                .Name("gridDepartment")
                .Columns(columns =>
                {
                    columns.Bound(c => c.departmentName).Title("Department");
                    columns.Bound(c => c.departmentId).Hidden(true);
                    columns.Bound(c => c.normalInterest).Title("Normal Interest");
                    columns.Bound(c => c.penalInterest).Title("Penal Interest");
                    columns.Bound(c => c.frequencyName).Title("Frequency");
                    columns.Bound(c => c.frequency).Hidden(true);
                    columns.Bound(c => c.noInstallment).Title("Max no. of Installment");
                    columns.Bound(c => c.allotmentmoney).Title("Allotment Money");
                    columns.Bound(c => c.installmentmoney).Title("Installment Money");
                    columns.Bound(c => c.leaseRent).Title("Lease Rent");
                    columns.Bound(c => c.floorArearatio).Title("FAR");
