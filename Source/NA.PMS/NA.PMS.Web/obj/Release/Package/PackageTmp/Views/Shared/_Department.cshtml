    function RemoveDepttRecord(refId) {
        var schemeID = $("#scheId").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ refId: refId, schemeID: schemeID }),
            url: '/Scheme/RemoveDepttRecord',
            success: function (result) {
                if (result == true) {
                    $("#gridDepartment").data("kendoGrid").dataSource.read();
                    var gridDepartment = $("#gridDepartment").data("kendoGrid").dataSource.data();
                    if (gridDepartment.length == 1) {
                        IsSchemeCompletedByRemove(false);
                    }
                    alertify.success("Record deleted successfully.");
                }
                else {
                    alertify.error("Department can't be deleted as a dependent Quota, Rebate or Cost exists for it.");
                }
            },
            error: function (obj) {
                //alert('Error While Saving Record.');
            }
        });
    }
    function ValidateDepttMasterScheme() {
        var selecteddpttValue = $('#departmentId');
        var selectedNoInttValue = $('#normalInterest');
        var selectedPenInttValue = $('#penalInterest');
        var selectedfreqValue = $('#frequency');
        var selectionType = $('#SelectionType');
        var floorArearatio = $("#floorArearatio").val().trim();
        var installmentmoney = $("#installmentmoney").val().trim();
        var allotmentmoney = $("#allotmentmoney").val().trim();
        var txtdepttleaseRent = (isNaN(parseFloat($('#txtdepttleaseRent').val()))) ? 0 : parseFloat($('#txtdepttleaseRent').val());
        if (selecteddpttValue.val() == "") {
            alertify.error('Please Select Department');
            //$("#btnAddDeptt").removeAttr('disabled');
            return false;
        }
        else if (selectedNoInttValue.val() == "") {
            alertify.error('Please Select Normal Interest');
            //$("#btnAddDeptt").removeAttr('disabled');
            return false;
        }
        else if (selectedPenInttValue.val() == "") {
            alertify.error('Please Select Penal Interest');
            //$("#btnAddDeptt").removeAttr('disabled');
            return false;
        }
        else if (selectedfreqValue.val() == "") {
            alertify.error('Please Select Frequency');
            //$("#btnAddDeptt").removeAttr('disabled');
            return false;
        }
        else if (selectionType.val() == "") {
            alertify.error('Please Select Selection Type');
            //$("#btnAddDeptt").removeAttr('disabled');
            return false;
        }

        else if ($('#noInstallment').val().trim() == "") {
            alertify.error('Please Maximum No. of Installment');
            //$("#btnAddDeptt").removeAttr('disabled');
            return false;
        }

        else if (selecteddpttValue.val() != 5) {
            var total = parseFloat(installmentmoney) + parseFloat(allotmentmoney)

            if($('#noInstallment').val().trim()=="")
            {
                alertify.error('Please enter Maximum No. of Installment.');
                //$("#btnAddDeptt").removeAttr('disabled');
                return false;
            }
            else if(allotmentmoney=="")
            {
                alertify.error('Please enter allotment money.');
                //$("#btnAddDeptt").removeAttr('disabled');
                return false;
            }
            else if(installmentmoney=="")
            {
                alertify.error('Please enter Installment money.');
                //$("#btnAddDeptt").removeAttr('disabled');
                return false;
            }
            else if (floorArearatio == "") {
                alertify.error('Please enter Floor Area Ratio.');
                //$("#btnAddDeptt").removeAttr('disabled');
                return false;
            }
            else if($('#txtdepttleaseRent').val().trim()=="")
            {
                alertify.error('Please enter Lease Rent.');
                //$("#btnAddDeptt").removeAttr('disabled');
                return false;
            }
            else if (total != 100) {
                alertify.error('Sum of Allotment Money % and Installment Money % should be equal to 100%.');
                //$("#btnAddDeptt").removeAttr('disabled');
                return false;
            }
            else if (floorArearatio > 100) {
                alertify.error('Floor Area Ratio should be less then 100 percents');
                //$("#btnAddDeptt").removeAttr('disabled');
                return false;
            }
            else if(txtdepttleaseRent>100)
            {
                alertify.error("Department Lease Rent Should be between 0 to 100");
                return false;
            }
        }
        return true;
    }

