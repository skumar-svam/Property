@model NA.PMS.Web.Models.LoginViewModel
@using System
@using System.Web;
@using System.Configuration
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Blank.cshtml";

    var userlist = ConfigurationManager.AppSettings["OTP123USERS"].ToString();
    string[] otp123userlist = userlist.Split(',');
    var DefaultUserFlag = false;
    if (Session != null)
    {
        if (Session["UserName"] != null)
        {
            DefaultUserFlag = otp123userlist.Contains(Session["UserName"].ToString().ToUpper());
        }
    }
}

