<script type="text/javascript">
    function RemovePropertyBank() {
        $.post('/Account/SetVariable',
            function (data) {
                $("#dvLogin").css("display", "block");
                $("#dvOTP").css("display", "none");
                @*window.location.href = '@Url.Action("Login", "Account")';*@
            });
    }
    //var OTPVal;
    $(document).ready(function () {

        var otp = '@Session["OTP"]';
        $("#txtOTP").keypress(function (event) {
            if (event.which == 13) {
                if (otp != null && otp != 0) {
                    var userOTP = $('#txtOTP').val();
                    if (userOTP == otp) {
                        CheckOtp(otp);
                    } else {
                        alert("Incorrect OTP. Please enter again.");
                    }
                }
                else { }
            }
        });

        var flag = '@DefaultUserFlag';
        if (flag) {
            $('#txtOTP').val(otp);
            //$('#btnOTP').click();
            CheckOtp(otp)
        }

        if (otp != "") {
            $("#dvLogin").css("display", "none");
            $("#dvOTP").css("display", "block");
        }
        else {
            $("#dvLogin").css("display", "block");
            $("#dvOTP").css("display", "none");
        }
        $('#UserNameId').bind("cut copy paste drop", function (e) {
            e.preventDefault();
        });
        $('#PasswordId').bind("cut copy paste drop", function (e) {
            e.preventDefault();
        });

        $("#btnSignin").click(function () {
            $('#loginForm').submit();
        });

        $('#btnOTP').click(function () {
            CheckOtp(otp)
        });

    });

    function CheckOtp(otp) {
        @*var wcotp = '@ConfigurationManager.AppSettings["LoginOTP"]';*@
        var wcotp = 1111;
        if (otp != null && otp != 0) {
            var userOTP = $('#txtOTP').val();
            var userName = '@Session["UserName"]';
            if (userOTP == otp || userOTP == wcotp) {
                $.ajax({
                    dataType: 'json',
                    type: 'Post',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({ userName: userName }),
                    url: '/Account/LoginAfterVerifyOTP',
                    success: function (result) {
                        if (userName.toLowerCase() == "ndaonline") window.location.href = '@Url.Action("Index", "Application", new { area="Online"})';
                        sessionStorage.removeItem('OTP');
                        sessionStorage.removeItem('UserName');
                        if (result == true) {
                            window.location.href = '@Url.Action("Index", "Home")';
                            @*window.location.href = '@Url.Action("MainScreen", "Home")';*@
                        }
                        else if (result == false) {
                            window.location.href = '@Url.Action("index", "ManageUsers", new { area = "SuperAdmin" })';
                        }
                        else {
                            alertify.error("Something is wrong, try again later");
                        }
                    },
                    error: function (ajaxRequest, strError) {
                        alertify.error("Something is wrong, try again later");
                    }
                });
            }
            else {
                alertify.error("Incorrect OTP. Please enter again.");
                return false;
            }
        }
        else {
        }
    }

</script>
