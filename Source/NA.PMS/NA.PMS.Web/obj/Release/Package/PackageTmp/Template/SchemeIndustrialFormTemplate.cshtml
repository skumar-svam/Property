                        <span style='color:black'>9.</span>
                    </b><b>
                        <span style='font-size:7.0pt;line-height:
  106%;color:black'>&nbsp;&nbsp;&nbsp;</span><span style='color:black'>
                            <u>
                                MODE
                                OF PAYMENT
                            </u>
                        </span>
                    </b>
