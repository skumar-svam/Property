<script type="text/javascript">

    function GetRid() {
        var regId = $("#hdnRId").val();
        if (regId == "" || regId == undefined) { regId = 0; }
        return {
            Rid: regId
        };
    }

    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }

    function MeterSealingFileSelection() {
        var fileMeterSealing = $("#fileMeterSealing").val();
        var arrayFileMeterSealing = fileMeterSealing.split('.');
        if (arrayFileMeterSealing[1] != "pdf") {
            alert("Only pdf files are allowed");
            $("#fileMeterSealing").val('');
            $("#MeterSealing").prop('checked', false);
            $("#MeterSealing").prop('disabled', false);
            return false;
        }
        else {
            $("#MeterSealing").prop('checked', true);
            $("#MeterSealing").prop('disabled', true);
        }
    }
    function AffidavitFileSelection() {
        var fileAffidavit = $("#fileAffidavit").val();
        var arrayFileAffidavit = fileAffidavit.split('.');
        if (arrayFileAffidavit[1] != "pdf") {
            alert("Only pdf files are allowed");
            $("#fileAffidavit").val('');
            $("#Affidavit").prop('checked', false);
            $("#Affidavit").prop('disabled', false);
            return false;
        }
        else {
            $("#Affidavit").prop('checked', true);
            $("#Affidavit").prop('disabled', true);
        }
    }
    function RegistrationCertificateFileSelection() {
        var fileRegistrationCertificate = $("#fileRegistrationCertificate").val();
        var arrayFileRegistrationCertificate = fileRegistrationCertificate.split('.');
        if (arrayFileRegistrationCertificate[1] != "pdf") {
            alert("Only pdf files are allowed");
            $("#fileRegistrationCertificate").val('');
            $("#RegistrationCertificate").prop('checked', false);
            $("#RegistrationCertificate").prop('disabled', false);
            return false;
        }
        else {
            $("#RegistrationCertificate").prop('checked', true);
            $("#RegistrationCertificate").prop('disabled', true);
        }
    }
    function NDCAccountFileSelection() {
        var fileNDCAccount = $("#fileNDCAccount").val();
        var arrayFileNDCAccount = fileNDCAccount.split('.');
        if (arrayFileNDCAccount[1] != "pdf") {
            alert("Only pdf files are allowed");
            $("#fileNDCAccount").val('');
            $("#NDCAccount").prop('checked', false);
            $("#NDCAccount").prop('disabled', false);
            return false;
        }
        else {
            $("#NDCAccount").prop('checked', true);
            $("#NDCAccount").prop('disabled', true);
        }
    }
    $("#MeterSealing").click(function () {
        if ($(this).is(":checked")) {
            $("#MeterSealing").val(true);
        }
        else {
            $("#MeterSealing").val(false);
        }

    });
    $("#Affidavit").click(function () {
        if ($(this).is(":checked")) {
            $("#Affidavit").val(true);
        }
        else {
            $("#Affidavit").val(false);
        }

    });
    $("#RegistrationCertificate").click(function () {
        if ($(this).is(":checked")) {
            $("#RegistrationCertificate").val(true);
        }
        else {
            $("#RegistrationCertificate").val(false);
        }

    });
    $("#NDCAccount").click(function () {
        if ($(this).is(":checked")) {
            $("#NDCAccount").val(true);
        }
        else {
            $("#NDCAccount").val(false);

        }

    });

    function RIdChange() {
        var rId = $("#RId").val();
        if (rId == '') {
            ClearValues();
            alertify.error("Please select an RID");

            return false;
        }
        //GetKYADetails(rId);
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rId: rId }),
            url: '/PropertyRegistration/GetFunctionalTransferDetailsByRID',
            success: function (result) {
                if (result != null) {

                    //$("#lblPropNo").html(result.PropertyNumber);
                    $("#PropertyNumber").val(result.PropertyNumber);
                    $("#lblScNa").html(result.SchemeName);
                    $("#lblDeNa").html(result.DepttName);
                    $("#lblApNa").html(result.ApplicationName);
                    $("#lblGender").html(result.Gender);
                    $("#lblReNa").html(result.RelationName);
                    $("#lblPropTy").html(result.PropertyType);
                    $("#lblArea").html(result.Area);
                    $("#lblFloor").html(result.Floor);

                    //$("#FunctionalDueDate").data("kendoDatePicker").value(result.FunctionalDueDate);

                    //$("#lblTrGender").html(result.TransfereeGender);
                    //$("#lblTrReNa").html(result.TransfereeRelationName);
                    //$("#lblTransTy").html(result.TransferType);
                    //$("#TransferDate").data("kendoDatePicker").value(result.TransferDate);
                    //$("#ReqNo").val(result.ReqNo);

                    $("#DepttId").val(result.DepttId);
                    //$("#PropertyNumber").var(result.PropNo);
                    if (result.Gender == "company") {
                        $('label[for="Father_s_Husband_s_Name"]').hide();
                    }
                    else {
                        $('label[for="Father_s_Husband_s_Name"]').show();
                    }
                }
                else {
                    ClearValues();
                    alertify.error("Some error occured. Please try again later.");
                }
            },
            error: function (obj) {
                ClearValues();
                alertify.error("Some error occured. Please try again later.");
            }
        });
    }

    function GetKYADetails(rId) {
        //var rId = $("#RId").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ RegistrationId: rId }),
            url: '/Property/PropertyRegistration/GetKYADetailsForRid',
            success: function (result) {
                if (result != null) {
                    if (result.StatusId == "2") {
                        alertify.error("Your KYA has been Rejected. Please Complete your KYA again.");
                        $('#btnSubmitForApprovallink').attr('disabled', 'disabled');
                        return false;
                    }
                    else if (result.StatusId == "" || result.StatusId == null) {
                        alertify.error("Please Complete your KYA.");
                        $('#btnSubmitForApprovallink').prop('disabled', true);
                        return false;
                    }
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }
        });
    }

    function ToJavaScriptDate(value) {
        var pattern = /Date\(([^)]+)\)/;
        var results = pattern.exec(value);
        if (results != null) {
            var dt = new Date(parseFloat(results[1]));
            return (dt.getMonth() + 1) + "/" + dt.getDate() + "/" + dt.getFullYear();
        }
    }

    function RequestIdCheck() {
        var request = $("#ReqRefNo").val();
        rModel = {
            RequestId: $("#ReqRefNo").val(),
            RegistrationId: $("#RId").val(),
            ServiceId: "10"
        }
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: rModel }),
            url: '/Property/PropertyRegistration/IsRequestIdIsExist',
            success: function (result) {
                if (result != '@ReturnType.Exist') {
                    if (result == '@NAStatusId.Completed') {
                        alertify.error("This Request is Completed");
                    }
                    else if (result == '@NAStatusId.Initiated') {
                        alertify.error("This Request is in Initiated State. Please Forward this request first.");
                    }
                    else if (result == '@NAStatusId.Objection') {
                        alertify.error("This Request in Objection State.");
                    }
                    else if (result == '@NAStatusId.Rejected') {
                        alertify.error("This Request is Rejected");
                    }
                    else if (result == '@NAStatusId.Cancelled') {
                        alertify.error("This Request is cancelled");
                    }
                    else if (result == '@NAStatusId.Withdrawn') {
                        alertify.error("This Request is Withdrawn by Allottee.");
                    }
                    else {
                        alertify.error("Request no. mismatch. Please enter a valid Request No.");
                    }
                    $("#ReqRefNo").val('');
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }
        });
    }
</script>
