@*@model NA.PMS.Model.TransferModel*@

@*<h2 class="blck-heading">Allottee Details</h2>*@
<div class="form-bx">
    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Scheme Name")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblScNa" class="lbl-form-control"></label>
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Department")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblDeNa" class="lbl-form-control"></label>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Applicant's Name", new { @class = "mfGender", @id = "lbl_mfGender" })
            @Html.Label("Company's Name", new { @class = "comGender", @id = "lbl_comGender" })
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblApNa" class="lbl-form-control mfGender"></label>
            <label id="lblCoNa" class="lbl-form-control comGender"></label>
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Gender")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblGend" class="lbl-form-control"></label>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Father's/Husband's Name", new { @class = "mfGender", @id = "lbl_FHname" })
            @Html.Label("Signatory Authority", new { @class = "comGender", @id = "lbl_SAname" })
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblReNa" class="lbl-form-control mfGender"></label>
            <label id="lblSiAu" class="lbl-form-control comGender"></label>
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Property Type")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblPropTy" class="lbl-form-control"></label>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Area (sqmt)")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblArea" class="lbl-form-control"></label>
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Floor")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblFloo" class="lbl-form-control"></label>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Property Mortgaged")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblProMo" class="lbl-form-control"></label>
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Property Functional")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblProFu" class="lbl-form-control"></label>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("One Time Lease Rent")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblOTLR" class="lbl-form-control"></label>
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Correspondence Address")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblCorrAdd" class="lbl-form-control"></label>
            <input type="hidden" id="hdnDepttId" />
            <input type="hidden" id="hdnPropId" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Permanent Address")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblPerAdd" class="lbl-form-control"></label>
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        </div>
    </div>
</div>

