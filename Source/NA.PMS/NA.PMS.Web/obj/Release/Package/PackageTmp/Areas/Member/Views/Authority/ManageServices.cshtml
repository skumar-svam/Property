@model NA.PMS.Model.ServiceViewModel
@using NA.PMS.Common;
@using Kendo.Mvc.UI;

@{
    ViewBag.Title = "Manage Services";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .hyperlink{
        color:blue;
    }
    .kendo-popup-window{
        display:none;
    }
</style>
<div class="service-content">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Service Type</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                <a href="#" onclick="javascript:DisplayWindow()">Add/Update Service Type</a>   
            </div>
        </div>
    </div>
    <div class="col-md-12  blnk-rw"></div>
    <div class="col-md-12" style="border-left:1px solid #abc;border-right:1px solid #abc;">
        <div class="row form-group">
            <div class="col-md-3 pad-left">
                @Html.Label("Department")
                @(Html.Kendo().DropDownListFor(model => model.DepartmentId)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    //.DataSource(source => source.Read(read => read.Action("GetDepartmentListAsDataSource", "AuthorityService", new { area="Member"})))
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true).ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetDepartmentListAsDataSource", "Authority", new { area = "Member" })))
                        .Schema(schema => schema.Data("Data").Total("Total")).PageSize(100);
                    })
                    .Events(e => e.Change("ChangeInDepartmentEvent"))
                   .HtmlAttributes(new { style = "width:95%;float:right;", @class = "input-disabled" })
                )
            </div>
            <div class="col-md-2" style="text-align:center;">
                @*<label style="width:100%;"> </label>
                <button type="button" id="btnSearch" class="k-button top-margin" value="Search">Search</button>
                <button type="button" id="btnClear" class="k-button top-margin" value="Clear">Clear</button>*@
            </div>
        </div>
    </div>
    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.Model.ServiceViewModel>()
            .Name("gridServices")
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.DepartmentId).Hidden(true);
                columns.Bound(c => c.ServiceId).Title("Id").Width(80);
                columns.Bound(c => c.Department).Title("Department").Width(200).Sortable(false).Filterable(false);
                columns.Bound(c => c.ServiceName).Title("Service Name");
                columns.Bound(c => c.IsActive).Title("Status").Width(110).ClientTemplate("<label class='hyperlink' onclick='javascript:ChangeServiceStatus(this)'>#=Status#</label>");
                columns.Bound(c => c.Id).Title("").Width(110).ClientTemplate("<label class='hyperlink' onclick='javascript:RemoveService(#=Id#)'>Delete</label>").Filterable(false);
            })
            .Filterable().Resizable(resize => resize.Columns(true))
            //.Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(new[] { 10, 50, 100, 500 }).Info(true).PreviousNext(true).Input(true).Numeric(true).ButtonCount(10))
            .DataSource
            (
                dataSource => dataSource
                .Ajax().Model(model => model.Id(p => p.Id)).ServerOperation(true)
                .Read(read => read.Action("GetAuthorityServiceDetailList", "Authority", new { area = "Member" }).Data("SearchParameter"))
                .Sort(r=>r.Add(s=>s.DepartmentId))
            )
        )
        
    </div>
</div>

<div class="col-md-12 kendo-popup-window" id="bank-window" style="background:url(/Content/Images/boxed-bg.jpg) repeat">
    @{Html.RenderPartial("_PartialServices");}
</div>

<script>
    $(document).ready(function () {
        $('.kendo-popup-window').kendoWindow({
            modal: true,
            title: "Add/Update Service Type",
            actions: ["Refresh", "Pin", "Minimize", "Maximize", "Close"],
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "30%"
            },
            width: "70%",// height: "35%"
        });
    });
    function DisplayWindow() {
        $('.kendo-popup-window').data("kendoWindow").open();
        $('.kendo-popup-window').data("kendoWindow").center();
    }

    function ChangeInDepartmentEvent() {
        $('#gridServices').data("kendoGrid").dataSource.read();
    }

    function SearchParameter() {
        return {DepartmentId : $('#DepartmentId').val() }
    }

    function ChangeServiceStatus(row) {
        var flag = confirm("Are You sure to change status?");
        if (flag) {
            var tr = $(row).parent().parent();
            var id = $(tr).children("td:eq(0)").text();
            var serviceId = $(tr).children("td:eq(2)").text();
            var departmentId = $(tr).children("td:eq(1)").text();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({Id:id, ServiceId: serviceId, DepartmentId: departmentId }),
                url: '/Member/Authority/ActivateAuthorityServiceStatus',
                success: function (result) {
                    if (result == '@ReturnType.Updated') {
                        alertify.success("Status updated successfully");
                    }
                    $("#gridServices").data("kendoGrid").dataSource.read();
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Network error, try again later");
                }
            });
        }       
    }

    function RemoveService(id) {
        var flag = confirm("Are You sure to remove this service?");
        if (flag) {
            //var tr = $(row).parent().parent();
            //var id = $(tr).children("td:eq(0)").text();
            //var serviceId = $(tr).children("td:eq(2)").text();
            //var departmentId = $(tr).children("td:eq(1)").text();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ Id: id, ActionType: "DeleteService" }),
                url: '/Member/Authority/SavePropertyServiceType',
                success: function (result) {
                    if (result == '@ReturnType.Removed') {
                        alertify.success("service removed successfully");
                    }
                    $("#gridServices").data("kendoGrid").dataSource.read();
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Network error, try again later");
                }
            });
        }
    }

</script>





