@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@using NA.PMS.Common
@model NA.PMS.Model.PaymentScheduleModel

@{
    ViewBag.Title = "Manage Installment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .fa.fa-refresh{
        
    }
    #dues-update-window{
        display:none;
    }
    .modal-header{
        padding: 6px 15px;
        border-bottom: 1px solid #e5e5e5;
        border-radius:0;
        background:#edbfbf;
    }
    .modal-footer{
        padding: 3px 15px;
        border-top: 1px solid #e5e5e5;
        border-radius:0;
        background:#edbfbf;
    }
    .modal-content{
        border-radius:0;
    }
</style>

<div class="manage-installment">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Installment Dues</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                <a href="#" onclick="javascript:OpenUpdateWindow()"><i class="fa fa-plus"></i> <span>Update Dues</span></a>
                <a href="/Revenue/Payment/InstallmentDues" target="_blank"><i class="fa fa-plus"></i> <span> Installment Dues</span></a>
                @*<a href="/Revenue/Payment/Installment" target="_blank"><i class="fa fa-plus"></i> <span> Installment</span></a>*@
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>

    <div class="col-md-12 content-top-spce">
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading" style="margin-bottom:15px;">Search</h2>
            <div class="form-bx">
                <div class="row">
                    <div class="col-md-2 col-sm-2 col-xs-12 form-group">
                        <b>@Html.Label("Department")</b>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                            .Filter("contains")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel(" --- select ---")
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => transport.Read(read => read.Action("GetDepartmentList", "Finance", new { area = "Revenue" })))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(6);
                            })
                            .Events(events => { events.Change("ChangeDepartmentEvent"); })
                            .HtmlAttributes(new { @class = "input-disabled", style = "width:100%" })
                        )
                    </div>
                </div>
            </div>

            <h2 class="blck-heading" style="margin-bottom:0;">Installment Dues List</h2>
            <div class="col-md-12 k-grid-content">
                @(Html.Kendo().Grid<NA.PMS.Model.PaymentScheduleModel>()
                .Name("InstallmentDuesGrid")
                .Columns(columns =>
                {
                    columns.Bound(c => c.Id).Hidden(true);
                    columns.Bound(c => c.RegistrationId).Title("Registration Id");
                    columns.Bound(c => c.DuesAmount).Title("Dues Amount");
                    columns.Bound(c => c.PenalInterest).Title("PI(%)").Width(80);                   
                    columns.Bound(c => c.DuesUptoDate).Title("Dues Upto").Format("{0:dd-MMM-yyyy}");
                    columns.Bound(c => c.BalanceUptoDate).Title("Balance Upto").Format("{0:dd-MMM-yyyy}");
                    columns.Bound(c => c.BalanceAmount).Title("Balance").ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
                    columns.Bound(c => c.IsTotalPremiumPaid).Title("Total Premium").Width(110).ClientTemplate("#if(IsTotalPremiumPaid==true){#<label>Paid</label>#}else{#<label>Not Paid</label>#}#");
                    columns.Bound(c => c.IsOneTimeLeaseRentPaid).Title("OTLR").Width(110).ClientTemplate("#if(IsOneTimeLeaseRentPaid==true){#<label>Paid</label>#}else{#<label>Not Paid</label>#}#");
                    columns.Bound(c => c.IsNDCGenerated).Title("NDC").Width(80).ClientTemplate("#if(IsNDCGenerated==true){#<label>Issued</label>#}else{#<label>---</label>#}#");
                    //columns.Bound(c => c.Id).Title("Edit").ClientTemplate("#if(IsActive==false){# <a href=\"/Revenue/Payment/Installment/#= Id#\" id='e_#=Id#'><span class='glyphicon glyphicon-pencil'></span></a> #}else{# --- #}#").Filterable(false).Sortable(false).Width(50);
                    //columns.Bound(c => c.Id).Title("View").ClientTemplate("<a href=\"/Revenue/Finance/ViewLeaseDeedDetails/#= Id#\" id='e_#=Id#'><span class='glyphicon glyphicon-eye-open'></span></a>").Filterable(false).Sortable(false).Width(50);
                    columns.Bound(c => c.RegistrationId).Title("Demand Note").Width(100).ClientTemplate(" <center><a onclick='javascript:PrintDemandNote(#=RegistrationId#,#=DuesAmount#);'><span class='fa fa-print hyperlink'></span></a></center> ").Filterable(false).Sortable(false);
                    columns.Bound(c => c.IsDuesUptoDate).Title(" ").Width(50).ClientTemplate("<center><a onclick='javascript:CalculateInstallmentDues(#=RegistrationId#);'><span class='fa fa-refresh hyperlink'></span></a></center> ").Filterable(false).Sortable(false);
                })
                .Sortable().Filterable().Resizable(resize => resize.Columns(true))
                .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                .ClientDetailTemplateId("template")
                .DataSource(dataSource => dataSource
                    .Ajax().ServerOperation(true)
                    .Model(model => model.Id(p => p.Id))                    
                    .Read(read => read.Action("GetInstallmentPaymentScheduleList", "Payment", new { area = "Revenue" }).Data("FilterDepartment")).PageSize(10)
                    .Aggregates(aggregates => aggregates.Add(p => p.BalanceAmount).Sum())
                    )
                )
            </div>
        </div>
    </div>

</div>

<div class="col-md-12" id="dues-update-window">
    <div class="row form-group" style="margin-top:25px;">
        <div class="col-md-4 col-sm-12 col-xs-12" style="text-align:center;padding:0;">
            <label>Department</label>
        </div>
        <div class="col-md-5 col-sm-12 col-xs-12" style="padding:0;">
            @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                .Name("DDLDepartmentId")
                .Filter("contains")
                .DataTextField("Text")
                .DataValueField("Id")
                .OptionLabel(" --- select ---")
                .DataSource(source =>
                {
                    source.Custom()
                    .ServerFiltering(true)
                    .ServerPaging(true)
                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                    .Transport(transport => transport.Read(read => read.Action("GetDepartmentList", "Finance", new { area = "Revenue" })))
                    .Schema(schema => schema.Data("Data").Total("Total"))
                    .PageSize(6);
                })
                .HtmlAttributes(new { @class = "input-disabled", style = "width:100%" })
            )
        </div>
        <div class="col-md-3 col-sm-12 col-xs-12" style="padding:0;">

        </div>
    </div>
    <div class="row form-group" style="margin:15px 0 15px 0;">
        <div class="col-md-4 col-sm-6 col-xs-12"></div>
        <div class="col-md-5 col-sm-6 col-xs-12">
            <input type="button" class="k-button btn btn-primary" id="btnSubmitAction" value="Update" style="width:100%" />
        </div>
    </div>
</div>

<div id="demand-note-window" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 70%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title"><b>Demand Note</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:450px;">
                <div id="demand-note-content"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <input type="button" id="btnPrintDiv" class="k-button fa fa-print" data-dismiss="modal" value="Print" onclick="PrintDemandNoteContent();" style="width:100px;"/>
            </div>
        </div>
    </div>
</div>


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<NA.PMS.Model.PaymentScheduleModel>()
            .Name("grid_#=Id#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.RegistrationId).Hidden(true);
                columns.Bound(c => c.DuesAmount).Title("Dues Amount").Width(120);
                //columns.Bound(c => c.InstallmentAmount).Title("Installment").Width(120);
                //columns.Bound(c => c.NormalInterest).Title("NI").Width(120);
                columns.Bound(c => c.PenalInterest).Title("PI").Width(130);               
                columns.Bound(c => c.InstallmentDueDate).Title("Due Date").Width(120).Format("{0:dd-MMM-yyyy}");
                columns.Bound(c => c.DuesUptoDate).Title("Dues Upto").Width(120).Format("{0:dd-MMM-yyyy}");
                columns.Bound(c => c.PaymentStatus).Title("Status").Width(100);
                //columns.Bound(c => c.PropertyType).Title("Property Type");
                //columns.Bound(c => c.Id).Title("Status").Width(120).ClientTemplate("#if(IsPropertyAllotted==true){#<lable>Allotted</label>#}else{#<label>Not Allotted</label>#}#");
                //columns.Bound(c => c.AllotmentDate).Format("{0:dd/MM/yyyy}").Width(120);
            })
            .DataSource(dataSource => dataSource
                .Ajax().Read(read => read.Action("GetInstallmentPaymentScheduleListById", "Payment", new { area = "Revenue", RefId = "#=Id#" }))
            )
            .ToClientTemplate()
    )
</script>
<script>
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
</script>



<script type="text/javascript">
    $(document).ready(function () {
        $('#dues-update-window').kendoWindow({
            modal: true,
            title: "Dues Update Window",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "30%"
            },
            width: "40%", height: "35%"
        });

        $('#btnSubmitAction').click(function () {
            UpdateDuesByDepartment();
        });
    });

    function ChangeDepartmentEvent() {
        $("#InstallmentDuesGrid").data("kendoGrid").dataSource.read();
    }


    function FilterDepartment() {
        var model = { DepartmentId: $("#DepartmentId").val(), ActionType: "InstallmentRequest" };
        return model;
    }

    function OpenUpdateWindow() {
        $("#dues-update-window").data("kendoWindow").center();
        $("#dues-update-window").data("kendoWindow").open();
        $("#dues-update-window").data("kendoWindow").pin();
    }


    function UpdateDuesByDepartment() {
        if ($('#DDLDepartmentId').val() == '') {
            alertify.error("Please select Department");
            return false;
        }
        else {
            //var actionType = $('#ddlUpdateDues').val();
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json;charset=utf-8",
                data: JSON.stringify({ DepartmentId: $("#DDLDepartmentId").val(), ActionType: '@Constants.Installment' }),
                url: '@Url.Action("UpdateDuesPaymentDetails", "Payment", new { area = "Revenue" })',
                success: function (result) {
                    $("#dues-update-window").data("kendoWindow").close();
                    if (actionType == '@Constants.Installment' && result == '@ReturnType.Updated') {
                        alertify.success("Dues updated successfully");
                        $('#InstallmentDuesGrid').data("kendoGrid").dataSource.read();
                    }
                    if (actionType == '@Constants.Leaserent' && result == '@ReturnType.Updated') {
                        alertify.success("Dues updated successfully");
                        $('#InstallmentDuesGrid').data("kendoGrid").dataSource.read();
                    }
                    else {
                        alertify.error("Dues is not updated");
                        return false;
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Something is wrong, try again later");
                }
            });
        }
    }



    function CalculateInstallmentDues(rid) {
        var flag = confirm("Are You sure to update installment dues of RID " + rid);
        if (rid != 0 && flag == true) {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ RegistrationId: rid, ActionType: "Installment" }),
                url: '/Revenue/Payment/UpdateInstallmentDuesPaymentByIdII',
                //url: '/Revenue/Payment/UpdateInstallmentDuesPaymentII',
                success: function (result) {
                    if (result == '@ReturnType.Updated') {
                        $("#InstallmentDuesGrid").data("kendoGrid").dataSource.read();
                        alertify.success("Dues Updated successfully");
                    }
                    else if (result == '@ReturnType.Success') {
                        $("#InstallmentDuesGrid").data("kendoGrid").dataSource.read();
                        alertify.success("Dues Updated successfully");
                    }
                    else if (result == '@ReturnType.None') {
                        alertify.error("Dues is not Updated.");
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    alertify.error("Some Error in save database.");
                }
            });
        }
    }


    function PrintDemandNote(registrationId, dueAmount) {
        var duesModel = { RegistrationId: registrationId, LeaseRentDues: dueAmount };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: duesModel }),
            //url: '/Revenue/Finance/PrintDemandNote',
            url: '/Revenue/Finance/PrintInstallmentDuesDemandNote',
            success: function (result) {
                //$("#divApplicationForm").modal('hide');
                $("#demand-note-content").html(result);
                $("#demand-note-window").modal('show');
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alertify.error("Some Error in save database.");
            }
        });
    }

    function PrintDemandNoteContent() {
        var contents = document.getElementById("demand-note-content").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }
</script>
