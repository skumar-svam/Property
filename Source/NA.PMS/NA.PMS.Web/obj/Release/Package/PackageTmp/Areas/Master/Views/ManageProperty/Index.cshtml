
@model NA.PMS.Model.PropertyViewModel
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
@using NA.PMS.Common;

@{
    ViewBag.Title = "Noida Property";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .btn {
        margin-top: 20px;
    }

    .applicant-grid, .property-grid, .row-btn-action {
        display: none;
    }

    .hyperlink {
        cursor: pointer;
        color: blue;
    }
</style>

<div id="ManageProperty">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Property Details</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">

            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12" style="border:solid #e2e3e4; border-width:0 1px 1px">
        <div>
            @Html.HiddenFor(model=>model.ActionType)
        </div>
        <div class="row" style="padding:12px 30px 0px 0;">
            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                @Html.Label("Scheme Name")
                @(Html.Kendo().DropDownListFor(m => m.SchemeId)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetMasterSearchParameterAsDataSource", "ManageProperty", new { area = "Master" }).Data("FilterSchemeParameter")))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                    .Events(events => { events.Change("ChangeInScheme"); })
                    .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                )
            </div>
            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                @Html.Label("Department")
                @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetMasterSearchParameterAsDataSource", "ManageProperty", new { area = "Master" }).Data("FilterDepartmentParameter")))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                    .Events(events => { events.Change("ChangeInDepartment"); })
                    .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                )
            </div>

            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                @Html.Label("Sector")
                @(Html.Kendo().DropDownListFor(model => model.SectorId)
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .Enable(true)
                    .AutoBind(true)
                    .Filter("contains")
                    //.CascadeFromField("DepartmentId")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetMasterSearchParameterAsDataSource", "ManageProperty", new { area = "Master" }).Data("FilterSectorParameter")))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                   //.CascadeFrom("DepartmentId")
                   .HtmlAttributes(new { style = "width:90%; float:right;", @class = "input-disabled" })
                   .Events(e => e.Change("ChangeInSector"))
                )
            </div>
            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                @Html.Label("Block")
                @(Html.Kendo().DropDownListFor(m => m.BlockId)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    //.CascadeFrom("SectorId")
                    //.CascadeFromField("SectorId")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetMasterSearchParameterAsDataSource", "ManageProperty", new { area = "Master" }).Data("FilterBlockParameter")))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                   .Events(events => { events.Change("ReadPropertyGridEvent"); })
                   .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                )
            </div>
            
        </div>

    </div>

    <div class="col-md-12 alot-prop-grid k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.Model.PropertyViewModel>()
            .Name("GridAllottedProperty")
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.PropertyId).Title("Property Id").Width(130);
                columns.Bound(c => c.RegistrationId).Title("Registration Id").Width(150).ClientTemplate("#if(IsPropertyAllotted==true){#<a target='_blank' href='/Property/PropertyAllotment/PropertyDetails/#=RegistrationId#'>#=RegistrationId#</a>#}else{#<label>Not Allotted</label>#}#");
                columns.Bound(c => c.Department).Title("Department").Width(140);
                columns.Bound(c => c.SectorName).Title("Sector").Width(130);
                columns.Bound(c => c.BlockName).Title("Block").Width(110);
                columns.Bound(c => c.PlotNo).Title("Plot").Width(120);
                columns.Bound(c => c.SchemeName).Title("Scheme Name");             
                //columns.Bound(c => c.AllotmentDate).Title("Allotment").Width(130).Format("{0:dd/MM/yyyy}");
            })
            .Sortable().Filterable().Resizable(resize => resize.Columns(true))
            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
            .ClientDetailTemplateId("template")
            .AutoBind(true)
            .DataSource
            (
                dataSource => dataSource
                .Ajax().ServerOperation(true)
                .Model(model => model.Id(p => p.Id))                
                .Read(read => read.Action("GetMasterPropertyList", "ManageProperty", new { area = "Master" }).Data("SearchPropertyByParameter"))
                .Sort(s => s.Add(x => x.SectorId))
                //.Group(groups => groups.Add(p => p.SchemeName))
                .PageSize(10)
            ))
    </div>

</div>


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<NA.PMS.Model.PropertyViewModel>()
            .Name("grid_#=Id#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.RegistrationId).Hidden(true);
                columns.Bound(c => c.TotalArea).Title("Total Area").Width(120);
                columns.Bound(c => c.ActualArea).Title("Actual Area").Width(120);
                columns.Bound(c => c.TotalPropertyCost).Title("Property Cost").Width(130);
                columns.Bound(c => c.FloorArea).Title("Floor Area").Width(120);
                columns.Bound(c => c.LandRate).Title("Land Rate").Width(120);
                columns.Bound(c => c.LocationCharge).Title("Location charge").Width(140);
                columns.Bound(c => c.PropertyType).Title("Property Type");
                columns.Bound(c => c.Id).Title("Status").Width(120).ClientTemplate("#if(IsPropertyAllotted==true){#<lable>Allotted</label>#}else{#<label>Not Allotted</label>#}#");
                //columns.Bound(c => c.AllotmentDate).Format("{0:dd/MM/yyyy}").Width(120);
            })
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(10)
                .Read(read => read.Action("GetMasterPropertyList", "ManageProperty", new { Id = "#=Id#" }))
            )
            .ToClientTemplate()
    )
</script>
<script>
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
</script>


<script>
    $(document).ready(function () {
        $('#ActionType').val("Scheme");
    });

    function ChangeInDropdownFilter() {
        $('#SchemeId').data('kendoDropDownList').dataSource.read();
        $('#DepartmentId').data('kendoDropDownList').dataSource.read();
        $('#SectorId').data('kendoDropDownList').dataSource.read();
        $('#BlockId').data('kendoDropDownList').dataSource.read();
        $('#GridAllottedProperty').data('kendoGrid').dataSource.read();
    }

    function ChangeInScheme() {
        //$('#ActionType').val("Scheme");
        ChangeInDropdownFilter();
    }
    function FilterSchemeParameter() {
        return {
            ActionType: "Scheme",
            SchemeId: $('#SchemeId').val(),
            DepartmentId: $('#DepartmentId').val(),
            SectorId: $('#SectorId').val(),
            BlockId: $('#BlockId').val()
        };
    }

    function ChangeInDepartment() {
        //$('#ActionType').val("Department");
        ChangeInDropdownFilter();
    }
    function FilterDepartmentParameter() {
        return {
            ActionType: "Department",
            SchemeId: $('#SchemeId').val(),
            DepartmentId: $('#DepartmentId').val(),
            SectorId: $('#SectorId').val(),
            BlockId: $('#BlockId').val()
        };
    }

    function ChangeInSector() {
        //$('#ActionType').val("Sector");
        ChangeInDropdownFilter();
    }
    function FilterSectorParameter() {
        return {
            ActionType: "Sector",
            SchemeId: $('#SchemeId').val(),
            DepartmentId: $('#DepartmentId').val(),
            SectorId: $('#SectorId').val(),
            BlockId: $('#BlockId').val()
        };
    }

    function ChangeInBlock() {
        //$('#ActionType').val("Block");
        ChangeInDropdownFilter();
    }
    function FilterBlockParameter() {
        return {
            ActionType: "Block",
            SchemeId: $('#SchemeId').val(),
            DepartmentId: $('#DepartmentId').val(),
            SectorId: $('#SectorId').val(),
            BlockId: $('#BlockId').val()
        };
    }


    function ReadPropertyGridEvent() {
        $('#GridAllottedProperty').data('kendoGrid').dataSource.read();
    }
    //var action = "Scheme";
    function FilterSearchParameter() {
        return {
            ActionType: $('#ActionType').val(),
            SchemeId: $('#SchemeId').val(),
            DepartmentId: $('#DepartmentId').val(),
            SectorId: $('#SectorId').val(),
            BlockId: $('#BlockId').val()
        };
    }

    function SearchPropertyByParameter() {
        var model = {
            SchemeId: $('#SchemeId').val(),
            DepartmentId: $('#DepartmentId').val(),
            SectorId: $('#SectorId').val(),
            BlockId: $('#BlockId').val()
        };
        return model;
    }


</script>





