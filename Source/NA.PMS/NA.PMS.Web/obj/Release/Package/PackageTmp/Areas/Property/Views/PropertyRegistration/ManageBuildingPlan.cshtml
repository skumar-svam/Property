@using Kendo.Mvc.UI
@{
    ViewBag.Title = "ManageBuildingPlan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .topSpace{
        padding-top:25px;
    }
</style>


<div class="divBuildingPlan">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Building Plan</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                @*<a href="#" id="btnOpenKendoWindow" class="" onclick="javascript:GeneratePaymentChallan(event);">Generate Payment Challan</a>*@
                <a href="#" id="btnRequest" class="" onclick="javascript: AddBuildingPlan(event);">Add Request</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.Model.BuildingPlanModel>()
                .Name("gridCompletion")
                .Columns(columns =>
                {
                    columns.Bound(c => c.RId).Title("Registration Id").Width(150).ClientTemplate("<a href=\"/Property/PropertyRegistration/ViewBuildingPlan/#= RId#\" id='v_#=RId#'  style = 'width: 30px;' >#=RId#</a>");
                    columns.Bound(c => c.BuildingPlanFileNo).Title("BP File Number");
                    columns.Bound(c => c.DepttName).Title("Department");
                    columns.Bound(c => c.SectorName).Title("Sector").Width(100);
                    columns.Bound(c => c.BlockName).Title("Block").Width(100);
                    columns.Bound(c => c.PropertyNo).Title("Property No").Width(130);
                    //columns.Bound(c => c.PropNo).Title("Property No");
                    columns.Bound(c => c.MapRevised).Title("Revised").Width(120);
                    columns.Bound(c => c.DateOfSubmission).Title("Submission Date").Format("{0:dd/MM/yyyy}"); 
                    columns.Bound(c => c.RId).ClientTemplate("<a href='" + "/Property/PropertyRegistration/Edit/#= RId #'><span class='glyphicon glyphicon-edit'></span> Edit </a>").Title("Edit").Filterable(false).Width(120);            
                })
                .Sortable()
                .Filterable()
                .Resizable(resize => resize.Columns(true))
                //.ToolBar(toolBar =>
                //{
                //    toolBar.Custom().Text("<i class='fa fa-plus-square' aria-hidden='true'></i> Add Request").HtmlAttributes(new { onclick = "javascript:AddBuildingPlan(event);", @class = "k-button", id = "btnRequest" });
                //})
                .Pageable(pageable => pageable
                                                       .Enabled(true)
                                                       .Refresh(true)
                                                       .PageSizes(true)
                                                    )
                .DataSource(dataSource => dataSource
                        .Ajax().Model(model => model.Id(c => c.RId))
                        .ServerOperation(true)
                        .Read(read => read.Action("GetBuildingPlan", "PropertyRegistration")).PageSize(20)
                )
        )
    </div>
</div>

<div id="divGenerateChallanForBuildingPlan">
    <div class="container-fluid">
        <div class="row topSpace">
            <div class="col-md-3 col-sm-6 col-md-offset-1">
                Registration Id
            </div>
            <div class="col-md-6 col-sm-6">
                @(Html.Kendo().DropDownList()
                    .Name("ddlRid")
                    .Filter("contains")
                    .OptionLabel("---please select--")
                    .DataTextField("text")
                    .DataValueField("id")
                                    .DataSource(source => source.Read(read => read.Action("GetRIDs", "PropertyRegistration").Data("RIdChanges")))
                    .HtmlAttributes(new { style="width:100%"})
                )
            </div>
        </div>
        <div class="row topSpace">
            <div class="col-md-6 col-md-offset-4">
                <input type="button" id="btnGenerateChallan" value="Submit" class="btn btn-add"/>
                <input type="button" id="btnCloseWindow" value="Close" class="btn btn-default" />
            </div>
        </div>
    </div>
</div>

<div id="divPrintChallan" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" style="width: 55%">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Challan</b></h4>
            </div>
            <div class="modal-body" id="divChallanBody">

            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnChallanPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv('challan');">Print</button>

            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function AddBuildingPlan(event) {
        event.preventDefault();
        window.location.href = '@Url.Action("AddBuildingPlan", "PropertyRegistration")';
    }

    function RIdChanges() {
        return {
            type: "buildingPlan"
        };
    }

    $('#divGenerateChallanForBuildingPlan').kendoWindow({
        modal: true,
        title: "Generate Building Plan Challan",
        visible: false,
        width: "39%",
        height:180
    });

    $('#btnOpenKendoWindow').click(function () {
        var win = $("#divGenerateChallanForBuildingPlan").data("kendoWindow");
        win.center().open();
        //win.open();
    });

    $('#btnCloseWindow').click(function () {
        $("#divGenerateChallanForBuildingPlan").data("kendoWindow").close();
    })

    $('#btnGenerateChallan').click(function () {
        var rid = $('#ddlRid').val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            //data: JSON.stringify({ propId: propId, schemeId: schemeId, deptId: deptId, rId: rId }),
            //url: '/DocParser/PrintCompletionChallan',
            data: JSON.stringify({ rid: rid }),
            url: '/DocParser/PrintPaymentChallanForBuildingPlan',
            success: function (result) {
                $("#divChallanBody").html(result);
                $("#divPrintChallan").modal('show');
            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                alertify.error("Something is wrong, Please try again later.");
            }
        });
    })



    function PrintDiv(controlID) {
        var contents;
        if (controlID == "challan")
            contents = document.getElementById("divChallanBody").innerHTML;
        else
            contents = document.getElementById("divCompletionBody").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }
</script>

