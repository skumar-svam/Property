
@model NA.PMS.Model.KYAViewModel
@using Kendo.Mvc.UI;

<div class="PropertyDetailsForm content-top-spce">
    <div class="col-md-12" style="border:solid #e2e3e4; border-width:0 1px 1px">
        <h2 class="blck-heading">KYA Details</h2>
        <div class="col-md-12 col-sm-12 col-xs-12 form-bx">
            @Html.HiddenFor(m=>m.RegistrationId)
            @Html.HiddenFor(m => m.StatusId)
            @Html.HiddenFor(m=>m.Status)

            <div class="row row-StatusApproved">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_KYAId">KYA Uid</label> </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><span class="form-control" id="KYAId"></span>  </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_KYAReferenceCode">KYA Reference Code</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><span class="form-control" id="KYAReferenceCode"></span></div>
            </div>
            <div class="row">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_AllotteeName">Allottee Name</label> </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><span class="form-control" id="AllotteeName"></span>  </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_AllotteeType">Allottee Type</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><span class="form-control" id="AllotteeType"></span></div>
            </div>            
            <div class="row">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_MobileNo">Mobile No</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><span class="form-control" id="MobileNo"></span> </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_Email">Email Id</label> </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><span class="form-control" id="EmailId"></span> </div>
            </div>
            <div class="row">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_CorrespondAddress">Correspond Address</label> </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><span class="form-control" id="CorrespondAddress"></span> </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_CommunicationAddress">Communication Address </label> </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><span class="form-control" id="CommunicationAddress"></span> </div>
            </div>
            <div class="row">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_AlloteePAN">Allotee PAN</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><span class="form-control" id="AlloteePAN"></span></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_ReqDate">Request Date </label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().DatePicker().Name("ReqDate").HtmlAttributes(new { style = "width:100%;", @readonly = "readonly" }))
                    @*<span class="form-control" id="ReqDate"></span>*@
                </div>
            </div>
            <div class="row row-company">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_AuthorizedSignatoryName">Authorized Signatory Name</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><span class="form-control" id="AuthorizedSignatoryName"></span></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_GSTNo">GST No</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><span class="form-control" id="GSTNo"></span> </div>
            </div>
            <div class="row row-company">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_AuthorizedSignatoryMobile">Authorized Signatory Mobile No</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><span class="form-control" id="AuthorizedSignatoryMobile"></span></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_AuthorizedSignatoryEmail">Authorized Signatory Email Id</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><span class="form-control" id="AuthorizedSignatoryEmail"></span> </div>
            </div>
            <div class="row row-StatusApproved">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_ApprovalDate">Approval Date</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().DatePicker().Name("ApprovalDate").HtmlAttributes(new { style = "width:100%;", @readonly = "readonly" }))
                    @*<span class="form-control" id="ApprovalDate"></span>*@
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_Approver">Approver</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><span class="form-control" id="Approver"></span> </div>
            </div>
            <div class="row row-statusReject">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_RejectionReason">Reason for Rejection</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><span class="form-control" id="RejectionReason"></span></div>
            </div>
            @*<div class="row">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_Status">Status</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><span class="form-control" id="Status"></span></div>
            </div>*@
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function (){
        GetKYADetails();
    });

    function GetKYADetails() {
        var rid = $("#hdnRID").val() == "" ? 0 : $("#hdnRID").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rId: rid }),
            url: "/Property/PropertyAllotment/GetKYADetails",
            success: function (data) {
                if (data != null) {
                    $('#StatusId').val(data.StatusId);
                    $('#Status').val(data.Status);
                    $('#AllotteeName').html(data.AllotteeName);
                    $('#AllotteeType').html(data.AllotteeType);
                    $('#MobileNo').html(data.MobileNo);
                    $('#EmailId').html(data.Email);
                    $('#CorrespondAddress').html(data.CorrespondAddress);
                    $('#CommunicationAddress').val(data.CommunicationAddress);
                    $('#Sector').html(data.Sector);
                    $('#BlockName').html(data.Block);
                    $('#Plot').html(data.PlotNo);
                    $('#AlloteePAN').html(data.PAN);
                    $('#AuthorizedSignatoryName').html(data.AuthorizedSignatory);
                    $('#GSTNo').html(data.GSTNo);
                    $('#AuthorizedSignatoryMobile').html(data.SignatoryMobileNo);
                    $('#AuthorizedSignatoryEmail').html(data.SignatoryEmail);
                    $('#KYAId').html(data.KYAuid);
                    $('#KYAReferenceCode').html(data.KYAReferenceCode);

                    $('#ReqDate').data("kendoDatePicker").value(data.CreatedDate);                   
                    //$('#ReqDate').html(data.CreatedDate);
                    $('#Approver').html(data.Approver);
                    $('#ApprovalDate').data("kendoDatePicker").value(data.ApprovalDate);
                    $('#RejectionReason').html(data.OptionalAction);
                    $('.row-statusReject').css("display", "none");
                    $('.row-StatusApproved').css("display", "none");
                    //$('#ApprovalDate').html(data.ApprovalDate);
                    //$('#Status').html(data.Status);
                    if ($('#Status').val() == "Approved") {
                        $('.row-StatusApproved').show();
                    }
                    
                    if ($('#Status').val() == "Rejected") {
                        $('.row-statusReject').show();
                    }
                    ChangeInAllotteeType();
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert("error");
            }
        });
    }

    function ChangeInAllotteeType() {
        //alert("change in allottee type");
        if ($('#AllotteeType').html() == "Company") {
            $('#_AllotteeName').text("Name Of Organisation");
            $('#_MobileNo').text("Organisation's Contact No");
            $('#_Email').text("Organisation's Email Id");
            //$('#lbl-idproof').text("Organisation PAN/GST Reg.");
            $('#_AlloteePAN').text("Organisation PAN")
            $('.row-company').show();
        }
        else {
            $('#_AllotteeName').text("Allottee Name");
            $('#_MobileNo').text("Allottee's Mobile No");
            $('#_Email').text("Allottee's Email Id");
            //$('#lbl-idproof').text("Id Proof")
            $('#_AlloteePAN').text("Allottee PAN")
            $('.row-company').css("display", "none");
        }

        //$('#AllotteeIdFileType').data('kendoDropDownList').dataSource.read();
        //$('#PlotOwnershipFileType').data('kendoDropDownList').dataSource.read();
    }
</script>