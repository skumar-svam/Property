@model NA.PMS.OnlineScheme.SchemeFormViewModel
@using Kendo.Mvc.UI
@using NA.PMS.Common

@{
    ViewBag.Title = "Scheme Form Preview";
    Layout = "~/Areas/Online/Views/Shared/_LayoutOnlineScheme.cshtml";
}

<style>
    .hyperlink {
        cursor: pointer;
    }

    .k-button.k-upload-button {
        margin: 0;
    }

    .k-upload-files {
        margin: 0;
    }

    #blah {
        display: none;
    }

        #blah:hover {
            cursor: pointer;
        }

    .glyphicon-user:hover {
        cursor: pointer;
    }

    #divUserPhoto {
        width: 100px;
        height: 120px;
        float: right;
        margin: 0 0px 20px 0;
    }

    #divUserSign {
        width: 100px;
        height: 40px;
        float: right;
    }

    #UserImage {
        width: 100px;
        height: 120px;
    }

    #UserSign {
        width: 100px;
        height: 40px;
        margin-top: 80px;
    }

    .red {
        color: red;
    }
</style>

<div class="online-registration row-prnt" id="divOnlineForm">
    <div class="row row-prnt">
        <div class="col-md-12 row-prnt">
            <div class="row rw-spce row-prnt">
                <div class="col-md-6 col-sm-6 col-xs-12 col-prnt-lt"><h1 class="gridTitle">Online Application Form</h1></div>
                <div class="col-md-6 col-sm-6 col-xs-12 mandatory col-prnt-rt"><h1 class="gridTitle">Form No: @Model.ApplicationFormId [@Model.ApplicantType]</h1></div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw hdr-ln"></div>
        <div class="col-md-12 content-top-spce row-prnt" id="first-form">
            <div class="inr-bx row-prnt" style="border:solid #e2e3e4; border-width:0 1px 1px">
                <h2 class="blck-heading row-prnt" style="margin-bottom:6px;">Applicant Information</h2>
                <div class="form-bx row-prnt">
                    <div>
                        @Html.HiddenFor(m => m.Id)
                        @Html.HiddenFor(m => m.ApplicantType)
                        @Html.HiddenFor(m => m.ApplicationFormId)
                        @Html.HiddenFor(m => m.EncryptedFormId)
                        @Html.HiddenFor(m => m.ApplicationFormType)
                        @Html.HiddenFor(m => m.ExpansionType)
                        @Html.HiddenFor(m => m.IsApplicationFeePaid)
                        @Html.HiddenFor(m => m.SchemeType)
                        @Html.HiddenFor(m => m.AppType)
                    </div>
                  

                    <div class="row row-prnt-pc row-prnt">
                        <div class="col-md-6 row-prnt-hf-lt">
                            
                            <div class="row row-prnt">
                                <div class="col-md-4 col-40 col-sm-6 col-xs-12 form-group col-prnt-lt">
                                    @Html.Label("Scheme Name", htmlAttributes: new { @class = "required" })
                                </div>
                                <div class="col-md-8 col-60 col-sm-6 col-xs-12 form-group col-prnt-rt">
                                    @Html.TextBoxFor(model => model.SchemeName, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="row row-prnt">
                                <div class="col-md-4 col-40 col-sm-6 col-xs-12 form-group col-prnt-lt">
                                    @Html.Label("Department", htmlAttributes: new { @class = "required" })
                                </div>
                                <div class="col-md-8 col-60 col-sm-6 col-xs-12 form-group col-prnt-rt">
                                    @Html.TextBoxFor(model => model.Department, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="row row-prnt">
                                <div class="col-md-4 col-40 col-sm-3 col-xs-12 form-group">
                                    <label>Applicant Type</label>
                                </div>
                                <div class="col-md-8 col-60 col-sm-3 col-xs-12 form-group rdio-bx" id="FormType">
                                    @Html.TextBoxFor(model => model.ApplicantType, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-40 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                                    @Html.Label("Applicant Constitution", htmlAttributes: new { @class = "required" })
                                </div>
                                <div class="col-md-8 col-60 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                                    @Html.TextBoxFor(model => model.CompanyType, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-40 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                                    @Html.Label("Area Range", htmlAttributes: new { @class = "required" })
                                </div>
                                <div class="col-md-8 col-60 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                                    @Html.TextBoxFor(model => model.AreaRange, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>

                        </div>
                        <div class="col-md-6  row-prnt-hf-rt">

                            <div class="row">
                                <div class="col-md-4 col-40 col-sm-6 col-xs-12">

                                </div>
                                <div class="col-md-8 col-60 col-sm-6 col-xs-12 form-group">
                                    <div class="row">
                                        <div class="col-md-12 text-right" style="margin-bottom:5px;">
                                            <img id="userphoto" src="@Model.UserImage" alt="your image" height="150px" width="140px" name="userImage2" />
                                        </div>
                                        <div class="col-md-12 text-right">
                                            <img id="signature" src="@Model.SignImage" alt="your sign" height="40px" width="140px" name="usersign" />
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="row row-company row-prnt" id="divCompanyInfo">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt">
                            @Html.Label("Applicant", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-rt">
                            @Html.TextBoxFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", placeholder = "", @readonly = "readonly" })
                        </div>
                        <div class="col-md-2 col-20 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("Signing Authority", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.SigningAuthority, new { @class = "form-control", @maxlength = "150", placeholder = "", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="row row-company" id="">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Signatory's Father Name", htmlAttributes: new { @class = "" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.ApplicantMaster, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-company">
                            @Html.Label("Signatory Status", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-company">
                            @Html.TextBoxFor(model => model.SignatoryStatus, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="row" id="divIndividualInfo">
                        @*@{Html.RenderPartial("_IndividualForm", Model);}*@
                    </div>
                </div>
                <div id="CommonInfo" class="form-bx row-prnt">
                   
                    <div class="row row-prnt">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("Permanent Address", htmlAttributes: new { @class = "required lbl-permanent-address" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextAreaFor(model => model.PermanentAddress, new { @class = "form-control", @readonly = "readonly", style = "" })
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("Correspondence Address", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextAreaFor(model => model.CorrespondingAddress, new { @class = "form-control", @maxlength = "500", placeholder = "", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="row row-prnt">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("Email", htmlAttributes: new { @class = "required", @id = "lblCompanyEmail" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @(Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", @maxlength = "150", placeholder = "", @readonly = "readonly" } }))
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("Mobile Number", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.MobileNumber, new { @class = "form-control", @maxlength = "10", placeholder = "", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="row row-prnt">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("GST Number", htmlAttributes: new { @class = "", @id = "" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.ApplicantGSTNumber, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Aadhar Number", htmlAttributes: new { @class = "required", @id = "lblPanNumber" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.AadharNumber, new { @class = "form-control", @maxlength = "16", placeholder = "0000 1111 2222 3333", @readonly = "readonly" })
                            @Html.ValidationMessageFor(model => model.AadharNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row row-prnt">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("PAN", htmlAttributes: new { @class = "required", @id = "lblPanNumber" })
                        </div>

                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.PanNumber, new { @class = "form-control", placeholder = "", @maxlength = "10", @readonly = "readonly" })
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("Annual Income", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.AnnualIncome, new { @class = "form-control textBoxValueRightAlign", @maxlength = "15", @readonly = "readonly" })
                        </div>
                    </div>

                    <div class="row row-prnt">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("EPF Registration No", htmlAttributes: new { @class = "", @id = "" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.EPFRegistrationNo, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-rent col-prnt-lt4">
                            @Html.Label("ESI Registration No", htmlAttributes: new { @class = "", @id = "lblSector" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-rent col-prnt-lt4">
                            @Html.TextBoxFor(model => model.ESIRegistrationNo, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>

                </div>
                <h2 class="blck-heading row-prnt-hd">Payment Information</h2>
                <div class="form-bx">
                    <div class="row row-prnt">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("Form Fee (INR)", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.ApplicationFee, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("Processing Fee", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.ProcessingCharge, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                        </div>
                    </div>
                    <div class="row row-prnt">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("GST(18%) on Form Fee ", htmlAttributes: new { @class = "" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.FormFeeGST, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("GST(18%) on Processing Charge", htmlAttributes: new { @class = "" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.ProcessingChargeGST, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                        </div>
                    </div>
                    <div class="row row-prnt">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("Earnest Money (INR)", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.EarnestMoney, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("Amount Payable (INR)", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.TotalAmount, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                        </div>
                    </div>
                </div>
                <h2 class="blck-heading row-prnt-hd">Refund Information</h2>
                <div class="form-bx row-prnt ">
                    <div class="row row-prnt">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("Bank Name", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.RefundBank, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("Branch Name", htmlAttributes: new { @class = "" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.BranchName, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="row row-prnt">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("Infavour of", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.RefundInfaverof, new { @class = "form-control", @maxlength = "150", placeholder = "", @readonly = "readonly" })
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("Account No", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.RefundAccountNo, new { @class = "form-control textBoxValueRightAlign", @maxlength = "16", placeholder = "", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="row row-prnt">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.Label("IFSC Code", htmlAttributes: new { @class = "" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                            @Html.TextBoxFor(model => model.IFSCCode, new { @class = "form-control textBoxValueRightAlign", @maxlength = "16", placeholder = "", @readonly = "readonly" })
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group">

                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">

                        </div>
                    </div>
                </div>
               
                @if (Model.IsApplicationFeePaid == true)
                {
                    <h2 class="blck-heading" style="">Payment Receipt</h2>
                    <div class="form-bx row-prnt payment_data">
                        <div class="row row-prnt">
                            <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt">
                                @Html.Label("Form No: ")
                            </div>
                            <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt">
                                @Html.TextBoxFor(model => model.ApplicationFormId, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                            <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt">
                                @Html.Label("Status: ")
                            </div>
                            <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt">
                                @Html.TextBoxFor(model => model.SchemePayment.Status, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                        <div class="row row-prnt">
                            <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt">
                                @Html.Label("Consumer Name: ")
                            </div>
                            <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt">
                                @Html.TextBoxFor(model => model.Applicant, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                            <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt">
                                @Html.Label("Amount: ")
                            </div>
                            <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt">
                                @Html.TextBoxFor(model => model.SchemePayment.Amount, new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                        @if (Model.PaymentMode != "Online")
                        {
                            <div class="row row-prnt">
                                <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.Label("Transaction Id: ")
                                </div>
                                <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.TextBoxFor(model => model.SchemePayment.TransactionId, new { @class = "form-control", @readonly = "readonly" })
                                </div>
                                <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.Label("Method: ")
                                </div>
                                <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.TextBoxFor(model => model.SchemePayment.ProductInfo, new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="row row-prnt">
                                <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.Label("UTR No: ")
                                </div>
                                <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.TextBoxFor(model => model.SchemePayment.TransactionKey, new { @class = "form-control", @readonly = "readonly" })
                                </div>
                                <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.Label("Bank Name: ")
                                </div>
                                <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.TextBoxFor(model => model.SchemePayment.BankName, new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row row-prnt">
                                <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.Label("Transaction Id: ")
                                </div>
                                <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.TextBoxFor(model => model.SchemePayment.TransactionId, new { @class = "form-control", @readonly = "readonly" })
                                </div>
                                <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.Label("Method: ")
                                </div>
                                <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.TextBoxFor(model => model.SchemePayment.ProductInfo, new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="row row-prnt">
                                <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.Label("Bank Ref No: ")
                                </div>
                                <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.TextBoxFor(model => model.SchemePayment.BankReferenceNo, new { @class = "form-control", @readonly = "readonly" })
                                </div>
                                <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.Label("Name on Card: ")
                                </div>
                                <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.TextBoxFor(model => model.SchemePayment.NameOnCard, new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.Label("Card Type: ")
                                </div>
                                <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">
                                    @Html.TextBoxFor(model => model.SchemePayment.CardType, new { @class = "form-control", @readonly = "readonly" })
                                </div>
                                <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.Label("Bank Transaction: ")
                                </div>
                                <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt">
                                    @Html.TextBoxFor(model => model.SchemePayment.Mihpayid, new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                        }
                    </div>
                }

                <h2 class="blck-heading" style="margin-bottom:0px;margin-top:20px;">Documents Required</h2>
                <div class="row">
                    <div class="col-md-12 k-grid-content row-prnt" style="page-break-before:always">
                        @(Html.Kendo().Grid<NA.PMS.OnlineScheme.SchemeDocumentViewModel>()
                                .Name("gridDocs")
                                .Columns(columns =>
                                {
                                    columns.Bound(c => c.Id).Hidden(true);
                                    columns.Bound(c => c.Sno).Title("Sl. No.").Width(100);
                                    columns.Bound(c => c.DocumentName).Title("Description").Encoded(false);
                                    columns.Bound(c => c.PathName).Title("File").Width(220).ClientTemplate("# if (UploadedDocument != null) {#<a onclick='' href='#=PathName#' class='hyperlink' target='_blank'>View Docs</a>#}else {#<span></span>#} #").Filterable(false);
                                    columns.Bound(c => c.PathName).Hidden(true);
                                    columns.Bound(c => c.ParentDocumentType).Title(" ").Hidden(true);
                                })
                                .Resizable(resize => resize.Columns(true))
                                .AutoBind(true)
                                .DataSource(dataSource => dataSource
                                    .Ajax()
                                    .Model(model => model.Id(c => c.Id))
                                    .ServerOperation(true)
                                    .Group(groups => groups.Add(p => p.ParentDocumentType))
                                    //.Read(read => read.Action("GetUploadedDocumentsForOnlineForm", "Application").Data("FilterFormId"))
                                    .Read(read => read.Action("GetUploadedDocumentsAsDataSource", "Housing").Data("FilterFormId"))
                                )
                        )
                    </div>
                    @*Use in Application Form Print*@
                    <div id="documenttable">
                        @Html.Raw(Model.DocumentsTable)
                    </div>
                </div>
                <h2 class="blck-heading" style="">DECLARATION BY THE APPLICANT</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-12">
                            <label style="padding-left:30px;">
                                <input type="checkbox" name="checboxDeclaration" id="checboxDeclaration" checked="checked" />&nbsp;
                                I/We hereby declare that the information, submitted with application form, are true to the best of our knowledge. Nothing has been concealed 
                                and no part of it is false. I/We further declare that we have carefully read and understood the terms and conditions for allotment of
                                industrial plot and do hereby abide by the same. Each page of the terms &amp; conditions has been signed. I/We are aware, if allotment is 
                                obtained on the basis of false information, the NOIDA may cancel our allotment at any stage and forfeit all the deposits made by me/us.
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="box-button text-center">
                <input type="hidden" id="txt-token" />
                @{
                    if (Model.IsApplicationFeePaid == true)
                    {
                        <input type="button" class="btn btn-default" value="Print" id="btnPrintSchemeForm" />
                    
                        if (Model.IsChallanGenerated != true)
                        {
                            @*<input type="button" value="Proceed To Payment" id="btnPayment" class="btn btn-add" />*@
                            <input type="button" value="Generate Challan" id="btn-token" onclick="GenerateToken()" class="btn btn-add" />
                            @*<input type="button" value="Print Form" id="btn-token" onclick="PrintDiv()" class="btn btn-add" />*@
                        }
                        else
                        {
                            if (Model.PaymentMode == "Offline")
                            {
                                @*<input type="button" class="btn btn-default" value="Re-Print Challan" id="btn-reprint-challan" />*@
                                <span class="red">
                                    <span>Please update your challan (RTGS/NEFT) to generate reciept. </span> 
                                    <input type="button" value="Update Challan" id="btn-upload-challan" class="btn btn-add" />
                                </span>
                            }
                            if (Model.PaymentMode == "Offline_Updated")
                            {
                                <input type="button" class="btn btn-default" value="Print" id="btnPrintSchemeForm" />
                                <span class="red">Challan (RTGS/NEFT) has been updated. You will get notification after form validation.</span>
                            }
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>

@{Html.RenderPartial("_SchemeFormPayment");}

@{ if (Model.IsApplicationFeePaid == true) { Html.RenderPartial("_PartialPrintSchemeForm"); }}

<div id="divDocumentView" style="overflow:hidden">
    <div class="row">
        <div class="col-md-12 no-margin no-padding" id="divPageView" style="overflow:hidden">
            <iframe style="border-width:0;" id="ifrmViewPdf"></iframe>
        </div>
        <div class="col-md-12" style="text-align:center;">
            <input type="button" value="Print Challan" id="btn-token" onclick="PrintChallan()" class="btn btn-add" />
        </div>
    </div>
</div>


<script type="text/javascript">

    $(document).ready(function () {

        $("#documenttable").hide();
        
        var radiobtnVal = $('#ApplicantType').val();
        if (radiobtnVal == "Company") {
            $('.lbl-permanent-address').text("Registered Office");
            $('#divIndividualInfo').css("display", "none");
            $('.row-company').show();
            $("label[for='Applicant']").html("Company");
        }
        else if (radiobtnVal == "Individual") {
            //$('.lbl-permanent-address').text("Permanent Address");
            //$('#divIndividualInfo').show();
            //$('.row-company').css("display", "none");
            //$("label[for='Applicant']").html("Applicant");
        }

        $('.single').attr("disabled", true);
        $('.inpchk').attr("disabled", "disabled");

        $("input[type='checkbox'][name=checboxDeclaration]").attr("disabled", "disabled");
       
        var gender = $("#Gender").val();
        if (gender != "Company") {
            $("#FirstName").attr("readonly", "readonly");
            $("#MiddleName").attr("readonly", "disabled");
            $("#LastName").attr("readonly", "readonly");
            $("#FatherName").attr("readonly", "readonly");
            $("#MotherName").attr("readonly", "readonly");
        }

        $('#divDocumentView').kendoWindow({
            modal: true,
            title: "Document",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "15%"
            },
            width: "70%", height: "80%"
        });

    });

    function FilterFormId() {
        return {
            ApplicationFormId: $("#ApplicationFormId").val(),
            DepartmentId: 5
        };
    }

    function GenerateToken() {
        $.ajax({
            url: "https://bankapi.mynoida.in/token",
            data: {
                username: "Admin",
                password: "Admin",
                grant_type: 'password',
                //  scope:'openid offline_access',
            },
            method: 'POST',
            success: function (tdata) {
                $('#txt-token').val(tdata.access_token);

                $.ajax({
                    url: "/Online/Default/SaveAndGetOnlineSchemeFormCallan",
                    data: { ApplicationFormId: $('#ApplicationFormId').val() },
                    method: 'POST',
                    success: function (fdata) {
                        if (fdata != null && fdata.FormApiChallan != null) {
                            var accessToken = $('#txt-token').val();
                            var dts = fdata.FormApiChallan;

                            GenerateChallan(dts, accessToken);
                        }
                    },
                    error: function (err) {
                        alert(err.responseText);
                    }
                })
            },
            error: function (err) {
                alert(err.responseText);
            }
        })
    }

    function GenerateChallan(dt, accessToken) {
        $.ajax({
            url: "https://bankapi.mynoida.in/Api/Receipt/CreateChallan",
            data: JSON.stringify(dt),
            contentType: "application/json; charset=utf-8",
            method: 'POST',
            beforeSend: function (xhr) {
                xhr.setRequestHeader("Authorization", "Bearer " + accessToken);
            },
            success: function (cdata) {
                if (cdata["StatusCode"] == 200) {
                    //$("#divDocumentView").empty();
                    $("#divPageView").empty();
                    //$("#divDocumentView").html(cdata["ChallanContent"]);
                    $('#divPageView').html(cdata["ChallanContent"]);
                    //$("#divDocumentView").append($('<iframe src=' + link + ' style="width:900px;height:500px;overflow:hidden;"></iframe>'));
                    $("#divDocumentView").data("kendoWindow").center();
                    $("#divDocumentView").data("kendoWindow").open();
                    $("#divDocumentView").data("kendoWindow").pin();
                }
            },
            error: function (err) {
                alert(err.responseText);
            }
        })
    }
   

    function OpenDocument(row) {
        $("#divDocumentView").empty();
        var tr = $(row).parent().parent();
        var link = $(tr).children("td:eq(5)").text();
        $("#divDocumentView").append($('<iframe src=' + link + ' style="width:900px;height:500px;overflow:hidden;"></iframe>'));
        $("#divDocumentView").data("kendoWindow").center();
        $("#divDocumentView").data("kendoWindow").open();
        $("#divDocumentView").data("kendoWindow").pin();
    }

    function PrintDiv() {
        var contents = document.getElementById("divOnlineForm").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('<style>.row-prnt{width:100%;display:table}.row-prnt-pc{width:100%}.row-prnt-hf-lt{width:50%; float:left}.row-prnt-hf-rt{width:50%; float:right}</style>');
        frameDoc.document.write('<style>.form-group{padding:6px 0 6px 0}.col-prnt-lt{width:50%;float:left}.col-prnt-rt{width:50%;float:right}.hdr-ln{display:none;}</style>');
        frameDoc.document.write('<style>#divUserPhoto{width:80px;height:100px;float:right;}#divUserSign{width:80px;height:100px;float:right}</style>');
        frameDoc.document.write('<style>#UserImage{width:80px;height:100px;float:right;margin-right:10px;}#UserSign{width:80px;height:30px;margin-top:70px;margin-right:15px;float:right}</style>');
        frameDoc.document.write('<style>#imguser{width:80px;height:90px;float:right;}#imgsign{width:80px;height:20px;margin-top:60px;float:right}.row-prnt-pc{height:100px;width:100%}</style>');
        frameDoc.document.write('<style>.col-prnt-lt4{width:25%;float:left;display:inline-block}h1{font-size:24px}h2{font-size:20px}</style>');
        frameDoc.document.write('<style>.col-prnt-hd{width:100%;text-align:left;}label{padding-left:10px}textarea{width:95%}.k-datepicker .k-input{width:95%}</style>');
        frameDoc.document.write('<style>.btn{display:none}</style>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }

