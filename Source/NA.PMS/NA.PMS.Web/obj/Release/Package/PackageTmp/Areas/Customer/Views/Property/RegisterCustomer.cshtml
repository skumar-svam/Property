@model  NA.PMS.Model.NACustomer
@using Kendo.Mvc.UI
@using System.Web.Optimization
@using NA.PMS.Common
@{
    ViewBag.Title = "Register Customer";
    Layout = "~/Views/Shared/_BlankCustomer.cshtml";
}

<style type="text/css">
    .col-md-4.col-pad-left {
        margin-top: 0;
        padding: 0 7px 0 0;
    }

    .col-md-4.col-pad-center {
        margin-top: 0;
        padding: 0 7px 0 7px;
    }

    .col-md-4.col-pad-right {
        margin-top: 0;
        padding: 0 0 0 7px;
    }

    /*.form-control {
        display: inline;
        width: 100%;
    }*/

    .logo-gda {
        background: #00c097 url("../../Content/Images/logo-gda.png") no-repeat 20px center;
        width: 100%;
        height: 76px;
    }

    #step2 {
        display: none;
    }

    #step3 {
        display: none;
    }

    #next_button {
        /*display: none;*/
    }

    .resend-otp:hover {
        color: blue;
        cursor: pointer;
        text-decoration: underline;
    }

    #tblLogin h1 {
        display: none;
    }

    #loginPad {
        padding-top: 40px;
    }

    span.k-dropdown .k-dropdown-wrop {
        border-radius: 0;
        height: 30px;
    }

    @@media screen and (max-width: 767px) {
        .row {
            margin-left: 0;
            margin-right: 0;
        }
    }

    @@media screen and (min-width:992px) and (max-width: 1199px) {
        .col-md-offset-1 {
            margin-left: 0;
        }

        .col-md-10 {
            width: 100%;
        }
    }

    @@media screen and (min-width:768px) and (max-width: 991px) {
        #BlockDropdown {
            display: block;
            max-width: 120px;
            z-index: 9999;
        }
    }

    @@media screen and (max-width: 767px) {
        #BlockDropdown {
            display: inline-block;
            max-width: 120px;
            z-index: 9999;
        }
    }

    #loginPad {
        padding-top: 40px;
        width: 75%;
    }

    .k-widget.k-dropdown.k-header {
        border-radius: 0;
        height: 30px;
    }

    .k-dropdown-wrap.k-state-default {
        border-radius: 0;
        height: 30px;
    }

    .k-dropdown-wrap .k-input {
        line-height: 1.90em;
    }

    .k-dropdown-wrap.k-state-disabled {
        border-radius: 0;
        height: 30px;
        line-height: 1.90em;
    }

    .form-control {
        width: 100%;
        border-radius: 0;
        height: 32px;
        display: inline;
    }

    .pad-bottom {
        margin-bottom: 12px;
    }

    .nw-upld-help-txt {
        font-size: 81%;
        display: block;
        padding-top: 12px;
    }

    .input-group {
        padding: 0 15px;
    }

    .setup-content {
        padding: 40px;
        padding-top: 20px;
    }

    h4 {
        font-weight: 700;
        border-bottom: blue;
    }

    .left {
        padding-left: 20px;
        padding-right: 0;
    }

    .right {
        padding-left: 0;
        padding-right: 20px;
    }

    .pad {
        padding-left: 15px;
        padding-right: 0;
    }
</style>
<script src="//code.jquery.com/ui/1.11.2/jquery-ui.js"></script>

<div class="container" id="loginPad">
    @using (Html.BeginForm("RegisterCustomerDetails", "Property", FormMethod.Post, new { @class = "form-horizontal", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true)
        <div class="row">
            <div class="col-lg-12" style="background:rgb(0, 161, 130) none repeat scroll 0 0; width:100%; height:60px; padding-left:10px; box-sizing:border-box">
                <img src="~/Content/Images/logo-noida-small.png" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-12" style="background:#fff; padding-left:40px;">
                <h4>Register New Customer</h4>
            </div>
        </div>
        //steps here
        <div>
            @Html.HiddenFor(model => model.DepartmentId)
            @Html.HiddenFor(model => model.PropertyId)
            @Html.HiddenFor(model => model.Sector)
            @Html.HiddenFor(model => model.Block)
            @Html.HiddenFor(model => model.CaptchaInput, new { @id = "hdn-captcha-input" })
            @Html.HiddenFor(model => model.RandomKeyVal, new { @id = "hdn-random-key" })
            <input type="hidden" id="hdn-otp" />
        </div>
        <div class="row setup-content" id="step1" style=" background:#fff;">
            <div class="col-md-6 right">
                <div class="row pad-bottom ">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <span style="color: red; font-size: x-small">*</span>@Html.Label("Registration Id")
                        <img title="Please enter your Registration Id." src="~/Content/Images/information16.png" />
                        @*@Html.TextBoxFor(m => m.RegistrationId, new { @class = "form-control", @maxlength = "8", @minlength = "8", onkeypress = "return IsNumeric(event);" })*@
                        @(Html.Kendo().DropDownListFor(model => model.RegistrationId)
                        .Filter("contains")
                        .DataTextField("Text")
                        .DataValueField("Id")
                        .OptionLabel(" --- Select ---")
                        .DataSource(source =>
                        {
                            source.Custom()
                            .ServerFiltering(true)
                            .ServerPaging(true)
                            .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                            .Transport(transport => transport.Read(read => read.Action("GetRegistrationIdListAsDataSource", "Property", new { area = "Customer" })))
                            .Schema(schema => schema.Data("Data").Total("Total"))
                            .PageSize(100);
                        })
                        .HtmlAttributes(new { style = "width: 100%;border-radius: 0;height: 30px;"})
                        .Events(e => e.Change("ChangeInRegistrationId"))
                        )
                        <br />
                        @Html.ValidationMessageFor(m => m.RegistrationId, "", new { @class = "red" })
                    </div>

                </div>
                <div class="row pad-bottom">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <span style="color: red; font-size: x-small">*</span> @Html.Label("Department")
                        <img title="Please enter your Department." src="~/Content/Images/information16.png" />
                        @Html.TextBoxFor(m => m.Department, new { @class = "form-control", @maxlength = "100", @minlength = "2", @readonly = "readonly" })
                        @Html.ValidationMessageFor(m => m.Department, "", new { @class = "red" })
                    </div>
                </div>
                <div class="row pad-bottom">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <span style="color: red; font-size: x-small">*</span>@Html.Label("User Name")
                        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", @readonly = "readonly" })
                        @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "red" })
                    </div>
                </div>
                <div class="row pad-bottom">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <span style="color: red; font-size: x-small">*</span>@Html.Label("Customer Name")
                        <img title="Please enter cutomer Name." src="~/Content/Images/information16.png" />
                        @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", @maxlength = "100", @minlength = "2" })
                        @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "red" })
                    </div>
                </div>
                <div class="row pad-bottom">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <span style="color: red; font-size: x-small">*</span>@Html.Label("Mobile No")
                        <img title="Please enter your Mobile Number." src="~/Content/Images/information16.png" />
                        @Html.TextBoxFor(m => m.MobileNo, new { @class = "form-control", @maxlength = "10", onkeypress = "return IsNumeric(event);" })
                        <br />
                        @Html.ValidationMessageFor(m => m.MobileNo, "", new { @class = "red" })
                    </div>
                </div>
                <div class="row pad-bottom">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        @Html.LabelFor(m => m.Email) <img title="Please enter your Email Id." src="~/Content/Images/information16.png" />
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                        <br />
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "red" })
                    </div>
                </div>
            </div>
            <div class="col-md-6 left">
                <div class="row pad-bottom">
                    <div class="col-md-4 col-pad-left">
                        <label>Sector</label><span style="color: red; font-size: x-small">*</span>
                        @*<img title="Please select Sector from the dropdown." src="~/Content/Images/information16.png" />*@
                        @(Html.Kendo().DropDownListFor(model => model.SectorId)
                        .DataValueField("Id")
                        .DataTextField("Text")
                        .OptionLabel("--Select--")
                        .Filter("contains")
                        .DataSource(source =>
                        {
                            source.Custom()
                            .ServerFiltering(true)
                            .ServerPaging(true)
                            .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                            .Transport(transport => transport.Read(read => read.Action("GetSectorListAsDataSource", "Property", new { area = "Customer" })))
                            .Schema(schema => schema.Data("Data").Total("Total"))
                            .PageSize(100);
                        })
                        .HtmlAttributes(new { style = "width: 100%;border-radius: 0;height: 30px;", @class = "input-disabled " })
                        )
                    </div>
                    <div class="col-md-4 col-pad-center">
                        <label>Block</label><span style="color: red; font-size: x-small">*</span>
                        @*<img title="Please select Block from the dropdown." src="~/Content/Images/information16.png" />*@
                        @(Html.Kendo().DropDownListFor(model => model.BlockId)
                        .DataValueField("Id")
                        .DataTextField("Text")
                        .OptionLabel("--Select--")
                        .Filter("contains")
                        .CascadeFrom("SectorId")
                        .DataSource(source =>
                        {
                            source.Custom()
                            .ServerFiltering(true)
                            .ServerPaging(true)
                            .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                            .Transport(transport => transport.Read(read => read.Action("GetBlockListAsDataSource", "Property", new { area = "Customer" }).Data("FilterSectorId")))
                            .Schema(schema => schema.Data("Data").Total("Total"))
                            .PageSize(100);
                        })
                        .HtmlAttributes(new { style = "width: 100%;border-radius: 0;height: 30px;", @class = "input-disabled " })
                        )
                    </div>
                    <div class="col-md-4 col-pad-right">
                        @Html.Label("Plot/Unit/Shop No")@*<span style="color: red; font-size: x-small">*</span>*@
                        @*<img title="Please enter Plot/Shop/Flat No." src="~/Content/Images/information16.png" />*@
                        @Html.TextBoxFor(m => m.PlotNo, new { @class = "form-control ", @maxlength = "6" })

                        @Html.ValidationMessageFor(m => m.PlotNo, "", new { @class = "red" })
                    </div>
                </div>
                <div class="row pad-bottom">
                    <div class="col-md-12 col-sm-12 col-xs-12 ">
                        @Html.Label("Security Question") <span style="color: red; font-size: x-small">*</span>
                        @(Html.Kendo().DropDownListFor(model => model.SecurityQuestion)
                        .DataValueField("Value")
                        .DataTextField("Value")
                        .OptionLabel("---Select--")
                        .Filter("contains")
                        .DataSource(source =>
                        {
                            source.Custom()
                            .ServerFiltering(true)
                            .ServerPaging(true)
                            .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                            .Transport(transport => transport.Read(read => read.Action("GetSecurityQuestioinListAsDataSource", "Property", new { area = "Customer" })))
                            .Schema(schema => schema.Data("Data").Total("Total"))
                            .PageSize(100);
                        })
                    .HtmlAttributes(new { style = "width: 100%;margin-right:15px;border-radius: 0;height: 30px;", @class = "" })
                        )
                    </div>
                </div>
                <div class="row pad-bottom">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <span style="color: red; font-size: x-small">*</span>@Html.LabelFor(m => m.SecurityAnswer) <img title="Please enter Answer." src="~/Content/Images/information16.png" />
                        @Html.TextBoxFor(m => m.SecurityAnswer, new { @class = "form-control", @maxlength = "50", @minlength = "2" })

                        @Html.ValidationMessageFor(m => m.SecurityAnswer, "", new { @class = "red" })
                    </div>




                </div>
                <div class="row pad-bottom">
                    <div class="col-md-6 col-sm-6 col-xs-12" style="margin-bottom:0px;">
                        <span style="color: red; font-size: x-small">*</span>@Html.Label("Upload File-Customer Id")
                        <img title="Please select your Id prrof that you want to upload for verification." src="~/Content/Images/information16.png" />
                        @{
                            List<SelectListItem> IdFileList = new List<SelectListItem>();
                            IdFileList.Add(new SelectListItem { Text = "PAN Card", Value = "PANCard" });
                            IdFileList.Add(new SelectListItem { Text = "Aadhar Card", Value = "AadharCard" });
                        }
                        @Html.DropDownListFor(model => model.CustomerIdFiletype, IdFileList, "-- select your Id file --", new { @class = "form-control nw-upld-select" })
                    </div>
                    <div class="col-md-6 col-sm-6 col-xs-12 pad">
                        <span class="nw-upld-help-txt">Only jpg, png and gif (50KB allowed)</span>
                        <input style="" type="file" onchange="ChangeIdentityFile()" id="CustomerIdFile" name="files" />
                    </div>
                </div>
                <div class="row pad-bottom">
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        <span style="color: red; font-size: x-small">*</span>@Html.Label("Upload-Authority Letter")
                        <img title="Please select Authority Type Letter that you want to upload for verification." src="~/Content/Images/information16.png" />
                        @{
                            List<SelectListItem> LetterFileList = new List<SelectListItem>();
                            LetterFileList.Add(new SelectListItem { Text = "Allotment Letter", Value = "AllotmentLetter" });
                            LetterFileList.Add(new SelectListItem { Text = "Transfer Letter", Value = "TransferLetter" });
                        }
                        @Html.DropDownListFor(model => model.AuthorityLetterType, LetterFileList, "-- Select  Doc --", new { @class = "form-control nw-upld-select" })
                    </div>
                    <div class="col-md-6 col-sm-6 col-xs-12 pad">
                        <span class="nw-upld-help-txt">Only jpg, png and gif(50KB allowed)</span>
                        <input style="max-width:180px;" type="file" id="AuthorityLetterFile" onchange="ChangeAuthorityLetter()" name="files" />
                    </div>
                </div>
                <div class="row pad-bottom">
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        <div class="nw-inline-lbl">
                            <span style="color: red; font-size: x-small">*</span><label>Enter Captcha</label>
                            <img title="Please enter below captcha." src="~/Content/Images/information16.png" />
                        </div>
                        @Html.TextBoxFor(m => m.CaptchaInput, new { @class = "form-control captcha-bg", @readonly = "readonly" })
                    </div>
                    <div class="col-md-6 pad">
                        @Html.TextBoxFor(m => m.CaptchaValue, new { @class = "form-control", @maxlength = "10", @placeholder = "Enter security code", style = "margin-top:23px;" })
                    </div>
                </div>
            </div>

            <div class="col-sm-12 text-right pad" id="row-btn-continue">
                <input type="button" style="display:inline-block; width:auto; height:40px; border-radius:0;" class="btn btn-primary  btn-block" id="btn-next" value="Continue ->" />
            </div>
        </div>

        <div class="row  setup-content" id="step2" style="padding:30px 0 30px 0; background:#fff;">
            <div class="row pad-bottom">
                <div class="col-md-5 col-md-offset-3 text-center">
                    <div class="input-group">
                        <span class="input-group-addon"><label>Enter OTP here</label></span>
                        <input type="text" id="txt-otp" class="form-control" style="height:35px;" />
                    </div>
                </div>
                <div class="col-md-4">
                    <a class="resend-otp" onclick="SendOTP();"><b>Resend OTP</b></a>
                </div>
            </div>
            <div class="row text-center ">
                <div class="col-sm-12 text-right">

                    <input type="button" id="btn-submit" class="btn btn-primary" value="Submit" style="padding:10px 35px; border-radius:0;" />
                </div>
            </div>
        </div>
    }

</div>

<script type="text/javascript">
    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }

    function FilterSectorId() {
        return { SectorId: $('#SectorId').val() }
    }

    function ChangeAuthorityLetter() {
        var letter = $("#AuthorityLetterFile").val();
        var letterType = letter.split('.');
        if (letterType[1] == "jpg" || letterType[1] == "png" || letterType[1] == "gif" || letterType[1] == "jpeg") {
            if ($("#AuthorityLetterType").val() == "") {
                alert("Please select a Letter");
                return false;
            }
        }
        else {
            alert("Only jpg, png and gif files are allowed");
            $('#AuthorityLetterFile').val('');
            return false;
        }
    }

    function ChangeIdentityFile() {
        var identityFile = $("#CustomerIdFile").val();
        var fileType = identityFile.split('.');
        if (fileType[1] == "jpg" || fileType[1] == "png" || fileType[1] == "gif" || fileType[1] == "jpeg") {
            if ($("#CustomerIdFiletype").val() == "") {
                alert("Please select a file");
                return false;
            }
        }
        else {
            alert("Only jpg, png and gif files are allowed");
            $('#CustomerIdFile').val('');
            return false;
        }
    }

    var OTPVal;
    $(document).ready(function () {
        //function GetDropdownData(requestUrl, successFuntion) {
        //    jQuery.support.cors = true;
        //    $.ajax({
        //        url: requestUrl,
        //        type: 'GET',
        //        dataType: 'json',
        //        success: function (data) {
        //            successFuntion(data);
        //        },
        //        error: function (x, y, z) {
        //        }
        //    });
        //}

        $('#btn-next').click(function () {
            var flag = ValidateInputField();
            //var flag1 = ValidateDocument("IdFile");
            //var flag2 = ValidateDocument("AuthorityLetter");

            if (flag == true) {
                $('#step1').css("display", "none");
                $("#step2").show();
                $("#step-1-lnk").attr("disabled", "disabled");
                $("#step-1-lnk").removeClass("btn-primary");
                $("#step-1-lnk").addClass("btn-default");
                $("#step-2-lnk").removeAttr("disabled", "disabled");
                $("#step-2-lnk").addClass("btn-primary");
                $("#row-btn-continue").css('display', 'none');
                SendOTP();
                $("#CaptchaValue").val('');
            }

        });

        $('#btn-back').click(function () {
            $('#step1').show();
            $("#step2").css("display", "none");
            $("#row-btn-continue").show();
            $("#step-2-lnk").removeClass("btn-primary");
            $("#step-2-lnk").addClass("btn-default");
            $("#step-1-lnk").attr("disabled", "disabled");
            $("#step-1-lnk").addClass("btn-primary");
        });

        $('.resend-otp').click(function () {
            SendOTP();
        });


        $('#btn-submit').click(function () {
            var otp = $('#hdn-otp').val();
            if (otp != "" && otp != 0 && otp != undefined) {
                var userOTP = $('#txt-otp').val();
                if (userOTP == otp) {
                    //$('#step2').css("display", "none");
                    $('#txt-otp').val('');
                    $('#Sector').val($('#SectorId').data("kendoDropDownList").text());
                    var block = $('#BlockId').val() == "" ? "NA" : $('#BlockId').data("kendoDropDownList").text();
                    $('#Block').val(block);
                    var formdata = new FormData($('form').get(0));
                    $.ajax({
                        dataType: 'json',
                        type: 'Post',
                        contentType: false, // Not to set any content header
                        processData: false, // Not to process data
                        data: formdata,
                        url: "/Customer/Property/RegisterCustomer",
                        success: function (result) {
                            if (result == '@ReturnType.Saved') {
                                alert("You registered successfully.");
                                window.location.href = "/Customer/Property/";
                            }
                            else {
                                alert("Provider failed to save, try again");
                            }
                        },
                        error: function (ajaxRequest, strError) {
                            alert("Network error, try again");
                        }
                    });
                }
                else {
                    alert("Incorrect OTP. Please enter again.");
                    $('#txt-otp').val('');
                    return false;
                }
            }
            else {
                alert("Network error. Please try again later.");
            }
        });

    });

    function IsValidEmail(email) {
        var pattern = /^\b[A-Z0-9._%-]+@@[A-Z0-9.-]+\.[A-Z]{2,4}\b$/i;
        return pattern.test(email);
    }

    function SendOTP() {
        //$('.resend-otp').css("display", "none");
        var mobileNo = $("#MobileNo").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ mobileNo: mobileNo }),
            url: '/Customer/Property/SendCustomerOTP',
            success: function (result) {
                if (result.flag == true) {
                    $("#hdn-otp").val(result.OTPVal);
                    alert("OTP has been sent to your Mobile number");
                }
                else {
                    alert("Provider failed to send");
                }
            },
            error: function (ajaxRequest, strError) {
            }
        });
    }


    function ValidateDocument(filetype) {
        var flag = true;
        //if (filetype == "IdFile") {
        //    var idFile = document.getElementById('CustomerIdFile');
        //    var fileSize = idFile.files[0].size;
        //    var sizeInKB = fileSize / 1024
        //    if (sizeInKB > 50) {
        //        $('#btn-next').prop('disabled', false);
        //        alert("Please select Customer Id File of 50 KB");
        //        flag = false;
        //    }
        //}
        //else if (filetype == "AuthorityLetter") {
        //    var letter = document.getElementById('AuthorityLetterFile');
        //    var fileSize = letter.files[0].size;
        //    var sizeInKB = fileSize / 1024
        //    if (sizeInKB > 50) {
        //        $('#btn-next').prop('disabled', false);
        //        alert("Please select Authority Letter File of 50 KB");
        //        flag = false;
        //    }
        //}
        return flag;
    }

    function ChangeInRegistrationId() {
        var RegistrationId = $("#RegistrationId").val();
        $.ajax({
            url: '/Customer/Property/ValidateCustomerRegistration',
            type: 'POST',
            dataType: 'json',
            data: { RegistrationId: RegistrationId },
            success: function (result) {
                if (result.IsActive == false) {
                    alert("Registration Id already exists");
                    return false;
                }
                else if (result.IsExist == false) {
                    alert("Registration Id doesn't exists");
                    return false;
                }
                else {
                    $('#SectorId').data("kendoDropDownList").value(result.SectorId);
                    $('#BlockId').data("kendoDropDownList").value(result.BlockId);
                    $('#PlotNo').val(result.PlotNo);
                    $('#PropertyId').val(result.PropertyId);
                    $('#DepartmentId').val(result.DepartmentId);
                    $('#Department').val(result.Department);
                    $('#UserName').val(result.RegistrationId);
                    $('#CustomerName').val(result.Applicant);
                    $('#MobileNo').val(result.MobileNo);
                    $('#Email').val(result.Email);
                }
            }
        });
    }

    function ValidateInputField() {
        var flag = true;
        debugger;

        if ($("#RegistrationId").val() == '') {
            alert("Please select Registration Id");
            flag = false;
        }
        else if ($("#RegistrationId").val().length > 8) {
            alert("Registration id can't be more than 8 digits.");
            flag = false;
        }
        else if ($('#SectorId').val() == '') {
            alert("Please select Sector");
            flag = false;
        }
        else if ($('#PlotNo').val().trim() == '') {
            alert("Please enter Plot/Shop/Flat No.");
            flag = false;
        }
        else if ($('#UserName').val().trim() == '') {
            alert("Please enter User Name");
            flag = false;
        }
        else if ($("#SecurityQuestion").val() == '') {
            alert("Please select Security Question.");
            flag = false;
        }
        else if ($("#SecurityAnswer").val() == "") {
            alert("Please enter Answer");
            flag = false;
        }
        else if ($("#CustomerIdFiletype").val() == "") {
            debugger;
            alert("Please select id file Type");
            flag = false;
        }
        else if ($("#CustomerIdFile").val() == "") {
            debugger;
            alert("Please select id file");
            flag = false;
        }

        else if ($("#AuthorityLetterType").val() == "") {

            alert("Please select Authority letter Type");
            flag = false;
        }
        else if ($("#AuthorityLetterFile").val() == "") {
            alert("Please select Authority letter");
            flag = false;
        }
        else if ($("#hdn-captcha-input").val() != $("#CaptchaValue").val().trim()) {
            alert("Please enter correct secuity code !.");
            flag = false;
        }
        else if ($("#CustomerIdFile").val() != "") {
            flag = ValidateDocument("IdFile");
        }
        else if ($("#AuthorityLetterFile").val() != "") {
            flag = ValidateDocument("AuthorityLetter");
        }



        return flag;
    }

    function ClearInputFields() {
        $('#RegistrationId').data("kendoDropDownList").value('');
        $('#SectorId').data("kendoDropDownList").value('');
        $('#BlockId').data("kendoDropDownList").value('');
        $('#CustomerIdFileType').data("kendoDropDownList").value('');
        $('#AuthorityLetterType').data("kendoDropDownList").value('');
        $('#PlotNo').val('');
        $('#PropertyId').val('');
        $('#DepartmentId').val('');
        $('#Department').val('');
        $('#UserName').val('');
        $('#CustomerName').val('');
        $('#MobileNo').val('');
        $('#Email').val('');
        $('#CustomerIdFile').val('');
        $('#AuthorityLetterFile').val('');
    }
</script>
