<script type="text/javascript">
    function FilterDepartment() {
        return { departmentId: $('#DepartmentId').val() }
    }
    function FilterTemplateDepartment() {
        return {
            departmentId: $('#DepartmentId').val(),
            templateId: 0
            //templateId: $('#LetterId').val()
        }
    }
    function FilterForServiceRequest() {
        return {
            rid: $('#Rid').val()
        }
    }

    function GetServiceRequestStatusForLetter() {
        var rid = $('#Rid').val();
        var letterId = $('#LetterId').val();
        if (rid != "" && letterId != "") {
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json;charset=utf-8",
                data: JSON.stringify({ rid: rid, letterId: letterId }),
                url: '@Url.Action("GetServiceRequestStatusForLetter","Report")',
                success: function (result) {
                    if (result == 0) {
                        alertify.error("Service is not validated.");
                        return false;
                    }
                    else {
                        alertify.success("validated");
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Something is wrong, try again later.");
                }
            });
        }
    }

    function GetServiceRequestStatus() {
        var reqNo = $('#RequestId').val();
        //alert(reqNo);
        if (reqNo != null && reqNo != "") {
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json;charset=utf-8",
                data: JSON.stringify({ requestId: reqNo }),
                url: '@Url.Action("GetServiceRequestStatus","Report")',
                success: function (result) {
                    if (result != null) {
                        if (result == 8) {
                            $('#RequestStatus').val("Initiated");
                        }
                        else {
                            $('#RequestStatus').val("Validated");
                        }
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Something is wrong, try again later.");
                }
            });
        }
    }

    function GetAllotteeDetails() {
        var rid = $('#Rid').val();
        if (rid != "") {
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json;charset=utf-8",
                data: JSON.stringify({ rid: rid }),
                url: '@Url.Action("GetAllotteDetailsToGenerateLetter","Report")',
                success: function (result) {
                    if (result != null) {
                        $('#ApplicantName').val(result.ApplicantName);
                        $('#PropertyNo').val(result.PropertyNo);
                        $('#CorresspondentAddress').val(result.CorresspondentAddress);
                        $('#PermanentAddress').val(result.PermanentAddress);
                        $('#MobileNo').val(result.MobileNo);
                        $('#Email').val(result.Email);
                        $('#KYAStatusId').val(result.KYAStatusId);
                        $('#KYAStatus').val(result.KYAStatus);
                    }
                    else {
                        alertify.error("There is some error, try again");
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Something is wrong, try again later.");
                }
            });
        }
    }

    $(".num-only").keydown(function (e) {
        // Allow: backspace, delete, tab, escape, enter and .
        if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110, 190]) !== -1 ||
            // Allow: Ctrl+A, Command+A
            (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
            // Allow: home, end, left, right, down, up
            (e.keyCode >= 35 && e.keyCode <= 40)) {
            // let it happen, don't do anything
            return;
        }
        // Ensure that it is a number and stop the keypress
        if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
            e.preventDefault();
        }
    });

    $('#Rid').change(function () {
        var rid = $('#Rid').val();
        //alert(rid);
        if (rid == "") {
            alertify.error("Please enter Registration id.");
            return false;
        }
        else if (rid.length != 8) {
            alertify.error("Registration id length should be 8.");
            return false;
        }
        else {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ rid: rid }),
                url: '/Report/GetPropertyDetailsByRid',
                success: function (result) {
                    if (result != null) {
                        $('#DepartmentId').val(result.DepartmentId);
                        $('#DepartmentName').val(result.DepartmentName);
                        $('#ApplicantName').val(result.ApplicantName);
                        $('#PropertyNo').val(result.PropertyNo);
                        $('#CorresspondentAddress').val(result.CorresspondentAddress);
                        $('#PermanentAddress').val(result.PermanentAddress);
                        $('#MobileNo').val(result.MobileNo);
                        $('#Email').val(result.Email);
                    }
                    else {
                        alertify.error("Registration doesn't exist.");
                        return false;
                    }
                },
                error: function (obj) {
                    alertify.error("Some error occured. Please try again later.");
                }
            });
        }
    });


    $('#btnGenerateLetter').click(function () {
        var rid = $('#Rid').val();
        var departmentId = $('#DepartmentId').val();
        var serviceId = $('#ServiceId').val();
        var letterId = $('#LetterId').val();
        var letterDate = $('#LetterDate').val();
        var KyaStatus = $('#KYAStatus').val();
        //alert($('#LetterId').data("kendoDropDownList").text());
        $('#LetterHeading').text($('#LetterId').data("kendoDropDownList").text());
        if (rid == "" || rid == null) {
            alertify.error("Please select Registration no");
            return false;
        }
        if (rid.length != 8) {
            alertify.error("Registration id length should be 8.");
            return false;
        }
        if (departmentId == "" || departmentId == null) {
            alertify.error("Please select Department");
            return false;
        }
        if (letterDate == "" || letterDate == null) {
            alertify.error("Please enter letter date");
            return false;
        }
        if (letterId == "" || letterId == null) {
            alertify.error("Please select letter type.");
            return false;
        }       
        if (letterId != "13") {
            if ($('#KYAStatusId').val() == "" || $('#KYAStatusId').val() == null) {
                alertify.error("Please complete your KYA.");
                return false;
            }
            //if ($('#KYAStatusId').val() == "2") {
            //    alertify.error("Your KYA from has been " + KyaStatus + ". Please complete your KYA again.");
            //    return false;
            //}
            //if ($('#KYAStatusId').val() == "14") {
            //    alertify.error("KYA from has been Forwarded. Please Approve the KYA.");
            //    return false;
            //}
            if ($('#KYAStatusId').val() != "1") {
                alertify.error("KYA from has been "+ KyaStatus +". Please complete the KYA process.");
                return false;
            }
            else {
                GenerateLetterByService(rid, departmentId, serviceId, letterId, letterDate);
            }
            //GenerateLetterByService(rid, departmentId, serviceId, letterId, letterDate);
        }
        else {
            GenerateLetterByService(rid, departmentId, serviceId, letterId, letterDate);
        }
    });

    function GenerateLetterByService(rid, departmentId, serviceId, letterId, letterDate) {
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rid: rid, departmentId: departmentId, serviceId: serviceId, letterId: letterId, letterDate: letterDate }),
            url: '/Report/GenerateLetterByService',
            success: function (result) {
                if (result == 0) {
                    $("#divLetterBody").html("Service is not approved");
                    $("#divLetterBodyModal").modal('show');
                }
                else {
                    $("#divLetterBody").html(result);
                    //$("#inputdata").before("<div id='divBarcode' class='font-barcode' style='text-align:center;'></div>");
                    generateBarcode();
                    $('#divBarcode').html($('#inputdata').html());
                    $('#inputdata').css("display", "none");
                    $("#divLetterBodyModal").modal('show');
                }
                //alertify.success(result);
            },
            error: function (obj) {
                alertify.error("Some error occured. Please try again later.");
            }
        });
    }


    function PrintDiv() {
        //generateBarcode();
        //var contents = document.getElementById("divmodalbody").innerHTML;
        var contents = document.getElementById("divLetterBody").innerHTML;
        //var contents = document.getElementById("divBarcode").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('<style>#barcodeTarget{ width:30%; margin-left:35%; } #divBarcode{ width:100%; text-align:center; }</style>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }

    $('#downloadLetter').click(function () {
        var rid = $("#Rid").val();
        var departmentId = $("#DepartmentId").val();
        var serviceId = null; //$('#ServiceId').val();
        var letterId = $('#LetterId').val();
        var letterDate = $('#LetterDate').val();
        if (letterDate == "") {
            alertify.error("Please enter letter date.");
            return false;
        }
        else if (letterId == "") {
            alertify.error("Please select letter type.");
            return false;
        }
        else {
            window.location = "/Report/DownloadLetter?rid=" + rid + "&departmentId=" + departmentId + "&serviceId=" + serviceId + "&letterId=" + letterId + "&letterDate=" + letterDate;
        }
    });

</script>
