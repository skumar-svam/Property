@model NA.PMS.Model.AlloteeBasicInfo



<div class="PropertyBasicInfo">

    <div class="col-md-12" style="border:solid #e2e3e4; border-width:0 1px 1px">

        <div class="col-md-12 col-sm-12 col-xs-12 col-md-offset-0 form-bx">
            <div class="row">
                <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                    @Html.Label("Allottee Name:")
                </div>
                <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                    <label class="form-control appName">@Model.ApplicantName</label>
                </div>
                <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                    @Html.Label("Property No:")
                </div>
                <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                    @{
                        if (!string.IsNullOrEmpty(Model.PropertyNumber))
                        {
                            <label id="lbl" class="form-control">@Model.PropertyNumber</label>
                        }
                        else
                        {
                            <label id="lbl" class="form-control propNumber">NA</label>
                        }
                    }
                </div>
            </div>
            <div class="row">
                <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                    @{
                        if (!string.IsNullOrEmpty(Model.Gender))
                        {
                            if (Model.Gender.ToUpper() == "COMPANY")
                            {
                                <label>Authorized Signatory:</label>
                            }
                            else
                            {
                                @Html.Label("Father's Name:")
                            }
                        }
                    }

                </div>
                <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                    @{
                        if (!string.IsNullOrEmpty(Model.Gender))
                        {
                            <label class="form-control">@Model.FatherName</label>
                        }
                    }
                </div>
                <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                    @Html.Label("Property Type:")
                </div>
                <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                    @{
                        if (!string.IsNullOrEmpty(Model.PropertyType))
                        {
                            <label id="lbl" class="form-control">@Model.PropertyType</label>
                        }
                        else
                        {
                            <label id="lbl" class="form-control proType">NA</label>
                        }
                    }
                </div>
            </div>
            <div class="row">
                <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                    @Html.Label("Department:")
                </div>
                <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                    <label class="form-control department">@Model.DepartmentName</label>
                </div>
                <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                    @Html.Label("Gender:")
                </div>
                <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                    @{
                        if (!string.IsNullOrEmpty(Model.Gender))
                        {
                            <label id="lbl" class="form-control">@Model.Gender</label>
                            @*<label id="lbl" class="form-control">@Model.GenderType</label>*@
                        }
                        else
                        {
                            <label id="lbl" class="form-control gender">NA</label>
                        }
                    }
                </div>
            </div>

        </div>
    </div>
</div>