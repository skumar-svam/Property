@model NA.PMS.Model.AllottedPropertyViewModel
@using Kendo.Mvc.UI;

<div class="col-md-12" style="padding-top:5px;">
    <ul class="nav nav-tabs content-tabs" id="ulProperty" role="tablist" style="float:right;">
        <li class="active"><a href="#payment-schedule" role="tab" data-toggle="tab">Payment Schedule</a></li>
        <li><a href="#payment-history" role="tab" data-toggle="tab">Payment History</a></li>
        <li><a href="#installment-dues" role="tab" data-toggle="tab">Installment Dues</a></li>
        <li><a href="#lease-rent" role="tab" data-toggle="tab">Lease Rent</a></li>
        <li><a href="#tab-ndc" role="tab" data-toggle="tab">NDC</a></li>
    </ul>
</div>
<div class="col-md-12 tab-content" style="border:solid #e2e3e4; border-width:0 1px">
    <div class="tab-pane fade in active" id="payment-schedule">
        <h2 class="blck-heading-grid">Payment Schedule</h2>
        <div class="col-md-12 k-grid-content">
            @(Html.Kendo().Grid<NA.PMS.Model.PaymentSchedule>()
               .Name("gridPaymentSchedule")
              .Columns(columns =>
              {
                  columns.Bound(c => c.InstallmentNumber).Title("Installment No").Width(80);
                  columns.Bound(c => c.InstallmentDueDate).Format("{0:dd-MMM-yyyy}").Title("Due Date").Width(80);
                  columns.Bound(c => c.PrincipalInstallmentAmount).Title("Premium").Width(80);
                  columns.Bound(c => c.InterestInstallmentAmount).Title("Interest").Width(80);
                  columns.Bound(c => c.TotalBalAmount).Title("Total Paid Amount").Width(80);
                  columns.Bound(c => c.PrincipalBalAmount).Title("Balance Amount").Width(80);
              })
              .Sortable().Filterable().Resizable(resize => resize.Columns(true))
              .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
              .DataSource
              (
                  dataSource => dataSource
                      .Ajax().ServerOperation(true)
                      .Model(model => model.Id(p => p.Id))
                      .Read(read => read.Action("GetPaymentSchedule", "PropertyAllotment").Data("FilterRegistrationId"))
                      .PageSize(10)
              )
            )
        </div>

    </div>

    <div class="tab-pane fade" id="payment-history">
        <div class="col-md-12 k-grid-content">
            <h2 class="blck-heading-grid">Payment History</h2>
            @(Html.Kendo().Grid<NA.PMS.Model.PaymentReceipt>()
              .Name("gridPaymentReceipt")
              .Columns(columns =>
              {
                  columns.Bound(c => c.RECEIPT_ID).Title("Receipt No").Width(80);
                  columns.Bound(c => c.RECEIPT_HEAD_Name).Title("Receipt Head").Width(80);
                  columns.Bound(c => c.RECEIPT_SUBHEAD_Name).Title("Receipt Sub Head").Width(80);
                  columns.Bound(c => c.CHALLAN_ID).Title("Challan No").Width(80);
                  columns.Bound(c => c.DEPOSIT_DATE).Title("Deposit Date").Format("{0:dd/MM/yyyy}").Width(80);
                  columns.Bound(c => c.AMOUNT_PAID).Title("Amount Paid").Width(80);
              })
              .Sortable().Filterable().Resizable(resize => resize.Columns(true))
              .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
              .DataSource
              (
                  dataSource => dataSource
                      .Ajax()
                      .Model(model => model.Id(p => p.ID))
                      .ServerOperation(true)
                      .Read(read => read.Action("GetReceiptSchedule", "PropertyAllotment").Data("FilterRegistrationId"))
                      .PageSize(10)
              )
            )
        </div>
    </div>

    <div class="tab-pane fade" id="installment-dues">
        <h2 class="blck-heading">Installment Dues Payment</h2>
            <div class="form-bx">
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.Label("Installment Start Date")
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <input type="text" class="lbl-form-control" id="installment-start-date" style="width:100%;" />
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.Label("Installment End Date")
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <input type="text" class="lbl-form-control" id="installment-end-date" style="width:100%;" />
                    </div>
                </div>
                <div class="row">
                    <div class=" col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.Label("Dues Amount")
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <label class="lbl-form-control" id="installment-dues-amount"></label>
                    </div>

                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.Label("Dues Upto Date")
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <input type="text" class="lbl-form-control" id="dues-uptodate" style="width:100%;" />
                    </div>
                </div>
                <div class="row">
                    <div class=" col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.Label("Current Balance Amount")
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <label class="lbl-form-control" id="balance-amount"></label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.Label("Balance Upto Date")
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <input type="text" class="lbl-form-control" id="balance-uptodate" style="width:100%;" />
                    </div>
                </div>
            </div>
    </div>

    <div class="tab-pane fade" id="lease-rent">
        <h2 class="blck-heading-grid">Lease Rent Details</h2>
        <div class="col-md-12 k-grid-content">
            @(Html.Kendo().Grid<NA.PMS.Model.LeaseRentViewModel>()
                    .Name("GridLeaseRentDues")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.Id).Title("Id").Width(50).Hidden(true);
                        columns.Bound(c => c.LeaseRentPremium).Title("Lease Rent (<span class='fa fa-rupee'></span>)").ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
                        columns.Bound(c => c.PaidUptoDate).Title("Paid Upto").Format("{0:dd-MMM-yyyy}");
                        columns.Bound(c => c.LeaseRentDues).Title("Dues (<span class='fa fa-rupee'></span>)").ClientTemplate("<label class='hyperlink' onclick='ShowLeaseRentDetail(#=Id#)'>#= LeaseRentDues #</label>").ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
                        columns.Bound(c => c.DuesUptoDate).Title("Dues Upto").Format("{0:dd-MMM-yyyy}");
                        //columns.Bound(c => c.RegistrationId).Title("Demand Note").Width(140).ClientTemplate(" <center><a onclick='javascript:PrintDemandNote(#=RegistrationId#,#=LeaseRentDues#);'><span class='fa fa-print'></span></a></center> ");
                        //columns.Bound(c => c.LeaseRentDues).Title("Lease Rent Dues").ClientTemplate("<label class='hyperlinkcss' onclick='ShowLeaseRentDetail(#=Id#)'>view</label>");
                    })
                    .Sortable().Filterable().Resizable(resize => resize.Columns(true))
                    .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                    .ClientDetailTemplateId("rent-template").AutoBind(true)
                    .DataSource(dataSource => dataSource
                            .Ajax().ServerOperation(true)
                            .Model(model => model.Id(p => p.Id))
                            .Read(read => read.Action("GetLeaseRentPaymentByIdAsDataSource", "PropertyAllotment", new { area = "Property" }).Data("FilterLeaseRentById")).PageSize(10)
                            .Aggregates(aggregates => aggregates.Add(p => p.LeaseRentPremium).Sum())
                            .Aggregates(aggregates => aggregates.Add(p => p.LeaseRentDues).Sum())

                        )
            )
        </div>

        <script id="rent-template" type="text/kendo-tmpl">
            @(Html.Kendo().Grid<NA.PMS.Model.LeaseRentViewModel>()
            .Name("grid_#=Id#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.LeaseRentPremium).Title("Premium").Width(120);
                columns.Bound(c => c.DepositDueDate).Title("Due Date").Format("{0:dd-MMM-yyyy}");
                columns.Bound(c => c.DuesAmount);               
                columns.Bound(c => c.PaymentMode).Title("Payment Mode");
                columns.Bound(c => c.Status).Title("Status").Width(120);
            })
            .DataSource(dataSource => dataSource
                .Ajax().PageSize(10)
                .Read(read => read.Action("GetLeaseRentPaymentByIdAsDataSource", "PropertyAllotment", new { RentId = "#=Id#", ActionType = "LeaseRentTrans" }))
            )
            .ToClientTemplate()
            )
        </script>
        <script>
            function dataBound() {
                this.expandRow(this.tbody.find("tr.k-master-row").first());
            }
        </script>
    </div>

    <div class="tab-pane fade" id="tab-ndc">
        <h2 class="blck-heading">No Dues Certificate</h2>
        <div class="form-bx">
            <div class="row">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @Html.Label("Total Premium Paid")
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label class="lbl-form-control" id="is-total-premium-paid"></label>
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @Html.Label("One Time Lease Rent Paid")
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label class="lbl-form-control" id="is-onetime-lease-paid"></label>
                </div>
            </div>
            <div class="row">
                <div class=" col-md-3 col-sm-3 col-xs-12 form-group">
                    @Html.Label("NDC Date")
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @*<input type="text" class="lbl-form-control" id="ndc-date" style="width:100%;" />*@
                    @(Html.Kendo().DatePicker().Name("ndc-date").HtmlAttributes(new { style="width:100%;", @readonly="readonly"}))
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @Html.Label("Lease Rent Paid Upto")
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <input type="text" class="lbl-form-control" id="leaserent-paid-uptodate" style="width:100%;" />
                </div>
            </div>
        </div>
    </div>

</div>


<script>
    $(document).ready(function () {
        GetInstallmentDues();
        GetNDCDetails();
    });

    function FilterLeaseRentById() {
        rid = $('#Property_RegistrationId').val();
        var model = { RegistrationId: rid, ActionType: "LeaseRent" };
        return model;
    }

    function GetInstallmentDues() {
        var rid = $('#Property_RegistrationId').val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ RegistrationId: rid, ActionType: "Installment" }),
            url: "/Property/PropertyAllotment/GetDuesPaymentStatusByRegistrationId",
            success: function (data) {
                if (data != null) {
                    $('#installment-start-date').val(data.InstallmentStartDate);
                    $('#installment-end-date').val(data.InstallmentEndDate);
                    $('#installment-dues-amount').html(data.DuesAmount);
                    $('#dues-uptodate').val(data.DuesUptoDate);
                    $('#balance-amount').html(data.BalanceAmount);
                    $('#balance-uptodate').val(data.BalanceUptoDate);
                }
            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
            }
        });
    }

    function GetNDCDetails() {
        var rid = $('#Property_RegistrationId').val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ RegistrationId: rid, ActionType: "NDC" }),
            url: "/Property/PropertyAllotment/GetDuesPaymentStatusByRegistrationId",
            success: function (data) {
                if (data != null) {
                    $('#is-total-premium-paid').html(data.PremiumPaidStatus);
                    $('#is-onetime-lease-paid').html(data.LeaseRentStatus);
                    //$('#ndc-date').val(data.NDCDate);
                    $('#ndc-date').data("kendoDatePicker").value(data.NDCDate);
                    $('#leaserent-paid-uptodate').val(data.LeaseRentDuration);
                }
            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
            }
        });
    }
</script>