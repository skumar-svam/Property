@using Kendo.Mvc.UI;
@model NA.PMS.Model.CICModel

@{
    ViewBag.Title = "ManageCIC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="ManageCic">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Change In Constitution</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                @*<a href="#" id="btnGenratePaymentChallan" class="" onclick="javascript: AddRequest(event);">Generate Payment Challan</a>*@
                <a href="#" id="btnAddRequest" class="" onclick="javascript: AddRequest(event);">Add Request</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12" style="border:solid #e2e3e4; border-width:0 1px 0 1px">
        <ul class="nav nav-tabs content-tabs" id="ulProperty" role="tablist">
            <li class="active"><a href="#one" role="tab" data-toggle="tab">Directors/Shareholders</a></li>
            <li><a href="#two" role="tab" data-toggle="tab">Firm Name/Status/Product Name</a></li>
        </ul>
    </div>
    <div class="col-md-12 tab-content">
        <div class="tab-pane fade in active" id="one">
            <div class="k-grid-content">
                <h2 class="blck-heading-grid">Change In Directors (CID)</h2>
                @(Html.Kendo().Grid<NA.PMS.Model.CICModel>()
               .Name("gridCIC")
              .Columns(columns =>
              {
                  //columns.Bound(c => c.Director_Id).Width(150).ClientTemplate("<a href='" + "/Property/CIC/ViewCIC/#= Director_Id #'>#=Director_Id#</a>").Width(70).Filterable(false);
                  columns.Bound(c => c.Director_Id).Title("Request No").Width(130).ClientTemplate("<a href='" + "/Property/CIC/ViewCIC/" + "?ReqID=#= Director_Id #&Type=#=Change_Type#'" + ">#=Director_Id#</a>");
                  columns.Bound(c => c.Rid).Title("Registration Id").Width(150);
                  columns.Bound(c => c.Director_Id).Hidden(true);
                  columns.Bound(c => c.DepartmentName).Title("Department Name");
                  //columns.Bound(c => c.SectorName).Title("Sector").Width(100);
                  //columns.Bound(c => c.BlockName).Title("Block").Width(100);
                  //columns.Bound(c => c.PropertyNo).Title("Property No").Width(130);
                  //columns.Bound(c => c.PropNo).Title("Property Number");
                  columns.Bound(c => c.Request_Date).Title("Request Date").Format("{0:dd/MM/yyyy}");
                  columns.Bound(c => c.Approved_Date).Title("Approved Date").Format("{0:dd/MM/yyyy}");
                  columns.Bound(c => c.AssignTo).Title("Assigned To");
                  columns.Bound(c => c.StatusName).Title("Status");
                  columns.Bound(c => c.Change_Type).Hidden(true);
                  columns.Bound(c => c.Rid).ClientTemplate("<label onclick='javascript:GenerateLetter(this)' class='hyperlinkcss'>Print Challan</label>").Width(120).Title("Action").Filterable(false);
              })
              .Sortable().Filterable().Resizable(resize => resize.Columns(true))
              .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
              .DataSource
              (
                 dataSource => dataSource
                .Ajax().Model(model => model.Id(p => p.Director_Id))
                .ServerOperation(true).Sort(sort => sort.Add("Director_Id").Descending()).Read(read => read.Action("GetAllCIC", "CIC"))
                .PageSize(10)
              )
                )
            </div>
        </div>

        <div class="tab-pane fade" id="two">
            <div class="k-grid-content">
                <h2 class="blck-heading-grid">Change In Firm Name/Firm Status/Product Name</h2>
                @(Html.Kendo().Grid<NA.PMS.Model.CICModel>()
                       .Name("gridFirmProductStatus")
              .Columns(columns =>
              {
                  //columns.Bound(c => c.Director_Id).Width(150).ClientTemplate("<a href='" + "/Property/CIC/FirmViewCIC/#= Director_Id #'>#=Director_Id#</a>").Width(70).Filterable(false);
                  columns.Bound(c => c.Director_Id).Title("Request No").Width(130).ClientTemplate("<a href='" + "/Property/CIC/ViewCIC/" + "?ReqID=#= Director_Id #&Type=#=Change_Type#'" + ">#=Director_Id#</a>");
                  columns.Bound(c => c.Rid).Title("Registration Id").Width(150);
                  columns.Bound(c => c.Director_Id).Hidden(true);
                  columns.Bound(c => c.DepartmentName).Title("Department Name");
                  //columns.Bound(c => c.SectorName).Title("Sector").Width(100);
                  //columns.Bound(c => c.BlockName).Title("Block").Width(100);
                  //columns.Bound(c => c.PropertyNo).Title("Property No").Width(130);
                  //columns.Bound(c => c.PropNo).Title("Property Number");
                  columns.Bound(c => c.ChangeTypeName).Title("CIC Type");
                  columns.Bound(c => c.Request_Date).Title("Requested Date").Format("{0:dd/MM/yyyy}");
                  columns.Bound(c => c.Approved_Date).Title("Approved Date").Format("{0:dd/MM/yyyy}");
                  columns.Bound(c => c.AssignTo).Title("AssignedTo");
                  columns.Bound(c => c.StatusName).Title("Status");
                  columns.Bound(c => c.Rid).ClientTemplate("<label onclick='javascript:GenerateFirmnProductLetter(this)' class='hyperlinkcss'>Print Challan</label>").Width(120).Title("Action").Filterable(false);
              })
              .Sortable().Filterable().Resizable(resize => resize.Columns(true))
              .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
              .DataSource
              (
                 dataSource => dataSource
                        .Ajax().Model(model => model.Id(p => p.Director_Id))
                        .ServerOperation(true).Sort(sort => sort.Add("Director_Id").Descending()).Read(read => read.Action("GetAllFirmProductStatus", "CIC"))
                .PageSize(10)
              )
                )
            </div>
        </div>
    </div>



    <div id="divPrintLetters" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
        <div class="modal-dialog" style="width: 60%;">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">  <b>Letter</b></h4>
                </div>
                <div class="modal-body" style="overflow:auto; height:400px;">
                    <div id="divLetterBody"></div>
                </div>
                <div class="modal-footer" style="text-align: center;">
                    <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv();">Print</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function AddRequest(event) {
        event.preventDefault();
        window.location.href = '@Url.Action("AddCIC", "CIC")';
    }
    
    function GenerateLetter(row) {
        var tr = $(row).parent().parent();
        var rIds = $(tr).children("td:eq(1)").text();
        var directorID = $(tr).children("td:eq(2)").text();
        if (rIds.length > 0) {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ ridList: rIds, directorID: directorID }),
                url: '/DocParser/PrintCICChallan',
                success: function (result) {
                    $("#divLetterBody").html(result);
                    $("#divPrintLetters").modal('show');
                },
                error: function (obj) {
                    alertify.error("Some error occured. Please try again later.");
                }
            });
        } else {
            alertify.error("Please select atleast one record to print Functional Challan.");
        }
    }


    function GenerateFirmnProductLetter(row) {
        var tr = $(row).parent().parent();
        var rIds = $(tr).children("td:eq(1)").text();
        var directorID = $(tr).children("td:eq(2)").text();
        if (rIds.length > 0) {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ ridList: rIds, directorID: directorID }),
                url: '/DocParser/PrintCICFirmnProductChallan',
                success: function (result) {
                    $("#divLetterBody").html(result);
                    $("#divPrintLetters").modal('show');
                },
                error: function (obj) {
                    alertify.error("Some error occured. Please try again later.");
                }
            });
        } else {
            alertify.error("Please select atleast one record to print Functional Challan.");
        }
    }

</script>