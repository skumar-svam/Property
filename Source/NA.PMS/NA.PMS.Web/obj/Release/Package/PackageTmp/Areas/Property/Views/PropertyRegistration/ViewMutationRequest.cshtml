@model NA.PMS.Model.MutationModel
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
@{
    ViewBag.Title = "View Mutation Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="row">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">View Mutation Request</h1></div>
                <div class="col-md-6 col-sm-6 col-xs-12 col-btn">
                    <a href="#" id="btnComment" class="">View Comments</a>
                </div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
                <input type="hidden" value="@Model.RId" id="hdnRId" />
                @{Html.RenderPartial("_PartialMutation", Model);}
            </div>
            <div class="box-button text-center">
                <input type="button" class="btn btn-default" value="Back" id="btnBack" />
                <input type="button" class="btn btn-add" value="Submit for Approval" id="btnAdd" />
                <input type="button" class="btn btn-default" value="Cancel Request" id="btnCancel" />
                <input type="button" class="btn btn-add" value="Generate Mutation Letter" id="btnGenerateLetter" />
            </div>
        </div>
        <div class="col-md-12">

        </div>
    </div>
</div>




@(Html.Kendo().Window().Name("assignToWindow").Title("Assign To").Modal(true).Visible(false).Content(@<text>
        <div class="container-fluid">
            <div class="row topSpace">
                <div class="col-md-3 col-md-offset-1">
                    @Html.Label("Assign To: ")
                </div>
                <div class="col-md-6">
                    @(Html.Kendo().DropDownListFor(model => model.User)
                                      .Name("User")
                              .DataTextField("text")
                              .DataValueField("id")
                      .OptionLabel("Select").Filter("contains")
                      .DataSource(source =>
                      {
                          source.Read(read =>
                          {
                              read.Action("GetAssineToByDepttId", "PropertyRegistration").Data("AdditionalData");
                          });
                      })
                      .HtmlAttributes(new { style = "width:100%" })
                    )
                </div>
            </div>
            <div class="row topSpace bottomSpace">
                <div class="col-md-6 col-md-offset-4">
                    <input type="button" class="btn btn-add" id="btnPopupSubmit" value="Submit" />
                    <input type="button" class="btn btn-default closePopup" value="Close" />
                </div>
            </div>

        </div>
</text>)
                    .Draggable()
                    .Resizable()
                    //.Width(400)
                    .Actions(actions => actions.Close())
)

@(Html.Kendo().Window().Name("viewCommentsWindow").Title("View Comments").Modal(true).Visible(false).Content(@<text>
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-2 col-md-offset-1 form-group">
                    @Html.Label("From :")
                </div>
                <div class="col-md-8 form-group">
                    @Html.DisplayFor(model => model.From)
                </div>
            </div>
            <div class="row">
                <div class="col-md-2 col-md-offset-1 form-group">
                    @Html.Label("Date :")
                </div>
                <div class="col-md-8 form-group">
                    @*@Html.DisplayFor(model => model.SubmittedDate)*@
                    @Convert.ToString(string.Format("{0:dd/MM/yyyy}", Model.SubmittedDate))
                </div>
            </div>
            <div class="row">
                <div class="col-md-2 col-md-offset-1">
                    @Html.Label("Comments :")
                </div>
                <div class="col-md-8 form-group">
                    @Html.TextAreaFor(model => model.Comment, new { @disabled = "disabled", @class = "form-control", @style = "border:0;background:#ffffff;margin:0;padding:0;" })
                </div>
            </div>
            <div class="row">
                <div class="col-md-8 col-md-offset-3 form-group">
                    <input type="button" class="btn btn-default closePopup" value="Close" />
                </div>
            </div>
        </div>
</text>)
.Draggable()
.Resizable()
//.Width(400)
.Actions(actions => actions.Close())
)

@*PopUp to print*@
<div id="divPrintMutation" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" style="width: 50%">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Mutation Letter</b></h4>
            </div>
            <div class="modal-body" id="divMutationLetterBody">

            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv();">Print</button>

            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var status = $("#Status").val();
        //Hide Upload functionality in View
        //$("#divUpload").hide();

        $("#RId").data('kendoDropDownList').value($("#hdnRId").val());
        //$("#txtRId").val($("#hdnRId").val());
        //Disable fields in the case of View Request
        $('#MutationDate').data('kendoDatePicker').enable(false);
        $('#TransferDeedDate').data('kendoDatePicker').enable(false);
        $('#BahiNo').attr("disabled", true);
        $('#BahiZildNo').attr("disabled", true);
        $('#BahiPageNo').attr("disabled", true);
        $('#SINo').attr("disabled", true);
        var dropDown = $("#RId").data("kendoDropDownList");
        dropDown.enable(false);
        //dropDown.hide();
        //$("#txtRId").show();
        //$("#txtRId").disabled(true);

        //Hide buttons according to Status.
        //var status = $("#Status").val();
        if (status == '@NA.PMS.Common.AllotmentStatus.Pending') {
            $("#btnAdd").hide();
            $("#btnGenerateLetter").hide();
            $("#btnComment").hide();
            $("#fileDoc").hide();
        }
        else if (status == '@NA.PMS.Common.AllotmentStatus.Cancelled') {
            //$("#btnAdd").hide();
            $("#btnGenerateLetter").hide();
            $("#btnCancel").hide();
            $("#btnComment").hide();
            //Enable fields in the case of Re-Submit Request (Status = Rejected)
            $('#MutationDate').data('kendoDatePicker').enable(true);
            $('#TransferDeedDate').data('kendoDatePicker').enable(true);
            $('#BahiNo').attr("disabled", false);
            $('#BahiZildNo').attr("disabled", false);
            $('#BahiPageNo').attr("disabled", false);
            $('#SINo').attr("disabled", false);
            $("#divUpload").show();
            $("#fileDoc").show();
            //var dropDown = $("#RId").data("kendoDropDownList");
            //dropDown.enable(true);
        }
        else if (status == '@NA.PMS.Common.AllotmentStatus.Approved') {
            $("#btnAdd").hide();
            $("#btnCancel").hide();
            $("#fileDoc").hide();
        }
        else if (status == '@NA.PMS.Common.AllotmentStatus.Rejected') {
            //Enable fields in the case of Re-Submit Request (Status = Rejected)
            $('#MutationDate').data('kendoDatePicker').enable(true);
            $('#TransferDeedDate').data('kendoDatePicker').enable(true);
            $('#BahiNo').attr("disabled", false);
            $('#BahiZildNo').attr("disabled", false);
            $('#BahiPageNo').attr("disabled", false);
            $('#SINo').attr("disabled", false);
            //var dropDown = $("#RId").data("kendoDropDownList");
            //dropDown.enable(true);
            $("#divUpload").show();
            $("#btnGenerateLetter").hide();
            $("#btnCancel").hide();
            $("#btnAdd").val("Re-Submit for Approval");
            $("#fileDoc").show();
        }

        $("#btnAdd").click(function () {
            var mutDate = $("#MutationDate").val();
            var transDeedDate = $("#TransferDeedDate").val();
            var bahiNo = $("#BahiNo").val();
            var bahiZildNo = $("#BahiZildNo").val();
            var bahiPageNo = $("#BahiPageNo").val();
            var SINo = $("#SINo").val();
            var ReqNo = $("#ReqNo").val();
            var transferDate = $("#TransferDate").val();
            var dtMutDate = new Date(mutDate);
            var dtTransDeedDate = new Date(transDeedDate);
            var dtTransferDate = new Date(transferDate);
            if (mutDate == "") {
                alertify.error("Please enter Mutation Date.");
                return false;
            }
            if (transDeedDate == "") {
                alertify.error("Please enter Transfer Deed Date.");
                return false;
            }
            if (bahiNo == "") {
                alertify.error("Please enter Bahi Number.");
                return false;
            }
            if (bahiZildNo == "") {
                alertify.error("Please enter Bahi Zild Number.");
                return false;
            }
            if (bahiPageNo == "") {
                alertify.error("Please enter Bahi Page Number.");
                return false;
            }
            if (SINo == "") {
                alertify.error("Please enter SI Number.");
                return false;
            }
            if (dtTransDeedDate <= dtTransferDate) {
                alertify.error("Transfer Deed Date can't be earlier than, or equal to Transfer Date");
                return false;
            }
            if (dtMutDate <= dtTransDeedDate) {
                alertify.error("Mutation Date can't be earlier than, or equal to Transfer Deed Date");
                return false;
            }
            $("#assignToWindow").data("kendoWindow").center();
            $("#assignToWindow").data("kendoWindow").open();
        });

        $("#btnGenerateLetter").click(function () {
            //window.location.href = '/DocParser/MutationLetter/' + $("#ReqNo").val();
            //setTimeout(function () {
            //    var printWindow = window.open("/DocParser/MutationLetter/" + $("#ReqNo").val());
            //    printWindow.focus();
            //    printWindow.print();
            //}, 1000);
            //window.open("/DocParser/MutationLetter/" + $("#ReqNo").val());
            var id = $("#ReqNo").val();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ id: id }),
                url: '/DocParser/PrintMutationLetter',
                success: function (result) {
                    $("#divMutationLetterBody").html(result);
                    $("#divPrintMutation").modal('show');
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //alert(respText);
                    alertify.error("Some error occured. Please try again later.");
                }
            });
        });

        $("#btnPopupSubmit").click(function () {
            var userVal = $("#User").val();
            if (userVal == "" || userVal == null) {
                alertify.error("Please select a User.");
                return false;
            }
            else {
                var mutDate = $("#MutationDate").val();
                var transDeedDate = $("#TransferDeedDate").val();
                var bahiNo = $("#BahiNo").val();
                var bahiZildNo = $("#BahiZildNo").val();
                var bahiPageNo = $("#BahiPageNo").val();
                var SINo = $("#SINo").val();
                var userVal = $("#User").val();
                var ReqNo = $("#ReqNo").val();
                var rId = $("#RId").val();

                if (userVal == "" || userVal == null) {
                    alertify.error("Please select a User.");
                    return false;
                }
                else {
                    var formData = new FormData();
                    var file = $('#fileDoc')[0];
                    formData.append("fileTransDeed", file.files[0]);
                    formData.append("mutDate", mutDate);
                    formData.append("transDeedDate", transDeedDate);
                    formData.append("bahiNo", bahiNo);
                    formData.append("bahiZildNo", bahiZildNo);
                    formData.append("bahiPageNo", bahiPageNo);
                    formData.append("SINo", SINo);
                    formData.append("userVal", userVal);
                    formData.append("ReqNo", ReqNo);
                    formData.append("rId", rId);
                    $.ajax({
                        dataType: 'json',
                        type: 'Post',
                        //contentType: 'application/json; charset=utf-8',
                        //data: JSON.stringify({ mutDate: mutDate, transDeedDate: transDeedDate, bahiNo: bahiNo, bahiZildNo: bahiZildNo, bahiPageNo: bahiPageNo, SINo: SINo, userVal: userVal, ReqNo: ReqNo, rId: rId }),
                        data: formData,
                        url: '/PropertyRegistration/UpdateMutationDetails',
                        cache: false,
                        contentType: false,
                        processData: false,
                        success: function (result) {
                            if (result == true) {
                                //Close popups
                                $("#assignToWindow").data("kendoWindow").close();
                                $("#viewCommentsWindow").data("kendoWindow").close();
                                //Disable fields
                                $('#MutationDate').data('kendoDatePicker').enable(false);
                                $('#TransferDeedDate').data('kendoDatePicker').enable(false);
                                $('#BahiNo').attr("disabled", true);
                                $('#BahiZildNo').attr("disabled", true);
                                $('#BahiPageNo').attr("disabled", true);
                                $('#SINo').attr("disabled", true);
                                var dropDown = $("#RId").data("kendoDropDownList");
                                dropDown.enable(false);
                                //Hide/Show buttons
                                $("#btnGenerateLetter").hide();
                                $("#btnCancel").show();
                                $("#btnComment").hide();
                                $("#btnAdd").hide();
                                alertify.success("Data saved successfully.");
                                window.location.href = '@Url.Action("ManageMutation", "PropertyRegistration")';
                                return false;
                            }
                            else {
                                alertify.error("Some error occured. Please try again later.");
                            }
                        },
                        error: function (objAjaxRequest, strError) {
                            var respText = objAjaxRequest.responseText;
                            alertify.error("Some error occured. Please try again later.");
                        }
                    });
                }
            }
        });

        $(".closePopup").click(function () {
            $("#assignToWindow").data("kendoWindow").close();
            $("#viewCommentsWindow").data("kendoWindow").close();
        });

        $("#btnBack").click(function () {
            window.location.href = '@Url.Action("ManageMutation", "PropertyRegistration")';
        });

        $("#btnComment").click(function () {
            $("#viewCommentsWindow").data("kendoWindow").center();
            $("#viewCommentsWindow").data("kendoWindow").open();
        });

        $("#btnCancel").click(function () {
            var reqNo = $("#ReqNo").val();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ reqNo: reqNo }),
                url: '/PropertyRegistration/CancelMutationRequest',
                success: function (result) {
                    if (result == true) {
                        //Enable fields
                        $('#MutationDate').data('kendoDatePicker').enable(true);
                        $('#TransferDeedDate').data('kendoDatePicker').enable(true);
                        $('#BahiNo').attr("disabled", false);
                        $('#BahiZildNo').attr("disabled", false);
                        $('#BahiPageNo').attr("disabled", false);
                        $('#SINo').attr("disabled", false);
                        //var dropDown = $("#RId").data("kendoDropDownList");
                        //dropDown.enable(true);
                        //Show/Hide buttons
                        $("#btnGenerateLetter").hide();
                        $("#btnCancel").hide();
                        $("#btnComment").hide();
                        $("#btnAdd").show();
                        alertify.success("Request cancelled successfully.");
                        $("#fileDoc").show();
                    }
                    else {
                        alertify.error("Some error occured. Please try again later.");
                    }
                },
                error: function (obj) {
                    alertify.error("Some error occured. Please try again later.");
                }
            });
        });
    });

    function AdditionalData() {
        return {
            depttId: $("#DepttId").val()
        };
    }

    function PrintDiv() {
        var contents = document.getElementById("divMutationLetterBody").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }
</script>