@using Kendo.Mvc.UI
@{
    ViewBag.Title = "Refunds";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    #EditRefund,#AddRefund{
        float:right;
    }
    .disable_a_href {
        pointer-events: none;
    }
    .k-grid-content{
        overflow-y:hidden;
        overflow-x:hidden;
    }
</style>


<div class="ManageRefundPage">
    
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12">
                <h1 class="gridTitle">Manage Refunds</h1>
            </div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                <a id="btnAddApplication" class="" onclick="javascript: AddRefunds(event);" href="#">Add Refund</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="k-grid-content manageRefundTable" id="ManageRefundsId">
        @(Html.Kendo().Grid<NA.PMS.Model.Refund>()
        .Name("ManageRefund")
        .Columns(columns =>
        {
            columns.Bound(c => c.RefundId).Hidden(true);
            columns.Bound(c => c.EncodedParameter).Hidden(true);
            columns.Bound(c => c.SchemeName).Title("Scheme Name");
            columns.Bound(c => c.DepartmentName).Title("Department");
            columns.Bound(c => c.RefundDescription).Title("Refund Description");
            columns.Bound(c => c.CreatedDate).Title("Created").Format("{0:dd-MMM-yyyy}");

            if (@ViewBag.EditMenuVal != null && @ViewBag.EditMenuVal == true)
            {
                columns.Bound(c => c.RefundId).Title("Action").HeaderHtmlAttributes(new { style = "text-align:center;" }).HtmlAttributes(new { style = "text-align:center;" }).ClientTemplate("<a class='gridEdit' href='/Master/ManageRefunds/EditRefund/#=EncodedParameter#'>Edit</a>").Filterable(false).Sortable(false);
                //columns.Bound(c => c.RefundId).Title("Action").ClientTemplate(@Url.Action("EditRefund", "ManageRefunds", new RouteValueDictionary(new { id = "#=id" }))).Filterable(false).Sortable(false);             
            }
            else{
                columns.Bound(c => c.RefundId).ClientTemplate("Edit").Title("Action").Filterable(false); 
            }
            if (@ViewBag.ReadOnlyMenu != null && @ViewBag.ReadOnlyMenu==true)
            {
                columns.Bound(c => c.RefundId).Title("View").HeaderHtmlAttributes(new { style = "text-align:center;" }).HtmlAttributes(new { style = "text-align:center;" }).ClientTemplate("<a href='/Master/ManageRefunds/ViewRefund/#=EncodedParameter#'class='gridView'>View</a>").Filterable(false).Sortable(false);
                //columns.Bound(c => c.RefundId).Title("View").ClientTemplate("<a href='javascript:ViewRefunds(#=id#)' class='btn glyphicon glyphicon-eye-open'>View</a>").Filterable(false).Sortable(false);
            }
            else
            {
                columns.Bound(c => c.RefundId).ClientTemplate("View").Title("View").Filterable(false);
            }
            if (@ViewBag.DeleteMenuVal != null && @ViewBag.DeleteMenuVal==true)
            {
                columns.Bound(c => c.RefundId).Title("Remove").HeaderHtmlAttributes(new { style = "text-align:center;" }).HtmlAttributes(new { style = "text-align:center;" }).ClientTemplate("<a onclick='javascript:RemoveRefund(#=RefundId#)' class='gridRemove hyperlinkcss' id='RemoveRefundTag'>Remove</a>").Filterable(false).Sortable(false);
            }
            else
            {
                columns.Bound(c => c.RefundId).ClientTemplate("Remove").Title("Remove").Filterable(false);
            }
            })
        .Sortable()
                .Filterable()
                      .Groupable()
        //.ToolBar(toolBar => {
        //    toolBar.Custom().Text("<i class='fa fa-plus-square' aria-hidden='true'></i> Add Refunds") 
        //                    .HtmlAttributes(new { onclick = "javascript:AddRefunds(event);", @class = "k-button", id = "AddRefund" });
        //})
                .Events(e => e.DataBound("onDataBound"))
        .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
        .DataSource(dataSourc => dataSourc
                                .Ajax()
                                .Sort(sort => sort.Add("RefundId").Descending())
                                .Model(model => model.Id(p => p.RefundId))
                                .ServerOperation(true)
                                .Read(read => read.Action("GetRefundDetails", "ManageRefunds"))
                                .PageSize(10)
                    )
        )
    </div>

</div>

<div id="myModal" class="modal fade" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog  modal-sm" style="margin:150px auto">
        <div class="modal-content">
            <!-- dialog body -->
            <div class="modal-body">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <div class="row form-group">
                    <div class="col-sm-12">
                        @Html.Label("Title", new { @class = "", @id = "Title" })
                    </div>                    
                </div>

                <!-- dialog buttons -->
                <div class="row form-group">
                    <div class="col-sm-6"></div>
                    <div class="col-sm-6">
                        <button type="button" id="Deactivatebtn" usrid="" status="" class="k-button" data-dismiss="modal" onclick="javascript:removeR()">Yes</button>
                        <button type="button" class="k-button" data-dismiss="modal">No</button>
                    </div>
               </div>
            </div>

            
        </div>
    </div>
</div>

<script type="text/javascript">
    function AddRefunds(event) {
        event.preventDefault();
        window.location.href = '@Url.Action("AddRefund", "ManageRefunds")';
    }

    function ViewRefunds(id) {
        //event.preventDefault();
        window.location.href = '@Url.Action("ViewRefund", "ManageRefunds")';//',new RouteValueDictionary(new { id = "ID" }))'.Replace("ID",id);
    }
    function removeR() {
        return true;
    }
    function RemoveRefund(RefundId) {
        //$('#myModal').modal("show");
        var flag = confirm("Are you sure to remove this refund?");
        //var flag = removeR();
        if (flag) {
            $.ajax({
                url: '@(Url.Action("RemoveRefundForScheme", "ManageRefunds"))',
                type: 'POST',
                data: { RefundId: RefundId },
                success: function (result) {
                    if (result == true) {
                        alertify.success("Refund successfully removed"); //location.reload();
                        $('#ManageRefund').data('kendoGrid').dataSource.read();
                        $('#ManageRefund').data('kendoGrid').refresh();
                    }
                    else {
                        alertify.error("Refund not removed");
                        return false;
                    }
                }
            });
        }
        else {
            return false;
        }
    }
    function onDataBound(e) {
        var AddMenuVal = '@ViewBag.AddMenuVal'
        if (AddMenuVal == "False") {
            $("#AddRefund").addClass("disable_a_href");
        }
    }
</script>