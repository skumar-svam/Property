@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@using NA.PMS.Common
@model NA.PMS.Model.LeaseRentViewModel

@{
    ViewBag.Title = "Manage Lease Rent";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #dues-update-window{
        display:none;
    }
    .fa.fa-refresh{
        
    }
</style>

<div class="ManageLeaseRentList">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Lease Rent</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                <a href="#" onclick="javascript:OpenUpdateWindow()"><i class="fa fa-plus"></i> <span>Update Dues</span></a>
                <a href="/Revenue/Payment/LeaseRent" id="btnAddLeaseDeed" target="_blank"><i class="fa fa-plus"></i> <span>Add Lease Rent</span></a>
                @*<a href="/Revenue/Finance/LeaseRentPayment" id="btnAddLeaseDeed" target="_blank"><i class="fa fa-plus"></i> <span> Add Lease Rent</span></a>*@
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>

    <div class="col-md-12 content-top-spce">
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading" style="margin-bottom:15px;">Search</h2>
            <div class="form-bx">
                <div class="row">
                    <div class="col-md-2 col-sm-2 col-xs-12 form-group">
                        <b>@Html.Label("Department")</b>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                            .Filter("contains")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel(" --- select ---")
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => transport.Read(read => read.Action("GetDepartmentList", "Finance", new { area="Revenue"})))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(6);
                            })
                            .Events(events => { events.Change("ChangeDeptEvent"); })
                            .HtmlAttributes(new { @class = "input-disabled", style = "width:100%" })
                        )
                    </div>
                </div>
            </div>

            <h2 class="blck-heading" style="margin-bottom: 0px;">Lease Rent Details</h2>
            <div class="k-grid-content">
                @(Html.Kendo().Grid<NA.PMS.Model.LeaseRentViewModel>()
                .Name("GridLeaseRentDues")
                .Columns(columns =>
                {
                    columns.Bound(c => c.Id).Hidden(true);
                    columns.Bound(c => c.RegistrationId).Title("Registration Id");
                    columns.Bound(c => c.Sector).Title("Sector");
                    columns.Bound(c => c.Block).Title("Block");
                    columns.Bound(c => c.PlotNo).Title("Plot No");
                    columns.Bound(c => c.IsTotalInstallmentPaid).Title("Total Premium").ClientTemplate("#if(IsTotalInstallmentPaid==true){#<label>Paid</label>#}else{#<label>Not Paid</label>#}#");
                    columns.Bound(c => c.IsLeaseRentPaid).Title("Onetime Lease").ClientTemplate("#if(IsLeaseRentPaid==true){#<label>Paid</label>#}else{#<label>Not Paid</label>#}#");                    
                    columns.Bound(c => c.PaidUptoDate).Title("Paid Upto").Format("{0:dd-MMM-yyyy}");
                    columns.Bound(c => c.TotalBalance).Title("Total Balance (<span class='fa fa-rupee'></span>)").ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
                    columns.Bound(c => c.CurrentDues).Title("Current Dues").ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
                    columns.Bound(c => c.CurrentDuesDate).Title("Dues Upto").Format("{0:dd-MMM-yyyy}");
                    columns.Bound(c => c.RegistrationId).Title("Demand Note").Width(140).ClientTemplate(" <center><a onclick='javascript:PrintDemandNote(#=RegistrationId#,#=LeaseRentDues#);'><span class='fa fa-print hyperlink'></span></a></center> ");
                    columns.Bound(c => c.IsDuesUptoDate).Title(" ").Width(50).ClientTemplate("<center><a onclick='javascript:CalculateDuesUptoDate(#=RegistrationId#);'><span class='fa fa-refresh hyperlink'></span></a></center> ");
                    //columns.Bound(c => c.Id).Title("Edit").ClientTemplate("#if(IsActive==false){# <a href=\"/Revenue/Payment/LeaseRent/#= Id#\" id='e_#=Id#'><span class='glyphicon glyphicon-pencil'></span></a> #}else{# --- #}#").Filterable(false).Sortable(false).Width(50);
                    //columns.Bound(c => c.Id).Title("View").ClientTemplate("<a href=\"/Revenue/Finance/ViewLeaseDeedDetails/#= Id#\" id='e_#=Id#'><span class='glyphicon glyphicon-eye-open'></span></a>").Filterable(false).Sortable(false).Width(50);
                })
                .Sortable().Filterable().Resizable(resize => resize.Columns(true))
                .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                .ClientDetailTemplateId("template").AutoBind(true)
                .DataSource(dataSource => dataSource
                    .Ajax().ServerOperation(true)
                    .Model(model => model.Id(p => p.Id))                   
                    .Read(read => read.Action("GetLeaseRentDetails", "Payment", new { area="Revenue"}).Data("LeaseRent")).PageSize(10)
                    .Sort(sort=>sort.Add(s=>s.Id).Descending())
                    .Aggregates(aggregates => aggregates.Add(p => p.TotalBalance).Sum())
                            .Aggregates(aggregates => aggregates.Add(p => p.CurrentDues).Sum())
                    )
                )
            </div>
        </div>
    </div>
  
</div>

<div class="col-md-12" id="dues-update-window">
    <div class="row form-group" style="margin-top:25px;">
        <div class="col-md-4 col-sm-12 col-xs-12" style="text-align:center;padding:0;">
            <label>Department</label>
        </div>
        <div class="col-md-5 col-sm-12 col-xs-12" style="padding:0;">
            @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                .Name("DDLDepartmentId")
                .Filter("contains")
                .DataTextField("Text")
                .DataValueField("Id")
                .OptionLabel(" --- select ---")
                .DataSource(source =>
                {
                    source.Custom()
                    .ServerFiltering(true)
                    .ServerPaging(true)
                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                    .Transport(transport => transport.Read(read => read.Action("GetDepartmentList", "Finance", new { area = "Revenue" })))
                    .Schema(schema => schema.Data("Data").Total("Total"))
                    .PageSize(6);
                })
                .HtmlAttributes(new { @class = "input-disabled", style = "width:100%" })
            )
        </div>
        <div class="col-md-3 col-sm-12 col-xs-12" style="padding:0;">
            @*<div id="loading-image" class="k-loading-image"></div>*@
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-4 col-sm-12 col-xs-12" style="text-align:center;padding:0;">
            <label>Dues Upto Date</label>
        </div>
        <div class="col-md-5 col-sm-12 col-xs-12" style="text-align:right;">
            @(Html.Kendo().DatePicker().Name("DPCurrentDuesDate").HtmlAttributes(new { @class = "input-disabled", style = "width:100%;" }))
        </div>
    </div>
    <div class="row form-group" style="margin:15px 0 15px 0;">
        <div class="col-md-4 col-sm-6 col-xs-12">
           
        </div>
        <div class="col-md-5 col-sm-6 col-xs-12">
            <input type="button" class="k-button btn btn-primary" id="btnSubmitAction" value="Update" style="width:100%" />
        </div>
    </div>
</div>

<div id="divPrintSchemeForm" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 60%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title"><b>Demand Note</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:400px;">
                <div id="divSchemeForm"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintSchemeFormDiv();">Print</button>
            </div>
        </div>
    </div>
</div>

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<NA.PMS.Model.LeaseRentViewModel>()
            .Name("grid_#=Id#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.LeaseRentPremium).Title("Leaserent").Width(120);//.ClientTemplate("<span>#= ServiceName #<br/><small ><b>Receiving Date:</b>&nbsp;#= CreatedDate#</small></span>");
                columns.Bound(c => c.PanelInterest).Title("Interest");
                columns.Bound(c => c.DuesAmount).Title("Dues");
                columns.Bound(c => c.PaidAmount).Title("Paid");
                columns.Bound(c => c.BalanceAmount).Title("Balance");
                columns.Bound(c => c.DepositDueDate).Title("Dues Date").Format("{0:dd-MMM-yyyy}");
                columns.Bound(c => c.DepositDate).Title("Deposited").Format("{0:dd-MMM-yyyy}");
                columns.Bound(c => c.Comment);//.ClientTemplate("<label>#=Comment#</label>");
                //columns.Bound(o => o.Status).Width(120).Title("Update Status").ClientTemplate("<label class='lbl-status-action' onclick='javascript:OpenStatusWindow(this)'>#=Status#</label>");
                //columns.Bound(o => o.RequestDate).Format("{0:dd/MM/yyyy}").Width(120);
            })
            .DataSource(dataSource => dataSource
                            .Ajax().Read(read => read.Action("GetLeaseRentDuesPaymentById", "Payment", new { area = "Revenue", RefId = "#=Id#" })).PageSize(5)
            )
            .ToClientTemplate()
    )
</script>
<script>
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
</script>


<script type="text/javascript">
    $(document).ready(function () {
        $('#dues-update-window').kendoWindow({
            modal: true,
            title: "Dues Update Window",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "30%"
            },
            width: "40%", height: "35%"
        });

        $('#btnSubmitAction').click(function () {
            //UpdateDuesByDepartment();
            UpdateLeaseRentDues();
        });

        //var windowWidget = $("#dues-update-window").data("kendoWindow");
        //$("#btn-loading-image").click(function () {
        //    kendo.ui.progress(windowWidget.element, true);
        //});
        $("span.fa-refresh").attr("title", "Update Lease Rent");
    });



        function ChangeDeptEvent() {
            $("#GridLeaseRentDues").data("kendoGrid").dataSource.read();
            //$("#gridNDCDdetails").data("kendoGrid").dataSource.read();
        }

        function NDC() {
            var objNDC = { DepartmentId: $("#DepartmentId").val(), IsLeaseRentPaid: '@NA.PMS.Common.NDCOptions.Id_Yes' }
            return objNDC;
        }

        function LeaseRent() {
            var model = { DepartmentId: $("#DepartmentId").val(), PremiumPaidStatus: '@NA.PMS.Common.NDCOptions.Id_No' };
            return model;
        }

    function OpenUpdateWindow() {
        $("#dues-update-window").data("kendoWindow").center();
        $("#dues-update-window").data("kendoWindow").open();
        $("#dues-update-window").data("kendoWindow").pin();
    }

    function UpdateLeaseRentDues() {
        if ($("#DDLDepartmentId").val() != "" && $('#DPCurrentDuesDate').val() != "") {
            var windowWidget = $("#dues-update-window").data("kendoWindow");
            kendo.ui.progress(windowWidget.element, true);
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json;charset=utf-8",
                data: JSON.stringify({ DepartmentId: $("#DDLDepartmentId").val(), CurrentDuesDate: $('#DPCurrentDuesDate').val() }),
                //url: '/Revenue/Payment/UpdateLeaseRentDuesPayment',
                url: '/Revenue/Payment/UpdateDuesPaymentByDepartment',
                success: function (result) {
                    $("#dues-update-window").data("kendoWindow").close();
                    if (result == '@ReturnType.Success') {
                        alertify.success("Dues updated successfully");
                        $('#GridLeaseRentDues').data("kendoGrid").dataSource.read();
                    }
                    else {
                        alertify.error("Dues is not updated");
                        return false;
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Something is wrong, try again later");
                }
            });
        }
        else {
            alertify.error("Select Department");
        }
    }

    function UpdateDuesByDepartment() {
        if ($('#DDLDepartmentId').val() == '') {
            alertify.error("Please select Department");
            return false;
        }
        else {
            var windowWidget = $("#dues-update-window").data("kendoWindow");
            kendo.ui.progress(windowWidget.element, true);
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json;charset=utf-8",
                data: JSON.stringify({ DepartmentId: $("#DDLDepartmentId").val(), ActionType: '@Constants.Installment' }),
                url: '@Url.Action("UpdateDuesPaymentDetails", "Payment", new { area = "Revenue" })',
                success: function (result) {
                    kendo.ui.progress(windowWidget.element, false);
                    $("#dues-update-window").data("kendoWindow").close();
                    if (actionType == '@Constants.Installment' && result == '@ReturnType.Updated') {
                        alertify.success("Dues updated successfully");
                        $('#InstallmentDuesGrid').data("kendoGrid").dataSource.read();
                    }
                    if (actionType == '@Constants.Leaserent' && result == '@ReturnType.Updated') {
                        alertify.success("Dues updated successfully");
                        $('#InstallmentDuesGrid').data("kendoGrid").dataSource.read();
                    }
                    else {
                        alertify.error("Dues is not updated");
                        return false;
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Something is wrong, try again later");
                }
            });
        }
    }


    function PrintDemandNote(registrationId, dueAmount) {
        //, DuesUptoDate: duesUptoDate

        var _ObjDemand = { RegistrationId: registrationId, LeaseRentDues: dueAmount };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ _LeaseRentViewModel: _ObjDemand }),
            url: '/Revenue/Finance/PrintDemandNote',
            success: function (result) {
                //$("#divApplicationForm").modal('hide');
                $("#divSchemeForm").html(result);
                $("#divPrintSchemeForm").modal('show');
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alertify.error("Some Error in save database.");
            }
        });
    }

    function CalculateDuesUptoDate(rid) {
        var flag = confirm("Are You sure to update Lease Rent of RID " + rid);     
        if (rid != 0 && flag == true) {
            //OpenUpdateWindow()
            //var windowWidget = $("#dues-update-window").data("kendoWindow");
            var windowWidget = $("#GridLeaseRentDues").data("kendoGrid");
            kendo.ui.progress(windowWidget.element, true);
            //$("#dues-update-window").data("kendoWindow").center();
            //$("#dues-update-window").data("kendoWindow").open();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ RegistrationId: rid, ActionType: "LeaseRent" }),
                url: '/Revenue/Payment/UpdateLeaseRentDuesPaymentByIdII',
                success: function (result) {
                    if (result == '@ReturnType.Updated') {
                        $("#dues-update-window").data("kendoWindow").close();
                        $("#GridLeaseRentDues").data("kendoGrid").dataSource.read();
                        alertify.success("Dues Updated successfully");
                    }
                    else if (result == '@ReturnType.Paid') {
                        $("#GridLeaseRentDues").data("kendoGrid").dataSource.read();
                        alertify.success("Lease rent onetime paid");
                    }
                    else if (result == '@ReturnType.None') {
                        alertify.error("Dues is not Updated.");
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    alertify.error("Some Error in save database.");
                }
            });
        }
    }




    function PrintSchemeFormDiv() {
        var contents = document.getElementById("divSchemeForm").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }


</script>
