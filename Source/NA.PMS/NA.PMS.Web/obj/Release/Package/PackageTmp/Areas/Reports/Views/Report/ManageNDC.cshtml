@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
@using NA.PMS.Common;

@{
    ViewBag.Title = "Manage NDC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #ChallanWindow{
        display:none;
    }
    .hyperlink.verify{
        font-weight: bold;
        color: blue;
    }
</style>
<div id="divManageNDC">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">No Dues Certificate</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                <a href="/Revenue/Finance/NDC" class="" target="_blank">Generate NDC</a>
                @*<a href="/Member/Authority/NDCForm"  class="" target="_blank">Generate NDC</a>*@
                <a href="#" id="AddRentRequest" class="" onclick="javascript: GenerateNoDuesCertificate(event);">Generate No Dues Certificate</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 row blnk-rw"></div>
    <div class="col-md-12">
        <ul class="nav nav-tabs content-tabs" id="ulProperty" role="tablist">
            <li><a href="#one" role="tab" data-toggle="tab">NDC OLD</a></li>
            <li class="active"><a href="#two" role="tab" data-toggle="tab">NDC After 2018</a></li>
        </ul>
    </div>
    <div class="col-md-12 tab-content">
        <div class="tab-pane fade" id="one">
            <div class="col-md-12 k-grid-content">
                @(Html.Kendo().Grid<NA.PMS.Model.NDCVeiwModel>()
                    .Name("NDCGrid")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.Id).Hidden();
                        columns.Bound(c => c.RegistrationId).Title("Registration Id");
                        columns.Bound(c => c.Applicant).Title("Applicant");
                        columns.Bound(c => c.EntryDate).Title("Request Date").Format("{0:dd-MM-yyyy}");
                        columns.Bound(c => c.NDCDate).Title("Issue Date").Format("{0:dd-MM-yyyy}");
                        columns.Bound(c => c.Status).Title("Status");
                    })
                        .Sortable().Filterable().Resizable(resize => resize.Columns(true))
                        .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                        .DataSource(dataSource => dataSource
                        .Ajax().Model(model => model.Id(p => p.Id))
                        .ServerOperation(true).Sort(sort => sort.Add("Id").Descending())
                        .Read(read => read.Action("GetNoDuesCertificateList", "Report", new { area = "Reports" })).PageSize(10)
                    )
                )
            </div>
        </div>

        <div class="tab-pane fade in active" id="two">
            <div class="col-md-12 k-grid-content">
                @(Html.Kendo().Grid<NA.PMS.Model.NDCVeiwModel>()
                    .Name("NDCGrid2")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.Id).Hidden();
                        columns.Bound(c => c.RegistrationId).Title("Registration Id").Width(100);
                        columns.Bound(c => c.Department).Title("Department").Width(100);
                        columns.Bound(c => c.Applicant).Title("Applicant");
                        columns.Bound(c => c.Sector).Title("Sector").Width(100);
                        columns.Bound(c => c.Block).Title("Block").Width(100);
                        columns.Bound(c => c.PlotNo).Title("Plot No").Width(100);
                        //columns.Bound(c => c.CreatedDate).Title("Request Date").Format("{0:dd-MM-yyyy}");
                        columns.Bound(c => c.NDCDate).Title("Issue Date").Width(100).Format("{0:dd-MM-yyyy}");
                        columns.Bound(c => c.Status).Title("Status").Width(100);
                        columns.Bound(c => c.TemplateContent).Hidden();
                        //columns.Bound(c => c.Id).Title("NDC Letter").Width(100).ClientTemplate("<center><a onclick='javascript:ViewNDCLetter(#=Id#);'><span class='fa fa-print'></span></a></center> ");
                        columns.Bound(c => c.Id).Title("NDC Letter").Width(100).ClientTemplate("#if(StatusId == 1){# <center><a onclick='javascript:ViewNDCLetter(#=Id#);'><span class='fa fa-print'></span></a></center>#}# ");
                        columns.Bound(c => c.Id).Title("Edit").Width(100).ClientTemplate("#if(IsLetterIssued == null || IsLetterIssued == false){#<center><a href='" + "/Member/Authority/EditNDCLetter/#= Id #'><span class='fa fa-edit'></span></a></center>#}else{#<label>Issued</label>#}#  ");
                        columns.Bound(c => c.IsLetterIssued).Title("Action").Width(100).ClientTemplate("#if(IsActive == true){ if(IsLetterIssued == true){#<label>Issued</label>#}else{#<label class='hyperlink verify' onclick='javascript:UpdateRemarks(#=RegistrationId#,#=Id#)'>Generated</label>#}}else{#<label>Cancelled</label>#}#");
                    })
                        .Sortable().Filterable().Resizable(resize => resize.Columns(true))
                        .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                        //.ClientDetailTemplateId("template")
                        //.AutoBind(true)
                        .DataSource(dataSource => dataSource
                        .Ajax().Model(model => model.Id(p => p.Id))
                        .ServerOperation(true).Sort(sort => sort.Add("Id").Descending())
                        .Read(read => read.Action("GetNDCGeneratedListAsDataSource", "Authority", new { area = "Member" })).PageSize(10)
                    )
                )
            </div>
        </div>

    </div>
</div>

