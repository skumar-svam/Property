@model NA.PMS.Model.OnlineFormViewModel
@using Kendo.Mvc.UI
@using NA.PMS.Common

@{
    ViewBag.Title = "Form Preview";
    if (Session["WBasicDetailsNIC"] != null || Model.AppType == Constants.AppType)
    {
        Layout = "~/Views/Shared/_LayoutNIC.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_LayoutOnline.cshtml";
    }
}

<style>
    .hyperlink {
        cursor: pointer;
    }

    .k-button.k-upload-button {
        margin: 0;
    }

    .k-upload-files {
        margin: 0;
    }

    #blah {
        display: none;
    }

        #blah:hover {
            cursor: pointer;
        }

    .glyphicon-user:hover {
        cursor: pointer;
    }

    #divUserPhoto {
        width: 100px;
        height: 120px;
        float: right;
        margin: 0 0px 20px 0;
    }

    #divUserSign {
        width: 100px;
        height: 40px;
        float: right;
    }

    #UserImage {
        width: 100px;
        height: 120px;
    }

    #UserSign {
        width: 100px;
        height: 40px;
        margin-top: 80px;
    }

    .red {
        color: red;
    }
</style>
<div>
    <div style="text-align:center;margin-top:25px;margin-bottom:50px; color:green;font-weight:700; font-size:20px">Payment has been successfully processed, <a style="margin-bottom:50px;" target="_blank" href="http://doc.mynoida.in/SchemData/broucherInstutional.pdf">Click here to download the broucher</a></div>
    <div style="text-align:center;">
        <a href="/Online/Application/SchemeInformation" class="btn btn-default">Click here to view all the Schemes</a>
    </div>
</div>