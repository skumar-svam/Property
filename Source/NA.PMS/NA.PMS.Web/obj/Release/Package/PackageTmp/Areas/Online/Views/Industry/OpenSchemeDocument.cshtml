    function SaveProposedProject() {
        var pnam = $('#SchemeProposedFirm_ProposedProject').val();
        var cost = $('#SchemeProposedFirm_TotalCost').val();
        var time = $('#SchemeProposedFirm_ImplementationTime').val();
        if (pnam == "" || pnam == undefined) {
            alertify.error("Enter Project Name");
            return false;
        }
        else if (cost == "" || cost == undefined) {
            alertify.error("Enter Estimated Cost");
            return false;
        }
        else if (time == "" || time == undefined) {
            alertify.error("Enter Estimated Time");
            return false;
        }
        else {
            var proj = {
                ApplicationFormId: $('#ApplicationFormId').val(),
                ProposedProject: pnam,
                TotalCost: cost,
                ImplementationTime: time,
                ActionType: "SaveProject"
            };
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ model: proj }),
                url: "/Online/Industry/SaveProposedFirmDirectorsDetail",
                success: function (data) {
                    if (data.ReturnTypeId == '@OSReturnTypeId.Saved') {
                        alertify.success("Record added successfully.");
                    }
                    else {
                        alertify.error("Provider failed to save data.");
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    //alert("error");
                }
            });
        }
    }

    function ProposedFirmPANChangeEvent() {
        if ($("#SchemeProposedFirm_PAN").val().trim() == '') {
            $("#SchemeProposedFirm_PAN").val('');
        }
        else {
            var firmpan = $("#SchemeProposedFirm_PAN").val().trim();
            var panregex = /^[A-Z]{5}\d{4}[A-Z]{1}$/;
            if (!panregex.test(firmpan) || firmpan.length != 10) {
                alertify.error("Pan Number format is wrong.");
                $("#SchemeProposedFirm_PAN").val('');
                return false;
            }
        }
    }


