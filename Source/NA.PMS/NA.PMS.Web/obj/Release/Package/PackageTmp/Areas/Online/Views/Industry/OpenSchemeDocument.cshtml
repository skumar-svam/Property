                            columns.Bound(c => c.DirectorId).Hidden();
                            columns.Bound(c => c.Id).Title("SNo").Width(50);
                            columns.Bound(c => c.DirectorName).Title("Name").Width(80);
                            columns.Bound(c => c.DirectorType).Title("Type").Width(50);
                            columns.Bound(c => c.DirectorShare).Title("Share (In %)").Width(80);
                            columns.Bound(c => c.PAN).Title("PAN").Width(80);
                            columns.Bound(c => c.DirectorId).Hidden(true).Title("Action");
                            columns.Bound(c => c.DirectorId).Title("Action").ClientTemplate("<a href='##' onclick='javascript: return RemoveProposedDirector(this);' id='RemoveTag'>Remove</a>").Width(50).Filterable(false).Sortable(false);
                        })
                        .Resizable(resize => resize.Columns(true))
                        .AutoBind(true)
                        .DataSource
                        (
                            dataSource => dataSource
                            .Ajax().Model(model => model.Id(p => p.Id))
                            .ServerOperation(true)
                            .Read(read => read.Action("GetProposedFirmDirectorsDetailAsDataSource", "Industry", new { area = "Online" }).Data("FilterFormId"))
                        )
                    )
                </div>


                <div class="col-md-12" style="border:solid #e2e3e4; border-width:0 1px 1px">
