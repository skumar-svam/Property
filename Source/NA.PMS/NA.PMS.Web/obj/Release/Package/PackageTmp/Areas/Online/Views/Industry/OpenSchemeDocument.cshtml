@model NA.PMS.OnlineScheme.SchemeFormViewModel
@using Kendo.Mvc.UI
@using NA.PMS.OnlineScheme
@using NA.PMS.Common

@{
    ViewBag.Title = "Open Scheme Document";
    if (Session["WBasicDetailsNIC"] != null || Model.AppType == Constants.AppType)
    {
        Layout = "~/Views/Shared/_LayoutNIC.cshtml";
    }
    else
    {
        Layout = "~/Areas/Online/Views/Shared/_LayoutOnlineScheme.cshtml";
    }
 }
<style>
    .hyperlink {
        color: #547ae1;
    }

        .hyperlink:hover {
            cursor: pointer;
            color: #547ae1;
        }

    #divCompanyInfo {
        display: none;
    }

    #second-form {
        display: none;
    }

    .k-button.k-upload-button {
        margin: 0;
    }

    .k-upload-files {
        margin: 0;
    }

    #loader {
        display: none;
    }

</style>

@using (Html.BeginForm("SaveDocumentForOnlineSchemeForm", "Industry", FormMethod.Post, new { enctype = "multipart/form-data", id = "applicationform" }))
{
    <div class="upload-document" id="UploadDocument">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Upload Document</h1></div>
                <div class="col-md-6 col-sm-6 col-xs-12 mandatory"><h1 class="gridTitle">Form No :- @Model.ApplicationFormId</h1></div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce" id="first-form">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
                <h2 class="blck-heading" style="margin-bottom:6px;">Upload Document/PDF</h2>
                <div class="form-bx">
                    <div>
                        @Html.HiddenFor(model => model.Id)
                        @Html.HiddenFor(model => model.ApplicationFormId)
                        @Html.HiddenFor(model => model.EncryptedFormId)
                        @Html.HiddenFor(model => model.SchemeId)
                        @Html.HiddenFor(model => model.SchemeTypeId)
                        @Html.HiddenFor(model => model.DepartmentId)
                        @Html.HiddenFor(model => model.ApplicantType)
                        @Html.HiddenFor(model => model.StrDocList)
                        @Html.HiddenFor(model => model.DocumentIdList)
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-md-4 col-40 col-sm-6 col-xs-12 form-group">
                                    @Html.Label("Scheme Name", htmlAttributes: new { @class = "required" })
                                </div>
                                <div class="col-md-8 col-60 col-sm-6 col-xs-12 form-group">
                                    @Html.TextBoxFor(model => model.SchemeName, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-40 col-sm-6 col-xs-12 form-group">@Html.Label("Department", htmlAttributes: new { @class = "required" })</div>
                                <div class="col-md-8 col-60 col-sm-6 col-xs-12 form-group">
                                    @Html.TextBoxFor(model => model.Department, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-40 col-sm-6 col-xs-12 form-group">@Html.Label("Applicant", htmlAttributes: new { @class = "required" })</div>
                                <div class="col-md-8 col-60 col-sm-6 col-xs-12 form-group">
                                    @Html.TextBoxFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", placeholder = "", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-40 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                                    @Html.Label("Area Range", htmlAttributes: new { @class = "required" })
                                </div>
                                <div class="col-md-8 col-60 col-sm-3 col-xs-12 form-group col-prnt-lt4">
                                    @Html.TextBoxFor(model => model.AreaRange, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6" style="">
                            <div class="row">
                                <div class="col-md-4 col-40 col-sm-6 col-xs-12">

                                </div>
                                <div class="col-md-8 col-60 col-sm-6 col-xs-12 form-group">
                                    <div class="row">
                                        <div class="col-md-12 text-right" style="margin-bottom:5px;">
                                            <img id="userphoto" src="@Model.UserImage" alt="your image" height="150px" width="140px" name="userImage2" />
                                        </div>
                                        <div class="col-md-12 text-right">
                                            <img id="signature" src="@Model.SignImage" alt="your sign" height="40px" width="140px" name="usersign" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>

                <h2 class="blck-heading" style="">Proposed Project Detail</h2>
                <div class="form-bx" id="ProposedCompany">
                    <div class="row">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Proposed Project Name", new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.SchemeProposedFirm.ProposedProject, new { @class = "form-control", @maxlength = "100" })
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Estimated Cost  (In lakhs)", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.SchemeProposedFirm.TotalCost, new { @class = "form-control", @maxlength = "8", onkeypress = "return IsNumeric(event);" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Implementation Time (yr)", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.SchemeProposedFirm.ImplementationTime, new { @class = "form-control", @maxlength = "2", onkeypress = "return IsNumeric(event);" })
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group">

                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">
                            <input type="button" class="k-button" value="Save Project" id="btn-save-project" style="min-width:110px;" />
                        </div>
                    </div>
                </div>

                <h2 class="blck-heading" style="">Director's Information</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Director's Name", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.SchemeProposedFirm.DirectorName, new { @class = "form-control", @maxlength = "99" })
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Director's Share(%)", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.SchemeProposedFirm.DirectorShare, new { @class = "form-control", @maxlength = "7" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Director Type", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(model => model.SchemeProposedFirm.DirectorTypeId)
                                .DataTextField("Text")
                                .DataValueField("Id")
                                .OptionLabel("--Select--")
                                .DataSource(source => source.Read(read => read.Action("GetDirectorTypeList", "Default", new { area = "Online" })))
                                .HtmlAttributes(new { @class = "", style = "width:100%;" })
                            )
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group">
                            @Html.Label("PAN")
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.SchemeProposedFirm.PAN, new { @class = "form-control", @maxlength = "10", @onchange = "ProposedFirmPANChangeEvent();" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group">
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">
                        </div>
                        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group">
                        </div>
                        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">
