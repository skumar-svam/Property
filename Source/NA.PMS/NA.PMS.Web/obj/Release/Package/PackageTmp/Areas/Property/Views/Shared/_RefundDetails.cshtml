<style>
    .lbl-form-control{
        background:#ececec;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Deduction Amount")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblDedAmt" class="lbl-form-control"></label>
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Unit")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblUnit" class="lbl-form-control"></label>
        </div>
    </div>
  
    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Deduction Apply On")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblDedApp" class="lbl-form-control"></label>
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Refund Lock Period")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblRLP" class="lbl-form-control"></label>
        </div>
    </div>
   
    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Interest rate")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblIntRate" class="lbl-form-control"></label>
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Days After Interest")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label id="lblDAI" class="lbl-form-control"></label>
        </div>
    </div>
</div>
