@*Login Form for Online Scheme*@
<div class="col-md-12" id="divLoginWindow">
    @{
        using (Html.BeginForm("SchemeLogin", "Application", new { area = "Online" }, FormMethod.Post, new { enctype = "multipart/form-data", id = "SchemeLoginform" }))
        {
            @*<input type="hidden" id="SchemeType" name="SchemeType" />*@
            <div class="row" style="padding-top:25px;">
                <div class="col-md-4 col-sm-6 col-xs-12 form-group" style="">
                    <label><b>Username/Form ID:</b></label>
                </div>
                <div class="col-md-6 col-sm-6 col-xs-12 form-group">
                    <input type="text" class="form-control" id="txtUserName" name="txtUserName" maxlength="10" placeholder="Enter Your User Name/Form ID" style="width:100%" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 col-sm-6 col-xs-12 form-group" style="">
