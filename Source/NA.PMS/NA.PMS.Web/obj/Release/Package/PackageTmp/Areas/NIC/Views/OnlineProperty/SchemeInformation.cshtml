                    <input class="btn btn-danger" type="button" value="Cancel" id="btnCancelLogin" />
                </div>
                <div class="col-md-12 col-sm-12 col-xs-12 form-group text-center">
                    @*<p class="message"><a href="#" data-toggle="modal" data-target="#divForgotPasswordWindow" id="ForgotPasswordWindow">Forgot Your Password?</a></p>*@
                    <p class="message"><a href="#" id="ForgotPasswordWindow">Forgot Your Password?</a></p>
                </div>
            </div>
        }
    }
</div>

@*Forgot Password*@
<div class="col-md-12" id="divForgotPasswordWindow">
    @{
        <br />
        <div class="row" style="">
            <div class="col-md-4 col-sm-6 col-xs-12 form-group" style="">
                <label><b>Username/Form ID:</b></label>
            </div>
            <div class="col-md-6 col-sm-6 col-xs-12 form-group">
                <input type="text" class="form-control" id="ApplicationFormId-FFP" name="ApplicationFormId-FFP" maxlength="10" placeholder="Enter Your User Name/Form ID" style="width:100%" />
            </div>
            <div class="col-md-4 col-sm-6 col-xs-12 form-group" style="">
                <label><b>Mobile No.:</b></label>
            </div>
            <div class="col-md-6 col-sm-6 col-xs-12 form-group">
                <input type="text" class="form-control" id="MobileNumber" name="MobileNumber" maxlength="10" placeholder="Enter Your Mobile Number" style="width:100%" />
            </div>
            <div class="col-md-4 col-sm-6 col-xs-12 form-group" style="">
                <label><b>Email ID:</b></label>
            </div>
            <div class="col-md-6 col-sm-6 col-xs-12 form-group">
                <input type="text" class="form-control" id="Email" name="Email" maxlength="40" placeholder="Enter Your Email" style="width:100%" />
            </div>
            <div class="col-md-12 col-sm-12 col-xs-12 form-group text-center">
                <input class="btn btn-success" type="submit" value="Submit" id="btnForgotPassword" />
                <input class="btn btn-danger" type="button" value="Cancel" id="btnCancelForgotPassword" />
            </div>
            <div class="col-md-12 col-sm-12 col-xs-12 form-group text-center">
                <p class="message"><a href="#"  id="LoginWindow">Back to Login.</a></p>
            </div>
        </div>

    }
</div>

<script type="text/javascript">
    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }

    var redirectType;
    $(document).ready(function () {
        $("#ShowPasswordWindow").hide();

        $('input[name=TRegisteredUser]').prop('checked', false);
        $('input[name=OERegisteredUser]').prop('checked', false);
        $('input[name=IPRegisteredUser]').prop('checked', false);

        $('input:radio[name=OERegisteredUser]').on('click', function () {
            var radiobtnVal = $('input[name=OERegisteredUser]:checked').val();
            if (radiobtnVal == "OERegistered") {
                $("#SchemeType").val('@OnlineSchemeType.OpenEnded');
                $("#divLoginWindow").data("kendoWindow").center();
                $("#divLoginWindow").data("kendoWindow").open();
                $("#divLoginWindow").data("kendoWindow").pin();
            }
            else if (radiobtnVal == "OEUnRegistered") {
                //alert("Open Ended Scheme has been closed on 31-Dec-2018");
                //var id = $('#ApplicationFormId').val();
                @*window.location.href = '@Url.Action("OpenSchemeForm", "Application", new  { area="Online",})';*@
                window.location.href = "/NIC/OnlineProperty/IndustrialOpenEndForm?id=" + $('#ApplicationFormId').val() + "&controlid=" + $('#NICControlId').val() + "&unitid=" + $('#NICUnitId').val() + "&serviceid=" + $('#NICServiceId').val()
                //$("#OESform").submit();
            }
        });

        $('input:radio[name=TRegisteredUser]').on('click', function () {
            var radiobtnVal = $('input[name=TRegisteredUser]:checked').val();
            if (radiobtnVal == "TRegistered") {
                $("#SchemeType").val('@OnlineSchemeType.Transport');
                $("#divLoginWindow").data("kendoWindow").center();
                $("#divLoginWindow").data("kendoWindow").open();
                $("#divLoginWindow").data("kendoWindow").pin();
            }
            else if (radiobtnVal == "TUnRegistered") {
                //alert("Scheme has been closed on 31-03-2018");
                window.location.href = '@Url.Action("TransportSchemeForm", "Application", new { area = "Online" })';
            }
        });

        $('input:radio[name=IPRegisteredUser]').on('click', function () {
            var radiobtnVal = $('input[name=IPRegisteredUser]:checked').val();
            if (radiobtnVal == "IPRegistered") {
                $("#SchemeType").val('@NASchemeType.IndustriaScheme');
                $("#divLoginWindow").data("kendoWindow").center();
                $("#divLoginWindow").data("kendoWindow").open();
                $("#divLoginWindow").data("kendoWindow").pin();
            }
            else if (radiobtnVal == "IPUnRegistered") {
                //alert("Scheme has been closed on 30-Nov-2018 : 5:00PM");
                @*window.location.href = '@Url.Action("IndustrialForm", "OnlineProperty", new { area = "NIC" })';*@
                //$.post("/NIC/OnlineProperty/IndustrialForm?id=" + $('#ApplicationFormId').val() + "&controlid=" + $('#NICControlId').val() + "&unitid=" + $('#NICUnitId').val() + "&serviceid=" + $('#NICServiceId').val());
                window.location.href = "/NIC/OnlineProperty/IndustrialForm?id=" + $('#ApplicationFormId').val() + "&controlid=" + $('#NICControlId').val() + "&unitid=" + $('#NICUnitId').val() + "&serviceid=" + $('#NICServiceId').val();
                }
        });

        $("#btnCancelLogin").click(function () {
            $('input[name=TRegisteredUser]:checked').prop('checked', false);
            $('input[name=OERegisteredUser]:checked').prop('checked', false);
            $("#divLoginWindow").data("kendoWindow").close();
        });

        $("#btnCancelForgotPassword").click(function () {
            $('input[name=TRegisteredUser]:checked').prop('checked', false);
            $('input[name=OERegisteredUser]:checked').prop('checked', false);
            $("#divForgotPasswordWindow").data("kendoWindow").close();
        });

        $("#btnForgotPassword").click(function () {

            var formId = $("#ApplicationFormId-FFP").val();
            var Email = $("#Email").val();
            var mobileNo = $("#MobileNumber").val();

            $.ajax({
                url: '@Url.Action("ValidateForgotPassword", "Application", new { area = "Online"})',
                type: 'POST',
                data: { ApplicationFormId: formId, MobileNumber: mobileNo, Email: Email },
                success: function (result) {
                    if (result == '@ReturnType.Exist') {
                        alertify.success("Password has been send to your registed mobile no and email both.");
                        $('#divForgotPasswordWindow').data("kendoWindow").close();
                    }
                    else if (result == '@ReturnType.Failure') {
                        alertify.error("Application is inactive.");
                    }
                    else if (result == '@ReturnType.UserNameNotExist') {
                        alertify.error("please enter valid credentials.");
                    }
                    else {
                        alertify.error("Please enter again.");
                        return false;
                    }
                }
            });
        });


        @{
            if (TempData["ServiceMessage"] != null && TempData["ServiceMessage"] != "")
            {
                 @:alertify.error('@TempData["ServiceMessage"]');
                                                                                            }
        }

        @{
            if (TempData["PasswordMessage"] != null && TempData["PasswordMessage"] != "")
            {
                @:alertify.error('@TempData["PasswordMessage"]');
                                                                                            }
        }

        @{
            if (TempData["PaymentStatus"] != null && TempData["PaymentStatus"] != "")
             {
                 if(TempData["PaymentStatus"]=="error")
                 {
                     @:alertify.error('@NAMessages.OAFPaymentError');
                                                                                                                                                                                                                                                                                                                                 }
                 if (TempData["PaymentStatus"] == "refresh")
                 {
                    @:alertify.error('@NAMessages.OAFPageRefresh');
                                                                                                                                                                                                                                                                                  }
             }
         }

        @{
            if (TempData["FailedTraxaction"] != null && TempData["FailedTraxaction"] != "")
            {
                @:alertify.error('Transaction Failed');
                                                                                                                                                                                                                                                                                            }
            if (TempData["MismatchTraxaction"] != null && TempData["MismatchTraxaction"] != "")
            {
                @:alertify.error('Transaction mismatch');
                                                                                                                                                                                                                                                                                                            }
        }

        @{
            if (TempData["OfflinePayment_RTGS"] != null && TempData["OfflinePayment_RTGS"] != "")
            {
                @:alertify.success('@TempData["OfflinePayment_RTGS"]');
                                                                                                                                                                                                                                                                                    }
        }

        @{
             if (TempData["ErrorLoginMessage"] != null && TempData["ErrorLoginMessage"] != "")
             {
                 @:alertify.error('@TempData["ErrorLoginMessage"]');
                                                                                                                             }
         }

        $("#ForgotPasswordWindow").click(function () {
            $("#divForgotPasswordWindow").data("kendoWindow").center();
            $("#divForgotPasswordWindow").data("kendoWindow").open();
            $("#divForgotPasswordWindow").data("kendoWindow").pin();
            $("#divLoginWindow").data("kendoWindow").close();
        });

        $("#LoginWindow").click(function () {
            $("#divLoginWindow").data("kendoWindow").center();
            $("#divLoginWindow").data("kendoWindow").open();
            $("#divLoginWindow").data("kendoWindow").pin();
            $("#divForgotPasswordWindow").data("kendoWindow").close();
        });


        $('#btnUpload').click(function () {
            redirectType = "Upload";
            UploadDocument();
            //ValidateApplicationFormId(redirectType);
        });

        $('#btnUpdate').click(function () {
            redirectType = "Edit";
            ValidateApplicationFormId(redirectType);
        });

        //$('#btnPreview').click(function () {
        //    redirectType = "Preview";
        //    //ValidateApplicationFormId(redirectType);
        //    var formId = $('#txtFormId').val();
        //    window.location.href = "/Online/Application/PreviewForm/" + formId;
        //});

        $("#btnPayment").click(function () {
            redirectType = "Payment";
            ValidateApplicationFormId(redirectType);
        });

        $('#btnResend').click(function () {
            SendOTPtoUser();
        });

        $('#btnMobileOTP').click(function () {
            ValidateOTP();
        });

        $('#divOTPwindow').kendoWindow({
            modal: true,
            title: "Online Form Payment",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "30%"
            },
            width: "40%", height: "35%"
        });


        $('#divLoginWindow').kendoWindow({
            modal: true,
            title: "Login Form for Online Scheme",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "30%"
            },
            width: "40%", height: "35%"
        });


        $('#divForgotPasswordWindow').kendoWindow({
            modal: true,
            title: "Forgot Password Form for Online Scheme",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "30%"
            },
            width: "40%", height: "35%"
        });
    });

    function ValidateApplicationFormId(redirectType) {
        var formId = $('#txtFormId').val();
        if (formId.trim() != "" && formId.length == 8) {
            $.ajax({
                type: 'POST',
                dataType: 'json',
                data: { formNo: formId },
                url: '/Online/Application/ValidateFormNumber',
                success: function (result) {
                    if (result == '@ReturnType.NotExist') {
                        alertify.error("Form number doesn't exist.");
                        $('#txtFormId').val('');
                    }
                    else {
                        //$('#hdnFormId').val(formId);
                        if (redirectType == "Edit") {
                            //CheckUpdationForm(formId);
                            alertify.error("Scheme has been closed.");
                        }
                        if (redirectType == "Preview") { showPreviewOrReciept(formId); } //return window.location.href = "/Online/Application/PreviewForm/" + formId;
                        if (redirectType == "Payment") {
                            //ValidatePayment(formId);
                            ValidateDocument(formId);
                        }
                        if (redirectType == "Upload") {
                            alertify.error("Scheme has been closed.");
                            //UploadDocument();
                        }
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    //alert(respText);
                }
            });
        }
        else {
            alertify.error("Enter correct form number.");
            return false;
        }
    }

