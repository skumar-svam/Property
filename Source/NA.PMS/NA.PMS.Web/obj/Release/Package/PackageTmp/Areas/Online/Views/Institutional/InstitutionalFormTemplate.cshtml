    #ApplicationDirectorGrid #gridDirectors table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid black;
    }

        #ApplicationDirectorGrid #gridDirectors table td, table th {
            border: 1px solid black;
        }

        #ApplicationDirectorGrid #gridDirectors table tr:first-child th {
            border-top: 0;
        }

        #ApplicationDirectorGrid #gridDirectors table tr:last-child td {
            border-bottom: 0;
        }

        #ApplicationDirectorGrid #gridDirectors table tr td:first-child,
        #ApplicationDirectorGrid #gridDirectors table tr th:first-child {
            border-left: 0;
        }

        #ApplicationDirectorGrid #gridDirectors table tr td:last-child,
        #ApplicationDirectorGrid #gridDirectors table tr th:last-child {
            border-right: 0;
        }

    /*Kendo Grid*/
    .k-grid-header th.k-header > .k-link {
        font-weight: bold;
        color: #484848;
        pointer-events: none;
        cursor: default;
        text-decoration: none;
    }

    .k-filter-row th, .k-grid-header th.k-header {
        overflow: hidden;
        border-style: solid;
        border-width: 0 0 1px 1px;
        padding: .5em .6em .4em .6em;
        font-weight: 400;
        white-space: nowrap;
        text-overflow: ellipsis;
        text-align: left;
        pointer-events: none;
        cursor: default;
    }
</style>
