@model NA.PMS.Model.Property.AddMergeSplitRequestModel

@using Kendo.Mvc.UI
@using NA.PMS.Common
@using NA.PMS.Model.Property

@{
    ViewBag.Title = "Deamalgamation Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="row">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-6 col-xs-12">
                    <h1 class="gridTitle">Edit Deamalgamation Request</h1>
                </div>
                <div class="col-md-6 col-sm-6 col-xs-12 mandatory">
                    @if (Model.Status > 0)
                    {
                        if (Model.Status == Constants.Approved)
                        {
                            <strong style="color: lightgreen;font-size: 18px">
                                <i class=" glyphicon glyphicon-ok-sign" aria-hidden="true"></i>
                                Approved
                            </strong>
                        }
                        else if (Model.Status == Constants.RejectedProp)
                        {
                            <strong style="color: red;font-size: 18px">
                                <i class="glyphicon glyphicon-remove-sign" aria-hidden="true"></i>
                                Rejected
                            </strong>
                        }
                        else if (Model.Status == Constants.Cancelled)
                        {
                            <strong style="color: red;font-size: 18px">
                                <i class="glyphicon glyphicon-remove-sign" aria-hidden="true"></i>
                                Cancelled
                            </strong>
                        }
                    }


                </div>
            </div>
        </div>
        @Html.HiddenFor(m => m.PropertyNumber)
        @Html.HiddenFor(m => m.SchemeName)
        @Html.HiddenFor(m => m.BlockName)
        @Html.HiddenFor(m => m.SectorName)

        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce">
            <div class="inr-bx" style="border: solid #e2e3e4; border-width: 0 1px 1px">
                <h2 class="blck-heading">Filter Property</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.LabelFor(m => m.DepartmentName)
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                                  .Filter("contains")
                                  .OptionLabel("-Select-")
                                  .DataTextField("Text")
                                  .DataValueField("Value")
                                  .BindTo(Model.DepartmentCollection)
                                    //.Events(events => { events.Change("DepartmentSelection"); })
                                  .HtmlAttributes(new { style = "width: 100%", TabIndex = 1 })
                                          .Enable(false)
                            )
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Registration Id")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(m => m.Rid)
                                      .Filter("contains")
                                      .CascadeFrom("DepartmentId")
                                      .DataTextField("Text")
                                      .DataValueField("Value")
                                      .OptionLabel("-Select-")
                                      .Events(events => { events.Change("RidSelection"); })
                                      .DataSource(source =>
                                      {
                                          source.Read(read =>
                                          {
                                              read.Action("GetAllRidsForSplit", "MergeSplitProperties")
                                                  .Data("FilterRIDs");
                                          })
                                              .ServerFiltering(true);
                                      })
                                      .HtmlAttributes(new { style = "width: 100%", TabIndex = 5 })

                                      .Enable(false)
                                      .AutoBind(false)
                            )
                        </div>
                        <script>
                            function FilterRIDs() {
                                return {
                                    departmentId: $("#DepartmentId").val()
                                };
                            }
                        </script>
                    </div>

                </div>
                <h2 class="blck-heading">Property Detail</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">

                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            <input type="button" id="btnViewComments" style="float: right; display: none;" value="View Comments" class="btn btn-default" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.LabelFor(m => m.ApplicantName)
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(m => m.ApplicantName, new { @Readonly = "readonly", @class = "form-control" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.LabelFor(m => m.DepartmentName)
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(m => m.DepartmentName, new { @Readonly = "readonly", @class = "form-control" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.LabelFor(m => m.PropertyType)
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(m => m.PropertyType, new { @Readonly = "readonly", @class = "form-control" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.LabelFor(m => m.TotalArea)
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(m => m.TotalArea, new { @Readonly = "readonly", @class = "form-control" })
                        </div>
                    </div>
                    @Html.HiddenFor(m => m.CoveredArea)
                    @Html.HiddenFor(m => m.ActualArea)
                    @Html.HiddenFor(m => m.TotalPropertyCost)

                    <div id="gridProperties" style="margin-left:30px;"></div>
                    <div class="row" style="margin-left:30px;">
                        <div class="k-grid-content">
                            @(Html.Kendo().Grid<MergeSplitPropertyGrid>()
                              .Name("gridSplitProperties")
                              .AutoBind(true)
                              .Columns(columns =>
                              {
                                  columns.Bound(c => c.IsSelected).Width(200).ClientTemplate("<input type='checkbox' #= IsSelected ? checked='checked':'' # class='inpchk' ></input>").Filterable(false).Sortable(false).Title("Deamalgamate Property");
                                  columns.Bound(c => c.Rid).Title("Registration Id");
                                  columns.Bound(c => c.DepartmentName).Title("Department");
                                  columns.Bound(c => c.PropertyNumber).Title("Property Number");
                                  columns.Bound(c => c.CoveredArea).Hidden(true);
                                  columns.Bound(c => c.ActualArea).Hidden(true);
                                  columns.Bound(c => c.TotalArea).Hidden(true);
                                  columns.Bound(c => c.TotalPropertyCost).Hidden(true);
                              })
                              .DataSource(dataSource => dataSource
                                  .Ajax()
                                  .Read(read => read.Action("GetPropertiesToSplitByRid", "MergeSplitProperties").Data("getRid"))
                                  .PageSize(20)
                              )

                            )
                        </div>
                        <script>
                            function getRid() {
                                return {
                                    rid: parseInt($("#Rid").val())
                                }
                            }
                        </script>

                    </div>
                    <br />
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Charges", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                           @Html.TextBoxFor(m => m.Charges, new { @class = "form-control", @maxlength = "12" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        </div>
                    </div>

                </div>
            </div>
            <div class="box-button text-center">
                <input type="button" id="btnCancel" value="Back" class="btn btn-default" />
                <input type="button" id="btnCancelRequest" class="btn btn-add" value="Cancel Request" />
                @if (Model.Status == Constants.InProgress)
                {

                }

                @if (Model.Status == Constants.RejectedProp)
                {
                    <input type="button" id="btnSubmit" class="btn btn-add" value="Re-Submit for Approval" />
                }

            </div>
            @Html.HiddenFor(m => m.PropertyId)
            @Html.HiddenFor(m => m.RequestId)
            @Html.HiddenFor(m => m.Status)
        </div>
    </div>
    @Html.HiddenFor(m => m.ListMergeSplitPropertyGrid)
    <input type="hidden" id="hdnAllRids" />
</div>

@(Html.Kendo().Window().Name("popUpViewComments").Title("Comments").Modal(true).Visible(false).Content(@<text>
        <div class="container-fluid">
            <div class="row">
                @Html.LabelFor(m => m.AssignedTo) : @Html.TextBoxFor(m => m.AssignedTo)
                <br />
                @Html.LabelFor(m => m.RequestDate) : @Html.TextBoxFor(m => m.RequestDate)
                <br />
                @Html.LabelFor(m => m.Comments) : @Html.TextAreaFor(m => m.Comments, new { @cols = "52", @rows = "6" })
            </div>
            <br />
            <div class="row" style="text-align:right">
                @*<input type="submit" class="btn btn-default" id="btnPopupComments" value="Submit" />*@
                <input type="button" id="btnClosePopUp" class="btn btn-default closePopup" value="Close" />
            </div>
        </div>
</text>)
    .Draggable()
    .Resizable()
    //.Width(400)
    .Actions(actions => actions.Close())
)


@(Html.Kendo().Window().Name("assignToWindow").Title("Assign To").Modal(true).Visible(false).Content(@<text>
        <div class="container-fluid">
            <div class="row">
                @Html.Label("Assign To: ")
                @(Html.Kendo().DropDownListFor(model => model.User)
                      .Name("User")
                      .DataTextField("text")
                      .DataValueField("id")
                      .OptionLabel("Select").Filter("contains").AutoBind(false)
                      .DataSource(source =>
                      {
                          source.Read(read =>
                          {
                              read.Action("GetAssineToByDepttId", "PropertyRegistration").Data("AdditionalData");
                          });
                      })
                )
                @*@Html.ValidationMessageFor(model => model.User)*@
            </div>
            <script>
                function AdditionalData() {
                    return {
                        depttId: $("#DepartmentId").val()
                    };
                }
            </script>
            <br />
            <div class="row" style="text-align:right">
                <input type="submit" class="btn btn-default" id="btnPopupSubmit" value="Submit" />
                <input type="button" class="btn btn-default closePopup" value="Close" />
                @*<input type="button" class="btn-primary" id="btnPopupSubmit" value="Submit" />
                    <input type="button" class="btn-danger closePopup" value="Close" />*@
            </div>
        </div>
</text>)
    .Draggable()
    .Resizable()
    //.Width(400)
    .Actions(actions => actions.Close())
)


<script>

    $(document).ready(function () {

        $(".closePopup").click(function () {
            $("#assignToWindow").data("kendoWindow").close();
        });

        $("#btnPopupSubmit").click(function () {
            var charge = $("#Charges").val();
            var requestNo = $("#RequestId").val();
            var parentRid = $("#Rid").val();
            var userId = $("#User").val();
            var items = $("#gridSplitProperties").data("kendoGrid").dataSource.data();
            var rIds = "";
            for (var i = 0; i < items.length; i++) {
                var item = items[i];
                if (item.IsSelected == true) {
                    rIds = rIds + item.Rid + ",";
                }
            }
            var rids = rIds.slice(0, rIds.length - 1);

            $.ajax({
                dataType: 'json',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                url: '/MergeSplitProperties/ReSubmitSplitRequestForApproval',
                data: JSON.stringify({ allRids: rids, rId: parentRid, requestNo: requestNo, userId: userId, charge: charge }),
                success: function (result) {
                    if (result == true) {
                        $("#assignToWindow").data("kendoWindow").close();
                        alertify.success("Request submitted successfully.");
                        window.location.href = '@Url.Action("SplitProperties", "MergeSplitProperties")';
                    } else {
                        alert("There is some error.");
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //alert(respText + "");
                }
            });
        });

    });


</script>


<script type="text/javascript">
    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1 || keyCode == 46);
        if (ret == false)
            return false;
    }

    var checkedPropertyIds = [];
    var checkedRIds = [];

    function SelectAll(e) {
        var state = $(e).is(':checked');
        if (state == true) {
            var grid = $('#gridSplitProperties').data("kendoGrid");
            $.each(grid.dataSource.view(), function () {
                $(".inpchk").prop('checked', 'checked');
                if (this['IsSelected'] != state)
                    this['IsSelected'] = state;
                checkedRIds.push(this.Rid);
                checkedPropertyIds.push(this.PropertyId);
            });
        } else {
            $(".inpchk").removeAttr('checked');
            var grid = $('#gridSplitProperties').data("kendoGrid");
            $.each(grid.dataSource.view(), function () {
                this['IsSelected'] = false;
            });
        }
    }
    var currentDate = new Date().toJSON().slice(0, 10);
    //select selected checkboxes
    $(function () {
        $('#gridSplitProperties').on('change', '.inpchk', function () {

            var checked = $(this).is(':checked');
            $("#chkSelectAll").removeAttr('checked');
            if ($('.inpchk:checked').length == $('.inpchk').length) {
                $("#chkSelectAll").prop('checked', 'checked');
            }
            var grid = $('#gridSplitProperties').data().kendoGrid;
            var dataItem = grid.dataItem($(this).closest('tr'));
            dataItem.set('IsSelected', checked);
            checkedRIds.push(dataItem.Rid);
            checkedPropertyIds.push(this.PropertyId);
        });

    });

    function RidSelection(e) {
        var dataItem = this.dataItem(e.item);
        //$("#DepartmentId").val(dataItem.Value);
        var rId = dataItem.Value;
        $("#Rid").val(rId);
        $.ajax({
            url: '@(Url.Action("GetPropertyDetailsByRid", "MergeSplitProperties"))',
            type: 'POST',
            dataType: 'json',
            data: { rId: rId },
            success: function (result) {
                if (result != null) {
                    $("#ApplicantName").val(result.ApplicantName);
                    $("#DepartmentName").val(result.DepartmentName);
                    $("#PropertyType").val(result.PropertyTypeName);
                    $("#TotalArea").val(result.TotalArea);
                    $("#SchemeName").val(result.SchemeName);
                    $("#PropertyNumber").val(result.PropertyNo);
                    $("#PropertyId").val(result.PropertyId);

                    $("#SectorName").val(result.SectorName);
                    $("#BlockName").val(result.BlockName);
                    $("#CoveredArea").val(result.CoveredArea);
                    $("#ActualArea").val(result.ActualArea);
                    $("#TotalArea").val(result.TotalArea);
                    $("#TotalPropertyCost").val(result.TotalPropertyCost);
                    //alert(result.CoveredArea + ":" + result.ActualArea + ":" + result.TotalArea + ":" + result.TotalPropertyCost);

                    $("#btnAddProperty").show();
                    $("#btnAddProperty").removeAttr('disabled');

                } else {
                    alert("There is some error.");
                }
            }
        });
    }

    $(document).ready(function () {

        $("#btnCancelRequest").click(function () {
            if (confirm("Are you sure? You want to cancel the request.")) {

                //return confirm("You want to cancel the request?");
                var requestNo = $("#RequestId").val();
                //var rids = $("#hdnAllRids").val().slice(0, $("#hdnAllRids").val().length - 1);
                $.ajax({
                    dataType: 'json',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    url: '/MergeSplitProperties/CancelSplitRequest',
                    data: JSON.stringify({ requestNo: requestNo }),
                    success: function (result) {
                        if (result == true) {
                            $("#assignToWindow").data("kendoWindow").close();
                            alertify.success("Request submitted successfully.");
                            window.location.href = '@Url.Action("SplitProperties", "MergeSplitProperties")';
                        } else {
                            alert("There is some error.");
                        }
                    },
                    error: function (objAjaxRequest, strError) {
                        var respText = objAjaxRequest.responseText;
                        //alert(respText + "");
                    }
                });
            } else {
                return false;
            }
        });

        $("#btnCancel").click(function () {
            window.location.href = '@Url.Action("SplitProperties", "MergeSplitProperties")';
        });

        $('#btnSubmit').click(function () {
            if ($("#Charges").val() == "") {
                alertify.error("Please enter Charges.");
                $("#Charges").focus();
                return false;
            }
            var items = $("#gridSplitProperties").data("kendoGrid").dataSource.data();
            if (items.length == 0) {
                alertify.error("Please select atleast one property for Deamalgamation.");
                return false;
            }

            $("#assignToWindow").data("kendoWindow").center();
            $("#User").data("kendoDropDownList").dataSource.read();
            $("#assignToWindow").data("kendoWindow").open();
        });

        $("#btnClosePopUp").click(function () {
            $("#popUpViewComments").data("kendoWindow").close();
        });

        $("#btnViewComments").click(function () {
            $("#popUpViewComments").data("kendoWindow").center();
            $("#popUpViewComments").data("kendoWindow").open();
        });

    });
</script>
