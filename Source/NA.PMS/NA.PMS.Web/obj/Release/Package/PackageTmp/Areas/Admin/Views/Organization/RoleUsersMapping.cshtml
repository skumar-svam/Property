@model NA.PMS.UserManagement.NDAUserViewModel
@using Kendo.Mvc.UI

@{
    ViewBag.Title = "User Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Scripts/kendo.aspnetmvc.min.js"></script>
<script src="~/Scripts/_references.js"></script>
<style>
    .link {
        color: blue;
        text-decoration: underline;
    }

    .link:hover {
        color: blue;
        cursor: pointer;
        text-decoration: underline;
    }

    #divSearchUsers {
        display: none;
    }
    #divSearchPanel{
        display:none;
    }
    #UsersSearchGrid   { border: 1 !important; }
    .k-grid-content{
        overflow-y:hidden;
    }
</style>

<div class="MapApplicationForm">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Application Users mapping with Role</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 content-top-spce">
        <h2 class="col-md-12 blck-heading">Map User with Role</h2>
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <div class="form-bx">
                <div class="row">
                    <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group">
                        <label>Select Application</label>
                    </div>
                    <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(model => model.ApplicationId)
                          .Name("Applications")
                          .DataTextField("Text")
                          .DataValueField("Id")
                          .Filter("contains")
                          .OptionLabel("--select--")
                          //.DataSource(source => source.Read(read => read.Action("GetMasterDataListAsDataSource", "Organization", new { area="Admin"}).Data("FilterApplication")).ServerFiltering(true))
                          .DataSource(source =>
                          {
                            source.Custom()
                            .ServerFiltering(true)
                            .ServerPaging(true)
                            .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                            .Transport(transport => transport.Read(read => read.Action("GetMasterDataListAsDataSource", "Organization", new { area = "Admin" }).Data("FilterApplication")))
                            .Schema(schema => schema.Data("Data").Total("Total"))
                            .PageSize(100);
                          })
                          .HtmlAttributes(new { style = "width: 100%;" })
                          //.Events(e => e.Change("ApplicationChange"))
                        )
                    </div>
                    <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group">
                        <label>Select Role</label>
                    </div>
                    <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(model => model.RoleId)
                            .Name("ApplicationRoles")
                            .CascadeFrom("Applications")
                            .CascadeFromField("ApplicationId")
                            .DataValueField("Id")
                            .DataTextField("Text")
                            .AutoBind(true)
                            .Filter("contains")
                            .OptionLabel("--select--")
                            .HtmlAttributes(new { style = "width:100%;" })
                            //.DataSource(source => source.Read(read => read.Action("GetRoles", "Application").Data("FilterRoleOnApplication")).ServerFiltering(true))
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => transport.Read(read => read.Action("GetMasterDataListAsDataSource", "Organization", new { area = "Admin" }).Data("FilterRoleOnApplication")))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(100);
                            })
                            .Events(e => e.Change("ApplicationRoleChange"))
                        )
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group">
                        <label>Search Users</label>
                    </div>
                    <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(Model => Model.UserRefId)
                            .Name("UserName")
                            .Filter("contains")
                            .DataValueField("Id")
                            .DataTextField("Text")
                            .OptionLabel("--select--")
                            .HtmlAttributes(new { style = "width:100%;" })
                            //.DataSource(source => source.Read(read => read.Action("GetApplicationUsers", "Application").Data("FilterUserName")))
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => transport.Read(read => read.Action("GetMasterDataListAsDataSource", "Organization", new { area = "Admin" }).Data("FilterUserName")))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(100);
                            })
                            .Events(e => e.Change("UserNameChangeEvent"))
                        )
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12 k-grid-content" id="divSearchUsers">
            @(Html.Kendo().Grid<NA.PMS.UserManagement.NDAUserViewModel>()
                .Name("UsersSearchGrid")
                .Columns(columns =>
                {
                    columns.Bound(c => c.Id).Width(10).Title("ID").Hidden(true);
                    columns.Bound(c => c.IsActive).Hidden(true).Title("Is Locked?");
                    columns.Bound(c => c.UserName).Title("Employee Id").Filterable(false).Sortable(false);
                    columns.Bound(c => c.FullName).Title("Name").Filterable(false).Sortable(false);
                    columns.Bound(c => c.MobileNo).Title("Mobile Number").Filterable(false).Sortable(false);
                    columns.Bound(c => c.Email).Title("Email").Filterable(false).Sortable(false);
                    //columns.Bound(c => c.strDeptts).Title("Departments").Filterable(false).Sortable(false);
                    columns.Bound(c => c.Id).Title("Action").ClientTemplate("<a onClick='javascript:MapUserToRole(this);' class='link'>Add</a>").Filterable(false).Sortable(false);
                })
                .DataSource(dataSource => dataSource
                    .Ajax().Model(model => model.Id(p => p.Id))
                     .ServerOperation(false)
                     .Read(read => read.Action("GetUsersAsDataSource", "Organization", new { area="Admin"}).Data("FilterUserRefId"))

                )
            )
        </div>
    </div>

    
    

    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 k-grid-content">
        <h2 class="blck-heading-grid">Mapped Application Users</h2>
        @(Html.Kendo().Grid<NA.PMS.UserManagement.NDAUserViewModel>()
                .Name("ApplicationUsers")
                .Columns(columns =>
                {
                    columns.Bound(c => c.Id).Width(10).Title("ID").Hidden(true);
                    columns.Bound(c => c.RoleId).Hidden(true);
                    columns.Bound(c => c.ApplicationId).Hidden(true);
                    columns.Bound(c => c.IsActive).Hidden(true).Title("Is Locked?");
                    columns.Bound(c => c.UserName).Title("Username");
                    columns.Bound(c => c.FullName).Title("Name");
                    columns.Bound(c => c.MobileNo).Title("Mobile Number");
                    columns.Bound(c => c.Email).Title("Email");
                    columns.Bound(c => c.DepartmentsName).Title("Departments");
                    columns.Bound(c => c.RoleName).Title("RoleName");
                    //columns.Bound(c => c.id).Title("Action").ClientTemplate("<a onClick = 'javascript:RemoveUser(#= id#)' class='hyperlinkcss'>Remove</a>").Filterable(false).Sortable(false);
                    columns.Bound(c => c.Id).Title("Action").ClientTemplate("<a onClick = 'javascript:RemoveUser(this)' class='hyperlinkcss'>Remove</a>").Filterable(false).Sortable(false);
                })
                .Sortable().Filterable()
                .Resizable(resize => resize.Columns(true))
                .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                .DataSource(dataSource => dataSource
                    .Ajax().Model(model => model.Id(p => p.Id))
                     .ServerOperation(true)
                     .Read(read => read.Action("GetMappedUsersListByApplicationRoleAsDataSource", "Organization", new { area="Admin"}).Data("FilterApplicationUserOnRoleId")).PageSize(10)
                )
        )
    </div>
</div>


<script type="text/javascript">
   
    function MapUserToRole(row) {
        if ($("#Applications").val() == '' || $("#Applications").val() == 0) {
            alertify.error("Please select an Application");
            return false;
        }
        if ($("#ApplicationRoles").val() == '' || $("#ApplicationRoles").val() == 0) {
            alertify.error("Please select a Role");
            return false;
        }
        var tr = $(row).parent().parent();
        var id = $(tr).children("td:eq(0)").text();
        var roleID = $("#ApplicationRoles").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ id: id, roleID: roleID }),
            url: '/Admin/Application/MapUserToRole',
            success: function (result) {
                if (result == 1) {
                    $("#UserName").val('');
                    alertify.success("User Role mapped successfully.");
                    $("#ApplicationUsers").data("kendoGrid").dataSource.read();
                    $("#divSearchUsers").css("display", "none");
                }
                else if (result == 0)
                {
                    alertify.error("User is already associated with a Role for this Application.");
                    $("#divSearchUsers").css("display", "none");
                }
                else if (result == 2)
                    {
                    alertify.error("User is already an Admin for this Application.");
                    $("#divSearchUsers").css("display", "none");
                }
                else{
                    alertify.error("Some error occured. Please try again later.");
                    $("#divSearchUsers").css("display", "none");
                }
            },
            error: function (obj) {
                //alert('Error While Saving Record.');
            }
        });
    }

    function RemoveUser(row) {
        var tr = $(row).parent().parent();
        var userid = $(tr).children("td:eq(0)").text();
        var roleid = $(tr).children("td:eq(1)").text();
        var applicationid = $(tr).children("td:eq(2)").text();
        //alert("userid: "+userid+ " roleid: "+ roleid + " appid: "+applicationid);
       // return false;
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ userId: userid, roleId: roleid, applicationId: applicationid }),
            url: '/Admin/Application/RemoveUser',
            success: function (result) {
                if (result == true) {
                    alertify.success("User Role mapping removed successfully.");
                    $("#ApplicationUsers").data("kendoGrid").dataSource.read();
                }
                else
                    alertify.error("Some error occured. Please try again later.");
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }
        });
    }

    //function RemoveUser(id) {
    //    $.ajax({
    //        dataType: 'json',
    //        type: 'Post',
    //        contentType: 'application/json; charset=utf-8',
    //        data: JSON.stringify({ id: id }),
    //        url: '/Application/RemoveUser',
    //        success: function (result) {
    //            if (result == true) {
    //                alertify.success("User Role mapping removed successfully.");
    //                $("#ApplicationUsers").data("kendoGrid").dataSource.read();
    //            }
    //            else
    //                alertify.error("Some error occured. Please try again later.");
    //        },
    //        error: function (objAjaxRequest, strError) {
    //            var respText = objAjaxRequest.responseText;
    //            //alert(respText);
    //        }
    //    });
    //}

    function FilterApplication(){
        return {
            FilterType: "Application"
        }
    }

    function FilterRoleOnApplication() {
        return {
            FilterType: "RolesByApplication",
            ApplicationId: $("#Applications").val()
        };
    }
    var uname;
    function FilterUserName() {
        return {
            FilterType: "UserName",
            UserRefId: $('#UserRefId').val()
        }
    }
    function FilterUserRefId() {
        return { UserRefId: $("#UserName").val() }
    }

    function ApplicantionChange(){
        $("#ApplicationUsers").data("kendoGrid").dataSource.read();
    }

    function ApplicationRoleChange(){
        $("#ApplicationUsers").data("kendoGrid").dataSource.read();
    }

    function UserNameChangeEvent() {
        uname = $("#UserName").val();
        if(uname == null || uname==""){
            $("#divSearchUsers").css("display","none");
        }
        else{
            $("#UsersSearchGrid").data("kendoGrid").dataSource.read();
            $("#divSearchUsers").show();
        }
    }

    function FilterApplicationUserOnRoleId(){
        return{
            ApplicationId: $('#Applications').val(),
            RoleId: $('#ApplicationRoles').val()
        };
    }

  

</script>