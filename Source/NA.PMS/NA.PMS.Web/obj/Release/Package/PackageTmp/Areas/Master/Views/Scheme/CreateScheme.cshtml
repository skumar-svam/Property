<script type="text/javascript">
    function AdditionalData() {
        return { schemeId: $("#scheId").val() };
    }
    $(document).ready(function () {

        function close_accordion_section() {
            jQuery('.accordion .accordion-section-title').removeClass('active');
            jQuery('.accordion .accordion-section-content').slideUp(300).removeClass('open');
        }


        if ($('#scheId').val() == 0) {
            $(".first .fke-link").hide();
            $(".first .accordion-section-title").show();

            $(".second .fke-link").show();
            $(".third .fke-link").show();
            $(".fourth .fke-link").show();
            $(".fifth .fke-link").show();
            $(".sixth .fke-link").show();
            $(".seventh .fke-link").show();
            $(".second .accordion-section-title").hide();
            $(".third .accordion-section-title").hide();
            $(".fourth .accordion-section-title").hide();
            $(".fifth .accordion-section-title").hide();
            $(".sixth .accordion-section-title").hide();
            $(".seventh .accordion-section-title").hide();
            $('#btnNext1').attr('disabled', 'disabled');
        }
        else if ($('#scheId').val() != 0 && gridDepartment.length <= 0) {
            $(".first .fke-link").hide();
            $(".first .accordion-section-title").show();
            $(".second .fke-link").hide();
            $(".second .accordion-section-title").show();
            $('#btnNext1').attr('disabled', 'disabled');
        }

        //if ($('#scheId').val() == 0) {
        //    $(".first .fke-link").hide();
        //    $(".first .accordion-section-title").show();
        //    var curr = $('#acc1').attr('href');
        //    if (curr == '#accordion-1') {
        //        jQuery(this).addClass('active');
        //        jQuery('.accordion ' + curr).slideDown(300).addClass('open');
        //        $('#btnNext1').attr('disabled', 'disabled');
        //    }
        //}
        jQuery('.accordion-section-title').click(function (e) {
            var gridDepartment = $("#gridDepartment").data("kendoGrid").dataSource.data();
            var currentAttrValue = jQuery(this).attr('href');
            if ($('#scheId').val() == 0 && gridDepartment.length <= 0) {
                if (curr == '#accordion-1') {
                    jQuery(this).addClass('active');
                    jQuery('.accordion ' + curr).slideDown(300).addClass('open');
                }
            }
            else if ($('#scheId').val() != 0 && gridDepartment.length <= 0) {
                if (currentAttrValue == '#accordion-1') {
                    if (jQuery(e.target).is('.active')) {
                        close_accordion_section();
                        $(this).find('.fa-chevron-down').removeClass('fa-chevron-down').addClass('fa-chevron-right')
                    } else {
                        close_accordion_section();
                        $(this).find('.fa-chevron-right').removeClass('fa-chevron-right').addClass('fa-chevron-down')
                        jQuery(this).addClass('active');
                        jQuery('.accordion ' + currentAttrValue).slideDown(300).addClass('open');
                    }
                }
                if (currentAttrValue == '#accordion-2') {
                    if (jQuery(e.target).is('.active')) {
                        close_accordion_section();
                        $(this).find('.fa-chevron-down').removeClass('fa-chevron-down').addClass('fa-chevron-right')
                    } else {
                        close_accordion_section();
                        $(this).find('.fa-chevron-right').removeClass('fa-chevron-right').addClass('fa-chevron-down')
                        jQuery(this).addClass('active');
                        jQuery('.accordion ' + currentAttrValue).slideDown(300).addClass('open');
                    }
                }
            }
            else if ($('#scheId').val() != 0 && gridDepartment.length > 0) {
                if (jQuery(e.target).is('.active')) {
                    close_accordion_section();
                    $(this).find('.fa-chevron-down').removeClass('fa-chevron-down').addClass('fa-chevron-right')
                } else {
                    close_accordion_section();
                    $(this).find('.fa-chevron-right').removeClass('fa-chevron-right').addClass('fa-chevron-down')
                    jQuery(this).addClass('active');
                    jQuery('.accordion ' + currentAttrValue).slideDown(300).addClass('open');
                }
            }
            e.preventDefault();
        });

        $("#gridDepartment").data("kendoGrid").dataSource.read();
        $("#gridQuota").data("kendoGrid").dataSource.read();
        $("#gridBanks").data("kendoGrid").dataSource.read();
        $("#gridReb").data("kendoGrid").dataSource.read();
        $("#grdCosts").data("kendoGrid").dataSource.read();
        $("#grdLandDevelopment").data("kendoGrid").dataSource.read();
        $("#btnAddScheme").click(function () {
            var isOK = false;
            var validator = false;
            var schemename = $('#schemeName').val().trim();
            var schemeId = 0;
            var validationMaster = ValidateMasterScheme();
            if (validationMaster) {
                isOK = true;
            } else {
                isOK = false;
                return false;
            }
            if (isOK) {
                $.ajax({
                    dataType: 'json',
                    type: 'Post',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({ schemeName: $("#schemeName").val().trim(), schemeType: $("#schemeType").val(), startDate: $("#startDate").val(), endDate: $("#endDate").val(), formFee: $("#FormFee").val() }),
                    url: "/Scheme/AddScheme",
                    success: function (data) {
                        if (data != null && data != -1) {
                            if (data.flag == 1 && data.scheme > 0) {
                                $("#scheId").val(data.scheme);
                                $("#schemeName").attr("readonly", "true");
                                $("#schemeType").attr("readonly", "true");
                                $("#startDate").attr("readonly", "true");
                                $("#endDate").attr("readonly", "true");
                                $('#btnAddScheme').attr('disabled', 'disabled');
                                $('#btnNext1').removeAttr('disabled');
                                $(".second .fke-link").hide();
                                $(".second .accordion-section-title").show();
                                alertify.success("Scheme added successfully");
                            }
                            else {
                                alertify.error("Scheme Name already exists.");
                            }
                        }
                    },
                    error: function (objAjaxRequest, strError) {
                        var respText = objAjaxRequest.responseText;
                        //alert(respText);
                        //alertify.error("Scheme added successfully");
                    }
                });
            }
        });
        $('#btnNext1').click(function () {
            $("#acc2").click();
        });
        ActivateScheme();
        $('#btnPre21').hide();
        $('#btnNext21').hide();
        $('#btnPre31').hide();
        $('#btnNext31').hide();
        $('#btnPre41').hide();
        $('#btnNext41').hide();
        $('#btnPre51').hide();
        $('#btnNext51').hide();
        $('#btnPre61').hide();
        $('#btnNext61').hide();
        $('#btnPre71').hide();
    });
    function ActivateScheme() {
        var gridDepartment = $("#gridDepartment").data("kendoGrid").dataSource.data();
        var grdCosts = $("#grdCosts").data("kendoGrid").dataSource.data();
        //var rebatedepartment = $("#gridReb").data("kendoGrid").dataSource.data();
        var grdBanks = $("#gridBanks").data("kendoGrid").dataSource.data();
        //var grdQuota = $("#gridQuota").data("kendoGrid").dataSource.data();
        var grdLandDevelopment = $("#grdLandDevelopment").data("kendoGrid").dataSource.data();
        if (gridDepartment.length > 0 && grdCosts.length > 0 && grdBanks.length > 0 && grdLandDevelopment.length > 0) {
            $('#btnSubmitScheme').removeAttr('disabled');
        }
        else {
            $('#btnSubmitScheme').attr('disabled', 'disabled');
        }
    }
    function SumbitScheme() {
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ schemeId: $("#scheId").val() }),
            url: "/Scheme/ActivateScheme",
            success: function (data) {
                if (data != null && data != '') {
                    if (data == true) {
                        alertify.success("Scheme activated successfully");
                        window.location.href = '@Url.Action("Manage", "Scheme")';

                    }
                    else {
                        alertify.error("Scheme is not activated.");
                    }
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }
        });
    }
    function ValidateMasterScheme() {
        var schemeName = $("#schemeName");
        if (schemeName.val().trim() == "") {
            alertify.error('Please enter Scheme Name.');
            return false;
        }
        if (!/^[a-zA-Z0-9 \[\]\{\}\(\)\& \-\\\/ ]*$/g.test(schemeName.val().trim())) {
            alertify.error("Scheme Name should be alphanumeric (with '-', '\' and '/' characters)");
            return false;
        }
        var selectedValue = $('#schemeType');
        if (selectedValue.val().trim() == "") {
            alertify.error('Please Select Scheme Type.');
            return false;
        }
        var startdate = $("#startDate").val();
        var enddate = $("#endDate").val();
        var formFee = $("#FormFee").val();
        if (startdate == "") {
            alertify.error('Please enter Start Date.');
            return false;
        }
        if (enddate == "") {
            alertify.error('Please enter End Date.');
            return false;
        }
        if (formFee == '' || formFee == null) {
            alertify.error('Please enter Form Fee.');
            return false;
        }
        if (!(Date.parse(enddate) > Date.parse(startdate))) {
            alertify.error('End Date should be later than Start Date.');
            return false;
        }

        return true;
    }

    function RebindDepartmentDdl() {
        $("#quotaDepartmentId").data("kendoDropDownList").dataSource.read();
        $("#rebatedepartment").data("kendoDropDownList").dataSource.read();
        $("#depttID").data("kendoDropDownList").dataSource.read();
        $("#LandDevelopmentDepartmentId").data("kendoDropDownList").dataSource.read();
    }
</script>
