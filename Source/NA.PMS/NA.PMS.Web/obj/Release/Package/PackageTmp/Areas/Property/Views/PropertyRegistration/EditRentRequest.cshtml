    function SetRentingEndDate() {
        var rid = $('#Rid').val();
        var rentdate = $('#RentingDate').val();
        var duration = $('#RentDuration').val();
        if (duration.trim() == "" || duration == null) {
            alertify.error("Please enter rent duration");
            return false;
        }
        if (rentdate.trim() != "") {
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json;charset=utf-8",
                data: JSON.stringify({ rid: rid, rentStartDate: rentdate }),
                url: '@Url.Action("ValidateRentingStartDate","PropertyRegistration")',
                success: function (result) {
                    //alert(result);
                    if (Date.parse(result) >= Date.parse(rentdate)) {
                        alertify.error("Renting date can't be earlier than functional date.");
                        return false;
                        //flag = false;
                    }
                    else {
                        var startDate = $('#RentingDate').val();
                        var endDate = $('#RentingEndDate').data("kendoDatePicker");
                        var newDate = new Date(startDate);
                        newDate.setFullYear(newDate.getFullYear() + parseInt(duration));
                        //newDate.setDate(newDate.getDate() - 1);
                        var newDate2 = new Date(newDate.setDate(newDate.getDate() - 1));
                        endDate.value(newDate2);
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Something is wrong, try again later.");
                }
            });
        }
    }
    function ValidateRentingEndDate(duration) {
        var startDate = $('#RentingDate').val();
        var endDate = $('#RentingEndDate').val();
        var stDate = new Date(startDate);
        var enDate = new Date(endDate);
        var timeDiff = Math.abs(enDate.getTime() - stDate.getTime());
        var diffYears = Math.floor(timeDiff / (1000 * 3600 * 24 * 365));
        if (diffYears != parseInt(duration)) {
            alertify.error("Rent duration should be equal to difference of renting end date and start date");
            return false;
        }
        else {
            return true;
        }
    }

