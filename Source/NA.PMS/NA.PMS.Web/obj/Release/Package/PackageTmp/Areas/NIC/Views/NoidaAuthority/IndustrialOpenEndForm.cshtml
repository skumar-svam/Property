<div id="progressbar" style="width:100%; text-align:center;">
    <div id="loader" style="position: fixed;top:210px; left:0;  width:100%; height: 100%;  ">
        <img src="~/Content/Images/ajax_loader_red.gif" style="width:200px;height:200px;" />
    </div>
</div>


<script>
   
    $(document).ready(function () {
        $('.header-title-main').html("INDUSTRIAL OPEN END SCHEME : NOIDA/IP/2019-20/OES/01");
        $('#Applicant').attr("readonly", "readonly");
        $('.row-expansion').css("display", "none");
        $('.row-ex-alotee').css("display", "none");
        
        $('#DDLApplicationFormType').data('kendoDropDownList').value('General');

        $('#btn-skip-form').click(function (e) {
            e.preventDefault();  //stop the browser from following
            window.location.href = window.location.href = "/NIC/NoidaAuthority/IndustrialProposedProject?id=" + $('#ApplicationFormId').val() + "&controlid=" + $('#NICControlId').val() + "&unitid=" + $('#NICUnitId').val() + "&serviceid=" + $('#NICServiceId').val();
        });

        if ($('#ApplicationFormId').val() != "") {
            $('#checkbox-declaration').attr("checked", "checked");
            $('#checkbox-declaration').attr("disabled", "disabled");
            $(".area-form-fee").show();
            //$('#div-box-button').css("display", "none");
        }
        else {
            $(".area-form-fee").css("display", "none");
            //$('#div-box-button').show();
        }

        if ($('#ApplicantType').val() != "") {
            var radiobtnVal = $('#ApplicantType').val();
            if (radiobtnVal == "Company") {
                $('.lbl-permanent-address').text("Registered Office");
                $('.lbl-annnual-income').text("Annual Turnover");
                $('.lbl-Email').text("Company Email");
                $('.lbl-PAN').text("Company PAN");
                $('#divIndividualInfo').css("display", "none");
                $('.divCompanyInfo').show();
                $('#Applicant').attr("readonly", false);
                $("label[for='Applicant']").html("Company");
                $('.col-company').show();
            }
            else if (radiobtnVal == "Individual") {
                $('.lbl-permanent-address').text("Permanent Address");
                $('.lbl-annnual-income').text("Annual Income");
                $('.lbl-Email').text("Email");
                $('.lbl-PAN').text("PAN");
                $('#divIndividualInfo').show();
                $('.divCompanyInfo').css("display", "none");
                $('.col-company').css("display", "none");
            }
        }

        $('form').submit(function () {
            $('#loader').show();
        })

        $("#btn-cancel-otp").click(function () {
            $('#text-otp').val('');
            $('#div-otp-popup-window').data("kendoWindow").close();
        });

        $(".k-i-close").click(function () {
            $('#div-otp-popup-window').data("kendoWindow").close();
        });

        $('#div-otp-popup-window').kendoWindow({
            modal: true,
            title: "Online Form validation",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "30%"
            },
            width: "40%", height: "210px" //"35%"
        });

        $('#DDLApplicantType').change(function () {
            ToggleApplicantType();
        });

        $('#DDLApplicationFormType').change(function () {
            ToggleFormType();
        });

        $('#AnnualIncome').change(function () {
            CheckAnnualIncome();
        });

        $("#btn-form-submit").click(function () {
            //$('#loader').show();
            if ($("#applicationform").valid()) {
                ValidateFormFields();
            } else {
                alertify.error("Please check required field validations.");
            }
        });

        $('#btn-validate-otp').click(function () {
            ValidateOtpOnPage();
        });

        $('#btn-otp-resend').click(function () {
            SendOTPtoUser();
        });

        $('#btn-pay-form-fee').click(function () {
            var nicmodel = {
                ApplicationFormId: $('#ApplicationFormId').val(),
                NICApplicationId: $('#ApplicationFormId').val(),
                NICControlId: $('#NICControlId').val(),
                NICUnitId: $('#NICUnitId').val(),
                NICServiceId: $('#NICServiceId').val(),
                NICProcessIndustryId: $('#NICProcessIndustryId').val(),
                NICRequestId: $('#NICRequestId').val()
            };
            $.ajax({
                //url: '/Online/Application/ValidateOESpaymentFromNIC',
                url: '/NIC/NoidaAuthority/IsApplicationFormFeePaidViaNiveshMitra',
                type: 'POST',
                dataType: 'json',
                data: { model: nicmodel },
                success: function (result) {
                    if (result == true) {
                        alertify.success("Form fee paid.");
                        window.location.reload(true);
                        //$('#form-download-href').show();
                        //$('#btn-skip-form').show();
                        //$('#div-box-button').css("display", "none");
                    }
                    else {
                        alertify.error("Form fee not paid.");
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    //alert(respText);
                }
            });
        });


        //$('#btn-download-form').click(function (e) {
        //    e.preventDefault();  //stop the browser from following
        //    window.location.href = 'http://localhost:53000/Template/Brochure2019-20above5acre.pdf';
        //});
    });

    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }

    function FilterByFormType() {
        return { FilterType: "FormType" };
    }
    function FilterBySubFormType() {
        return {
            FilterType: "SubFormType",
            ActionType: $('DDLApplicationFormType').val()
        };
    }
    function FilterApplicantType() {
        return {
            FilterType: "ApplicantType",
            FilterTypeId: 2
        };
    }
    function FilterCompanyType() {
        return {
            FilterType: "CompanyType",
            ActionType: $('#DDLApplicantType').val()
        };
    }
    function FilterAreaRangeType() {
        return {
            ReturnType: "OES-2020-21-01",
            FilterType: "AreaRange",
            ActionType: '@SWPSchemeType.OpenEnded',
            SchemeId: $("#SchemeId").val(),
            DepartmentId: $("#DepartmentId").val() //18
        }
    }
    function FilterDirectorType() {
        return { FilterType: "DirectorType" };
    }


    function ToggleApplicantType() {
        var radiobtnVal = $('#DDLApplicantType').val();
        if (radiobtnVal == "Company") {
            ClearUserImages();
            ClearCommonFields();
            //ClearPaymentFields();
            $('.lbl-permanent-address').text("Registered Office");
            $('.lbl-annnual-income').text("Annual Turnover");
            $('.lbl-Email').text("Company Email");
            $('.lbl-PAN').text("Company PAN");
            $('#divIndividualInfo').css("display", "none");
            $('.divCompanyInfo').show();
            $('#Applicant').val('');
            $('#Applicant').attr("readonly", false);
            $("label[for='Applicant']").html("Company");
            $('.col-company').show();
            //$('#RefundInfaverof').attr("readonly", true);
            $('#CompanyTypeId').data("kendoDropDownList").dataSource.read();
        }
        else if (radiobtnVal == "Individual") {
            ClearIndividualField();
            ClearCommonFields();
            ClearUserImages();
            //ClearPaymentFields();
            $('.lbl-permanent-address').text("Permanent Address");
            $('.lbl-annnual-income').text("Annual Income");
            $('.lbl-Email').text("Email");
            $('.lbl-PAN').text("PAN");
            $('#divIndividualInfo').show();
            $('.divCompanyInfo').css("display", "none");
            $('#Applicant').val('');
            $('#SigningAuthority').val('');
            $('#Applicant').attr("readonly", "readonly");
            $("label[for='Applicant']").html("Applicant");
            $('.col-company').css("display", "none");
            //$('#RefundInfaverof').attr("readonly", false);
            $('#CompanyTypeId').data("kendoDropDownList").dataSource.read();
        }
    }

    function ToggleFormType() {
        var formType = $('#DDLApplicationFormType').val();
        if (formType.trim() == "Expansion") {
            //$('#divExpansionType').show();
            $('.row-expansion').show();
            //ToggleExpansion();
        }
        else {
            $('.row-expansion').css("display", "none");
            $('.row-rent').css("display", "none");
            $('.col-rent').css("display", "none");
            $('#divExistingAllottee').css("display", "none");
            $('#ExistingProperty').val('');
            $('#AllottmentDate').data("kendoDatePicker").value('');
            $('#LetterCode').val('');
            $('#LetterDate').data("kendoDatePicker").value('');
        }
    }

    function ToggleExpansionTypeField() {
        var formType = $('#ExpansionType').val();
        if (formType.trim() == "Rent Permission") {
            $('.row-rent').show();
            $('.col-rent').show();
            $('.row-ex-alotee').css("display", "none");
            $('#ExistingProperty').val('');
            $('#AllottmentDate').data("kendoDatePicker").value('');
        }
        if (formType.trim() == "Existing Allottee") {
            $('.row-rent').css("display", "none");
            $('.col-rent').css("display", "none");
            $('.row-ex-alotee').show();
            $('#LetterCode').val('');
            $('#LetterDate').data("kendoDatePicker").value('');
        }
    }

    function ApplicationFeeAndCharges() {
        $('#PanNumber').val('');
        var schemeId = $('#SchemeId').val();
        var departmentId = $('#DepartmentId').val();
        var propertyTypeId = $('#PropertyTypeId').val();
        var areaTypeId = $('#AreaRangeId').val();
        if (areaTypeId != "") {
            $.ajax({
                url: '/Online/Application/GetApplicationFeeAndCharges',
                type: 'POST',
                dataType: 'json',
                data: { schemeId: schemeId, departmentId: departmentId, propertyTypeId: propertyTypeId, areaTypeId: areaTypeId },
                success: function (result) {
                    if (result != null) {
                        //$("#ApplicationFee").val(result.ApplicationFee);
                        //$("#EarnestMoney").val(result.EarnestMoney);
                        //$("#ProcessingCharge").val(result.ProcessingCharge);
                        $("#ApplicationFee").val(5000);
                        $('#EarnestMoney').val(5000000);
                        $("#ProcessingCharge").val(25000);

                        CalculateAmount();
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    //alert(respText);
                }
            });
        }
        else {
            ClearPaymentFields();
        }
    }

    function ValidateFormFields() {
        //var applicantType = $('input[name=ApplicantType]:checked', '#applicationform').val();
        var applicantType = $("#DDLApplicantType").val();
        //if ($("#Applicant").val() == "") {
        //    alertify.error("Please enter Applicant Name");
        //    return false;
        //}
        if ($('#ApplicationFormId').val() == "") {
            if ($('#imguser').val() == '' || $('#imguser').val() == null) {
                alertify.error("Please upload a Photograph.");
                return false;
            }
            if ($('#imgsign').val() == '' || $('#imgsign').val() == null) {
                alertify.error("Please upload signature image.");
                return false;
            }
        }

        //var formType = $('input[name=ApplicationFormType]:checked', '#applicationform').val();
        var formType = $('#DDLApplicationFormType').val();
        if (formType.trim() == "Expansion") {
            var expansionType = $('#ExpansionType').val();
            if (expansionType.trim() == "Rent Permission") {
                if ($("#LetterDate").val() == "") {
                    alertify.error("Please enter Renting letter date");
                    return false;
                }
                if ($("#LetterCode").val() == "") {
                    alertify.error("Please enter Renting Letter No");
                    return false;
                }
            }
            if (expansionType.trim() == "Existing Allottee") {
                if ($("#ExistingProperty").val() == "") {
                    alertify.error("Please enter Existing property");
                    return false;
                }
                if ($("#AllottmentDate").val() == "") {
                    alertify.error("Please enter Allottment Date");
                    return false;
                }
            }
        }

        if (applicantType == "Individual") {
            var iflag = ValidateIndividualFields();
            var cflag = ValidateCommonFields();
            //var pflag = ValidateProposedCompany();
            if (iflag == true && cflag == true) {
                SendOTPtoUser();
                $("#div-otp-popup-window").data("kendoWindow").center();
                $("#div-otp-popup-window").data("kendoWindow").open();
                $("#div-otp-popup-window").data("kendoWindow").pin();
            }

        }
        if (applicantType == "Company") {
            if ($("#Applicant").val() == "") {
                alertify.error("Please enter Applicant Name");
                return false;
            }
            if ($("#SigningAuthority").val() == "") {
                alertify.error("Please enter Signing Authority");
                return false;
            }
            if ($("#PermanentAddress").val() == "") {
                alertify.error("Please enter Signing Authority");
                return false;
            }
            if ($("#SigningAuthorityId").val() == "") {
                alertify.error("Please select signatory type");
                return false;
            }
            var cflag = ValidateCommonFields();
            //var pflag = ValidateProposedCompany();
            if (cflag == true) {
                SendOTPtoUser();
                $("#div-otp-popup-window").data("kendoWindow").center();
                $("#div-otp-popup-window").data("kendoWindow").open();
                $("#div-otp-popup-window").data("kendoWindow").pin();
            }
        }

    }

    function ValidateCommonFields() {
        var bflag = true;
        if ($("#PermanentAddress").val() == "") {
            alertify.error("Please enter Permanent Address.");
            bflag = false;
        }
        if ($("#CorrespondingAddress").val() == "") {
            alertify.error("Please enter Corresponding Address.");
            bflag = false;
        }
        if ($("#Email").val() == "") {
            alertify.error("Please enter email address.");
            bflag = false;
        }
        if ($("#MobileNumber").val() == "") {
            alertify.error("Please enter Mobile Number.");
            bflag = false;
        }
        if ($("#MobileNumber").val() != "") {
            if ($("#MobileNumber").val().length != 10) {
                alertify.error("Please enter correct Mobile Number.");
                bflag = false;
            }
        }
        if ($("#AadharNumber").val() == "") {
            alertify.error("Please enter Aadhar Number.");
            bflag = false;
        }
        if ($("#AadharNumber").val() != "") {
            if ($("#AadharNumber").val().length != 12) {
                alertify.error("Please enter correct Aadhar Number.");
                bflag = false;
            }
        }
        if ($("#PanNumber").val() == "") {
            alertify.error("Please enter PAN.");
            bflag = false;
        }
        if ($("#AnnualIncome").val() == "") {
            alertify.error("Please enter Annual Income.");
            bflag = false;
        }
        if ($("#AreaRangeId").val() == "") {
            alertify.error("Please select Area range.");
            bflag = false;
        }
        if ($("#ApplicantGSTNumber").val() == "") {
            alertify.error("Please enter GST No.");
            bflag = false;
        }

        var dflag = $("#checkbox-declaration").prop("checked");
        if (dflag == false) {
            alertify.error("Please check Declaration .");
            bflag = false;//
        }
        
        return bflag;

    }

    function CheckAnnualIncome() {
        var annualIncome = $("#AnnualIncome").val();
        if (annualIncome != '') {
            if (annualIncome < 50000) {
                alertify.error("Annual Income should be graeter than 50000");
                $("#AnnualIncome").val('')
                return false;
            }
            else {
                return true;
            }
        }
    }

    //function ValidateEmail(email) {
    //    var expr = /^([\w-\.]+)@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$/;
    //    return expr.test(email);
    //};

    function CalculateAmount() {
        var applicationFrom = (isNaN(parseFloat($('#ApplicationFee').val()))) ? 0 : parseFloat($('#ApplicationFee').val());
        var earnestMoney = (isNaN(parseFloat($('#EarnestMoney').val()))) ? 0 : parseFloat($('#EarnestMoney').val());
        var processingFee = (isNaN(parseFloat($('#ProcessingCharge').val()))) ? 0 : parseFloat($('#ProcessingCharge').val());
        var processingGST = CalculateGST(processingFee);
        var formFeeGST = CalculateGST(applicationFrom);
        $('#FormFeeGST').val(formFeeGST);
        $('#ProcessingChargeGST').val(processingGST);
        $('#FormFeeWithGST').val((parseFloat(applicationFrom) + parseFloat(formFeeGST)));
        var totalAmount = parseFloat((parseFloat(applicationFrom) + parseFloat(earnestMoney) + parseFloat(processingFee) + parseFloat(processingGST) + parseFloat(formFeeGST)).toFixed(2));
        $("#TotalAmount").val(totalAmount);
    }

    function CalculateGST(amount) {
        if ((amount != null || amount != "") && amount > 0) {
            var gst = (amount * 18) / 100;
            return gst;
        }
        else return 0;
    }

    function PanNumberChange() {
        if ($("#PanNumber").val().trim() == '') {
            $("#PanNumber").val('');
        }
        var bool = CheckPanNoFormat();
        if (bool == false) {
            alertify.error("Pan Number format is wrong.");
            $("#PanNumber").val('');
            return false;
        }
        else {
            ValidatePanNumber();
        }
    }

    function CheckPanNoFormat() {
        var value = $("#PanNumber").val().trim();
        var regex1 = /^[A-Z]{5}\d{4}[A-Z]{1}$/;
        if (!regex1.test(value) || value.length != 10) {
            return false;
        }
        return true;
    }

    function ValidatePanNumber() {
        var flag = false;
        var pan = $('#PanNumber').val();
        var areaId = $('#AreaRangeId').val();
        if (areaId != "" && areaId != null) {
            $.ajax({
                url: '/Online/Application/ValidatePANnumber',
                type: 'POST',
                dataType: 'json',
                data: { pan: pan, areaId: areaId },
                success: function (result) {
                    if (result == '@SWPReturnTypeId.Exist') {
                        alertify.error("This PAN no " + pan + " already exist for this property.");
                        $("#PanNumber").val('');
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    //alert(respText);
                }
            });
        }
        else {
            alertify.error("Please select area applied for");
            $("#PanNumber").val('');
        }
    }

    function SendOTPtoUser() {
        var mobile = $('#MobileNumber').val();
        var mailId = $('#Email').val();
        if (mobile != "") {
            $.ajax({
                type: 'POST',
                dataType: 'json',
                data: { mobileNo: mobile, email: mailId },
                url: '/Online/Application/SendOTP',
                success: function (result) {
                    if (result != null) {
                        $('#hdn-otp').val(result);
                        alertify.success("OTP has been sent on your mobile and email id successfuly.");
                        return false;
                    }
                    else {

                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    //alert(respText);
                }
            });
        }
    }

    function ValidateOtpOnPage() {
        var otp_sent = $('#text-otp').val();
        var otp_return = $('#hdn-otp').val();
        if (otp_sent != "") {
            if (otp_sent == otp_return) {
                $('#AreaRange').val($('#AreaRangeId').data("kendoDropDownList").text());
                $('#div-otp-popup-window').data("kendoWindow").close();
                SubmitOpenSchemeForm();
            }
            else {
                alertify.error("OTP mismatch");
            }
        }
    }

    function SubmitOpenSchemeForm() {
        $('#btn-form-submit').prop("disabled",true);
        var atype = $('#DDLApplicantType').val();
        var ftype = $('#DDLApplicationFormType').val();
        $('#hdnFormType').val("Online"); //$('#hdnFormType').val(form);
        $('#ApplicantType').val(atype);
        $('#ApplicationFormType').val(ftype);

        var formData = new FormData($('form').get(0));
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            data: formData,
            url: '/NIC/NoidaAuthority/SaveOpenSchemeFormDetail',
            success: function (result) {
                if (result != null) {
                    $("#ApplicationFormId").val(result.ApplicationFormId);
                    var gst = CalculateGST(result.ApplicationFee);
                    var totalAmount = parseFloat((parseFloat(result.ApplicationFee) + parseFloat(gst)).toFixed(2));
                    $("#schemeformfee").val(totalAmount);
                    $("#FormFeeWithGST").val(totalAmount);
                    $(".area-form-fee").show();
                    //$('#div-box-button').css("display", "none");
                    //alert("Pay form fee via nivesh mitra portal then proceed further action.");
                    alertify.alert('Scheme Form Payment!', 'Congratulations! Your form: [' + result.ApplicationFormId + '] registration has been successfully submitted. You are now requested to complete the payment of application form fee of Rs 5900/- on Nivesh Mitra Portal using || Pay Consolidated Fee || option to download the brochure and complete other formalities', function () { BackNiveshMitraPortal(); });
                }
            },
            error: function (ajaxRequest, strError) {
                alertify.error("Network error, try again later");
                $('#btn-form-submit').prop("disabled", false);
            }
        });
    }

    function ClearPaymentFields() {
        $('#ApplicationFee').val('');
        $('#ProcessingCharge').val('')
        $('#EarnestMoney').val('');
        $('#FormFeeGST').val('');
        $('#ProcessingChargeGST').val('');
        $("#TotalAmount").val('');
    }

    function ClearCommonFields() {
        //$('#SchemeId').data("kendoDropDownList").value('');
        $('#CompanyTypeId').data("kendoDropDownList").value('');
        $('#PermanentAddress').val('');
        $('#CorrespondingAddress').val('');
        $('#Email').val('');
        $('#PhoneNumber').val('');
        $('#MobileNumber').val('');
        $('#FaxNumber').val('');
        $('#PanNumber').val('');
        $('#AnnualIncome').val('');
        $('#AreaRangeId').data("kendoDropDownList").value('');
        
        $('#AadharNumber').val('');
        $('#ExistingProperty').val('');
        $('#AllottmentDate').data("kendoDatePicker").value('');
        $('#LetterCode').val('');
        $('#LetterDate').data("kendoDatePicker").value('');
        $('#ApplicantGSTNumber').val('');
        $('#PropertyNo').val('');
    }

</script>


