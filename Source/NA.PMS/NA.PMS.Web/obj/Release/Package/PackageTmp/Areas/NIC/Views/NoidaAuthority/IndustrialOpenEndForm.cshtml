@model NA.PMS.NICServices.SWPFormViewModel
@using NA.PMS.NICServices
@using System.Web.Mvc
@using Kendo.Mvc.UI;

@{
    ViewBag.Title = "Industrial Open End Scheme";
    //Layout = "~/Views/Shared/_LayoutNIC.cshtml";
    Layout = "~/Areas/NIC/Views/Shared/_Layout.cshtml";
}

<style>
    .divCompanyInfo {
        display: none;
    }

    .row-rent {
        display: none;
    }

    .col-rent {
        display: none;
    }

    .k-button.k-upload-button {
        margin: 0;
    }

    .k-upload-files {
        margin: 0;
    }

    #userphoto {
        display: none;
    }

        #userphoto:hover {
            cursor: pointer;
        }

    .glyphicon-user:hover {
        cursor: pointer;
    }

    #signature {
        display: none;
    }

        #signature:hover {
            cursor: pointer;
        }

    .img-upld-bx:hover {
        cursor: pointer;
    }

    #loader {
        display: none;
    }

    .text-red {
        color: red;
    }

    .upload-user-image {
        width: 140px;
        height: 140px;
        padding-top: 60px;
    }

    .upload-sign-image {
        width: 140px;
        height: 55px;
        line-height: 14px;
        padding-top: 5px;
    }

    .upload-image {
        background: #fff;
        border: 1px solid #ccc;
        font-size: 11px;
        text-align: center;
        float: right;
    }

    .area-form-fee {
        display: none;
    }

    #btn-download-form {
        /*display: none;*/
    }

    #form-download-href {
        /*display: none;*/
    }
    .btn{
        min-width:100px !important;
        border-radius:0 !important;
    }

    /*#btn-skip-form {
        display: none;
    }*/
    .col-md-3.col-20{
        width:20% !important;
    }
    .col-md-3.col-30{
        width:30% !important;
    }
    .col-md-3.col-40{
        width:40% !important;
    }
    .col-md-9.col-60{
        width:60% !important;
    }

    @@media only screen and (max-width: 768px) {
      .col-md-3.col-20{
        width:100% !important;
    }
    .col-md-3.col-30{
        width:100% !important;
    }
    .col-md-3.col-40{
        width:100% !important;
    }
    .col-md-9.col-60{
        width:100% !important;
    }
    }
</style>

@using (Html.BeginForm("SaveOpenSchemeFormDetail", "NoidaAuthority", FormMethod.Post, new { enctype = "multipart/form-data", id = "applicationform" }))
{
    <div class="online-registration nic-portal" data-nic="forms">
        <div class="col-md-12">
            <div class="row" style="margin-top:6px;">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Online Application Form</h1></div>
                <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce" id="first-form">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px" id="divApplicantInformation">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <h2 class="blck-heading" style="margin-bottom:6px;">
                    Applicant Information
                    @{
                        if (Model.ApplicationFormId != null)
                        {
                            <span class="pull-right">Form No: @Html.DisplayFor(model => model.ApplicationFormId)</span>
                        }
                    }
                </h2>
                <div class="form-bx">
                    <div class="hidden-field">
                        @Html.HiddenFor(model => model.Id)
                        @*@Html.HiddenFor(model => model.ApplicationFormId)*@
                        @Html.HiddenFor(model => model.SchemeId)
                        @Html.HiddenFor(model => model.DepartmentId)
                        @Html.HiddenFor(model => model.AreaRange)
                        @Html.HiddenFor(model => model.SchemeType)
                        @Html.HiddenFor(model => model.ApplicationFormType)
                        @Html.HiddenFor(model => model.ApplicantType)
                        @Html.HiddenFor(model => model.AppType)
                        @Html.HiddenFor(model => model.FormType, htmlAttributes: new { @id = "hdnFormType" })

                        @Html.HiddenFor(model => model.ApplicationFee)
                        @Html.HiddenFor(model => model.EarnestMoney)
                        @Html.HiddenFor(model => model.ProcessingCharge)
                        @Html.HiddenFor(model => model.FormFeeGST)
                        @Html.HiddenFor(model => model.FormFeeWithGST)
                        @Html.HiddenFor(model => model.ProcessingChargeGST)
                        @Html.HiddenFor(model => model.TotalAmount)

                        
                        @Html.HiddenFor(model => model.NICControlId)
                        @Html.HiddenFor(model => model.NICUnitId)
                        @Html.HiddenFor(model => model.NICServiceId)
                        @Html.HiddenFor(model => model.NICApplicationId)
                        @Html.HiddenFor(model => model.NICProcessIndustryId)
                        @Html.HiddenFor(model => model.NICRequestId)
                        @Html.HiddenFor(model => model.IsFromNIC)

                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Annual_Turnover)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.ApplicationID)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Company_Name)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Control_ID)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.ControlID)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Expected_date_construction)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Expected_date_production)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Fee_Amount)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Fee_Status)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Industry_Address)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Industry_District)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Industry_District_Id)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Industry_Type_ID)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Industry_Type_Name)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Installed_Capacity)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Occupier_Name)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Occupier_PAN)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Occupier_Pin_Code)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Occupier_Mobile_No)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Occupier_Email_ID)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Occupier_Address)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Occupier_DOB)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Occupier_District_ID)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.OnlineApplicationId)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Unit_Id)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Nature_of_Activity)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Employees)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Project_Cost)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Nature_of_Operation)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Organization_Type_ID)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Organization_Type)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Unit_Category)
                        @Html.HiddenFor(model => model.SWPApiXMLData.Table.Items_Manufactured)
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-md-3 col-sm-6 col-xs-12 col-40 form-group">
                                    @Html.Label("Scheme Name", htmlAttributes: new { @class = "required" })
                                </div>
                                <div class="col-md-9 col-sm-6 col-xs-12 col-60 form-group">
                                    @Html.TextBoxFor(model => model.SchemeName, new { @readonly = "readonly", @class = "form-control" })
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3 col-sm-6 col-xs-12 col-40 form-group">
                                    @Html.Label("Department", htmlAttributes: new { @class = "required" })
                                </div>
                                <div class="col-md-9 col-sm-6 col-xs-12 col-60 form-group">
                                    @Html.TextBoxFor(model => model.Department, new { @readonly = "readonly", @class = "form-control" })
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3 col-sm-6 col-xs-12 col-40 form-group">
                                    <label>Scheme Form Type</label>
                                </div>
                                <div class="col-md-9 col-sm-6 col-xs-12 col-60 form-group">
                                    @(Html.Kendo().DropDownListFor(model => model.ApplicationFormType)
                                        .Name("DDLApplicationFormType")
                                        .DataTextField("Text")
                                        .DataValueField("Text")
                                        .OptionLabel(" -- Select --")
                                        .Filter("contains")
                                        .AutoBind(true)
                                        .Enable(false)
                                        .DataSource(source =>
                                        {
                                            source.Custom()
                                           .ServerFiltering(true)
                                           .ServerPaging(true)
                                           .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                           .Transport(transport => transport.Read(read => read.Action("GetDropDownListByTypeAsDataSource", "NoidaAuthority", new { area = "NIC" }).Data("FilterByFormType")))
                                           .Schema(schema => schema.Data("Data").Total("Total"))
                                           .PageSize(100);
                                        })
                                        .HtmlAttributes(new { style = "width:100%", @class = "input-disabled" })
                                    )
                                </div>
                            </div>
                            <div class="row row-expansion">
                                <div class="col-md-3 col-sm-6 col-xs-12 col-40 form-group">
                                    <label>Expansion Type</label>
                                </div>
                                <div class="col-md-9 col-sm-6 col-xs-12 col-60 form-group">
                                    @(Html.Kendo().DropDownListFor(model => model.ExpansionType)
                                        .DataTextField("Text")
                                        .DataValueField("Text")
                                        .OptionLabel(" -- Select --")
                                        .Enable(true)
                                        .AutoBind(true)
                                        .Filter("contains")
                                        .CascadeFrom("DDLApplicationFormType")
                                        //.DataSource(source => source.Read(read => read.Action("GetFormSubTypeList", "Application", new { area="Online"}).Data("FilterFormType")).ServerFiltering(true))
                                        .DataSource(source =>
                                        {
                                            source.Custom()
                                           .ServerFiltering(true)
                                           .ServerPaging(true)
                                           .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                           .Transport(transport => transport.Read(read => read.Action("GetDropDownListByTypeAsDataSource", "NoidaAuthority", new { area = "NIC" }).Data("FilterBySubFormType")))
                                           .Schema(schema => schema.Data("Data").Total("Total"))
                                           .PageSize(100);
                                        })
                                        .Events(e => e.Change("ToggleExpansionTypeField"))
                                        .HtmlAttributes(new { style = "width:100%", @class = "input-disabled" })
                                    )
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3 col-sm-6 col-xs-12 col-40 form-group">
                                    <label>Applicant Type</label>
                                </div>
                                <div class="col-md-9 col-sm-6 col-xs-12 col-60 form-group">
                                    @(Html.Kendo().DropDownListFor(model => model.ApplicantType)
                                        .Name("DDLApplicantType")
                                        .DataTextField("Text")
                                        .DataValueField("Text")
                                        .OptionLabel(" -- Select --")
                                        .Enable(true)
                                        .AutoBind(true)
                                        .Filter("contains")
                                        //.DataSource(source => source.Read(read => read.Action("GetApplicantTypeList", "Application", new { area="Online"})))
                                        .DataSource(source =>
                                        {
                                            source.Custom()
                                           .ServerFiltering(true)
                                           .ServerPaging(true)
                                           .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                           .Transport(transport => transport.Read(read => read.Action("GetDropDownListByTypeAsDataSource", "NoidaAuthority", new { area = "NIC" }).Data("FilterApplicantType")))
                                           .Schema(schema => schema.Data("Data").Total("Total"))
                                           .PageSize(100);
                                        })
                                        .Events(e => e.Change("ToggleApplicantType"))
                                        .HtmlAttributes(new { style = "width:100%", @class = "input-disabled" })
                                    )
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3 col-sm-6 col-xs-12 col-40 form-group">
                                    @Html.Label("Applicant Constitution", htmlAttributes: new { @class = "required" })
                                </div>
                                <div class="col-md-9 col-sm-6 col-xs-12 col-60 form-group">
                                    @(Html.Kendo().DropDownListFor(model => model.CompanyTypeId)
                                    .DataTextField("Text")
                                    .DataValueField("Id")
                                    .OptionLabel(" -- Select --")
                                    .Enable(true)
                                    .AutoBind(true)
                                    .Filter("contains")
                                    .CascadeFrom("DDLApplicantType")
                                    //.DataSource(source => source.Read(read => read.Action("GetCompanyTypeList", "Application", new { area="Online"}).Data("FilterApplicantType")).ServerFiltering(true))
                                    .DataSource(source =>
                                    {
                                        source.Custom()
                                       .ServerFiltering(true)
                                       .ServerPaging(true)
                                       .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                       .Transport(transport => transport.Read(read => read.Action("GetDropDownListByTypeAsDataSource", "NoidaAuthority", new { area = "NIC" }).Data("FilterCompanyType")))
                                       .Schema(schema => schema.Data("Data").Total("Total"))
                                       .PageSize(100);
                                    })
                                    .HtmlAttributes(new { style = "width:100%", @class = "input-disabled" })
                                    )
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3 col-sm-6 col-xs-12 col-40 form-group">
                                    @Html.Label("Area Range (sqm)", htmlAttributes: new { @class = "required" })
                                </div>
                                <div class="col-md-9 col-sm-6 col-xs-12 col-60 form-group">
                                    @(Html.Kendo().DropDownListFor(model => model.AreaRangeId)
                                    .DataValueField("Id")
                                    .DataTextField("Text")
                                    .OptionLabel("--Select--")
                                    .AutoBind(true).Enable(true)
                                    .Filter("contains")
                                    //.CascadeFrom("DepartmentId")
                                    //.DataSource(source => source.Read(read => read.Action("GetFloorAreaList", "Application", new { area="Online"}).Data("FilterIdForAreaRange")).ServerFiltering(true))
                                    .DataSource(source =>
                                    {
                                        source.Custom()
                                       .ServerFiltering(true)
                                       .ServerPaging(true)
                                       .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                       .Transport(transport => transport.Read(read => read.Action("GetDropDownListByTypeAsDataSource", "NoidaAuthority", new { area = "NIC" }).Data("FilterAreaRangeType")))
                                       .Schema(schema => schema.Data("Data").Total("Total"))
                                       .PageSize(100);
                                    })
                                    .Events(events => { events.Change("ApplicationFeeAndCharges"); })
                                    .HtmlAttributes(new { style = "width: 100%" })
                                    )
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-md-3 col-sm-6 col-xs-12 col-40 form-group">
                                    
                                   
                                </div>
                                <div class="col-md-9 col-sm-6 col-xs-12 col-60 form-group">
                                    <div class="row">
                                        @{
                                            if (Model.UserImage != null && Model.SignImage != null)
                                            {
                                                <div class="col-md-12 text-right" style="margin-bottom:5px;">
                                                    <img id="userphoto1" src="@Model.UserImage" alt="your image" height="150" width="140" name="userImage2" />
                                                </div>
                                                <div class="col-md-12 text-right">
                                                    <img id="signature1" src="@Model.SignImage" alt="your sign" height="40" width="140" name="usersign" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="col-md-12 text-right" style="margin-bottom:5px;">
                                                    <div id="userid" class="img-upld-bx upload-image upload-user-image" style=""> Upload your image <small class="text-red"> User Image Size Min(10kb) and Max(50kb)</small></div>
                                                    <img id="userphoto" src="#" alt="your image" height="150" width="140" name="userImage2" />
                                                    <input type='file' id="imguser" name="userImage" accept="image/jpg" style="display:none" />
                                                </div>
                                                <div class="col-md-12 text-right">
                                                    <div id="signatureid" class="img-upld-bx upload-image upload-sign-image" style=""> Upload your signature <small class="text-red"> Signature Image Min(5kb) and Max(20kb)</small></div>
                                                    <img id="signature" src="#" alt="your sign" height="40" width="140" name="usersign" />
                                                    <input type='file' id="imgsign" name="signatureImage" accept="image/jpg" style="display:none" />
                                                </div>
                                            }
                                        }

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row divCompanyInfo" id="divCompanyInfo">
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.LabelFor(m => m.Applicant, htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", placeholder = "full name " })
                            @Html.ValidationMessageFor(model => model.Applicant, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group col-company">
                            @Html.Label("Authorized Signatory", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group col-company">
                            @Html.TextBoxFor(model => model.SigningAuthority, new { @class = "form-control", @maxlength = "150", placeholder = "signing authority" })
                            @Html.ValidationMessageFor(model => model.SigningAuthority, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row divCompanyInfo" id="">
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Signatory's Father Name", htmlAttributes: new { @class = "" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.ApplicantMaster, htmlAttributes: new { @class = "form-control", placeholder = "father's name " })
                            @Html.ValidationMessageFor(model => model.ApplicantMaster, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group col-company">
                            @Html.Label("Signatory Status", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group col-company">
                            @(Html.Kendo().DropDownListFor(model => model.SigningAuthorityId)
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel("--Select--")
                            .Filter("contains")
                            .DataSource(source =>
                            {
                                source.Custom()
                               .ServerFiltering(true)
                               .ServerPaging(true)
                               .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                               .Transport(transport => transport.Read(read => read.Action("GetDropDownListByTypeAsDataSource", "NoidaAuthority", new { area = "NIC" }).Data("FilterDirectorType")))
                               .Schema(schema => schema.Data("Data").Total("Total"))
                               .PageSize(100);
                            })
                            .HtmlAttributes(new { @class = "", style = "width:100%;" })
                            )
                        </div>

                    </div>

                    <div class="row" id="divIndividualInfo">
                        @{Html.RenderPartial("_IndividualForm", Model);}
                    </div>
                </div>
                <div id="CommonInfo" class="form-bx">
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Permanent Address", htmlAttributes: new { @class = "required lbl-permanent-address" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextAreaFor(model => model.PermanentAddress, new { @class = "form-control", @maxlength = "500", placeholder = "address", style="height:30px;" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Correspond Address", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextAreaFor(model => model.CorrespondingAddress, new { @class = "form-control", @maxlength = "500", placeholder = "address",style="height:30px;" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Email", htmlAttributes: new { @class = "required lbl-Email" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                            @(Html.EditorFor(model => model.Email, new { htmlAttributes = new { @editable = "true", @class = "form-control", @maxlength = "150", placeholder = "skumar@svam.com" } }))
                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Mobile Number", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.MobileNumber, new { @class = "form-control", @minlength = "10", @maxlength = "10", onkeypress = "return IsNumeric(event);", placeholder = "1234567899" })
                            @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Phone Number")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.PhoneNumber, new { @class = "form-control", @maxlength = "14", placeholder = "011 29968337" })
                            @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Aadhar Number", htmlAttributes: new { @class = "required", @id = "lblPanNumber" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.AadharNumber, new { @class = "form-control", @minlength = "12", @maxlength = "12", onkeypress = "return IsNumeric(event);", placeholder = "0000 1111 2222" })
                            @Html.ValidationMessageFor(model => model.AadharNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("PAN", htmlAttributes: new { @class = "required lbl-PAN" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.PanNumber, new { @class = "form-control", placeholder = "AAAAA1111A", @onchange = "PanNumberChange();", @maxlength = "10" })
                            @Html.ValidationMessageFor(model => model.PanNumber, "", new { @class = "text-danger" })
                            <small class="text-info">PANCARD Format Like AAAAA1111A</small>
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Annual Income", htmlAttributes: new { @class = "required lbl-annnual-income" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.AnnualIncome, new { @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                            <small class="text-info">Value in Rupees.</small>
                            @Html.ValidationMessageFor(model => model.AnnualIncome, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row row-rent" id="divRentPermission">
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Rent Letter Date", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                            @(Html.Kendo().DatePickerFor(model => model.LetterDate).HtmlAttributes(new { style = "width:100%", @class = "DisableKeyboardInput" }))
                            @Html.ValidationMessageFor(model => model.LetterDate, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Rent Letter No", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.LetterCode, new { @class = "form-control", @maxlength = "11", placeholder = "" })
                            @Html.ValidationMessageFor(model => model.LetterCode, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row row-ex-alotee" id="divExistingAllottee">
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Existing Property", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.ExistingProperty, new { @class = "form-control", @maxlength = "11", placeholder = "sector/block-plot" })
                            @Html.ValidationMessageFor(model => model.ExistingProperty, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Allotment Date", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                            @(Html.Kendo().DatePickerFor(model => model.AllottmentDate).HtmlAttributes(new { style = "width:100%", @class = "DisableKeyboardInput" }))
                            @Html.ValidationMessageFor(model => model.AllottmentDate, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("GST Number", htmlAttributes: new { @class = "required", @id = "" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.ApplicantGSTNumber, new { @class = "form-control", placeholder = "", @maxlength = "15" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group col-rent">
                            @Html.Label("Rented Property", htmlAttributes: new { @class = "", @id = "lblSector" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group col-rent">
                            @Html.TextBoxFor(model => model.PropertyNo, new { @class = "form-control", placeholder = "sector/block-plot", @maxlength = "10" })
                        </div>
                    </div>
                </div>


                <h2 class="blck-heading" style="margin-bottom:6px;">DECLARATION BY THE APPLICANT</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-12 form-group">
                            <p>
                                <label>
                                    <input type="checkbox" required name="checkbox-declaration" id="checkbox-declaration" />
                                    I/We hereby declare that the information, submitted with application form, are true to the best of our knowledge. Nothing
                                    has been concealed and no part of it is false. I/We further declare that we have carefully read and understood the terms and conditions
                                    for allotment of industrial plot and do hereby abide by the same. I/We are aware, if allotment is obtained on the basis of false
                                    information, the NOIDA may cancel our allotment at any stage and forfeit all the deposits made by me/us.
                                </label>
                            </p>
                        </div>
                    </div>

                </div>

                <h2 class="blck-heading area-form-fee">Scheme Application Form Payment</h2>
                <div class="form-bx  area-form-fee">
                    <div class="row">
                        <div class="col-md-3 col-20 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Application Form No", htmlAttributes: new { @class = "" })
                        </div>
                        <div class="col-md-3 col-30 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.ApplicationFormId, new { @readonly = "readonly", @class = "form-control text-right", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                        </div>
                        <div class="col-md-3 col-20 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Form Fee (INR)", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-30 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.FormFeeWithGST, new { @id = "schemeformfee", @readonly = "readonly", @class = "form-control text-right", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                        </div>
                    </div>
                </div>

                <div class="div-box-button form-bx" id="div-box-button">
                    @if (Model.AppType == SWPConstant.AppType)
                    {
                        if (Model.IsApplicationFeePaid == true)
                        {
                            <div class="row">
                                <div class="col-md-3 col-20 col-sm-3 col-xs-12 form-group"></div>
                                <div class="col-md-3 col-30 col-sm-3 col-xs-12 form-group text-right">
                                    <a class="btn btn-primary" id="form-download-href" href="http://pims.mynoida.in/Template/NOIDA-IP-2020-21-OES-01.pdf" target="_blank" download>Download Scheme Brochure</a>
                                </div>
                                <div class="col-md-3 col-20 col-sm-3 col-xs-12 form-group">
                                    
                                </div>
                                <div class="col-md-3 col-30 col-sm-3 col-xs-12 form-group text-right">
                                    <input type="button" class="btn btn-default" id="btn-skip-form" value="Proceed to complete the form" />
                                </div>
                            </div>
                        }
                        else if (Model.ApplicationFormId != null)
                        {
                            if (Model.SchemeEndDate != null && Model.SchemeEndDate.Value.AddHours(30) >= DateTime.Now)
                            {
                                <div class="row">
                                    <div class="col-md-12">
                                        <label style="color:red; font-size:10pt;padding-left:30px;font-weight:bold;">
                                            Congratulations! Your registration has been successfully submitted. You are now requested to complete the payment of application form fee of Rs 5900/- on Nivesh Mitra
                                            Portal using || Pay Consolidated Fee || option to download the brochure and complete other formalities.
                                            If you have already made the payment on Nivesh Mitra, please wait for the validation of the application fee payment to be updated.
                                        </label>
                                    </div>
                                    <div class="col-md-12 col-sm-12 form-group text-right">
                                        <input type="button" class="btn btn-default" id="btn-pay-form-fee" value="Validate Fee Payment" style="float:right;" />
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            if (Model.SchemeEndDate != null && Model.SchemeEndDate.Value.AddHours(30) >= DateTime.Now)
                            {
                                <input type="button" value="Submit" id="btn-form-submit" class="btn btn-add" />
                            }
                        }
                    }
                </div>
            </div>

            

        </div>

    </div>
}

<div class="col-md-12" id="div-otp-popup-window">
