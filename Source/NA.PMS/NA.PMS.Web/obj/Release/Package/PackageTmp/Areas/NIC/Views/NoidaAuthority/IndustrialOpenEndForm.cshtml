        <div class="col-md-3 col-sm-4 col-xs-12 form-group" style="text-align:center">
            <label>OTP</label>
        </div>
        <div class="col-md-3 col-sm-4 col-xs-12 form-group">
            <input type="text" class="k-textbox" id="text-otp" maxlength="10" placeholder="enter otp here" style="width:100%" />
        </div>
        <div class="col-md-3 col-sm-4 col-xs-12 form-group">
            <input class="k-button" type="button" value="Resend" id="btn-otp-resend" />
        </div>
    </div>
