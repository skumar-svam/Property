<div id='divUserRequestStatus' class='col-md-12 adminfeediv'>
    <div class="row" style="margin-top:12px;">
        <div class="col-md-12 k-grid-content">
            @(Html.Kendo().Grid<UserWiseRequest>
                ()
                .Name("gvUserWiseRequest")
                .Columns(columns =>
                {
                    columns.Bound(c => c.UserName).Title("User Name");
                    columns.Bound(c => c.Name).Title("Name");
                    columns.Bound(c => c.TotalRequest).Title("Total Request");
                })
                .Sortable()
                .Filterable()
                .Pageable
                (
                pageable => pageable
                .Enabled(true)
                .Refresh(true)
                .PageSizes(true)
                )
                    //.Groupable()
                .DataSource
                (
                dataSource => dataSource
                .Ajax()
                    //.Sort(x => x.Add("RequestId").Descending())
                .Model(model => model.Id(p => p.RequestId))

                .ServerOperation(true)
                .Read(read => read.Action("GetUserWiseRequest_Read", "Report").Data("GetPara")).PageSize(5)
                ).AutoBind(false)
            )
        </div>
    </div>
    <div class="row" style="padding-top:30px;">
        <div class="col-md-5 form-group"></div>
        <div class="col-md-6 form-group">
            <button type='button' class='btn btn-default' value='Cancel' onclick="CloseUserReq();">Close</button>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#loadingImg").addClass("loadImg");
        $("#divUserRequestStatus").kendoWindow({
            modal: true,
            title: "User Wise Request",
            visible: false,
            width: "50%"
        });
        DefaultData();
    });

    function DefaultData() {
        var todayDate = kendo.toString(kendo.parseDate(new Date()), 'MM/dd/yyyy');
        var ToDate = $('#kendoToDate').val(todayDate);
        var FromDate = $('#kendoFromDate').val(todayDate);
        GetMatrix(null, null, FromDate, ToDate);
    }

    function OpenUserReqPopUp() {
        $("#gvUserWiseRequest").data("kendoGrid").dataSource.read();
        var win = $("#divUserRequestStatus").data("kendoWindow");
        win.center();
        win.open();
    }

    function CloseUserReq() {
        var win = $("#divUserRequestStatus").data("kendoWindow");
        win.close();
    }

    function ShowUserWiseRequest(strId) {
        if (strId != null && strId.length > 1) {
            var array = strId.split('#');
            var Deptid = array[0];
            var ServiceId = array[1];
            var RequestStatus = array[2];

            if (Deptid.length > 0 && ServiceId.length > 0 && RequestStatus.length > 0) {
                $('#DepartmentId').val(parseInt(Deptid));
                $('#ServiceId').val(parseInt(ServiceId));
                $('#RequestId').val(parseInt(RequestStatus));
                OpenUserReqPopUp();
            }
        }
    }

    function GetPara() {
        var objUserWiseRequest = {
            DepartmentId: parseInt($('#DepartmentId').val()),
            ServiceId: parseInt($('#ServiceId').val()),
            RequestId: parseInt($('#RequestId').val()),
            FromDate: $('#kendoToDate').val(),
            ToDate: $('#kendoFromDate').val()
        };
        return objUserWiseRequest;
    }

    $('#btnSearch').click(function () {
        var ndeptId = $('#ddlDepartment').val();
        var nservId = $('#ddlService').val();
        var ToDate = $('#kendoToDate').val();
        var FromDate = $('#kendoFromDate').val();

        if (FromDate == null || FromDate == "") {
            alertify.error("select start date.");
            return false;
        }
        if (ToDate == null || ToDate == "") {
            alertify.error("select end date.");
            return false;
        }
        if (FromDate > ToDate) {
            alertify.error("start date should not be greater than end date.");
            return false;
        }
        $("#loadingImg").removeClass("loadImg");
        $(".divMatrix").addClass("divOpacity");
        GetMatrix(null, null, FromDate, ToDate);
    });

    $('#btnClear').click(function () {
        //$('#ddlDepartment').data("kendoDropDownList").value("");
        //$('#ddlService').data("kendoDropDownList").value("");
        $('#kendoFromDate').data("kendoDatePicker").value("");
        $('#kendoToDate').data("kendoDatePicker").value("");
        $("#loadingImg").removeClass("loadImg");
        $(".divMatrix").addClass("divOpacity");
        DefaultData();
    });
    function GetMatrix(ndeptId, nservId, FromDate, ToDate) {
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ departmentid: ndeptId, serviceId: nservId, FromDate: FromDate, ToDate: ToDate }),
            url: '/Report/GetServiceRequestMatrixBySearch',
            success: function (result) {
                $(".divtbl").remove();
                $(".divMatrix").append(result);
                $("#loadingImg").addClass("loadImg");
                $(".divMatrix").removeClass("divOpacity");
            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                alertify.error("Something is wrong, try again later");
            }
        });
    }
</script>