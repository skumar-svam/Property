@model NA.PMS.NICServices.SWPEpassViewModel
@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@using NA.PMS.Common
@{
    ViewBag.Title = "Manage Online Epass";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="OnlinePass">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Covid-19 Pass</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                @Html.ActionLink("Create Pass", "Index", new { controller = "NoidaAuthority", area = "NIC" }, htmlAttributes: new { target = "_blank" })
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 alot-prop-grid k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.NICServices.SWPEpassViewModel>()
            .Name("GridEpass")
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.EpassNo).Title("Pass No").ClientTemplate("#if(IsActive==true){#<a target='_blank' href='/NIC/NoidaAuthority/EpassDetails/#=Id#'>#=EpassNo#</a>#}else{#<label>#=EpassNo#</label>#}#").Sortable(true);
                columns.Bound(c => c.Applicant).Title("Applicant Name");
                columns.Bound(c => c.MobileNo).Title("Mobile No").Sortable(false).Filterable(false);
                columns.Bound(c => c.FromAddress).Title("Address");
                //columns.Bound(c => c.ToAddress).Title("Destination");
                columns.Bound(c => c.Purpose).Title("Purpose");
                //columns.Bound(c => c.StartDate).Title("Start Date").Format("{0:dd-MMM-yyyy}").Sortable(false);
                columns.Bound(c => c.EndDate).Title("Valid Till").Format("{0:dd-MMM-yyyy}").Sortable(false);
                columns.Bound(c => c.Approver).Title("Validated By");
                columns.Bound(c => c.ApprovalDate).Title("Validated Date").Format("{0:dd-MMM-yyyy}").Sortable(false);
                columns.Bound(c => c.StatusId).Title("Action").ClientTemplate("#if(IsApproved!=true){#<label style='color:blue;'  class='hyperlink' onclick='javascript:ValidateEpass(#=Id#)'>Approve</label> #}else if(StatusId==2){#<label>Rejected</label>#}else{#<label>Approved</label>#}#").Sortable(false);
                //columns.Bound(c => c.IsDocumentAvailable).Title(" ").Width(80).ClientTemplate("<label class='hyperlink' onclick='javascript:UpdateDocument(this)'>#=IsDocumentAvailable#</label>");
                //columns.Bound(c => c.IsActive).Title(" ").Width(50).ClientTemplate("#if(IsDocumentAvailable){#<center><span class='glyphicon glyphicon-download'></span></center> #}else{#<center><span class='glyphicon glyphicon-refresh' onclick='javascript:UpdateDocument(this)'></span></center>#}#").Sortable(false);
            })
            .Sortable().Filterable().Resizable(resize => resize.Columns(true))
            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                .ClientDetailTemplateId("template")
            .AutoBind(true)
            .DataSource
            (
                dataSource => dataSource
                .Ajax()
                .Model(model => model.Id(p => p.Id))
                .ServerOperation(true)
                .Read(read => read.Action("GetAllEpassList", "NoidaAuthority", new { area = "NIC" }))
                .Sort(s => s.Add(x => x.Id).Descending())
                .PageSize(10)
            )
            .Excel(excel => excel
                .AllPages(true).Filterable(true)
                .FileName("Covid-19 Pass.xlsx"))
            .ToolBar(toolsExcel => toolsExcel.Excel())
        )
    </div>
</div>

<div class="col-md-12" id="divPopupWindow" style="min-height:300px;background:url(/Content/Images/boxed-bg.jpg) repeat">
    <div class="row form-group">
        @Html.HiddenFor(m => m.Id)
        <div class="col-md-3 col-sm-12 col-xs-12 form-group">
            <label>Service Status</label>
        </div>
        <div class="col-md-6">
            @(Html.Kendo().DropDownList()
            .Name("ddlStatus")
                .DataTextField("Text")
                .DataValueField("Value")
                .OptionLabel(" --- Select ---")
                .BindTo(new List<SelectListItem>() {
                    new SelectListItem() { Text = "Approve", Value = "1" },
                    new SelectListItem() { Text = "Reject", Value = "2" }
                })
                    //.Events(e => e.Change("KYAParameterChangeEvent"))
                .HtmlAttributes(new { @class = "input-disabled", style = "width:100%; float:right;" })
            )
        </div>
    </div>
    <div class="row" style="margin-top:25px;">
        <div class="col-md-3 col-sm-12 col-xs-12 form-group">
            <label>Remarks</label>
        </div>
        <div class="col-md-8 col-sm-12 col-xs-12 form-group">
            @Html.TextAreaFor(model => model.Comment, htmlAttributes: new { @class = "form-control" })
            @*<input type="text" class="k-textbox" id="txtotp" maxlength="10" placeholder="enter otp here" style="width:100%" />*@
        </div>
    </div>
    <div class="row">
        <div class="col-md-3 col-sm-12 col-xs-12 form-group">

        </div>
        <div class="col-md-8 col-sm-12 col-xs-12 form-group">
            <input type="button" class="k-button" id="btnCancelPopup" value="Cancel" style="width:100px" />
            <input type="button" class="k-button" id="btnSubmitComment" value="submit" style="width:100px" />
        </div>
    </div>
</div>

<div class="col-md-12 popup-window" id="DocumentWindow" style="min-height:500px;background:url(/Content/Images/boxed-bg.jpg) repeat;">
    <div class="row form-group" id="divLetterContent" style="height:500px; overflow:auto;">

    </div>
    @*<div class="row">
            <div class="col-md-12" style="text-align:center">
                <button type="button" class="k-button" onclick="PrintLetter();" style="width:100px;">Print</button>
                <button type="button" class="k-button" onclick="CloseLetter();" style="width:100px;">Close</button>
            </div>
        </div>*@
</div>

<script id="template" type="text/kendo-tmpl">
        @(Html.Kendo().Grid<NA.PMS.NICServices.SWPEpassViewModel>()
                .Name("grid_#=Id#") // template expression, to be evaluated in the master context
                .Columns(columns =>
                {
                    columns.Bound(c => c.Id).Hidden(true);
                    columns.Bound(c => c.PhotoPath).Title("User Photo").ClientTemplate("#if(PhotoPath != null){#<label style='color:blue;'  class='hyperlink' onclick='javascript:DisplayDocument(\"#=PhotoPath#\")'>User Image</label> #}#");
                    columns.Bound(c => c.UserIdPath).Title("Id Proof").ClientTemplate("#if(UserIdPath != null){#<label style='color:blue;'  class='hyperlink' onclick='javascript:DisplayDocument(\"#=UserIdPath#\")'>#=EPDIII#</label> #}#");
                    columns.Bound(c => c.RCPath).Title("Registration Certificate").ClientTemplate("#if(RCPath != null){#<label style='color:blue;'  class='hyperlink' onclick='javascript:DisplayDocument(\"#=RCPath#\")'>RC</label> #}#");
                    //columns.Bound(c => c.LicencePath).Title("Driving Licence").ClientTemplate("#if(LicencePath != null){#<label style='color:blue;'  class='hyperlink' onclick='javascript:DisplayDocument(\"#=LicencePath#\")'>Driving Licence</label> #}#");
                })
                .AutoBind(true)
                .DataSource(dataSource => dataSource
                     .Ajax().Read(read => read.Action("GetAllEpassList", "NoidaAuthority", new { area = "NIC", Id = "#=Id#" }))
                )
                .ToClientTemplate()
        )
    </script>



<script type="text/javascript">
    $(document).ready(function () {
        $('#divPopupWindow').kendoWindow({
            modal: true,
            title: "Validate Covid-19 Pass",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "30%"
            },
            width: "50%", height: "35%"
        });

        $('.popup-window').kendoWindow({
            modal: true,
            title: "View Document",
            //actions: false,
            //actions: ["Pin", "Minimize", "Maximize", "Close"],
            visible: false,
            width: "75%"
        });
        $('#btnCancelPopup').click(function () {
            $("#divPopupWindow").data("kendoWindow").close();
        });

        $('#btnSubmitComment').click(function () {
            UpdateEpass();
        });

    });
    function ValidateEpass(id) {
        $('#Id').val(id);
        $("#divPopupWindow").data("kendoWindow").center();
        $("#divPopupWindow").data("kendoWindow").open();
    }

    function DisplayDocument(path) {
        $("#divLetterContent").empty();
        $("#divLetterContent").append($('<iframe src=' + path + ' style="width:100%;min-height:500px;"></iframe>'));
        $("#DocumentWindow").data("kendoWindow").center();
        $("#DocumentWindow").data("kendoWindow").open();
    }
    function UpdateEpass() {
        if (ValidateActionField()) {
            var model = {
                Id: $('#Id').val(),
                StatusId: $('#ddlStatus').data("kendoDropDownList").value(),
                Comment: $('#Comment').val()
            };
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ model: model }),
                url: '/NIC/NoidaAuthority/ValidateEpass',
                success: function (result) {
                    if (result == '@ReturnType.None') {
                        $('#divPopupWindow').data("kendoWindow").close();
                        alertify.error("provider failed to update status.");
                    }
                    else if (result == '@ReturnType.Approved') {
                        $('#divPopupWindow').data("kendoWindow").close();
                        alertify.success("Data approved successfully.");
                        $("#GridEpass").data("kendoGrid").dataSource.read();
                    }
                    else if (result == '@ReturnType.Rejected') {
                        $('#divPopupWindow').data("kendoWindow").close();
                        alertify.success("KYA rejected successfully.");
                        $("#GridEpass").data("kendoGrid").dataSource.read();
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Network error, try again later");
                }
            });
        }

    }
    function ValidateActionField() {
        var flag = true;
        if ($('#StatusId').val() == "") {
            alertify.error("Select status");
            flag = false;
        }
        if ($('#Comment').val() == "") {
            alertify.error("Enter remarks");
            flag = false;
        }
        @*else if (($('#StatusId').val() == '@NAStatusId.Rejected') || ($('#StatusId').val() == '@NAStatusId.Pending')) {
            if ($('#OptionalId').val() == "") {
                alertify.error("Select reason for rejection/pending");
                flag = false;
            }
            if ($('#Remarks').val() == "") {
                alertify.error("Enter remarks for rejection/pending");
                flag = false;
            }
        }
        else if ($('#StatusId').val() == '@NAStatusId.Forwarded') {
            if ($('#ApproverId').val() == "") {
                alertify.error("Select Approver");
                flag = false;
            }
        }*@
        return flag;
    }
</script>
