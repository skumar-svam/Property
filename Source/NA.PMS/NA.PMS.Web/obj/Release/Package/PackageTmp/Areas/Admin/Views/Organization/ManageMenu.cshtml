@model NA.PMS.Model.RolesModel
@using Kendo.Mvc.UI;
@using NA.PMS.Model

@{
    ViewBag.Title = "Manage Menu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Scripts/kendo.aspnetmvc.min.js"></script>
<style>
    .k-grid-content {
        overflow-y: hidden;
        overflow-x: hidden;
    }
</style>

<div class="ManageAdminRoles">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Menu</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                <a href="#" id="btnAddRole" class="" onclick="javascript:AddMenu(event);">Add Menu</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>

    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.UserManagement.NDARoleViewModel>()
              .Name("gridMenu")
              .Columns(columns =>
              {
                  columns.Bound(c => c.Id).Title("Menu Id").Width(100);
                  columns.Bound(c => c.MenuName).Title("Menu Name");
                  columns.Bound(c => c.MenuPathId).Title("Menu Path Id").Width(110);
                  columns.Bound(p => p.MenuParentId).Title("Parent Id").Width(110);
                  columns.Bound(p => p.AplicationName).Title("Application");
                  //columns.Bound(p => p.ApplicationId).Title("Application").Width(110);
                  columns.Bound(c => c.RoleId).Title("Mapping").Width(110).ClientTemplate("# if (IsActive == true) {#<a href='" + Url.Action("MapUsers", "ManageUsers") + "?rId=#= RoleId #&appID=#=ApplicationId#'" + ">Map Users</a>#} else {#<span>Map Users</span>#} #");
                  //columns.Bound(c => c.RoleId).Title("Action").Width(100).ClientTemplate("# if (IsActive == true) {#<a class='gridEdit' href='" + "/SuperAdmin/ManageAdminRoles/EditAdminRole/#= RoleId #'> Edit </a>#} else {#<span class='gridNotEdit'>Edit</span>#} #").Filterable(false);
                  columns.Bound(c => c.RoleId).Title("Status").Width(110).ClientTemplate("<label class='hyperlink' onclick='javascript:Deactivate(#= MenuId #);'>#if(IsActive == true){#<span>Deactive</span>#}else{#<span>Activate</sapn>#}#</label>");
              })
              .Sortable().Filterable()
              .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(new[] { 10, 50, 100, 500 }).Info(true).PreviousNext(true).Input(true).Numeric(true).ButtonCount(5))
              .Resizable(resize => resize.Columns(true))
              .DataSource
              (
                  dataSource => dataSource
                      .Ajax()
                      .Model(model => model.Id(p => p.Id))
                      .ServerOperation(true).Group(g=>g.Add(m=>m.ParentMenuName))
                      .Read(read => read.Action("GetMenuListAsDataSource", "Organization", new { area = "Admin" }))
                      .PageSize(10)
              )
        )
        @Html.HiddenFor(model => model.ViewName)
    </div>
</div>


<div id="window-modal" class="modal fade" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog" style="min-height:250px; min-width:70%;border-radius:0;">
        <div class="modal-content" style="border-radius:0;">
            <div class="modal-body">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                @{Html.RenderPartial("_PartialMenu");}
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function Deactivate(menuid) {
        $.ajax({
            dataType: 'json',
            contentType: 'application/json; charset=utf-8',
            type: "POST",
            data: JSON.stringify({ MenuId: menuid, ActionType: "Status", FilterName: "Menu" }),
            url: '/Admin/Organization/SaveMasterDataInfoByType',
            success: function (data) {
                $('#gridMenu').data('kendoGrid').dataSource.read();
            },
            error: function (msg) {
                alert("Error Occured-" + msg.responseText);
            }
        });
    }

    function AddMenu(event) {
        event.preventDefault();
        $('#window-modal').modal('show');
    }
</script>

