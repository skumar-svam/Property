@using Kendo.Mvc.UI;
@{
    ViewBag.Title = "Service Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style type="text/css">
    .top-margin {
        margin-top: 6px;
    }

    .col-md-2.pad-left {
        margin-left: 12px;
    }
</style>
<div id="divServiceReports">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Samadhan Diwas Service Request</h1></div>
            <div class="col-md-6 col-sm-6 col-xs-12 col-btn">
                @*<a href="#" id="btnAddRequest" class="" onclick="javascript: AddRequest(event);">Add Request</a>*@
                <a href="/Member/ServiceRequest/PradhikaranDiwas" id="btnAddRequest" class="" target="_blank">Add Request</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12" style="border-left:1px solid #abc;border-right:1px solid #abc ;padding-bottom:15px;">
        <div class="row">
            <div class="col-md-2 pad-left">
                @Html.Label("Department")
                @(Html.Kendo().DropDownList()
                    .Name("ddlDepartment")
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Please Select --")
                    .DataSource(source =>source.Read(read =>read.Action("GetDepartmentList", "ServiceRequest")))
                    .Events(e => e.Change("ChangeDepartmentEvent"))
                   .HtmlAttributes(new { style = "width:100%", @class = "input-disabled" })
                )
            </div>
            <div class="col-md-2 pad-left">
                @Html.Label("Start Date")
                @(Html.Kendo().DatePicker().Name("kendoFromDate").Events(e => e.Change("ChangeDepartmentEvent")).HtmlAttributes(new { style = "width:100%;" }))
            </div>
            <div class="col-md-2 pad-left">
                @Html.Label("End Date")
                @(Html.Kendo().DatePicker().Name("kendoToDate").Events(e => e.Change("ChangeDepartmentEvent")).HtmlAttributes(new { style = "width:100%;" }))
            </div>
            <div class="col-md-2" style="text-align:right;">
                <label style="width:100%;"> </label>
                <button type="button" id="btnSearch" class="k-button top-margin" value="Search">Search</button>
                <button type="button" id="btnClear" class="k-button top-margin" value="Clear">Clear</button>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <div class="k-grid-content" style="overflow-y:hidden;">
            @(Html.Kendo().Grid<NA.PMS.Model.ServiceReportModel>()
              .Name("gridComplaintReport")
              .Excel(excel => excel.AllPages(true).Filterable(true).FileName("ServiceReport.xlsx"))
              .ToolBar(toolsExcel => toolsExcel.Excel())
              .Columns(columns =>
              {
                  if (Model.ServiceModel.RoleType == NA.PMS.Common.Constants.RoleIdSDO)
                  {
                      columns.Bound(c => c.Id).Title("Request No").Width(120).Title("Acknowledgement No").ClientTemplate("<a href='" + "/Member/ServiceRequest/RequestDetail/#= Id #'>#= Id #</a>").ClientFooterTemplate("Total Count: #=count#");
                  }
                  else if (Model.ServiceModel.RoleType == NA.PMS.Common.Constants.RoleIdSDU)
                  {
                      columns.Bound(c => c.Id).Title("Request No").Width(120).Title("Acknowledgement No").ClientTemplate("#if(Status=='InProgress'){# <a href='" + "/Member/ServiceRequest/EditRequestDetail/#= EncodedParameter #'>#= Id #</a> #}else{# <a href='" + "/Member/ServiceRequest/RequestDetail/#= Id #'>#= Id #</a> #}#").ClientFooterTemplate("Total Count: #=count#");
                  }
                  else
                  {
                      columns.Bound(c => c.Id).Title("Request No").Width(120).Title("Acknowledgement No").ClientFooterTemplate("Total Count: #=count#");
                  }
                  columns.Bound(c => c.ApplicantName).Hidden(true).Title("Applicant Name");
                  columns.Bound(c => c.DepartmentName).Title("Department").Width(140);
                  columns.Bound(c => c.SubDepartment).Title("Sub Department");
                  columns.Bound(c => c.ApplicantName).Title("Applicant").ClientTemplate("<span>#= ApplicantName #<br/>#if(MobileNo!=null){# <small class='glyphicon glyphicon-phone'>&nbsp;#=MobileNo#</small> #}else{# -- #}#</span>").Width(200);
                  columns.Bound(c => c.Sector).Title("Property No.").ClientTemplate("#=Sector#+-/+#=Block#+-+#=PropertyNo#").Width(90);
                  columns.Bound(c => c.MobileNo).Hidden(true).Title("Mobile No");
                  columns.Bound(c => c.ServiceName).Hidden(true).Title("Service Name");
                  columns.Bound(c => c.CreatedDate).Format("{0:dd/MM/yyyy}").Hidden(true).Title("Receiving Date");
                  columns.Bound(c => c.ServiceName).Title("Service Request Type").ClientTemplate("<span>#= ServiceName #<br/><small ><b>Status:</b>&nbsp;#=Status#</small><br/><small ><b>Receiving Date:</b>&nbsp;#= kendo.toString(CreatedDate, 'D')#</small></span>").Width(180);
                  columns.Bound(c => c.Description).Title("Description");
                  columns.Bound(c => c.Status).Title("Status");
                  columns.Bound(c => c.CreatedDate).Title(" ").ClientTemplate("<a  onclick='javascript:OpenFile(this);'><center><span class='glyphicon glyphicon-print'></span></center></a>").Filterable(false).Sortable(false);
                  columns.Bound(c => c.IsServiceHasDoc).ClientTemplate("#if(IsServiceHasDoc){# <center><span class='glyphicon glyphicon-download'></span></center> #}else{# <center>--</center> #}#").Title(" ").Filterable(false).Width(50);
                  columns.Bound(c => c.UploadedDocumentName).ClientTemplate("#if(UploadedDocumentName!=''){# <a  onclick='javascript:OpenDocument_user(this);'><center><span class='glyphicon glyphicon-download'></span></center></a> #}else{# <center>--</center> #}#").Title("User").Filterable(false).Width(50);
                  columns.Bound(c => c.DispatchDocumentName).ClientTemplate("#if(DispatchDocumentName!=''){# <a  onclick='javascript:OpenDocument_officer(this);'><center><span class='glyphicon glyphicon-download'></span></center></a> #}else{# <center>--</center> #}#").Title("Officer").Filterable(false).Width(50);
                  columns.Bound(c => c.UploadedDocumentName).Hidden(true);
                  columns.Bound(c => c.DispatchDocumentName).Hidden(true);
              })
              .Sortable()
              .Filterable()
              .Resizable(resize => resize.Columns(true))
              .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
              .DataSource
              (
                  dataSource => dataSource
                      .Ajax()
                      .Sort(x => x.Add("CreatedDate").Descending())
                      .Model(model => model.Id(p => p.Id))
                      .ServerOperation(true)
                      .Read(read => read.Action("GetServiceRequestReport", "ServiceRequest").Data("FilterSearchParameter"))
                      .Aggregates(aggregates =>aggregates.Add(p => p.Id).Count())
                      .PageSize(10)
              )
              .Events(events => events.ExcelExport("excelex"))
            )
        </div>
    </div>
</div>

<div id="divDocumentView" style="overflow:hidden">
    <div class="row">
        <div class="col-md-12 no-margin no-padding" id="divPageView" style="overflow:hidden">
            <iframe id="ifrmViewPdf"></iframe>
        </div>
    </div>
</div>
<input type="hidden" value="@System.Configuration.ConfigurationManager.AppSettings["FTPSiteRootPath"]" id="DocPath" />
@(Html.Kendo().Window().Visible(false)
           .Name("IDWindow")
           .Title("<b>Service Request Acknowledgement</b>")
           .Width(1000)
           .Modal(true)
