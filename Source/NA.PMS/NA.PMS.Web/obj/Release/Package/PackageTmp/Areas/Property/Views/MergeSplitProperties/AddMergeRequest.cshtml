<script>
    function isNumberKey(event, element) {
        //var charCode = (event.which) ? event.which : event.keyCode;
        //if (charCode > 31 && (charCode < 48 || charCode > 57) && !(charCode == 46 || charcode == 8))
        //    return false;
        //else {
        //    var len = $(element).val().length;
        //    var index = $(element).val().indexOf('.');
        //    if (index > 0 && charCode == 46) {
        //        return false;
        //    }
        //    if (index > 0) {
        //        var CharAfterdot = (len + 1) - index;
        //        if (CharAfterdot > 3) {
        //            return false;
        //        }
        //    }

        //}
        //return true;
        if (!event)
            event = window.event;

        if (event.keyCode > 47 && event.keyCode < 58) {
            return true;
        }
        if (event.keyCode == 8 || event.keyCode == 46) {
            return true;
        }
        return false;
    }
    $(document).ready(function () {

        $(".closePopup").click(function () {
            $("#assignToWindow").data("kendoWindow").close();
        });

        $("#btnAddProperty").hide();
        $("#btnAmalgamateProp").hide();
        $('#btnSubmit').attr('disabled', 'disabled');

        var grid = $("#gridProperties").kendoGrid({
            dataSource: [],
            //pageable: true,
            //toolbar: ["create", "save", "cancel"],
            columns: [
                { field: "Rid", title: "Registration Id", width: "200px" },
                { field: "Department", title: "Department", width: "200px" },
                { field: "PropertyNumber", title: "PropertyNumber", width: "120px" },
                { field: "CoveredArea", hidden: true, width: "120px" },
                { field: "ActualArea", hidden: true, width: "120px" },
                { field: "TotalArea", hidden: true, width: "120px" },
                { field: "TotalPropertyCost", hidden: true, width: "120px" },
                { field: "PropertyType", title: "Property Type", hidden: false, width: "120px" },
                { command: ["destroy"], title: "Action", width: "200px" }
            ],
            editable: {
                mode: "inline",
                confirmation: false
            }
        });

        $("#btnPopupSubmit").click(function () {

            var charge = $("#Charges").val();
            var rids = $("#hdnAllRids").val().slice(0, $("#hdnAllRids").val().length - 1);

            $.ajax({
                dataType: 'json',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                url: '/MergeSplitProperties/SubmitRequestForApproval',
                data: JSON.stringify({ allRids: rids, userId: $("#User").val(), charge: charge }),
                success: function (result) {
                    if (result == true) {
                        $("#assignToWindow").data("kendoWindow").close();
                        alertify.success("Data saved successfully.");
                        window.location.href = '@Url.Action("MergeProperties", "MergeSplitProperties")';
                    } else {
                        alert("There is some error.");
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //alert(respText);
                }
            });

        });
    });
    var PropertyData = [];
    $("#btnAddProperty").click(function () {
        var gridData = $("#gridProperties").data("kendoGrid").dataSource.data();
        if (gridData.length > 0) {
            var type = gridData[0].PropertyType;
            if (type.toLowerCase() != $("#PropertyType").val().toLowerCase()) {
                alertify.error("Only properties with same Property Type can be amalgmated");
                return false;
            }
        }

        var found = PropertyData.some(function (el) {
            return el.Rid === $("#Rid").val();
        });
        if (!found) {
            PropertyData.push({
                Rid: $("#Rid").val(),
                Department: $("#DepartmentName").val(),
                PropertyNumber: $("#PropertyNumber").val(),
                CoveredArea: $("#CoveredArea").val(),
                ActualArea: $("#ActualArea").val(),
                TotalArea: $("#TotalArea").val(),
                TotalPropertyCost: $("#TotalPropertyCost").val(),
                PropertyType: $("#PropertyType").val()
            });
        }

        localStorage["grid_data"] = JSON.stringify(PropertyData);

        var dataSource = new kendo.data.DataSource({
            transport: {
                read: function (options) {
                    var localData = JSON.parse(localStorage["grid_data"]);
                    options.success(localData);
                },
                destroy: function (options) {
                    var localData = JSON.parse(localStorage["grid_data"]);

                    for (var i = 0; i < localData.length; i++) {
                        if (localData[i].Rid === options.data.Rid) {
                            localData.splice(i, 1);
                            break;
                        }
                    }
                    localStorage["grid_data"] = JSON.stringify(localData);
                    options.success(localData);
                    //e.success();
                }
            },
            pageSize: 20
        });

        var grid = $("#gridProperties").kendoGrid({
            dataSource: dataSource,
            //pageable: true,
            //toolbar: ["create", "save", "cancel"],
            columns: [
                { field: "Rid", title: "Rid", width: "200px" },
                { field: "Department", title: "Department", width: "200px" },
                { field: "PropertyNumber", title: "PropertyNumber", width: "120px" },
                { field: "CoveredArea", hidden: true, width: "120px" },
                { field: "ActualArea", hidden: true, width: "120px" },
                { field: "TotalArea", hidden: true, width: "120px" },
                { field: "TotalPropertyCost", hidden: true, width: "120px" },
                { field: "PropertyType", title: "Property Type", hidden: false, width: "120px" },
                { command: ["destroy"], title: "Action", width: "200px" }
            ],
            editable: {
                mode: "inline",
                confirmation: false
            }
        });//.true("kendoGrid");

        $("#btnAmalgamateProp").show();


    });

    function DepartmentSelection(e) {
        var dataItem = this.dataItem(e.item);
        $("#DepartmentId").val(dataItem.Value);
        $("#btnAddProperty").hide();
        PropertyData = [];
        $("#gridProperties").data("kendoGrid").dataSource.data([]);
    }

    function SectorSelection(e) {
        var dataItem = this.dataItem(e.item);
        $("#SectorId").val(dataItem.id);
        $("#btnAddProperty").hide();
        PropertyData = [];
        //$("#gridProperties").data("kendoGrid").dataSource.data([]);
    }

    function BlockSelection(e) {
        var dataItem = this.dataItem(e.item);
        $("#BlockId").val(dataItem.id);
        $("#btnAddProperty").hide();
        PropertyData = [];
        $("#gridProperties").data("kendoGrid").dataSource.data([]);
    }

    function RidSelection(e) {
        var dataItem = this.dataItem(e.item);
        //$("#DepartmentId").val(dataItem.Value);
        var rId = dataItem.id;
        if (rId != "") {
            $("#Rid").val(rId);
            $.ajax({
                url: '@(Url.Action("GetPropertyDetailsByRid", "MergeSplitProperties"))',
                type: 'POST',
                dataType: 'json',
                data: { rId: rId },
                success: function (result) {
                    if (result != null) {
                        $("#ApplicantName").val(result.ApplicantName);
                        $("#DepartmentName").val(result.DepartmentName);
                        $("#PropertyType").val(result.PropertyTypeName);
                        $("#TotalArea").val(result.TotalArea);
                        $("#SchemeName").val(result.SchemeName);
                        $("#PropertyNumber").val(result.PropertyNo);
                        $("#PropertyId").val(result.PropertyId);

                        $("#SectorName").val(result.SectorName);
                        $("#BlockName").val(result.BlockName);
                        $("#CoveredArea").val(result.CoveredArea);
                        $("#ActualArea").val(result.ActualArea);
                        $("#TotalArea").val(result.TotalArea);
                        $("#TotalPropertyCost").val(result.TotalPropertyCost);
                        //alert(result.CoveredArea + ":" + result.ActualArea + ":" + result.TotalArea + ":" + result.TotalPropertyCost);

                        $("#btnAddProperty").show();

                    } else {
                        alert("There is some error.");
                    }
                }
            });
        }
    }

    function FilterSectorValuesByDeptId() {
        return {
            departmentId: $("#DepartmentId").val()
        };
    }

    function FilterBlockBySector() {
        return {
            departmentId: $("#DepartmentId").val(),
            sectorId: $("#SectorId").val()
        };
    }

    function FilterRIDs() {
        return {
            departmentId: $("#DepartmentId").val(),
            sectorId: $("#SectorId").val(),
            blockId: $("#BlockId").val()
        };
    }

    $("#btnCancel").click(function () {
        window.location.href = '@Url.Action("MergeProperties", "MergeSplitProperties")';
    });
    $("#btnAmalgamateProp").click(function () {
        var dataSource = $("#gridProperties").data("kendoGrid").dataSource;

        // Gets the filter from the dataSource
        var filters = dataSource.filter();

        // Gets the full set of data from the data source
        var allData = dataSource.data();

        // Applies the filter to the data
        var query = new kendo.data.Query(allData);
        var filteredData = query.filter(filters).data;
        var allRIDs = "";
        var newPropertyNumber = "";
        var newSchemeName = "";
        var newDepartment = "";
        var newPropertyType = "";
        var newSector = "";
        var newBlock = "";
        var newCoveredArea = 0;
        var newActualArea = 0;
        var newTotalArea = 0;
        var newTotalPropertyCost = 0;

        if (filteredData.length == 0) {
            //alert("Please add some properties to amalgamate.");
            alertify.error("Please add some properties to amalgamate.");
            return false;
        }

        if (filteredData.length == 1) {
            alertify.error("Please add atleast two properties to amalgamate.");
            return false;
        }

        $.each(filteredData, function (index, item) {

            allRIDs = allRIDs + item.Rid + ",";
            newPropertyNumber = newPropertyNumber + item.PropertyNumber + "-";

            newCoveredArea = parseInt(newCoveredArea) + parseInt(item.CoveredArea);
            newActualArea = parseInt(newActualArea) + parseInt(item.ActualArea);
            newTotalArea = parseInt(newTotalArea) + parseInt(item.TotalArea);
            newTotalPropertyCost = parseInt(newTotalPropertyCost) + parseInt(item.TotalPropertyCost);
        });
        $("#hdnAllRids").val(allRIDs);
        //alert(newPropertyNumber);
        newSchemeName = $("#SchemeName").val();
        newDepartment = $("#DepartmentName").val();
        newPropertyType = $("#PropertyType").val();
        newSector = $("#SectorName").val();
        newBlock = $("#BlockName").val();

        //$("#ApplicantName").val(result.ApplicantName);
        $("#txtPropertyNumber").val(newPropertyNumber.slice(0, newPropertyNumber.length - 1));
        $("#txtSchemeName").val(newSchemeName);
        $("#txtDepartmentName").val(newDepartment);
        $("#txtPropertyType").val(newPropertyType);
        $("#txtSectorName").val(newSector);
        $("#txtBlockName").val(newBlock);
        $("#txtCoveredArea").val(newCoveredArea);
        $("#txtActualArea").val(newActualArea);
        $("#txtTotalArea").val(newTotalArea);
        $("#txtTotalPropertyCost").val(newTotalPropertyCost);

        //$('#btnSubmit').attr('disabled', 'disabled');
        $('#btnSubmit').removeAttr('disabled');
    });
    $('#btnSubmit').click(function () {
        if ($("#Charges").val() == "") {
            alertify.error("Please enter Charges.");
            $("#Charges").focus();
            return false;
        }

        $("#assignToWindow").data("kendoWindow").center();
        $("#User").data("kendoDropDownList").dataSource.read();
        $("#assignToWindow").data("kendoWindow").open();
    });


</script>
