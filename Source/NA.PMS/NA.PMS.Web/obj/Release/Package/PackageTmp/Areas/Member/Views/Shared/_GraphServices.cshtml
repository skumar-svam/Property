@using Kendo.Mvc.UI
@using NA.PMS.Common
@using System.Linq

<div id="div-graph-services">
    <div class="row" style="padding-bottom:8px;">
        <div class="col-md-3">
            <label>Department</label>
            @(Html.Kendo().DropDownList()
                .Name("DDLServiceDepartmentId")
                .DataTextField("Text")
                .DataValueField("Value")
                //.OptionLabel(" --- Select ---")
                .BindTo(new List<SelectListItem>() {
                    new SelectListItem() { Text = "Institutional", Value = "1" },
                    new SelectListItem() { Text = "Industrial", Value = "4" },
                    new SelectListItem() { Text = "Commercial", Value = "2" },
                    new SelectListItem() { Text = "Residential", Value = "3" },
                    new SelectListItem() { Text = "Housing", Value = "5" },
                    new SelectListItem() { Text = "Group Housing", Value = "6" },
                    new SelectListItem() { Text = "5 % Abadi", Value = "7" }
                })
                .Events(e => e.Change("ServiceChangeEvent"))
                .HtmlAttributes(new { style = "width: 90%;" })
            )
        </div>
        <div class="col-md-3">
            <label>Start Date</label>
            @(Html.Kendo().DatePicker().Name("ServiceStartDate")
                    .Events(e => e.Change("ServiceChangeEvent"))
                    .HtmlAttributes(new { style = "width:90%;" })
            )
        </div>
        <div class="col-md-3">
            <label>End Date</label>
            @(Html.Kendo().DatePicker().Name("ServiceEndDate")
                    .Events(e => e.Change("ServiceChangeEvent"))
                    .HtmlAttributes(new { style = "width:90%;" })
            )
        </div>
    </div>
    <div class="row">
       <div class="col-md-12">
           <input type="hidden" id="hdn-department-id" />
           <input type="hidden" id="hdn-service-id" />
       </div>
    </div>
    <div class="row">
        <div class="col-md-6 demo-section k-content wide">
            <div id="DivServicePieChartI"></div>
        </div>
        <div class="col-md-6 demo-section k-content wide">
            <div id="DivServicePieChartII"></div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 demo-section k-content wide">
            <div id="DivServicePieChartIII"></div>
        </div>
        <div class="col-md-6 demo-section k-content wide">
            <div id="DivServicePieChartIV"></div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 demo-section k-content wide">
            @*<div id="DivServicePieChartV" style="width:100%;"></div>*@
        </div>
    </div>
    <div class="row">
        <div class="col-md-12" style="margin-top:20px;">
            <div class="row rw-spce">
                <div class="col-md-12">
                    <h2 class=" blck-heading" style="border-left:1px solid green;border-right:1px solid green;margin-bottom:0;">Status Of Services (1st-Jan-2018 Onwards)</h2>
                    <div class="col-md-12 k-grid-content">
                        @(Html.Kendo().Grid<NA.PMS.Model.ServiceViewModel>()
                    .Name("GridServiceDetailStatus")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.ServiceName).Title("Service Name").ClientFooterTemplate("Total Count:");
                        columns.Bound(c => c.Completed).Title("Completed").Width(110).ClientFooterTemplate("#=sum#");
                        columns.Bound(c => c.Cancelled).Title("Cancelled").Width(110).ClientFooterTemplate("#=sum#");
                        columns.Bound(c => c.Rejected).Title("Rejected").Width(110).ClientFooterTemplate("<div>#= sum #</div>");
                        columns.Bound(c => c.Pending).Title("Pending").Width(110).ClientFooterTemplate("<div>#= sum #</div>");
                        //columns.Bound(c => c.InProgress).Title("In Progresss").Width(110).ClientFooterTemplate("<div>#= sum #</div>");
                        columns.Bound(c => c.TotalRequest).Title("Total Request").Width(110).ClientFooterTemplate("<div>#= sum #</div>");
                        //columns.Bound(c => c.PercentInProgress).Title("Progress(%)").Width(110);//.ClientFooterTemplate("<div>#= sum #</div>");
                        //columns.Bound(c => c.DateMar).Title("Average Days").ClientFooterTemplate("<div>Avg: #= kendo.toString(average, '0.00') #</div>");//Gap Between submit date and approve date
                    })
                    .Resizable(resize => resize.Columns(true))
                    //.Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                    .AutoBind(true)
                    .DataSource
                    (
                        dataSource => dataSource
                        .Ajax().ServerOperation(true)
                        .Read(read => read.Action("GetServiceReportsAsDataSource", "Report", new { area = "Reports" }).Data("FilterParameterForServices"))
                        .Aggregates(aggregates =>
                        {
                            aggregates.Add(p => p.Completed).Sum();
                            aggregates.Add(p => p.Cancelled).Sum();
                            aggregates.Add(p => p.Rejected).Sum();
                            aggregates.Add(p => p.Pending).Sum();
                            //aggregates.Add(p => p.InProgress).Sum();
                            aggregates.Add(p => p.TotalRequest).Sum();
                        })
                    ))
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
