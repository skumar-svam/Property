    function GetServiceListForGraph() {
        var today = new Date().toDateString();
        var departmentId = $('#DDLServiceDepartmentId').val();
        var startDate = $('#ServiceStartDate').val();
        var endDate = $('#ServiceEndDate').val();
        var reqThrough = "";
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ DepartmentId: departmentId, StartDate: startDate, EndDate: endDate, RequestThrough: reqThrough }),
            url: '/Reports/Report/GetServiceReportsForGraph',
            success: function (result) {
                if (result != null) {
                    //CreateTotalServiceRequestChart(result);
                    //CreateCompletedServiceChart(result);
                    //CreatePendencyServiceReportChart(result);
                    //CreateInProgressServiceReportChart(result);
                    //CreateBarGraphForServices(result);
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Network error, Please try again later.");
            }
        });
    }

