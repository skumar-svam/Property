@model NA.PMS.Model.OnlineFormViewModel
@using Kendo.Mvc.UI
@using NA.PMS.Common

@{
    ViewBag.Title = "Upload Document";
    if (Session["WBasicDetailsNIC"] != null || Model.AppType == Constants.AppType)
    {
        Layout = "~/Views/Shared/_LayoutNIC.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_LayoutOnline.cshtml";
    }
}

<style>
    .hyperlink {
        color: #547ae1;
    }

        .hyperlink:hover {
            cursor: pointer;
            color: #547ae1;
        }

    #divCompanyInfo {
        display: none;
    }

    #second-form {
        display: none;
    }

    .k-button.k-upload-button {
        margin: 0;
    }

    .k-upload-files {
        margin: 0;
    }

    #loader{display:none;}

