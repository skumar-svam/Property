                    //$('#Applicant').val(result.Applicant);
                    //$('#PropertyId').val(result.PropertyId);
                    //$('#PropertyNo').val(result.PropertyNo);
                    //$('#Address').val(result.Address);
                    //$('#Mobile').val(result.MobileNo);
                    //$('#Email').val(result.Email);
                    //$('#Sector').val(result.Sector);
                    //$('#Block').val(result.Block);
                    //$('#PlotNo').val(result.PlotNo);
                    //$('#LeaseDeedDate').data("kendoDatePicker").value(result.RegistryDate);
                }
                else {
                    alertify.error("There is some error, try again");
                }
                $('#gridLeaseDeedDdetails').data("kendoGrid").dataSource.read();
            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                alertify.error("Something is wrong, try again later.");
            }
        });
    }

    function ValidateLeaseRentFields() {
        var flag = true;
        var totalInstallment = $('#TotalPremiumPaidStatus').data('kendoDropDownList').value();
        var onetimeLeaserent = $('#OneTimeLeasePaidStatus').data('kendoDropDownList').value();
        var ndcDate = $('#NDCDate').data("kendoDatePicker").value();
        var challanDate = $('#ChallanDate').data("kendoDatePicker").value();

        if ($("#RegistrationId").val() == "") {
            flag = false;
            alertify.error("Please select a Registration Id.");
        }
        if (totalInstallment == "") {
            flag = false;
            alertify.error("Select total installment paid status.");
        }
        if (onetimeLeaserent == "") {
            flag = false;
            alertify.error("Select One time lease rent status.");
        }
        if (onetimeLeaserent == "N") {
            if ($("#LeaseRentPerAnnum").val() == "") {
                flag = false
                alertify.error("Enter Lease rent premium.");
            }
            if ($("#LeaseDeedDate").val() == "") {
                flag = false
                alertify.error("Enter Lease Lease Deed Date.");
            }
            if ($("#PenalInterest").val() == "") {
                flag = false
                alertify.error("Enter Penal Interest.");
            }
            if ($("#PaidUptoDate").val() == "") {
                flag = false
                alertify.error("Enter Premium paid upto date.");
            }
            if ($("#RevisedDate").val() == "") {
                flag = false
                alertify.error("Enter Revised Date.");
            }
            if ($("#RevisedRate").val() == "") {
                flag = false
                alertify.error("Enter Revised Rate.");
            }
        }
        if (onetimeLeaserent == "Y") {
            if ($("#TotalLeaseRent").val() == "") {
                flag = false
                alertify.error("Enter Lease rent amount.");
            }
            if ($("#DepositDate").val() == "") {
                flag = false
                alertify.error("Enter deposit date.");
            }
        }
        return flag;
    }

