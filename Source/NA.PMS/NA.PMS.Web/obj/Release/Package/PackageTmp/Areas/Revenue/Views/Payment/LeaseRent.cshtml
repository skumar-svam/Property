@model NA.PMS.Model.LeaseRentViewModel
@using NA.PMS.Common;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;

@{
    ViewBag.Title = "Lease Rent";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .form-group{margin-bottom:10px;}
</style>

@using (Html.BeginForm("SaveLeaseRentPremium", "Payment", FormMethod.Post, new { enctype = "multipart/form-data", id = "LeaserentForm" }))
{
    <div class="col-lg-12 col-md-12 col-sm-12">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Add/Edit Lease Rent</h1></div>
                <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
                <h2 class="blck-heading" style="margin-bottom:12px;">Lease Rent Payment</h2>
                <div class="form-bx">
                    <div style="display:none">
                        @Html.HiddenFor(m => m.Id)
                        @*@Html.HiddenFor(m => m.LeaseDeedDate)
                        @(Html.Kendo().DatePickerFor(model => model.LeaseDeedDate))*@
                        @Html.HiddenFor(m => m.DepartmentId)
                        @Html.HiddenFor(m => m.PropertyId)
                        @Html.HiddenFor(m => m.PropertyNo)
                        @Html.HiddenFor(m => m.PaymentMode)
                        @Html.HiddenFor(m => m.IsOneTimeInstallmentPaid)
                        @Html.HiddenFor(m => m.IsTotalInstallmentPaid)
                        @Html.HiddenFor(m => m.IsOneTimeLeaseRentPaid)
                        @Html.HiddenFor(m => m.IsTotalLeaseRentPaid)
                    </div>

                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Registration Id", htmlAttributes: new { @class = "required" })
                            @if (Model.Id != null && Model.Id > 0)
                            {
                                @Html.TextBoxFor(m => m.RegistrationId, htmlAttributes: new { @class = "form-control", @Readonly = "readonly", style="width:90%; float:right;" })
                            }
                            else
                            {
                                @(Html.Kendo().DropDownListFor(m => m.RegistrationId)
                                .DataTextField("Text")
                                .DataValueField("Id")
                                .Filter("contains")
                                .OptionLabel("---Select---")
                                .DataSource(source =>
                                {
                                    source.Custom()
                                    .ServerFiltering(true)
                                    .ServerPaging(true)
                                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                    .Transport(transport => transport.Read(read => read.Action("GetRegistrationIdList", "Payment", new { area = "Revenue" })))
                                    .Schema(schema => schema.Data("Data").Total("Total"))
                                    .PageSize(100);
                                })
                               .Events(events => { events.Change("GetApplicantDetails"); })
                               .HtmlAttributes(new { @class = "", style = "width:90%; float:right;" })
                                )
                            }
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Sector:")
                            @Html.TextBoxFor(model => model.Sector, htmlAttributes: new { @class = "form-control", @Readonly = "readonly", style="width:90%; float:right;" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Block:")
                            @Html.TextBoxFor(model => model.Block, htmlAttributes: new { @class = "form-control", @Readonly = "readonly", style = "width:90%; float:right;" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                           @Html.Label("Plot No:")
                            @Html.TextBoxFor(model => model.PlotNo, htmlAttributes: new { @class = "form-control", @Readonly = "readonly", style = "width:90%; float:right;" })
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 col-sm-6 col-xs-12 form-group">
                            @Html.Label("Allottee Name:", htmlAttributes: new { @class = "" })
                            @Html.TextAreaFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", @Readonly = "Readonly", style="width:95%; height:30px;float:right;" })
                        </div>
                        
                        <div class="col-md-6 col-sm-6 col-xs-12 form-group">
                            @Html.Label("Address:", htmlAttributes: new { @class = "" })
                            @Html.TextAreaFor(model => model.Address, htmlAttributes: new { @class = "form-control", @Readonly = "readonly", style = "width:95%; height:30px;float:right;" })
                        </div>
                       
                    </div>

                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Is Total Installment Paid:", htmlAttributes: new { @class = "required" })
                            @(Html.Kendo().DropDownListFor(m => m.TotalPremiumPaidStatus)
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .OptionLabel("---Select---")
                            .DataSource(source => source.Read(read => read.Action("GetYesNoStatus", "Payment", new { area = "Revenue" })))
                            .HtmlAttributes(new { @class = "", style = "width:90%; float:right;" })
                            )
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Is One Time Lease Rent Paid:", htmlAttributes: new { @class = "required" })
                            @(Html.Kendo().DropDownListFor(m => m.OneTimeLeasePaidStatus)
                            .OptionLabel("---Select---")
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .DataSource(source => source.Read(read => read.Action("GetYesNoStatus", "Payment", new { area = "Revenue" })))
                            .Events(events => { events.Change("LeaseRentStatusChange"); })
                            .HtmlAttributes(new { @class = "", style = "width:90%; float:right;" })
                            )
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Lease Rent(Annual)", htmlAttributes: new { @class = "" })<span class="fa fa-rupee"></span>
                            @Html.TextBoxFor(model => model.LeaseRentPerAnnum, new { @class = "form-control text-right", @maxlength = "16", onkeypress = "return IsNumeric(event);", style = "width:90%; float:right;" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Revised Lease Rent(Annual)", htmlAttributes: new { @class = "" })<span class="fa fa-rupee"></span>
                            @Html.TextBoxFor(model => model.RevisedLeaseRentPerAnnum, new { @class = "form-control text-right", @maxlength = "16", onkeypress = "return IsNumeric(event);", style = "width:90%; float:right;" })
                        </div>
                    </div>

                    <div class="row row-leaserent">
                        @*<div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Lease Rent Per Year", htmlAttributes: new { @class = "" })<span class="fa fa-rupee"></span>
                            @Html.TextBoxFor(model => model.LeaseRentPremium, new { @class = "form-control text-right", @maxlength = "16", onkeypress = "return IsNumeric(event);", style = "width:90%; float:right;" })
                        </div>*@
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Lease Deed Date")
                            @(Html.Kendo().DatePickerFor(m => m.LeaseDeedDate).HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" }))
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Lease Transfer Date")
                            @(Html.Kendo().DatePickerFor(m => m.TransferLeaseDate).HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" }))
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Panel Interest")
                            @Html.TextBoxFor(model => model.PanelInterest, new { @class = "form-control text-right", @maxlength = "16", onkeypress = "return IsNumeric(event);", style = "width:90%; float:right;" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Lease Rent Revised Date", htmlAttributes: new { @class = "required" })
                            @(Html.Kendo().DatePickerFor(m => m.RevisedDate).HtmlAttributes(new { @class = "input-disabled GPAField", style = "width:90%; float:right;" }))
                        </div>
                    </div>

                    <div class="row row-leaserent">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Paid Duration (Year)")
                            @Html.TextBoxFor(model => model.PremiumPaidDuration, new { @class = "form-control", @maxlength = "50", @placeholder="2001-2002" ,style = "width:90%; float:right;" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Lease Rent Paid Upto", htmlAttributes: new { @class = "required" })
                            @(Html.Kendo().DatePickerFor(m => m.PaidUptoDate).HtmlAttributes(new { @class = "input-disabled GPAField", style = "width:90%; float:right;" }))
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Balance Amount", htmlAttributes: new { @class = "" })<span class="fa fa-rupee"></span>
                            @Html.TextBoxFor(model => model.BalanceAmount, new { @class = "form-control text-right", @maxlength = "16", onkeypress = "return IsNumeric(event);", style = "width:90%; float:right;" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group col-leaserent">
                            @Html.Label("Revised Rate Per Year (%)")
                            @Html.TextBoxFor(model => model.RevisedRate, new { @class = "form-control text-right", @maxlength = "16", onkeypress = "return IsNumeric(event);", style = "width:90%; float:right;" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group col-paid">
                            @Html.Label("Total Lease Rent", htmlAttributes: new { @class = "" })<span class="fa fa-rupee"></span>
                            @Html.TextBoxFor(model => model.TotalLeaseRent, new { @class = "form-control text-right", @maxlength = "16", onkeypress = "return IsNumeric(event);", style = "width:90%; float:right;" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group col-challan">
                            @Html.Label("Deposit Date")
                            @(Html.Kendo().DatePickerFor(m => m.DepositDate).HtmlAttributes(new { @class = "input-disabled GPAField", style = "width:90%; float:right;" }))
                        </div>

                        
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group col-paid">
                            @Html.Label("NDC Date:", htmlAttributes: new { @class = "required" })
                            @(Html.Kendo().DatePickerFor(model => model.NDCDate).HtmlAttributes(new { style = "width:90%; float:right;" }))
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group col-challan">
                            @Html.Label("Challan Date:", htmlAttributes: new { @class = "required" })
                            @(Html.Kendo().DatePickerFor(model => model.ChallanDate).HtmlAttributes(new { style = "width:90%; float:right;" }))
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Payment Mode", htmlAttributes: new { @id = "" })
                            @(Html.Kendo().DropDownListFor(model => model.PaymentModeId)
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel("---Select---")
                            .Filter("contains")
                            //.DataSource(source => source.Read(read => read.Action("GetPaymentModeList", "ManagePayment", new { Area = "Property" })))
                            .DataSource(source =>
                                {
                                    source.Custom()
                                    .ServerFiltering(true)
                                    .ServerPaging(true)
                                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                    .Transport(transport => transport.Read(read => read.Action("GetPaymentModeList", "Payment", new { area = "Revenue" })))
                                    .Schema(schema => schema.Data("Data").Total("Total"))
                                    .PageSize(100);
                                })
                            .HtmlAttributes(new { style = "width:90%;float:right;" })
                            )
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Transaction Id", htmlAttributes: new { @id = "" })
                            @Html.TextBoxFor(model => model.TransactionId, htmlAttributes: new { @class = "form-control", @maxlength = "30", style = "width:90%;float:right;" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group ">
                            @Html.Label("Approver: ")
                            @(Html.Kendo().DropDownListFor(model => model.ApproverId)
                                //.Name("DDLApproverId")
                                .DataTextField("Text")
                                .DataValueField("Id")
                                .Filter("contains")
                                .OptionLabel("---select---")
                                .DataSource(source =>
                                {
                                    source.Custom()
                                    .ServerFiltering(true)
                                    .ServerPaging(true)
                                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                    .Transport(transport => transport.Read(read => read.Action("GetApproverIdList", "Payment", new { area = "Revenue" })))
                                    .Schema(schema => schema.Data("Data").Total("Total"))
                                    .PageSize(100);
                                })
                                .HtmlAttributes(new { style = "width:90%; float:right;" })
                            )
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12  form-group">
                            <label>Payment Status</label>
                            @(Html.Kendo().DropDownListFor(model => model.StatusId)
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel(" -- Select --")
                            .Filter("contains")
                            .AutoBind(true)
                            .Enable(true)
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerPaging(true)
                                .ServerFiltering(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => transport.Read(read => read.Action("GetStatusList", "Payment", new { Area = "Revenue" })))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(100);
                            })
                            .HtmlAttributes(new { style = "width:90%; float:right;" })
                            )
                        </div>
                    </div>
                </div>
            </div>
            <div class="box-button text-center">
                <input type="button" id="btnCncl" value="Cancel" class="btn btn-default" />
                <input type="button" id="btnAddLeaseDeedDetails" value="Add Lease Rent Details" class="btn btn-add" />
            </div>
        </div>

    </div>
}

<div class="col-md-12 k-grid-content" id="LeaseRentGrid">
    @(Html.Kendo().Grid<NA.PMS.Model.LeaseRentViewModel>()
                .Name("gridLeaseDeedDdetails")
                .Columns(columns =>
                {
                    columns.Bound(c => c.Id).Hidden(true);
                    columns.Bound(c => c.RegistrationId).Hidden(true);
                    columns.Bound(c => c.PropertyNo).Hidden(true);
                    columns.Bound(c => c.PremiumPaidDuration).Title("Duration");
                    columns.Bound(c => c.LeaseRentPremium).Title("Premium <span class='fa fa-rupee'>");                   
                    //columns.Bound(c => c.RevisedDate).Title("Revised Date").Format("{0:dd-MMM-yyyy}");
                    columns.Bound(c => c.ChallanDate).Title("Challan Date").Format("{0:dd-MMM-yyyy}");
                    columns.Bound(c => c.DepositDate).Title("Deposit Date").Format("{0:dd-MMM-yyyy}");                    
                    columns.Bound(c => c.PremiumPaidStatus).Title("Premium Paid");
                    //columns.Bound(c => c.IsLeaseRentPaid).Title("Lease Rent Paid");
                    columns.Bound(c => c.OneTimeLeasePaidStatus).Title("Installment");
                    columns.Bound(c => c.PaidUptoDate).Title("Paid Upto").Format("{0:dd-MMM-yyyy}");
                    columns.Bound(c => c.TotalBalance).Title("Total Balance <span class='fa fa-rupee'></span>");//.ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
                    columns.Bound(c => c.Status).Title("Status");
                    columns.Bound(c => c.Id).Title("Edit").ClientTemplate("#if(IsActive==false){# <a href=\"/Revenue/Payment/LeaseRent/#= Id#\" id='e_#=Id#'><span class='glyphicon glyphicon-pencil'></span></a> #}else{# --- #}#").Filterable(false).Sortable(false).Width(50);
                    //columns.Bound(c => c.Id).Title("View").ClientTemplate("<a href=\"/Revenue/Finance/ViewLeaseDeedDetails/#= Id#\" id='e_#=Id#'><span class='glyphicon glyphicon-eye-open'></span></a>").Filterable(false).Sortable(false).Width(50);
                })
                .Sortable()
                .Filterable()
                .Resizable(resize => resize.Columns(true))
                .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Model(model => model.Id(p => p.Id))
                    .ServerOperation(true)
                    .Read(read => read.Action("GetLeaseRentPaymentListById", "Payment", new { area = "Revenue" }).Data("FilterRegistrationId")).PageSize(10)
                    //.Aggregates(aggregates => aggregates.Add(p => p.TotalBalance).Sum())
                    )
    )
</div>

