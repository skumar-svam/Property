<script type="text/javascript">
    $(document).ready(function () {
        //$('.row-leaserent').hide();
        //$('.col-leaserent').hide();
        //$('.col-paid').hide();
        //$('.col-challan').hide();

        //$('#IsPremiumPaid').val("Y");
        var rid = $('#RegistrationId').val().trim();
        if (rid != "" && rid.length == 8) {
            GetApplicantDetails();
        }
        var leaseDeedId = $("#Id").val();

        $("#ApprovarWindow").kendoWindow({
            modal: true,
            title: "Assign Request to Approver",
            visible: false,
            width: "40%"
        });

        $("#btnAddLeaseDeedDetails").click(function () {
            //OpenPopupWindow();
            if (ValidateLeaseRentFields()) {
                //$('#ApproverId').val($('#DDLApproverId').val());
                $('#PaymentMode').val($('#PaymentModeId').data("kendoDropDownList").text());
                //CalculateTotalPremium();
                SubmitLeaseRentForm();
            }
        });

        $("#btnCncl").click(function () {
            window.location.href = '@Url.Action("ManageLeaseRent", "Payment", new { area="Revenue"})';
        });

        $("#btnRequetForApproval").click(function () {
            if (ValidateLeaseRentFields()) {
                //$('#ApproverId').val($('#DDLApproverId').val());
                $('#PaymentMode').val($('#PaymentModeId').data("kendoDropDownList").text());
                //CalculateTotalPremium();
                SubmitLeaseRentForm();
            }
        });

    });

    function FilterRegistrationId() {
        return { rid: $('#RegistrationId').val() };
    }

    function OpenPopupWindow() {
        var win = $("#ApprovarWindow").data("kendoWindow");
        win.center();
        win.open();
    }

    function ClosePopupWindow() {
        var win = $("#ApprovarWindow").data("kendoWindow");
        win.close();
    }

    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }


    function ToggleOneTimePaidFields() {
        var status = $('#OneTimeLeasePaidStatus').val();
        if (status == "Y") {
            //$('.row-leaserent').hide();
            //$('.col-leaserent').hide();
            //$('.col-paid').show();
            //$('.col-challan').show();
        }
        else {
            //$('.row-leaserent').show();
            //$('.col-leaserent').show();
            //$('.col-paid').hide();
            //$('.col-challan').hide();
        }
    }

    function LeaseRentStatusChange() {
        ToggleOneTimePaidFields();
    }

    function GetApplicantDetails() {
        var rid = $('#RegistrationId').val().trim();
        if (rid != "" && rid.length == 8) {
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json;charset=utf-8",
                data: JSON.stringify({ RegistrationId: rid }),
                url: '@Url.Action("GetDetailsByIdForLeaseRent", "Payment", new { area = "Revenue" })',
                success: function (result) {
                    if (result.ReturnTypeId == '@ReturnType.Exist') {
                        $('#DepartmentId').val(result.DepartmentId);
                        $('#Applicant').val(result.Applicant);
                        $('#PropertyId').val(result.PropertyId);
                        $('#PropertyNo').val(result.PropertyNo);
                        $('#Address').val(result.Address);
                        $('#Mobile').val(result.MobileNo);
                        $('#Email').val(result.Email);
                        $('#Sector').val(result.Sector);
                        $('#Block').val(result.Block);
                        $('#PlotNo').val(result.PlotNo);
                        $('#LeaseRentPerAnnum').val(result.LeaseRentPerAnnum);
                        $('#RevisedLeaseRentPerAnnum').val(result.RevisedLeaseRentPerAnnum);
                        $('#LeaseDeedDate').data("kendoDatePicker").value(result.RegistryDate);
                        $('#TransferLeaseDate').data("kendoDatePicker").value(result.TransferLeaseDate);
                        $('#PanelInterest').val(result.PanelInterest);
                        $('#RevisedDate').data("kendoDatePicker").value(result.RevisedDate);
                        $('#PremiumPaidDuration').val(result.PremiumPaidDuration);
                        $('#PaidUptoDate').data("kendoDatePicker").value(result.PaidUptoDate);
                        $('#BalanceAmount').val(result.BalanceAmount);
                        $('#RevisedRate').val(result.RevisedRate);

                        if (result.IsTotalInstallmentPaid == true) {
                            $('#TotalPremiumPaidStatus').data("kendoDropDownList").value("Y");
                        }
                        else {
                            $('#TotalPremiumPaidStatus').data("kendoDropDownList").value("N");
                        }

                        if (result.IsOneTimeLeaseRentPaid == true) {
                            $('#OneTimeLeasePaidStatus').data("kendoDropDownList").value("Y");
                        }
                        else {
                            $('#OneTimeLeasePaidStatus').data("kendoDropDownList").value("N");
                        }
                        alertify.success("Lease rent already added");
                        //ToggleOneTimePaidFields();
                    }
                    if (result.ReturnTypeId == '@ReturnType.NotExist') {
                        $('#DepartmentId').val(result.DepartmentId);
                        $('#Applicant').val(result.Applicant);
                        $('#PropertyId').val(result.PropertyId);
                        $('#PropertyNo').val(result.PropertyNo);
                        $('#Address').val(result.Address);
                        $('#Mobile').val(result.MobileNo);
                        $('#Email').val(result.Email);
                        $('#Sector').val(result.Sector);
                        $('#Block').val(result.Block);
                        $('#PlotNo').val(result.PlotNo);
                        $('#LeaseDeedDate').data("kendoDatePicker").value(result.RegistryDate);
                        alertify.error("Lease Rent data not available.");
                    }
                    else if (result.ReturnTypeId == '@ReturnType.NotAllotted') {
                        alertify.error("This Registration Id not updated in system.");
                    }
                    $('#gridLeaseDeedDdetails').data("kendoGrid").dataSource.read();
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Something is wrong, try again later.");
                }
            });
        }
        else {
            ClearBasicInfo();
            ClearLeaseRentFields();
        }
    }

    function SubmitLeaseRentForm() {
        var formData = new FormData($('form').get(0));
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            data: formData,
            url: '/Revenue/Payment/SaveLeaseRentPremium',
            success: function (result) {
                if (result == '@ReturnType.Saved' || result == '@ReturnType.Updated') {
                    ClearLeaseRentFields();
                    ClearBasicInfo();
                    //ClosePopupWindow();
                    $('#gridLeaseDeedDdetails').data("kendoGrid").dataSource.read();
                    alertify.success("Data saved successfully.");
                }
                else if (result == '@ReturnType.Exist') {
                    //ClosePopupWindow();
                    alertify.error("Data already exists for this rid.");
                }
                else if (result == '@ReturnType.None') {
                    //ClosePopupWindow();
                    alertify.error("Data not exists for this rid.");
                }
            },
            error: function (ajaxRequest, strError) {
                alertify.error("Network error, try again later");
            }
        });
    }

    function GetCalculatedLeaseRent() {
        $.ajax({
            type: "post",
            dataType: "json",
            contentType: "application/json;charset=utf-8",
            data: JSON.stringify({ RegistrationId: $('#RegistrationId').val() }),
            url: '@Url.Action("CalculateLeaseRentPremium", "Payment", new { area = "Revenue" })',
            success: function (result) {
                if (result != null) {
