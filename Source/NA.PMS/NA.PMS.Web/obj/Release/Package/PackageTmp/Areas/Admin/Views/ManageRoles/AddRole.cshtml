@model NA.PMS.Model.RolesModel
@using Kendo.Mvc.UI;

@{
    ViewBag.Title = "Add Role";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("AddRole", "ManageRoles", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
        <div class="row">
            <div class="col-md-12">
                <div class="row rw-spce">
                    <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Add Role</h1></div>
                    <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
                </div>
            </div>
            <div class="col-md-12 blnk-rw"></div>
            <div class="col-md-12 content-top-spce">
                <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <h2 class="blck-heading">Role Information</h2>
                    <div class="form-bx">
                        <div class="row">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @Html.HiddenFor(model => model.ApplicationId, new { @id = "hdnApplicationId", @name = "hdnApplicationId" })
                            @Html.HiddenFor(model => model.ApplicationName, new { @id = "hdnApplicationName", @name = "hdnApplicationName" })
                            @Html.HiddenFor(model => model.ViewName)
                        </div>
                        <div class="row">
                            <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                                @Html.LabelFor(model => model.ApplicationName, htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                                @(Html.Kendo().DropDownListFor(model => model.ApplicationId)
                                      .Name("applications")
                                      .DataTextField("ApplicationName")
                                      .DataValueField("ApplicationId")
                                      .OptionLabel("Select")
                                      .DataSource(source =>source.Read(read =>read.Action("GetApplications", "ManageRoles")))
                                      .HtmlAttributes(new { style = "width:100%;" })
                                      .Events(e => e.Select("SetSelectedValue"))
                                )
                                @*@Html.ValidationMessageFor(model => model.applications, "", new { @class = "text-danger" })*@
                            </div>

                            <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                                <span id="appID" class="text-danger">Please select an application. </span>
                            </div>
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">

                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                                @Html.LabelFor(model => model.RoleName, htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(model => model.RoleName, new { @class = "form-control", @maxlength = "100" })
                                @Html.ValidationMessageFor(model => model.RoleName, "", new { @class = "text-danger" })                              
                            </div>
                            <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                                <span id="rolename" class="text-danger">Please enter role name. </span>
                                <span id="duplicateroles" class="text-danger">Role Name already exists.</span>
                            </div>
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">

                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                                <label>Role In Department</label>
                            </div>
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                               @(Html.Kendo().DropDownListFor(m=>m.RoleInDepartment)
                                  .DataTextField("Text")
                                  .DataValueField("Value")
                                  .OptionLabel("---select---")
                                  .BindTo(new List<SelectListItem>() {
                                      new SelectListItem() { Text = "Assistant", Value = "Assistant" },
                                      new SelectListItem() { Text = "Accountant", Value = "Accountant" },
                                      new SelectListItem() { Text = "Accounts Officer", Value = "AccountsOfficer" }
                                  })
                                  .HtmlAttributes(new { style = "width: 100%" })
                            )
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                                @Html.LabelFor(model => model.RoleDescription, htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                                @Html.TextAreaFor(model => model.RoleDescription, new { @class = "form-control", @maxlength = "500" })
                                @Html.ValidationMessageFor(model => model.RoleDescription, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                                <span id="reledescription" class="text-danger">Please enter role description. </span>
                            </div>
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">

                            </div>
                        </div>
                    </div>
                </div>
                <div class="box-button text-center">
                    <input type="button" id="btnCancel" value="Cancel" class="btn btn-default" onclick="javascript: window.location = '@Url.Action("ManageRoles", "ManageRoles")';" />
                    <input type="submit" value="Add" id="btnSubmit" class="btn btn-add" onclick="return ValidateApplication()" />
                </div>
            </div>
        </div>
    </div>
}

<script type="text/javascript">
    function SetSelectedValue(e) {
        var dataItem = this.dataItem(e.item.index() + 1);
        if (dataItem.ApplicationId != "") {
            $("#hdnApplicationId").val(dataItem.ApplicationId);
            $("#hdnApplicationName").val(dataItem.ApplicationName);
        }
        HideShowMessage();
    }

    $(document).ready(function () {
        HideShowMessage();
        $("#rolename").hide();
        $("#reledescription").hide();
        $("#duplicateroles").hide();
        $("#RoleName").blur(function () {
            if ($("#RoleName").val().trim() != "") {
                $("#rolename").hide();
            }
            GetApplicantDetails();
        });
        $("#RoleDescription").blur(function () {
            if ($("#RoleDescription").val().trim() != "") {
                $("#reledescription").hide();
            }
        });
        $("#ViewName").val("AddRole");
    });

    function HideShowMessage() {
        $("#appID").hide();
    }

    function ValidateApplication() {
        var flag = false;
        var flag1 = false;
        var flag2 = false;

        var rolename = $("#RoleName").val().trim();
        var roledesc = $("#RoleDescription").val().trim();
        var apps = $("#applications").val();

        if (apps == "") {
            $("#appID").show();
            flag2 = false;
        }
        else {
            $("#appID").hide();
            flag2 = true;
        }

        if (rolename == "") {
            $("#rolename").show();
            flag = false;
        }
        else {
            $("#rolename").hide();
            flag = GetApplicantDetails();
        }       
        if (roledesc == "") {
            $("#reledescription").show();
            flag1 = false;
        }
        else {
            $("#reledescription").hide();
            flag1 = true;
        }
        if (flag && flag1 && flag2) {
            return true;
        }
        else { return false; }
    }

    var appflag = true;
    function GetApplicantDetails() {
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ roleName: $("#RoleName").val().trim(), applicationId: $("#hdnApplicationId").val().trim() }),
            url: "/ManageRoles/IsRoleNameUnique",
            success: function (data) {
                if (data == true) {
                    appflag = false;
                    $("#duplicateroles").show();
                }
                else {
                    appflag = true;
                    $("#duplicateroles").hide();
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                appflag = false;
                //alert(respText);
            }
        });
        return appflag;
    }

    $('#RoleName').blur(function(){
        $('#RoleName').val($('#RoleName').val().trim());
    });

    $('#RoleDescription').blur(function(){
        $('#RoleDescription').val($('#RoleDescription').val().trim());
    });

</script>