<div class="ApplicationForm">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-3 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Applications</h1></div>
            <div class="col-md-9 col-sm-12 col-xs-12 col-btn">
                @*<a href="#" id="btnAddCompany" class="" onclick="javascript:UpdateAddress(event);">Update Address</a>*@
                <a href="#" id="btnDownloadFormat" class="">Download Format</a>
                <a href="#" id="btnAddCompany" class="" onclick="javascript:AddCompanyDetails(event);">Add Company Details</a>
                <a href="#" id="btnDrawSlipPopup" class="" onclick="javascript:GenerateDrawSlip(event);">Generate Draw slip</a>
                <a href="#" style="display:none" id="btnPersonalInformation" class="" onclick="javascript:UpdatePersonalInformation(event);">Update Personal Information</a>
                <a href="#" id="btnBulkApplication" class="" onclick="javascript:AddBulkApplication(event);">Bulk Application</a>
                <a href="#" id="btnAddApplication" class="" onclick="javascript:AddApplication(event);">New Allotment Application</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<ApplicationFormModel>()
                .Name("gvApplications")
                .ToolBar(tools => tools.Excel())
                .Excel(excel => excel.FileName("ServiceRequestList.xlsx").ProxyURL(Url.Action("Excel_Export_Save", "Allotment")).AllPages(true).Filterable(true))
                .Columns(columns =>
                {
                    columns.Bound(c => c.ApplicationId).Visible(false);
                    columns.Bound(c => c.EncryptedAppId).Visible(false);
                    columns.Bound(c => c.BankId).Visible(false);
                    columns.Bound(c => c.RID).Title("RID").Width(110);
                    if (@ViewBag.ReadOnlyMenu != null && @ViewBag.ReadOnlyMenu == true)
                    {
                        columns.Bound(c => c.FormNo).Title("Form No").Width(110).ClientTemplate("<a href='/Property/Allotment/ViewApplicationForm/#=EncryptedAppId#'>#=FormNo#</a>").Sortable(false);
                    }
                    else
                    {
                        columns.Bound(c => c.FormNo).Title("Form Number").Width(120);
                    }

                    columns.Bound(c => c.SchemeName).Title("Scheme").ClientTemplate("<a href='/Master/Scheme/ViewScheme/#= EncodedParameter #'>#= SchemeName #</a>");
                    columns.Bound(c => c.DepartmentName).Title("Department").Width(130).Sortable(false);
                    columns.Bound(c => c.FirstName).Title("Applicant");
                    columns.Bound(c => c.MobileNumber).Title("Mobile No").Width(120).Sortable(false);
                    columns.Bound(c => c.Status).Title("Status").Width(100);
                    if (@ViewBag.EditMenuVal != null && @ViewBag.EditMenuVal == true)
                    {
                        // online applcation Bank Id  = 4
                        columns.Bound(c => c.ApplicationId).Title("Edit").Width(100).ClientTemplate("# if (IsAllotted != 1 && SchemeStatus != 26 && BankId != 4) { # <a class='gridEdit' href='" + "/Property/Allotment/EditApplicationForm/#= EncryptedAppId #'>Edit </a> # } else {#<span class='gridNotEdit'>Edit</span>#} #").Filterable(false);
                    }
                    else
                    {
                        columns.Bound(c => c.ApplicationId).Title("Edit").Width(100).ClientTemplate("Edit").Filterable(false);
                    }
                })
                .Sortable().Filterable()
                .Events(e => e.DataBound("onDataBound"))
                //.ToolBar(toolBar =>
                //    {
                //        toolBar.Custom().Text("<i class='fa fa-plus-square' aria-hidden='true'></i> Add Application").HtmlAttributes(new { onclick = "javascript:AddApplication(event);", @class = "k-button k-right", id = "btnAddApplication" });
                //        toolBar.Custom().Text("<i class='fa fa-plus-square' aria-hidden='true'></i> Bulk Application").HtmlAttributes(new { onclick = "javascript:AddBulkApplication(event);", @class = "k-button", id = "btnBulkApplication" });
                //        toolBar.Custom().Text("<i class='fa fa-plus-square' aria-hidden='true'></i> Update Personal Information").HtmlAttributes(new { onclick = "javascript:UpdatePersonalInformation(event);", @class = "k-button", id = "btnPersonalInformation" });
                //    }
                // )
                .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                .Groupable()
                .DataSource
                (
                     dataSource => dataSource
                    .Ajax().ServerOperation(true)
                    .Model(model => model.Id(p => p.FormNo))
                    .Sort(x => x.Add("FormNo").Descending())
                    .Read(read => read.Action("GetAllApplications", "Allotment")).PageSize(20)
                 ).AutoBind(false)
        )
    </div>
</div>

