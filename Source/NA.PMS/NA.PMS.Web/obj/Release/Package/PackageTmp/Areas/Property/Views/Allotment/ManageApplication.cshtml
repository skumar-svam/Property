<div id="divDrawSlip" class="col-md-12">
    <div class="col-md-11 col-sm-12 col-xs-12 col-md-offset-1" style="padding-top:20px;">
        <div class="row">
            <div class="col-md-5 col-sm-12 col-xs-12 form-group">
                @Html.Label("Scheme Name")
                @(Html.Kendo().DropDownList()
                      .Name("DrawSchemeId")
                      .DataTextField("schemeName")
                      .DataValueField("schemeId")
                      .OptionLabel(" -- Please Select --")
                      .DataSource(source => source.Read(read => read.Action("GetSchemeListForAllotment", "PropertyAllotment")))
                      .Enable(true)
                      .AutoBind(true)
                      .HtmlAttributes(new { style = "width: 100%; height:100%" })
                )
            </div>
            <div class="col-md-5 col-sm-12 col-xs-12 col-md-offset-1 form-group">
                @Html.Label("Department")
                @(Html.Kendo().DropDownList()
                      .Name("DrawDepartmentId")
                      .DataTextField("DepartmentName")
                      .DataValueField("DepartmentId")
                      .OptionLabel(" -- Please Select --")
                      .DataSource(source => source.Read(read => read.Action("FilterDepartmentOnScheme", "PropertyAllotment").Data("FilterDepartment"))
                                                          .ServerFiltering(true))
                      .Enable(false)
                      .AutoBind(false)
                      .CascadeFrom("DrawSchemeId")
                      .HtmlAttributes(new { style = "width: 100%; height:100%" })
                )
            </div>
        </div>
        <div class="row" style="padding-top:20px">
            <div class="col-sm-4">
                @Html.CheckBox("Applicant", htmlAttributes: new { @id = "chkApplicant" })
                @Html.Label("Applicant Name", htmlAttributes: new { @id = "" })
            </div>
            <div class="col-sm-4">
                @Html.CheckBox("FormNumber", htmlAttributes: new { @id = "chkFormNo" })
                @Html.Label("Form Number")
            </div>
            <div class="col-sm-4">
                @Html.CheckBox("Mobile Number", htmlAttributes: new { @id = "chkMobile" })
                @Html.Label("Mobile Number")
            </div>
        </div>
        <div class="row">
            <div class="col-sm-4">
                @Html.CheckBox("FatherName", htmlAttributes: new { @id = "chkFatherName" })
                @Html.Label("Father's Name")
            </div>
            @*<div class="col-sm-4">
                    @Html.CheckBox("MotherName", htmlAttributes: new { @id = "chkMotherName" })
                    @Html.Label("Mother's Name")
                </div>*@
            @*<div class="col-sm-4">
                    @Html.CheckBox("PAN Number", htmlAttributes: new { @id = "chkPan" })
                    @Html.Label("PAN Number")
                </div>*@
        </div>
        <div class="row">
            <div class="col-md-11">
                <div class="box-button-popup text-center">
                    <input type="button" id="btnKendoPopupClose" value="Close" class="btn btn-default" />
                    <input type="button" value="Generate Draw Slip" id="btnGenerateDrawSlip" class="btn btn-add" />
                </div>
            </div>
        </div>

    </div>

</div>

<div id="divPrintDrawSlip" class="col-md-10">
    <div class="form-bx" style="overflow:auto;height:85%;">
        <div id="divPrintSlip" style="width:90%;"></div>
    </div>
    <div class="box-button text-center">
        <input type="button" id="btnPrintKendoPopupClose" value="Close" class="btn btn-default" />
        <input type="button" value="Generate Draw Slip" id="btnPrintGenerateDrawSlip" onclick="PrintDiv()" class="btn btn-add" />
    </div>
</div>

<div id="divDrawSlipModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 60%">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Generate Draw slip</b></h4>
            </div>
            <div class="modal-body" id="divDrawSlipBody" style="overflow:auto;height:420px;">

            </div>
            <div style="page-break-after: always;"></div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv();">Print</button>
            </div>
        </div>
    </div>
</div>
