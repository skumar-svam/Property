    function ShowPrintDrawSlipWindow() {
        var win = $("#divPrintDrawSlip").data("kendoWindow");
        win.center();
        win.open();
    }
    $('#btnGenerateDrawSlip').click(function () {
        var scheme = $('#DrawSchemeId').val();
        var department = $('#DrawDepartmentId').val();
        if (scheme != "" && department != "") {
            var checkedField = [];
            var uncheckedField = [];
            $("input:checkbox").each(function () {
                if ($(this).is(":checked")) {
                    checkedField.push($(this).attr("id"));
                } else {
                    uncheckedField.push($(this).attr("id"));
                }
            });
            //alert(checkedField);
            if (checkedField.length >= 2) {
                $.ajax({
                    type: "post",
                    dataType: "json",
                    contentType: "application/json;charset=utf-8",
                    data: JSON.stringify({ schemeId: $('#DrawSchemeId').val(), departmentId: $('#DrawDepartmentId').val(), nameList: checkedField }),
                    url: '/DocParser/PrintDrawSlipForAuthority',
                    success: function (result) {
                        if (result != "0") {
                            $("#divDrawSlip").data("kendoWindow").close();
                            $("#divDrawSlipBody").html(result);
                            $("#divDrawSlipModal").modal('show');
                            DoUncheckBox();
                        }
                        else {
                            alertify.error("Application form is not available");
                        }
                    },
                    error: function (ajaxRequest, strError) {
                        //alert(ajaxRequest.responseText);
                        alertify.error("Something is wrong, try again later");
                    }
                });
            }
            else {
                alertify.error("Please select atleast two checkboxes.");
            }
        }
        else {
            alertify.error("Please select Scheme and Department");
        }
    });

    function DoUncheckBox() {
        $('#chkApplicant').prop('checked', false);
        $('#chkMobile').prop('checked', false);
        $('#chkFormNo').prop('checked', false);
        $('#chkFatherName').prop('checked', false);
        $('#chkMotherName').prop('checked', false);
        $('#chkPan').prop('checked', false);
    }

