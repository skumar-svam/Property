@using NA.PMS.Common;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions


<div class="panel-body">
    <div class="row form-group">
        <div class="col-md-12" id="Application" style="text-align:center">
            <input type="radio" name="arearange-action" value="AddAreaRange" />Add &nbsp;&nbsp;
            <input type="radio" name="arearange-action" value="UpdateAreaRange" />Update
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-3 col-sm-12 form-group col-20">
            <label>Department</label>
        </div>
        <div class="col-md-3 col-sm-12 form-group col-30">
            @(Html.Kendo().DropDownList()
                .Name("ddlARDepartment")
                .OptionLabel("---select---")
                .DataTextField("Text")
                .DataValueField("Id")
                //.DataSource(source => source.Read(read => read.Action("GetDepartmentList", "Application", new { area = "Admin" })))
                .DataSource(source =>
                {
                    source.Custom()
                    .ServerFiltering(true)
                    .ServerPaging(true)
                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                    .Transport(transport => transport.Read(read => read.Action("GetMasterDataDropDownListAsDataSource", "Organization", new { area = "Admin" }).Data("FilterDepartment")))
                    .Schema(schema => schema.Data("Data").Total("Total"))
                    .PageSize(100);
                })
                .HtmlAttributes(new { style = "width:100%;" })
            )
        </div>
        <div class="col-md-3 col-sm-12 form-group col-20">
            <label>Category</label>
        </div>
        <div class="col-md-3 col-sm-12 form-group col-30">
            <input type="text" maxlength="30" id="txtAreaCategory" class="k-textbox" style="width:100%;"/>
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-3 col-sm-12 form-group col-20">
            <label>Ex Area Range:</label>
        </div>
        <div class="col-md-3 col-sm-12 form-group col-30">
            @(Html.Kendo().DropDownList()
                .Name("ddlAreaRange")
                .OptionLabel("---select---")
                .DataTextField("Text")
                .DataValueField("Id")
                .CascadeFrom("ddlARDepartment")
                .CascadeFromField("DepartmentId")
                //.DataSource(source => source.Read(read => read.Action("GetAreaRangeList", "Application", new { area = "Admin" }).Data("FilterARDepartment")).ServerFiltering(true))
                .DataSource(source =>
                {
                    source.Custom()
                    .ServerFiltering(true)
                    .ServerPaging(true)
                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                    .Transport(transport => transport.Read(read => read.Action("GetMasterDataDropDownListAsDataSource", "Organization", new { area = "Admin" }).Data("FilterAreaRange")))
                    .Schema(schema => schema.Data("Data").Total("Total"))
                    .PageSize(100);
                })
                .HtmlAttributes(new { style = "width:100%;" })
            )
        </div>
        <div class="col-md-3 col-sm-12 form-group col-20">
            <label>New Area Range:</label>
        </div>
        <div class="col-md-3 col-sm-12 form-group col-30">
            <input type="text" maxlength="8" id="txtAreaRange" class="k-textbox" style="width:100%;"/>
        </div>
    </div>
    <div class="row form-group" style="text-align:right;">
        <div class="col-md-12">
            <input type="button" id="btn-save-area-range" class="k-button" value="Update" style="min-width:80px;" />
            <input type="button" id="btn-clear-area-range" class="k-button" value="Clear" style="min-width:80px;" />
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        $('input[type="radio"][name="arearange-action"]').on("change", function () {
            var action = $('input[type="radio"][name="arearange-action"]:checked').val();
            if (action == "AddAreaRange") {
                $('#btn-save-area-range').val("Add");
                //$('#ddlApplication').data("kendoDropDownList").value('');
                //$('#ddlApplication').data("kendoDropDownList").enable(false);
            }
            else {
                $('#btn-save-area-range').val("Update");
                //$('#ddlApplication').data("kendoDropDownList").enable(true);
            }
        });

        $('#btn-save-area-range').click(function () {
            SubmitAreaRangeForm();
        });

        $('#btn-clear-area-range').click(function () {
            ClearAreaRangeFields();
        });
    });


    function FilterDepartment() {
        return {
            FilterType: "Department",
            MasterData: "Department"
        }
    }

    function FilterAreaRange() {
        return {
            FilterType: "AreaRange",
            MasterData: "AreaRange",
            DepartmentId: $('#ddlARDepartment').val()
        }
    }

    function SubmitAreaRangeForm() {
        var flag = true;
        var actiontype = $('input[type="radio"][name="arearange-action"]:checked').val();
        var departmentId = $('#ddlARDepartment').data("kendoDropDownList").value();
        var category = $('#txtAreaCategory').val();
        var areaRangeId = "";
        var arearange = $('#txtAreaRange').val();
        if (actiontype == "" || actiontype == undefined) {
            flag = false;
            alertify.error("Select Action type.");
            return false;
        }
        if (departmentId == "") {
            flag = false;
            alertify.error("Select Department.");
            return false;
        }
        //if (category == "") {
        //    flag = false;
        //    alertify.error("Enter Category.");
        //    return false;
        //}
        if (actiontype == "AddAreaRange") {
            if (arearange == "") {
                alertify.error("Enter Area Range");
                flag = false;
            }
            actiontype = "Save";
        }
        if (actiontype == "UpdateAreaRange") {
            areaRangeId = $('#ddlAreaRange').data("kendoDropDownList").value();
            if (areaRangeId == "") {
                alertify.error("Select existing Area Range");
                flag = false;
            }
            else if (arearange == "") {
                alertify.error("Enter Property Area Range");
                flag = false;
            }
            actiontype = "Update";
        }
        if (flag) {
            var RangeModel = {
                MasterData: "AreaRange",
                FilterType: "AreaRange",
                ActionType: actiontype,
                DepartmentId: $('#ddlARDepartment').data("kendoDropDownList").value(),
                Category: category,
                //AreaType: category,
                AreaRange: $('#txtAreaRange').val(),
                AreaRangeId: $('#ddlAreaRange').data("kendoDropDownList").value()
            };
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ model: RangeModel }),
                url: '/Admin/Organization/GetMasterDataInfoByType',
                success: function (result) {
                    if (result.ReturnTypeId == '@ReturnType.Success') {
                        alertify.success("Area Range saved successfully.");
                        ClearAreaRangeFields();
                        $('#ddlAreaRange').data("kendoDropDownList").dataSource.read();
                    }
                    else if (result == '@ReturnType.None') {
                        alertify.error("Area Range doesn't exist.");
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Network error, try again");
                }
            });
        }
    }

    function ClearAreaRangeFields() {
        $('#ddlAreaRange').data("kendoDropDownList").value('');
        $('#txtAreaCategory').val('');
        $('#txtAreaRange').val('')
    }

</script>
