@using Kendo.Mvc.UI
@{
    ViewBag.Title = "Manage GPA";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*<style>
        #btnRequest {
            float: right;
        }

        .linkCss {
            color: #337ab7;
            text-decoration: underline;
        }

            .linkCss:hover {
                color: #337ab7;
                cursor: pointer;
                text-decoration: underline;
            }
