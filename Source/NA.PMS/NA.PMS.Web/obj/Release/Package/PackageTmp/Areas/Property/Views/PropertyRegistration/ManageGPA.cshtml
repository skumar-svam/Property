<div class="ApplicationForm">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage GPA/NOMINEE</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                <a href="#" id="btnRequest" class="" onclick="javascript:AddGPA(event);">Add Request</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.Model.GPAModel>()
        .Name("gridGPA")
        .Columns(columns =>
        {
            columns.Bound(c => c.RId).Title("Registration Id").Width(130).ClientTemplate("<a href='" + "/Property/PropertyRegistration/ViewGPA/" + "?RId=#= RId #&Type=#=GPAType#'" + ">#=RId#</a>");
            //columns.Bound(c => c.GPAId).Title("GPA ID").Width(40);
            columns.Bound(c => c.IsActive).Hidden(true);
            columns.Bound(c => c.GPAType).Title("Type");
            columns.Bound(c => c.DepttName).Title("Department");
            columns.Bound(c => c.SectorName).Title("Sector");
            columns.Bound(c => c.BlockName).Title("Block");
            columns.Bound(c => c.PropertyNo).Title("Property No");
            //columns.Bound(c => c.PropNo).Title("Property No").Width(50);
            columns.Bound(c => c.EffectiveFrom).Title("Effective From").Format("{0:dd/MM/yyyy}");
            columns.Bound(c => c.EffectiveTo).Title("Effective To").Format("{0:dd/MM/yyyy}");
            columns.Bound(c => c.NominationDate).Title("Nomination Date").Format("{0:dd/MM/yyyy}");
            columns.Bound(c => c.GPAId).Title("Action").ClientTemplate("<a href='" + "/Property/PropertyRegistration/EditGPA/" + "?RId=#= RId #&Type=#=GPAType#'" + ">Edit</a>").Filterable(false).Sortable(false);
            // columns.Bound(c => c.GPAId).Title("Deactivate").Width(170).ClientTemplate("#if(IsActive == true && GPAType == 'GPA'){#  <a onclick='javascript:ActivateDeactivateToggle(this);' class='linkCss'><i class='fa fa-lock' aria-hidden='true'></i> Deactivate</a> #} #").Width(35).Filterable(false).Sortable(false);
        })
        .Sortable()
        .Filterable()
                .Resizable(resize => resize.Columns(true))
                //.ToolBar(toolBar =>
                //{
                //    toolBar.Custom().Text("<i class='fa fa-plus-square' aria-hidden='true'></i> Add Request").HtmlAttributes(new { onclick = "javascript:AddGPA(event);", @class = "k-button", id = "btnRequest" });
                //})
        .Pageable(pageable => pageable
                                               .Enabled(true)
                                               .Refresh(true)
                                               .PageSizes(true)
                                            )
        .DataSource(dataSource => dataSource
        .Ajax().Model(model => model.Id(c => c.RId))
        .ServerOperation(true)
                .Sort(sort => sort.Add("CreatedDate").Descending())
                .Read(read => read.Action("GetAllGPAData", "PropertyRegistration")).PageSize(20)
        )
        )
    </div>
</div>

<script type="text/javascript">
    function AddGPA(event) {
        event.preventDefault();
        window.location.href = '@Url.Action("AddGPA", "PropertyRegistration")';
    }

    function ActivateDeactivateToggle(row) {
        var tr = $(row).parent().parent();
        var id = $(tr).children("td:eq(1)").text();
        var isActive = $(tr).children("td:eq(2)").text();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ id: id, isActive: isActive }),
            url: '/PropertyRegistration/ActivateDeactivateToggle',
            success: function (result) {
                if (result == true) {
                    $("#gridGPA").data("kendoGrid").dataSource.read();
                    alertify.success("Data updated successfully.");
                }
                else
                    alertify.error("Some error occured. Please try again later.");
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alertify.error("Some error occured. Please try again later.");
                //alert(respText);
            }
        });
    }
</script>

