@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
@using NA.PMS.Common;
@model NA.PMS.Model.PaymentViewModel

@{
    ViewBag.Title = "Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    #gridPayment {
        padding: 0;
    }

    .k-widget.k-window {
        padding: 0;
    }

    .k-window-content.k-content {
        padding: 0;
    }

    .k-window-titlebar.k-header {
        background: #299a8b;
        color: #ffffff;
        border-radius: 0;
    }

    .float-right {
        float:right;
    }
    .form-group{
        margin-bottom:8px;
    }
    .k-numerictextbox{
        float:right;
    }
    .remove-temp-receipt{
        cursor:pointer;
        color:red;
    }
    .btn-remove-receipt{
        display:none;
    }
</style>

<div class="col-lg-12 col-md-12 col-sm-12">
    <div class="row form-group rw-spce">
        <div class="col-sm-8"><h1 class="gridTitle">Payment</h1></div>
        <div class="col-sm-4 col-btn">
            @Html.ActionLink("Show Payment", "PaymentList", new { Controller="Payment",area="Revenue"}, htmlAttributes: new { @target="_blank"})            
        </div>
    </div>

    <div class="col-md-12 blnk-rw"></div>

    @using (Html.BeginForm("SaveMiscellaneousPayment", "Payment", FormMethod.Post, new { enctype = "multipart/form-data", id = "PaymentForm" }))
    {
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading" style="margin-bottom:8px;">Add Payment</h2>
            <div class="form-bx">
                <div class="row">
                    @Html.HiddenFor(model => model.AllotteeName)
                    @Html.HiddenFor(model => model.FirstName)
                    @Html.HiddenFor(model => model.MiddleName)
                    @Html.HiddenFor(model => model.LastName)
                    @Html.HiddenFor(model => model.SectorId)
                    @Html.HiddenFor(model => model.SectorName)
                    @Html.HiddenFor(model => model.BlockId)
                    @Html.HiddenFor(model => model.BlockName)
                    @Html.HiddenFor(model => model.PlotNo)
                    @Html.HiddenFor(model => model.DepartmentName)
                    @Html.HiddenFor(model => model.PropertyId)
                    @Html.HiddenFor(model => model.PropertyNo)
                    @Html.HiddenFor(model => model.PropertyRegistryId)
                    @Html.HiddenFor(model => model.BankName)
                    @*@Html.HiddenFor(model => model.ReceiptId, htmlAttributes: new { @id="hdn-receipt-id"})*@
                </div>
                <div class="row form-group">
                    <div class="col-md-3 col-sm-12 col-xs-12  ">
                        <label>Registration Id:</label>
                        @(Html.Kendo().DropDownListFor(model => model.RegistrationId)
                              .DataTextField("Text")
                              .DataValueField("Id")
                              .OptionLabel(" ---select---")
                              .Filter("contains")
                              .AutoBind(true)
                              .Enable(true)
                              .DataSource(source =>
                                {
                                    source.Custom()
                                    .ServerPaging(true)
                                    .ServerFiltering(true)
                                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                    .Transport(transport => transport.Read(read => read.Action("GetRegistrationIdList", "Payment", new { Area = "Revenue" })))
                                    .Schema(schema => schema.Data("Data").Total("Total"))
                                    .PageSize(100);
                                })
                              .HtmlAttributes(new { style = "width:90%; float:right" })
                              .Events(e => e.Change("GetAllottedPropertyDetails"))
                        )
                    </div>
                    <div class="col-md-3 col-sm-12 col-xs-12 ">
                        <label>Department:</label>
                       @(Html.Kendo().DropDownListFor(model => model.DepartmentId)
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel(" --- select ---")
                            .Filter("contains")
                            .AutoBind(true)
                            .Enable(true)
                            .DataSource(source => source.Read(read => read.Action("GetDepartmentList", "Payment", new { area = "Revenue" })))
                            .HtmlAttributes(new { style = "width:90%; float:right;" })
                        )
                    </div>
                    <div class="col-md-6 col-sm-12 col-xs-12  ">
                        <label>Applicant's Name</label>
                        @Html.TextAreaFor(model => model.Applicant, htmlAttributes: new { @class="form-control",@readonly="readonly", style="width:95%;float:right;height:30px;"})
                    </div>
                </div>
                <div class="row form-group"> 
                    <div class="col-md-3 col-sm-12 col-xs-12">
                        <label>Receipt Id</label>
                        @Html.TextBoxFor(model => model.ReceiptId, new { @class = "form-control integer-only text-right",@minlength="12", @maxlength = "12", style = "width:90%;float:right;" })                       
                    </div>                
                    <div class="col-md-3 col-sm-12 col-xs-12">
                        <label>Receipt Head</label>
                        @(Html.Kendo().DropDownListFor(model => model.ReceiptHeadId)
                              .DataTextField("Text")
                              .DataValueField("Id")
                              .OptionLabel(" -- Select --")
                              .Filter("contains")
                              .AutoBind(true)
                              .Enable(true)
                              .DataSource(source =>
                                {
                                    source.Custom()
                                    .ServerPaging(true)
                                    .ServerFiltering(true)
                                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                    .Transport(transport => transport.Read(read => read.Action("GetPaymentTypeList", "Payment", new { Area = "Revenue" })))
                                    .Schema(schema => schema.Data("Data").Total("Total"))
                                    .PageSize(100);
                                })
                              .HtmlAttributes(new { style = "width:90%; float:right;" })
                        )
                    </div>
                    <div class="col-md-3 col-sm-12 col-xs-12 ">
                        <label>Receipt Sub Head</label>
                        @(Html.Kendo().DropDownListFor(model => model.ReceiptSubHeadId)
                              .DataTextField("Text")
                              .DataValueField("Id")
                              .OptionLabel(" -- Select --")
                              .Filter("contains")
                              .AutoBind(true)
                              .Enable(true)
                              .DataSource(source =>
                                {
                                    source.Custom()
                                    .ServerPaging(true)
                                    .ServerFiltering(true)
                                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                    .Transport(transport => transport.Read(read => read.Action("GetPaymentSubTypeList", "Payment", new { Area = "Revenue" }).Data("FilterPaymentType")))
                                    .Schema(schema => schema.Data("Data").Total("Total"))
                                    .PageSize(100);
                                })
                              .CascadeFrom("ReceiptHeadId")
                              .HtmlAttributes(new { style = "width:90%; float:right;" })
                        )
                    </div>
                    
                    <div class="col-md-3 col-sm-12 col-xs-12 ">
                        <label>Amount</label>
                        @(Html.Kendo().NumericTextBoxFor(m => m.Amount)
                            .Min(0).Max(99999999999999).Spinners(false).Step(0).Enable(true)
                            .HtmlAttributes(new { style = "width: 90%;", @maxlength = "12", @class = "text-right", @placeholder = "" })
                        )
                    </div>
                    
                </div>
                <div class="row form-group">
                    <div class="col-md-3 col-sm-12 col-xs-12 ">
                        <label>Challan Id</label>
                        @Html.TextBoxFor(model => model.ChallanId, new { @class = "form-control", @maxlength = "12", style = "width:90%;float:right;" })
                    </div>
                    <div class="col-md-3 col-sm-12 col-xs-12   ">
                        <label>Bank Name</label>
                        @(Html.Kendo().DropDownListFor(model => model.BankId)
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel(" -- Select --")
                            .Filter("contains")
                            .AutoBind(true)
                            .Enable(true)
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerPaging(true)
                                .ServerFiltering(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => transport.Read(read => read.Action("GetBankNamesForPayment", "Payment", new { Area = "Revenue" })))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(100);
                            })
                            .HtmlAttributes(new { style = "width:90%; float:right;" })
                            .Events(e => e.Change("SelectBankNameEvent"))
                        )
                    </div>
                    <div class="col-md-3 col-sm-12 col-xs-12  ">
                        <label>Entry Date</label>
                        @(Html.Kendo().DatePickerFor(model => model.EntryDate).HtmlAttributes(new { style = "width: 90%; float:right;", @class = "input-disabled" }))
                    </div>
                    <div class="col-md-3 col-sm-12 col-xs-12  ">
                        <label>Deposit Date</label>
                        @(Html.Kendo().DatePickerFor(model => model.DepositDate).HtmlAttributes(new { style = "width: 90%; float:right;", @class = "input-disabled" }))
                    </div>
                                      
                </div>
                <div class="row form-group">       
                    <div class="col-md-6 col-sm-12 col-xs-12 ">
                        <label>Depositor's Name</label>
                        @Html.TextBoxFor(model => model.DepositorName, new { @class = "form-control", @maxlength = "100", style = "width:95%;float:right;" })
                    </div>
                    <div class="col-md-6 col-sm-12 col-xs-12 ">
                        <label>Depositor's Address</label>
                        @Html.TextAreaFor(model => model.DepositorAddress, new { @class = "form-control", @maxlength = "200", style = "width:95%;float:right;height:30px;" })
                    </div>
                    
                </div> 
                <div class="row form-group">
                    <div class="col-md-3 col-sm-12 col-xs-12  ">
                        <label>Receipt Id:</label>
                        @(Html.Kendo().DropDownList()
                              .Name("DDLReceiptId")
                              .DataTextField("Text")
                              .DataValueField("ReceiptId")
                              .OptionLabel(" ---select---")
                              .Filter("contains")
                              .AutoBind(true)
                              .Enable(true)
                              .DataSource(source =>
                                {
                                    source.Custom()
                                    .ServerPaging(true)
                                    .ServerFiltering(true)
                                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                    .Transport(transport => transport.Read(read => read.Action("GetReceiptHeadIdListAsDataSource", "Finance", new { Area = "Revenue" }).Data("FilterRegistrationId")))
                                    .Schema(schema => schema.Data("Data").Total("Total"))
                                    .PageSize(100);
                                })
                              .CascadeFrom("RegistrationId")
                              .HtmlAttributes(new { style = "width:90%; float:right" })
                              .Events(e => e.Change("ReceiptIdChangeEvent"))
                        )
                    </div>
                    <div class="col-md-3 col-sm-12 col-xs-12">
                        <label>Total Amount</label>
                        @(Html.Kendo().NumericTextBoxFor(m => m.TotalAmount)
                            .Min(0).Max(99999999999999).Spinners(false).Step(0).Enable(true)
                            .HtmlAttributes(new { style = "width: 90%;", @maxlength = "18", @class = "text-right", @placeholder = "" })
                        )
                    </div>
                    <div class="col-md-3 col-sm-12 col-xs-12" style="text-align:center;">
                        <input type="button" class="k-button btn-remove-receipt" value="Remove Challan From This Property" style="min-width:100px;margin-top:25px;" />
                    </div>
                    <div class="col-md-3 col-sm-12 col-xs-12" style="text-align:right;">
                        <input type="button" class="k-button btn-save-temp-data" value="Add Amount" style="min-width:100px;margin-top:25px;" />
                    </div>
                </div>                       
            </div>

            <div class="col-md-12 k-grid-content" id="div-temp-receipt">
                @(Html.Kendo().Grid<NA.PMS.Model.PaymentViewModel>()
                .Name("TempReceiptGrid")
                //.ToolBar(t => t.Template("<button class='k-button'>Remove All</button>"))
                .Columns(columns =>
                {
                    columns.Bound(c => c.SerialNo).Title("SNo").Width(50);
                    columns.Bound(c => c.RegistrationId).Title("RegistrationId").Width(115);
                    //columns.Bound(c => c.EntryDate).Title("Deposit Date").Format("{0:dd-MMM-yyyy}");
                    //columns.Bound(c => c.DepositDate).Title("Clearing Date").Format("{0:dd-MMM-yyyy}");
                    columns.Bound(c => c.ReceiptHead).Title("Receipt Head");
                    columns.Bound(c => c.ReceiptSubHead).Title("Receipt Sub Head").ClientFooterTemplate("<div>Total Amount :-</div>");
                    columns.Bound(c => c.Amount).Title("Amount").Width(150).ClientFooterTemplate("<div><span class='fa fa-rupee'></span><span id='total-amount'> #= sum #</span></div>");
                    columns.Bound(c => c.SerialNo).Title("Action").Width(120).ClientTemplate("<a onclick='javascript:RemoveTempChallan(#=SerialNo#);'class='hyperlink'>Remove</a>").ClientFooterTemplate("<label class='remove-temp-receipt' onclick='javascript:RemoveCompleteTempChallan()'><b>Remove All</b></label>");
                })
                .Resizable(resize => resize.Columns(true))
                .Events(e => e.DataBound("TempGridDataBoundEvent"))
                .DataSource(dataSource => dataSource
                    .Ajax().Model(model => model.Id(c => c.Id))
                    .ServerOperation(true)
                    .Read(read => read.Action("GetSavedTempPaidChallanDetail", "Finance", new { area = "Revenue" }).Data("FilterRegistrationId"))
                    .Sort(s => s.Add(m => m.Id))//.PageSize(10)
                    .Aggregates(aggregates => aggregates.Add(p => p.Amount).Sum())
                )
                )
            </div>            
        </div>
        <div class="box-button text-center">
            <input type="reset" id="btnReset" value="Reset" class="btn btn-default" style="min-width:100px;" />
            <input type="button" id="btnSubmit" value="Submit" class="btn btn-add" style="min-width:100px;"/>
        </div>
    }

    <div class=" col-md-12 k-grid-content" id="div-paid-challan-grid" style="margin-top:30px;">
        @(Html.Kendo().Grid<NA.PMS.Model.PaymentViewModel>()
            .Name("PaidChallanGrid")
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.RegistrationNo).Hidden(true);
                columns.Bound(c => c.ReceiptId).Title("Receipt Id").Width(150);
                columns.Bound(c => c.ChallanId).Title("Challan Id").Width(150);
                columns.Bound(c => c.EntryDate).Title("Deposit Date").Width(110).Format("{0:dd-MMM-yyyy}");
                columns.Bound(c => c.DepositDate).Title("Clearing Date").Width(110).Format("{0:dd-MMM-yyyy}");  
                columns.Bound(c => c.ReceiptHead).Title("Receipt Head");
                columns.Bound(c => c.ReceiptSubHead).Title("Receipt Sub Head");
                columns.Bound(c => c.Amount).Title("Amount").Width(120);                           
                //columns.Bound(c => c.Id).Title("Action").ClientTemplate("<a onclick='javascript:RemoveChallanDetails(this);'class='hyperlinkcss'>Remove</a>").Filterable(false).Sortable(false);
            })
            .Groupable()
            //.Events(e=>e.DataBound("PaidChallanGridDataBoundEvent"))
            .Filterable().Resizable(resize => resize.Columns(true))
            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(new[] { 10, 50, 100, 500 }).Info(true).PreviousNext(true).Input(true).Numeric(true).ButtonCount(10))
            .DataSource(dataSource => dataSource
                .Ajax().Model(model => model.Id(c => c.Id))
                .ServerOperation(true)
                //.Read(read => read.Action("GetMiscellaneousPaymentListById", "Payment", new { area = "Revenue" }).Data("FilterRegistrationId")).PageSize(10)
                .Read(read => read.Action("GetPaidAmountDetailListByIdAsDataSource", "Finance", new { area = "Revenue" }).Data("FilterRegistrationId"))
                .Sort(s=>s.Add(m=>m.DepositDate).Descending())//.PageSize(10)
            )
        )
    </div>
</div>


<script>
    var totalReceiptAmount = 0;
    $(document).ready(function () {
        ToggleRemoveButtonDisplay();

        $(".integer-only").keydown(function (e) {
            // Allow: backspace, delete, tab, escape, enter and .
            if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110]) !== -1 ||
                // Allow: Ctrl+A, Command+A
                (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
                // Allow: home, end, left, right, down, up
                (e.keyCode >= 35 && e.keyCode <= 40)) {
                // let it happen, don't do anything
                return;
            }
            // Ensure that it is a number and stop the keypress
            if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
                e.preventDefault();
            }
        });

        //$('#div-paid-challan-grid').css("display", "none");

        $('#btnSubmit').click(function () {
            if (ValidateInputFields()) {
                SavePaymentDetail();
            }
        });

        $('.btn-save-temp-data').click(function () {
            var receiptHeadId = $('#ReceiptHeadId').val();
            var receiptSubHeadId = $('#ReceiptSubHeadId').val();
            var amount = $('#Amount').val();
            if (receiptHeadId == "") {
                alertify.error("Select Receipt Head");
                return false;
            }
            if (receiptSubHeadId == "") {
                alertify.error("Select Receipt Sub Head");
                return false;
            }
            if (amount == "") {
                alertify.error("Enter amount");
                return false;
            }
            else {
                SaveReceiptTempData();
            }
        });

        //$('.remove-temp-receipt').click(function(){
        //    RemoveCompleteTempChallan();
        //});
        $(".btn-remove-receipt").click(function () {
            RemoveRegistrationIdFromChallan();
        });
    });

    function ToggleRemoveButtonDisplay() {
        if ($("#DDLReceiptId").val() == "") {
            $(".btn-remove-receipt").css("display", "none");
        }
        else {
            $(".btn-remove-receipt").show();
        }
    }

    function RemoveRegistrationIdFromChallan() {
        var flag = confirm("Are You sure to remove this receipt from This RegistrationId");
        if (flag) {
            if ($("#DDLReceiptId").val() != "") {
                $.ajax({
                    dataType: 'json',
                    type: 'Post',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({ RegistrationId: $('#RegistrationId').val(), ReceiptId: $("#DDLReceiptId").val() }),
                    url: "/Revenue/Finance/RemoveRegistrationIdFromPaidChallan",
                    success: function (result) {
                        if (result == '@ReturnType.Removed') {
                            clearReceiptDetails();
                            alertify.success("Record has been removed successfully.");                            
                            $('#TempReceiptGrid').data('kendoGrid').dataSource.read();
                            $('#PaidChallanGrid').data("kendoGrid").dataSource.read();
                            ToggleRemoveButtonDisplay();
                        }
                        else {
                            alertify.error("Provider failed to update challan, try again later");
                        }
                    },
                    error: function (ajaxRequest, strError) {
                        var respText = ajaxRequest.responseText;
                    }
                });
            }
            else {
                alertify.error("Please select ReceiptId");
            }
        }
    }

    function RemoveCompleteTempChallan(){
        var flag = confirm("Are You sure to remove all receipt detail");
        if(flag){
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ RegistrationId: $('#RegistrationId').val(), ActionType: "RemoveAll" }),
                url: "/Revenue/Finance/RemoveTempPaidChallanDataById",
                success: function (result) {
                    if (result == '@ReturnType.Removed') {
                        clearReceiptDetails();
                        alertify.success("Record has been removed successfully.");
                        $('#TempReceiptGrid').data('kendoGrid').dataSource.read();
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                }
            })
        }
    }

    function TempGridDataBoundEvent() {
        var total = $('#TempReceiptGrid').data('kendoGrid').dataSource.total();
        //$('.k-grid td label.remove-temp-receipt').css("display","none");
        if (total > 0) {
            var amount = $("#total-amount").html();
            if (amount != "" && amount != undefined) {
                amount = parseFloat(amount).toFixed(2);
                $('#TotalAmount').data("kendoNumericTextBox").value(amount);
                $('.k-grid td label.remove-temp-receipt').show();
                $('#div-temp-receipt').show();
            }
            if ($('#RegistrationId').val() != "") {
                $('#div-temp-receipt').show();
            }
            else {
                $('#div-temp-receipt').css("display", "none");
            }
        }
        else {
            $('#div-temp-receipt').css("display","none");
            $('.k-grid td label.remove-temp-receipt').css("display","none");
        }
    }

    function PaidChallanGridDataBoundEvent() {
        var grid = $('#PaidChallanGrid').data('kendoGrid').dataSource;

        var total = $('#PaidChallanGrid').data('kendoGrid').dataSource.total();
        if (total > 0) {
            $('#div-paid-challan-grid').show();
        }
        else {
            $('#div-paid-challan-grid').css("display", "none");
        }
    }

    function SelectBankNameEvent() {
        $('#BankName').val($('#BankId').data("kendoDropDownList").text());
    }

    function FilterPaymentType() {
        return { id: $('#ReceiptHeadId').val() }
    }
    //FilterRegistrationIdForExChallan
    function FilterRegistrationId() {
        return { RegistrationId: $('#RegistrationId').val() };
    }

    function FilterRegistrationIdForExChallan() {
        return {
            RegistrationId: $('#RegistrationId').val(),
            ActionType: "PaidChallan"
        };
    }

    function SavePaymentDetail() {
        var receiptId = $('#DDLReceiptId').val() == "" ? $('#ReceiptId').val() : $('#DDLReceiptId').val();
        $('#ReceiptId').val(receiptId);
        var formData = new FormData($('form').get(0));
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            data: formData,
            url: '/Revenue/Finance/SavePaidChallanDetailByRegistrationId',
            success: function (result) {
                if (result == '@ReturnType.Saved' || result == '@ReturnType.Updated') {
                    alertify.success("Data saved successfully.");
                    ClearInputField();
                    $('#TempReceiptGrid').data('kendoGrid').dataSource.read();
                    $('#PaidChallanGrid').data("kendoGrid").dataSource.read();
                }
                else if (result == '@ReturnType.Exist') {
                    alertify.error("Data already exists for this rid.");
                }
            },
            error: function (ajaxRequest, strError) {
                alertify.error("Network error, try again later");
            }
        });
        }


        function SaveReceiptTempData() {
            var kendoWidget = $('#TempReceiptGrid').data("kendoGrid");
            kendo.ui.progress(kendoWidget.element, true);
            var paymodel = {
                RegistrationId: $('#RegistrationId').val(),
                DepartmentId: $('#DepartmentId').val(),
                ReceiptHeadId: $('#ReceiptHeadId').val(),
                ReceiptHead: $('#ReceiptHeadId').data("kendoDropDownList").text(),
                ReceiptSubHeadId: $('#ReceiptSubHeadId').val(),
                ReceiptSubHead: $('#ReceiptSubHeadId').data("kendoDropDownList").text(),
                Amount: $('#Amount').val()
            };
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ model: paymodel }),
                url: "/Revenue/Finance/SaveTempPaidChallanDetail",
                success: function (result) {
                    if (result == '@ReturnType.Saved') {
                        $('#TempReceiptGrid').data('kendoGrid').dataSource.read();
                        kendo.ui.progress(kendoWidget.element, false);
                        alertify.success("Record has been saved successfully.");
                    }
                    if (result == '@ReturnType.None') {
                        $('#TempChallanGrid').data('kendoGrid').dataSource.read();
                        kendo.ui.progress(kendoWidget.element, false);
                        alertify.error("Records aren't saved.");
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                }
            })
        }


        function GetAllottedPropertyDetails() {
            var rId = $('#RegistrationId').val();
            if (rId != "" && rId.length == 8) {
                $.ajax({
                    type: "post",
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({ rid: rId }),
                    url: "/Revenue/Payment/GetAllottedPropertyDetailsById",
                    success: function (result) {
                        if (result != null) {
                            //ClearInputField();
                            $('#Applicant').val(result.Applicant);
                            $('#PropertyNo').val(result.PropertyNo);
                            $('#FirstName').val(result.FirstName);
                            $('#MiddleName').val(result.MiddleName);
                            $('#LastName').val(result.LastName);
                            $('#SectorId').val(result.SectorId);
                            $('#SectorName').val(result.SectorName);
                            $('#BlockId').val(result.BlockId);
                            $('#BlockName').val(result.BlockName);
                            $('#PlotNo').val(result.PlotNo);
                            $('#DepartmentId').data("kendoDropDownList").value(result.DepartmentId);
                            $('#DepartmentName').val(result.DepartmentName);
                            $('#PropertyId').val(result.PropertyId);
                        }
                        $('#PaidChallanGrid').data("kendoGrid").dataSource.read();
                        //$('#TempReceiptGrid').data('kendoGrid').dataSource.read();
                    },
                    error: function (ajaxRequest, strError) {
                        //alert(ajaxRequest.responseText);
                        alertify.error("Network error, Please try again.");
                    }
                });
            }
            else {
                ClearInputField();
                //alertify.error("Please select Registration Id");
            }
        }

        function ReceiptIdChangeEvent() {
            var rId = $('#RegistrationId').val();
            var receiptId = $('#DDLReceiptId').val();
            if (rId != "" && receiptId != null) {
                $.ajax({
                    type: "post",
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({ RegistrationId: rId, ReceiptId: receiptId, ActionType: "PaidChallan" }),
                    //url: "/Revenue/Finance/GetSavedTempPaidChallanDetail",
                    url: "/Revenue/Finance/GetExistingPaidChallanDetail",
                    success: function (result) {
                        if (result != null) {
                            $('#ReceiptId').val(receiptId);
                            $('#EntryDate').data("kendoDatePicker").value(result.EntryDate);
                            $('#DepositDate').data("kendoDatePicker").value(result.DepositDate);
                            $('#TotalAmount').data("kendoNumericTextBox").value(result.TotalAmount);
                            $('#DepositorName').val(result.DepositorName);
                            $('textarea#DepositorAddress').val(result.DepositorAddress);
                            $('#ChallanId').val(result.ChallanId);
                        }
                        $.ajax({
                            type: "post",
                            dataType: "json",
                            contentType: "application/json; charset=utf-8",
                            data: JSON.stringify({ RegistrationId: rId, ReceiptId: receiptId, ActionType: "PaidChallan" }),
                            url: "/Revenue/Finance/GetSavedTempPaidChallanDetail",
                            success: function (result) {
                                if (result != null) {
                                    $('#ReceiptId').val(receiptId);
                                    $('#TempReceiptGrid').data('kendoGrid').dataSource.read();
                                }
                                ToggleRemoveButtonDisplay();
                            },
                            error: function (ajaxRequest, strError) {
                                //alert(ajaxRequest.responseText);
                                alertify.error("Network error, Please try again.");
                            }
                        });
                    },
                    error: function (ajaxRequest, strError) {
                        //alert(ajaxRequest.responseText);
                        alertify.error("Network error, Please try again.");
                    }
                });
            }
            else {
                $('#ReceiptId').val('');
                $('#EntryDate').data("kendoDatePicker").value('');
                $('#DepositDate').data("kendoDatePicker").value('');
                $('#TotalAmount').data("kendoNumericTextBox").value('');
                $('#DepositorName').val('');
                $('#DepositorAddress').text('');
                $('#ChallanId').val('');
            }
        }

        function ValidateEntryDate() {
            var depositdate = $('#DepositDate').val();
            var entrydate = $('#EntryDate').val();
            var today = '@DateTime.Now.ToString()';
            if (new Date(depositdate) > new Date(entrydate)) {
                alertify.error("Entry date should not be earlier than deposit date");
                return false;
            }
            if (new Date(entrydate) > new Date(today)) {
                alertify.error("Entry date should not be future date.");
                return false;
            }
        }

        function RemoveTempChallan(id) {
            var flag = confirm("Are You sure to remove this detail.");
            if (flag) {
                $.ajax({
                    dataType: 'json',
                    type: 'Post',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({ SerialNo: id, RegistrationId: $('#RegistrationId').val() }),
                    url: "/Revenue/Finance/RemoveTempPaidChallanDataById",
                    success: function (result) {
                        if (result == '@ReturnType.Removed') {
                            alertify.success("Record has been removed successfully.");
                            $('#TempReceiptGrid').data('kendoGrid').dataSource.read();
                        }
                    },
                    error: function (ajaxRequest, strError) {
                        var respText = ajaxRequest.responseText;
                    }
                })
            }
        }


        function ValidateInputFields() {
            var flag = true;
            var rid = $('#RegistrationId').data("kendoDropDownList").value();
            var departmentId = $('#DepartmentId').data("kendoDropDownList").value();
            var paymentTypeId = $('#ReceiptHeadId').data("kendoDropDownList").value();
            var paymentSubTypeId = $('#ReceiptSubHeadId').data("kendoDropDownList").value();
            var bankId = $('#BankId').data("kendoDropDownList").value();
            var amount = $('#Amount').val();
            var challanId = $('#ChallanId').val();
            var depositDate = $('#DepositDate').data("kendoDatePicker").value();
            if (rid == "" || rid == null) {
                alertify.error("Select Registration Id");
                flag = false;
            }
            if (departmentId == "" || null) {
                alertify.error("Select DepartmentId Id");
                flag = false;
            }
            //if (paymentTypeId == "" || paymentTypeId == null) {
            //    alertify.error("Select Payment Type Id");
            //    flag = false;
            //}
            //if (paymentSubTypeId == "" || paymentSubTypeId == null) {
            //    alertify.error("Select Payment SubType Id");
            //    flag = false;
            //}
            //if (amount == "") {
            //    alertify.error("Enter Amount");
            //    flag = false;
            //}
            if (depositDate == "" || depositDate == null) {
                alertify.error("Select Deposit date");
                flag = false;
            }
            if (challanId == "") {
                alertify.error("Enter Challan Id");
                flag = false;
            }
            if (bankId == "" || bankId == null) {
                alertify.error("Select Bank Name");
                flag = false;
            }

            return flag;
        }

