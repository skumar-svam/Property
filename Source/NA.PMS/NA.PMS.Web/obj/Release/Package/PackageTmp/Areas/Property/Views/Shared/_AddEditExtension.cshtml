@using Kendo.Mvc.UI
@model NA.PMS.Model.ExtensionDetails
@using NA.PMS.Common;

<h2 class="blck-heading">Applicant Details</h2>
<div class="form-bx">
    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Registration Id", htmlAttributes: new { @class = "required" })
