                <input type="button" id="btnCancel" value="Cancel" class="btn btn-default" />
                <input type="button" id="btnResubmit" value="Re-Submit" class="btn btn-add" />
            </div>
        </div>
    </div>
</div>
@*Prints Transfer Memorandum*@
