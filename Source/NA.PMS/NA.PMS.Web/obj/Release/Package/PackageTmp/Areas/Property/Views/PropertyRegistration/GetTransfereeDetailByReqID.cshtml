        });

        $("#TransferChargePerSqMtr").blur(function () {
            var area = $("#lblArea").html();
            var intArea = parseFloat(area);
            $("#TotalTransferCharge").val(intArea * $("#TransferChargePerSqMtr").val());
        });

        $(".closePopup").click(function () {
            $("#assignToWindow").data("kendoWindow").close();
        });

        $("#btnCancel").click(function () {
            var requestId = $('#ReqNo').val();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ requestId: requestId }),
                url: '/PropertyRegistration/CancelTransferRequest',
                success: function (result) {
                    if (result == true) {
                        window.location.href = '@Url.Action("ManageTransfers", "PropertyRegistration")';
                        return false;
                    }
                    else {
                        return true;
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //alert(respText);
                }
            });
        });
        var specialKeys = new Array();
        specialKeys.push(8); //Backspace
        function IsNumeric(e) {
            var keyCode = e.which ? e.which : e.keyCode
            var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
            if (ret == false)
                return false;
        }
    });

    function TransChange() {
        var trans = $("#TransferType").val();
        if (trans == '') {
            alertify.error("Please fill GPA details.");
            $("#TransferType").data("kendoDropDownList").value("");
            $("#TransferSubType").data("kendoDropDownList").value("");
        }
    }
</script>