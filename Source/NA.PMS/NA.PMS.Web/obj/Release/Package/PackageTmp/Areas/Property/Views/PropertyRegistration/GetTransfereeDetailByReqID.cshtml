@model NA.PMS.Model.TransferModel
@using Kendo.Mvc.UI
@{
    ViewBag.Title = "View/Edit Transfer Request";//Bug#191 - Resolved
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .k-window {
        width: 39%;
        min-height: 180px;
    }
</style>

<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="row">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">View/Edit Transfer Request</h1></div>@*Bug#191 - Resolved*@
                <div class="col-md-6 col-sm-6 col-xs-12 col-btn">
                    <input type="button" value="Print Transfer Memorandum" id="btnPrintDeed" class="btn btn-add" />
                    <a href="#" id="btnComment" class="">View Comments</a>
                </div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
                <h2 class="blck-heading">Registration Id</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Registration Id", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(m => m.RId)
                                    .Filter("contains")
                                    .DataTextField("text")
                                    .DataValueField("id")
                                    .OptionLabel("Select")
                                    .DataSource(source =>
                                    {
                                        source.Custom()
                                        .ServerFiltering(true)
                                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                        .Transport(transport =>
                                        {
                                            transport.Read(read => read.Action("GetRIDsForTransferForView", "PropertyRegistration").Data("GetRid"));
                                        }).Schema(schema =>
                                        {
                                            schema.Data("Data")
                                            .Total("Total");
                                        }).PageSize(100);

                                    })
                                    .HtmlAttributes(new { @class = "schemeForms", style = "width:100%" })
                            )
                            @Html.HiddenFor(m => m.isGPA)
                            @*<input type="hidden" id="hdnTransfereeGenderName" value="@Model.TransfereeGenderName" />*@
                            <input type="hidden" id="hdnReqNo" value="@Model.ReqNo" />
                            <input type="hidden" id="hdnTransfereeGenderName" />
                            <input type="hidden" id="hdnRid" value="@Model.RId" />


                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">@Html.Label("Property Number")</div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="lblPropNo" class="lbl-form-control"></label></div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">@Html.LabelFor(m => m.ReqRefNo)</div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">@Html.TextBoxFor(m => m.ReqRefNo, new { @class = "form-control" })</div>
                    </div>
                </div>
                <h2 class="blck-heading">Transfer Allottee Details</h2>
                <div class="">
                    @{Html.RenderPartial("_TransferAllotteDetails");}
                </div>

                <h2 class="blck-heading">Transfer Details</h2>
                <div class="form-bx">
                    @{Html.RenderPartial("_TransferDetailsDocs", Model);}
                </div>

                <h2 class="blck-heading">Transer Details</h2>
                <div class="form-bx">
                    @{Html.RenderPartial("_ViewTransferee", Model);}
                </div>
            </div>
            <div id="hdnDiv">
                @(Html.Kendo().DatePickerFor(m => m.PossessionDate)
                                          .HtmlAttributes(new { style = "width:100%", @class = "DisableKeyboardInput" }))
