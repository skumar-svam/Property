                                  .DataTextField("schemeName")
                                  .DataValueField("schemeId")
                                  .Filter("contains")
                                  .OptionLabel(" -- Please Select --")
                                  .DataSource(source => source.Read(read => read.Action("GetAllSchemesForRefund", "ManageRefunds")))
                                  .Enable(true)
                                  .AutoBind(true)
                                  .HtmlAttributes(new { style = "width: 100%;" })
                                )
                                @(Html.ValidationMessageFor(m => m.SchemeId))
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Department", htmlAttributes: new { @class = "required font-bold" })
                                               </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">

                                @(Html.Kendo().DropDownListFor(model => model.DepartmentId)
                                  .Name("DepartmentId")
                                  .DataTextField("DepartmentName")
                                  .DataValueField("DepartmentId")
                                  .Filter("contains")
                                  .OptionLabel(" -- Please Select --")
                                  .DataSource(source => source.Read(read => read.Action("GetDepartmentOnSchemeForRefund", "ManageRefunds").Data("FilterDepartment"))
                                                              .ServerFiltering(true))
                                  .Enable(false)
                                  .AutoBind(false)
                                  .CascadeFrom("SchemeId")
                                  .HtmlAttributes(new { style = "width: 100%; height:100%" })
                                )
                                @(Html.ValidationMessageFor(m => m.DepartmentId))
                            </div>
                        </div>



                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Unit", htmlAttributes: new { @class = "required font-bold" })
                           
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">

                                @(Html.Kendo().DropDownListFor(model => model.Unit)
                //.Name("Unit")
                            .DataTextField("UnitName")
                            .DataValueField("UnitValue")
                            .OptionLabel("Select")
