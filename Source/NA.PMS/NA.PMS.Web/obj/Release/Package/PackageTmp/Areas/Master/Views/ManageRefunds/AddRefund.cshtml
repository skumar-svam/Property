                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Interest Rate", htmlAttributes: new { @class = "required font-bold" })
                          
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">

                                @Html.TextBoxFor(model => model.InterestRate, new { @class = "form-control textBoxValueRightAlign", @maxlength = "2" })
                                @(Html.ValidationMessageFor(m => m.InterestRate))
                            </div>
