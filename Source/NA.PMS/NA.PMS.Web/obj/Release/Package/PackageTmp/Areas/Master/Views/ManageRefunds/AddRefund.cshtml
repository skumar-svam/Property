@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@using NA.PMS.Common
@model NA.PMS.Model.Refund

@{
    ViewBag.Title = "Refund";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Scripts/_references.js"></script>
<script>
    function filterSchemeName() {
        return {
            schemeId: $("#SchemeId").val()
        };
    }

