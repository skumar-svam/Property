    $(document).ready(function () {
        $('#Unit').change("click", function () {
            if ($("#Unit").val() == "INR") {
                $("#Deduction").attr('maxlength', '15');
            }
            if ($("#Unit").val() == "P") {
                $("#Deduction").attr('maxlength', '5');
            }
            if ($("#Unit").val() == "Select") {
                $("#Deduction").attr('maxlength', '0');
            }
        });

        $('#btnSubmit').click(function () {
            if ($('#SchemeId').val() == "") {
                alertify.error("Please select Scheme.");
                return false;
            }
            if ($('#DepartmentId').val() == "") {
                alertify.error("Please select Department.");
                return false;
            }
            if ($('#Unit').val() == "") {
                alertify.error("Please select Unit.");
                return false;
            }
            if ($('#Deduction').val() == "") {
                alertify.error("Please enter Deduction value.");
                return false;
            }
            if ($('#Deduction').val() != "") {
                var deduction = $('#Deduction').val();
                if ($("#Unit").val() == "INR") {
                    if (deduction >= 0 && deduction <= 999999999999) {
                        $('#Deduction').val(parseFloat($('#Deduction').val()).toFixed(2));
                        //return true;
                    }
                    else {
                        alertify.error("With unit INR, maximum deduction should be of digits [12,2]");
                        $('#Deduction').Focus();
                        return false;
                    }
                }
                if ($("#Unit").val() == "P") {
                    if (deduction >= 0 && deduction <= 99) {
                        $('#Deduction').val(parseFloat($('#Deduction').val()).toFixed(2));
                        //$("#btnSubmit").attr('disabled', 'disabled');
                        //return true;
                    }
                    else {
                        alertify.error("With unit P, deduction can't be more than 99");
                        $('#Deduction').Focus();
                        return false;
                    }
                }
            }
            if ($('#InterestRate').val() == "") {
                alertify.error("Please enter InterestRate.");
                return false;
            }
            if ($('#DaysAfterInterest').val() == "") {
                alertify.error("Please enter Days After Interest.");
                return false;
            }
            if ($('#DaysAfterInterest').val() != "") {
                if (!regexD.test($('#DaysAfterInterest').val())) {
                    alertify.error("Days After Interest must be number.");
                    return false;
                }
            }
            if ($('#DeductionApplyOn').val() == "") {
                alertify.error("Please select Deduction Apply On.");
                return false;
            }
            if ($('#RefundDescription').val() == "") {
                alertify.error("Please enter Refund Description.");
                return false;
            }
            if ($('#RefundDescription').val() != "") {
                if (!regex.test($('#RefundDescription').val().trim())) {
                    alertify.error("Refund Description must be alphanumeric.");
                    return false;
                }
            }
            if ($('#RefundLockPeriod').val() == "") {
                alertify.error("Please enter Refund Lock Period.");
                return false;
            }
            $("#btnSubmit").attr('disabled', 'disabled');
            $.ajax({
                url: '@(Url.Action("AddRefundForScheme", "ManageRefunds"))',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: JSON.stringify({ schemeId: $('#SchemeId').val(), departmentId: $('#DepartmentId').val(), unit: $('#Unit').val(), deduction: $('#Deduction').val(), interestRate: $('#InterestRate').val(), daysAfterInterest: $('#DaysAfterInterest').val(), deductionApplyOn: $('#DeductionApplyOn').val(), refundDescription: $('#RefundDescription').val(), refundLockPeriod: $('#RefundLockPeriod').val() }),
                success: function (result) {
                    if (result == false) {
                        alertify.error("Save Refund is not successful.");
                        $("#btnSubmit").removeAttr('disabled');
                    }
                    else {
                        alertify.success("Refund saved successfully.");
                        window.location.href = '@Url.Action("ManageRefund", "ManageRefunds")';
                        return false;
                    }

                },
                error: function (objAjaxRequest, strError) {
                    //alertify.error("There is some error. Please contact to administrator.");
                    $("#btnSubmit").removeAttr('disabled');
                    //var resptext = objajaxrequest.responsetext;
                    //$("#btnSubmit").removeAttr('disabled');
                    //alert(resptext);
                }
            });
