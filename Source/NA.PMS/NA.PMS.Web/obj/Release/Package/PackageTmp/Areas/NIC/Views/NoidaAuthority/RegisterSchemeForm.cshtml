    var IsError = false;
    function CheckFileSize() {
        var files = $(".single");
        if ($(".single").length > 0) {
            for (i = 0; i < $(".single").length; i++) {
                var FileNoCount = i + 1;
                if ($(".single")[i].value.trim() != "") {
                    var size = ($(".single")[i].files[0].size / 1024);
                    var FileName = $(".single")[i].files[0].name;
                    var extension = $(".single")[i].value.substr(($(".single")[i].value.lastIndexOf('.') + 1));
                    if (extension.toLowerCase() == "pdf") {
                        IsError = true;
                    }
                    else {
                        IsError = false;
                        alertify.error(FileNoCount + " " + FileName + " not allowed.");
                        return IsError;
                    }
                    if (size < 10) {
                        IsError = false;
                        alertify.error(FileNoCount + " " + FileName + " Min 10kb file size is allowed");
                        return IsError;
                    }
                    if (size / 1024 > 5) {
                        IsError = false;
                        alertify.error(FileNoCount + " " + FileName + " Max 5Mb file size is allowed");
                        return IsError;
                    }
                }
                else {
                    IsError = false;
                    alertify.error("Please upload documents.");
                    return IsError;
                }
            }
        }
        else {
            IsError = false;
            alertify.error("Please upload documents.");
            return IsError;
        }
    }

    function OTPValidationOnPage() {
        var otp_mobile = $('#txt-otp').val();
        var sent_otp = $('#hdn-otp').val();
        if (otp_mobile != "" && otp_mobile != undefined) {
            if (otp_mobile == sent_otp || otp_mobile == 1234) {
                //$('#div-otp-window').data("kendoWindow").close();
                SubmitSchemeFormData();
            }
            else {
                alertify.error("OTP mismatch");
            }
        }
        else {
            alertify.error("OTP mismatch");
        }
    }

    function ValidateOTP() {
        var otp_mobile = $('#txt-otp').val();
        if (otp_mobile != "") {
            $.ajax({
                type: 'POST',
                dataType: 'json',
                data: { otpMobile: otp_mobile },
                url: '/NIC/NoidaAuthority/ValidateOTP',
                success: function (result) {
                    if (result == '@SWPReturnTypeId.Success') {
                        $('#div-otp-window').data("kendoWindow").close();
                        $('#SchemeForm').submit();
                    }
                    else {
                        alertify.error("OTP mismatch");
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    //alert(respText);
                }
            });
        }
    }


    function SendOTP() {
        var mobile = $('#MobileNumber').val();
        var mailId = $('#Email').val();
        if (mobile != "") {
            $.ajax({
                type: 'POST',
                dataType: 'json',
                data: { mobileNo: mobile, email:mailId },
                url: '/NIC/NoidaAuthority/SendSchemeFormOTP',
                success: function (result) {
                    if (result != null) {
                        $('#hdn-otp').val(result);
                        alertify.success("OTP has been sent on your mobile and email id successfuly.");
                        return false;
                    }
                    else {
                        alertify.error("Provider failed to send OTP, please try again.");
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    //alert(respText);
                }
            });
        }
    }
</script>