    function CalculateAmount() {
        var applicationFrom = (isNaN(parseFloat($('#ApplicationFee').val()))) ? 0 : parseFloat($('#ApplicationFee').val());
        var earnestMoney = (isNaN(parseFloat($('#EarnestMoney').val()))) ? 0 : parseFloat($('#EarnestMoney').val());
        var processingFee = (isNaN(parseFloat($('#ProcessingCharge').val()))) ? 0 : parseFloat($('#ProcessingCharge').val());
        var processingGST = CalculateGST(processingFee);
        var formFeeGST = CalculateGST(applicationFrom);
        $('#FormFeeGST').val(formFeeGST);
        $('#ProcessingChargeGST').val(processingGST);
        var totalAmount = parseFloat((parseFloat(applicationFrom) + parseFloat(earnestMoney) + parseFloat(processingFee) + parseFloat(processingGST) + parseFloat(formFeeGST)).toFixed(2));
        $("#TotalAmount").val(totalAmount);
    }

    function CalculateGST(amount) {
        if ((amount != null || amount != "") && amount > 0) {
            var gst = (amount * 18) / 100;
            return gst;
        }
        else return 0;
    }

    function PanNumberChange() {
        if ($("#PanNumber").val().trim() == '') {
            $("#PanNumber").val('');
        }
        var bool = CheckPanNoFormat();
        if (bool == false) {
            alertify.error("Pan Number format is wrong.");
            $("#PanNumber").val('');
            return false;
        }
        else {
            ValidatePanNumber();
        }
    }

    function CheckPanNoFormat() {
        var value = $("#PanNumber").val().trim();
        var regex1 = /^[A-Z]{5}\d{4}[A-Z]{1}$/;
        if (!regex1.test(value) || value.length != 10) {
            return false;
        }
        return true;
    }

    function ValidatePanNumber() {
        var flag = false;
        var pan = $('#PanNumber').val();
        var areaId = $('#AreaRangeId').val();
        if (areaId != "" && areaId != undefined) {
            $.ajax({
                url: '/NIC/NoidaAuthority/ValidateFormInputFieldByType',
                type: 'POST',
                dataType: 'json',
                data: { PanNumber: pan, AreaRangeId: areaId, ActionType: "PAN" },
                success: function (result) {
                    if (result != null && result.ReturnTypeId == '@SWPReturnTypeId.Exist') {
                        alertify.error("This PAN no " + pan + " already exist for this property.");
                        $("#PanNumber").val('');
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    //alert(respText);
                }
            });
        }
        else {
            alertify.error("Please select area applied for");
            $("#PanNumber").val('');
        }
    }

