    </div>
    <div class="row">
        <div class="col-md-4 col-md-6 col-popup form-group">
            @Html.Label("Payment Mode")
            @(Html.Kendo().DropDownListFor(model => model.PaymentMode)
                    .DataTextField("Text")
                    .DataValueField("Value")
                    .OptionLabel("--select--")
                    .BindTo(new List<SelectListItem>() {
                          new SelectListItem() { Text = "Challan", Value = "Challan" },
                          new SelectListItem() { Text = "Online", Value = "Online" }
                      })
                    .HtmlAttributes(new { style = "width:95%;float:right;" })
                    //.Events(e => e.Change("ChangeDepartmentEvent"))
            )
        </div>
