@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@using NA.PMS.Common;
@model NA.PMS.Model.PaymentViewModel

@{
    ViewBag.Title = "Allotment Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .form-control {
        width: 95%;
        float: right;
    }

    .kendo-popup-window {
        display: none;
    }

        .kendo-popup-window .row {
            margin-right: 20px;
        }

    .k-button {
        min-width: 80px;
    }
</style>

<div class="manage-payment">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Allotment Account</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                @*<a href="/Revenue/Payment/InstallmentSchedule" target="_blank"><i class="fa fa-plus"></i> <span> Schedule</span></a>*@
                <a href="#" onclick="javascript:DisplayWindow()"><i class="fa fa-plus"></i>Add Payment</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>

    <div class="col-md-12 content-top-spce">
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading" style="margin-bottom:15px;">Allotment Account Detail</h2>
            <div class="form-bx">
                <div>
                    @Html.HiddenFor(model => model.DepartmentId)
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>RegistrationId</label>
                        @(Html.Kendo().DropDownListFor(m => m.RegistrationId)
                            .Filter("contains")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel(" --- select ---")
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => transport.Read(read => read.Action("GetRegistrationIdList", "Finance", new { area = "Revenue" })))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(6);
                            })
                                //.Events(events => { events.Change("ChangeDepartmentEvent"); })
                            .Events(events => { events.Change("ChangeInRegistrationIdEvent"); })
                            .HtmlAttributes(new { @class = "input-disabled", style = "width:95%; float:right;" })
                        )
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Department</label>
                        @Html.TextBoxFor(model => model.Department, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-6 col-sm-12 col-xs-12 form-group">
                        <label>Allottee Name</label>
                        @Html.TextBoxFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", @maxlength = "50" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Property No</label>
                        @Html.TextBoxFor(model => model.PropertyNo, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Allotment Date</label>
                        @(Html.Kendo().DatePickerFor(model => model.DuesUptoDate).HtmlAttributes(new { style = "width:95%;float:right;" }))
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Total Area(sqm)</label>
                        @Html.TextBoxFor(model => model.TotalArea, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    
                </div>

                <div class="row">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Allotment Rate(psqm)</label>
                        @Html.TextBoxFor(model => model.AllotmentRate, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Location Charge(psqm)</label>
                        @Html.TextBoxFor(model => model.LocationCharge, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Total Allotment Rate(psqm)</label>
                        @Html.TextBoxFor(model => model.TotalAllotmentRate, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Total Property Cost</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                   
                </div>
                <div class="row">
                  
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Earnest Money</label>
                        @Html.TextBoxFor(model => model.RegistrationAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Balance Allotment Money</label>
                        @Html.TextBoxFor(model => model.AllotmentMoney, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>One Year Advance Lease Rent</label>
                        @Html.TextBoxFor(model => model.AdvanceLeaseRentAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Payable (Balance A/Money + Adv.L/Rent)</label>
                        @Html.TextBoxFor(model => model.InstallmentAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Valid Upto Date</label>
                        @(Html.Kendo().DatePickerFor(model => model.ChallanDate).HtmlAttributes(new { @class = "", style = "width:90%; float:right;" }))
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Interest(Balance A/Money)</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Total Payable Allotment Money</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Penal Interest(%)</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>

                </div>

                <div class="row">
                    <div class="col-md-12" style="text-align:right;">
                        <input type="button" class="btn btn-default" value="NDA Calculation" />
                        <input type="button" class="btn btn-default" value="Calculation Of Allotment Money" />
                    </div>
                </div>
            </div>
            

            <h2 class="blck-heading" style="margin-bottom:15px;">Excess Area Detail</h2>
            <div class="form-bx">
                <div class="row">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Excess Area Date</label>
                        @(Html.Kendo().DatePickerFor(model => model.CurrentDuesDate).HtmlAttributes(new { style = "width:95%;float:right;" }))
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Total Excess Area(sqm)</label>
                        @Html.TextBoxFor(model => model.TotalArea, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Allotment Rate Of Excess Area(psqm)</label>
                        @Html.TextBoxFor(model => model.AllotmentRate, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Location Charge Of Excess Area(psqm)</label>
                        @Html.TextBoxFor(model => model.LocationCharge, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Total Allotment Rate Of Excess Area(psqm)</label>
                        @Html.TextBoxFor(model => model.TotalAllotmentRate, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Total Property Cost Of Excess Area</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>

                </div>
                <div class="row">

                    
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>One Time Lease Rent On Excess Area</label>
                        @Html.TextBoxFor(model => model.AdvanceLeaseRentAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Payable (Total cost of Excess Area + One Time Lease Rent on Excess Area)</label>
                        @Html.TextBoxFor(model => model.InstallmentAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Valid Upto Date On Excess Area</label>
                        @(Html.Kendo().DatePickerFor(model => model.ChallanDate).HtmlAttributes(new { @class = "", style = "width:90%; float:right;" }))
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Interest(Total cost of Excess Area + One Time Lease Rent on Excess Area)</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Total Payable (Total cost of Excess Area + One Time Lease Rent on Excess Area)</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    
                </div>
                <div class="row">
                    
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Penal Interest On Excess Area(%)</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>

                </div>

                <div class="row">
                    <div class="col-md-12" style="text-align:right;">
                        <input type="button" class="btn btn-default" value="Calculation Of Excess Area" />
                    </div>
                </div>
            </div>
            
            <h2 class="blck-heading" style="margin-bottom:15px;">Installment Detail</h2>
            <div class="form-bx">
                <div class="row">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Balance Amount</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Total No of Installment</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Frequency Of Installment</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Installment Start Date</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Normal Interest(%)</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Penal Interest(%)</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Interest On Installment</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Total Payable (Installment + Interest on Installment)</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12" style="text-align:right;">
                        <input type="button" class="btn btn-default" value="NDA Calculation" />
                        <input type="button" class="btn btn-default" value="Payment Schedule Of Installment" />
                        <input type="button" class="btn btn-default" value="Calculation Of Installment" />
                    </div>
                </div>
            </div>


            <h2 class="blck-heading" style="margin-bottom:15px;">Lease Rent Detail</h2>
            <div class="form-bx">
                <div class="row">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Date Of Lease Deed</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Frequency Of Lease Rent (Yearly)</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Revised Lease Rent</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>One Time Lease Rent</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Lease Rent Amount</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Penal Interest(%)</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Interest On Lease Rent</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Total Payable (Lease Rent + Interest on Lease Rent)</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12" style="text-align:right;">
                        <input type="button" class="btn btn-default" value="One Time Lease Rent" />
                        <input type="button" class="btn btn-default" value="Calculation Of Lease Rent" />
                    </div>
                </div>
            </div>


            <h2 class="blck-heading" style="margin-bottom:15px;">Compensation Amount</h2>
            <div class="form-bx">
                <div class="row">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Date Of Compensation Letter</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Effected Area of Compensation</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Rate Of Compensation</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Payable Amount of Compensation</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Penal Interest Of Compensation Amount</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Total Compensation Payable Amount</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    
                </div>
                <div class="row">
                    <div class="col-md-12" style="text-align:right;">
                        <input type="button" class="btn btn-default" value="One Time Lease Rent" />
                        <input type="button" class="btn btn-default" value="Calculation Of Lease Rent" />
                    </div>
                </div>
            </div>

            <h2 class="blck-heading" style="margin-bottom:15px;">Allotment II (Transfer)</h2>
            <div class="form-bx">
                <div>
                    @Html.HiddenFor(model => model.DepartmentId)
                </div>
                <div class="row">
                    
                    <div class="col-md-6 col-sm-12 col-xs-12 form-group">
                        <label>Allottee II Name</label>
                        @Html.TextBoxFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", @maxlength = "50" })
                    </div>
                    <div class="col-md-6 col-sm-12 col-xs-12 form-group">
                        <label>Allottee II Address</label>
                        @Html.TextBoxFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", @maxlength = "50" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Transfer Request Letter Date</label>
                        @(Html.Kendo().DatePickerFor(model => model.DuesUptoDate).HtmlAttributes(new { style = "width:95%;float:right;" }))
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Transfer Date</label>
                        @(Html.Kendo().DatePickerFor(model => model.DuesUptoDate).HtmlAttributes(new { style = "width:95%;float:right;" }))
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Transfer Charge (%)</label>
                        @Html.TextBoxFor(model => model.TotalArea, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>

                </div>

                <div class="row">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Current Allotment Rate(psqm)</label>
                        @Html.TextBoxFor(model => model.AllotmentRate, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Location Charge(psqm)</label>
                        @Html.TextBoxFor(model => model.LocationCharge, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Total Allotment Rate At time of transfer(psqm)</label>
                        @Html.TextBoxFor(model => model.TotalAllotmentRate, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Total Property Cost At time of transfer</label>
                        @Html.TextBoxFor(model => model.TotalPremiumAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>

                </div>
                <div class="row">

                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Transfer Amount</label>
                        @Html.TextBoxFor(model => model.RegistrationAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Lease Rent</label>
                        @Html.TextBoxFor(model => model.AllotmentMoney, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>One Time Lease Rent</label>
                        @Html.TextBoxFor(model => model.AdvanceLeaseRentAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Revised Lease Rent</label>
                        @Html.TextBoxFor(model => model.AdvanceLeaseRentAmount, htmlAttributes: new { @class = "form-control", @maxlength = "8" })
                    </div></div>
                <div class="row">
                    
                </div>

                <div class="row">
                    <div class="col-md-12" style="text-align:right;">
                        @*<input type="button" class="btn btn-default" value="NDA Calculation" />*@
                        <input type="button" class="btn btn-default" value="One Time Lease Rent" />
                    </div>
                </div>
            </div>

            <h2 class="blck-heading" style="margin-bottom:0;">Installment Schedule</h2>
            <div class="col-md-12 k-grid-content">
                @(Html.Kendo().Grid<NA.PMS.Model.PaymentScheduleModel>()
                .Name("InstallmentScheduleGrid")
                .Columns(columns =>
                {
                    columns.Bound(c => c.ScheduleId).Hidden(true);
                    columns.Bound(c => c.InstallmentNo).Title("I No.").Width(50);
                    columns.Bound(c => c.InstallmentDueDate).Title("Due Date").Width(100).Format("{0:dd-MMM-yyyy}");
                    columns.Bound(c => c.InstallmentAmount).Title("Installment").Width(100);
                    columns.Bound(c => c.InstallmentInterest).Title("Interest").Width(100);
                    columns.Bound(c => c.BalanceAmount).Title("Balance").Width(110).Sortable(false);
                    columns.Bound(c => c.PenaltyAmount).Title("Penalty").Width(110);
                    //columns.Bound(c => c.CurrentBalance).Title("C Balance").Width(110).Sortable(false);
                    columns.Bound(c => c.CurrentDues).Title("Current Dues").Width(100).Sortable(false);
                    columns.Bound(c => c.DepositDate).Title("Payment Date").Width(110).Format("{0:dd-MMM-yyyy}");
                    columns.Bound(c => c.DepositAmount).Title("Paid Amount").Width(110).Sortable(false);
                    columns.Bound(c => c.ChallanRefId).Title("Challan Id").Width(110).Sortable(false);
                    //columns.Bound(c => c.PenalInterest).Title("PI(%)").Width(80).Sortable(false);
                    columns.Bound(c => c.InstallmentStatus).Title("Status").Width(90).Sortable(false);
                    //columns.Bound(c => c.Id).Title("Edit").ClientTemplate("#if(IsActive==true){# <a href=\"/Revenue/Payment/Installment/#= Id#\" id='e_#=Id#'><span class='glyphicon glyphicon-pencil'></span></a> #}else{# --- #}#").Filterable(false).Sortable(false).Width(50);
                    //columns.Bound(c => c.Id).Title("Delete").ClientTemplate("<label class='hyperlink' onclick='javascript:RemovePremiumSchedule(this)'>Delete<i class='fa fa-remove'></i></label>").Filterable(false).Sortable(false).Width(110);
                })
                .Resizable(resize => resize.Columns(true))
                        //.Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                        //.Editable(editable => editable.Mode(GridEditMode.InCell))
                        //.ToolBar(toolbar => toolbar.Save())
                .DataSource(dataSource => dataSource
                    .Ajax().ServerOperation(true).Batch(true)
                    .Model(model => model.Id(m => m.Id))
                    //.Model(model=>
                    //{
                    //    model.Id(p => p.Id);
                    //    model.Field(c => c.InstallmentDueDate).Editable(false);
                    //    model.Field(c => c.InstallmentNo).Editable(false);
                    //    model.Field(c => c.InstallmentAmount).Editable(false);
                    //    //model.Field(c => c.PrincipalAmount).Editable(false);
                    //})

                    .Read(read => read.Action("GetInstallmentPaymentScheduleById", "Finance", new { area = "Revenue" }).Data("FilterRegistrationId"))
                    .Sort(s => s.Add(i => i.InstallmentNo).Ascending())//.PageSize(20)
                        //.Update("UpdateInstallmentSchedulePaymentById", "Finance", new { area = "Revenue" })
                    )
                )
            </div>

            <div class="form-bx">
                <div class="row form-group">
                    <div class="col-md-3">
                        <input type="button" class="k-button" id="btn-calculate" value="Calculate Dues" style="margin-top:12px;" />
                    </div>
                    <div class="col-md-6"></div>
                    <div class="col-md-3" style="text-align:right;">
                        @*<input type="text" class="form-control" id="total-dues" placeholder="Total Dues" style="margin-top:12px;" />*@
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


<div class="kendo-popup-window" id="div-popup-window" style="background:url(/Content/Images/boxed-bg.jpg) repeat">
    <div class="row">
