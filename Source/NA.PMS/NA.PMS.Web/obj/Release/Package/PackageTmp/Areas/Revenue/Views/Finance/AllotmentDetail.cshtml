        </div>
        <div class="col-md-4 col-md-6 col-popup form-group">
            <label>GST Amount</label>
            @Html.TextBoxFor(model => model.GSTAmount, htmlAttributes: new { @class = "k-textbox", @maxlength = "18", style = "width:95%; float:right;" })
        </div>
        <div class="col-md-4 col-md-6 col-popup form-group">
            <label>Paid Amount</label>
            @Html.TextBoxFor(model => model.DepositAmount, htmlAttributes: new { @class = "k-textbox", @maxlength = "18", style = "width:95%; float:right;" })
