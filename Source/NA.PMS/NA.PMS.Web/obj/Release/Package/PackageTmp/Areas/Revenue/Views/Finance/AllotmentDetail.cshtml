            <label>Challan</label>
            @Html.TextBoxFor(model => model.TransactionId, htmlAttributes: new { @class = "k-textbox", @maxlength = "18", style = "width:95%; float:right;" })
        </div>
        <div class="col-md-4 col-md-6 col-popup form-group">
            <label>Payment Date</label>
            @(Html.Kendo().DatePickerFor(model => model.DepositDate).HtmlAttributes(new { @class = "", style = "width:95%; float:right;" }))
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 form-group k-grid-content">
            @(Html.Kendo().Grid<NA.PMS.Model.PaymentScheduleModel>()
                .Name("TempChallanGrid")
                .Columns(columns =>
                {
                    //columns.Bound(c => c.ScheduleId).Hidden(true);
                    columns.Bound(c => c.RefId).Title("SNo.").Width(50);
                    columns.Bound(c => c.ReceiptHead).Title("Head");
                    columns.Bound(c => c.ReceiptSubHead).Title("Sub Head");
                    columns.Bound(c => c.DepositAmount).Title("Paid Amount").Width(110).Sortable(false);
                    //columns.Bound(c => c.RefId).Title(" ").ClientTemplate("#if(IsActive==true){# <a href=\"/Revenue/Payment/Installment/#= Id#\" id='e_#=Id#'><span class='glyphicon glyphicon-pencil'></span></a> #}else{# --- #}#").Filterable(false).Sortable(false).Width(50);
                    columns.Bound(c => c.RefId).Title(" ").Width(110).ClientTemplate("<label class='hyperlink' onclick='javascript:RemoveTempChallan(#=RefId#)'>Delete<i class='fa fa-remove'></i></label>").Filterable(false).Sortable(false);
                })
                .Resizable(resize => resize.Columns(true))
                .DataSource(dataSource => dataSource
                    .Ajax().ServerOperation(true).Batch(true)
                    .Model(p => p.Id(m => m.Id))
                    .Read(read => read.Action("GetSavedTempChallanDetail", "Finance", new { area = "Revenue" }).Data("FilterRegistrationId"))
                    )
            )
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 form-group" style="text-align:right">
            <input type="button" class="k-button" value="Add" id="btn-challan-amount" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 form-group" style="text-align:center;">
            <input type="button" class="k-button" value="Cancel" id="btn-cancel" />
            <input type="button" class="k-button" value="Save" id="btn-save-payment" />
        </div>
    </div>
</div>




<script type="text/javascript">
    $(document).ready(function () {
        //$(".k-grid#DepositDate").kendoDatePicker();

        $('.kendo-popup-window').kendoWindow({
            modal: true,
            title: "Add Payment",
            actions: ["Refresh", "Pin", "Minimize", "Maximize", "Close"],
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "30%"
            },
            width: "65%",// height: "35%"
        });

        $('#btn-remove').click(function () {
            RemoveRepeatedSchedule();
        });

        $('#btn-generate').click(function () {
            GeneratePremiumSheduleByDepartment();
        });

        $('#btn-cancel').click(function () {
            $('.kendo-popup-window').data("kendoWindow").close();
        });

        $('#btn-save-payment').click(function () {
            SavePaymentDetail();
        });

        $('#pop-input-amount').change(function () {
            CalculatePaidAmount();
        });
        $('#GSTAmount').change(function () {
            CalculatePaidAmount();
        });

        $('#btn-challan-amount').click(function () {
            if (ValidateChallanData()) {
                SaveChallanTempData();
            }
        });

        $('#btn-calculate').click(function () {
            if ($('#RegistrationId').val() != "") {
                CalculateDuesPayment();
            }
            else alertify.error("Please select Registration Id");
        });

        $('.k-i-refresh').click(function () {
            $('.kendo-popup-window').data("kendoWindow").refresh();
        });
    });

    function CalculatePaidAmount() {
        var amount = $('#pop-input-amount').val();
        var gst = $('#GSTAmount').val();
        amount = amount != "" ? parseInt(amount) : 0;
        gst = gst != "" ? parseInt(gst) : 0;
        var total = parseInt(amount) + parseInt(gst);

        $('#DepositAmount').val(total);
        $('#DepositAmount').attr("readonly", true);
    }

    function ChangeDepartmentEvent() {
        $("#InstallmentScheduleGrid").data("kendoGrid").dataSource.read();
    }

    function FilterAccountHeadId() {
        return {
            id: $("#ReceiptHeadId").val()
        };
    }

    function DisplayWindow() {
        if ($('#RegistrationId').val() != "") {
            $('.kendo-popup-window').data("kendoWindow").open();
            $('.kendo-popup-window').data("kendoWindow").center();
        }
        else {
            alertify.error("Please select RegistrationId");
        }
    }

    function productNameEditable(dataItem) {
        // do not allow editing for product with ProductID=3
        return dataItem.ProductID != 3;
    }

    function ChangeInRegistrationIdEvent() {
        //$("#InstallmentScheduleGrid").data("kendoGrid").dataSource.read();
        var rid = $('#RegistrationId').val();
        if (rid != "") {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ ActionType: "Registered", RegistrationId: rid }),
                url: "/Revenue/Finance/GetPropertyDetailsById",
                success: function (result) {
                    if (result != null) {
                        $('#DepartmentId').val(result.DepartmentId);
                        $('#Department').val(result.Department);
                        $('#Applicant').val(result.Applicant);
                        $('#PropertyNo').val(result.PropertyNo);
                        $('#LeaseDeedDate').data("kendoDatePicker").value(result.RegistryDate);
                        $('#TotalArea').val(result.TotalArea);
                        $('#TotalPropertyCost').val(result.TotalPropertyCost);
                        $('#AllotmentMoney').val(result.AllotmentMoney);
                        $('#InstallmentAmount').val(result.InstallmentAmount);
                        $('#LeaseRentPerAnnum').val(result.LeaseRentPerAnnum);
                        $('#RentRevisedDuration').val(result.RentRevisedDuration);
                        $("#InstallmentScheduleGrid").data("kendoGrid").dataSource.read();
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                }
            })
        }
    }

    function FilterRegistrationId() {
        var model = { RegistrationId: $("#RegistrationId").val(), ActionType: "InstallmentRequest" };
        return model;
    }

    function SaveChallanTempData() {
        var kendoWidget = $('.kendo-popup-window').data("kendoWindow");
        kendo.ui.progress(kendoWidget.element, true);
        var paymodel = {
            RegistrationId: $('#RegistrationId').val(),
            DepartmentId: $('#DepartmentId').val(),
            ReceiptHeadId: $('#ReceiptHeadId').val(),
            ReceiptHead: $('#ReceiptHeadId').data("kendoDropDownList").text(),
            ReceiptSubHeadId: $('#ReceiptSubHeadId').val(),
            ReceiptSubHead: $('#ReceiptSubHeadId').data("kendoDropDownList").text(),
            InstallmentAmount: $('#pop-input-amount').val(),
            GSTAmount: $('#GSTAmount').val(),
            BankId: $('#BankId').val(),
            DepositAmount: $('#DepositAmount').val(),
            PaymentMode: $('#PaymentMode').val(),
            TransactionId: $('#TransactionId').val(),
            DepositDate: $('#DepositDate').val(),
        };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: paymodel }),
            url: "/Revenue/Finance/SaveTempChallanDetail",
            success: function (result) {
                if (result == '@ReturnType.Saved') {
                    $('#TempChallanGrid').data('kendoGrid').dataSource.read();
                    //$('.kendo-popup-window').data("kendoWindow").close();
                    kendo.ui.progress(kendoWidget.element, false);
                    alertify.success("Record has been saved successfully.");
                }
                if (result == '@ReturnType.None') {
                    $('#TempChallanGrid').data('kendoGrid').dataSource.read();
                    kendo.ui.progress(kendoWidget.element, false);
                    //$('.kendo-popup-window').data("kendoWindow").close();
                    alertify.error("Records aren't saved.");
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
            }
        })
    }

    function SavePaymentDetail() {
        if (ValidatePaymentDetail()) {
            var kendoWidget = $('.kendo-popup-window').data("kendoWindow");
            kendo.ui.progress(kendoWidget.element, true);
            var paymodel = {
                RegistrationId: $('#RegistrationId').val(),
                DepartmentId: $('#DepartmentId').val(),
                ReceiptHeadId: $('#ReceiptHeadId').val(),
                ReceiptSubHeadId: $('#ReceiptSubHeadId').val(),
                InstallmentAmount: $('#pop-input-amount').val(),
                GSTAmount: $('#GSTAmount').val(),
                BankId: $('#BankId').val(),
                DepositAmount: $('#DepositAmount').val(),
                PaymentMode: $('#PaymentMode').val(),
                TransactionId: $('#TransactionId').val(),
                DepositDate: $('#DepositDate').val(),
            };
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ model: paymodel }),
                url: "/Revenue/Finance/AddInstallmentPaymentBySchedule",
                success: function (result) {
                    if (result == '@ReturnType.Updated') {
                        ClearChallanInputFields();
                        $('#InstallmentScheduleGrid').data('kendoGrid').dataSource.read();
                        $('.kendo-popup-window').data("kendoWindow").close();
                        kendo.ui.progress(kendoWidget.element, false);
                        alertify.success("Record has been updated successfully.");
                    }
                    if (result == '@ReturnType.None') {
                        $('#InstallmentScheduleGrid').data('kendoGrid').dataSource.read();
                        kendo.ui.progress(kendoWidget.element, false);
                        //$('.kendo-popup-window').data("kendoWindow").close();
                        alertify.error("Records aren't updated.");
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                }
            })
        }
    }

    function RemoveTempChallan(id) {
        var flag = confirm("Are You sure to remove this detail.");
        if (flag) {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ RefId: id, RegistrationId: $('#RegistrationId').val() }),
                url: "/Revenue/Finance/RemoveTempChallanDataById",
                success: function (result) {
                    if (result == '@ReturnType.Removed') {
                        alertify.success("Record has been removed successfully.");
                        $('#TempChallanGrid').data('kendoGrid').dataSource.read();
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                }
            })
        }
    }

    function CalculateDuesPayment() {
        var flag = confirm("Are You sure to update dues.");
        if (flag) {
            var kendoWidget = $('#InstallmentScheduleGrid').data('kendoGrid');
            kendo.ui.progress(kendoWidget.element, true);
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ RegistrationId: $('#RegistrationId').val() }),
                url: "/Revenue/Finance/UpdatePaymentDuesById",
                success: function (result) {
                    if (result.ReturnTypeId == '@ReturnType.Updated') {
                        kendo.ui.progress(kendoWidget.element, false);
                        alertify.success("Record has been updated successfully.");
                        $('#InstallmentScheduleGrid').data('kendoGrid').dataSource.read();
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                }
            })
        }
    }

    function ValidatePaymentDetail() {
        var flag = true;
        if ($('#RegistrationId').val() == "") {
            alertify.error("Please Select Registration Id.");
            return flag = false;
        }
        if ($('#BankId').val() == "") {
            alertify.error("Please Select Bank Name.");
            return flag = false;
        }
        if ($('#PaymentMode').val() == "") {
            alertify.error("Please Select Payment mode.");
            return flag = false;
        }
        if ($('#TransactionId').val() == "") {
            alertify.error("Please enter challan Id.");
            return flag = false;
        }
        if ($('#DepositDate').val() == "") {
            alertify.error("Please enter diposit date.");
            return flag = false;
        }
        return flag;
    }

    function ValidateChallanData() {
        var flag = true;
        if ($('#RegistrationId').val() == "") {
            alertify.error("Please select RegistrationId");
            return flag = false;
        }
        if ($('#ReceiptHeadId').val() == "") {
            alertify.error("Please select Receipt head Id");
            return flag = false;
        }
        if ($('#ReceiptSubHeadId').val() == "") {
            alertify.error("Please select Receipt sub head Id");
            return flag = false;
        }
        if ($('#pop-input-amount').val() == "") {
            alertify.error("Please enter Installment Amount");
            return flag = false;
        }
        return flag;
    }

    function ClearChallanInputFields() {
        $('#BankId').data("kendoDropDownList").value('');
        $('#ReceiptHeadId').data("kendoDropDownList").value('');
        $('#ReceiptSubHeadId').data("kendoDropDownList").value('');
        $('#PaymentMode').data("kendoDropDownList").value('');
        $('#pop-input-amount').val('');
        $('#TransactionId').val('');
        $('#DepositDate').val('');
        $('#GSTAmouont').val('');
    }

    function RemovePremiumSchedule(row) {
        var tr = $(row).parent().parent();
        var scheduleId = $(tr).children("td:eq(1)").text();
        var rid = $(tr).children("td:eq(2)").text();
        if (rid != "" && scheduleId != "") {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ ScheduleId: scheduleId, RegistrationId: rid }),
                url: "/Revenue/Payment/RemovePropertyPremiumScheduleById",
                success: function (result) {
                    if (result == '@ReturnType.Removed') {
                        alertify.success("Record has been removed successfully.");
                        $('#InstallmentScheduleGrid').data('kendoGrid').dataSource.read();
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                }
            })
        } else {
            alertify.error("ScheduleId or RegistrationId not selected.");
            return false;
        }
    }


    function RemoveRepeatedSchedule() {
        var departmentId = $('#DepartmentId').val();
        if (departmentId != "") {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ DepartmentId: departmentId }),
                url: "/Revenue/Payment/RemovePremiumScheduleByDepartment",
                success: function (result) {
                    if (result == '@ReturnType.Removed') {
                        alertify.success("Record has been removed successfully.");
                        $('#InstallmentScheduleGrid').data('kendoGrid').dataSource.read();
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                }
            })
        } else {
            alertify.error("Please select Department.");
            return false;
        }
    }

    function GeneratePremiumSheduleByDepartment() {
        var departmentId = $('#DepartmentId').val();
        if (departmentId != "") {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ DepartmentId: departmentId }),
                url: "/Revenue/Payment/GeneratePremiumScheduleByDepartment",
                success: function (result) {
                    if (result == '@ReturnType.Saved') {
                        alertify.success("Schedule has been generated successfully.");
                        $('#InstallmentScheduleGrid').data('kendoGrid').dataSource.read();
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                }
            })
        } else {
            alertify.error("Department not selected.");
            return false;
        }
    }
</script>




