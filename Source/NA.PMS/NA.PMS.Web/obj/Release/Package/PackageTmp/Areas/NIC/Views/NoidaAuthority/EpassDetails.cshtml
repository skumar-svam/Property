@model NA.PMS.NICServices.SWPEpassViewModel
@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@using NA.PMS.Common
@{
    ViewBag.Title = "EpassDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .form-control {
        width: 90%;
