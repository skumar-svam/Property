</style>
<div class="PropertyDetails col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12">
                <h1 class="gridTitle">Covid-19 Curfew Epass Details</h1>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="user-template" style="padding-top:30px;">
        <div class="col-md-12" id="kya-form-content" style="border:solid #e2e3e4; border-width:0 1px 1px; margin-bottom:15px;">
            <div class="row">
                <input type="hidden" id="hdnOTP" />
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(model => model.StatusId, htmlAttributes: new { @id = "hdn-status-id" })
            </div>
            <div class="row" style="padding-top:30px;">
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-md-4 col-sm-6 col-xs-12 form-group">
                            <label>Epass No</label>
                        </div>
                        <div class="col-md-8 col-sm-6 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.EpassNo, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="row ">
                        <div class="col-md-4 col-sm-6 col-xs-12 form-group">
                            <label>Epass Type</label>
                        </div>
                        <div class="col-md-8 col-sm-6 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.EpassType, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 col-sm-6 col-xs-12 form-group">
                            @Html.Label("Applicant Name", htmlAttributes: new { @class = "" })
                        </div>
                        <div class="col-md-8 col-sm-6 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 col-sm-6 col-xs-12 form-group">
                            @Html.Label("Mobile No", htmlAttributes: new { @class = "" })
                        </div>
                        <div class="col-md-8 col-sm-6 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.MobileNo, new { @class = "form-control", @maxlength = "10", @readonly = "readonly" })
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-md-6 col-sm-6 col-xs-12"></div>
                        <div class="col-md-6 col-sm-6 col-xs-12 form-group">
                            <div class="row">
                                @{
                                    if (Model.PhotoPath != null)
                                    {
                                        <div class="col-md-10 text-right" style="margin-top:5px;margin-bottom:5px;">
                                            <img id="userphoto1" src="@Model.PhotoPath" alt="your image" height="150" width="140" name="userImage2" />
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @*<div class="row" style="margin-top:12px;">
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <label>Epass No</label>
                    </div>
                    <div class="col-md-3">
                        @Html.TextBoxFor(model => model.EpassNo, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.Label("Pass Type", new { id = "lbl-kyaid" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.TextBoxFor(model => model.EpassType, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <label>Applicant Name</label>
                    </div>
                    <div class="col-md-3">
                        @Html.TextBoxFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.Label("Mobile No", new { id = "lbl-kyaid" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.TextBoxFor(model => model.MobileNo, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>*@
            <div class="row">
                <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                    <label>Email Id</label>
                </div>
                <div class="col-md-4">
                    @Html.TextBoxFor(model => model.Email, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                </div>
                <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                    <label>Correspond Address</label>
                </div>
                <div class="col-md-4">
                    @Html.TextBoxFor(model => model.FromAddress, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                </div>
            </div>

            <div class="row" style="margin-top:12px;">
                <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                    <label>District</label>
                </div>
                <div class="col-md-4">
                    @Html.TextBoxFor(model => model.City, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                </div>
                <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                    @Html.Label("state")
                </div>
                <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                    @Html.TextBoxFor(model => model.State, new { @class = "form-control", @readonly = "readonly" })
                </div>
            </div>
            @*<div class="row">

                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.Label("Destination", new { id = "lbl-kyaid" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.TextAreaFor(model => model.ToAddress, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>*@
            <div class="row">
                <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                    @Html.Label("ID Proof Type")
                </div>
                <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                    @Html.TextBoxFor(model => model.EPDV, new { @class = "form-control", @readonly = "readonly" })
                </div>
                <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                    <label>ID proof No</label>
                </div>
                <div class="col-md-4">
                    @Html.TextBoxFor(model => model.EPDIII, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                </div>

            </div>

            <div class="row">
                @{
                    if (Model.EpassType == "Vehicle")
                    {

                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Vehicle Type")
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.VehicleType, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            <label>Vehicle No</label>
                        </div>
                        <div class="col-md-4">
                            @Html.TextBoxFor(model => model.VehicleNo, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    }
                }

            </div>
            <div class="row">
                @{
                    if (Model.EpassType == "Vehicle")
                    {

                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Vehicle")
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.EPDIV, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    }
                }

            </div>
            <div class="row">
                @{
                    if (Model.IsApproved == true)
                    {
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            <label id="lbl-approver">Approved By</label>
                        </div>
                        <div class="col-md-4">
                            @Html.TextBoxFor(model => model.Approver, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Approval Date", new { @id = "lbl-appDate" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DatePickerFor(m => m.ApprovalDate).HtmlAttributes(new { style = "width:90%;", @readonly = "readonly" }))
                        </div>
                    }
                }

            </div>
            <div class="row">
                @{
                    if (Model.StatusId == 1)
                    {
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Valid Till Date")
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DatePickerFor(m => m.EndDate).HtmlAttributes(new { style = "width:90%;", @readonly = "readonly" }))
                        </div>
                    }
                }

            </div>

            <div class="col-md-12 alot-prop-grid k-grid-content" style="padding:10px;">
                @(Html.Kendo().Grid<NA.PMS.Model.EpassViewModel>()
            .Name("GridEpassDocument")
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                //columns.Bound(c => c.PhotoPath).Title("User Photo").ClientTemplate("#if(PhotoPath != null){#<label style='color:blue;'  class='hyperlink' onclick='javascript:DisplayDocument(\"#=PhotoPath#\")'>User Photo</label> #}#");
                columns.Bound(c => c.UserIdPath).Title("Id Proof").ClientTemplate("#if(UserIdPath != null){#<label style='color:blue;'  class='hyperlink' onclick='javascript:DisplayDocument(\"#=UserIdPath#\")'>#=EPDV#</label> #}#");
                columns.Bound(c => c.RCPath).Title("Registration Certificate").ClientTemplate("#if(RCPath != null){#<label style='color:blue;'  class='hyperlink' onclick='javascript:DisplayDocument(\"#=RCPath#\")'>RC</label> #}#");
                //columns.Bound(c => c.LicencePath).Title("Driving Licence").ClientTemplate("#if(LicencePath != null){#<label style='color:blue;'  class='hyperlink' onclick='javascript:DisplayDocument(\"#=LicencePath#\")'>Driving Licence</label> #}#");
            })
            .AutoBind(true)
            .DataSource
            (
                dataSource => dataSource
                .Ajax()
                .Model(model => model.Id(p => p.Id))
                .ServerOperation(true)
                .Read(read => read.Action("GetAllEpassList", "NoidaAuthority", new { area = "NIC" }).Data("FilterSearchParameter"))
            )
                )
            </div>

            <div class="row" style="padding:10px;">
                <div class="col-md-12 col-sm-12 col-xs-12 " style="text-align:right;">
                    @{

                        if (Model.IsApproved == null)
                        {

                            <input type="button" id="btnValidate" value="Approve/Reject" class="btn btn-primary" style="min-width:100px; margin-right:12px;border-radius:0;" />

                        }
                        <input type="button" id="btn-cancel" value="Back" class="btn btn-primary" style="width:100px; margin-right:12px;border-radius:0;" />
                    }
                </div>


            </div>
        </div>
    </div>
</div>



<div class="col-md-12" id="divPopupWindow" style="min-height:300px;background:url(/Content/Images/boxed-bg.jpg) repeat">
    <div class="row form-group">
        @*@Html.HiddenFor(m => m.Id)*@
        <div class="col-md-3 col-sm-12 col-xs-12 form-group">
            <label>Service Status</label>
        </div>
        <div class="col-md-6">
            @(Html.Kendo().DropDownList()
            .Name("ddlStatus")
                .DataTextField("Text")
                .DataValueField("Value")
                .OptionLabel(" --- Select ---")
                .BindTo(new List<SelectListItem>() {
                    new SelectListItem() { Text = "Approve", Value = "1" },
                    new SelectListItem() { Text = "Reject", Value = "2" }
                })
                    //.Events(e => e.Change("KYAParameterChangeEvent"))
                .HtmlAttributes(new { @class = "input-disabled", style = "width:100%; float:right;" })
            )
        </div>
    </div>
    <div class="row" style="margin-top:25px;">
        <div class="col-md-3 col-sm-12 col-xs-12 form-group">
            <label>Remarks</label>
        </div>
        <div class="col-md-8 col-sm-12 col-xs-12 form-group">
            @Html.TextAreaFor(model => model.Comment, htmlAttributes: new { @class = "form-control", @id = "txtComment" })
            @*<input type="text" class="k-textbox" id="txtotp" maxlength="10" placeholder="enter otp here" style="width:100%" />*@
        </div>
    </div>
    <div class="row">
        <div class="col-md-3 col-sm-12 col-xs-12 form-group">

        </div>
        <div class="col-md-8 col-sm-12 col-xs-12 form-group">
            <input type="button" class="k-button" id="btnCancelPopup" value="Cancel" style="width:100px" />
            <input type="button" class="k-button" id="btnSubmitComment" value="submit" style="width:100px" />
        </div>
    </div>
</div>

<div class="col-md-12 popup-window" id="DocumentWindow" style="min-height:500px;background:url(/Content/Images/boxed-bg.jpg) repeat;">
    <div class="row form-group" id="divLetterContent" style="height:500px; overflow:auto;">

    </div>
    @*<div class="row">
            <div class="col-md-12" style="text-align:center">
                <button type="button" class="k-button" onclick="PrintLetter();" style="width:100px;">Print</button>
                <button type="button" class="k-button" onclick="CloseLetter();" style="width:100px;">Close</button>
            </div>
        </div>*@
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var status = $('#hdn-status-id').val();
        if (status == '1') {
            $('#lbl-approver').html("Approved By");
            $('#lbl-appDate').html("Approval Date");
        }
        else {
            $('#lbl-approver').html("Rejected By");
            $('#lbl-appDate').html("Rejected Date");
        }

        $('#divPopupWindow').kendoWindow({
            modal: true,
            title: "Validate Covid-19 Pass",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "30%"
            },
            width: "50%", height: "35%"
        });
        $('.popup-window').kendoWindow({
            modal: true,
            title: "View Document",
            //actions: false,
            //actions: ["Pin", "Minimize", "Maximize", "Close"],
            visible: false,
            width: "75%"
        });

        $('#btnCancelPopup').click(function () {
            $("#divPopupWindow").data("kendoWindow").close();
        });

        $('#btnSubmitComment').click(function () {
            UpdateEpass();
        });
        $('#btnValidate').click(function () {
            $("#divPopupWindow").data("kendoWindow").center();
            $("#divPopupWindow").data("kendoWindow").open();
        });
        $('#btn-Cancel').click(function () {
            window.location.href = "/NIC/NoidaAuthority/ManageOnlineEpass";
        });

    });
    function UpdateEpass() {
        if (ValidateActionField()) {
            var model = {
                Id: $('#Id').val(),
                StatusId: $('#ddlStatus').data("kendoDropDownList").value(),
                Comment: $('#txtComment').val()
            };
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ model: model }),
                url: '/NIC/NoidaAuthority/ValidateEpass',
                success: function (result) {
                    if (result == '@ReturnType.None') {
                        $('#divPopupWindow').data("kendoWindow").close();
                        alertify.error("provider failed to update status.");
                    }
                    else if (result == '@ReturnType.Approved') {
                        $('#divPopupWindow').data("kendoWindow").close();
                        alertify.success("Data approved successfully.");
                        //$("#GridEpass").data("kendoGrid").dataSource.read();
                    }
                    else if (result == '@ReturnType.Rejected') {
                        $('#divPopupWindow').data("kendoWindow").close();
                        alertify.success("KYA rejected successfully.");
                        //$("#GridEpass").data("kendoGrid").dataSource.read();
                    }
                    window.location.reload();
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Network error, try again later");
                }
            });
        }

    }
    function ValidateActionField() {
        var flag = true;
        if ($('#ddlStatus').val() == "") {
            alertify.error("Select status");
            flag = false;
        }
        if ($('#txtComment').val() == "") {
            alertify.error("Enter remarks");
            flag = false;
        }
        return flag;
    }
    function FilterSearchParameter() {
        return {
            Id: $('#Id').val()
        };
    }
    function DisplayDocument(path) {
        $("#divLetterContent").empty();
        $("#divLetterContent").append($('<iframe src=' + path + ' style="width:100%;min-height:500px;"></iframe>'));
        $("#DocumentWindow").data("kendoWindow").center();
        $("#DocumentWindow").data("kendoWindow").open();
    }
</script>
