
@model NA.PMS.Model.AllotmentViewModel
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
@using NA.PMS.Common;

@{
    ViewBag.Title = "Allotment Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .btn {
        margin-top: 20px;
    }

    .applicant-grid, .property-grid, .row-btn-action {
        display: none;
    }

    .hyperlink{
        cursor:pointer;
        color:blue;
    }
</style>

<div id="ManageAllotment">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Allotment Requests</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">

            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12" style="border:solid #e2e3e4; border-width:0 1px 1px">
        <div class="row" style="padding:12px 30px 12px 0;">
            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                @Html.Label("Scheme Name")
                @(Html.Kendo().DropDownListFor(model => model.SchemeId)
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    //.DataSource(source => source.Read(read => read.Action("GetSchemeList", "Allotment", new { area = "Property" })))
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetSchemeListAsDataSource", "Allotment", new { area = "Property" })))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                    .Enable(true)
                    .AutoBind(true)
                    .Filter("contains")
                    .HtmlAttributes(new { style = "width:90%; float:right;", @class = "input-disabled" })
                    .Events(e => e.Change("ChangeInSchemeAndDepartment"))
                )
            </div>
            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                @Html.Label("Department")
                @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .CascadeFromField("SchemeId")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetDepartmentListBySchemeId", "Allotment", new { area = "Property" }).Data("FilterSchemeId")))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                    .CascadeFrom("SchemeId")
                    .Events(events => { events.Change("ChangeInSchemeAndDepartment"); })
                    .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                )
            </div>

            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                @Html.Label("Form No")
                @(Html.Kendo().DropDownListFor(model => model.FormNo)
                    .DataTextField("Value")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .Enable(true)
                    .AutoBind(true)
                    .Filter("contains")
                    .CascadeFromField("DepartmentId")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetApplicationFormListByScheme", "Allotment", new { area = "Property" }).Data("FilterParam")))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                    .CascadeFrom("DepartmentId")
                    .HtmlAttributes(new { style = "width:90%; float:right;", @class = "input-disabled" })
                            .Events(e => e.Change("ChangeApplicationFormNoEvent"))
                )
            </div>
            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                @Html.Label("Property")
                @(Html.Kendo().DropDownListFor(m => m.PropertyId)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .CascadeFrom("DepartmentId")
                    .CascadeFromField("DepartmentId")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetAllottedPropertyIdListAsDataSource", "Allotment", new { area = "Property" }).Data("FilterApplication")))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                   .Events(events => { events.Change("ChangeInSchemeAndDepartment"); })
                   .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                )
            </div>
        </div>

    </div>

    <div class="col-md-12 alot-prop-grid k-grid-content">
        <h2 class="blck-heading" style="margin-bottom:0;">Allotted Property<span class="grid-scheme-header"></span></h2>
        @(Html.Kendo().Grid<NA.PMS.Model.AllotmentViewModel>()
            .Name("GridAllottedProperty")
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.RegistrationId).Title("Registration Id").Width(150);
                columns.Bound(c => c.PropertyId).Title("Property Id").Width(120);
                columns.Bound(c => c.FormNo).Title("Form No").Width(120);
                columns.Bound(c => c.Department).Title("Department").Width(140);
                columns.Bound(c => c.SchemeName).Title("Scheme");
                columns.Bound(c => c.PropertyNo).Title("Property").Width(120);
                columns.Bound(c => c.SubmissionDate).Title("Submitted").Width(130).Format("{0:dd-MMM-yyyy}");
                //columns.Bound(c => c.AllotmentDate).Title("Allotment").Width(130).Format("{0:dd/MM/yyyy}");
                columns.Bound(c => c.AllotmentStatus).Title("Status").Width(100);
            })
            .Sortable()
            .Filterable()
            .Resizable(resize => resize.Columns(true))
            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
            .ClientDetailTemplateId("template")
            .AutoBind(true)
            .DataSource
            (
                dataSource => dataSource
                .Ajax()
                .Model(model => model.Id(p => p.ApplicationId))
                .ServerOperation(true)
                .Read(read => read.Action("GetAllottedPropertyFormListForApproval", "Allotment", new { area = "Property" }).Data("FilterSearchParameter"))
                .Sort(s => s.Add(x => x.SubmissionDate).Descending())
                .PageSize(10)
            ))
    </div>

</div>

<div class="col-md-12 popup-window" id="divStatusMaster" style="min-height:250px;background:url(/Content/Images/boxed-bg.jpg) repeat;">
    <div class="row form-group" style="padding-top:15px;">
        <div class="col-md-3">
            <label>Service Status</label>
        </div>
        <div class="col-md-6">
            @(Html.Kendo().DropDownListFor(model => model.StatusId)
                .Filter("contains")
                .DataTextField("Text")
                .DataValueField("Id")
                .OptionLabel(" -- Select --")
                .DataSource(source =>
                {
                    source.Custom()
                    .ServerFiltering(true)
                    .ServerPaging(true)
                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                    .Transport(transport => transport.Read(read => read.Action("GetStatusListAsDataSource", "Allotment", new { area = "Property" })))
                    .Schema(schema => schema.Data("Data").Total("Total"))
                    .PageSize(100);
                })
                //.Events(events => { events.Change("ChangeDepartmentEvent"); })
                .HtmlAttributes(new { @class = "input-disabled", style = "width:100%; float:right;" })
            )
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-3">
            <label>Comment</label>
        </div>
        <div class="col-md-9">
            @Html.TextAreaFor(model => model.Comment, htmlAttributes: new { @class = "k-textbox", style = "width:93%;height:70px;" })
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-3">
            <input type="hidden" class="hdn-rid" />
        </div>
        <div class="col-md-3">
            <input type="button" class="k-button" id="btnStatusSubmit" value="Submit" style="width:98%;" />
        </div>
        <div class="col-md-3" style="text-align:right;">
            <input type="button" class="k-button" id="btnStatusClose" value="Close" style="width:98%;" />
        </div>
    </div>
</div>


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<NA.PMS.Model.AllotmentViewModel>()
            .Name("grid_#=Id#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(c => c.RegistrationId).Hidden(true);
                columns.Bound(c => c.ApplicationId).Title("Application Id").Width(120);
                columns.Bound(c => c.Applicant).Title("Applicant");
                columns.Bound(c => c.CorresspondAddress).Title("Address");
                columns.Bound(c => c.Approver).Title("Approver").Width(160);
                //columns.Bound(c => c.PropertyNo).Title("Property").Width(120);
                columns.Bound(c => c.AllotmentDate).Format("{0:dd/MM/yyyy}").Width(120);
                //columns.Bound(c => c.AllotmentStatus).Width(120).Title("Update Status").ClientTemplate("#if(UserId == Approver){#<label class='hyperlink' onclick='javascript:OpenStatusWindow(this)'>#=AllotmentStatus#</label>#}else{#<label>#=AllotmentStatus#</label>#}#");
                columns.Bound(c => c.AllotmentStatus).Width(120).Title("Status").ClientTemplate("#if(IsAllotted == false){#<label class='hyperlink' onclick='javascript:OpenStatusWindow(this)'>#=Status#</label>#}else{#<label>#=Status#</label>#}#");
            })
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(10)
                .Read(read => read.Action("GetAllottedPropertyFormListForApproval", "Allotment", new { RegistrationId = "#=RegistrationId#" }))
            )
            .ToClientTemplate()
    )
</script>
<script>
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
</script>


<script>
    $(document).ready(function () {
        $('.popup-window').kendoWindow({
            modal: true,
            title: "Approval Window",
            //actions: false,
            actions: ["Pin", "Close"],
            visible: false,
            width: "40%"
        });

        $('#btnStatusSubmit').click(function () {
            if ($('#StatusId').val() != "" && $('#Comment').val() != "") {
                UpdateAllotmentStatus();                
            }
            else {
                alertify.error("Select Status and write comment.");
                return false;
            }
        });

        $('#btnStatusClose').click(function () {
            $(".popup-window").data("kendoWindow").close();
        });
    });

    function OpenStatusWindow(row) {
        var tr = $(row).parent().parent();
        var id = $(tr).children("td:eq(0)").text();
        $('.hdn-rid').val(id);
        $(".popup-window").data("kendoWindow").center();
        $(".popup-window").data("kendoWindow").open();
    }

    function ChangeInSchemeAndDepartment() {
        if ($('#SchemeId').val() != "") {
            $('.grid-scheme-header').html(" In Scheme: " + $('#SchemeId').data("kendoDropDownList").text());
        }
        else {
            $('.grid-scheme-header').html("");
        }
        $('#GridAllottedProperty').data('kendoGrid').dataSource.read();
    }

    function ChangeApplicationFormNoEvent() {
        if ($('#FormNo').val() == "") {
            $('#PropertyId').data('kendoDropDownList').value('');
        }
        $('#PropertyId').data('kendoDropDownList').dataSource.read();
        $('#GridAllottedProperty').data('kendoGrid').dataSource.read();
    }

    function FilterSchemeId() {
        return { schemeId: $('#SchemeId').val() };
    }

    function FilterParam() {
        return {
            schemeId: $('#SchemeId').val(),
            departmentId: $('#DepartmentId').val()
        };
    }

    function FilterApplication() {
        return {
            schemeId: $('#SchemeId').val(),
            departmentId: $('#DepartmentId').val(),
            applicationId: $('#FormNo').val()
        };
    }

    function FilterSearchParameter() {
        var model = {
            SchemeId: $('#SchemeId').val(),
            DepartmentId: $('#DepartmentId').val(),
            ApplicationId: $('#FormNo').val(),
            PropertyId: $('#PropertyId').val()
        };
        return model;
    }

    function UpdateAllotmentStatus() {
        var model = {
            RegistrationId: $('.hdn-rid').val(),
            StatusId: $('#StatusId').val(),
            Comment: $('#Comment').val()
        };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: model }),
            url: '/Property/Allotment/UpdateAllottedPropertyStatus',
            success: function (result) {
                $(".popup-window").data("kendoWindow").close();
                if (result == '@ReturnType.Allotted') {
                    $('#GridAllottedProperty').data('kendoGrid').dataSource.read();
                    alertify.success("Allotted property approved successfully.");
                }
                if (result == '@ReturnType.NotAllotted') {
                    $('#GridAllottedProperty').data('kendoGrid').dataSource.read();
                    alertify.error("Allotted property is not approved, try again.");
                }
                if (result == '@ReturnType.None') {
                    $('#GridAllottedProperty').data('kendoGrid').dataSource.read();
                    alertify.error("Provider failed to load data.");
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Network error.");
            }
        });
    }


</script>



