                                columns.Bound(c => c.TotalAmount).Title("Total Amount Of Generated Challan");//.ClientFooterTemplate("<div>#= sum #</div>"); 
                                columns.Bound(c => c.DepositedAmount).Title("Deposited Amount By Challan");//.ClientFooterTemplate("<div>#= sum #</div>");
                                columns.Bound(c => c.NotDepositedAmount).Title("Not Deposited Amount");//.ClientFooterTemplate("<div>#= sum #</div>");
                            })
                            .Resizable(resize => resize.Columns(true))
                            //.Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(new[] { 10, 50, 100, 500 }).Info(true).PreviousNext(true).Input(true).Numeric(true).ButtonCount(10))
                            .AutoBind(true)
                            .DataSource
                            (
                                dataSource => dataSource
                                .Ajax().ServerOperation(true)
                                .Read(read => read.Action("GetChallanReportsForGraph", "Authority", new { area = "Member" }).Data("FilterParamForGrid"))
