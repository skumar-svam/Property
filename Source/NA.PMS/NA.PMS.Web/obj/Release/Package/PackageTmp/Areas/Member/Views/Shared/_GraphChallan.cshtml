            <label>Start Date</label>
            @(Html.Kendo().DatePicker().Name("ChallanStartDate").Events(e => e.Change("ChallanDateChangeEvent")).HtmlAttributes(new { style = "width:90%;" }))
        </div>
        <div class="col-md-3">
            <label>End Date</label>
            @(Html.Kendo().DatePicker().Name("ChallanEndDate").Events(e => e.Change("ChallanDateChangeEvent")).HtmlAttributes(new { style = "width:90%;" }))
        </div>
    </div>
