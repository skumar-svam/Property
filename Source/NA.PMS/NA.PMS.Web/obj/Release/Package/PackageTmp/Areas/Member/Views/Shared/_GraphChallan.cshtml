                    <div class="col-md-12 k-grid-content">
                        @(Html.Kendo().Grid<NA.PMS.Model.ChallanViewModel>()
                            .Name("GridChallanDetails")
                            .Columns(columns =>
                            {
                                columns.Bound(c => c.Department).Title("Department").ClientFooterTemplate("Total Count:");
                                //columns.Bound(c => c.TotalVerified).Title("Verified").Width(110);//.ClientFooterTemplate("<div>#= sum #</div>");
                                //columns.Bound(c => c.TotalNotVerified).Title("Not Verified").Width(110);//.ClientFooterTemplate("<div>#= sum #</div>");
                               
