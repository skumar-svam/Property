    function GetChallanListForColumnGraph() {
        //_StatusDate = $('#StatusDate').val();
        //StartDate: $('#ChallanStartDate').val(),
        //EndDate: $('#ChallanEndDate').val(),
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ StartDate: $('#ChallanStartDate').val(), EndDate: $('#ChallanEndDate').val(), FilterType: "ChallanByStatus" }),
            url: '/Member/Authority/GetChallanReportsForGraph',
            success: function (result) {
                if (result != null) {
                    //CreateChallanPieChart(result);
                    CreateBarGraphForChallan(result);
                    //CreateChallanDonutChart(result)
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Network error, Please try again later.");
            }
        });
    }

    function CreateBarGraphForChallan(GraphData) {
        $("#DivChallanBarChartI").kendoChart({
            dataSource: {
                data: GraphData
            },
            title: {
                text: "Total Generated Challan"
            },
            legend: {
                position: "top",
                 Visible: true
            },
            seriesDefaults: {
                type: "column",
                labels: {
                    visible: true,
                    background: "transparent",
                    template: "#= value#"
                    //template: "#= category #:  #= value#"
                }
            },
            series:
            [
                { field: "TotalChallanCount", categoryField: "Department", name:"Total Challan" },
                { field: "TotalVerified", categoryField: "Department", name: "Verified", color: "blue" },
                { field: "TotalNotVerified", categoryField: "Department", name: "Not Verified", color: "black" }
            ],
            chartArea:{
                width: 1100
            },
            categoryAxis: {
                labels: {
                    rotation: -45
                }
            },
            valueAxis: {
                labels: {
                    format: "{0:N0}"
                },
                majorUnit: 500
            },
            tooltip: {
                //visible: true,
                //format: "{0:N0}"
                visible: true,
                template: "#= category #: \n #= value#"
            }
            //seriesClick: onChallanPieChartSeriesClickEvent,
            //seriesClick: onSeriesClick,
            //seriesHover: onSeriesHover,
