    function GetRIdDetails() {
        var rId = $("#Rid").val();
        var date = "1/1/2018";
        //GetKYADetails(rId);
        if (rId != "") {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ rId: rId }),
                url: '/Possession/GetDetailsByRID',
                success: function (result) {
                    if (result.PropertyId != null) {
                        if (result.IsPossessionOrderDone == true) {
                            alertify.error("Possession order already added for this RID.");
                            return false;

                        } else {
                            $("input[type=submit]").removeAttr('disabled');
                        }
                        if (result.Gender.toLowerCase() == "company") {
                            $("#divSigningAuthority").show();
                            $('#divParentsName').hide();
                        }
                        else {
                            $("#divSigningAuthority").hide();
                            $('#divParentsName').show();
                        }
                        $("#PropertyId").val(result.PropertyId);
                        $("#SchemeName").val(result.SchemeName);
                        $("#ApplicantName").val(result.ApplicantName);
                        $("#FatherName").val(result.FatherName);
                        $("#MotherName").val(result.MotherName);
                        $('#SigningAuthority').val(result.SigningAuthority);
                        $('#RegisteredOffice').val(result.RegisteredOffice);
                        $('#CorrespondAdd').val(result.CorrespondAdd);
                        $("#Gender").val(result.Gender);
                        $("#DepartmentName").val(result.DepartmentName);
                        $("#PropertyType").val(result.PropertyType);
                        $("#PropertyNumber").val(result.PropertyNumber);
                        $("#Area").val(result.Area);
                        $("#FloorAreaRange").val(result.FloorAreaRange);

                        $("#LeaseDeedDueDate").data("kendoDatePicker").value(result.LeaseDeedDueDate);
                        $("#PossessionDueDate").data("kendoDatePicker").value(result.PossessionDueDate);
                        $("#LeaseDeedExecutionDate").data("kendoDatePicker").value(result.LeaseDeedExecutionDate);
                        //$("#AllottmentDate").val(result.AllottmentDate);
                        var htrAllotDate = new Date(parseInt(result.AllottmentDate.substr(6))).toLocaleDateString();
                        $("#AllottmentDate").val(htrAllotDate);

                        if ($("#AllottmentDate").val() >= date) {
                            $("#btnSubmitPossessionApproval").show();
                            $("#btnAdd").hide();
                        }
                        else {
                            $("#btnSubmitPossessionApproval").hide();
                            $("#btnAdd").show();
                        }
                    }
                    else {
                        RemoveApplicantDetails();
                        alertify.error("There is no record for this RID for Possession.");
                    }
                },
                error: function (obj) {
                    alertify.error("Some error occured. Please try again later.");
                }
            });
        }
        else {
            RemoveApplicantDetails();
        }

    }

    function GetKYADetails(rId) {
        //var rId = $("#RId").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ RegistrationId: rId }),
            url: '/Property/PropertyRegistration/GetKYADetailsForRid',
            success: function (result) {
                if (result != null) {
                    if (result.StatusId == "2") {
                        alertify.error("Your KYA has been Rejected. Please Complete your KYA again.");
                        $('#btnSubmitPossessionApproval').attr('disabled', 'disabled');
                        return false;
                    }
                    else if (result.StatusId == "" || result.StatusId == null) {
                        alertify.error("Please Complete your KYA.");
                        $('#btnSubmitPossessionApproval').prop('disabled', true);
                        return false;
                    }
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }
        });
    }

