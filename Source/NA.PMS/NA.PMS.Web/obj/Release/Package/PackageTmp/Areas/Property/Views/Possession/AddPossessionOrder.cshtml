    function ValidatePossession() {
        var flag = false;
        var refReq = $("#ReqRefNo").val();
        if (refReq == "") {
            alertify.error("Please enter Request Ref. No.");
            return false;
        }

        else if (refReq.length < 3) {
            alertify.error("Request Ref. No. length must be 3 characters");
            return false;
        }
        else {
            flag = true;
        }
        return flag;
    }

