@model NA.PMS.Model.ServiceViewModel
@using Kendo.Mvc.UI;
@using NA.PMS.Common;

@{
    ViewBag.Title = "Manage Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .top-margin {
        margin-top: 6px;
        width: 80px;
    }

    .lbl-status-action {
        cursor: pointer;
        color: blue;
    }

    .glyphicon-print {
        cursor: pointer;
    }
    .popup-window{
        display:none;
    }
    .status-window{
        display:none;
    }
</style>

<div class="ManageRequestServices">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Manage Service Requests</h1></div>
            <div class="col-md-6 col-sm-6 col-xs-12 col-btn">
                @Html.ActionLink("Request Service", "Index", new { controller = "ServiceRequest", area = "Member" }, htmlAttributes: new { target = "_blank" })
            </div>
        </div>
    </div>

    <div class="col-md-12 blnk-rw"></div>
    
    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.Model.ServiceViewModel>()
                .Name("GridServiceRequest")
                .ToolBar(tools => tools.Excel())
                .Excel(excel => excel
                    .FileName("ServiceRequestList.xlsx")
                    .AllPages(true)
                    .Filterable(true)
                    .ProxyURL(Url.Action("Excel_Export_Save", "Report"))
                )
                .Columns(columns =>
                {
                    columns.Bound(c => c.EncryptedId).Hidden();
                    columns.Bound(c => c.DepartmentId).Hidden();
                    columns.Bound(c => c.ServiceId).Hidden();
                    columns.Bound(c => c.RequestId).Title("Ref No").Width(100).ClientTemplate("<a href='" + "/Member/ServiceRequest/RequestDetail/#= Id #" + "' target='_blank'>#=Id#</a>");
                    columns.Bound(c => c.RegistrationNo).Title("RId").Width(120).Sortable(false);//.ClientTemplate("<label class='hyperlinkcss' onclick='javascript:RedirectForServices(#=ServiceId#, #=RId#)'>#=RId#</label>");
                    columns.Bound(c => c.Applicant).Hidden(true);
                    columns.Bound(c => c.Department).Title("Department").Width(130).Sortable(false);
                    columns.Bound(c => c.SubDepartment).Hidden(true);
                    columns.Bound(c => c.PropertyNo).Title("Property").Width(110).Sortable(false);
                    columns.Bound(c => c.ServiceName).Title("Service Name");
                    columns.Bound(c => c.RequestDate).Title("Request Date").Width(140).Format("{0:dd/MM/yyyy}").Sortable(false);
                    columns.Bound(c => c.Status).Title("Status").Width(100).Sortable(false);
                    //columns.Bound(c => c.RId).Title("Action").ClientTemplate("<a href='" + "/Member/CitizenRequests/ViewRequestDetails/#= Id #" + "'>View</a>").Sortable(false).Filterable(false);
                    //columns.Bound(c => c.RId).Title("").ClientTemplate("<a href='" + "/Member/CitizenRequests/CitizenChallan?regId=#= EncryptedRId #" + "&refid=#=EncryptedId#" + "'>Create Challan</a>").Sortable(false).Filterable(false);
                    columns.Bound(c => c.RequestDate).Title("Print").ClientTemplate("<a  onclick='javascript:OpenFile(this);'><center><span class='glyphicon glyphicon-print'></span></center></a>").Width(100).Filterable(false).Sortable(false);                    
                    columns.Bound(c => c.MobileNo).Hidden();                   
                    columns.Bound(c => c.Description).Hidden();
                })
                .Sortable().Filterable().Resizable(resize => resize.Columns(true))
                .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                .ClientDetailTemplateId("template")
                .AutoBind(true)
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Model(model => model.Id(c => c.Id))
                    .ServerOperation(true)
                    //.Read(read => read.Action("GetCustomerServiceRequestList", "ServiceRequest", new { area = "Member" }).Data("FilterSearchParameter")).PageSize(10)
                    .Read(read => read.Action("GetServiceRequestListForJanSuvidhaKendra", "ServiceRequest", new { area = "Member" })).PageSize(10)
                    .Sort(s => s.Add(r => r.RequestDate).Descending())
                )
        )
    </div>

</div>


<div class="col-md-12 status-window" id="divStatusMaster" style="min-height:200px;background:url(/Content/Images/boxed-bg.jpg) repeat;">
    <div class="row form-group" style="padding-top:15px;">
        <div class="col-md-12">
            <label style="padding-left:0;"><b>Reason For Cancellation</b></label>
            @Html.TextAreaFor(model => model.Comment, htmlAttributes: new { @class = "k-textbox", style = "width:100%;height:100px;" })
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-3">
            @Html.HiddenFor(model => model.RequestId)
        </div>
        <div class="col-md-3">
            <input type="button" class="k-button" id="btnStatusSubmit" value="Submit" style="width:98%;" />
        </div>
        <div class="col-md-3" style="text-align:right;">
            <input type="button" class="k-button" id="btnStatusClose" value="Close" style="width:98%;" />
        </div>
    </div>
</div>


<div class="col-md-12 popup-window" id="AcknowledgementContent" style="min-height:300px;background:url(/Content/Images/boxed-bg.jpg) repeat;">
    <div class="" id="divAcknowledgementReceiptBody">
        <div class="row">
            <div class="col-md-12">
                <h2 style="text-align:center;padding:0;margin-bottom:4px;">NEW OKHLA INDUSTRIAL DEVELOPMENT AUTHORITY</h2>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <h4 style="text-align:center;padding:0;margin-bottom:4px;">Sector-6 Administrator Office, NOIDA</h4>
            </div>
        </div>
        <div class="row ">
            <div class="col-md-12">
                <h5 style="text-align:center;padding:0;margin-top:4px;">Acknowledgement Receipt </h5>
            </div>
        </div>
        <div class="row row-pad">
            <div class="col-md-12">
                <span style="width:50%;text-align:right;float:right"> <b>Date: <span id="CreatedDate">["CreatedDate"]</span></b></span>
            </div>
        </div>
        <div class="row row-pad">
            <div class="col-md-12">
                <span style="width:50%;float:left"><b> Acknowledgement No: &nbsp;<span id="RequestId">["RequestId"]</span></b></span>
                <span style="width:50%;text-align:right;float:right"><b>Registration Id: &nbsp;<span id="RegistrationNo">["RegistrationId"]</span></b></span>
            </div>
        </div>
        <div class="row row-pad">
            <div class="col-md-12">
                <span style="width:70%;float:left"><b> Applicant Name: &nbsp;<span id="Name">["Name"]</span></b></span>
                <span style="width:30%;text-align:right;float:right"><b>Property No: &nbsp;<span id="PropertyNo">["PropertyNo"]</span></b></span>
            </div>
        </div>
        <div class="row row-pad">
            <div class="col-md-12">
                <span style="width:50%;float:left"><b> Department: &nbsp;<span id="Department">["Department"]</span></b> &nbsp;&nbsp;( <span id="SubDepartment">["SubDepartment"]</span> )</span>
                <span style="width:50%;text-align:right;float:right"><b>Mobile No.: &nbsp;<span id="Mobile">["Mobile"]</span></b></span>
            </div>
        </div>
        <div class="row row-pad">
            <div class="col-md-12">
                <b> Request Type: &nbsp;<span id="ServiceName">["ServiceName"]</span></b>
            </div>
        </div>
        <div class="row row-pad">
            <div class="col-md-12">
                <b> Subject: &nbsp; <label id="Description">["Description"]</label></b>
            </div>
        </div>
        <div class="row row-pad">
            <div class="col-md-12" style="text-align:justify;text-justify:inter-word">
                <p>
                    <b> Note:</b> The information provided in application shall be validated against the available information with the department.
                    In case where addition information like payment info addition supporting document etc.is required, the same shall be communicated on registered
                    mobile number and mail You can also track the status of service request on <b> http://www.mynoida.in </b>,Please quote this service request number for any
                    communication regarding the application.
                </p>
            </div>
        </div>
        <div class="row row-pad">
            <div class="col-md-12">
                <b>
                    Thanks for using services online.<br />
                    Your Thankfully<br />
                    NOIDA
                </b>
            </div>
        </div>
        <div class="row row-pad row-btn">
            <div class="col-md-12" style="text-align: center; padding:15px 0 15px 0;">
                <button type="button" id="btnPrintDiv" class="btn btn-success" onclick=" PrintAcknowledgementReciept();">Print</button>
                <button type="submit" id="btnClose" class="btn btn-danger">Close</button>
            </div>
        </div>
    </div>
</div>


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<NA.PMS.Model.ServiceViewModel>()
            .Name("grid_#=Id#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(o => o.Applicant).Width(300);//.ClientTemplate("<span>#= ServiceName #<br/><small ><b>Receiving Date:</b>&nbsp;#= CreatedDate#</small></span>");
                columns.Bound(o => o.Description);
                columns.Bound(o => o.Comment);//.ClientTemplate("<label>#=Comment#</label>");
                columns.Bound(o => o.StatusId).Width(100).Title("Cancel").ClientTemplate("<label class='lbl-status-action' onclick='javascript:OpenStatusWindow(this)'>#=Status#</label>");
                //columns.Bound(o => o.Status).Width(100).Title("Update").ClientTemplate("<a href='/Member/ServiceRequest/EditRequestDetail?id=#=Id# '>Edit</a>");
                //columns.Bound(o => o.RequestDate).Format("{0:dd/MM/yyyy}").Width(120);
            })
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(10)
                .Read(read => read.Action("GetCustomerServiceRequestListById", "ServiceRequest", new { Id = "#=Id#" }))
            )
            .ToClientTemplate()
    )
</script>
<script>
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
</script>

