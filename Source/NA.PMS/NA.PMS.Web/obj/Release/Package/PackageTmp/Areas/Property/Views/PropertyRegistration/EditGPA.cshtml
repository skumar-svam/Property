@model NA.PMS.Model.GPAModel
@using Kendo.Mvc.UI
@{
    ViewBag.Title = "Update";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style type="text/css">
    .modal-header .close {
        margin-top: 4px;
        margin-right: 6px;
    }

    .floatRight {
        float: right;
    }

    .blck-heading {
        border: 1px solid #299a8b;
    }

    .modal-header, .modal-body {
        background: url(/Content/Images/boxed-bg.jpg) repeat;
    }
</style>
@using (Html.BeginForm("SaveGPANominee", "PropertyRegistration", FormMethod.Post, new { enctype = "multipart/form-data", id = "GPAForm" }))
{
    <div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
        <div class="row">
            <div class="col-md-12">
                <div class="row rw-spce">
                    <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Update</h1></div>
                    <div class="col-md-6 col-sm-6 col-xs-12 mandatory"></div>
                </div>
            </div>
            <div class="col-md-12 blnk-rw"></div>
            <div class="col-md-12 content-top-spce">
                <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
                    <h2 class="blck-heading">REGISTRATION ID <span class="floatRight"><a id="allotteeModal" class="btn-sm floatRight" data-toggle="modal" data-target="#myModal">Allottee Information</a></span> </h2>
                    <div class="form-bx">
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Registration Id", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                <input type="hidden" value="@Model.RId" id="hdnRid" />
                                @(Html.Kendo().DropDownListFor(m => m.RId)
                                .Filter("contains")
                                .DataTextField("text")
                                .DataValueField("id")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                    //source.Read(read =>
                                    //{
                                    //    read.Action("GetRIDsByDeptt", "PropertyRegistration");
                                    //});
                                    source.Custom()
                                    .ServerFiltering(true)
                                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                    .Transport(transport =>
                                    {
                                        transport.Read(read => read.Action("GetRIDsByDeptt", "PropertyRegistration").Data("GetRid"));
                                    }).Schema(schema =>
                                    {
                                        schema.Data("Data")
                                        .Total("Total");
                                    }).PageSize(100);
                                })

                            //.Events(events => { events.Change("RIdChange"); })
                            .HtmlAttributes(new { @class = "schemeForms", style = "width:100%" })
                                )
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Type", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @(Html.Kendo().DropDownListFor(m => m.GPAType)
                                .Filter("contains")
                                .DataTextField("text")
                                .DataValueField("text")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("GetGPAType", "PropertyRegistration").Data("FilterCompany");
                                    }).ServerFiltering(true);
                                })
                            .CascadeFrom("RId")
        //.Events(events => { events.Change("TypeChange"); })
                            .HtmlAttributes(new { @class = "schemeForms", style = "width:100%" })
                                )
                                @Html.HiddenFor(gpa => gpa.GPAId)
                                @Html.HiddenFor(gpa => gpa.hdnGPAType)
                            </div>
                        </div>

                    </div>
                    @*@{Html.RenderPartial("_TransferAllotteDetails");}*@
                    <div id="divGPA">
                        @{Html.RenderPartial("_GPAForm", Model);}
                    </div>
                    <div id="divNominee">
                        @{Html.RenderPartial("_NomineeForm", Model);}
                    </div>
                </div>
                <div id="hdnDiv">
                    @(Html.Kendo().DatePickerFor(m => m.AllotmentDate)
                                          .HtmlAttributes(new { style = "width:100%", @class = "DisableKeyboardInput" }))
                </div>
                <div class="box-button text-center">
                    <input type="button" id="btnCancel" value="Cancel" class="btn btn-default" />
                    <input type="submit" id="btnAdd" value="Update" class="btn btn-add" />
                </div>
            </div>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title blck-heading" style="margin-bottom: 0px;" id="myModalLabel">Allottee Information</h4>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-12 blnk-rw"></div>
                        <div class="col-md-12 content-top-spce">
                            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px;padding-top:10px;">
                                <div id="divAllotteeDetails">
                                    @{Html.RenderPartial("_TransferAllotteDetails");}
                                </div>
                            </div>
                        </div>
                    </div>
                    @*<div class="modal-footer">
                            <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                        </div>*@
                </div>
            </div>
        </div>
    </div>
}
<script type="text/javascript">


    function GetRid() {
        var regId = $("#hdnRid").val();
        if (regId == "") { regId = 0; }
        return {
            Rid: regId
        };
    }


    function ClearValues() {
        $("#lblScNa").html('');
        $("#lblDeNa").html('');
        $("#lblApNa").html('');
        $("#lblGend").html('');
        $("#lblReNa").html('');
        $("#lblPropTy").html('');
        $("#lblArea").html('');
        $("#lblFloo").html('');
        $("#lblProMo").html('');
        $("#lblProFu").html('');
        $("#BalanceDues").val('');
    }
    $(document).ready(function () {
        $("#hdnDiv").hide();

        var GPASOAVal = $("#GPASOA").val();
        var AgreementTypeVal = $("#AgreementType").val();
        if (GPASOAVal == '@NA.PMS.Common.MortPrevLoan.yes') {
            $(".RegisteredPart").hide();
            $(".UnRegisteredPart").hide();
            $(".DivAgreement").show();
            if (AgreementTypeVal == '1') {
                $(".RegisteredPart").show();
                $(".UnRegisteredPart").hide();
            }
            else {
                $(".RegisteredPart").hide();
                $(".UnRegisteredPart").show();
            }
        }
        else {
            $(".RegisteredPart").hide();
            $(".UnRegisteredPart").hide();
            $(".DivAgreement").hide();
        }

        var ddlRid = $("#RId").data("kendoDropDownList");
        ddlRid.enable(false);
        var ddlType = $("#GPAType").data("kendoDropDownList");
        ddlType.enable(false);

        $("#divNominee").hide();

        //Code to pick values for _TransferAllotteDetails Partial View
        var rId = $("#RId").val();
        if (rId == '') {
            ClearValues();
            alertify.error("Please select an RID");
            return false;
        }
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rId: rId }),
            url: '/PropertyRegistration/GetOriginalDetailsForTransferByRID',
            success: function (result) {
                if (result != null) {
                    //if (result.isLeaseDeedExecuted == false) {
                    //    ClearValues();
                    //    alertify.error("Please execute Lease Deed for this RID before Transfer process");
                    //    $("#RId").data('kendoDropDownList').value('');
                    //    return false;
                    //}
                    //else {
                    $("#lblScNa").html(result.SchemeName);
                    $("#lblDeNa").html(result.DepttName);
                    $("#lblApNa").html(result.ApplicantName);
                    $("#lblCoNa").html(result.T_Company_Name);
                    $("#lblGend").html(result.Gender);
                    $("#lblReNa").html(result.RelationName);
                    $("#lblSiAu").html(result.TransfereeCompanySigningAuth);
                    $("#lblPropTy").html(result.PropType);
                    $("#lblArea").html(result.Area);
                    $("#lblFloo").html(result.Floor);
                    $("#lblProMo").html(result.PropMortgaged);
                    $("#lblProFu").html(result.PropFunctional);
                    $("#lblOTLR").html(result.OneTimeLeaseRent);
                    $("#hdnDepttId").val(result.DepttId);
                    $("#hdnPropId").val(result.PropId);
                    $("#BalanceDues").val(result.BalanceDues);
                    $("#AllotmentDate").data("kendoDatePicker").value(result.AllotmentDate);

                    if (result.Gender == "company" || result.Gender == "Company") {
                        $('#lbl_mfGender').hide();
                        //$('#lbl_mfGender').css("display", "none");
                        //$('#lblApNa').hide();
                        $('#lbl_comGender').show();
                        $('#lblCoNa').hide();
                        $('#lbl_FHname').hide();
                        $('#lbl_SAname').show();
                        $('#lblReNa').hide();
                        $('#lblSiAu').show();
                    }
                    else {
                        $('#lbl_mfGender').show();
                        $('#lblApNa').show();
                        $('#lbl_comGender').hide();
                        $('#lblCoNa').hide();
                        $('#lbl_FHname').show();
                        $('#lbl_SAname').hide();
                        $('#lblReNa').show();
                        $('#lblSiAu').hide();
                    }
                    $("#lblCorrAdd").html(result.TransferorCorrAdd);
                    $("#lblPerAdd").html(result.TransferorPerAdd);
                    //}
                }
                else {
                    ClearValues();
                    alertify.error("Some error occured. Please try again later.");
                }
            },
            error: function (obj) {
                ClearValues();
                alertify.error("Some error occured. Please try again later.");
            }
        });

        var type = $("#GPAType").val();
        if (type == '@NA.PMS.Common.GPAType.Nominee') {
            $("#divGPA").hide();
            $("#btnAdd").hide();
            $("#divNominee").show();
            //setTimeout(function () { $("#gridNominees").data("kendoDropDownList").dataSource.read(); }, 1000);
            $("#gridNominees").data("kendoGrid").dataSource.read();
        }
        else {
            $("#divNominee").hide();
            $("#divGPA").show();
            $("#btnAdd").show();
        }

        var registeredVal = $("#GPARegistered").val();
        if (registeredVal == '@NA.PMS.Common.MortPrevLoan.no') {
            $("#GPARegisteredNo").val('');
            $("#GPARegisteredNo").prop("disabled", true);
        }
        else {
            $("#GPARegisteredNo").prop("disabled", false);
        }

        //Button clicks
        $("#btnCancel").click(function () {
            window.location.href = '@Url.Action("ManageGPA", "PropertyRegistration")';
        });

        $("#btnAdd").click(function () {
            var rId = $("#RId").val();
            var GPAHolderName = $("#GPAHolderName").val();
            var GPAHolderAdd = $("#GPAHolderAdd").val();
            var GPARelationName = $("#RelationName").val();
            var applicationDate = $("#ApplicationDate").val();
            var effectiveFrom = $("#EffectiveFrom").val();
            var effectiveTo = $("#EffectiveTo").val();
            var GPARegistered = $("#GPARegistered").val();
            var GPARegistrationNo = $("#GPARegisteredNo").val();
            var acceptanceDate = $("#AcceptanceDate").val();
            var allotmentDate = $("#AllotmentDate").val();
            var dtEffectiveFrom = new Date(effectiveFrom);
            var dtEffectiveTo = new Date(effectiveTo);
            var dtApplicationDate = new Date(applicationDate);
            var dtAllotmentDate = new Date(allotmentDate);
            var dtAcceptanceDate = new Date(acceptanceDate);

            var bahiNo = $("#BahiNo").val();
            var bahiZildNo = $("#BahiZildNo").val();
            var bahiPageNo = $("#BahiPageNo").val();
            var SINo = $("#SINo").val();

            var GPASOA = $("#GPASOA").val();
            var AgreementType = $("#AgreementType").val();

            if (rId == '') {
                ClearValues();
                alertify.error("Please select an RID");
                return false;
            }
            if (GPAHolderName == '') {
                alertify.error("Please enter GPA Holder Name");
                return false;
            }

            if (!IsAlphabetWithSpaceHolderName(GPAHolderName)) {
                alertify.error("GPA Holder Name should only have alphabets and space.");
                return false;
            }

            if (GPAHolderAdd == '') {
                alertify.error("Please enter GPA Holder Address");
                return false;
            }

            if (GPARelationName != '') {
                if (!IsAlphabetWithSpace(GPARelationName)) {
                    alertify.error("Realation should only have alphabets and space.");
                    return false;
                }
            }

            if (applicationDate == '') {
                alertify.error("Please enter Application Date");
                return false;
            }
            if (effectiveFrom == '') {
                alertify.error("Please enter Effective From Date");
                return false;
            }
            //if (effectiveTo == '') {
            //    alertify.error("Please enter Effective To Date");
            //    return false;
            //}
            if (GPARegistered == '') {
                alertify.error("Please select GPA Registered");
                return false;
            }
            if (GPARegistered == '@NA.PMS.Common.MortPrevLoan.yes') {
                if (GPARegistrationNo == '') {
                    alertify.error("Please enter GPA Registration Number");
                    return false;
                }

                if (!IsAlphanumericSpecialCharater(GPARegistrationNo)) {
                    alertify.error("GPA Registration Number should only be alphanumeric.");
                    return false;
                }
            }
            if (acceptanceDate == '') {
                alertify.error("Please enter Acceptance Date");
                return false;
            }
            if (dtEffectiveFrom > dtEffectiveTo) {
                alertify.error("Effective From can't be later than Effective To");
                return false;
            }
            if (dtApplicationDate <= dtAllotmentDate) {
                alertify.error("Application Date can't be earlier than, or equal to Allotment Date");
                return false;
            }
            if (dtEffectiveFrom <= dtAllotmentDate) {
                alertify.error("GPA Effective From can't be earlier than, or equal to Allotment Date");
                return false;
            }
            if (dtAcceptanceDate < dtApplicationDate) {
                alertify.error("Acceptance Date can't be earlier than Application Date");
                return false;
            }

            if (bahiNo == "") {
                alertify.error("Please enter Bahi Number.");
                return false;
            }
            if (!IsAlphanumeric(bahiNo)) {
                alertify.error("Bahi Number should only be alphanumeric.");
                return false;
            }
            if (bahiZildNo == "") {
                alertify.error("Please enter Bahi Zild Number.");
                return false;
            }
            if (!IsAlphanumeric(bahiZildNo)) {
                alertify.error("Bahi Zild Number should only be alphanumeric.");
                return false;
            }
            if (bahiPageNo == "") {
                alertify.error("Please enter Bahi Page Number.");
                return false;
            }
            if (!IsAlphanumeric(bahiPageNo)) {
                alertify.error("Bahi Page Number should only be alphanumeric.");
                return false;
            }
            if (SINo == "") {
                alertify.error("Please enter SI Number.");
                return false;
            }
            if (!IsAlphanumericWithSpecialCharacter(SINo)) {
                alertify.error("SI Number should only be alphanumeric.");
                return false;
            }

            if (GPASOA == '') {
                alertify.error("Please select Sale of Agreement.");
                return false;
            }

            if (GPASOA == '@NA.PMS.Common.MortPrevLoan.yes') {

                if (AgreementType == '') {
                    alertify.error("Please select Agreement Type.");
                    return false;
                }

                if (AgreementType == '1')//Registered
                {
                    var SOAbahiNo = $("#SOABahiNo").val();
                    var SOAbahiZildNo = $("#SOABahiZildNo").val();
                    var SOAbahiPageNo = $("#SOABahiPageNo").val();
                    var SOASINo = $("#SOASINo").val();
                    var RegistrationDate = $("#RegistrationDate").val();
                    var dtRegistrationDate = new Date(RegistrationDate);

                    if (RegistrationDate == '') {
                        alertify.error("Please enter Registration Date.");
                        return false;
                    }

                    if (SOAbahiNo == "") {
                        alertify.error("Please enter Sale of Agreement Bahi Number.");
                        return false;
                    }
                    if (!IsAlphanumeric(SOAbahiNo)) {
                        alertify.error("Sale of Agreement Bahi Number should only be alphanumeric.");
                        return false;
                    }
                    if (SOAbahiZildNo == "") {
                        alertify.error("Please enter Sale of Agreement Bahi Zild Number.");
                        return false;
                    }
                    if (!IsAlphanumeric(SOAbahiZildNo)) {
                        alertify.error("Sale of Agreement Bahi Zild Number should only be alphanumeric.");
                        return false;
                    }
                    if (SOAbahiPageNo == "") {
                        alertify.error("Please enter Sale of Agreement Bahi Page Number.");
                        return false;
                    }
                    if (!IsAlphanumeric(SOAbahiPageNo)) {
                        alertify.error("Sale of Agreement Bahi Page Number should only be alphanumeric.");
                        return false;
                    }
                    if (SOASINo == "") {
                        alertify.error("Please enter Sale of Agreement SI Number.");
                        return false;
                    }
                    if (!IsAlphanumericWithSpecialCharacter(SOASINo)) {
                        alertify.error("Sale of Agreement SI Number should only be alphanumeric.");
                        return false;
                    }
                }

                if (AgreementType == '2')//UnRegistered
                {
                    var AdvertismentInNewsPaper = $("#AdvertismentInNewsPaper.").val();
                    var PublishedDate = $("#PublishedDate").val();
                    var dtPublishedDate = new Date(PublishedDate);

                    if (AdvertismentInNewsPaper == "") {
                        alertify.error("Please enter Advertisment in NewsPaper.");
                        return false;
                    }

                    if (PublishedDate == '') {
                        alertify.error("Please enter Published Date.");
                        return false;
                    }
                }
            }
            @*if (GPAHolderName == '') {
                alertify.error("Please enter GPA Holder Name");
                return false;
            }
            if (GPAHolderAdd == '') {
                alertify.error("Please enter GPA Holder Address");
                return false;
            }
            if (GPARelationName == '') {
                alertify.error("Please enter Relation");
                return false;
            }
            if (applicationDate == '') {
                alertify.error("Please enter Application Date");
                return false;
            }
            if (effectiveFrom == '') {
                alertify.error("Please enter Effective From Date");
                return false;
            }
            if (effectiveTo == '') {
                alertify.error("Please enter Effective To Date");
                return false;
            }
            if (GPARegistered == '') {
                alertify.error("Please select GPA Registered");
                return false;
            }
            if (GPARegistered == '@NA.PMS.Common.MortPrevLoan.yes') {
                if (GPARegistrationNo == '') {
                    alertify.error("Please enter GPA Registration Number");
                    return false;
                }
            }
            if (acceptanceDate == '') {
                alertify.error("Please enter Acceptance Date");
                return false;
            }
            if (dtEffectiveFrom > dtEffectiveTo) {
                alertify.error("Effective From can't be later than Effective To");
                return false;
            }
            if (dtApplicationDate <= dtAllotmentDate) {
                alertify.error("Application Date can't be earlier than, or equal to Allotment Date");
                return false;
            }
            if (dtEffectiveFrom <= dtAllotmentDate) {
                alertify.error("GPA Effective From can't be earlier than, or equal to Allotment Date");
                return false;
            }
            if (dtAcceptanceDate < dtApplicationDate) {
                alertify.error("Acceptance Date can't be earlier than Application Date");
                return false;
            }*@
            alertify.success("Data added successfully");
        });



    });

    function FilterCompany() {
        //return { company: $('#lblGend').text() };
        return { company: $('#RId').val().toString() };
    }

    function IsAlphanumericWithSpecialCharacter(character) {// dash(-)
        if (!/^[a-zA-Z0-9\-]*$/g.test(character.trim())) {
            //alertify.error("Scheme Name should be alphanumeric (with '-', '\' and '/' characters)");
            return false;
        }
        return true;
    }

    function IsAlphabetWithSpace(character) {
        if (!/^[a-zA-Z ]*$/g.test(character.trim())) {
            //alertify.error("Scheme Name should be alphanumeric (with '-', '\' and '/' characters)");
            return false;
        }
        return true;
    }

    function IsAlphanumeric(character) {
        if (!/^[a-zA-Z0-9]*$/g.test(character.trim())) {
            //alertify.error("Scheme Name should be alphanumeric");
            return false;
        }
        return true;
    }

    function IsAlphanumericSpecialCharater(character) {// dash(-) and underscore(_)
        if (!/^[a-zA-Z0-9\_\-]*$/g.test(character.trim())) {
            //alertify.error("Scheme Name should be alphanumeric (with '-', '\' and '/' characters)");
            return false;
        }
        return true;
    }

    function IsAlphabetWithSpaceHolderName(character) {// dash(-)
        if (!/^[a-zA-Z0-9\-\/ ]*$/g.test(character.trim())) {
            //alertify.error("Scheme Name should be alphanumeric (with '-', '\' and '/' characters)");
            return false;
        }
        return true;
    }
</script>

