}
<style>
    .k-grid .k-grid-header .k-header .k-link {
        overflow: visible !important;
        white-space: normal !important;
        text-align: center;
        font-weight: 800;
        /*color: white;*/
    }

    #GridSeviceTimeline .k-grid-footer {
        background-color: cornsilk;
    }

    .k-footer-template td {
        background: #78c3b9;
        color: black;
    }
   
    /*CSS for sticky div*/
    .header {
     padding: 6px 16px;
     background: #fff;
     color: #f1f1f1;
     z-index: 1000;
     border: 1px solid #ccccccb3;
    }
    .content {
      padding: 16px;
    }
    .sticky {
      position: fixed;
      top: 0;
      width: 100%
    }

    .sticky + .content {
      padding-top: 102px;
    }


</style>
