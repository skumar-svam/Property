<script>
    var deptid = 0;
    var myBarChart = null;
    var institutionalBarChart = null;
    var commercialBarChart = null;
    var ResidentialBarChart = null;
    var IndustrialBarChart = null;
    var HousingBarChart = null;
    var GroupHousingBarChart = null;
    var AbadiBarChart = null;

    var institutional = [];
    var commercial = [];
    var residential = [];
    var industrial = [];
    var housing = [];
    var grouphousing = [];
    var abaadi = [];


    $(document).ready(function () {
        $('#_allgriddata').hide();
        $('#ServiceDepartmentWise').hide();
        $('#ServiceDetailsDeptWise').hide();
    });
    function OnSuccess(data) {
        debugger
        $('#_departmenttabs').show();
        institutional.length = 0;
        commercial.length = 0;
        residential.length = 0;
        industrial.length = 0;
        housing.length = 0;
        grouphousing.length = 0;
        abaadi.length = 0;

        for (var it in data) {
            if (data[it].DepartmentId == "1") {
                institutional.push(data[it].TotalReceived);
                institutional.push(data[it].WithDrawn);
                institutional.push(data[it].CompletedWithinTime);
                institutional.push(data[it].CompletedBeyondTime);
                institutional.push(data[it].PendingWithTime);
                institutional.push(data[it].PendingMoreThanWeek);
                institutional.push(data[it].PendingMoreThanFortNight);
                institutional.push(data[it].PendingMoreThanOneMonth);
                institutional.push(data[it].TotalReject);
                institutional.push(data[it].TotalObjection);
                //institutional.push(data[it].Total);
                institutional.push(data[it].AverageProcessingTime);
                institutional.push(data[it].AverageDelaytime);
            }
            if (data[it].DepartmentId == "2") {
                commercial.push(data[it].TotalReceived);
                commercial.push(data[it].WithDrawn);
                commercial.push(data[it].CompletedWithinTime);
                commercial.push(data[it].CompletedBeyondTime);
                commercial.push(data[it].PendingWithTime);
                commercial.push(data[it].PendingMoreThanWeek);
                commercial.push(data[it].PendingMoreThanFortNight);
                commercial.push(data[it].PendingMoreThanOneMonth);
                commercial.push(data[it].TotalReject);
                commercial.push(data[it].TotalObjection);
                //commercial.push(data[it].Total);
                commercial.push(data[it].AverageProcessingTime);
                commercial.push(data[it].AverageDelaytime);
            }
            if (data[it].DepartmentId == "3") {
                residential.push(data[it].TotalReceived);
                residential.push(data[it].WithDrawn);
                residential.push(data[it].CompletedWithinTime);
                residential.push(data[it].CompletedBeyondTime);
                residential.push(data[it].PendingWithTime);
                residential.push(data[it].PendingMoreThanWeek);
                residential.push(data[it].PendingMoreThanFortNight);
                residential.push(data[it].PendingMoreThanOneMonth);
                residential.push(data[it].TotalReject);
                residential.push(data[it].TotalObjection);
                //residential.push(data[it].Total);
                residential.push(data[it].AverageProcessingTime);
                residential.push(data[it].AverageDelaytime);
            }
            if (data[it].DepartmentId == "4") {
                industrial.push(data[it].TotalReceived);
                industrial.push(data[it].WithDrawn);
                industrial.push(data[it].CompletedWithinTime);
                industrial.push(data[it].CompletedBeyondTime);
                industrial.push(data[it].PendingWithTime);
                industrial.push(data[it].PendingMoreThanWeek);
                industrial.push(data[it].PendingMoreThanFortNight);
                industrial.push(data[it].PendingMoreThanOneMonth);
                industrial.push(data[it].TotalReject);
                industrial.push(data[it].TotalObjection);
                //industrial.push(data[it].Total);
                industrial.push(data[it].AverageProcessingTime);
                industrial.push(data[it].AverageDelaytime);
            }
            if (data[it].DepartmentId == "5") {
                housing.push(data[it].TotalReceived);
                housing.push(data[it].WithDrawn);
                housing.push(data[it].CompletedWithinTime);
                housing.push(data[it].CompletedBeyondTime);
                housing.push(data[it].PendingWithTime);
                housing.push(data[it].PendingMoreThanWeek);
                housing.push(data[it].PendingMoreThanFortNight);
                housing.push(data[it].PendingMoreThanOneMonth);
                housing.push(data[it].TotalReject);
                housing.push(data[it].TotalObjection);
                //housing.push(data[it].Total);
                housing.push(data[it].AverageProcessingTime);
                housing.push(data[it].AverageDelaytime);
            }
            if (data[it].DepartmentId == "6") {
                grouphousing.push(data[it].TotalReceived);
                grouphousing.push(data[it].WithDrawn);
                grouphousing.push(data[it].CompletedWithinTime);
                grouphousing.push(data[it].CompletedBeyondTime);
                grouphousing.push(data[it].PendingWithTime);
                grouphousing.push(data[it].PendingMoreThanWeek);
                grouphousing.push(data[it].PendingMoreThanFortNight);
                grouphousing.push(data[it].PendingMoreThanOneMonth);
                grouphousing.push(data[it].TotalReject);
                grouphousing.push(data[it].TotalObjection);
                //grouphousing.push(data[it].Total);
                grouphousing.push(data[it].AverageProcessingTime);
                grouphousing.push(data[it].AverageDelaytime);
                grouphousing.push(data[it].TotalCompleted);
                grouphousing.push(data[it].TotalPending);
            }
            if (data[it].DepartmentId == "7") {
                abaadi.push(data[it].TotalReceived);
                abaadi.push(data[it].WithDrawn);
