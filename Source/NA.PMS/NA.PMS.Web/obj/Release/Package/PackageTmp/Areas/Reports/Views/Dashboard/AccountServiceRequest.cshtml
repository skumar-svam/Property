                                        info.Bound(c => c.PendingMoreThanOneMonth).Title("More Than a Month").ClientTemplate("<input type='button' value='#= PendingMoreThanOneMonth #' class='k-button btn_successround MoreThanMonthBackClr' onclick='javascript:ServiceDetailsByServiceId(#= DepartmentId #,#= ServiceId #,7)'>").ClientFooterTemplate("#=sum#").HeaderHtmlAttributes(new { style = "text-align: center;background-color:#fff8dc;" });
