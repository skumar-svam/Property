                                        //info.Bound(c => c.AverageProcessingTime).Title("Average Processing Time").ClientTemplate("<input type='button' value='#= TotalObjection #' class='k-button btn_successround objectionBackClr' onclick='javascript:ServiceDetailsByServiceId(#= DepartmentId #,#= ServiceId #,9)'>").ClientFooterTemplate("#=sum#").HtmlAttributes(new { @class = "" });
