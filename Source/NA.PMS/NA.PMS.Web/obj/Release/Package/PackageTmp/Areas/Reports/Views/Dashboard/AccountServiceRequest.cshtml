                @*<h2 class=" blck-heading" style="" id="ServiceHead">Timeline Of Services ( Online & JSK )</h2>*@
                <div class="col-md-12 k-grid-content">
                    @(Html.Kendo().Grid<NA.PMS.MTC.MasterDashboardModel>()
                    .Name("GridSeviceTimeline")
                    .Excel(excel => excel
                    .AllPages(true).Filterable(true)
                    .FileName("AllPropertyDepartment.xlsx"))
                    .ToolBar(toolsExcel => toolsExcel.Excel())
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.DepartmentId).Hidden(true);
                        columns.Bound(c => c.Department).Title("Department").Width(110).ClientFooterTemplate("Total Count:").Width(200).HeaderHtmlAttributes(new { style = "text-align: center;background-color:#fff8dc;" });
                        columns.Bound(c => c.TotalReceived).Title("Total Request").Width(110).ClientFooterTemplate("#=sum#").HeaderHtmlAttributes(new { style = "text-align: center;background-color:#fff8dc;" });
                        columns.Group(g =>
                            g.Title("Completed").HeaderHtmlAttributes(new { style = "text-align: center;background-color:#63d827;" })//background-color:#63d827;
                            .Columns(info =>
                            {
                                info.Bound(x => x.CompletedWithinTime).Title("Within Time").ClientFooterTemplate("#=sum#").HeaderHtmlAttributes(new { style = "text-align: center;background-color:#fff8dc;" });//.HeaderHtmlAttributes(new { style = "background-color:lawngreen;" });compBackCl                                                                                         // info.Bound(x => x.CompletedWithinTime).Title("Within Time").ClientFooterTemplate("#=sum#").ClientTemplate("<label class='btn_successround '>#= CompletedWithinTime #</label>");
                                info.Bound(x => x.CompletedBeyondTime).Title("Beyond Time").ClientFooterTemplate("#=sum#").HeaderHtmlAttributes(new { style = "text-align: center;background-color:#fff8dc;" });//.HeaderHtmlAttributes(new { style = "background-color:#ffa500;" })compBeyondBackClr
                                //info.Bound(x => x.TotalReject).Title("Rejected").ClientFooterTemplate("#=sum#");
                                //info.Bound(x => x.WithDrawn).Title("Withdrawn").ClientFooterTemplate("#=sum#");
                            })
                        );
                        columns.Group(g =>
                            g.Title("Pending").HeaderHtmlAttributes(new { style = "text-align: center;background-color:#ffdab3;" })//background-color:orange;
                            .Columns(info =>
                            {
                                info.Bound(x => x.PendingWithTime).Title("Within Time").ClientFooterTemplate("#=sum#").HeaderHtmlAttributes(new { style = "text-align: center;background-color:#fff8dc;" });//.HeaderHtmlAttributes(new { style = "background-color:yellow" })pendingwithinBackClr
                                info.Bound(c => c.PendingMoreThanWeek).Title("More Than a Week").ClientFooterTemplate("#=sum#").HeaderHtmlAttributes(new { style = "text-align: center;background-color:#fff8dc;" });//.HeaderHtmlAttributes(new { style = "background-color:#fa8072;" })MoreThanWeekBackClr
                                info.Bound(c => c.PendingMoreThanFortNight).Title("More Than Fortnight").ClientFooterTemplate("#=sum#").HeaderHtmlAttributes(new { style = "text-align: center;background-color:#fff8dc;" });
                                info.Bound(c => c.PendingMoreThanOneMonth).Title("More Than a Month").ClientFooterTemplate("#=sum#").HeaderHtmlAttributes(new { style = "text-align: center;background-color:#fff8dc;" });//.HeaderHtmlAttributes(new { style = "background-color:#8b0000;" })MoreThanMonthBackClr
                                info.Bound(c => c.TotalObjection).Title("Objection").ClientFooterTemplate("#=sum#").HeaderHtmlAttributes(new { style = "text-align: center;background-color:#fff8dc;" });
                            })
                        );
                        columns.Bound(c => c.AverageProcessingTime).ClientFooterTemplate("Overall: #= kendo.toString(average, '0') #").HeaderHtmlAttributes(new { style = "text-align: center;background-color:#fff8dc;" });
                        columns.Bound(c => c.AverageDelaytime).ClientFooterTemplate("Overall: #= kendo.toString(average, '0') #").HeaderHtmlAttributes(new { style = "text-align: center;background-color:#fff8dc;" });
                    })
                    .Resizable(resize => resize.Columns(true))
                    //.Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                    .AutoBind(true)
                    .DataSource
                    (
                        dataSource => dataSource
                        .Ajax().ServerOperation(true)
                        .Read(read => read.Action("GetServiceTimelineAccountReportsAsDataSource", "Dashboard", new { area = "Reports" }).Data("FilterParameterTimeline"))
                        .Aggregates(aggregates =>
                        {
                            aggregates.Add(p => p.TotalReceived).Sum();
                            aggregates.Add(p => p.CompletedWithinTime).Sum();
                            aggregates.Add(p => p.CompletedBeyondTime).Sum();
                            aggregates.Add(p => p.PendingWithTime).Sum();
                            aggregates.Add(p => p.PendingMoreThanWeek).Sum();
                            aggregates.Add(p => p.PendingMoreThanFortNight).Sum();
                            aggregates.Add(p => p.PendingMoreThanOneMonth).Sum();
                            aggregates.Add(p => p.TotalReject).Sum();
                            aggregates.Add(p => p.TotalObjection).Sum();
                            aggregates.Add(p => p.WithDrawn).Sum();
                            aggregates.Add(p => p.AverageProcessingTime).Average();
                            aggregates.Add(p => p.AverageDelaytime).Average();
                        })
                    )
                        )
                </div>
            </div>
        </div>
    </div>
