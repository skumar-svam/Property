        color: blue;
    }

    .hyperlink.cancel {
        font-weight: bold;
        color: darkred;
    }

    .k-grid .k-grid-header .k-header .k-link {
        overflow: visible !important;
        white-space: normal !important;
        text-align: center;
    }
    .k-datepicker{
        border: 1px solid #abc;
    }
</style>

