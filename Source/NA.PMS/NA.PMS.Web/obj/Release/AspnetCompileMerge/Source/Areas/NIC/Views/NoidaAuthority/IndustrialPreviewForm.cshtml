<script type="text/javascript">
    function ValidatePayment(formId, Type) {
        var encryptedId = $('#EncryptedFormId').val();
        var schemeType = $("#SchemeType").val();
        if ($('#IsChallanGenerated').val() != 'True') {
            //$('input[name=PaymentTypeId][value=3]', '#PaymentMode').css("display", "none");
            $('.lbl-upd').css("display", "none");
        }
        if (formId.trim() != "") {
            $.ajax({
                type: 'POST',
                dataType: 'json',
                data: { formNo: formId },
                //url: '/Online/Application/ValidateOnlineFormPayment',
                url: '/NIC/NoidaAuthority/IsProcessingFeeAndReservationMoneyPaid',
                success: function (result) {
                    if (result == '@SWPReturnTypeId.None') {
                        if (Type == "Payment") {
                            $("#divPaymentwindow").data("kendoWindow").center();
                            $("#divPaymentwindow").data("kendoWindow").open();
                            $("#divPaymentwindow").data("kendoWindow").pin();
                        }
                    }
                    //var nExist = result.split("#");
                    else if (result == '@SWPReturnTypeId.Exist') {
                        $("#divPaymentwindow").data("kendoWindow").center();
                        $("#divPaymentwindow").data("kendoWindow").open();
                        $("#divPaymentwindow").data("kendoWindow").pin();
                        //alertify.error("Not allowed after payment (online) or challan generation (offline).");
                        //return false;
                    }
                    else {
                        alertify.error("1. Not allowed after payment (online) or challan generation (offline).");
                        return false;
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                }
            });
        }
    }
</script>

<script type="text/javascript">

    $(document).ready(function () {
        $("#documenttable").hide();

        var formType = $('#ApplicationFormType').val();
        if (formType.trim() == "Expansion") {
            $('#divExpansionType').show();
        }
        else {
            $('#divExpansionType').css("display", "none");
            $('#divRentPermission').css("display", "none");
            $('.row-rent').css("display", "none");
            $('.col-rent').css("display", "none");
            $('#divExistingAllottee').css("display", "none");
        }

        var expansionType = $('#ExpansionType').val();
        if (expansionType.trim() == "Rent Permission") {
            $('#divRentPermission').show();
            $('.row-rent').show();
            $('.col-rent').show();
            $("input[type='radio'][name=ExpansionType][value='RentPermission']").attr("checked", true);
            $('#divExistingAllottee').css("display", "none");
        }
        if (expansionType.trim() == "Existing Allottee") {
            $('#divRentPermission').css("display", "none");
            $('.row-rent').css("display", "none");
            $('.col-rent').css("display", "none");
            $("input[type='radio'][name=ExpansionType][value='ExistingAllottee']").attr("checked", true);
            $('#divExistingAllottee').show();
        }


        //var radiobtnVal = $('input[name=ApplicantType]:checked', '#applicationform').val();
        var radiobtnVal = $('#ApplicantType').val();
        if (radiobtnVal == "Company") {
            $('.lbl-permanent-address').text("Registered Office");
            $('#divIndividualInfo').css("display", "none");
            $('.row-company').show();
            $("label[for='Applicant']").html("Company");
