@{Html.RenderPartial("_PartialSchemeFormPayment");}

<script type="text/javascript">

    $(document).ready(function () {
        $("#btnPrintSchemeForm").click(function () {
            OpenSubmittedFormForPrint();
        });

        

        $("#documenttable").hide();
        var formType = $('#ApplicationFormType').val();
        if (formType.trim() == "Expansion") {
            $('#divExpansionType').show();
        }
        else {
            $('#divExpansionType').css("display", "none");
            $('#divRentPermission').css("display", "none");
            $('.row-rent').css("display", "none");
            $('.col-rent').css("display", "none");
            $('#divExistingAllottee').css("display", "none");
        }

        var expansionType = $('#ExpansionType').val();
        if (expansionType.trim() == "Rent Permission") {
            $('#divRentPermission').show();
            $('.row-rent').show();
            $('.col-rent').show();
            $('#divExistingAllottee').css("display", "none");
        }
        if (expansionType.trim() == "Existing Allottee") {
            $('#divRentPermission').css("display", "none");
            $('.row-rent').css("display", "none");
            $('.col-rent').css("display", "none");
            $('#divExistingAllottee').show();
        }


        //var radiobtnVal = $('input[name=ApplicantType]:checked', '#applicationform').val();
        var radiobtnVal = $('#ApplicantType').val();
        if (radiobtnVal == "Company") {
            $('.lbl-permanent-address').text("Registered Office");
            $('#divIndividualInfo').css("display", "none");
            $('.row-company').show();
            $("label[for='Applicant']").html("Company");
        }
        else if (radiobtnVal == "Individual") {
            $('.lbl-permanent-address').text("Permanent Address");
            $('#divIndividualInfo').show();
            $('.row-company').css("display", "none");
            $("label[for='Applicant']").html("Applicant");
        }

        $('.single').attr("disabled", true);
        $('.inpchk').attr("disabled", "disabled");

        $('#Gender').data("kendoDropDownList").enable(false);
        $('#MaritalStatus').data("kendoDropDownList").enable(false);
        $('#CategoryId').data("kendoDropDownList").enable(false);
        $('#OccupationId').data("kendoDropDownList").enable(false);
        $('#DOB').data("kendoDatePicker").enable(false);
        $("input[type='radio'][name=ApplicationFormType]").attr("disabled", "disabled");
        $("input[type='radio'][name=ApplicantType]").attr("disabled", "disabled");
        $("input[type='radio'][name=ExpansionType]").attr("disabled", "disabled");
        $("input[type='checkbox'][name=checboxDeclaration]").attr("disabled", "disabled");
        //$("#DispatchDate").data("kendoDatePicker").enable(false);
        $("#LetterDate").data("kendoDatePicker").enable(false);

        var gender = $("#Gender").val();
        if (gender != "Company") {
            $("#FirstName").attr("readonly", "readonly");
            $("#MiddleName").attr("readonly", "disabled");
            $("#LastName").attr("readonly", "readonly");
            $("#FatherName").attr("readonly", "readonly");
            $("#MotherName").attr("readonly", "readonly");
        }

        $('#divDocumentView').kendoWindow({
            modal: true,
            title: "Document",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "15%"
            },
            width: "70%", height: "80%"
        });

    });

    function FilterFormId() {
        return {
            ApplicationFormId: $("#ApplicationFormId").val(),
            DepartmentId: 1
        };
    }

    function OpenDocument(row) {
        $("#divDocumentView").empty();
        var tr = $(row).parent().parent();
        var link = $(tr).children("td:eq(5)").text();
        $("#divDocumentView").append($('<iframe src=' + link + ' style="width:900px;height:500px;overflow:hidden;"></iframe>'));
        $("#divDocumentView").data("kendoWindow").center();
        $("#divDocumentView").data("kendoWindow").open();
        $("#divDocumentView").data("kendoWindow").pin();
    }

    function OpenSubmittedFormForPrint() {
        var FormId = $("#ApplicationFormId").val();
        var schemeType = $("#SchemeType").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ ApplicationFormId: FormId, FormId: FormId, SchemeType: schemeType }),
            url: '/Online/Institutional/PrintInstitutionalSchemeFormByTemplate',
            success: function (result) {
                var DocGrid = $("#documenttable").html();
                var DirGrid = $(".DirectorGrid").html();
                var payment = $(".payment_data").html();
                result = result.replace("$DirectorGrid$", DirGrid);
                result = result.replace("$SchemeDoc$", DocGrid);
                result = result.replace("$PaymentGrid$", payment);
                $("#divApplicationForm").modal('hide');
                $("#divSchemeForm").html(result);
                $("#divPrintSchemeForm").modal('show');
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alertify.error("Some Error in saved database.");
            }
        });
    }

    function PrintSchemeFormDiv() {
        var contents = document.getElementById("divSchemeForm").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }

    function PrintDiv() {
        var contents = document.getElementById("divOnlineForm").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('<style>.row-prnt{width:100%;display:table}.row-prnt-pc{width:100%}.row-prnt-hf-lt{width:50%; float:left}.row-prnt-hf-rt{width:50%; float:right}</style>');
        frameDoc.document.write('<style>.form-group{padding:6px 0 6px 0}.col-prnt-lt{width:50%;float:left}.col-prnt-rt{width:50%;float:right}.hdr-ln{display:none;}</style>');
        frameDoc.document.write('<style>#divUserPhoto{width:80px;height:100px;float:right;}#divUserSign{width:80px;height:100px;float:right}</style>');
        frameDoc.document.write('<style>#UserImage{width:80px;height:100px;float:right;margin-right:10px;}#UserSign{width:80px;height:30px;margin-top:70px;margin-right:15px;float:right}</style>');
        frameDoc.document.write('<style>#imguser{width:80px;height:90px;float:right;}#imgsign{width:80px;height:20px;margin-top:60px;float:right}.row-prnt-pc{height:100px;width:100%}</style>');
        frameDoc.document.write('<style>.col-prnt-lt4{width:25%;float:left;display:inline-block}h1{font-size:24px}h2{font-size:20px}</style>');
        frameDoc.document.write('<style>.col-prnt-hd{width:100%;text-align:left;}label{padding-left:10px}textarea{width:95%}.k-datepicker .k-input{width:95%}</style>');
        frameDoc.document.write('<style>.btn{display:none}</style>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }
</script>