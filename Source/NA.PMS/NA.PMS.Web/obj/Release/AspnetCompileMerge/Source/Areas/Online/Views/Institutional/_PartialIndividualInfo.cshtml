@model NA.PMS.OnlineScheme.SchemeFormViewModel
@using Kendo.Mvc.UI;
@using NA.PMS.Common

<div id="OnlineAppRequestForIndividual row-prnt">
    <div class="row row-prnt" id="divFirstAndMiddleName">
        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @Html.Label("First Name", htmlAttributes: new { @class = "required" })
        </div>
        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @Html.TextBoxFor(model => model.FirstName, new { @class = "form-control", @maxlength = "100", @onchange = "GetCompleteName();", placeholder = "First Name" })
            @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @Html.Label("Middle Name")
        </div>
        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @Html.TextBoxFor(model => model.MiddleName, new { @class = "form-control", @maxlength = "100", @onchange = "GetCompleteName();", placeholder = "Middle Name" })
        </div>
    </div>
    <div class="row row-prnt">
        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @Html.Label("Last Name", new { @class = "required", id = "lblLastName" })
        </div>
        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @Html.TextBoxFor(model => model.LastName, new { @class = "form-control", @maxlength = "100", @onchange = "GetCompleteName();", placeholder = "Last Name" })
            @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @Html.Label("Gender", htmlAttributes: new { @class = "required" })
        </div>
        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            <div id="ddlGenderName" style="width:100%">
                @(Html.Kendo().DropDownListFor(m => m.Gender).Filter("contains")
                        //.Events(events => { events.Change("GenderChange"); })
                        .DataTextField("Text")
                        .DataValueField("Text")
                        .OptionLabel("Select")
                        .DataSource(source =>source.Read(read =>read.Action("GetGenderList", "Application", new { Area = "Online" })))
                        .HtmlAttributes(new { @class = "", style = "width: 100%" })
                )
                @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="row row-prnt" id="divParentsName">
        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @Html.Label("Father's Name", new { @class = "required", @id = "lblFatherName" })
        </div>
        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @Html.TextBoxFor(model => model.FatherName, new { @class = "form-control", @maxlength = "150", placeholder = "Father/Husband Name" })
            @Html.ValidationMessageFor(model => model.FatherName, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @Html.Label("Mother's Name", htmlAttributes: new { @class = "" })
        </div>
        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @Html.TextBoxFor(model => model.MotherName, new { @class = "form-control", @maxlength = "150", placeholder = "Mother Name" })
            @Html.ValidationMessageFor(model => model.MotherName, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="row row-prnt">
        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @Html.Label("Date Of Birth", htmlAttributes: new { @class = "required" })
        </div>
        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @(Html.Kendo().DatePickerFor(model => model.DOB)
                    .Events(e => { e.Change("changeDOB"); })
                    .HtmlAttributes(new { style = "width:100%", @class = "DisableKeyboardInput" })
            )
            @Html.ValidationMessageFor(model => model.DOB, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @Html.Label("Marital Status", htmlAttributes: new { @class = "required" })
        </div>
        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @(Html.Kendo().DropDownListFor(m => m.MaritalStatus).Filter("contains")
                .DataTextField("Text")
                .DataValueField("Text")
                .OptionLabel("Select")
                .DataSource(source =>source.Read(read =>read.Action("GetMaritalStatusList", "Application", new { Area = "Online" })))
                .HtmlAttributes(new { @class = "schemeForms", style = "width: 100%" })
            )
            @Html.ValidationMessageFor(model => model.MaritalStatus, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="row row-prnt" style="display:none">
        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @Html.Label("Category", htmlAttributes: new { @class = "required" })
        </div>
        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @(Html.Kendo().DropDownListFor(m => m.CategoryId).Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel("Select")
                    .DataSource(source =>source.Read(read =>read.Action("GetCategoryList", "Application", new { Area = "Online" })))
                    .HtmlAttributes(new { @class = "schemeForms", style = "width: 100%" })
            )
            @Html.ValidationMessageFor(model => model.CategoryId, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-2 col-20 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @Html.Label("Occupation", htmlAttributes: new { @class = "required" })
        </div>
        <div class="col-md-4 col-30 col-sm-3 col-xs-12 form-group col-prnt-lt4">
            @(Html.Kendo().DropDownListFor(m => m.OccupationId).Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel("Select")
                    .DataSource(source =>source.Read(read =>read.Action("GetOccupationList", "Application", new { Area = "Online" })))
                    .HtmlAttributes(new { @class = "schemeForms", style = "width: 100%" })
            )
            @Html.ValidationMessageFor(model => model.OccupationId, "", new { @class = "text-danger" })
        </div>
    </div>
</div>

<script type="text/javascript">
    function CascadeData() {
        var SchemeId = $("#SchemeId").val();
        var deptID = $("#DepartmentId").val();
        return {
            schemeid: SchemeId,
            depttID: deptID
        };
    }

    function GetCompleteName() {
        //var radiobtnVal = $('input[name=ApplicantType]:checked', '#applicationform').val();
        var radiobtnVal = $('#DDLApplicantType').val();
        if (radiobtnVal == "Individual") {
            var fn = $('#FirstName').val();
            var mn = $('#MiddleName').val();
            var ln = $('#LastName').val();
            $('#Applicant').val(fn + " " + mn + " " + ln);
            //$('#RefundInfaverof').val(fn + " " + mn + " " + ln);
        }
    }

    $('#FatherName').change("click", function () {
        var fname = $('#FatherName').val();
        $('#FatherName').val(fname.trim());
    });

    $('#MotherName').change("click", function () {
        var mname = $('#MotherName').val();
        $('#MotherName').val(mname.trim());
    });

    $('#FirstName').change("click", function () {
        var fname = $('#FirstName').val();
        $('#FirstName').val(fname.trim());
    });

    $('#LastName').change("click", function () {
        var mname = $('#LastName').val();
        $('#LastName').val(mname.trim());
    });

    function changeDOB() {
        var dob = new Date(kendo.toString(this.value(), 'd'));
        CheckAge(dob);
    }

    function CheckAge(dob) {
        var today = new Date();
        var age = today.getTime() - dob.getTime();
        age = Math.floor(age / (1000 * 60 * 60 * 24 * 365.25));
        if (age < 18) {
            alertify.error("Age should be minimum 18 years.");
            $("#DOB").data('kendoDatePicker').value("")
            $("#Age").val('');
            return false;
        }
        else {
            $("#Age").val(age);
            return true;
        }
    }

    function ValidateIndividualFields() {
        var bflag = true;
        fname = $("#FirstName").val();
        if (fname.trim() == "") {
            alertify.error("Please enter First Name");
            bflag = false;
        }
        //else if ($("#LastName").val() == "") {
        //    alertify.error("Please enter Last Name");
        //    bflag = false;
        //}
        else if ($("#Gender").val() == "") {
            alertify.error("Please select Gender");
            bflag = false;
        }
        else if ($("#DOB").val() == "") {
            alertify.error("Please enter date of birth");
            bflag = false;
        }
        else if ($("#FatherName").val() == "") {
            alertify.error("Please enter Father Name");
            bflag = false;
        }
        //else if ($("#MaritalStatus").val() == "") {
        //    alertify.error("Please select Marital Status");
        //    bflag = false;
        //}
        //else if ($("#CategoryId").val() == "") {
        //    alertify.error("Please select Category");
        //    bflag = false;
        //}
        //else if ($("#OccupationId").val() == "") {
        //    alertify.error("Please select Occupation.");
        //    bflag = false;
        //}
        return bflag;
    }


    function ClearIndividualField() {
        $('#FirstName').val('');
        $('#MiddleName').val('');
        $('#LastName').val('');
        $('#FatherName').val('');
        $('#MotherName').val('');
        $('#Gender').data("kendoDropDownList").value('');
        $('#MaritalStatus').data("kendoDropDownList").value('');
        $('#CategoryId').data("kendoDropDownList").value('');
        $('#OccupationId').data("kendoDropDownList").value('');
        $('#DOB').data("kendoDatePicker").value('');
    }

</script>