@using Kendo.Mvc.UI;
@using NA.PMS.Model

@{
    ViewBag.Title = "Manage Online Scheme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Scripts/kendo.aspnetmvc.min.js"></script>
<style>
    .k-grid-content {
        overflow-y: hidden;
        overflow-x: hidden;
    }
    .k-grid-pager .k-dropdown{
        width:auto;
    }
    .k-grid .s-blue{
        color:blue;
    }
    .k-grid .s-red{
        color: darkred;
    }
    .k-grid .not-completed{
        background-color: #ff9999;
    }
</style>

<div class="ManageAdminRoles">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Online Scheme</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                <a href="#" id="btnAddRole" class="" onclick="javascript:UpdateScheme(event);">Update Scheme</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>

    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.UserManagement.NDAMasterDataViewModel>()
              .Name("gridApplication")
              .Columns(columns =>
              {
                  columns.Bound(c => c.Id).Hidden(true);
                  columns.Bound(c => c.SchemeId).Title("Id").Width(100);
                  columns.Bound(c => c.SchemeName).Title("Scheme Name");
                  columns.Bound(c => c.StartDate).Title("Start Date").Width(120).Format("{0:dd-MMM-yyyy}");
                  columns.Bound(c => c.EndDate).Title("End Date").Width(110).Format("{0:dd-MMM-yyyy}");
                  columns.Bound(c => c.SchemeFormFee).Title("Form Fee").Width(110).Format("{0:##,#}");
                  columns.Bound(c => c.ProcessingFee).Title("Processing Fee").Width(150).Format("{0:##,#}");
                  columns.Bound(c => c.StatusName).Title("Status").Width(120).ClientTemplate("<label class=' #if(StatusId == 24){# s-blue #}else{# s-red #}#'> #=StatusName#</label>");
                  columns.Bound(c => c.Id).Title("Action").Width(100).ClientTemplate("<label class='hyperlink' onclick='javascript:Deactivate(#= SchemeId #);'>#if(IsActive == true){#<span>Deactivate</span>#}else{#<span>Activate</sapn>#}#</label>");
                  //columns.Bound(c => c.Id).Title("Docs").Width(100).ClientTemplate("<a href='/NIC/Views/Template/NOIDA-IP-2020-21-OES-01.docx' target='_blank'>View docs</a>");
              })
              .Sortable().Filterable().Resizable(resize => resize.Columns(true)).Events(e=>e.DataBound("GridColumnAutoFitEvent"))
              .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(new[] { 10, 50, 100, 500 }).Info(true).PreviousNext(true).Input(true).Numeric(true).ButtonCount(10))
              .DataSource
              (
                  dataSource => dataSource
                      .Ajax()
                      .Model(model => model.Id(p => p.Id))
                      .ServerOperation(true)
                      .Read(read => read.Action("GetOnlineSchemeListAsDataSource", "Organization", new { area = "Admin" }))
                      .Sort(s=>s.Add(f=>f.CreatedDate).Descending())
                      .PageSize(10)
              )
        )
       
    </div>
</div>


<div id="window-modal" class="modal fade" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog" style="min-height:250px; min-width:70%;border-radius:0;">
        <div class="modal-content" style="border-radius:0;">
            <div class="modal-body">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                @*<iframe src="https://docs.google.com/gview?url=http://localhost:53000/Areas/NIC/Views/Template/NOIDA-IP-2020-21-OES-01.docx&embedded=true" width="100%;"></iframe>*@
                @{Html.RenderPartial("_PartialScheme");}
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function GridColumnAutoFitEvent(e){
        for (var i = 0; i < this.columns.length -1; i++) {
            this.autoFitColumn(i);
        }

        for(var j =0; j < this._data.length; j++){
            var stsname = this._data[j].StatusName;
            if(stsname != "Completed"){
                var row = $(this.tbody.find('tr')[j]);
                row.addClass("not-completed");
            }
        }
    }

    function Deactivate(appid) {
        $.ajax({
            dataType: 'json',
            contentType: 'application/json; charset=utf-8',
            type: "POST",
            data: JSON.stringify({ ApplicationId: appid, ActionType: "Status", FilterType: "Application" }),
            url: '/Admin/Organization/SaveMasterDataInfoByType',
            success: function (data) {
                $('#gridApplication').data('kendoGrid').dataSource.read();
            },
            error: function (msg) {
                alert("Error Occured-" + msg.responseText);
            }
        });
    }

    function UpdateScheme(event) {
        event.preventDefault();
        $('#window-modal').modal('show');       
    }
</script>

