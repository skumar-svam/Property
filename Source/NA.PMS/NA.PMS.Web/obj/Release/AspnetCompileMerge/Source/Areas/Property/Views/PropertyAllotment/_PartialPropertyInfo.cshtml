@model NA.PMS.Model.AllottedPropertyViewModel
@using Kendo.Mvc.UI;


<div class="col-md-12 nav-sub-group">
    <ul class="nav nav-tabs content-tabs" id="ulProperty" role="tablist" style="float:right;">
        <li class="active"><a href="#applicant-info" role="tab" data-toggle="tab">Basic Info</a></li>
        <li><a href="#property-info" role="tab" data-toggle="tab">Property Info</a></li>
        <li><a href="#sublease-info" role="tab" data-toggle="tab">Sublease Property</a></li>
    </ul>
</div>
<div class="col-md-12 tab-content" style="border:solid #e2e3e4; border-width:0 1px 1px 1px">
    <div class="tab-pane fade in active" id="applicant-info">
        <h2 class="blck-heading">Allottee Details</h2>
       <div class="form-bx">
           <div class="row">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_ApplicantName">Applicant's Name </label>  </div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="ApplicantName">@Html.DisplayFor(model => model.Applicant.Applicant)</label> </div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_PanCard">PAN Details </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="PanCard">@Html.DisplayFor(model => model.Applicant.PAN)</label></div>
           </div>
           <div class="row">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_Gender">Gender</label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="Gender">@Html.DisplayFor(model => model.Applicant.ApplicantType)</label> </div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_Father">Father's Name </label> </div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="Father">@Html.DisplayFor(model => model.Applicant.ApplicantMaster)</label> </div>
           </div>
           <div class="row">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_Mobile">Mobile Number </label> </div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="Mobile">@Html.DisplayFor(model => model.Applicant.MobileNo)</label> </div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_Address">Address </label> </div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="Address">@Html.DisplayFor(model => model.Applicant.CorrespondAddress)</label> </div>
           </div>
           <div class="row" id="divCatOcup">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_occupation">Occupation </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="occupation">@Html.DisplayFor(model => model.Applicant.Occupation)</label> </div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_Category">Category </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="Category"></label> </div>
           </div>
           <div class="row" id="divReligionIncome">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_Religion">Religion </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="Religion"></label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_AnnualIncome">Annual Income </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="AnnualIncome">@Html.DisplayFor(model => model.Applicant.AnnualIncome)</label></div>
           </div>
           <div class="row" id="divPhone">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_PhoneNumber">Phone Number </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="PhoneNumber">@Html.DisplayFor(model => model.Applicant.PhoneNo)</label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_FaxNumber">Fax Number</label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="FaxNumber">@Html.DisplayFor(model => model.Applicant.PhoneNo)</label></div>
           </div>
           <div class="row" id="divAddress">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_CorrespondAddress">Correspond Address </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="CorrespondAddress">@Html.DisplayFor(model => model.Applicant.CorrespondAddress)</label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_PermanentAddress">Permanent Address</label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="PermanentAddress">@Html.DisplayFor(model => model.Applicant.PermanentAddress)</label></div>
           </div>
       </div>
    </div>

    <div class="tab-pane fade" id="property-info">
        <h2 class="blck-heading">Property Details</h2>
       <div class="form-bx">
           <div class="row">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_schemeName">Scheme Name</label> </div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="schemeName">@Html.DisplayFor(model => model.Property.SchemeName)</label> </div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_department">Department Name</label> </div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="Department">@Html.DisplayFor(model => model.Property.Department)</label> </div>
           </div>
           <div class="row">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_FormID">Form Number </label> </div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="FormID">@Html.DisplayFor(model => model.Property.Department)</label>  </div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_propertytype">Property Type</label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="propertytype">@Html.DisplayFor(model => model.Property.PropertyType)</label></div>
           </div>
           <div class="row">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_sector">Sector </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="sector">@Html.DisplayFor(model => model.Property.SectorName)</label> </div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_coveredArea">Covered Area </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="coveredArea">@Html.DisplayFor(model => model.Property.CoveredArea)</label></div>
           </div>
           <div class="row">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_Block">Block </label> </div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="Block">@Html.DisplayFor(model => model.Property.BlockName)</label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_totalarea">Total Area </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="totalarea">@Html.DisplayFor(model => model.Property.TotalArea)</label> </div>
           </div>
           <div class="row">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_propertynu">Property No/Plot No </label> </div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="propertynu">@Html.DisplayFor(model => model.Property.PlotNo)</label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_actualarea">Actual Area </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="actualarea">@Html.DisplayFor(model => model.Property.ActualArea)</label></div>
           </div>
           <div class="row">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_floor">Floor </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="floor">@Html.DisplayFor(model => model.Property.FloorArea)</label></div>

               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_propertyCost">Property Cost </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="propertyCost">@Html.DisplayFor(model => model.Property.PropertyCost)</label></div>
           </div>
           <div class="row">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_landRate">Land Rate </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="landRate">@Html.DisplayFor(model => model.Property.LandRate)</label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_civilcost">Civil Cost </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="civil">@Html.DisplayFor(model => model.Property.CivilCost)</label></div>
           </div>
           <div class="row">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_locationCharges">Location Charges </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="locationCharges">@Html.DisplayFor(model => model.Property.LocationCharge)</label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_totalpropertyCost">Total Property Cost </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="totalpropertyCost">@Html.DisplayFor(model => model.Property.TotalPropertyCost)</label></div>
           </div>
           <div class="row">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_locationType">Location Type </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="locationType">@Html.DisplayFor(model => model.Property.LocationType)</label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_totalInstallment">Total No. of Installment </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="lbl-form-control" id="totalInstallment">@Html.DisplayFor(model => model.Property.TotalInstallment)</label></div>
           </div>
           <div class="row">
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_allotmentDate">Allotment Date: </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><input id="allotmentDate" value='@Html.DisplayFor(model => model.Property.AllotmentDate)' readonly="readonly" style="width:100%" /></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label id="_installmentStartDate">Installment Start Date </label></div>
               <div class="col-md-3 col-sm-3 col-xs-12 form-group"><input id="installmentStartDate" value='@Html.DisplayFor(model => model.Property.AllotmentDate)' readonly="readonly" style="width:100%" /></div>
           </div>
           <div class="row">
               @Html.HiddenFor(model => model.Property.AllotmentDate)
               @Html.HiddenFor(model => model.Property.PropertyId)
               @Html.HiddenFor(model => model.Property.SchemeId)
               @Html.HiddenFor(model => model.Property.DepartmentId)
               <input type="hidden" id="hidinstallmentStartDate" />
           </div>
       </div>
    </div>

    <div class="tab-pane fade" id="sublease-info">
        <div class="col-md-12 k-grid-content">
            @(Html.Kendo().Grid<NA.PMS.Model.PropertyViewModel>()
                .Name("SubLeasePropertyGrid")
                .Columns(columns =>
                    {
                        columns.Bound(c => c.Id).Hidden(true);
                        columns.Bound(c => c.ParentPropertyId).Hidden(true);
                        columns.Bound(c => c.RegistrationId).Title("Registration Id");//.ClientTemplate("<label class='hyperlinkcss' onclick='javascript:ViewProperty(#=Id#)'>#=RegistrationId#</label>");
                        columns.Bound(c => c.SectorName).Title("Sector");
                        columns.Bound(c => c.BlockName).Title("Block");
                        columns.Bound(c => c.PlotNo).Title("Plot No");
                        columns.Bound(c => c.Department).Title("Department");
                        columns.Bound(c => c.TotalArea).Title("Area");
                        columns.Bound(c => c.TotalPropertyCost).Title("Cost").HtmlAttributes(new { @class = "fa fa-inr" });
                        columns.Bound(c => c.Status).Title("Status");//.ClientTemplate("#if(SubLeaseStatus=='Active'){#<label class='actve'>#=SubLeaseStatus#</label>#}else{#<label class='inactve'>#=SubLeaseStatus#</label>#}#").HtmlAttributes(new { @class = "abc" });
                    })
                    //.Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                .DataSource(dataSource => dataSource
                            .Ajax().Model(model => model.Id(p => p.Id))
                            .ServerOperation(true)
                            .Read(read => read.Action("GetSubLeasedPropertyByIdAsDataSource", "PropertyAllotment", new { area="Property"}).Data("FilterPropertyId")).Sort(sort => sort.Add("Id").Descending())
                            .PageSize(10)
                        )
            )
        </div>

    </div>
</div>



