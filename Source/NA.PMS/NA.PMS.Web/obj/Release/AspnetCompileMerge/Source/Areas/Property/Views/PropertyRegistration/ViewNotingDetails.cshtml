@model NA.PMS.Model.NotingDetailsModel
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;

@{
    ViewBag.Title = "Noting Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    #divViewComment{
        min-height:250px;
        max-height:450px;
    }
</style>

<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="row">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Noting Details</h1></div>
                <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                    <a href="#" id="btnViewComment" class="" onclick="javascript:ViewAllComments();">View Comment</a>
                </div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
                <h2 class="blck-heading">Add notes for property</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                            @Html.Label("Registration Id")
                            @Html.HiddenFor(m => m.Rid)
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.DisplayFor(m => m.Rid)
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                            @Html.Label("Department")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.DisplayFor(m => m.DepartmentName)
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                            @Html.Label("File Number")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.DisplayFor(m => m.FileName)
                        </div>
                    </div>

                    @if (Model.NotingDetails != null)
                    {
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                                @Html.Label("File")
                            </div>
                            <div class="col-md-9 col-sm-9 col-xs-12 form-group" style="background:#ffffff;">
                                <div id="comment" style="word-wrap:break-word; width:100%;height:240px; overflow:auto;margin-left:10px;">
                                    @Model.ViewComments
                                </div>
                                <div id="divPrintFor" style="width:100%;height:35px;text-align:right;background:#e2e3e4;">
                                    <input type="button" id="btnPrintNotingDetail" class="btn btn-add" value="Print" style="margin-right:20px;"/>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                            @Html.Label("Noting Details")
                        </div>
                        <div class="col-md-9 col-sm-9 col-xs-12 form-group">
                            @(Html.Kendo().EditorFor(model => model.AddNotingDetails)
                                    //.Name("NotingDetails")
                                    .HtmlAttributes(new { style = "height:240px; width:100%;" })
                                    .Resizable(resizable => resizable.Content(true).Toolbar(true))
                            )
                        </div>
                    </div>
                    <div class="row">
                        @if (Model.IsNotingDetailShow == true)
                        {
                            <div class="col-md-12 col-sm-12 col-xs-12 form-group" style="text-align:right">
                                <input type="button" id="btnAddComment" class="btn btn-add" value="Add Comment" style="margin-right:15px;" />
                            </div>
                        }                        
                    </div>                   

                </div>
                <div class="box-button text-center">
                    <input type='button' id="btnBack" class='btn btn-default' value='Back' />
                    @if (Model.IsNotingDetailShow == true)
                    {
                        <input type="button" id="btnSubmitForApprovallink" class="btn btn-add" alt="click to open Check List popup" value="Move" />
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div id="divViewComment">
    <div class="row">
        <div id="divCommentBody" class="col-md-12 form-group">
            <div id="comment" style="word-wrap:break-word;">
                @Model.ViewComments
            </div>
        </div>
    </div>
</div>

<div id='divAssineRequetApproval' class='adminfeediv'>
    <div class="row" style="padding-top:15px;padding-bottom:40px;">
        <div class="col-md-4 col-sm-4 col-xs-12 col-for-label form-group">
            @Html.Label("Send to :")
        </div>
        <div class="col-md-5 col-sm-6 col-xs-12 form-group">
            @(Html.Kendo().DropDownListFor(model => model.User)
            .Name("User")
            .DataTextField("text")
            .DataValueField("id")
            .Filter("contains")
            .OptionLabel("Select")
            .DataSource(source =>
            {
                source.Read(read =>
                {
                    read.Action("GetAssineTo", "Allotment");
                });
            })
            .HtmlAttributes(new { style = "width:100%" })
            )
            @Html.ValidationMessageFor(model => model.User)
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12 form-group" style="text-align:center">
            <button type='button' class='btn btn-default' value='Cancel' onclick="CloseCommnetPopUpForApproval();">Close</button>
            <button type='submit' id="btnRequetForApproval" class='btn btn-default' value='Save'>Submit</button>
        </div>
    </div>
</div>


<script type="text/javascript">
    $("#btnBack").click(function () {
        window.location.href = '@Url.Action("ManageNotings", "PropertyRegistration")';
    });
    $(document).ready(function () {

        var editor = $('#AddNotingDetails').data('kendoEditor');
        if ('@Model.IsNotingDetailShow' == 'True') {
            editor.body.contentEditable = true;
        }
        else {
            editor.body.contentEditable = false;
        }

        $("div[id='divViewComment']").kendoWindow({
            modal: true,
            title: "Comments",
            actions: ["Pin", "Minimize", "Maximize", "Close"],
            visible: false,
            width: "60%"
        });

        $("div[id='divAssineRequetApproval']").kendoWindow({
            modal: true,
            title: "Move Noting",
            visible: false,
            width: "39%"
        });
        $("#btnSubmitForApprovallink").click(function () {
            OpenAssineRequetApprovalPopUp()
        });
    });

    function OpenAssineRequetApprovalPopUp() {
        var win = $("#divAssineRequetApproval").data("kendoWindow");
        win.center();
        win.open();
    }
    function CloseCommnetPopUpForApproval() {
        var win = $("#divAssineRequetApproval").data("kendoWindow");
        win.close();
    }

    $('#btnViewComment').click(function () {
        var win = $("#divViewComment").data("kendoWindow");
        win.center();
        win.open();
    })

