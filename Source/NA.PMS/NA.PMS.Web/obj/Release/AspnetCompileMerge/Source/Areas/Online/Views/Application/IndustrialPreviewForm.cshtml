<script type="text/javascript">

    $(document).ready(function () {

        $('input:radio[name=SingleWindowPortalOption]').on('change', function () {
            var formType = $('input[name=SingleWindowPortalOption]:checked').val();
            var formId = $("#ApplicationFormId").val();
            var totalAmount = $("#TotalAmount").val();
            var encryptId = $("#EncryptedFormId").val();
            if (formType.trim() == "1") {

                var type = "Payment";
                ValidatePayment(formId, type);
            }
            else if (formType.trim() == "2") {
                if (confirm("Are you sure? You want to make Consolidate Payment through Single Window Portal.")) {
                    $.ajax({
                        type: 'POST',
                        dataType: 'json',
                        data: { ApplicationFormId: formId, TotalAmount: totalAmount },
                        url: '/Online/Payment/SingleWindowPortalPayment',
                        success: function (result) {
                            if (result == '@ReturnType.Updated') {
                                window.location.href = '@Url.Action("PreviewForm", "Application", new { area = "Online" ,id=Model.EncryptedFormId })';
                            }
                            else {
                                alertify.error("Please try again.");
                            }
                        },
                        error: function (ajaxRequest, strError) {
                            var respText = ajaxRequest.responseText;
                            //alert(respText);
                        }
                    });
                }
                else {
                    event.preventDefault();
                    $('input[name=SingleWindowPortalOption]').prop('checked', false);
                }
            }
        });


        $("#documenttable").hide();
        var formType = $('#ApplicationFormType').val();
        if (formType.trim() == "Expansion") {
            $('#divExpansionType').show();
        }
        else {
            $('#divExpansionType').css("display", "none");
            $('#divRentPermission').css("display", "none");
            $('.row-rent').css("display", "none");
            $('.col-rent').css("display", "none");
            $('#divExistingAllottee').css("display", "none");
        }

        var expansionType = $('#ExpansionType').val();
        if (expansionType.trim() == "Rent Permission") {
            $('#divRentPermission').show();
            $('.row-rent').show();
            $('.col-rent').show();
            $('#divExistingAllottee').css("display", "none");
        }
        if (expansionType.trim() == "Existing Allottee") {
            $('#divRentPermission').css("display", "none");
            $('.row-rent').css("display", "none");
            $('.col-rent').css("display", "none");
            $('#divExistingAllottee').show();
        }


        //var radiobtnVal = $('input[name=ApplicantType]:checked', '#applicationform').val();
        var radiobtnVal = $('#ApplicantType').val();
        if (radiobtnVal == "Company") {
            $('.lbl-permanent-address').text("Registered Office");
            $('#divIndividualInfo').css("display", "none");
            $('.row-company').show();
            $("label[for='Applicant']").html("Company");
        }
        else if (radiobtnVal == "Individual") {
            $('.lbl-permanent-address').text("Permanent Address");
            $('#divIndividualInfo').show();
            $('.row-company').css("display", "none");
            $("label[for='Applicant']").html("Applicant");
        }

        $('.single').attr("disabled", true);
        $('.inpchk').attr("disabled", "disabled");

        $('#Gender').data("kendoDropDownList").enable(false);
        $('#MaritalStatus').data("kendoDropDownList").enable(false);
        $('#CategoryId').data("kendoDropDownList").enable(false);
        $('#OccupationId').data("kendoDropDownList").enable(false);
        $('#DOB').data("kendoDatePicker").enable(false);
        $("input[type='radio'][name=ApplicationFormType]").attr("disabled", "disabled");
        $("input[type='radio'][name=ApplicantType]").attr("disabled", "disabled");
        $("input[type='radio'][name=ExpansionType]").attr("disabled", "disabled");
        $("input[type='checkbox'][name=checboxDeclaration]").attr("disabled", "disabled");
        //$("#DispatchDate").data("kendoDatePicker").enable(false);
        $("#LetterDate").data("kendoDatePicker").enable(false);

        var gender = $("#Gender").val();
        if (gender != "Company") {
            $("#FirstName").attr("readonly", "readonly");
            $("#MiddleName").attr("readonly", "disabled");
            $("#LastName").attr("readonly", "readonly");
            $("#FatherName").attr("readonly", "readonly");
            $("#MotherName").attr("readonly", "readonly");
        }

        $('.helpsupport').click(function () {
            window.location.href = '@Url.Action("HelpOnline", "Application", new {area="Online", target="_blank"})';
        });



