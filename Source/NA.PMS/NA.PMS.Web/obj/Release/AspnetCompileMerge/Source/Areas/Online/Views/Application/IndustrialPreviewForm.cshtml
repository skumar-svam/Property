<script type="text/javascript">
    function ValidatePayment(formId, Type) {
        var encryptedId = $('#EncryptedFormId').val();
        var schemeType = $("#SchemeType").val();
        if (formId.trim() != "") {
            $.ajax({
                type: 'POST',
                dataType: 'json',
                data: { formNo: formId },
                url: '/Online/Application/ValidateOnlineFormPayment',
                success: function (result) {
                    if (result == '@NA.PMS.Common.ReturnType.None') {
                        if (Type == "Payment") {
                            $("#divPaymentwindow").data("kendoWindow").center();
                            $("#divPaymentwindow").data("kendoWindow").open();
                            $("#divPaymentwindow").data("kendoWindow").pin();
                        }
                        else if (Type == "Edit") {
                            if (schemeType == '@OnlineSchemeType.IndustrialPlots') { window.location.href = '@Url.Action("EditForm", "Application", new { area="Online"})' + "?id=" + encryptedId; }
                            else if (schemeType == '@OnlineSchemeType.Transport') { window.location.href = '@Url.Action("TransportSchemeForm", "Application", new { area = "Online" })' + "?id=" + encryptedId; }
                            else if (schemeType == '@OnlineSchemeType.OpenEnded') { window.location.href = '@Url.Action("OpenSchemeForm", "Application", new { area = "Online" })' + "?id=" + encryptedId; }
                        }
                    }
                    var nExist = result.split("#");
                    if (nExist[0] == '@NA.PMS.Common.ReturnType.Exist') {
                        alertify.error("Not allowed after payment (online) or challan generation (offline).");
                        return false;
                    }
                    else {
                        alertify.error("1. Not allowed after payment (online) or challan generation (offline).");
                        return false;
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                }
            });
        }
    }
</script>
