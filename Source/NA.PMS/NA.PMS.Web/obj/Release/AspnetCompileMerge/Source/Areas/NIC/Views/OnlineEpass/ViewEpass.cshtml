        </div>
        <div class="col-md-4 col-sm-4 col-xs-12 form-group">
            <input class="k-button" type="button" value="Resend" id="btn-otp-resend" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-2 col-sm-4 col-xs-12 form-group">
            <input type="hidden" id="hdn-otp" />
        </div>
        <div class="col-md-4 col-sm-4 col-xs-12 form-group">
            <input type="button" class="k-button" id="btn-validate-otp" value="Submit" style="width:100%" />
        </div>
        <div class="col-md-4 col-sm-4 col-xs-12 form-group">
            <input type="button" class="k-button" id="btn-cancel-otp" value="Cancel" style="width:100%" />
        </div>
    </div>
</div>

<div id="progressbar" style="width:100%; text-align:center;">
    <div id="loader" style="position: fixed;top:210px; left:0;  width:100%; height: 100%;  ">
        <img src="~/Content/Images/ajax_loader_red.gif" style="width:200px;height:200px;" />
    </div>
</div>




<script>
    $(document).ready(function () {

        $('#div-otp-popup-window').kendoWindow({
            modal: true,
            title: "Online E-Pass validation",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "30%"
            },
            width: "40%", height: "210px" //"35%"
        });

        $('#userid').click(function () {
            $("#imguser").click();
        });

        $("#imguser").change(function () {
            readURL(this);
        });

        $('#btn-next-form').click(function () {
            SendOTP();
            //$('#div-otp-popup-window').data("kendoWindow").open();
        });

        $('#btn-cancel-otp').click(function () {
            $('#div-otp-popup-window').data("kendoWindow").close();
        });

        $('#btn-validate-otp').click(function () {
            ValidateOtpOnPage();
            //$('#div-otp-popup-window').data("kendoWindow").close();
        });

        $('#btn-form-submit').click(function () {
            if (ValidateFormFields()) {
                SubmitEpassForm();
            }
        });
    });
    function readURL(input) {
        if (CheckUserImage(input)) {
            if (input.files && input.files[0]) {
                var imgsize = input.files[0].size / 1024;
                if (imgsize > 11 && imgsize < 51) {
                    var reader = new FileReader();
                    $('#userid').css("display", "none");
                    reader.onload = function (e) {
                        $('#userphoto').attr('src', e.target.result);
                    }
                    $('#userphoto').show();
                    reader.readAsDataURL(input.files[0]);
                }
                else {
                    alertify.error("user image min(10kb) and max(50kb)");
                    $('#imguser').val('');
                }
            }
        }
        else {
            $('#imguser').val('');
        }
    }

    function CheckUserImage(input) {
        var file = input.files[0].name;
        var count = file.lastIndexOf('.') + 1;
        var ext = file.substr(count);
        if (ext.toLowerCase() == "jpg") {
            return true;
        }
        else {
            alertify.error("Only jpg file allowed.");
            return false;
        }
    }

    function SendOTP() {
        var mobile = $('#MobileNo').val();
        var mailId = $('#Email').val();
        if (mobile != "") {
            $.ajax({
                type: 'POST',
                dataType: 'json',
                data: { mobileNo: mobile, email: mailId },
                url: '/NIC/OnlineEpass/SendOTP',
                success: function (result) {
                    if (result != null) {
                        $('#hdn-otp').val(result);
                        $('#div-otp-popup-window').data("kendoWindow").open();
                        //alertify.success("OTP has been sent on your mobile and email id successfuly.");
                        return false;
                    }
                    else {

                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    //alert(respText);
                }
            });
        }
        else {
            alertify.error("Please enter Mobile No");
        }
    }

    function ValidateOtpOnPage() {
        var otp_sent = $('#text-otp').val();
        var otp_return = $('#hdn-otp').val();
        if (otp_sent != "") {
            if (otp_sent == otp_return) {
                $('#CommonInfo').show();
                $('#h2-declaration').show();
                $('#div-declaration').show();
                $('#btn-form-submit').show();
                $('#div-otp-popup-window').data("kendoWindow").close();
                //SubmitOpenSchemeForm();
            }
            else {
                $('#CommonInfo').css("display", "none");
                $('#h2-declaration').css("display", "none");
                $('#div-declaration').css("display", "none");
                $('#btn-form-submit').css("display", "none");
                alertify.error("OTP mismatch");
            }
        }
    }

    function SubmitEpassForm() {
        $('#btn-form-submit').prop("disabled", true);
        //var atype = $('#DDLApplicantType').val();
        //var ftype = $('#DDLApplicationFormType').val();
        //$('#hdnFormType').val("Online"); //$('#hdnFormType').val(form);
        //$('#ApplicantType').val(atype);
        //$('#ApplicationFormType').val(ftype);

        var formData = new FormData($('form').get(0));
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            data: formData,
            url: '/NIC/OnlineEpass/SaveEpassForm',
            success: function (result) {
                if (result != null) {
                    //$("#ApplicationFormId").val(result.ApplicationFormId);
                    //var gst = CalculateGST(result.ApplicationFee);
                    //var totalAmount = parseFloat((parseFloat(result.ApplicationFee) + parseFloat(gst)).toFixed(2));
                    //$("#schemeformfee").val(totalAmount);
                    //$("#FormFeeWithGST").val(totalAmount);
                    //$(".area-form-fee").show();
                    //$('#div-box-button').css("display", "none");
                    alert("Your e-pass request is submitted successfully.");
                    //ClearInputFields();
                    window.location.reload();
                }
            },
            error: function (ajaxRequest, strError) {
                alertify.error("Network error, try again later");
                $('#btn-form-submit').prop("disabled", false);
            }
        });
    }

    function ValidateFormFields() {
        var bflag = true;
        if ($("#EpassType").val() == "") {
            alertify.error("Please select e-pass type.");
            bflag = false;
        }
        if ($("#IsAuthorityEmployee").val() == "") {
            alertify.error("Please select employee type");
            bflag = false;
        }
        if ($("#Email").val() == "") {
            alertify.error("Please enter email id.");
            bflag = false;
        }
        if ($("#MobileNo").val() == "") {
            alertify.error("Please enter Mobile no.");
            bflag = false;
        }
        if ($("#MobileNo").val() != "") {
            if ($("#MobileNo").val().length != 10) {
                alertify.error("Please enter correct Mobile No.");
                bflag = false;
            }
        }
        //if ($("#EPDI").val() == "") {
        //    alertify.error("Please enter Aadhar Number.");
        //    bflag = false;
        //}
        if ($("#EPDI").val() != "") {
            if ($("#EPDI").val().length != 12) {
                alertify.error("Please enter correct Aadhar Number.");
                bflag = false;
            }
        }
        if ($("#State").val() == "") {
            alertify.error("Please enter State.");
            bflag = false;
        }
        if ($("#City").val() == "") {
            alertify.error("Please enter city name.");
            bflag = false;
        }
        if ($("#LocalPlace").val() == "") {
            alertify.error("Please enter local palace name.");
            bflag = false;
        }
        if ($("#FromAddress").val() == "") {
            alertify.error("Please enter from address.");
            bflag = false;
        }
        if ($("#ToAddress").val() == "") {
            alertify.error("Please enter Destination Address.");
            bflag = false;
        }
        if ($("#StartDate").val() == "") {
            alertify.error("Please enter local palace name.");
            bflag = false;
        }
        if ($("#EndDate").val() == "") {
            alertify.error("Please enter local palace name.");
            bflag = false;
        }
        if ($("#Purpose").val() == "") {
            alertify.error("Please enter purpose for movement.");
            bflag = false;
        }
        if ($("#EpassType").val() != "") {
            if ($("#VehicleType").val() == '') {
                alertify.error("Please select Vehicle type.");
                bflag = false;
            }
            if ($("#VehicleNo").val() == '') {
                alertify.error("Please enter vehicle no.");
                bflag = false;
            }
            if ($("#RCNo").val() == '') {
                alertify.error("Please enter vehicle rc no.");
                bflag = false;
            }
        }

        var dflag = $("#checkbox-declaration").prop("checked");
        if (dflag == false) {
            alertify.error("Please check Declaration .");
            bflag = false;
        }

        return bflag;

    }

