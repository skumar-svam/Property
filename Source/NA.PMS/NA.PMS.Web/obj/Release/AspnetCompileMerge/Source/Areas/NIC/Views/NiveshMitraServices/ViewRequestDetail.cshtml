                                    <div class="row">
                                        <div class="col-md-12" id="file-option" style="padding:0 0 10px 0px;">
                                        </div>
                                    </div>

                                    <input type="submit" id="btn-re-submit" value="Re-Submit" class="btn btn-primary" style="min-width:100px; margin-right:12px;border-radius:0;" />
                                    <input type="button" id="btn-cancel" value="Back" class="btn btn-primary" style="width:100px; margin-right:12px;border-radius:0;" />
                                }

                            }
