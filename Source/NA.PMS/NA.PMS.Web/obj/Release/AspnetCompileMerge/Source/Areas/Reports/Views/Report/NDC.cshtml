
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
@using NA.PMS.Common;
@model NA.PMS.Model.NDCVeiwModel
@{
    ViewBag.Title = "Manage NDC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #ChallanWindow {
        display: none;
    }

    .hyperlink.verify {
        font-weight: bold;
        color: blue;
    }
</style>
<div id="divManageNDC">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">NDC Report</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
              
            </div>
        </div>
    </div>
    <div class="col-md-12 row blnk-rw"></div>
    <div class="col-md-12" style="border:1px solid #abc;">
        <div class="form-bx">
            <div class="row">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <b>@Html.Label("Department")</b>
                    @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                            .Filter("contains")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel(" --- select ---")
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => transport.Read(read => read.Action("GetDepartmentList", "Finance", new { area = "Revenue" })))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(6);
                            })
                                    .Events(events => { events.Change("ParameterChangeEvent"); })
                            .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                    )
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label>Start Date</label>
                    @(Html.Kendo().DatePickerFor(m => m.StartDate).Events(e => e.Change("ParameterChangeEvent")).HtmlAttributes(new { style = "width:90%; float:right;" }))
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label>End Date</label>
                    @(Html.Kendo().DatePickerFor(m => m.EndDate).Events(e => e.Change("ParameterChangeEvent")).HtmlAttributes(new { style = "width:90%; float:right;" }))
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    
                </div>
            </div>
        </div>
    </div>
   
    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.Model.NDCVeiwModel>()
            .Name("gridNDCReport")
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden();
                columns.Bound(c => c.RegistrationId).Title("Registration Id").Width(120);
                columns.Bound(c => c.Department).Title("Department").Width(120).Filterable(false);
                columns.Bound(c => c.Applicant).Title("Applicant");
                columns.Bound(c => c.Sector).Title("Sector").Width(100);
                columns.Bound(c => c.Block).Title("Block").Width(100);
                columns.Bound(c => c.PlotNo).Title("Plot No").Width(100);
                //columns.Bound(c => c.CreatedDate).Title("Request Date").Format("{0:dd-MM-yyyy}");
                columns.Bound(c => c.NDCDate).Title("Date").Width(100).Format("{0:dd-MMM-yyyy}");
                columns.Bound(c => c.Status).Title("Status").Width(100).Filterable(false);
                columns.Bound(c => c.TemplateContent).Hidden();
                columns.Bound(c => c.Id).Title("").Width(100).ClientTemplate(" <center><a onclick='javascript:ViewNDCLetter(#=Id#);'><span class='fa fa-print hyperlink'></span></a></center> ").Filterable(false);
                //columns.Bound(c => c.Id).Title("Edit").Width(100).ClientTemplate("#if(IsLetterIssued == null || IsLetterIssued == false){#<center><a href='" + "/Member/Authority/EditNDCLetter/#= Id #'><span class='fa fa-edit'></span></a></center>#}else{#<label>Issued</label>#}#  ");
                //columns.Bound(c => c.IsLetterIssued).Title("Action").Width(100).ClientTemplate("#if(IsActive == true){ if(IsLetterIssued == true){#<label>Issued</label>#}else{#<label class='hyperlink verify' onclick='javascript:UpdateRemarks(#=RegistrationId#,#=Id#)'>Generated</label>#}}else{#<label>Cancelled</label>#}#");
            })
                .Filterable().Resizable(resize => resize.Columns(true))
                .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                .DataSource(dataSource => dataSource
                .Ajax().Model(model => model.Id(p => p.Id))
                .ServerOperation(true).Sort(sort => sort.Add("Id").Descending())
                        .Read(read => read.Action("GetNDCReportDataAsDataSource", "Report", new { area = "Reports" }).Data("FilterParameterForNDC")).PageSize(10)
                    )
        )
    </div>

</div>

