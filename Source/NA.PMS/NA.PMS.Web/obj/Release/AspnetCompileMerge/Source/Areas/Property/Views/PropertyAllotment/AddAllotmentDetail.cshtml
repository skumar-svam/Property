
@{
    ViewBag.Title = "Add Allotment Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3>AddAllotmentDetail</h3>
<hr />
<div class="panel-body">
    <div id="Allotment-header-Id" style="width:100%;">
        @{Html.RenderPartial("_PartialAllotment");}
    </div>
    <div id="Applicant-Id" style="width:50%; float:left">
        <h4>Applicant Details</h4>
        <div class="panel-body">
            <div class="row form-group">
                <div class="col-sm-8 col-sm-offset-2">
                    <label>Form Number</label>
                    <input type="text" class="form-control" />
                </div>
            </div>
            <div class="row form-group">
                <div class="col-sm-8 col-sm-offset-2">
                    <label>Applicant's Name</label>
                    <input type="text" class="form-control" />
                </div>
            </div>
            <div class="row form-group">
                <div class="col-sm-8 col-sm-offset-2">
                    <label>Gender</label>
                    <input type="text" class="form-control" />
                </div>
            </div>
            <div class="row form-group">
                <div class="col-sm-8 col-sm-offset-2">
                    <label>Father's Name</label>
                    <input type="text" class="form-control" />
                </div>
            </div>
            <div class="row form-group">
                <div class="col-sm-8 col-sm-offset-2">
                    <label>Mobile Number</label>
                    <input type="text" class="form-control" />
                </div>
            </div>
            <div class="row form-group">
                <div class="col-sm-8 col-sm-offset-2">
                    <label>Address</label>
                </div>
            </div>
            <div class="row form-group">
                <div class="col-sm-8 col-sm-offset-2">
                    <label>Earnest Money</label>
                </div>
            </div>
        </div>
    </div>
    <div id="Property-Id" style="width:50%;float:right">
        <h4>Property Details</h4>
    </div>
</div>
