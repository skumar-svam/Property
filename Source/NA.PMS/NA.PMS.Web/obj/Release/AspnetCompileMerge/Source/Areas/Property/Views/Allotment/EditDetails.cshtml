<script type="text/javascript">
    var checkedIds = [];
    function CascadeData() {
        return {
            schemeid: $('#SchemeId').val(),
            depttID: $('#DepartmentId').val()
        }
    }

    function SelectAll(e) {
        var state = $(e).is(':checked');
        if (state == true) {
            var grid = $('#gridDocs').data("kendoGrid");
            $.each(grid.dataSource.view(), function () {
                $(".inpchk").prop('checked', 'checked');
                if (this['IsSelected'] != state)
                    this['IsSelected'] = state;
                checkedRIds.push(this.RId);
                //checkedPropertyIds.push(this.PropertyId);
            });
        } else {
            $(".inpchk").removeAttr('checked');
            var grid = $('#gridDocs').data("kendoGrid");
            $.each(grid.dataSource.view(), function () {
                this['IsSelected'] = false;
            });
        }
    }

    //select selected checkboxes
    $(function () {
        $('#gridDocs').on('change', '.inpchk', function () {
            var checked = $(this).is(':checked');
            $("#chkSelectAll").removeAttr('checked');
            if ($('.inpchk:checked').length == $('.inpchk').length) {
                $("#chkSelectAll").prop('checked', 'checked');
            }
            var grid = $('#gridDocs').data().kendoGrid;
            var dataItem = grid.dataItem($(this).closest('tr'));
            dataItem.set('IsSelected', checked);
            checkedIds.push(dataItem.RId);
            //checkedPropertyIds.push(this.PropertyId);
        });
    });

    function FilterDepartment() {
        return { SchemeId: $("#SchemeId").val() };
    }

    function filterForms() {
        return {
            SchemeId: $("#SchemeId").val(),
            DepartmentId: $("#DepartmentId").val()
        };
    }

    function AdditionalData() {
        return { //applicationId: $("#ApplicationId").val()
            applicationId: $("#ApplicationId").val()
        };
    }

    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }
    function CheckZeroInSTD() {
        if ($("#PhoneNumberP1").val() != '' && $("#PhoneNumberP1").val() == 0) {
            alertify.error("STD should not be 0.");
            $("#PhoneNumberP1").val('');
        }
        if ($("#FaxNumberP1").val() != '' && $("#FaxNumberP1").val() == 0) {
            alertify.error("STD should not be 0.");
            $("#FaxNumberP1").val('');
        }
        if ($("#PhoneNumber").val() != '' && $("#PhoneNumber").val() == 0) {
            alertify.error("Phone Number should not be 0.");
            $("#PhoneNumber").val('');
        }
        if ($("#FaxNumber").val() != '' && $("#FaxNumber").val() == 0) {
            alertify.error("Fax Number should not be 0.");
            $("#FaxNumber").val('');
        }
        if ($("#MobileNumber").val() != '' && $("#MobileNumber").val() == 0) {
            alertify.error("Mobile Number should not be 0.");
            $("#MobileNumber").val('');
        }
    }


    $(document).ready(function () {
        //$("#TextId").hide();
        CalculateAmount();
        if ($("#IsCompany").val() == "True") {
            $("#rbtnCompany").attr('checked', true);
            //$("#GenderName").val("Company");
        }
        var radiobtnVal = $('input[name=companyType]:checked', '#userform').val();
        if (radiobtnVal == "company") {
            $('#OnlineAppRequestForIndividual').hide();
            $('#OnlineAppRequestForcompany').show();
            $("#lblFirstName").text('Company Name');
            $("#lblPanNumber").text("Company PAN");
            $("#lblCompanyEmail").text("Company Email");
            $("#IsCompany").val(true);
            $("#GenderName").val("Company");
        }
        else if (radiobtnVal == "individual") {
            $('#OnlineAppRequestForIndividual').show();
            $('#OnlineAppRequestForcompany').hide();
            $("#lblPanNumber").text("PAN");
            $("#lblCompanyEmail").text("Email");
            $("#IsCompany").val(false);
        }

        $('#userform input:radio[name=companyType]').on('change', function () {
            var radiobtnVal = $('input[name=companyType]:checked', '#userform').val();
            if (radiobtnVal == "company") {
                $("#GenderName").val("Company");
                $('#OnlineAppRequestForIndividual').hide();
                $('#OnlineAppRequestForcompany').show();
                $("#lblFirstName").text('Company Name');
                $("#lblPanNumber").text("Company PAN");
                $("#lblCompanyEmail").text("Company Email");

                $("#IsCompany").val(true);
            }
            else if (radiobtnVal == "individual") {
                $('#OnlineAppRequestForIndividual').show();
                $('#OnlineAppRequestForcompany').hide();
                $("#lblPanNumber").text("PAN");
                $("#lblCompanyEmail").text("Email");
                $("#IsCompany").val(false);
            }
        });

        $("#btnCancel").click(function () {
            var appId = $("#ApplicationId").val();
            window.location = "/Property/Allotment/ViewOnlineDetails/" + appId;
        });

        $("#btnSubmitEdit").click(function () {
            if (Validate()) {
                var formData = new FormData();
                var applicationID = $("#ApplicationId").val();
                formData.append("applicationID", applicationID);
                var items = $("#gridDocs").data("kendoGrid").dataSource.data();
                var Ids = [];
                for (var i = 0; i < items.length; i++) {
                    //alert();
                    var item = items[i];
                    if (item.IsSelected == true) {
                        //alert(item.Id);
                        Ids.push(item.Id);
                    }
                }
                if (Ids.length < 1) {
                    alertify.error("Please select atleaset one document.");
                    return false;
                }
                formData.append("IDLst", Ids);
                $.ajax({
                    dataType: 'json',
                    type: 'Post',
                    data: formData,
                    url: '/Allotment/SaveFiles',
                    cache: false,
                    contentType: false,
                    processData: false,
                    success: function (result) {
                        //alert(result);
                        if (result == true) {                            
                            alertify.success("Data saved successfully.");
                            $("#userform").submit();                          
                            @*window.location.href = '@Url.Action("ManageMutation", "PropertyRegistration")';*@
                            //window.location = "/Property/Allotment/ViewOnlineDetails/" + applicationID;
                             window.location.href = '@Url.Action("ViewOnlineDetails", "Allotment", new { area = "Property"})'+"/"+applicationID;
                        }
                        else {
                            alertify.error("Some error occured. Please try again later.");
                        }
                    },
                    error: function (objAjaxRequest, strError) {
                        var respText = objAjaxRequest.responseText;
                        //alert(respText);
                        alertify.error("Some error occured. Please try again later.");
                    }
                });
                return true;
            }
            else { return false; }
        });
        DisabledFields();
    });

    function Validate() {
        var bflag = false;
        debugger;
        var radiobtnVal = $('input[name=companyType]:checked', '#userform').val();
        if (radiobtnVal == "individual") {
            if ($("#SchemeId").val() == "") {
                alertify.error("Please select Scheme");
                bflag = false;
            }
            else if ($("#DepartmentId").val() == "") {
                alertify.error("Please select Department");
                bflag = false;
            }
            else if ($("#FirstName").val() == "") {
                alertify.error("Please enter First Name");
                bflag = false;
            }
            else if ($("#LastName").val() == "") {
                alertify.error("Please enter Last Name");
                bflag = false;
            }
            else if ($("#GenderName").val() == "" && $("#rbtnIndividual").val() == "individual") {
                alertify.error("Please select Gender");
                bflag = false;
            }
            else if ($("#FatherName").val() == "") {
                alertify.error("Please enter Father Name");
                bflag = false;
            }
            else if ($("#MotherName").val() == "") {
                alertify.error("Please enter Mother Name");
                bflag = false;
            }
            else if ($("#MaritialStatusName").val() == "") {
                alertify.error("Please select Maritial Status");
                bflag = false;
            }
            else if ($("#CategoryId").val() == "") {
                alertify.error("Please select Category");
                bflag = false;
            }
            else if ($("#OccupationId").val() == "") {
                alertify.error("Please select Occupation.");
                bflag = false;
            }
            else if ($("#PermanentAddress").val() == "") {
                alertify.error("Please enter Permanent Address.");
                bflag = false;
            }
            else if ($("#CorrespondingAddress").val() == "") {
                alertify.error("Please enter Corresponding Address.");
                bflag = false;
            }
            else if ($("#Email").val() == "") {
                alertify.error("Please enter email address.");
                return false;
