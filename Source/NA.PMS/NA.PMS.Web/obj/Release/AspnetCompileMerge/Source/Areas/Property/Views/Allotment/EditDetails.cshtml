    function change() {
        var dob = new Date(kendo.toString(this.value(), 'd'));
        CheckAge(dob);
    }

    $('#AnnualIncome').change(function () {
        CheckAnnualIncome();
    });

    function CheckAnnualIncome() {
        var annualIncome = $("#AnnualIncome").val();
        if (annualIncome != '') {
            if (annualIncome < 50000) {
                alertify.error("Annual Income should be graeter than 50000");
                $("#AnnualIncome").val('')
                return false;
            }
            else {
                return true;
            }
        }
    }

    function ValidateEmail(email) {
        var expr = /^([\w-\.]+)@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$/;
        return expr.test(email);
    };

    function CheckAge(dob) {
        var today = new Date();
        var age = today.getTime() - dob.getTime();
        age = Math.floor(age / (1000 * 60 * 60 * 24 * 365.25));
        if (age < 18) {
            alertify.error("Age should be minimum 18 years.");
            $("#DOB").data('kendoDatePicker').value("")
            $("#Age").val('');
            return false;
        }
        else {
            $("#Age").val(age);
            return true;
        }
    }

