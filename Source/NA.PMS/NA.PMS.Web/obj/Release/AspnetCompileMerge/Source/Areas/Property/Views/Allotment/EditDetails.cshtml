    function OnAreaChange() {
        if ($("#Area").val() == "") {
            $('#ApplicationFee').val("");
            $('#ProcessingFee').val("");
            $('#earnestMoney').val("");
            $('#Amount').val("");
        }
        else {
            var id = $("#SchemeId").val();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ id: id }),
                //url: "/Allotment/GetAreaDetails",
                url: '@Url.Action("GetAreaDetails", "Allotment", new { area = "Property" })',
                success: function (data) {
                    if (data != null) {
                        $('#ApplicationFee').val(data.ApplicationFee);
                        $('#ProcessingFee').val(data.ProcessingFee);
                        CalculateAmount();
                        GetEarneshMoney();
                    }
                    else {
                        $('#ApplicationFee').val("");
                        $('#ProcessingFee').val("");
                        CalculateAmount();
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //alert("error");
                }
            });
        }
