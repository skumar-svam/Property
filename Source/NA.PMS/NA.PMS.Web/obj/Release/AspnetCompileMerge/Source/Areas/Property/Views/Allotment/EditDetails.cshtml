    function GetEarneshMoney() {
        var id = $("#SchemeId").val();
        var deptt = $("#DepartmentId").val();
        var floor = $("#Area").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ id: id, deptt: deptt, floor: floor }),
            url: "/Allotment/GetEarneshMoney",
            success: function (data) {
                if (data != null) {
                    $('#earnestMoney').val(data.earnestMoney);
                    CalculateAmount();
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert("error");
            }
        });
    }

