@model NA.PMS.Model.AllottedPropertyViewModel
@using Kendo.Mvc.UI;

<div class="col-md-12 nav-sub-group">
    <ul class="nav nav-tabs content-tabs" id="ulProperty" role="tablist" style="float:right;">
        <li class="active"><a href="#noting-manage" role="tab" data-toggle="tab">Notings</a></li>
        <li><a href="#noting-new" role="tab" data-toggle="tab">Create Noting</a></li>
    </ul>
</div>
<div class="col-md-12 tab-content" style="border:solid #e2e3e4; border-width:0 1px 1px 1px">
    <div class="tab-pane fade in active" id="noting-manage">
        <div class="col-md-12 k-grid-content">
            <h2 class="blck-heading-grid">Noting Details</h2>
            @(Html.Kendo().Grid<NA.PMS.Model.NotingViewModel>()
                .Name("GPAHistoryGrid")
                .Columns(columns =>
                {
                    columns.Bound(c => c.Id).Hidden(true);
                    columns.Bound(c => c.NotingFileNo).Title("File");
                    columns.Bound(c => c.NotingFileId).Title("Address");
                    columns.Bound(c => c.NotingDate).Title("Noting Date").Width(110).Format("{0:dd-MMM-yyyy}");
                    columns.Bound(c => c.CreatedDate).Title("Created date").Width(110).Format("{0:dd-MMM-yyyy}");
                    columns.Bound(c => c.CreatedBy).Title("Created By").Width(120);
                    columns.Bound(c => c.IsActive).Title("Status").Width(100).ClientTemplate("#if(IsActive){#<label>Active</label>#}else{#<label>InActive</label>#}#");
                })
                .Resizable(resize => resize.Columns(true))
                    //.Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                .AutoBind(true)
                .DataSource
                (
                        dataSource => dataSource
                    .Ajax().Model(model => model.Id(p => p.RegistrationId))
                    .ServerOperation(true)
                            .Read(read => read.Action("GetNotingFilesByIdAsDataSource", "PropertyAllotment", new { area = "Property" }).Data("FilterRegistrationIdNotes"))
                    //.PageSize(10)
                )
            )
        </div>
    </div>
</div>

<script>
    function FilterRegistrationIdNotes() {
        return { RegistrationId: 10000045 };
    }
</script>