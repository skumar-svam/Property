@model NA.PMS.Model.Property.MergeSplitPropModel

@using Kendo.Mvc.UI;
@using NA.PMS.Model
@using NA.PMS.Model.Property

@{
    ViewBag.Title = "Merge Properties";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .bulkDialog {
        display: none;
    }

    .disable_a_href {
        pointer-events: none;
    }
</style>

<div class="ApplicationForm">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Amalgamation</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                <a href="#" id="btnGeneratePaymentChallan" class="" onclick="javascript: GeneratePaymentChallan(event);">Generate Payment Challan</a>
                <a href="#" id="btnAddMergeRequest" class="" onclick="javascript: AddMergeRequest(event);">Add Merge Request</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="k-grid-content">
        @(Html.Kendo().Grid<MergeSplitPropModel>()
                .Name("gridMProperties")
                .Columns(columns =>
                {
                    columns.Bound(c => c.IsSelected).Width(30).ClientTemplate("<input type='checkbox' #= IsSelected ? checked='checked':'' # class='inpchk' ></input>").HeaderTemplate(" <input type='checkbox' id='chkSelectAll' onchange='SelectAll(this)'/>").Filterable(false).Sortable(false).Title("");
                  
                    columns.Bound(c => c.Id).Title("Request No").ClientTemplate("<a href='/Property/MergeSplitProperties/ViewMergeRequest/#=Id#'>#=Id#</a>").Width(130);
                    //columns.Bound(c => c.Rid).Title("RID").Width(100);
                    columns.Bound(c => c.DepartmentName).Title("Department");
                    columns.Bound(c => c.PropertyNumber).Title("Property No");
                    columns.Bound(c => c.AssignedTo).Title("Assigned To");
                    columns.Bound(c => c.RequestDate).Title("Request Date").Format("{0:dd/MM/yyyy}");
                    columns.Bound(c => c.ApprovedDate).Title("Approved Date").Format("{0:dd/MM/yyyy}");
                    columns.Bound(c => c.Status).Title("Status").Width(130);
                    columns.Bound(c => c.Id).ClientTemplate("#if(Status != 'Approved') {#<a class='gridEdit' href='" + "/Property/MergeSplitProperties/EditMergeRequest/#= Id #'>Edit</a>#}#").Width(100).Title("Action").Filterable(false);
                })
                .Sortable()
                .Filterable()
                .Pageable
                    (
                         pageable => pageable
                        .Enabled(true)
                        .Refresh(true)
                        .PageSizes(true)
                    )
                .DataSource
                (
                     dataSource => dataSource
                    .Ajax().Model(model => model.Id(p => p.Rid))
                    .ServerOperation(true)
                    .Read(read => read.Action("GetAllMergeProperties", "MergeSplitProperties")).PageSize(20)
                 )
        )
    </div>
</div>


<script type="text/javascript">
    $(document).ready(function () {

    });

    function AddMergeRequest(event) {
        event.preventDefault();
        window.location.href = '@Url.Action("AddMergeRequest", "MergeSplitProperties")';
    }

    function GeneratePaymentChallan(event) {
        event.preventDefault();
        //window.location.href = '@Url.Action("AddMergeRequest", "MergeSplitProperties")';
    }

    var checkedPropertyIds = [];
    var checkedRIds = [];
    //var checkedRNs = [];
    var checkedRIDs = [];

    function SelectAll(e) {
        var state = $(e).is(':checked');
        if (state == true) {
            var grid = $('#gridMProperties').data("kendoGrid");
            $.each(grid.dataSource.view(), function () {
                $(".inpchk").prop('checked', 'checked');
                if (this['IsSelected'] != state)
                    this['IsSelected'] = state;
                checkedRIds.push(this.Rid);
                checkedPropertyIds.push(this.PropertyId);
            });
        } else {
            $(".inpchk").removeAttr('checked');
            var grid = $('#gridMProperties').data("kendoGrid");
            $.each(grid.dataSource.view(), function () {
                this['IsSelected'] = false;
                checkedRIds.pop(this.Rid);
                checkedPropertyIds.pop(this.PropertyId);
            });
        }
    }
    var currentDate = new Date().toJSON().slice(0, 10);
    //select selected checkboxes
    $(function () {
        $('#gridMProperties').on('change', '.inpchk', function () {

            var checked = $(this).is(':checked');
            $("#chkSelectAll").removeAttr('checked');
            if ($('.inpchk:checked').length == $('.inpchk').length) {
                $("#chkSelectAll").prop('checked', 'checked');
            }
            var grid = $('#gridMProperties').data().kendoGrid;
            var dataItem = grid.dataItem($(this).closest('tr'));
            dataItem.set('IsSelected', checked);
            checkedRIds.push(dataItem.RID);
            checkedPropertyIds.push(this.PropertyId);
        });

    });
    $("#btnGeneratePaymentChallan").click(function () {
        var items = $("#gridMProperties").data("kendoGrid").dataSource.data();
        var rIds = [];
        var checkedRNs = [];
        var propertyIds = [];

        for (var i = 0; i < items.length; i++) {
            var item = items[i];
            if (item.IsSelected == true) {
                rIds.push(item.RID);
                checkedRNs.push(item.RequestNo);
            }
        }
        if (rIds.length > 0) {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ rid: rid, departmentId: departmentId }),
                url: '/MergeSplitProperties/PrintChallan',
                success: function (result) {

                    $("#divPossessionEntryBody").html(result);
                    $("#divPrintPossession").modal('show');
                    //alertify.success("Records added successfully.");
                },
                error: function (obj) {
                    alertify.error("Some error occured. Please try again later.");
                }
            });
        } else {
            alertify.error("Please select atleast one record to print Challan.");
        }
    });
    function PrintDiv() {
        var contents = document.getElementById("divLetterChallanBody").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }
</script>