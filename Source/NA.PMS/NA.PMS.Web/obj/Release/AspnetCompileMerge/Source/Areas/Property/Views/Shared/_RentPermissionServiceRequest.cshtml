    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<RentPermissionModel>()
                .Name("gvRentPermisssionServiceRequest")
                .Columns(columns =>
                {
                    columns.Bound(c => c.TenantName).Title("Tenant Name");
                    columns.Bound(c => c.RentingDate).Title("Renting Date");
                    columns.Bound(c => c.TenantProject).Title("Tenant Project");
                    columns.Bound(c => c.RentDuration).Title("Rent Duration");
                })
                .Sortable()
                .Filterable()
                .Pageable
                    (
                        pageable => pageable
                        .Enabled(true)
                        .PageSizes(true)
                     )
                .DataSource
                (
                     dataSource => dataSource
                    .Ajax().Model(model => model.Id(p => p.Rid))
                    .ServerOperation(true)
                    .Read(read => read.Action("GetRentServiceReqByRid", "CitizenRequests", new { area = "Member" }).Data("GetRid")).PageSize(20)
                 ).AutoBind(false)
        )
