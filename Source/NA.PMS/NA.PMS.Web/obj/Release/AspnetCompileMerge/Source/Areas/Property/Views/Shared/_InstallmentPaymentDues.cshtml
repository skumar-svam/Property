<div class="col-md-12 k-grid-content" id="div-GridDuesCalculationHistory">
    @(Html.Kendo().Grid<NA.PMS.Model.Sp_DuesCalculationHistory_Result>()
    .Name("GridDuesCalculationHistory")
        .AutoBind(false)
        //.ToolBar("")
        .Columns(columns =>
        {
            columns.Bound(c => c.InstallmentAmount).Title("Installment");//.ClientTemplate("<a href='" + "/Property/PropertyAllotment/PropertyDetails/#= RegistrationId #'>#= RegistrationId #</a>").Filterable(true);
            columns.Bound(c => c.DepositAmount).Title("Deposit");
            columns.Bound(c => c.InstallmentDueDate).Title("Due Date").Format("{0:dd-MMM-yyyy}");
            columns.Bound(c => c.DuesTill).Title("Dues");
            columns.Bound(c => c.DuesNextWithInterest).Title("Total Dues (<span class='fa fa-rupee'></span>)");
            columns.Bound(c => c.PenalAmount).Title("Penal Amount");
            columns.Bound(c => c.NewDateDiff).Title("Diff Date");//.ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
            columns.Bound(c => c.TotalPanelAmount).Title("Total Penal");
            columns.Bound(c => c.TotalPrincipalAmount).Title("Total Principal").Width(140);//.ClientTemplate(" <center><a onclick='javascript:PrintDemandNote(#=RegistrationId#,#=DuesAmount#);'><span class='fa fa-print'></span></a></center> ");
            columns.Bound(c => c.DepositDate).Title("Deposit Date").Format("{0:dd-MMM-yyyy}").ClientFooterTemplate("<button onclick='javascript:PrintDuesCalculation();'>Print</button> ");
        })
        .Events(m => m.DataBound("kendoDuesCalculationGridDataBoundEvent"))
        .Resizable(resize => resize.Columns(true))
        //.Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
        .DataSource(dataSource => dataSource
                .Ajax()
                .ServerOperation(true)
                .Read(read => read.Action("GetDuesCalcaluationHistoryAsDataSource", "PropertyAllotment", new { area = "Property" }).Data("FilterDuesParam"))
            )
    )
</div>

<div class="col-md-12 form-box" id="div-payment-status" style="padding-top:6px;border:1px solid #e2e3e4">
    <div class="row">
        <div class=" col-md-3 col-sm-12 col-xs-12 form-group">
            @Html.Label("Installment Dues")
        </div>
        <div class=" col-md-3 col-sm-12 col-xs-12 form-group">
            <label class="form-control" id="lbl-dues-amuont">
                @Html.DisplayFor(m => m.TotalDuesAmount)
            </label>
        </div>

        <div class=" col-md-3 col-sm-12 col-xs-12 form-group">
            @Html.Label("Installment Dues Upto")
        </div>
        <div class=" col-md-3 col-sm-12 col-xs-12 form-group">
            @(Html.Kendo().DatePickerFor(model => model.DuesUptoDate).HtmlAttributes(new { @readonly = "readonly", style = "width:100%;" }))
            @*<label class="form-control" id="lbl-dues-upto-date">
                @Html.DisplayFor(m => m.DuesUptoDate)
            </label>*@
        </div>
    </div>
    <div class="row">
        <div class=" col-md-3 col-sm-12 col-xs-12 form-group">
            @Html.Label("Principal Amount")
        </div>
        <div class=" col-md-3 col-sm-12 col-xs-12 form-group">
            <label class="form-control" id="lbl-principal-amount">
                @Html.DisplayFor(m => m.PrincipalAmount)
            </label>
        </div>
        <div class=" col-md-3 col-sm-12 col-xs-12 form-group">
            @Html.Label("Penal Amount")
        </div>
        <div class=" col-md-3 col-sm-12 col-xs-12 form-group">
            <label class="form-control" id="lbl-penal-interest">
                @Html.DisplayFor(m => m.PenalInterest)
            </label>
        </div>
    </div>
    <div class="row">
        <div class=" col-md-3 col-sm-12 col-xs-12 form-group">
            @Html.Label("Lease Rent Amount")
        </div>
        <div class=" col-md-3 col-sm-12 col-xs-12 form-group">
            <label class="form-control" id="lbl-leaserent-amount">
                @Html.DisplayFor(m => m.CurrentDues)
            </label>
        </div>
        <div class=" col-md-3 col-sm-12 col-xs-12 form-group">
            @Html.Label("Lease Rent Upto Date")
        </div>
        <div class=" col-md-3 col-sm-12 col-xs-12 form-group">
            @(Html.Kendo().DatePickerFor(model => model.CurrentDuesDate).HtmlAttributes(new {@readonly="readonly" ,style="width:100%;"}))
            @*<label class="form-control" id="lbl-leasernet-upto">
                @Html.DisplayFor(m => m.CurrentDuesDate)
            </label>*@
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 col-sm-12 col-xs-12 form-group" style="text-align:right;">
            <button id="btn-generate-demand" class="k-button">Generate Demand</button>
        </div>
        <div class="col-md-2 col-sm-12 col-xs-12 form-group" style="">

        </div>
        <div class="col-md-4 col-sm-12 col-xs-12" style="text-align:right">
            <input id="hdnCalDueDateTime" value="@DateTime.Now" title="datepicker" />
            <input type="button" class="btn btn-success" id="btnCalDuebyDate" value="Calculate Dues" />
        </div>
        @*<div class="col-md-6 col-sm-12 col-xs-12">
                <label id="lbl-dues-calculation-status" style="font-size:large; font-weight:500;padding-top:6px;"></label>
            </div>*@
    </div>
</div>


<script>

    $(document).ready(function () {
        $("#hdnCalDueDateTime").kendoDatePicker();
    })

    function FilterDuesParam() {
        return {
            RegistrationId: $('#Rid').val(),
            ActionDate: $('#hdnCalDueDateTime').val(),
            PropertyTypeId: 1
        };
    }

    $("#btnCalDuebyDate").click(function () {
        //var rid = $('#Rid').val();
        //var date = $("#hdnCalDueDateTime").val();
        //var flag1 = confirm("Are You sure to update Installment dues");
        //if(flag1){
        //    $("#GridDuesCalculationHistory").data('kendoGrid').dataSource.read();
        //}
        //var flag2 = confirm("Are You sure to update Lease Rent dues");
        //if (flag2) {
        //    //var rentdata = $("#GridLeaseRentDues").data("kendoGrid").dataSource;
        //    CalculateFromInstallmentDuesCal(date,rid);
        //}

        //$("#GridLeaseRentDues").data("kendoGrid").dataSource.read();


        UpdateDuesPayment();
    });


    function UpdateDuesPayment() {
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ RegistrationId: $('#Rid').val(), ActionDate: $('#hdnCalDueDateTime').val() }),
            //url: '/Revenue/Payment/InstallmentDuesPayment',
            url: '/Revenue/Payment/CalculateInstallmentDuesById',
            success: function (result) {
                if (result.IsInstallmentPaid == true) {
                    $('#lbl-dues-amuont').html(result.PremiumPaidStatus);
                }
                else {
                    $('#lbl-dues-amuont').html(result.TotalDuesAmount);
                    $('#lbl-penal-interest').html(result.PenalInterest);
                    $('#lbl-principal-amuont').html(result.PrincipalAmount);
                    $('#DuesUptoDate').data("kendoDatePicker").value(result.DuesUptoDate);
                }
                
                if (result.IsOneTimeLeaseRentPaid == true) {
                    $('#lbl-leaserent-amount').html(result.LeaseRentStatus);
                }
                else {
                    $('#lbl-leaserent-amount').html(result.CurrentDues);
                    //$('#lbl-leasernet-upto').html(result.CurrentDuesDate);
                    $('#CurrentDuesDate').data("kendoDatePicker").value(result.CurrentDuesDate);
                }
                $("#GridDuesCalculationHistory").data('kendoGrid').dataSource.read();
                $("#GridLeaseRentDues").data("kendoGrid").dataSource.read();
                //$('#lbl-dues-upto-date').html(result.DuesUptoDate != null && result.DuesUptoDate != "" ? new Date(parseInt(result.DuesUptoDate.substr(6))) : new Date());
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Some Error in save database.");
            }
        });
    }

    function kendoDuesCalculationGridDataBoundEvent() {
        var dataCount = $("#GridDuesCalculationHistory").data('kendoGrid').dataSource.total();
        if (dataCount == 0) {
            //$('#lbl-dues-calculation-status').html("Installment Full Paid");
            $('#div-GridDuesCalculationHistory').css("display", "none");
        }
        else {
            //$('#lbl-dues-calculation-status').html("");
            $('#div-GridDuesCalculationHistory').show();
        }
    }


    function kendoGridDueAfterDataBound() {
        
        var rid = $('#Rid').val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ RegistrationId: rid, ActionDate: $('#hdnCalDueDateTime').val() }),
            //url: '/Revenue/Payment/InstallmentDuesPayment',
            url: '/Revenue/Payment/CalculateInstallmentDuesById',
            success: function (result) {
                $('#lbl-dues-amuont').html(result.PremiumPaidStatus);
                //$('#lbl-dues-amuont').html(result.TotalDuesAmount);
                $('#lbl-penal-interest').html(result.PenalInterest);
                $('#lbl-principal-amuont').html(result.PrincipalAmount);
                $('#lbl-leaserent-amount').html(result.CurrentDues);
                $('#lbl-leasernet-upto').html(result.CurrentDuesDate);
                $('#lbl-dues-upto-date').html(result.DuesUptoDate != null && result.DuesUptoDate != "" ? new Date(parseInt(result.DuesUptoDate.substr(6))) : new Date());
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Some Error in save database.");
            }
        });
    }

    function PrintDuesCalculation() {
        var contents = document.getElementById("div-GridDuesCalculationHistory").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('<style>#Report{width:100%;} table{width:1000px;}  tr{ width:100%;}  td{width:120px;}</style>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }
</script>