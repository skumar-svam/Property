<script>
    var role = new function () {
        this.DeActivateRole = function () {
            var roleId = $("#Deactivatebtn").attr("roleId");
            var status = $("#Deactivatebtn").attr("status");
            var viewN = $("#ViewName").val();
            $.ajax({
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                type: "POST",
                @*url: '@Url.Action("DeActivateRole", "ManageAdminRoles")',*@
                //data: { "roleId": roleId, "status": status, "viewName": viewName },
                data: JSON.stringify({ roleId: roleId, status: status, viewN: viewN }),
                url: '/ManageRoles/DeActivateRole',
                success: function (data) {
                    $('#gridRoles').data('kendoGrid').dataSource.read();
                    $('#gridRoles').data('kendoGrid').refresh();
                    $("#Deactivatebtn").attr("roleId", "");
                    $("#Deactivatebtn").attr("status", "");
                },
                error: function (msg) {
                    alert("Error Occured-" + msg.responseText);
                }                
            });
        };
        this.StatusActivate = function (e, id, status) {
            $('#myModal').modal('show');
            $("#Deactivatebtn").attr("roleId", id);
            $("#Deactivatebtn").attr("status", status);
            if (e.id === "deactivate") {
                $("#Title").text("Do you want to activate this Role?");
            } else {
                $("#Title").text("Do you want to deactivate this Role?");
            }
        };
    }

    $(document).ready(function () {
        $("#ViewName").val("ManageAdminRoles");
        @{if (TempData["MesgAdd"] != null && TempData["MesgAdd"] != "")
          {
                @:alertify.success('Changes saved successfully.');
                 }}
        @{if (TempData["MesgEdit"] != null && TempData["MesgEdit"] != "")
           {
                 @:alertify.success('Changes saved successfully.');
                   }}
    });
</script>