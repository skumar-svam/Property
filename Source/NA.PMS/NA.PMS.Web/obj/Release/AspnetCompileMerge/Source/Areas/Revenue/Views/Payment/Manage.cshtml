@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@using NA.PMS.Common;
@model NA.PMS.Model.LeaseRentViewModel

@{
    ViewBag.Title = "Manage Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .ptr-cur {
        cursor: pointer;
    }

    #ndc-grid {
        display: none;
    }

    #installment-dues-grid {
        /*display:none;*/
    }

    #leaserent-dues-grid {
        /*display: none;*/
    }

    #leaserent-report {
        display: none;
    }

    .fa.fa-refresh {
        cursor: pointer;
    }
    .fa.fa-print{
        cursor:pointer;
    }

    .print-row:nth-child(2n+1) {
        background: #fefefe;
    }

    #Report .row:nth-child(2n+1) {
        background: #fefefe;
    }
</style>

<div class="ManageLeaseRentList">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Lease Rent</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                <a href="/Revenue/Finance/ManagePropertyCost" id="btn-add-rent" target="_blank"><i class="fa fa-plus"></i> <span> Manage Property Cost</span></a>
                <a href="/Revenue/Finance/LeaseRentPayment" id="btn-add-rent" target="_blank"><i class="fa fa-plus"></i> <span> Add Lease Rent</span></a>
                <a href="/Revenue/Payment/Update" id="btnUpdate" target="_blank"><i class="fa fa-plus"></i> <span> Update Lease Rent</span></a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>

    <div class="col-md-12 content-top-spce">
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading" style="margin-bottom:15px;">Search</h2>
            <div class="form-bx">
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <label>Department</label>
                        @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                            .Filter("contains")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel(" --- select ---")
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => transport.Read(read => read.Action("GetDepartmentList", "Finance", new { area = "Revenue" })))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(6);
                            })
                            .Events(events => { events.Change("ChangeDeptEvent"); })
                            .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                        )
                    </div>

                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <label>Session Year</label>
                        @(Html.Kendo().DropDownList()
                            .Name("DDLDuration")
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .OptionLabel(" --- Select ---")
                            .BindTo(new List<SelectListItem>() {
                                new SelectListItem() { Text = "2015-2016", Value = "2015-2016" },
                                new SelectListItem() { Text = "2016-2017", Value = "2016-2017" },
                                new SelectListItem() { Text = "2017-2018", Value = "2017-2018" }
                            })
                            .HtmlAttributes(new { style = "width: 90%; float:right;" })
                            .Events(e => e.Change("GetPaymentDuesReport"))
                        )
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <label>Action Type</label>
                        @(Html.Kendo().DropDownList()
                            .Name("DDLActionType")
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .OptionLabel(" --- Select ---")
                            .BindTo(new List<SelectListItem>() {
                                new SelectListItem() { Text = "Update Installment", Value = "Installment" },
                                new SelectListItem() { Text = "Update Lease Rent", Value = "LeaseRent" }
                            })
                            .HtmlAttributes(new { style = "width: 90%; float:right;" })
                            //.Events(e => e.Change("ChangeActionType"))
                        )
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group" style="text-align:right;">
                        <label>Dues Upto Date</label>
                        @(Html.Kendo().DatePicker().Name("DPCurrentDuesDate").HtmlAttributes(new { @class="input-disabled", style="width:90%;"}))
                        @*<input type="button" class="k-button" id="update-payment-dues" value="Update Payment Dues" style="margin-top:25px;"/>*@
                    </div>
                    @*<div class="col-md-2 col-sm-2 col-xs-12 form-group">
                         <input type="button" class="k-button" id="update-installment-dues" value="Update Installment Dues" />
                    </div>
                    <div class="col-md-2 col-sm-2 col-xs-12 form-group">
                        <input type="button" class="k-button" id="update-dues" value="Update Lease Rent Dues" />
                    </div>*@
                </div>

                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <b><span class="ptr-cur" id="lrcount" style="padding-left:30px;">LeaseRent Dues: @Model.TotalLeaseRentCount</span></b>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @*<b><span class="ptr-cur" id="ipcount" style="padding-left:30px;">Lease Rent and Installment Dues : @Model.TotalIPCount</span></b>*@
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <b><span class="ptr-cur" id="ndccount">Total NDC: @Model.TotalNDCCount</span></b>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <b><span class="ptr-cur" id="defaultercount">Lease Rent Report</span></b>
                    </div>
                </div>

                <div class="row">
                    <input type="hidden" id="hdn-departmentId" />
                    <input type="hidden" id="hdn-rid" />
                </div>
            </div>

            <h2 id="grid-head" class="blck-heading" style="margin-bottom: 0px;">Lease Rent Details</h2>
            <div class="col-md-12 k-grid-content" id="leaserent-dues-grid">
                    @(Html.Kendo().Grid<NA.PMS.Model.LeaseRentViewModel>()
                        .Name("GridLeaseRentDues")
                        .Excel(excel => excel.AllPages(true).Filterable(true).FileName("LeaseRentReport.xlsx"))
                        .ToolBar(toolsExcel => toolsExcel.Excel())
                        .Columns(columns =>
                        {
                            columns.Bound(c => c.Id).Title("Id").Width(50).Hidden(true);
                            columns.Bound(c => c.RegistrationId).Hidden(true);
                            columns.Bound(c => c.LeaseRentDues).Hidden(true);
                            columns.Bound(c => c.RegistrationId).Title("Registration Id").ClientTemplate("<a href='" + "/Property/PropertyAllotment/PropertyDetails/#= RegistrationId #'>#= RegistrationId #</a>").Filterable(true);
                            //columns.Bound(c => c.RegistrationId).Title("Registration Id").ClientTemplate("<a href='" + "/Revenue/Finance/PaymentDetail/#= RegistrationId #'>#= RegistrationId #</a>").Filterable(true);
                            columns.Bound(c => c.PropertyNo).Title("Property");
                            columns.Bound(c => c.LeaseRentPremium).Title("Lease Rent (<span class='fa fa-rupee'></span>)");//.ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
                            columns.Bound(c => c.PaidUptoDate).Title("Paid Upto").Format("{0:dd-MMM-yyyy}");
                            columns.Bound(c => c.CurrentDues).Title("Dues (<span class='fa fa-rupee'></span>)").ClientTemplate("<label class='hyperlink' onclick='ShowLeaseRentDetail(#=Id#, #=RegistrationId#, #=DepartmentId#)'>#= CurrentDues #</label>");//.ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
                            columns.Bound(c => c.CurrentDuesDate).Title("Dues Upto").Format("{0:dd-MMM-yyyy}");
                            columns.Bound(c => c.RegistrationId).Title("Demand").Width(110).ClientTemplate(" <center><a onclick='javascript:PrintLeaseRentDemandNote(#=RegistrationId#,#=CurrentDues#);'><span class='fa fa-print'></span></a></center> ");
                            //columns.Bound(c => c.LeaseRentDues).Title("Lease Rent Dues").ClientTemplate("<label class='hyperlinkcss' onclick='ShowLeaseRentDetail(#=Id#)'>view</label>");
                            columns.Bound(c => c.IsDuesUptoDate).Title(" ").Width(50).ClientTemplate("<center><a onclick='javascript:CalculateDuesUptoDate(#=RegistrationId#);'><span class='fa fa-refresh hyperlink'></span></a></center> ");
                        })
                        .Sortable().Filterable().Resizable(resize => resize.Columns(true))
                        .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                        .DataSource(dataSource => dataSource
                                .Ajax().ServerOperation(true)
                                .Model(model => model.Id(p => p.Id))                                
                                .Read(read => read.Action("GetMultiplePaymentStatusList", "Payment", new { area = "Revenue" }).Data("LeaseRent")).PageSize(10)
                                //.Aggregates(aggregates => aggregates.Add(p => p.LeaseRentPremium).Sum())
                                //.Aggregates(aggregates => aggregates.Add(p => p.CurrentDues).Sum())
                            )
                    )
            </div>
            <div id="ndc-grid">
                @{Html.RenderPartial("_NDCList");}
            </div>
            @*<div id="installment-dues-grid">
                @{Html.RenderPartial("_InstallmentDuesList");}
            </div>*@
            <div id="leaserent-report">
                @{Html.RenderPartial("_RevenueLeaseRent");}
            </div>
        </div>
    </div>
</div>

<div id="divPrintSchemeForm" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 60%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title"><b>Demand Note</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:400px;">
                <div id="divSchemeForm"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintSchemeFormDiv();">Print</button>
            </div>
        </div>
    </div>
</div>

<div id="PopupWindow" class="container-fluid">
    <div class="row">
        <style>
            .print-row {
                padding: 6px 20px 6px 20px;
            }

            #Report .row.print-row:nth-child(2n+0) {
                background: #f5faed;
            }
        </style>
        <div id="LeaseRentHtml"></div>

        <div id="div-rent-calculation" class="k-grid-content">
            @(Html.Kendo().Grid<NA.PMS.Model.LeaseRentViewModel>()
                    .Name("GridLeaseRentDues2")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.LeaseRentPremium).Title("Lease Rent (<span class='fa fa-rupee'></span>)");//.ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
                        columns.Bound(c => c.PanelInterest).Title("Penal Interest");
                        columns.Bound(c => c.DepositAmount).Title("Deposit Amount");
                        //columns.Bound(c => c.DuesAmount).Title("Dues (<span class='fa fa-rupee'></span>)");//.ClientTemplate("<label class='hyperlink' onclick='ShowLeaseRentDetail(#=Id#, #=RegistrationId#, #=DepartmentId#)'>#= CurrentDues #</label>").ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
                        columns.Bound(c => c.TotalAmount).Title("Dues (<span class='fa fa-rupee'></span>)");
                        columns.Bound(c => c.CurrentDuesDate).Title("Dues Date").Format("{0:dd-MMM-yyyy}");
                        columns.Bound(c => c.DepositDate).Title("Deposit Date").Format("{0:dd-MMM-yyyy}");
                    })
                    .Sortable().Filterable().Resizable(resize => resize.Columns(true))
                            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(new[] { 10, 50, 100, 500 }).Info(true).PreviousNext(true).Input(true).Numeric(true).ButtonCount(10))
                    .DataSource(dataSource => dataSource
                            .Ajax().ServerOperation(true)
                            .Model(model => model.Id(p => p.Id))
                            .Read(read => read.Action("GetLeaseRentDetailsByIdAndProcedure", "Payment", new { area = "Revenue" }).Data("ParamLeaseRent")).PageSize(100)
                            //.Aggregates(aggregates => aggregates.Add(p => p.LeaseRentPremium).Sum())
                            //.Aggregates(aggregates => aggregates.Add(p => p.CurrentDues).Sum())
                        )
            )
        </div>

    </div>
    <div class="row">
        <div class="col-sm-12" style="text-align:center;padding-top:10px;">
            <button id="btnPopupSubmit" class="k-button" style="min-width:100px;" onclick="PrintDiv()">Print</button>
            <button id="btnPopupCancel" class="k-button" style="min-width:100px;">close</button>
        </div>
    </div>
</div>


<div class="col-md-12" id="demand-note-type" style="min-height:150px;">
    <div class="row" style="padding-top:25px;">
        <div class="col-md-4 form-group">
            <label>Demand Type</label>
        </div>
        <div class="col-md-7 form-group">
            @(Html.Kendo().DropDownList()
                .Name("DDLDemandType")
                .DataTextField("Text")
                .DataValueField("Value")
                .OptionLabel(" --- Select ---")
                .BindTo(new List<SelectListItem>() {
                    new SelectListItem() { Text = "One Time Lease Rent", Value = "OneTimeLeaseRent" },
                    new SelectListItem() { Text = "Normal Lease Rent", Value = "LeaseRent" },
                    new SelectListItem() { Text = "Lease Rent with Compensation", Value = "Leaserent-Compensation" }
                })
                .HtmlAttributes(new { style = "width: 100%;" })
            )
        </div>       
    </div>
    <div class="row">
        <div class="col-md-4 form-group">
            <label>Dues Upto Date</label>
        </div>
        <div class="col-md-7 form-group">
            @(Html.Kendo().DatePicker().Name("PPCurrentDuesDate").HtmlAttributes(new { style="width:100%"}))
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 form-group">
            
        </div>
        <div class="col-md-7 form-group" style="padding-top:20px;text-align:center">
            <input type="button" class="k-button" id="btn-demand-note" value="Generate Demand Note" style="background:#299a8b;color:#fff; width:100%;" />
        </div>
    </div>
</div>


<script type="text/javascript">
    var displayType = "LeaseRentDues";//"InstallmentDues";
    var flag1; var flag2; var flag3; var actionType = "LeaseRentDues";//"InstallmentDues";
    $('#grid-head').text("Lease Rent Dues Details");
    //$('#grid-head').hide();

    $('#PopupWindow').kendoWindow({
        modal: true,
        title: "Lease Rent Report",
        visible: false,
        width: "70%"
    });

    $('#demand-note-type').kendoWindow({
        modal: true,
        title: "Select Demand Note Type",
        visible: false,
        width: "35%"
    });

    $('#btn-demand-note').click(function () {
        if ($('#DDLDemandType').val() == "") {
            alertify.error("Please select Demand Type");
            return false;
        }
        if ($('#PPCurrentDuesDate').val().trim() == "") {
            alertify.error("Please select Dues Upto Date");
            return false;
        }
        else {
            PrintLeaseRentDemandNote2();
        }       
    });

    $('#btnPopupCancel').click(function () {
        $("#PopupWindow").data("kendoWindow").close();
    });

    function GetPaymentDuesReport() {
        $("#GridLeaseRentReport").data("kendoGrid").dataSource.read();
    }

    function ShowLeaseRentDetail(row,rid,deptid) {
        $('#hdn-departmentId').val(deptid);
        $('#hdn-rid').val(rid);
        if ($('#DPCurrentDuesDate').val().trim() != "") {
            $("#GridLeaseRentDues2").data("kendoGrid").dataSource.read();
            $("#PopupWindow").data("kendoWindow").center();
            $("#PopupWindow").data("kendoWindow").open();
        }
        else {
            alertify.error("Enter Current Dues Date");
        }
        //$.ajax({
        //    type: "post",
        //    dataType: "json",
        //    contentType: "application/json;charset=utf-8",
        //    data: JSON.stringify({ Id: row, RegistrationId: rid, DepartmentId: deptid }),
            @*url: '@Url.Action("GetLeaseRentDetailsById", "Payment", new { area = "Revenue" })',*@
        //    url: '/Revenue/Payment/GetLeaseRentDetailsByIdAndProcedure',
        //    success: function (result) {
        //        if (result != null) {
        //            $('#LeaseRentHtml').html(result.HtmlDuesReport);
        //            $("#PopupWindow").data("kendoWindow").center();
        //            $("#PopupWindow").data("kendoWindow").open();
        //        }
        //        else {
        //            alertify.error("Report is not updated");
        //            return false;
        //        }
        //    },
        //    error: function (ajaxRequest, strError) {
        //        //alert(ajaxRequest.responseText);
        //        alertify.error("Something is wrong, try again later");
        //    }
        //});
    }

    function ShowLeaseRentDetail_SP(row) {
        //alert(row);
        $.ajax({
            type: "post",
            dataType: "json",
            contentType: "application/json;charset=utf-8",
            data: JSON.stringify({ Id: row }),
            url: '@Url.Action("GetLeaseRentDetailsById", "Payment", new { area = "Revenue" })',
            success: function (result) {
                if (result != null) {
                    $('#LeaseRentHtml').html(result.HtmlDuesReport);
                    $("#PopupWindow").data("kendoWindow").center();
                    $("#PopupWindow").data("kendoWindow").open();
                }
                else {
                    alertify.error("Report is not updated");
                    return false;
                }
            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                alertify.error("Something is wrong, try again later");
            }
        });
    }

    function ChangeDeptEvent() {
        flag1 = null;
        flag2 = null;
        flag3 = null;
        //actionType = "LeaseRent";
        //$('#grid-head').text("Lease Rent Details");
        if (displayType == "InstallmentDues") {
            $("#GridInstallmentDues").data("kendoGrid").dataSource.read();
            $('#leaserent-dues-grid').css("display", "none");
            $('#ndc-grid').css("display", "none");
            //$('#installment-dues-grid').show();
            $('#leaserent-report').css("display", "none");
        }
        else if (displayType == "LeaseRentDues") {
            $("#GridLeaseRentDues").data("kendoGrid").dataSource.read();
            $('#leaserent-dues-grid').show();
            $('#ndc-grid').css("display", "none");
            //$('#installment-dues-grid').css("display", "none");
            $('#leaserent-report').css("display", "none");
            UpdateTotalCount();
        }
        else if (displayType == "NDC") {
            $("#GridNDCList").data("kendoGrid").dataSource.read();
            $('#leaserent-dues-grid').css("display", "none");
            $('#ndc-grid').show();
            //$('#installment-dues-grid').css("display", "none");
            $('#leaserent-report').css("display", "none");
        }
        else if (displayType == "Report") {
            $('#leaserent-dues-grid').css("display", "none");
            $('#ndc-grid').css("display", "none");
            //$('#installment-dues-grid').css("display", "none");
            $('#leaserent-report').show();
            $("#GridLeaseRentReport").data("kendoGrid").dataSource.read();
        }
        UpdateTotalCount();
    }

    $('#lrcount').click(function () {
        flag1 = null;
        flag2 = null;
        flag3 = false;
        actionType = "LeaseRent";
        displayType = "LeaseRentDues";
        $('#grid-head').show();
        $('#grid-head').text("Lease Rent Details");
        $('#GridLeaseRentDues').data("kendoGrid").dataSource.read();
        $('#leaserent-dues-grid').show();
        $('#ndc-grid').css("display", "none");
        //$('#installment-dues-grid').css("display", "none");
        $('#leaserent-report').css("display", "none");
    });

    function UpdateTotalCount() {
        var departmentId = $('#DepartmentId').val();
        $.ajax({
            type: "post",
            dataType: "json",
            contentType: "application/json;charset=utf-8",
            data: JSON.stringify({ DepartmentId: departmentId }),
            url: '@Url.Action("GetMiscellaneousPaymentCountByDepartment", "Payment", new { area = "Revenue" })',
            success: function (result) {
                if (result != null) {
                    $('#lrcount').text("LeaseRent dues: " + result.TotalLeaseRentCount);
                    $('#ipcount').html("Lease Rent and Installment Dues: " + result.TotalIPCount);
                    $("#ndccount").text("Total NDC " + result.TotalNDCCount);

                }
                else {
                    alertify.error("Report is not updated");
                    return false;
                }
            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                alertify.error("Something is wrong, try again later");
            }
        });
    }

    $('#ipcount').click(function () {
        flag1 = null;
        flag2 = false;
        flag3 = false;
        actionType = "InstallmentDues";
        displayType = "InstallmentDues";
        $('#grid-head').show();
        $('#grid-head').text("Installment Dues Details");
        $('#GridInstallmentDues').data("kendoGrid").dataSource.read();
        $('#leaserent-dues-grid').css("display", "none");
        $('#ndc-grid').css("display", "none");
        //$('#installment-dues-grid').show();
        $('#leaserent-report').css("display", "none");
    });

    $('#ndccount').click(function () {
        flag1 = null;
        flag2 = true;
        flag3 = true;
        actionType = "LeaseRent";
        displayType = "NDC";
        $('#grid-head').show();
        $('#grid-head').text("NDC Details");
        $('#GridNDCList').data("kendoGrid").dataSource.read();
        $('#leaserent-dues-grid').css("display", "none");
        $('#ndc-grid').show();
        //$('#installment-dues-grid').css("display", "none");
        $('#leaserent-report').css("display", "none");
    });

    $('#defaultercount').click(function () {
        flag1 = null;
        flag2 = false;
        flag3 = false;
        actionType = "LeaseRent";
        displayType = "Report";
        $('#grid-head').show();
        $('#grid-head').text("Lease Rent Report");
        $('#leaserent-dues-grid').css("display", "none");
        $('#ndc-grid').css("display", "none");
        //$('#installment-dues-grid').css("display", "none");
        $('#leaserent-report').show();
        $("#GridLeaseRentReport").data("kendoGrid").dataSource.read();
        GetRevenueWithDefaulters();
    });



    var duration = $('#DDLDuration').val() == "" ? "2017-2018" : $('#DDLDuration').val();
    var deptt = $("#DepartmentId").val() == "" ? 4 : $("#DepartmentId").val();
    function FilterParam() {
        var model = { DepartmentId: $("#DepartmentId").val() == "" ? 4 : $("#DepartmentId").val(), IsOneTimeLeaseRentPaid: flag3, IsTotalInstallmentPaid: flag2, ActionType: $('#DDLDuration').val() == "" ? "2017-2018" : $('#DDLDuration').val() };
        return model;
    }

    function ViewLeaseRent(row) {
        //alert(1);
        var rw = $(row).parent().parent();
        var id = $(row).children("td:eq(1)").text();
        window.location.href = "/Revenue/Finance/LeaseRentReport?financialYear=" + id;
        @*window.location.href = '@Url.Action("LeaseRentReport", "Finance",new {financialYear="2017-2018", area="Revenue"})';*@
    }

    function LeaseRent() {
        var model = { DepartmentId: $("#DepartmentId").val(), IsOneTimeLeaseRentPaid: flag3, IsTotalInstallmentPaid: flag2, ActionType: actionType };
        return model;
    }

    function ParamLeaseRent() {
        var model = { DepartmentId: $("#hdn-departmentId").val(), RegistrationId: $("#hdn-rid").val(), CurrentDuesDate: $('#DPCurrentDuesDate').val() };
        return model;
    }

    $('#update-payment-dues').click(function () {
        if ($("#DepartmentId").val() != "") {
            var atype = $('#DDLActionType').val();
            if (atype == "Installment") {
                UpdateInstallmentDues();
            }
            else if (atype == "LeaseRent") {
