@using NA.PMS.Common;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions

@{
    ViewBag.Title = "Update Master Data";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/common-validation.js"></script>
<style>
    .left-pad-15 {
        padding-left: 15px;
    }

    .panel-title a {
        text-decoration: none;
    }

    .k-textbox {
        width: 100%;
    }

    .form-control {
        border-radius: 0;
    }

    .more-less {
        float: right;
        color: #212121;
    }

    .panel-body {
        padding-bottom: 0;
    }
    .row.form-group{padding-right:30px;}
    
</style>
<script src="~/Scripts/common-validation.js"></script>

<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
