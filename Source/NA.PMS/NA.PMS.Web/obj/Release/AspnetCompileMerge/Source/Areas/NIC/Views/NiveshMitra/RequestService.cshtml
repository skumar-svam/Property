@model NA.PMS.NICServices.SWPServicesViewModel
@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions;
@using NA.PMS.Common;
@using Newtonsoft.Json;

@{
    ViewBag.Title = "Nivesh Mitra Services";
    Layout = "~/Areas/NIC/Views/Shared/_Layout.cshtml";
    //Layout = "~/Views/Shared/_LayoutNIC.cshtml";
}
<style>
    .nic-header-name {
        font-family: inherit !important;
    }

    .text-red {
        color: red;
    }
    .col-md-3.col-20{
        width:20% !important;
