                        <a class="btn btn-add" href="@Url.Action("PreviewForm", "Application", new { area = "Online", id = OnlineSchemeHelper.Encode(Model.ApplicationFormId.ToString()) })">Go to Preview</a>
                    }
                }
                else
                {
                    <input type="button" value="Submit & Proceed to Payment" id="btnSubmit" class="btn btn-add" />
                }
            </div>
        </div>

    </div>
}

