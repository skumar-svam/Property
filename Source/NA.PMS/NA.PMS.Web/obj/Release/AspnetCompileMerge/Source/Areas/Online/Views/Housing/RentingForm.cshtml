@*@model NA.PMS.Model.OnlineFormViewModel*@
@model NA.PMS.OnlineScheme.SchemeFormViewModel
@using Kendo.Mvc.UI
@using NA.PMS.Common
@using NA.PMS.OnlineScheme
@{
    ViewBag.Title = "Renting Form";
    Layout = "~/Areas/Online/Views/Shared/_LayoutOnlineScheme.cshtml";
}

<style>
    .divCompanyInfo {
        display: none;
    }

    .k-button.k-upload-button {
        margin: 0;
    }

    .k-upload-files {
        margin: 0;
    }

    #userphoto {
        display: none;
    }

        #userphoto:hover {
            cursor: pointer;
        }

    .glyphicon-user:hover {
        cursor: pointer;
    }

    #signature {
        display: none;
    }

        #signature:hover {
            cursor: pointer;
        }

    .img-upld-bx:hover {
        cursor: pointer;
    }

    #loader {
        display: none;
    }

    .text-red {
        color: red;
    }

    .upload-user-image {
        width: 140px;
        height: 140px;
        padding-top: 60px;
    }

    .upload-sign-image {
        width: 140px;
        height: 55px;
        line-height: 14px;
        padding-top: 5px;
    }

    .upload-image {
        background: #fff;
        border: 1px solid #ccc;
        font-size: 11px;
        text-align: center;
        float: right;
    }

    .area-form-fee {
        display: none;
    }

    #btn-download-form {
        /*display: none;*/
    }

    /*#form-download-href {
        display: none;
    }*/

    #btn-skip-form {
        /*display: none;*/
    }
    .col-20{
        width:20% !important;
    }
     .col-30{
        width:30% !important;
    }
      .col-40{
        width:40% !important;
    }
     .col-60{
        width:60% !important;
    }
</style>

@using (Html.BeginForm("OnlineSchemeFormPayment", "Housing", FormMethod.Post, new { enctype = "multipart/form-data", id = "applicationform" }))
{
    <div class="online-registration">
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Online Application Form</h1></div>
                <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce" id="first-form">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px" id="divApplicantInformation">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <h2 class="blck-heading" style="margin-bottom:6px;">
                    Applicant Information
                    @{
                        if (Model.ApplicationFormId != null)
                        {
                            <span class="pull-right">Form No: @Html.DisplayFor(model => model.ApplicationFormId)</span>
                        }
                     }
                </h2>
                <div class="form-bx">
                    <div>
                        @Html.HiddenFor(m => m.Id)
                        @Html.HiddenFor(m => m.EncryptedFormId)
                        @Html.HiddenFor(m => m.SchemeId)
                        @Html.HiddenFor(m => m.DepartmentId)
                        @Html.HiddenFor(m => m.BankId)
                        @Html.HiddenFor(m => m.AreaRange)
                        @Html.HiddenFor(m => m.SchemeType)
                        @Html.HiddenFor(m => m.ApplicationFormType)
                        @Html.HiddenFor(m => m.ApplicantType)
                        @Html.HiddenFor(m => m.AppType)
                        @Html.HiddenFor(m => m.FormType, htmlAttributes: new { @id = "hdnFormType" })

                        @Html.HiddenFor(m => m.ApplicationFee)
                        @Html.HiddenFor(m => m.EarnestMoney)
                        @Html.HiddenFor(m => m.ProcessingCharge)
                        @Html.HiddenFor(m => m.FormFeeGST)
                        @Html.HiddenFor(m => m.FormFeeWithGST)
                        @Html.HiddenFor(m => m.ProcessingChargeGST)
                        @Html.HiddenFor(m => m.TotalAmount)

                        @Html.HiddenFor(m => m.NICApplicationId)
                        @Html.HiddenFor(m => m.NICControlId)
                        @Html.HiddenFor(m => m.NICServiceId)
                        @Html.HiddenFor(m => m.NICProcessIndustryId)
                        @Html.HiddenFor(m => m.NICUnitId)
                        @Html.HiddenFor(m => m.IsFromNIC)

                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-md-4 col-sm-6 col-xs-12 col-40 form-group">
                                    @Html.Label("Scheme Name", htmlAttributes: new { @class = "required" })
                                </div>
                                <div class="col-md-8 col-sm-6 col-xs-12 col-60 form-group">
                                    @Html.TextBoxFor(model => model.SchemeName, new { @readonly = "readonly", @class = "form-control" })
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-sm-6 col-xs-12 col-40 form-group">@Html.Label("Department", htmlAttributes: new { @class = "required" })</div>
                                <div class="col-md-8 col-sm-6 col-xs-12 col-60 form-group">
                                    @Html.TextBoxFor(model => model.Department, new { @readonly = "readonly", @class = "form-control" })
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-4 col-sm-6 col-xs-12 col-40 form-group">
                                    <label>Applicant Type</label>
                                </div>
                                <div class="col-md-8 col-sm-6 col-xs-12 col-60 form-group">
                                    @(Html.Kendo().DropDownListFor(model => model.ApplicantType)
                                        .Name("DDLApplicantType")
                                        .DataTextField("Text")
                                        .DataValueField("Text")
                                        .OptionLabel(" -- Select --")
                                        .DataSource(source => source.Read(read => read.Action("GetApplicantTypeList", "Application")))
                                        .Enable(true)
                                        .AutoBind(true)
                                        .Filter("contains")
                                        .Events(e => e.Change("ToggleApplicantType"))
                                        .HtmlAttributes(new { style = "width:100%", @class = "input-disabled" })
                                    )
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-sm-6 col-xs-12 col-40 form-group">
                                    @Html.Label("Applicant Constitution", htmlAttributes: new { @class = "required" })
                                </div>
                                <div class="col-md-8 col-sm-6 col-xs-12 col-60 form-group">
                                    @(Html.Kendo().DropDownListFor(model => model.CompanyTypeId)
                                    .DataTextField("Text")
                                    .DataValueField("Id")
                                    .OptionLabel(" -- Select --")
                                    .DataSource(source => source.Read(read => read.Action("GetCompanyTypeList", "Application").Data("FilterApplicantType")).ServerFiltering(true))
                                    .Enable(true)
                                    .AutoBind(true)
                                    .Filter("contains")
                                    .CascadeFrom("DDLApplicantType")
                                    .HtmlAttributes(new { style = "width:100%", @class = "input-disabled" })
                                    )
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-sm-6 col-xs-12 col-40 form-group">
                                    @Html.Label("Applied For(Sec-122)", htmlAttributes: new { @class = "required" })
                                </div>
                                <div class="col-md-8 col-sm-6 col-xs-12 col-60 form-group">
                                    @(Html.Kendo().DropDownListFor(model => model.AreaRangeId)
                                    .DataValueField("Id")
                                    .DataTextField("Text")
                                    .OptionLabel("--Select--")
                                    .AutoBind(true).Enable(true)
                                    .Events(events => { events.Change("ApplicationFeeAndCharges"); })
                                    .Filter("contains")
                                    .CascadeFrom("DepartmentId")
                                    .DataSource(source =>
                                    {
                                        source.Custom()
                                        .ServerFiltering(true)
                                        .ServerPaging(true)
                                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                        .Transport(transport => transport.Read(read => read.Action("GetFloorAreaListAsDataSource", "Default", new { area = "Online" }).Data("FilterIdForAreaRange")))
                                        .Schema(schema => schema.Data("Data").Total("Total"))
                                        .PageSize(100);
                                    })
                                    //.BindTo(new List<SelectListItem> { 
                                    //    new SelectListItem { Text = "1 Block", Value = "1" }, new SelectListItem { Text = "2 Block", Value = "2" },
                                    //    new SelectListItem { Text = "3 Block", Value = "3" }, new SelectListItem { Text = "4 Block", Value = "4" },
                                    //    new SelectListItem { Text = "5 Block", Value = "5" }, new SelectListItem { Text = "6 Block", Value = "6" },
                                    //    new SelectListItem { Text = "7 Block", Value = "7" }, new SelectListItem { Text = "8 Block", Value = "8" },
                                    //    new SelectListItem { Text = "9 Block", Value = "9" }, new SelectListItem { Text = "10 Block", Value = "10" },
                                    //    new SelectListItem { Text = "11 Block", Value = "11" }, new SelectListItem { Text = "12 Block", Value = "12" },
                                    //    new SelectListItem { Text = "13 Block", Value = "13" }, new SelectListItem { Text = "14 Block", Value = "14" },
                                    //    new SelectListItem { Text = "15 Block", Value = "15" }, new SelectListItem { Text = "16 Block", Value = "16" },
                                    //})
                                    //.DataSource(source => source.Read(read => read.Action("GetFloorAreaList", "Application").Data("FilterIdForAreaRange")).ServerFiltering(true))
                                    .HtmlAttributes(new { style = "width: 100%" })
                                    )
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">

                            <div class="row">
                                <div class="col-md-4 col-sm-6 col-xs-12 col-40">

                                </div>
                                <div class="col-md-8 col-sm-6 col-xs-12 col-60 form-group">
                                    <div class="row">
                                        @{
                                            if (Model.UserImage != null && Model.SignImage != null)
                                            {
                                                <div class="col-md-12 text-right" style="margin-bottom:5px;">
                                                    <img id="userphoto1" src="@Model.UserImage" alt="your image" height="150" width="140" name="userImage2" />
                                                </div>
                                                <div class="col-md-12 text-right">
                                                    <img id="signature1" src="@Model.SignImage" alt="your sign" height="40" width="140" name="usersign" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="col-md-12 text-right" style="margin-bottom:5px;">
                                                    <div id="userid" class="img-upld-bx upload-image upload-user-image" style=""> Upload your image <small class="text-red"> User Image Size Min(10kb) and Max(50kb)</small></div>
                                                    <img id="userphoto" src="#" alt="your image" height="150" width="140" name="userImage2" />
                                                    <input type='file' id="imguser" name="userImage" accept="image/jpg" style="display:none" />
                                                </div>
                                                <div class="col-md-12 text-right">
                                                    <div id="signatureid" class="img-upld-bx upload-image upload-sign-image" style=""> Upload your signature <small class="text-red"> Signature Image Min(5kb) and Max(20kb)</small></div>
                                                    <img id="signature" src="#" alt="your sign" height="40" width="140" name="usersign" />
                                                    <input type='file' id="imgsign" name="signatureImage" accept="image/jpg" style="display:none" />
                                                </div>
                                            }
                                        }

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row divCompanyInfo" id="divCompanyInfo">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.LabelFor(m => m.Applicant, htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", placeholder = "full name " })
                            @Html.ValidationMessageFor(model => model.Applicant, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group col-company">
                            @Html.Label("Authorized Signatory", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group col-company">
                            @Html.TextBoxFor(model => model.SigningAuthority, new { @class = "form-control", @maxlength = "150", placeholder = "signing authority" })
                            @Html.ValidationMessageFor(model => model.SigningAuthority, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row divCompanyInfo" id="">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Signatory's Father Name", htmlAttributes: new { @class = "" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.ApplicantMaster, htmlAttributes: new { @class = "form-control", placeholder = "father's name " })
                            @Html.ValidationMessageFor(model => model.ApplicantMaster, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group col-company">
                            @Html.Label("Signatory Status", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group  col-company">
                            @(Html.Kendo().DropDownListFor(model => model.SigningAuthorityId)
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel("--Select--")
                            .DataSource(source => source.Read(read => read.Action("GetDirectorTypeList", "Application", new { area = "Online" })))
                            .HtmlAttributes(new { @class = "", style = "width:100%;" })
                            )
                        </div>
                    </div>

                    <div class="row" id="divIndividualInfo">
                        @*@{Html.RenderPartial("_IndividualForm", Model);}*@
                    </div>
                </div>
                <div id="CommonInfo" class="form-bx">
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Permanent Address", htmlAttributes: new { @class = "required lbl-permanent-address" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextAreaFor(model => model.PermanentAddress, new { @class = "form-control", @maxlength = "500", placeholder = "address" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Correspond Address", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextAreaFor(model => model.CorrespondingAddress, new { @class = "form-control", @maxlength = "500", placeholder = "address" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Email", htmlAttributes: new { @class = "required lbl-Email" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @(Html.EditorFor(model => model.Email, new { htmlAttributes = new { @editable = "true", @class = "form-control", @maxlength = "150", placeholder = "skumar@svam.com" } }))
                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Mobile Number", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.MobileNumber, new { @class = "form-control", @minlength = "10", @maxlength = "10", onkeypress = "return IsNumeric(event);", placeholder = "1234567899" })
                            @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("GST Number", htmlAttributes: new { @class = "", @id = "" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.ApplicantGSTNumber, new { @class = "form-control", placeholder = "", @maxlength = "15" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Aadhar Number", htmlAttributes: new { @class = "required", @id = "lblPanNumber" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.AadharNumber, new { @class = "form-control", @minlength = "12", @maxlength = "12", onkeypress = "return IsNumeric(event);", placeholder = "0000 1111 2222" })
                            @Html.ValidationMessageFor(model => model.AadharNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("PAN", htmlAttributes: new { @class = "required lbl-PAN" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.PanNumber, new { @class = "form-control", placeholder = "AAAAA1111A", @onchange = "PanNumberChange();", @maxlength = "10" })
                            @Html.ValidationMessageFor(model => model.PanNumber, "", new { @class = "text-danger", style="font-size:10px;" })
                            <small class="text-info" style="font-size:10px;">PANCARD Format Like AAAAA1111A</small>
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Annual Income", htmlAttributes: new { @class = "required lbl-annnual-income" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.AnnualIncome, new { @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                            <small class="text-info">Value in Rupees.</small>
                            @Html.ValidationMessageFor(model => model.AnnualIncome, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("EPF Registration No", htmlAttributes: new { @class = "", @id = "lbl-epf" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.EPFRegistrationNo, new { @class = "form-control", placeholder = "E.P.F", @maxlength = "30" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group col-rent">
                            @Html.Label("ESI Registration No", htmlAttributes: new { @class = "", @id = "lbl-esi" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group col-rent">
                            @Html.TextBoxFor(model => model.ESIRegistrationNo, new { @class = "form-control", placeholder = "E.S.I.", @maxlength = "10" })
                        </div>
                    </div>

                </div>

                <h2 class="blck-heading">Refund Information</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20  form-group">
                            @Html.Label("Bank Name", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @(Html.Kendo().DropDownListFor(m => m.RefundBankId).Filter("contains")
                                .DataTextField("Text")
                                .DataValueField("Id")
                                .OptionLabel("---Select---")
                                .DataSource(source => source.Read(read => read.Action("GetBankListforOnline", "Application")))
                                .HtmlAttributes(new { @class = "schemeForms", style = "width: 100%" })
                            )
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Branch Name", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.BranchName, new { @class = "form-control", @maxlength = "150", placeholder = "" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Infavour of", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.RefundInfaverof, new { @class = "form-control", @maxlength = "150", placeholder = "name" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Account No", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.RefundAccountNo, new { @class = "form-control textBoxValueRightAlign",@minlength="11", @maxlength = "16", placeholder = "110000001100011" })
                            @Html.ValidationMessageFor(model => model.RefundAccountNo, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("IFSC Code", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.IFSCCode, new { @class = "form-control", @maxlength = "11", placeholder = "AAAA1111111" })
                            @Html.ValidationMessageFor(model => model.IFSCCode, "", new { @class = "text-danger" })
                            <small class="text-info">Format Like AAAA1111111</small>
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">

                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">

                        </div>
                    </div>

                </div>

                <h2 class="blck-heading" style="margin-bottom:6px;">DECLARATION BY THE APPLICANT</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-12 form-group">
                            <p>
                                <label>
                                    <input type="checkbox" required name="chkboxDeclaration" id="chkboxDeclaration" />
                                    I/We hereby declare that the information, submitted with application form, are true to the best of our knowledge. Nothing
                                    has been concealed and no part of it is false. I/We further declare that we have carefully read and understood the terms and conditions
                                    for allotment of industrial plot and do hereby abide by the same. I/We are aware, if allotment is obtained on the basis of false
                                    information, the NOIDA may cancel our allotment at any stage and forfeit all the deposits made by me/us.
                                </label>
                            </p>
                        </div>
                    </div>

                </div>

                <h2 class="blck-heading area-form-fee">Scheme Application Form Payment</h2>
                <div class="form-bx  area-form-fee">
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Application Form No", htmlAttributes: new { @class = "" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.ApplicationFormId, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Form Fee (INR)", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.FormFeeWithGST, new { @id = "schemeformfee", @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                        </div>
                    </div>
                    <div class="row">
