                            }
                          
                            @*<input type="button" class="btn btn-default" id="btn-pay-form-fee" value="Validate Fee Payment" style="float:right;" />*@
                        </div>
                    </div>
                </div>
            </div>

            <div class="box-button text-center" id="div-box-button">
                <input type="button" class="btn btn-default" id="btnCancel" value="Cancel" onclick="window.history.back()" />

                @if (Session["SchemeUserLoginDetails"] != null && Session["SchemeUserLoginDetails"] != "")
                {
