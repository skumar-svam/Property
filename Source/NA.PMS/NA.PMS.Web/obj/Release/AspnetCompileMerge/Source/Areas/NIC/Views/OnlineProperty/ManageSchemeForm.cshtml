    function RejectApplication(row) {
        //var tr = $(row).parent().parent();
        var ApplicationId = row; //$(tr).children("td:eq(1)").text();
        if (confirm("Are you sure? You want to reject this application.")) {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                //data: JSON.stringify({ AppId: ApplicationId }),
                //url: '/Online/Application/RejectApplication',
                data: JSON.stringify({ ApplicationFormId: ApplicationId, ActionType: "Reject" }),
                url: '/NIC/OnlineProperty/ValidateOnlineSchemeForm',
                success: function (result) {
                    if (result.ReturnTypeId == '@ReturnType.Rejected') {
                        alertify.success("Application rejected successfully.");
                    } else { alertify.error("Application not rejected."); }
                    $("#gridOnlineApplicationDetail").data("kendoGrid").dataSource.read();
                },
                error: function (obj) {
                }
            });
        }
    }

    function UpdateApplicationDetails(row) {
        //var tr = $(row).parent().parent();
        var ApplicationId = row; //$(tr).children("td:eq(1)").text();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            //data: JSON.stringify({ FormId: ApplicationId }),
            //url: '/Online/Application/AddToAllotment',
            data: JSON.stringify({ ApplicationFormId: ApplicationId }),
            url: 'NIC/OnlineProperty/SaveAllotmentDetailByOnlineSchemeFormId',
            success: function (result) {
                if (result.ReturnTypeId == '@ReturnType.Saved') {
                    alertify.success("Online application saved for allotment.");
                }
                else if (result.ReturnTypeId == '@ReturnType.NotPaid') {
                    alertify.error("Application Detail updated but payment not.");
                }
                else if (result.ReturnTypeId == '@ReturnType.Exist') {
                    alertify.error("Application Form Detail already saved.");
                }
                else {
                    alertify.error("Provider failed to save form data.");
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Network error, Please try again later.");
            }
        });
    }

    function UpdateChallanStatus(row) {
        $("#hdn-applicationid").val('');
        $("#hdn-challan-amount").val('');
        $("#hdn-challan-filepath").val('');
        //var tr = $(row).parent().parent();
        var ApplicationId = row; //$(tr).children("td:eq(1)").text();
        //var Amount = $(tr).children("td:eq(2)").text();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ ApplicationFormId: ApplicationId }),
            //url: '/Online/Payment/GetChallanDetailsTrans',
            url: '/NIC/OnlineProperty/GetSchemeFormPaymentTransaction',
            success: function (result) {
                $("#lbl-challan-bankname").html(result.BankName);
                $("#lbl-transaction-id").html(result.TransactionId);
                var ModDate = (new Date(parseInt(result.modifiydate.replace("/Date(", "").replace(")/", ""), 10))).toString("dd/MM/yyyy");
                $("#lbl-submit-date").html(ModDate);
                $("#lbl-applicationid").html(ApplicationId);
                $("#lbl-utr-no").html(result.TransactionKey);
                $("#hdn-applicationid").val(ApplicationId);
                $("#hdn-challan-amount").val(result.Amount);
                $("#hdn-challan-filepath").val(result.docPath);

                $("#div-challan-validation").modal('show');
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Network error, Please try later.");
            }
        });
    }


