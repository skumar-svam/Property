            //url: '/Online/Payment/UpdateChallanStatus',
            data: JSON.stringify({ ApplicationFormId: applicationId, PaymentTypeId: paymentType, Amount: amount }),
            url: '/NIC/OnlineProperty/ValidateSchemeFormChallan',
