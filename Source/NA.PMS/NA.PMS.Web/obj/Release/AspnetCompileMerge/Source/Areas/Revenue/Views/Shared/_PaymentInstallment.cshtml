                    //    //model.Field(c => c.PrincipalAmount).Editable(false);
                    //})

                    //.Read(read => read.Action("GetInstallmentPaymentScheduleById", "Finance", new { area = "Revenue" }).Data("FilterParameterForSchedule"))
                    .Read(read => read.Action("GetReScheduledInstallmentAsDataSource", "Payment", new { area = "Revenue" }).Data("FilterParameterForSchedule"))
                    .Sort(s => s.Add(i => i.InstallmentNo).Ascending())//.PageSize(20)
            //.Update("UpdateInstallmentSchedulePaymentById", "Finance", new { area = "Revenue" })
                    )
    )
</div>


<div class="col-md-12 k-grid-content" id="div-GridDuesCalculationHistory">
    <h2 class="blck-heading" style="margin-bottom:0;">Installment Dues Calculation</h2>
    @(Html.Kendo().Grid<NA.PMS.Model.Sp_DuesCalculationHistory_Result>()
    .Name("GridDuesCalculationHistory")
        .AutoBind(false)
    .Columns(columns =>
    {
        columns.Bound(c => c.InstallmentAmount).Title("Installment");//.ClientTemplate("<a href='" + "/Property/PropertyAllotment/PropertyDetails/#= RegistrationId #'>#= RegistrationId #</a>").Filterable(true);
        columns.Bound(c => c.DepositAmount).Title("Deposit");
        columns.Bound(c => c.InstallmentDueDate).Title("Due Date").Format("{0:dd-MMM-yyyy}");
        columns.Bound(c => c.DuesTill).Title("Dues");
        columns.Bound(c => c.DuesNextWithInterest).Title("Total Dues (<span class='fa fa-rupee'></span>)");
        columns.Bound(c => c.PenalAmount).Title("Penal Amount");
        columns.Bound(c => c.NewDateDiff).Title("Diff Date");//.ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
        columns.Bound(c => c.TotalPanelAmount).Title("Total Penal");
        columns.Bound(c => c.TotalPrincipalAmount).Title("Total Principal").Width(140);//.ClientTemplate(" <center><a onclick='javascript:PrintDemandNote(#=RegistrationId#,#=DuesAmount#);'><span class='fa fa-print'></span></a></center> ");
        columns.Bound(c => c.DepositDate).Title("Deposit Date").Format("{0:dd-MMM-yyyy}");//.ClientTemplate("<center><a onclick='javascript:CalculateInstallmentDues(#=RegistrationId#);'><span class='fa fa-refresh'></span></a></center> ");
    })
    .Events(m => m.DataBound("kendoDuesCalculationGridDataBoundEvent"))
    .Resizable(resize => resize.Columns(true))
            //.Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
    .DataSource(dataSource => dataSource
            .Ajax()
            .ServerOperation(true)
            .Read(read => read.Action("GetDuesCalcaluationHistoryAsDataSource", "PropertyAllotment", new { area = "Property" }).Data("FilterDuesParam")).PageSize(10)
        )
    )
</div>


<div id="div-installment-window" class="installment-popup-window">
    <style>
        #div-installment-window .row.form-group {
            padding-right: 30px;
        }
    </style>
    <div class="row form-group">
        <div class="col-md-6 col-sm-6 col-xs-12 ">
            <label>Installment Amount</label>
            <input type="text" class="k-textbox" id="txtInstallmentAmount" maxlength="20" style="width:90%; float:right;" />
        </div>
        <div class="col-md-6 col-sm-6 col-xs-12 ">
            <label>Installment Interest</label>
            <input type="text" class="k-textbox" id="txtInstallmentInterest" maxlength="20" style="width:90%; float:right;" />
        </div>

    </div>
    <div class="row form-group">
        <div class="col-md-6 col-sm-6 col-xs-12 ">
            <label>Balance Amount</label>
            <input type="text" class="k-textbox" id="txtBalanceAmount" maxlength="20" style="width:90%; float:right;" />
        </div>
        <div class="col-md-6 col-sm-6 col-xs-12 ">
            <label>Installment Due Date</label>
            @(Html.Kendo().DatePicker().Name("kendoInstallmentDueDate").HtmlAttributes(new { @class = "input-disabled  readonly", style = "width:90%;float:right;" }))
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-12" style="text-align:right; padding-top:25px;">
            <input type="button" id="btn-schedule-trans" class="k-button" value="Update" />
            <input type="button" id="btn-schedule-clear" class="k-button" value="Clear" />
            <input type="button" id="btn-window-close" class="k-button" value="Close" />
        </div>
    </div>
</div>



<div class="col-md-12" id="schedule-type-window" style="min-height:150px; background:url(/Content/Images/boxed-bg.jpg) repeat;">
    <div class="row" style="padding-top:25px;">
        <div class="col-md-8 col-md-offset-2">
            @(Html.Kendo().DropDownList()
                .Name("DDLCreateScheduleType")
                .DataTextField("Text")
                .DataValueField("Value")
                .OptionLabel(" --- Select ---")
                .BindTo(new List<SelectListItem>() {
                    new SelectListItem() { Text = "Normal Schedule", Value = "I" },
                    new SelectListItem() { Text = "Re Schedule", Value = "R" }
                })
                .HtmlAttributes(new { style = "width: 100%;" })
            )
        </div>
        <div class="col-md-12" style="padding-top:20px;text-align:center">
            <input type="button" class="k-button" id="btn-create-schedule" value="Create Schedule" style="background:#299a8b;color:#fff;" />
        </div>
    </div>
</div>


<div id="divPrintSchemeForm" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 60%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title"><b>Demand Note</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:400px;">
                <div id="divSchemeForm"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintSchemeFormDiv();">Print</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#hdnCalDueDateTime").kendoDatePicker();
        $('#schedule-type-window').kendoWindow({
            modal: true,
            title: "Select Schedule Type",
            visible: false,
            width: "25%"
        });

        $('.installment-popup-window').kendoWindow({
            modal: true,
            title: "Installment Update Window",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "25%"
            },
            width: "45%", height: "40%"
        });

        $('#btn-create-schedule').click(function () {
            if ($('#DDLCreateScheduleType').val() == "") {
                alertify.error("Please select schedule Type");
                return false;
            }
            else {
                CreateInstallmentSchedule();
            }
        });

        $(".btn-open-window").click(function () {
            $("#schedule-type-window").data("kendoWindow").center();
            $("#schedule-type-window").data("kendoWindow").open();
        });

        $('#btn-window-close').click(function () {
            $(".installment-popup-window").data("kendoWindow").close();
        });

        $('#btn-schedule-clear').click(function () {
            ClearScheduleTransFields();
        });

        $('#btn-schedule-trans').click(function () {
            ValidateScheduleTransInput();
            //SaveInstallmentScheduleTans();
        });

        $(".btn-installment-demand").click(function () {
             PrintInstallmentDemandNote();
        });

        $(".btn-calculate-installment-dues").click(function () {
            UpdateInstallmentDuesPayment();
        });
    });

    function OpenUpdateWindow() {
        $(".installment-popup-window").data("kendoWindow").center();
        $(".installment-popup-window").data("kendoWindow").open();
        $(".installment-popup-window").data("kendoWindow").pin();
    }

    function FilterParameterForSchedule() {
        return {
            RegistrationId: $('#hdn-registration-id').val(),
            ScheduleType: $("#DDLScheduleType").val() == "" ? "I" : $("#DDLScheduleType").val()
        };
    }

    function ScheduleTypeChangeEvent() {
        $('#InstallmentScheduleGrid').data('kendoGrid').dataSource.read();
        GetPaymentDetails();
    }

    function FilterDuesParam() {
        return {
            RegistrationId: $('#hdn-registration-id').val(),
            ActionDate: $('#installment-duesupto-date').val(),
            PropertyTypeId: 1
        };
    }

    function FrequencyChangeEvent() {
        var rid = $('#hdn-registration-id').val();
        var principal = $("#installment-balance-amount").val();
        if (rid != "" && principal != "") {
            var totalInstallment = $('#installment-total-installment').val();
            var frequency = $("#Frequency").data("kendoDropDownList").value();
            if (totalInstallment == "" || totalInstallment <= 0) {
                alertify.error("Enter Total Installment greater than 0");
                //$('#PremiumAmount').val('');
                //$('#PeriodOfInstallment').val('');
                return false;
            }
            else if (frequency == "") {
                alertify.error("Select Frequency.");
                $('#PremiumAmount').val('');
                $('#PeriodOfInstallment').val('');
                return false;
            }
            else if (totalInstallment != "" && frequency != "") {
                var premium = parseFloat(parseFloat(principal) / (parseInt(totalInstallment) * parseInt(frequency))).toFixed(2);
                var period = parseInt(12 / parseInt(frequency));
                //$('#PremiumAmount').val(premium);
                //$('#PeriodOfInstallment').val(period);
            }
            else {
                //$('#PremiumAmount').val('');
                //$('#PeriodOfInstallment').val('');
            }
        }
    }

    function CreateInstallmentSchedule() {
        var flag = ValidateForScheduleCreation();
        if (flag) {
            var schedule = {
                RegistrationId: $('#hdn-registration-id').val(),
                BalanceAmount: $("#installment-balance-amount").val(),
                PrincipalAmount: $("#installment-balance-amount").val(),
                Frequency: $("#Frequency").data("kendoDropDownList").value(),
                TotalInstallment: $("#installment-total-installment").val(),
                InstallmentStartDate: $("#installment-start-date").val(),
                NormalInterest: $("#installment-normal-interest").val(),
                PenalInterest: $("#installment-penal-interest").val(),
                ScheduleType: $("#DDLCreateScheduleType").val(),
                ActionType: $("#DDLCreateScheduleType").val() == "R" ? "Reschedule" : null
            }
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json;charset=utf-8",
                data: JSON.stringify({ model: schedule }),
                url: '/Revenue/Payment/SavePropertyPremiumScheduleByRegistrationId',
                success: function (result) {
                    if (result == '@ReturnType.Saved') {
                        alertify.success("Installment Schedule added successfully.");
                        GetPaymentDetails();
                        $('#DDLScheduleType').data('kendoDropDownList').dataSource.read();
                        $('#InstallmentScheduleGrid').data('kendoGrid').dataSource.read();
                        $('#DDLCreateScheduleType').data('kendoDropDownList').value('');
                    }
                    if (result == '@ReturnType.Rescheduled') {
                        alertify.success("Installment Rescheduled successfully.");
                        GetPaymentDetails();
                        $('#DDLScheduleType').data('kendoDropDownList').dataSource.read();
                        $('#InstallmentScheduleGrid').data('kendoGrid').dataSource.read();
                        $('#DDLCreateScheduleType').data('kendoDropDownList').value('');
                    }
                    else if (result == '@ReturnType.None') {
                        alertify.error("Provider failed to create schedule, try again.");
                        //$(".PaymentDetailsGrid").hide();
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Something is wrong, try again later");
                }
            });
        }        
    }

    function GetPaymentDetails() {
        var rid = $('#hdn-registration-id').val();
        var scheduleType = $("#DDLScheduleType").val() == "" ? "R" : $("#DDLScheduleType").val();
        if (rid != "") {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ RegistrationId: rid, ScheduleType: scheduleType }),
                url: "/Revenue/Payment/GetPropertyPaymentReScheduleInformationById",
                success: function (result) {
                    if (result != null) {
                        $("#installment-balance-amount").data("kendoNumericTextBox").value(result.PrincipalAmount);
                        $("#installment-total-installment").data("kendoNumericTextBox").value(result.TotalInstallment);
                        $("#installment-start-date").data("kendoDatePicker").value(result.InstallmentStartDate);
                        $("#installment-normal-interest").data("kendoNumericTextBox").value(result.NormalInterest);
                        $("#installment-penal-interest").data("kendoNumericTextBox").value(result.PenalInterest);
                        $("#Frequency").data("kendoDropDownList").value(result.Frequency);
                    } else { alertify.error("no data found."); }

                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                }
            });
        }
        else {
            //ClearPaymentScheduleFields();
            ////ClearInstallmentPaymentFields();
            //$(".PaymentDetailsGrid").hide();
            //$('.readonly').attr("readonly", false);
            ////$('#gridPaymentSchedule').data('kendoGrid').refresh();
        }
    }

    function UpdateInstallmentDuesPayment() {
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ RegistrationId: $('#hdn-registration-id').val(), ActionDate: $('#installment-duesupto-date').val() }),
            //url: '/Revenue/Payment/InstallmentDuesPayment',
            url: '/Revenue/Payment/CalculateInstallmentDuesById',
            success: function (result) {
                if (result.IsInstallmentPaid == true) {
                    //$('#lbl-dues-amuont').html(result.PremiumPaidStatus);
                }
                else {
                    $('#installment-payable-amount').data("kendoNumericTextBox").value(result.TotalDuesAmount);
                    $('#installment-interest-amount').data("kendoNumericTextBox").value(result.PenalInterest);
                    //$('#lbl-principal-amuont').html(result.PrincipalAmount);
                    //$('#DuesUptoDate').data("kendoDatePicker").value(result.DuesUptoDate);
                }

                if (result.IsOneTimeLeaseRentPaid == true) {
                    //$('#lbl-leaserent-amount').html(result.LeaseRentStatus);
                }
                else {
                    //$('#lbl-leaserent-amount').html(result.CurrentDues);
                    ////$('#lbl-leasernet-upto').html(result.CurrentDuesDate);
                    //$('#CurrentDuesDate').data("kendoDatePicker").value(result.CurrentDuesDate);
                }
                $("#GridDuesCalculationHistory").data('kendoGrid').dataSource.read();
                //$("#GridLeaseRentDues").data("kendoGrid").dataSource.read();
                //$('#lbl-dues-upto-date').html(result.DuesUptoDate != null && result.DuesUptoDate != "" ? new Date(parseInt(result.DuesUptoDate.substr(6))) : new Date());
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Some Error in save database.");
            }
        });
    }

    function kendoDuesCalculationGridDataBoundEvent() {
        var dataCount = $("#GridDuesCalculationHistory").data('kendoGrid').dataSource.total();
        if (dataCount == 0) {
            //$('#lbl-dues-calculation-status').html("Installment Full Paid");
            $('#div-GridDuesCalculationHistory').css("display", "none");
        }
        else {
            //$('#lbl-dues-calculation-status').html("");
            $('#div-GridDuesCalculationHistory').show();
        }
    }

    function PrintInstallmentDemandNote() {
        var rid = $('#hdn-registration-id').val();
        var duesDate = $('#installment-duesupto-date').val();
        var leaseModel = { RegistrationId: rid, ActionDate: duesDate };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: leaseModel }),
            //url: '/Revenue/Finance/PrintDemandNote',
            url: '/Revenue/Finance/PrintInstallmentDuesDemandNote',
            success: function (result) {
                $("#divApplicationForm").modal('hide');
                $("#divSchemeForm").html(result);
                $("#divPrintSchemeForm").modal('show');             
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alertify.error("Some Error in save database.");
            }
        });
    }

    function ValidateForScheduleCreation() {
        var flag = true;
        if ($("#installment-balance-amount").val() == "") {
            alertify.error("Enter Balance Amount");
            return flag = false;
        }
        if ($("#Frequency").data("kendoDropDownList").value() == "") {
            alertify.error("Enter select frequency type");
            return flag = false;
        }
        if ($("#installment-total-installment").val() == "") {
            alertify.error("Enter enter total installment");
            return flag = false;
        }
        if ($("#installment-start-date").val() == "") {
            alertify.error("Enter select installment start date");
            return flag = false;
        }
        if ($("#installment-normal-interest").val() == "") {
            alertify.error("Enter enter normal interest");
            return flag = false;
        }
        if ($("#installment-penal-interest").val() == "") {
            alertify.error("Enter enter normal interest");
            return flag = false;
        }
    }



    function ValidateScheduleTransInput() {
        if ($('#RegistrationId').val() == "") {
            alertify.error("Please select Registration Id");
            return false;
        }
        if ($('#txtInstallmentAmount').val() == "") {
            alertify.error("Please enter installment amount.");
            return false;
        }
        if ($('#txtInstallmentInterest').val() == "") {
            alertify.error("Please enter interest amount.");
            return false;
        }
        if ($('#kendoInstallmentDueDate').val() == "") {
            alertify.error("Please select due date.");
            return false;
        }
        else {
            SaveInstallmentScheduleTans();
        }
    }

    function SaveInstallmentScheduleTans() {
        var isntallment = {
            RegistrationId: $('#hdn-registration-id').val(),
            InstallmentAmount: $('#txtInstallmentAmount').val(),
            InstallmentInterest: $('#txtInstallmentInterest').val(),
            BalanceAmount: $('#txtBalanceAmount').val(),
            InstallmentDueDate: $('#kendoInstallmentDueDate').val(),
            ScheduleType: $('#DDLScheduleType').val(),
        };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: isntallment }),
            url: "/Revenue/Payment/SaveInstallmentScheduleTransByDate",
            success: function (result) {
                if (result == '@ReturnType.Updated') {
                    $(".installment-popup-window").data("kendoWindow").close();
                    alertify.success("Record has been updated successfully.");
                    $('#InstallmentScheduleGrid').data('kendoGrid').dataSource.read();
                    //ClearScheduleTransFields();
                }
                else if (result == '@ReturnType.None') {
                    alertify.error("Provider failed to update records, try again.");
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
            }
        })
    }


</script>