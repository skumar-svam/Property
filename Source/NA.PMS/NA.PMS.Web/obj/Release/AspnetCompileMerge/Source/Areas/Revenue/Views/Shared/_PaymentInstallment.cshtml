@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@using NA.PMS.Common;
@using NA.PMS.Model
@model NA.PMS.Model.PaymentViewModel

<style>
    #div-GridDuesCalculationHistory{
        display:none;
    }
</style>

<h2 class="blck-heading" style="margin-bottom:15px;">Installment Detail</h2>
<div class="form-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
    <div>

    </div>
    <div class="row">
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label>Balance Amount</label>
            @(Html.Kendo().NumericTextBoxFor(m => m.BalanceAmount).Name("installment-balance-amount")
                    .Min(0).Max(9999999999999999)
                    .Spinners(false).Step(0).Enable(true)
                    .HtmlAttributes(new { style = "width: 95%;", @maxlength = "13", @class = "text-right" })
            )
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label>Total No of Installment</label>
            @(Html.Kendo().NumericTextBoxFor(m => m.TotalInstallment).Name("installment-total-installment")
                    .Min(0).Max(99)
                    .Spinners(false).Step(0).Enable(true)
                    .HtmlAttributes(new { style = "width: 95%;", @maxlength = "13", @class = "text-right" })
            )
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <label>Frequency Of Installment</label>
            @(Html.Kendo().DropDownListFor(m => m.Frequency)
                .DataTextField("Text")
                .DataValueField("Id")
                .OptionLabel("---Select---")
                .Filter("contains")
                .DataSource(source => source.Read(read => read.Action("GetPaymentFrequencyList", "ManagePayment", new { Area = "Property" })))
                .HtmlAttributes(new { style = "width:90%; float:right; readonly " })
                .Events(e => e.Change("FrequencyChangeEvent"))
            )
            @Html.ValidationMessageFor(model => model.Frequency, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label>Installment Start Date</label>
            @(Html.Kendo().DatePickerFor(model => model.InstallmentStartDate).HtmlAttributes(new {@id="installment-start-date", style = "width:95%;float:right;" }))
        </div>

    </div>
    <div class="row">
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label>Normal Interest(%)</label>
            @(Html.Kendo().NumericTextBoxFor(m => m.NormalInterest).Name("installment-normal-interest")
                    .Min(0).Max(99)
                    .Spinners(false).Step(0).Enable(true)
                    .HtmlAttributes(new { style = "width: 95%;", @maxlength = "13", @class = "text-right" })
            )
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label>Penal Interest(%)</label>
            @(Html.Kendo().NumericTextBoxFor(m => m.PenalInterest).Name("installment-penal-interest")
                    .Min(0).Max(99)
                    .Spinners(false).Step(0).Enable(true)
                    .HtmlAttributes(new { style = "width: 95%;", @maxlength = "13", @class = "text-right" })
            )
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label>Interest On Installment</label>
            @(Html.Kendo().NumericTextBoxFor(m => m.InterestAmount).Name("installment-interest-amount")
                    .Min(0).Max(99999999999999)
                    .Spinners(false).Step(0).Enable(true)
                    .HtmlAttributes(new { style = "width: 95%;", @maxlength = "13", @class = "text-right" })
            )
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label title="Installment + Interest on Installment">Total Payable Amount</label>
            @(Html.Kendo().NumericTextBoxFor(m => m.TotalPayableAmount).Name("installment-payable-amount")
                    .Min(0).Max(99999999999999)
                    .Spinners(false).Step(0).Enable(true)
                    .HtmlAttributes(new { style = "width: 95%;", @maxlength = "13", @class = "text-right" })
            )
        </div>
    </div>
    <div class="row">
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label>Schedule Type</label>
            @(Html.Kendo().DropDownListFor(model => model.ScheduleType)
            .Name("DDLScheduleType")
            .DataTextField("Text")
            .DataValueField("Value")
            .OptionLabel("---Select---")
            .Filter("contains")
            .DataSource(source =>
            {
                source.Custom()
                .ServerPaging(true)
                .ServerFiltering(true)
                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                .Transport(transport => transport.Read(read => read.Action("GetInstallmentScheduleTypeAsDataSource", "Payment", new { Area = "Revenue" }).Data("FilterRegistrationId")))
                .Schema(schema => schema.Data("Data").Total("Total"))
                .PageSize(100);
            })
                    //.CascadeFrom("RegistrationId")
            .HtmlAttributes(new { style = "width:95%;float:right;" })
            .Events(m => m.Change("ScheduleTypeChangeEvent"))
            )
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label>Dues Upto Date</label>
            @*<input id="hdnCalDueDateTime" value="@DateTime.Now" title="datepicker" style="width:95%; float:right;"/>*@
            @(Html.Kendo().DatePickerFor(model => model.InstallmentDuesUptoDate).Value(DateTime.Now).Name("installment-duesupto-date").HtmlAttributes(new { style="width:95%;float:right;"}))
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
           
        </div>
    </div>
    <div class="row">
        <div class="col-md-12" style="text-align:right;">
            @*<input type="button" class="btn btn-success" id="btnCalDuebyDate" value="Calculate Dues" style="" />*@
            <input type="button" class="btn btn-default" onclick="javascript:OpenUpdateWindow()" value="Update Installment" />
            <input type="button" class="btn btn-default btn-installment-demand" value="Generate Demand" />
            <input type="button" class="btn btn-default btn-nda-calculation" value="NDA Calculation" />
            <input type="button" class="btn btn-default btn-open-window" value="Payment Schedule Of Installment" />
            <input type="button" class="btn btn-default btn-calculate-installment-dues" value="Calculation Of Installment" />
        </div>
    </div>
</div>

<h2 class="blck-heading" style="margin-bottom:0;">Installment Schedule</h2>
