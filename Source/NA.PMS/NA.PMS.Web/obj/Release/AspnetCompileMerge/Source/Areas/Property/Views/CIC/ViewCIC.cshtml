@model NA.PMS.Model.CICModel
@using Kendo.Mvc.UI;
@{
    ViewBag.Title = "ViewCIC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="row">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">View CIC</h1></div>           
                <div class="col-md-6 col-sm-6 col-xs-12 col-btn" id="divComment">
                    @Html.HiddenFor(m => m.Id)
                    @Html.HiddenFor(m => m.Change_Type, new { @id = "TypeID" })
                    @Html.HiddenFor(m=>m.ReqRefNo)
                    <input type="hidden" value="@Model.Status" id="hdnStatusID" />
                    @if (Model.Status == @NA.PMS.Common.Constants.Approved)
                    {
                        <i style="font-size: 18px; " class=" glyphicon glyphicon-ok-sign" aria-hidden="true"></i>
                        <strong style="color: lightgreen;font-size: 18px; padding-right: 10px; ">  @Html.DisplayFor(model => model.StatusName)</strong>
                    }
                    else if (Model.Status == @NA.PMS.Common.Constants.RejectedProp)
                    {
                        <strong style="color: red;font-size: 16px; padding-right: 10px; "><i class="glyphicon glyphicon-remove-sign" aria-hidden="true"></i>  @Html.DisplayFor(model => model.StatusName)</strong>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
                <h2 class="blck-heading">Allottee Information</h2>
                <div class="form-bx">
                    @Html.HiddenFor(m => m.Rid, htmlAttributes: new { id = "hdnRid" })
                    @{
                        Html.RenderPartial("_AloteeBasicDetails", Model);
                    }
                </div>
                <h2 class="blck-heading">CIC Details</h2>
                @*<div class="form-bx">
                        @{
                            Html.RenderPartial("_CICMain", Model);
                        }
                    </div>*@
                <div class="">
                    @{
                        Html.RenderPartial("_AddViewCICRequest", Model);
                    }
                </div>
            </div>

            <div class="box-button text-center">
                <button type="button" value="btnBack" class="btn btn-default" onclick="javascript: window.location = '@Url.Action("ManageCIC", "CIC")';">Back</button>

                @if (Model.Status == @NA.PMS.Common.Constants.Approved)
                {
                    <button type="button" class="btn btn-default" value="Submit" id="btnGenerateCICLetter">Generate CIC Letter</button>
                }
                else if (Model.Status == @NA.PMS.Common.Constants.RejectedProp || Model.Status == @NA.PMS.Common.Constants.Cancelled)
                {
                    <button type="button" class="btn btn-default" value="Submit" id="btnReSubmit">Re-Submit for Approval</button>
                }
                else if (Model.Status == @NA.PMS.Common.Constants.InProgress)
                {
                    <button type="button" class="btn btn-default" value="Submit" id="btnCancelRequest">Cancel Request</button>
                }
            </div>
        </div>
    </div>
</div>





<div id='divAssineRequetApproval' class='col-md-12 adminfeediv'>
    <div class="row" style="margin-top:12px;">
        <div class="col-md-3 form-group">
            @Html.Label("Assign To:")
        </div>
        <div class="col-md-6 form-group">         
            @(Html.Kendo().DropDownListFor(model => model.User)
                .DataTextField("text")
                .DataValueField("id")
                .Filter("contains")
                .OptionLabel("---Select---")
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetAssineTo", "Allotment");
                    });
                })
                .HtmlAttributes(new { style="width:100%;"})
            )
            @Html.ValidationMessageFor(model => model.User)
        </div>
    </div>
    <div class="row" style="padding-top:30px;">
        <div class="col-md-3 form-group"></div>
        <div class="col-md-8 form-group">
            <button type='submit' id="btnRequetForApproval" class='btn btn-default' value='Save'>Submit</button>
            <button type='button' class='btn btn-default' value='Cancel' onclick="CloseCommnetPopUpForApproval();">Close</button>
        </div>
    </div>
</div>

<div id="divPrintChallan" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 60%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>CIC Letter</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:400px;">
                <div id="divChallanBody"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv();">Print</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    function additionalInfo() {
        return { rid: $('#Rid').val() }
    }

    $(document).ready(function () {
        //var grid = $("#gridCIC").data("kendoGrid");
        //grid.hideColumn(1);
        $("#gridCIC").find("table tr:eq(1)").hide();
        var cType=$('#Change_Type').val();
        //$("#Rid").data("kendoDropDownList").enable(false);
        GetPropertyDetails();
        HideShowSection(cType);
        $("#btnCancelRequest").click(function () {
            CancelRequest();
        });
        $("#divAssineRequetApproval").kendoWindow({
            modal: true,
            title: "Assign Request to Approver",
            visible: false,
            width: "40%"
        });
        $("#btnReSubmit").click(function () {
            if(ValidateCIC())
                OpenAssineRequetApprovalPopUp();
        });
        $('#btnAdd').click(function(){
            if((ValidateDirectors()))
                SaveCIC();
        });
        $("#btnRequetForApproval").click(function (){
            ReSubmitForApproval();
        });
        $("#btnGenerateCICLetter").click(function () {
            GenerateCICLetter();
        });
        //$('#CIC_Charge').val("");

        if(($('#hdnStatusID').val()==@NA.PMS.Common.Constants.Approved))
        {
            $("#Type").data("kendoDropDownList").enable(false);
            $("#Director_Name").attr('disabled','disabled');
            $("#Director_Share").attr('disabled','disabled');
            $("#CIC_Charge").attr('disabled','disabled');
            $("#btnAdd").attr('disabled', 'disabled');
            $("#Share_Type").data("kendoDropDownList").enable(false);
            $('[id=ReqRefNo]').slice(1).prop("disabled", true);
        }
        $("#txtShareType").hide();
    });

    function HideShowSection(cType)
    {
        if((cType==@NA.PMS.Common.Constants.ChangeInDirector))
        {
            $('#changeInDirector').show();
            $('#changeInFirmName').hide();
            $('#changeInProduct').hide();
            $("#Change_Type").data("kendoDropDownList").enable(false);
            $("#gridCIC").data("kendoGrid").dataSource.read();
            if(($('#hdnStatusID').val()==@NA.PMS.Common.Constants.InProgress))
            {
                //$("#Change_Type").data("kendoDropDownList").enable(false);
                $("#Type").data("kendoDropDownList").enable(false);
                $("#Director_Name").attr('disabled','disabled');
                $("#Director_Share").attr('disabled','disabled');
                $("#CIC_Charge").attr('disabled','disabled');
                $("#btnAdd").attr('disabled', 'disabled');
                $("#Share_Type").data("kendoDropDownList").enable(false);
                $('[id=ReqRefNo]').slice(1).prop("disabled", true);
            }
            else if(($('#hdnStatusID').val()==@NA.PMS.Common.Constants.RejectedProp))
            {
                //$("#Change_Type").data("kendoDropDownList").enable(true);
                $("#Type").data("kendoDropDownList").enable(true);
                $("#Director_Name").removeAttr('disabled');
                $("#Director_Share").removeAttr('disabled');
                $("#CIC_Charge").removeAttr('disabled');
                $("#btnAdd").removeAttr('disabled');
                $("#Share_Type").data("kendoDropDownList").enable(true);
                $('[id=ReqRefNo]').slice(1).prop("disabled", false);

                var grid = $("#gridCIC").data("kendoGrid");
                grid.bind("dataBound", function () {
                    var _shareType = '';

                    var data = grid.dataSource._data;
                    var count = (data.length);

                    if (count > 0) {

                        $.each(data, function (p, row) {
                            if (row.Share_Type != '') {
                                _shareType = (row.Share_Type);
                                return false;
                            }
                        });

                        $("#ddShareType").hide();
                        $("#txtShareType").show();
                        _shareType= (_shareType != "" && _shareType != null ? (_shareType) : ('@NA.PMS.Common.CICDirectorShareType.Percentage'));
                        $("#txtShare").val(_shareType);
                        $("#Share_Type").data("kendoDropDownList").value(_shareType);

                        return false;
                    } else {
                        $("#ddShareType").show();
                        $("#txtShareType").hide();
                        $("#txtShare").val('');
                    }
                });
            }
        }
        else if((cType==@NA.PMS.Common.Constants.ChangeInFirmName))
        {
            $('#changeInDirector').hide();
            $('#changeInFirmName').show();
            $('#changeInProduct').hide();
            $("#Change_Type").data("kendoDropDownList").enable(false);
            if(($('#hdnStatusID').val()==@NA.PMS.Common.Constants.InProgress))
            {
                $("#Change_Type").data("kendoDropDownList").enable(false);
                $("#NewFirmStatus").data("kendoDropDownList").enable(false);
                $("#NewFirmName").attr('disabled','disabled');
                $("#CIC_Charge").attr('disabled','disabled');
                $("#btnAdd").attr('disabled','disabled');
            }
            else if(($('#hdnStatusID').val()==@NA.PMS.Common.Constants.RejectedProp))
            {
                $("#Change_Type").data("kendoDropDownList").enable(true);
                $("#NewFirmStatus").data("kendoDropDownList").enable(true);
                $("#NewFirmName").removeAttr('disabled');
                $("#CIC_Charge").removeAttr('disabled');
                $("#btnAdd").removeAttr('disabled');
            }
        }
        else if((cType==@NA.PMS.Common.Constants.ChangeInProduct))
        {
            $('#changeInDirector').hide();
            $('#changeInFirmName').hide();
            $('#changeInProduct').show();
            if(($('#hdnStatusID').val()==@NA.PMS.Common.Constants.InProgress))
            {
                $("#Change_Type").data("kendoDropDownList").enable(false);
                $("#NewFirmProduct").attr('disabled','disabled');
                $("#CIC_Charge").attr('disabled','disabled');
                $("#btnAdd").attr('disabled','disabled');
            }
            else if(($('#hdnStatusID').val()==@NA.PMS.Common.Constants.RejectedProp))
            {
                $("#Change_Type").data("kendoDropDownList").enable(true);
                $("#NewFirmProduct").removeAttr('disabled');
                $("#CIC_Charge").removeAttr('disabled');
                $("#btnAdd").removeAttr('disabled');
            }
        }
    }

    function OpenAssineRequetApprovalPopUp() {
        var win = $("#divAssineRequetApproval").data("kendoWindow");
        win.center();
        win.open();
    }

    function CloseCommnetPopUpForApproval() {
        var win = $("#divAssineRequetApproval").data("kendoWindow");
        win.close();
    }

    function CancelRequest()
    {
        var requestId = $('#Id').val();
        var typeID = $('#TypeID').val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ requestId: requestId,typeID:typeID}),
            url: '/CIC/CancelCICRequest',
            success: function (result) {
                if (result == true) {
                    window.location.href = '@Url.Action("ManageCIC", "CIC")';
                        return false;
                    }
                    else {
                        return true;
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //alert(respText);
                }
            });
        }

        function SaveCIC()
        {
            var directorShare = $('#Director_Share').val();
            var shareType = $('#Share_Type').val();

            if (shareType == '@NA.PMS.Common.CICDirectorShareType.Percentage') {
                var grid = $("#gridCIC").data("kendoGrid");
                var data = grid.dataSource._data;
                if (parseFloat(directorShare) > 100) {
                    alertify.error("Sum of Shares can't exceed 100%");
                    return false;
                }
                var sum = 0.0000;
                $.each(data, function (p, row) {
                    sum = sum + (row.Director_Share);
                });
                sum = parseFloat(sum) + parseFloat(directorShare);

                if (parseFloat(sum).toFixed(4) > 100) {
                    alertify.error("Sum of Shares can't exceed 100%");
                    return false;
                }

                if (parseFloat(sum).toFixed(4) <= 100) {
                    SaveCICMethod(directorShare, shareType)
                } else {
                    alertify.error("Sum of Shares can't exceed 100%.");
                    return false;
                }

            } else if(shareType == '@NA.PMS.Common.CICDirectorShareType.Nos') {
                if (parseFloat(directorShare).toFixed(4) > 0) {
                    SaveCICMethod(directorShare, shareType);
                } else {
                    alertify.error("Director Share should be greater than zero.");
                    return false;
                }
            }
        }

        function SaveCICMethod(directorShare, shareType) {

            var changetype = $('#Change_Type').val();
            var ciccharge = $('#CIC_Charge').val();
            var directorName = $('#Director_Name').val();
            var directorShare = directorShare;
            var type = $('#Type').val();
            var rid = $('#Rid').val();
            var shareType = shareType;

            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ Rid: rid, Director_Share: directorShare, Change_Type: changetype, CIC_Charge: ciccharge, Director_Name: directorName, Type: type, Share_Type: shareType }),
                url: '/CIC/SaveCIC',
                success: function (result) {
                    if (result == true) {
                        $('#Director_Name').val("");
                        $('#Director_Share').val("");
                        $('#hdnCICCharges').val($('#CIC_Charge').val());
                        $('#CIC_Charge').val("");
                        $("#Type").data("kendoDropDownList").value(0);
                        $("#gridCIC").data("kendoGrid").dataSource.read();
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //alert(respText);
                }
            });
        }

        function ReSubmitForApproval()
        {
            var changetype=$('#Change_Type').val();
            //var ciccharge=$('#CIC_Charge').val();
            var ciccharge=$('#hdnCICCharges').val();
            var rid=$('#hdnRid').val();
            //alert(rid);
            var Id=$('#Id').val();
            var reqRef = $('#ReqRefNo').val();
            //var approver=$("#User").data("kendoDropDownList").value();
            var approver=$('#User').val();
            //alert("type:"+changetype+"/charge:"+ciccharge+"/rid:"+rid+"/id:"+Id+"/approver:"+approver);
            if((changetype==@NA.PMS.Common.Constants.ChangeInDirector))
            {
                $.ajax({
                    dataType: 'json',
                    type: 'Post',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({rid:rid,approver:approver, ciccharge:ciccharge, reqRefNo:reqRef }),
                    url: '/CIC/SubmitForDirectors',
                    success: function (result) {
                        if (result == true) {
                            window.location.href = '@Url.Action("ManageCIC", "CIC")';
                            return false;
                        }
                        else {
                            return true;
                        }
                    },
                    error: function (objAjaxRequest, strError) {
                        var respText = objAjaxRequest.responseText;
                        //alert(respText);
                    }
                });
            }
            else if((changetype==@NA.PMS.Common.Constants.ChangeInFirmName))
            {
                var newFirmStatus=$('#NewFirmStatus').val();
                var newFirmName=$('#NewFirmName').val();
                var ciccharge=$('#CIC_Charge').val();
                $.ajax({
                    dataType: 'json',
                    type: 'Post',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({Id:Id, rid:rid,approver:approver, newFirmStatus:newFirmStatus, newFirmName:newFirmName, ciccharge:ciccharge }),
                    url: '/CIC/UpdateForFirmName',
                    success: function (result) {
                        if (result == true) {
                            window.location.href = '@Url.Action("ManageCIC", "CIC")';;
                            return false;
                        }
                        else {
                            return true;
                        }
                    },
                    error: function (objAjaxRequest, strError) {
                        var respText = objAjaxRequest.responseText;
                        //alert(respText);
                    }
                });
            }
            else if((changetype==@NA.PMS.Common.Constants.ChangeInProduct))
            {
                var newFirmProduct=$('#NewFirmProduct').val();
                var ciccharge=$('#CIC_Charge').val();
                $.ajax({
                    dataType: 'json',
                    type: 'Post',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({Id:Id, rid:rid,approver:approver, newFirmProduct:newFirmProduct, ciccharge:ciccharge }),
                    url: '/CIC/UpdateForFirmProduct',
                    success: function (result) {
                        if (result == true) {
                            window.location.href = '@Url.Action("ManageCIC", "CIC")';;
                            return false;
                        }
                        else {
                            return true;
                        }
                    },
                    error: function (objAjaxRequest, strError) {
                        var respText = objAjaxRequest.responseText;
                        //alert(respText);
                    }
                });
            }
        }

        function ValidateCIC()
        {
            var bflag=false;
            var rid=$('#Rid').val();
            var changetype=$('#Change_Type').val();
            var ck_name =  /^[a-zA-Z .-/&]*$/g;
            var CIC_Charge=$('#CIC_Charge').val();

            if(CIC_Charge!="")
            {
                if(!isNaN(CIC_Charge))
                {
                    if (CIC_Charge >= 0 && CIC_Charge <= 9999999999999999) {
                        $('#CIC_Charge').val(parseFloat($('#CIC_Charge').val()).toFixed(2));
                    }
                    else {
                        alertify.error("CIC Charge should be of digits [16,2]");
                        $('#CIC_Charge').Focus();
                        bflag= false;
                    }
                }
                else{
                    alertify.error("Please enter a number in CIC Charge.");
                    bflag= false;
                }
            }
            if((changetype==@NA.PMS.Common.Constants.ChangeInDirector))
            {
                var gridCIC = $("#gridCIC").data("kendoGrid").dataSource.data();
                if(gridCIC.length==0)
                {
                    alertify.error("Please enter atleast one record.");
                    bflag=false;
                }
                else{
                    bflag=true;
                }
            }
            else if((changetype==@NA.PMS.Common.Constants.ChangeInFirmName))
            {
                var newFirmStatus=$('#NewFirmStatus').val();
                var newFirmName=$('#NewFirmName').val().trim();
                if(rid=="")
                {
                    alertify.error("Please select Registration ID");
                    bflag=false;
                }
                else if(changetype=="")
                {
                    alertify.error("Please select Change In Constitution");
                    bflag=false;
                }
                else if(newFirmStatus=="")
                {
                    alertify.error("Please select New Firm Status");
                    bflag=false;
                }
                else if (!ck_name.test(newFirmName)) {
                    alertify.error("Plese enter char in Firm Name.");
                    bflag=false;
                }
                else if(newFirmName=="")
                {
                    alertify.error("Please enter New Firm Name");
                    bflag=false;
                }
                else{
                    bflag=true;
                }
            }
            else if((changetype==@NA.PMS.Common.Constants.ChangeInProduct))
            {
                var newFirmProduct=$('#NewFirmProduct').val().trim();

                if(rid=="")
                {
                    alertify.error("Please select Registration ID");
                    bflag=false;
                }
                else if(changetype=="")
                {
                    alertify.error("Please select Change In Constitution");
                    bflag=false;
                }
                else if(newFirmProduct=="")
                {
                    alertify.error("Please select New Firm Product");
                    bflag=false;
                }
                else if (!ck_name.test(newFirmProduct)) {
                    alertify.error("Plese enter char in New Firm Product.");
                    bflag=false;
                }
                else{
                    bflag=true;
                }
            }
            else{
                bflag=true;
            }
            return bflag;
        }

        function ValidateDirectors()
        {
            var changetype=$('#Change_Type').val();
            var ck_name =  /^[a-zA-Z ]*$/g;
            if((changetype==@NA.PMS.Common.Constants.ChangeInDirector))
            {
                var type=$('#Type').val();
                var directorName=$('#Director_Name').val().trim();
                var director_Share = $('#Director_Share').val().trim();
                var shareType = $('#Share_Type').val();
                var bflag=false;
                if(directorName=="")
                {
                    alertify.error("Please enter Director Name");
                    bflag=false;
                }
                else if (!ck_name.test(directorName)) {
                    alertify.error("Plese enter char in Director Name.");
                    bflag=false;
                }
                else if (shareType == "") {
                    alertify.error("Please select Share Type.");
                    bflag = false;
                }
                else if(director_Share=="")
                {
                    alertify.error("Please enter Director Share");
                    bflag=false;
                }
                else if(isNaN(director_Share))
                {
                    alertify.error("Please enter a number.");
                    bflag=false;
                }
                else if(type=="")
                {
                    alertify.error("Please select Type");
                    bflag=false;
                }
                else {
                    if (director_Share >= 0 && director_Share <= 99999) {
                        $('#Director_Share').val(parseFloat($('#Director_Share').val()).toFixed(4));
                        bflag = true;
                    }
                    else {
                        alertify.error("Share should be of digits [5,4]");
                        $('#Director_Share').focus();
                        bflag = false;
                    }
                }
                return bflag;
            }
        }

        function GenerateCICLetter()
        {
            var Id = $('#Rid').val();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ Id: Id }),
                url: '/CIC/GenerateCICLetter',
                success: function (result) {
                    $("#divChallanBody").html(result);
                    $("#divPrintChallan").modal('show');
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //alert(respText);
                }
            });
        }

        function PrintDiv() {
            var contents = document.getElementById("divChallanBody").innerHTML;
            var frame1 = document.createElement('iframe');
            frame1.name = "frame1";
            frame1.style.position = "absolute";
            frame1.style.top = "-1000000px";
            document.body.appendChild(frame1);
            var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
            frameDoc.document.open();
            frameDoc.document.write('<html><head><title></title>');
            frameDoc.document.write('</head><body>');
            frameDoc.document.write(contents);
            frameDoc.document.write('</body></html>');
            frameDoc.document.close();
            setTimeout(function () {
                window.frames["frame1"].focus();
                window.frames["frame1"].print();
                document.body.removeChild(frame1);
            }, 500);
            return false;
        }

        function RemoveRecord(row) {
            var bflag = false;
            if(($('#hdnStatusID').val()==@NA.PMS.Common.Constants.InProgress) || ($('#hdnStatusID').val()==@NA.PMS.Common.Constants.Approved))
            {
                alertify.error("Record can't removed in view mode");
                bflag = false;
            }
            else{
                if (confirm("Are you sure? You want to remove this record.")) {
                    var tr = $(row).parent().parent();
                    var dirID = $(tr).children("td:eq(4)").text();
                    $.ajax({
                        dataType: 'json',
                        type: 'Post',
                        contentType: 'application/json; charset=utf-8',
                        data: JSON.stringify({ dirID: dirID }),
                        url: '/CIC/RemoveRecord',
                        success: function (result) {
                            if (result == true) {
                                bflag = true;
                                $("#gridCIC").data("kendoGrid").dataSource.read();
                                alertify.success("Record deleted successfully.");
                            }
                            else {
                                bflag = false;
                                alertify.error("Some error occured. Please try again later.");
                            }
                        },
                        error: function (objAjaxRequest, strError) {
                            var respText = objAjaxRequest.responseText;
                            bflag = false;
