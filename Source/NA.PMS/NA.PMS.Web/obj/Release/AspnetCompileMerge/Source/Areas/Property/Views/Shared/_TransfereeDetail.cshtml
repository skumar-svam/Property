@model NA.PMS.Model.TransferViewModel
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;

<div class="row">
    <div class="col-md-3 col-sm-3 col-xs-12 form-group"></div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.RadioButtonFor(model => model.TypeOfTransferee, NA.PMS.Common.Constants.genderIndividual, new { @checked = "checked" }) Individual
        @Html.RadioButtonFor(model => model.TypeOfTransferee, NA.PMS.Common.Constants.genderCompany) Company
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group"></div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group"></div>
</div>
<div class="row">
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.Label("Gender", htmlAttributes: new { @class = "required genderClass" })
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @(Html.Kendo().DropDownListFor(trans => trans.TransfereeGenderId).Filter("contains")
                    .Events(events => { events.Change("GenderChange"); })
                //.Name("frequency")
                    .DataTextField("text")
                    .DataValueField("text")
                    .OptionLabel("Select")
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetIndividualGenders", "Allotment");
                        });
                    })
                    .HtmlAttributes(new { @class = "schemeForms", style = "width:100%" })
        )
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.Label("First Name", new { @class = "lblIndividual required" })
        @Html.Label("Company Name", new { @class = "lblCompany required" })
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.TextBoxFor(trans => trans.TransfereeFirstName, new { @class = "txtIndividual form-control", @maxlength = "490" })
        @Html.TextBoxFor(trans => trans.TransfereeCompanyName, new { @class = "txtCompany form-control", @maxlength = "500" })
    </div>
</div>

<div class="row">
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.Label("Middle Name", new { @class = "lblIndividual" })
        @Html.Label("Authorized Signatory", new { @class = "lblCompany required" })
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.TextBoxFor(trans => trans.TransfereeMiddleName, new { @class = "txtIndividual form-control", @maxlength = "490" })
        @Html.TextBoxFor(trans => trans.TransfereeCompanySigningAuth, new { @class = "txtCompany form-control", @maxlength = "150" })
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.Label("Last Name", new { @class = "lblIndividual required" })
        @Html.Label("Registered Office", new { @class = "lblCompany required" })
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.TextBoxFor(trans => trans.TransfereeLastName, new { @class = "txtIndividual form-control", @maxlength = "490" })
        @Html.TextBoxFor(trans => trans.TransfereeCompanyRegOff, new { @class = "txtCompany form-control", @maxlength = "500" })
    </div>
</div>

<div class="row">
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.Label("Father's/Husband's Name", new { @class = "lblIndividual required" })
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.TextBoxFor(trans => trans.TransfereeRelationName, new { @class = "txtIndividual form-control", @maxlength = "150" })
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.Label("Mother's Name", new { @class = "lblIndividual" })
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.TextBoxFor(trans => trans.TransfereeMotherName, new { @class = "txtIndividual form-control", @maxlength = "150" })
    </div>
</div>

<div class="row">
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.Label("Mobile Number", htmlAttributes: new { @class = "required" })
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.TextBoxFor(trans => trans.TransfereeMobileNo, htmlAttributes: new { @maxlength = "10", onkeypress = "return IsNumeric(event);", @class = "form-control" })
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.Label("Email")
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.TextBoxFor(trans => trans.TransfereeEmail, new { @maxlength = "150", @class = "form-control" })
    </div>
</div>

<div class="row">
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.Label("Correspondence Address", htmlAttributes: new { @class = "required" })
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.TextBoxFor(trans => trans.TransfereeCorrespondenceAdd, new { @maxlength = "500", @class = "form-control" })
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.Label("Permanent Address", new { @class = "lblIndividual required" })
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.TextBoxFor(trans => trans.TransfereePermanentAdd, new { @class = "txtIndividual form-control", @maxlength = "500" })
    </div>
</div>

<div class="row">
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.Label("PAN")
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.TextBoxFor(trans => trans.TransfereePAN, new { @maxlength = "10", @class = "form-control" })
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @Html.Label("Occupation", new { @class = "lblIndividual required" })
    </div>
    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        @(Html.Kendo().DropDownListFor(trans => trans.TransfereeOccupationId).Filter("contains")
                //.Name("frequency")
                    .DataTextField("text")
                    .DataValueField("id")
                    .OptionLabel("Select")
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetOccupation", "Allotment");
                        });
                    })
                    .HtmlAttributes(new { @class = "schemeForms", style = "width:100%" })
        )
        @Html.HiddenFor(trans => trans.BalanceDues)
    </div>
</div>





<script type="text/javascript">
    $(document).ready(function () {
        $(".lblCompany").hide();
        $(".companySpan").hide();
        $(".txtCompany").hide();
        //$("#TransfereeMotherName").val('NA');
        $('input[type=radio][name=TypeOfTransferee]').change(function () {
            var transfereeType = $("input[name='TypeOfTransferee']:checked").val();
            var dropdownlist = $("#TransfereeGenderId").data("kendoDropDownList");
            var dropdownlist1 = $("#TransfereeOccupationId").data("kendoDropDownList");
            if (transfereeType == '@NA.PMS.Common.Constants.genderCompany') {
                $(".genderClass").hide();
                dropdownlist.wrapper.hide();
                $(".lblIndividual").hide();
                $(".individualSpan").hide();
                $(".txtIndividual").hide();
                dropdownlist1.wrapper.hide();
                $(".lblCompany").show();
                $(".companySpan").show();
                $(".txtCompany").show();
                $("#TransfereeGenderId").data("kendoDropDownList").value('');
            }
            else {
                $(".genderClass").show();
                dropdownlist.wrapper.show();
                $(".lblCompany").hide();
                $(".companySpan").hide();
                $(".txtCompany").hide();
                $(".lblIndividual").show();
                $(".individualSpan").show();
                $(".txtIndividual").show();
                dropdownlist1.wrapper.show();
                $("#TransfereeGenderId").data("kendoDropDownList").value('');
            }
        });
    });

    //dropdownlist.wrapper.hide(); // call wrapper.show() to make it visible again
    function GenderChange() {
        var dropdownlist = $("#TransfereeOccupationId").data("kendoDropDownList");
        if ($("#TransfereeGenderId").val() == '@NA.PMS.Common.Gender.Company') {
            $(".lblIndividual").hide();
            $(".individualSpan").hide();
            $(".txtIndividual").hide();
            dropdownlist.wrapper.hide();
            $(".lblCompany").show();
            $(".companySpan").show();
            $(".txtCompany").show();
        }
        else if ($("#TransfereeGenderId").val() == '') {
        }
        else {
            $(".lblCompany").hide();
            $(".companySpan").hide();
            $(".txtCompany").hide();
            $(".lblIndividual").show();
            $(".individualSpan").show();
            $(".txtIndividual").show();
            dropdownlist.wrapper.show();
        }
    }
</script>

