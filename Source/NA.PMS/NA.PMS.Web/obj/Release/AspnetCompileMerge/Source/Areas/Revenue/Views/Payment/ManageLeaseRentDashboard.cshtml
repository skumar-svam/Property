                            //columns.Bound(c => c.RegistrationId).Title("Demand").Width(110).ClientTemplate(" <center><a onclick='javascript:PrintLeaseRentDemandNote(#=RegistrationId#,#=CurrentDues#);'><span class='fa fa-print'></span></a></center> ");
