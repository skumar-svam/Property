    function UpdateTotalCount() {
        var departmentId = $('#DepartmentId').val();
        $.ajax({
            type: "post",
            dataType: "json",
            contentType: "application/json;charset=utf-8",
            data: JSON.stringify({ DepartmentId: departmentId }),
            url: '@Url.Action("GetTotalCountByDepartment", "Payment", new { area = "Revenue" })',
            success: function (data) {
                if (data[0] != null) {
                    result = data[0];
                    $('#lrcount').text("LeaseRent dues : " + result.TotalLeaseRentCount);
                    $('#ipcount').html("Lease Rent and Installment Dues : " + result.TotalIPCount);
                    $("#ndccount").text("Total NDC : " + result.TotalNDCCount);
                    $('#Instcount').text("Installment dues : " + result.TotalInstallmentCount);
                    $('#Propcount').html("Total Property : " + result.TotalPropertyCount);
                    $("#FHPcount").text("Total Farm House Property : " + result.TotalFarmHousePropertyCount);
                    $("#FilenotUpdatecount").text("Not Yet Updated : " + result.TotalFileNotUpdatedCount);
                }
                else {
                    alertify.error("Report is not updated");
                    return false;
                }
            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                alertify.error("Something is wrong, try again later");
            }
        });
    }

    function LeaseRent() {
        var model = { DepartmentId: $("#DepartmentId").val(), ActionType: actionType };
        return model;
    }
</script>


