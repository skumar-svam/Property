<script>
    $(document).ready(function () {
        $('.rowCount').hide();
        $('#grid-head').hide();
        GridHide();
        //$('#installment-dues-grid').css("display", "none");
    });
    var flag1; var flag2; var flag3; var actionType;// = "LeaseRent";
    $('#lrcount').click(function () {
        actionType = "LeaseRent";
        gridShowHide(actionType);
    });
    $('#ipcount').click(function () {
        actionType = "LeaseRent_Premium";
        gridShowHide(actionType);
    });
    $('#ndccount').click(function () {
        actionType = "NDC";
        gridShowHide(actionType);
    });
    $('#Instcount').click(function () {
        actionType = "Installment";
        gridShowHide(actionType);
    });
    $('#Propcount').click(function () {
        actionType = "AllProperty";
        gridShowHide(actionType);
    });
    $('#FHPcount').click(function () {
        actionType = "FHProperty";
        gridShowHide(actionType);
    });
    $('#FilenotUpdatecount').click(function () {
        actionType = "NotYetUpdate";
        gridShowHide(actionType);
    });

    function gridShowHide(actionType) {
        GridHide();
        if (actionType == "LeaseRent") {
            $('#GridLeaseRentDues').data("kendoGrid").dataSource.read();
            $('#GridLeaseRentDues').show();
            $('#grid-head').show();
            $('#grid-head').text("Lease Rent Details");
        }
        if (actionType == "Installment") {
            $('#GridInstallmentDues').data("kendoGrid").dataSource.read();
            $('#GridInstallmentDues').show();
            $('#grid-head').show();
            $('#grid-head').text("Installment Details");
        }
        if (actionType == "NDC") {
            $('#GridNDC').data("kendoGrid").dataSource.read();
            $('#GridNDC').show();
            $('#grid-head').show();
            $('#grid-head').text("NDC Details");
        }
        if (actionType == "LeaseRent_Premium") {
            $('#GridInstallmentAndLeaseDues').data("kendoGrid").dataSource.read();
            $('#GridInstallmentAndLeaseDues').show();
            $('#grid-head').show();
            $('#grid-head').text("Installment And LeaseRent Details");
        }
        if (actionType == "AllProperty") {
            $('#GridAllProperty').data("kendoGrid").dataSource.read();
            $('#GridAllProperty').show();
            $('#grid-head').show();
            $('#grid-head').text("All Property Details");
        }
        if (actionType == "FHProperty") {
            $('#GridFHProperty').data("kendoGrid").dataSource.read();
            $('#GridFHProperty').show();
            $('#grid-head').show();
            $('#grid-head').text("Farm House Details");
        }
        if (actionType == "NotYetUpdate") {
            $('#GridNotYetUpdateProperty').data("kendoGrid").dataSource.read();
            $('#GridNotYetUpdateProperty').show();
            $('#grid-head').show();
            $('#grid-head').text("Not Validated Property Details");
        }

    }

    function GridHide() {
        $('#GridLeaseRentDues').hide();
        $('#GridInstallmentDues').hide();
        $('#GridNDC').hide();
        $('#GridInstallmentAndLeaseDues').hide();
        $('#GridNotYetUpdateProperty').hide();
        $('#GridFHProperty').hide();
        $('#GridAllProperty').hide();
    }

