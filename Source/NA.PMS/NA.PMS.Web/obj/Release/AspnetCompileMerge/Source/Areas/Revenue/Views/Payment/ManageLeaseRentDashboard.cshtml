@{
    ViewBag.Title = "ManageLeaseRentDashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /*.dashbrd-btn{
        color:#00ff90;
    }*/
    .dashboard_link {
        background-color: #299a8b;
        /*width: 250px;*/
