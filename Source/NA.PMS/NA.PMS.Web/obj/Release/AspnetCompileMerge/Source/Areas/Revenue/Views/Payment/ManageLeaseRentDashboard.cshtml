<div class="DashboardForDues">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Lease Rent</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">

            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 content-top-spce">
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <div class="form-bx">
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <label>Department</label>
                        @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                            .Filter("contains")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel(" --- select ---")
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => transport.Read(read => read.Action("GetUsersDepartmentListAsDataSource", "ServiceRequest", new { area = "Member" })))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(7);
                            })
                            .Events(events => { events.Change("ChangeDeptEvent"); })
                            .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                        )
                    </div>

                    @*<div class="col-md-3 col-sm-3 col-xs-12 form-group" style="text-align:right;">
                            <label>Dues Upto Date</label>
                            @(Html.Kendo().DatePicker().Name("DPCurrentDuesDate")
                            .Value(DateTime.Now)
                            .HtmlAttributes(new { @class = "input-disabled", style = "width:90%;" }))
                        </div>*@
                </div>

                <div class="row rowCount">
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
