@model NA.PMS.Model.CostModel
@using Kendo.Mvc.UI
@{
    ViewBag.Title = "CostPartial";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row">
    <div class="col-md-6">
        @Html.Label("Department")
        @(Html.Kendo().DropDownListFor(model => model.depttID)
        .DataValueField("id")
        .DataTextField("text").OptionLabel("Please Select").Events(e => e.Change("DepttChange"))
        .DataSource(source => source.Read(read => read.Action("GetAllDepartments", "Scheme")))
        )
    </div>
    <div class="col-md-6">
        @Html.Label("Property Type")
        @(Html.Kendo().DropDownListFor(model => model.propType)
        .DataValueField("id")
        .DataTextField("text").OptionLabel("Please Select")
        .DataSource(source => source.Read(read => read.Action("GetPropTypes", "Scheme")))
        )
    </div>
</div>
<br />
<div class="row">
    <div class="col-md-6">
        @Html.Label("Sector")
        @(Html.Kendo().DropDownListFor(model => model.sector)
        .DataValueField("id")
        .DataTextField("text").OptionLabel("Please Select")
        .DataSource(source => source.Read(read => read.Action("GetSectorsByPropType", "Scheme").Data("AdditionalData")))
        .CascadeFrom("propType").AutoBind(false).Enable(false)
        )
    </div>
    <div class="col-md-6">
        @Html.Label("Floor", new { @id = "lblFloor" })
        @(Html.Kendo().DropDownListFor(model => model.floor)
                .DataValueField("id")
                .DataTextField("text").OptionLabel("Please Select")
        .DataSource(source => source.Read(read => read.Action("GetFloors", "Scheme")))
        )
    </div>
</div>
<br />
<div class="row">
    <div class="col-md-6">
        @Html.Label("Property Cost", new { @id = "lblPropCost" })
        @Html.TextBoxFor(m => m.propCost)
    </div>
    <div class="col-md-6">
        @Html.Label("Land Rate (/sq. mtr.)")
        @Html.TextBoxFor(m => m.landRate)
        @Html.Label("Civil Cost", new { @id = "lblCivilCost" })
        @Html.TextBoxFor(m => m.civilCost)
    </div>
</div>
<br />
<div class="row">
    <div class="col-md-6">
        @Html.Label("Total Property Cost", new { @id = "lblTotalPropCost" })
        @Html.TextBoxFor(m => m.totPropCost)
    </div>
    <div class="col-md-6">
        @Html.Label("Allotment Money", new { @id = "lblPropCost" })
        @Html.TextBoxFor(m => m.allotmentMoney)
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        @Html.Label("Lease Rent (Yearly)", new { @id = "lblLeaseRent" })
        @Html.TextBoxFor(m => m.leaseRent)
    </div>
    <div class="col-md-6">

    </div>
</div>
<br />
<div class="row">
    <div class="col-md-9"></div>
    <div class="col-md-3">
        <input type="button" id="btnAddNew" value="Add" />
    </div>
</div>
<br />
<div class="k-grid-content">
    @(Html.Kendo().Grid<NA.PMS.Model.CostModel>()
                .Name("grdCosts")
        .Columns(columns =>
        {
            //columns.Bound(c => c.id).Width(30).Title("ID").Hidden(true);
            columns.Bound(c => c.depttName).Width(100).Title("Department");
            columns.Bound(c => c.depttID).Hidden(true);
            columns.Bound(c => c.propName).Width(100).Title("Property Type");
            columns.Bound(c => c.propType).Hidden(true);
            columns.Bound(c => c.sectorName).Width(100).Title("Sector");
            columns.Bound(c => c.sector).Hidden(true);
            columns.Bound(c => c.floorName).Width(100).Title("Floor");
            columns.Bound(c => c.floor).Hidden(true);
            columns.Bound(c => c.propCost).Width(100).Title("Total Property Cost");
            columns.Bound(c => c.allotmentMoney).Width(100).Title("Allotment Money");
            columns.Bound(c => c.leaseRent).Width(100).Title("Lease Rent");
            columns.Bound(c => c.civilCost).Width(100).Title("Civil Cost");
        })
        .Sortable()
        .Filterable()
            //.ToolBar(toolBar =>
            //{
            //    toolBar.Custom().Text("<i class='fa fa-plus-square' aria-hidden='true'></i> Add Notification").HtmlAttributes(new { onclick = "javascript:AddNotification(event);", @class = "k-button", id = "AddNotification" });
            //})
        .Pageable(pageable => pageable
                                               .Enabled(true)
            //.Refresh(true)
                                               .PageSizes(true)
                                            )
        .DataSource(dataSource => dataSource
            .Ajax().Model(model => model.Id(p => p.depttID))
             .ServerOperation(true)
                     .Read(read => read.Action("GetAllCosts", "Scheme")).PageSize(20)
        )
    )
</div>
<input type="button" value="Save" id="btnSave" />
