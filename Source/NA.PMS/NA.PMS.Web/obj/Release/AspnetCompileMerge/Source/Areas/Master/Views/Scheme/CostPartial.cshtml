<script type="text/javascript">
    $(document).ready(function () {
        //$("#lblFloor").hide();
        //$("#floor").hide();
        //$("#lblPropCost").hide();
        //$("#propCost").hide();
        //$("#lblCivilCost").hide();
        //$("#civilCost").hide();
        //$("#lblTotalPropCost").hide();
        //$("#totPropCost").hide();
        //$("#lblLeaseRent").hide();
        //$("#leaseRent").hide();
        //$("#btnSaveWorklog").click(function () {

        //    $("#addCosts").data("kendoWindow").close();
        //});

        $("#btnAddNew").click(function () {
            //var addWindow = $("#addCosts").data("kendoWindow");
            //addWindow.title("Add Worklog");
            //$("#addCosts").data("kendoWindow").center();
            //$("#addCosts").data("kendoWindow").open();
            if ($("#depttID").val() == '' || $("#depttID").val() == 0 || $("#depttID").val() == null) {
                alert("Please select a Department");
                return false;
            }
            else if ($("#propType").val() == '' || $("#propType").val() == 0 || $("#propType").val() == null) {
                alert("Please select a Property Type");
                return false;
            }
            else if ($("#sector").val() == '' || $("#sector").val() == 0 || $("#sector").val() == null) {
                alert("Please select a Sector");
                return false;
            }
            else if ($("#floor").val() == '' || $("#floor").val() == 0 || $("#floor").val() == null) {
                alert("Please select a Floor");
                return false;
            }
            else if ($("#propCost").val() == '' || $("#propCost").val() == null) {
                alert("Please enter Total Property Cost");
                return false;
            }
            else if ($("#civilCost").val() == '' || $("#civilCost").val() == null) {
                alert("Please enter Civil Cost");
                return false;
            }
            else if ($("#allotmentMoney").val() == '' || $("#allotmentMoney").val() == null) {
                alert("Please enter Allotment Money");
                return false;
            }
            else if ($("#leaseRent").val() == '' || $("#leaseRent").val() == null) {
                alert("Please enter Lease Rent (Yearly)");
                return false;
            }
            var grid = $("#grdCosts").data("kendoGrid");
            var gridData = grid.dataSource.data();
            var datasource = grid.dataSource;
            datasource.insert({
                depttName: $("#depttID").data("kendoDropDownList").text(),
                depttID: $("#depttID").val(),
                propName: $("#propType").data("kendoDropDownList").text(),
                propType: $("#propType").val(),
                sectorName: $("#sector").data("kendoDropDownList").text(),
                sector: $("#sector").val(),
                floorName: $("#floor").data("kendoDropDownList").text(),
                floor: $("#floor").val(),
                propCost: $("#propCost").val(),
                allotmentMoney: $("#allotmentMoney").val(),
                leaseRent: $("#leaseRent").val(),
                civilCost: $("#civilCost").val()
            });
            $("#depttID").data("kendoDropDownList").value("");
            $("#propType").data("kendoDropDownList").value("");
            $("#sector").data("kendoDropDownList").value("");
            $("#floor").data("kendoDropDownList").value("");
            $("#propCost").val("");
            $("#allotmentMoney").val("");
            $("#leaseRent").val("");
            $("#civilCost").val("");
        });

        $("#btnSave").click(function () {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ lst: $("#grdCosts").data("kendoGrid").dataSource._data }),
                url: "/Scheme/Save",
                success: function (data) {
                    alert();
                }

            });
        });
    });

    function AdditionalData() {
        return {
            propType: $("#propType").val()
        };
    }

    function DepttChange() {
        var deptt = $("#ddlDeptt").val();
        if (deptt == 5) {

        }
    }
</script>

