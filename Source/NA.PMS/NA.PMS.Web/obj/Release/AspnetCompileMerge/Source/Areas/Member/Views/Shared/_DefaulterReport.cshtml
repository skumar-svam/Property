@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@using NA.PMS.Common;

<style>
    /*.k-header k-grid-toolbar k-grid-top {
        border-top: 1px solid black;
    }*/
    .k-header{
        border-color:black;
    }
</style>

<div class="ManageDefaulterList">
    <div class="col-md-12 content-top-spce">
        <div class="inr-bx" style="">
            <div class="form-bx">
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <label>Department</label>
                        @(Html.Kendo().DropDownList()//(m => m.DepartmentId)
                            .Name("lbDepartmentId")
                            .Filter("contains")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel(" --- select ---")
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => transport.Read(read => read.Action("GetUsersDepartmentListAsDataSource", "ServiceRequest", new { area = "Member" })))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(7);
                                
                            })
                            .Events(events => { events.Change("ChangeMonth"); })
                            .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                        )
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group" style="text-align:right;">
                        <label>Month</label>
                        @(Html.Kendo().DatePicker()
                          .Name("lbMonth")
                          .Start(CalendarView.Year)
                          .Depth(CalendarView.Year)
                          .Format("MMMM yyyy")
                          .Value(DateTime.Now)
                                //.Min(DateTime.Now)
                          .HtmlAttributes(new { style = "width: 90%; float:right;", onkeydown = "return false;" })
                          .Events(e => e.Change("ChangeMonth"))
                        )
                    </div>
                </div>
            </div>

            <h2 id="grid-head" class="blck-heading" style="margin-bottom: 0px;">Defaulter List</h2>
            <div class="col-md-12 k-grid-content">
                @*id="leaserent-dues-grid"*@
                @(Html.Kendo().Grid<NA.PMS.Model.DefaulterViewModel>()
                        .Name("GridDefaulterList")
                                .Excel(excel => excel.AllPages(true).Filterable(true).FileName("DefaulterList.xlsx"))
                                .ToolBar(toolsExcel => toolsExcel.Excel())//.HtmlAttributes(new { style = "border-top:1px solid black" })
                        .Columns(columns =>
                        {
                            columns.Bound(c => c.Id).Hidden(true);
                            columns.Bound(c => c.RegistrationId).Title("Registration Id").ClientTemplate("<a href='" + "/Property/PropertyAllotment/PropertyDetails/#= RegistrationId #'>#= RegistrationId #</a>").Filterable(true).ClientFooterTemplate("Total:");
                            columns.Bound(c => c.PropertyNo).Title("Property No");
                            columns.Bound(c => c.AllotmentDate).Title("Date of Allotment").Format("{0:dd-MMM-yyyy}");
                            columns.Bound(c => c.AreaRange).Title("Area (in Sqm)");
                            columns.Group(g =>
                            g.Title("Leaserent Dues Amount")
                            .Columns(info =>
                            {
                                //info.Bound(c => c.LeaserentDuesAmount).Title("Leaserent (<span class='fa fa-rupee'></span>)");
                                //info.Bound(c => c.LeaserentInterestAmount).Title("Interest (<span class='fa fa-rupee'></span>)");
                                info.Bound(c => c.TotalLeaserentDues).Title("Total Dues (<span class='fa fa-rupee'></span>)").HtmlAttributes(new { style = "color:coral;" }).ClientFooterTemplate("#=sum#");
                                info.Bound(c => c.LeaserentPaidUpto).Title("Paid Upto");
                            })
                        );
                            columns.Group(g =>
                            g.Title("Installment Dues Amount")
                            .Columns(inf =>
                            {
                                inf.Bound(c => c.TotalInstallmentDues).Title("Total Dues (<span class='fa fa-rupee'></span>)").HtmlAttributes(new { style = "color:coral;" }).ClientFooterTemplate("#=sum#");
                                inf.Bound(c => c.InstallmentNumber).Title("Number of Installment Defaulted");
                                inf.Bound(c => c.InstallmentPaidUpto).Title("Paid Upto");
                            })
                        );
                            columns.Bound(c => c.TotalDues).Title("Total (<span class='fa fa-rupee'></span>)").ClientFooterTemplate("#=sum#").HtmlAttributes(new { style = "color:coral;" });
                            columns.Bound(c => c.CalculationDate).Title("Calculated Upto").Format("{0:dd-MMM-yyyy}");
                        })
                        .Sortable().Filterable().Resizable(resize => resize.Columns(true))
                        .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                        .DataSource(dataSource => dataSource
                            .Ajax().ServerOperation(true)
                            .Read(read => read.Action("GetDefaulterList", "Payment", new { area = "Revenue" }).Data("DefaulterParam")).PageSize(10)
                            .Aggregates(aggregates =>
                                {
                                    aggregates.Add(p => p.TotalDues).Sum();
                                    aggregates.Add(p => p.TotalInstallmentDues).Sum();
                                    aggregates.Add(p => p.TotalLeaserentDues).Sum();
                                })
                            .Sort(s => s.Add(r => r.TotalDues).Descending())
                         )
                )
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

    });

    //function DeptChange() {
    // $('#GridDefaulterList').data("kendoGrid").dataSource.read();
    //}

    function ChangeMonth() {
        $('#GridDefaulterList').data("kendoGrid").dataSource.read();
    }

    function DefaulterParam() {
        var month = $('#lbMonth').val();
        var year = null;
        //var d = new Date();
        //var currentYr = d.getFullYear();
        if (year == null) {
            //currentDate = '1 ' + month //+ '-' + currentYr
            startDate = '1 ' + month
        }
        else {
            currentDate = '1 ' + month //+ '-' + year
        }
        var deptId = $("#lbDepartmentId").val();
        var model = { DepartmentId: deptId, StartDate: startDate, Month: month };
        return model;
    }
</script>
