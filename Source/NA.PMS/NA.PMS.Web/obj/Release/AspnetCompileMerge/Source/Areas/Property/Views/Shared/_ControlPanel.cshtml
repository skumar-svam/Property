    function GetRid()
    {
        var RID = @Model.AllotmentModel.RID;
        return { RID:RID };
    }

    function HideAll()
    {
        $("#divTransServiceReq").hide();
        $("#divRentServiceReq").hide();
        $("#divCICServiceReq").hide();
        $("#divMortgageServiceReq").hide();
        $("#divExtensionServiceReq").hide();
    }

    function ToJavaScriptDate(value) {
        var pattern = /Date\(([^)]+)\)/;
        var results = pattern.exec(value);
        //return value;
        if (results != null) {
            var dt = new Date(parseFloat(results[1]));
            return (dt.getMonth() + 1) + "/" + dt.getDate() + "/" + dt.getFullYear();
        }
    }
