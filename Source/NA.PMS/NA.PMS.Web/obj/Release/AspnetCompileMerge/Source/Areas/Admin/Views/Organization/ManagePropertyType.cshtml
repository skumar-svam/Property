@using Kendo.Mvc.UI;
@using NA.PMS.Model

@{
    ViewBag.Title = "Manage Property Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/Scripts/kendo.aspnetmvc.min.js"></script>
<style>
    .k-grid-content {
        overflow-y: hidden;
        overflow-x: hidden;
    }
</style>

<div class="ManageAdminRoles">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Property Type</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                <a href="#" id="btnAddRole" class="" onclick="javascript:AddApplication(event);">Add Property Type</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>

    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.UserManagement.NDAMasterDataViewModel>()
              .Name("gridApplication")
              .Columns(columns =>
              {
                  columns.Bound(c => c.PropertyTypeId).Title("Type Id").Width(120);
                  columns.Bound(c => c.PropertyType).Title("Property Type");
                  columns.Bound(c => c.Department).Title("Department");
                  columns.Bound(c => c.CreatedDate).Title("Created on").Format("{0:dd-MMM-yyyy}");
                  columns.Bound(c => c.CreatedDate).Title("Modified On").Format("{0:dd-MMM-yyyy}");
                  //columns.Bound(c => c.ApplicationId).Title("Action").ClientTemplate("# if (IsActive == true) {#<a class='gridEdit' href='" + "/SuperAdmin/ManageAdminRoles/EditAdminRole/#= RoleId #'> Edit </a>#} else {#<span class='gridNotEdit'>Edit</span>#} #");
                  columns.Bound(c => c.Id).Title("Status").ClientTemplate("<label class='hyperlink' onclick='javascript:Deactivate(#= PropertyTypeId #);'>#if(IsActive == true){#<span>Deactivate</span>#}else{#<span>Activate</sapn>#}#</label>");
              })
              .Sortable().Filterable().Resizable(resize => resize.Columns(true))
              .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(new[] { 10, 50, 100, 500 }).Info(true).PreviousNext(true).Input(true).Numeric(true).ButtonCount(10))
              .DataSource
              (
                  dataSource => dataSource
                      .Ajax()
                      .Model(model => model.Id(p => p.Id))
                      .ServerOperation(true).Group(g=>g.Add(m=>m.Department))
                      .Read(read => read.Action("GetPropertyTypeListAsDataSource", "Organization", new { area = "Admin" }))
                      .PageSize(10)
              )
        )
       
    </div>
</div>


<div id="window-modal" class="modal fade" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog" style="min-height:250px; min-width:70%;border-radius:0;">
        <div class="modal-content" style="border-radius:0;">
            <div class="modal-body">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                @{Html.RenderPartial("_PartialPropertyType");}
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function Deactivate(appid) {
        $.ajax({
            dataType: 'json',
            contentType: 'application/json; charset=utf-8',
            type: "POST",
            data: JSON.stringify({ ApplicationId: appid, ActionType: "Status", FilterType: "Application" }),
            url: '/Admin/Organization/SaveMasterDataInfoByType',
            success: function (data) {
                $('#gridApplication').data('kendoGrid').dataSource.read();
            },
            error: function (msg) {
                alert("Error Occured-" + msg.responseText);
            }
        });
    }

    function AddApplication(event) {
        event.preventDefault();
        $('#window-modal').modal('show');       
    }
</script>

