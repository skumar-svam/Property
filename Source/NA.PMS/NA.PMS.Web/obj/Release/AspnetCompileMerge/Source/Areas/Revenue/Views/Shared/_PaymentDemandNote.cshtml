@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@using NA.PMS.Common;
@using NA.PMS.Model
@model NA.PMS.Model.PaymentViewModel

<h2 class="blck-heading" style="margin-bottom:15px;">Demand Notes Detail</h2>
<div class="col-md-12" style="border:solid #e2e3e4; border-width:0 1px 1px">
    <div class="row">
        <div class="col-md-2 col-sm-12 col-xs-12 form-group" style="text-align:center;">
            <b>Demand Type</b>
        </div>
        <div class="col-md-3 col-sm-12 col-xs-12 form-group">
            @(Html.Kendo().DropDownList()
                .Name("DDLDemandNoteType")
                .DataTextField("Text")
                .DataValueField("Value")
                .OptionLabel(" --- Select ---")
                .BindTo(new List<SelectListItem>() {
                    new SelectListItem() { Text = "Normal Lease Rent", Value = "LeaseRent" },
                    new SelectListItem() { Text = "One Time Lease Rent", Value = "OneTimeLeaseRent" },
                    new SelectListItem() { Text = "Installment", Value = "Installment" },
                    new SelectListItem() { Text = "Leaserent & Installment", Value = "Leaserent-Installment" },
                    new SelectListItem() { Text = "Compensation", Value = "Compensation" },
                    new SelectListItem() { Text = "Leaserent with Compensation", Value = "Leaserent-Compensation" },
                    new SelectListItem() { Text = "Installment with Compensation", Value = "Installment-Compensation" },
                    new SelectListItem() { Text = "Installment-Leaserent-Compensation", Value = "Installment-Leaserent-Compensation" }
                })
                .HtmlAttributes(new { style = "width: 95%;float:right;" })
            )
        </div>
        <div class="col-md-2 col-sm-12 col-xs-12 form-group" style="text-align:right;">
            <input id="demand-duesdate" value="@DateTime.Now" title="datepicker" style="width:95%;" />
        </div>
        <div class="col-md-2 col-sm-12 col-xs-12 form-group" style="text-align:right;">
            <input type="text" id="service-request-id" class="form-control numeric-box text-right" maxlength="8" , placeholder="request no" style="width:95%;" />
        </div>
        <div class="col-md-2 col-sm-12 col-xs-12 form-group" style="text-align:center;" id="div-btn">
            <input type="button" class="k-button" id="btn-generate-multi-demand" value="Generate Demand" />
        </div>
    </div>
</div>

<div class="col-md-12 k-grid-content">
    @(Html.Kendo().Grid<NA.PMS.Model.PaymentViewModel>()
        .Name("GridDemandNote")
        .Columns(columns =>
        {
            columns.Bound(c => c.Id).Hidden(true);
            //columns.Bound(c => c.RegistrationId).Title("Registration Id").ClientTemplate("<a href='" + "/Property/PropertyAllotment/PropertyDetails/#= RegistrationId #'>#= RegistrationId #</a>").Filterable(true);
            columns.Bound(c => c.CreatedDate).Title("Date").Format("{0:dd-MMM-yyyy}");
            columns.Bound(c => c.InstallmentAmount).Title("Installment");
            columns.Bound(c => c.InstallmentInterest).Title("I Interest");
            columns.Bound(c => c.LeaseRentDues).Title("Leaserent");
            columns.Bound(c => c.LeaseRentInterest).Title("L Interest");
            columns.Bound(c => c.TotalDuesAmount).Title("Dues Amount (<span class='fa fa-rupee'></span>)");        
            columns.Bound(c => c.DemandNoteStatus).Title("Status");
            columns.Bound(c => c.DemandNoteType).Title("Demand Type").Width(140);
            //columns.Bound(c => c.DemandNoteTypeId).Title("Demand Note").Width(140).ClientTemplate(" <center><a onclick='javascript:PrintDemandNote(#=RegistrationId#,#=DuesAmount#);'><span class='fa fa-print'></span></a></center> ");
            //columns.Bound(c => c.DemandNoteTypeId).Title("Print").Width(50).ClientTemplate(" <center><label onclick='javascript:DisplayDemandNote(this)'><span class='fa fa-print hyperlink'></span></label></center> ").Sortable(false).Filterable(false);
            //columns.Bound(c => c.IsActive).Title(" ").Width(50).ClientTemplate("<center><a onclick='javascript:CalculateInstallmentDues(#=RegistrationId#);'><span class='fa fa-refresh'></span></a></center> ").Sortable(false).Filterable(false);
            columns.Bound(c => c.DemandNoteContent).Hidden(true);
        })
        .Filterable().Resizable(resize => resize.Columns(true))
        .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
        //.ClientDetailTemplateId("template").AutoBind(true)
        .DataSource(dataSource => dataSource
                .Ajax().ServerOperation(true)
                .Model(model => model.Id(p => p.Id))
                .Read(read => read.Action("GetDemandNoteListAsDataSource", "Payment", new { area = "Revenue" }).Data("FilterParameter")).PageSize(10)
                .Sort(s => s.Add(c => c.Id).Descending())
            )
    )
</div>

<style>
    /*.modal-content{
        border-radius:0;
    }*/
</style>
<div id="div-multiple-demand-window" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 70%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title"><b>Demand Note</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:400px;">
                <div id="div-multi-demand-content"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btn-print-multi-demand" class="k-button" data-dismiss="modal" onclick="PrintMultipleTypeDemand();">Print</button>
            </div>
        </div>
    </div>
</div>

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<NA.PMS.Model.PaymentViewModel>()
            .Name("grid_#=Id#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.RegistrationId).Hidden(true);
                columns.Bound(c => c.InstallmentAmount).Title("Installment Dues").Width(120);
                columns.Bound(c => c.InstallmentInterest).Title("Installment Interest").Width(120);
                columns.Bound(c => c.LeaseRentDues).Title("Leaserent Dues").Width(130);
                columns.Bound(c => c.LeaseRentInterest).Title("Leaserent Interest").Width(120);
                columns.Bound(c => c.TotalDuesAmount).Title("Total Dues").Width(120);
                //columns.Bound(c => c.InstallmentDuesUptoDate).Title("Dues Upto").Width(120).Format("{0:dd-MMM-yyyy}");
                columns.Bound(c => c.PaymentStatus).Title("Status").Width(100);
                //columns.Bound(c => c.Id).Title("Status").Width(120).ClientTemplate("#if(IsPropertyAllotted==true){#<lable>Allotted</label>#}else{#<label>Not Allotted</label>#}#");
            })
            .DataSource(dataSource => dataSource
                .Ajax().Read(read => read.Action("GetDemandNoteListAsDataSource", "Payment", new { area = "Revenue", Id = "#=Id#" }))
            )
            .ToClientTemplate()
    )
</script>
<script>
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
</script>

<script>
    $(document).ready(function () {
        $("#demand-duesdate").kendoDatePicker();
        
        $('#btn-generate-multi-demand').click(function () {
            //var demandtype = $('input[name=DemandType]:checked', '#div-demand-type').val()
            var demandtype = $('#DDLDemandNoteType').val();
            var duesdate = $('#demand-duesdate').val();
            var requestNo = $('#service-request-id').val().trim();
            if (demandtype == "" || demandtype == undefined) {
                alertify.error("Please select Demand Type");
                return false;
            }
            else if (duesdate == "") {
                alertify.error("Please select Demand till Date");
                return false;
            }
            else if (requestNo == "") {
                alertify.error("Please enter service request no");
                return false;
            }
            else {
                GenerateMultipleTypeDemand();
            }
        });

    });

    function FilterParameter() {
        return {
            ActionType: "DemandNote",
            DepartmentId: $('#DepartmentId').val(),
            DemandNoteTypeId: $('#DemandNoteTypeId').val(),
            StartDate: $('#StartDate').val(),
            EndDate: $('#EndDate').val(),
            RegistrationId: $('#hdn-registration-id').val()
        };
    }


    function GenerateMultipleTypeDemand() {
        //var demandtype = $('input[name=DemandType]:checked', '#div-demand-type').val();
        var demandtype = $('#DDLDemandNoteType').val();
        //var URL = "/Revenue/Finance/PrintLeaseRentDuesDemandNote";
        var URL = "/Revenue/Finance/PrintDemandNote";
        var duesDate = $('#demand-duesdate').val() == "" ? '@DateTime.Now' : $('#demand-duesdate').val();
        //if (demandtype == "LeaseRent" || demandtype == "OneTimeLeaseRent" || demandtype == "Leaserent-Compensation") {
        //    URL = "/Revenue/Finance/PrintLeaseRentDuesDemandNote";
        //}
        if (demandtype == "Installment") {
            URL = "/Revenue/Finance/PrintInstallmentDuesDemandNote";
        }
        //if (demandtype == "Leaserent-Installment" || demandtype == "Compensation") {
        //    URL = "/Revenue/Finance/PrintDemandNote";
        //}
        //var widget = $("#btn-generate-multi-demand").data("k-button");
        //kendo.ui.progress(widget.element, true);
        var demandModel = {
            RegistrationId: $('#hdn-registration-id').val(),
            CurrentDuesDate: duesDate,
            ActionDate: duesDate,
            ServiceRequestId: $('#service-request-id').val().trim(),
            ActionType: demandtype,
            FilterType: demandtype
        };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: demandModel }),
            url: URL,
            success: function (result) {
                //kendo.ui.progress(widget.element, false);
                $("#div-multi-demand-content").html(result);
                $("#div-multiple-demand-window").modal('show');
                $('#GridDemandNote').data('kendoGrid').dataSource.read();
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //kendo.ui.progress(widget.element, false);
                alertify.error("Some Error in save database.");
            }
        });
    }


    function PrintMultipleTypeDemand() {
        var contents = document.getElementById("div-multi-demand-content").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }
</script>