@using NA.PMS.Common;
@using Newtonsoft.Json;

@{
    ViewBag.Title = "Pradhikaran Diwas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #divUnRegistered {
        display: none;
    }

    .lbl-lft-pd {
        padding-left: 50px;
    }

    .divPartialView {
        display: none;
    }


    /*.checklist {
        display: none;
