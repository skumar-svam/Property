                <span style="width:75%;float:left"><b> Applicant Name: &nbsp;<span id="Name">["Name"]</span></b></span>
                <span style="width:25%;text-align:right;float:right"><b>Property No: &nbsp;<span id="PropertyNo">["PropertyNo"]</span></b></span>
