<script type="text/javascript">
    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }

    $(document).ready(function () {
        $("#documenttable").hide();
        $('#divDocumentView').kendoWindow({
            modal: true,
            title: "Document",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "15%"
            },
            width: "70%", height: "80%"
        });

        var formType = $('#ApplicationFormType').val();
        if (formType.trim() == "Expansion") {
            $('#divExpansionType').show();
        }
        else {
            $('#divExpansionType').css("display", "none");
            $('#divRentPermission').css("display", "none");
            $('.row-rent').css("display", "none");
            $('.col-rent').css("display", "none");
            $('#divExistingAllottee').css("display", "none");
        }

        var expansionType = $('#ExpansionType').val();
        if (expansionType.trim() == "Rent Permission") {
            $('#divRentPermission').show();
            $('.row-rent').show();
            $('.col-rent').show();
            $("input[type='radio'][name=ExpansionType][value='RentPermission']").attr("checked", true);
            $('#divExistingAllottee').css("display", "none");
        }
        if (expansionType == "ExistingAllottee") {
            $('#divRentPermission').css("display", "none");
            $('.row-rent').css("display", "none");
            $('.col-rent').css("display", "none");
            $("input[type='radio'][name=ExpansionType][value='ExistingAllottee']").attr("checked", true);
            $('#divExistingAllottee').show();
        }

        var radiobtnVal = $('#ApplicantType').val();
        if (radiobtnVal == "Company") {
            $('.lbl-permanent-address').text("Registered Office");
            $('.row-individual').css("display", "none");
            $('.row-company').show();
        }
        else if (radiobtnVal == "Individual") {
            $('.lbl-permanent-address').text("Permanent Address");
            $('.row-individual').show();
            $('.row-company').css("display", "none");
        }

        $("input[type='radio']").attr("disabled", "disabled");

    });

    function FilterFormId() {
        return {
            formId: $("#ApplicationFormId").val()
        };
    }

    function OpenDocument(row) {
        $("#divDocumentView").empty();
        var tr = $(row).parent().parent();
        var link = $(tr).children("td:eq(1)").text();
        $("#divDocumentView").append($('<iframe src=' + link + ' style="width:100%;height:100%;overflow:hidden;"></iframe>'));
        $("#divDocumentView").data("kendoWindow").center();
        $("#divDocumentView").data("kendoWindow").open();
        $("#divDocumentView").data("kendoWindow").pin();
    }


</script>

