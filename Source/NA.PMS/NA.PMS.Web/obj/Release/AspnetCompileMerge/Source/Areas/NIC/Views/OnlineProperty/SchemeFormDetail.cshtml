@model NA.PMS.Model.OnlineFormViewModel
@using Kendo.Mvc.UI
@using NA.PMS.Common
@using NA.PMS.Model

@{
    ViewBag.Title = "Scheme Form Detail";
    //Layout = "~/Views/Shared/_LayoutNIC.cshtml";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .hyperlink {
        cursor: pointer;
    }

    #divUserPhoto {
        width: 100px;
        height: 120px;
        float: right;
        margin: 0 0px 20px 0;
    }

    #divUserSign {
        width: 100px;
        height: 40px;
        float: right;
    }

    #UserImage {
        width: 100px;
        height: 120px;
    }

    #UserSign {
        width: 100px;
        height: 40px;
        margin-top: 80px;
    }
</style>

<div class="row-prnt" id="divRegisteredForm">
    <div class="col-md-12 row-prnt">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-6 col-xs-12 col-prnt-lt"><h1 class="gridTitle">Form Acknowledgement</h1></div>
            <div class="col-md-6 col-sm-6 col-xs-12 mandatory col-prnt-rt"><h1 class="gridTitle">Form No: @Model.ApplicationFormId [@Model.ApplicantType]</h1></div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw hdr-ln"></div>
    <div class="col-md-12 content-top-spce row-prnt" id="first-form">
        <div class="inr-bx row-prnt" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading" style="margin-bottom:6px;">Applicant Information</h2>
            <div class="form-bx row-prnt">
                <div class="hidden-fields">
                    @Html.HiddenFor(model => model.Id)
                    @Html.HiddenFor(model => model.SchemeType)
                    @Html.HiddenFor(model => model.ApplicantType)
                    @Html.HiddenFor(model => model.ApplicationFormId)
                    @Html.HiddenFor(model => model.ApplicationFormType)
                    @Html.HiddenFor(model => model.ExpansionType)
                    @Html.HiddenFor(model => model.IsApplicationFeePaid)
                </div>
                <div class="row row-prnt">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                        <label>Application From</label>
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group" id="ApplicantTypeGroup">
                        <label>@Html.RadioButtonFor(m => m.ApplicationFormType, "General", new { @class = "", @checked = true, @id = "Individual" }) General</label>
                        <label>@Html.RadioButtonFor(m => m.ApplicationFormType, "Startup", new { @class = "", @id = "" }) Startup</label>
                        <label>@Html.RadioButtonFor(m => m.ApplicationFormType, "Expansion", new { @class = "", @id = "" }) Expansion</label>
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group" id="divExpansionType">
                        <label>@Html.RadioButtonFor(m => m.ExpansionType, "ExistingAllottee", new { @class = "", @checked = true, @id = "" }) Existing Allottee</label>
                        <label>@Html.RadioButtonFor(m => m.ExpansionType, "RentPermission", new { @class = "", @id = "" }) Under Rent Permission</label>
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group">

                    </div>
                </div>

                <div class="row row-prnt row-prnt-pc">
                    <div class="col-md-6 row-prnt-hf-lt">
                        <div class="row row-prnt">
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                                <label>Applicant Type</label>
                            </div>
                            <div class="col-md-8 col-sm-3 col-xs-12 form-group rdio-bx" id="FormType">
                                <label>@Html.RadioButtonFor(m => m.ApplicantType, "individual", new { @class = "", @checked = true, @id = "Individual" }) Individual</label>
                                <label>@Html.RadioButtonFor(m => m.ApplicantType, "company", new { @class = "", @id = "Company" }) Company</label>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.PreviousFormNo))
                        {
                            <div class="row row-prnt">
                                <div class="col-md-4 col-sm-6 col-xs-12 form-group col-prnt-lt">@Html.Label("Previous Form No If Refund Not Taken", htmlAttributes: new { @class = "" })</div>
                                <div class="col-md-8 col-sm-6 col-xs-12 form-group col-prnt-rt">
                                    @Html.TextBoxFor(model => model.PreviousFormNo, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                        }
                        <div class="row row-prnt">
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt-lt">
                                @Html.Label("Applicant Constitution", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-8 col-sm-3 col-xs-12 form-group col-prnt-rt">
                                @Html.TextBoxFor(model => model.CompanyType, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                        <div class="row row-prnt">
                            <div class="col-md-4 col-sm-6 col-xs-12 form-group col-prnt-lt">
                                @Html.Label("Scheme Name", htmlAttributes: new { @class = "" })
                            </div>
                            <div class="col-md-8 col-sm-6 col-xs-12 form-group col-prnt-rt">
                                @Html.TextBoxFor(model => model.SchemeName, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                        <div class="row row-prnt">
                            <div class="col-md-4 col-sm-6 col-xs-12 form-group col-prnt-lt">
                                @Html.Label("Department", htmlAttributes: new { @class = "" })
                            </div>
                            <div class="col-md-8 col-sm-6 col-xs-12 form-group cl-prnt-rt">
                                @Html.TextBoxFor(model => model.Department, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt-lt">
                                @Html.Label("Area Range", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-8 col-sm-3 col-xs-12 form-group col-prnt-lt">
                                @Html.TextBoxFor(model => model.AreaRange, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 row-prnt-hf-rt" style="">
                        <div class="row">
                            <div class="col-md-12 text-right" style="margin-bottom:5px;">
                                <img id="userphoto" src="@Model.UserImage" alt="your image" height="150px" width="140px" name="userImage2" />
                            </div>
                            <div class="col-md-12 text-right">
                                <img id="signature" src="@Model.SignImage" alt="your sign" height="40px" width="140px" name="usersign" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row row-company row-prnt" id="divCompanyInfo">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Applicant", htmlAttributes: new { @class = "required" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", placeholder = "", @readonly = "readonly" })
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Signing Authority", htmlAttributes: new { @class = "required" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.SigningAuthority, new { @class = "form-control", @maxlength = "150", placeholder = "", @readonly = "readonly" })
                    </div>
                </div>

                <div class="row row-company row-prnt" id="">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Signatory's Father Name", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.ApplicantMaster, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Signatory Status", htmlAttributes: new { @class = "required" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.SignatoryStatus, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>

                <div class="row row-individual row-prnt" id="divFirstAndMiddleName">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("First Name", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.FirstName, new { @class = "form-control", @readonly = "readonly" })

                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Middle Name")
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.MiddleName, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
                <div class="row row-individual row-prnt">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Last Name", new { @class = "", id = "lblLastName" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.LastName, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Gender", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.Gender, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
                <div class="row row-individual row-prnt" id="divParentsName">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Father's Name", new { @class = "", @id = "lblFatherName" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.FatherName, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Mother's Name", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.MotherName, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
                <div class="row row-individual row-prnt">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Date Of Birth", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @{
                            if (Model.DOB != null)
                            {
                                @Html.TextBox("dob", Model.DOB.Value.ToString("dd-MM-yyyy"), new { @class = "form-control", @readonly = "readonly" });
                            }
                        }
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Marital Status", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.MaritalStatus, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
            </div>
            <div id="CommonInfo" class="form-bx row-prnt">
                <div class="row row-prnt">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Permanent Address", htmlAttributes: new { @class = "required lbl-permanent-address" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextAreaFor(model => model.PermanentAddress, new { @class = "form-control", @maxlength = "500", placeholder = "", @readonly = "readonly" })
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Correspondence Address", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextAreaFor(model => model.CorrespondingAddress, new { @class = "form-control", @maxlength = "500", placeholder = "", @readonly = "readonly" })
                    </div>
                </div>
                <div class="row row-prnt">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Email", htmlAttributes: new { @class = "", @id = "lblCompanyEmail" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @(Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", @maxlength = "150", placeholder = "", @readonly = "readonly" } }))
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Mobile Number", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.MobileNumber, new { @class = "form-control", @maxlength = "10", placeholder = "", @readonly = "readonly" })
                    </div>
                </div>
                <div class="row row-prnt">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Phone Number")
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.PhoneNumber, new { @class = "form-control", @maxlength = "14", placeholder = "", @readonly = "readonly" })
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Aadhar Number", htmlAttributes: new { @class = "required", @id = "lblPanNumber" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.AadharNumber, new { @class = "form-control", @maxlength = "16", placeholder = "0000 1111 2222 3333", @readonly = "readonly" })
                    </div>
                </div>
                <div class="row row-prnt">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("PAN", htmlAttributes: new { @class = "", @id = "lblPanNumber" })
                    </div>

                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.PanNumber, new { @class = "form-control", placeholder = "", @maxlength = "10", @readonly = "readonly" })
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Annual Income", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.AnnualIncome, new { @class = "form-control textBoxValueRightAlign", @maxlength = "15", @readonly = "readonly" })
                    </div>
                </div>
                
                <div class="row row-rent row-prnt" id="divRentPermission">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Letter Date", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @(Html.Kendo().DatePickerFor(model => model.LetterDate).HtmlAttributes(new { style = "width:100%", @class = "DisableKeyboardInput", @readonly = "readonly" }))
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Rent Letter No", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.LetterCode, new { @class = "form-control", @maxlength = "11", placeholder = "", @readonly = "readonly" })
                    </div>
                </div>
                <div class="row row-prnt">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("GST Number", htmlAttributes: new { @class = "", @id = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.ApplicantGSTNumber, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-rent col-prnt">
                        @Html.Label("Rented Property", htmlAttributes: new { @class = "", @id = "lblSector" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-rent col-prnt">
                        @Html.TextBoxFor(model => model.PropertyNo, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>

                <div class="row row-prnt" id="divExistingAllottee">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Existing Property", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.ExistingProperty, new { @class = "form-control", @maxlength = "11", @readonly = "readonly" })
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Allotment Date", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @(Html.Kendo().DatePickerFor(model => model.AllottmentDate).HtmlAttributes(new { style = "width:100%", @class = "DisableKeyboardInput", @readonly = "readonly" }))
                    </div>
                </div>
            </div>
            <h2 class="blck-heading">Payment Information</h2>
            <div class="form-bx row-prnt">
                <div class="row row-prnt">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Form Fee (INR)", htmlAttributes: new { @class = "required" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.ApplicationFee, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Processing Fee", htmlAttributes: new { @class = "required" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.ProcessingCharge, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                    </div>
                </div>
                <div class="row row-prnt">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("GST(18%) on Form Fee ", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.FormFeeGST, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("GST(18%) on Processing Charge", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.ProcessingChargeGST, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                    </div>
                </div>
                <div class="row row-prnt">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Earnest Money (INR)", htmlAttributes: new { @class = "required" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.EarnestMoney, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Amount Payable (INR)", htmlAttributes: new { @class = "required" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.TotalAmount, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                    </div>
                </div>
            </div>
            <h2 class="blck-heading">Refund Information</h2>
            <div class="form-bx row-prnt">
                <div class="row row-prnt">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Bank Name", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.RefundBank, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Branch Name", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.BranchName, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
                <div class="row row-prnt">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Infavour of", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.RefundInfaverof, new { @class = "form-control", @maxlength = "150", placeholder = "", @readonly = "readonly" })
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("Account No", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.RefundAccountNo, new { @class = "form-control textBoxValueRightAlign", @maxlength = "16", placeholder = "", @readonly = "readonly" })
                    </div>
                </div>
                <div class="row row-prnt">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.Label("IFSC Code", htmlAttributes: new { @class = "" })
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                        @Html.TextBoxFor(model => model.IFSCCode, new { @class = "form-control textBoxValueRightAlign", @maxlength = "16", placeholder = "", @readonly = "readonly" })
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group col-prnt">
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group col-prnt">
                    </div>
                </div>
            </div>

