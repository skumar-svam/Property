        </div>
    </div>

    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 k-grid-content" style="margin-bottom:10px;">
        @(Html.Kendo().Grid<NA.PMS.Model.CostModel>()
        .Name("grdCosts")
        .Columns(columns =>
        {
            //columns.Bound(c => c.id).Width(30).Title("ID").Hidden(true);
            columns.Bound(c => c.depttName).Title("Department");
            columns.Bound(c => c.depttID).Hidden(true);
            columns.Bound(c => c.propName).Title("Property Type");
            columns.Bound(c => c.propType).Hidden(true);
            columns.Bound(c => c.sectorName).Title("Sector");
            columns.Bound(c => c.sector).Hidden(true);
            columns.Bound(c => c.floorName).Title("Floor/Area Range");
            columns.Bound(c => c.floor).Hidden(true);
            columns.Bound(c => c.blockName).Title("Block");
            columns.Bound(c => c.landRate).Title("Land Rate");
            columns.Bound(c => c.blockId).Hidden(true);
            columns.Bound(c => c.totPropCost).Title("Total Property Cost");
            //columns.Bound(c => c.totPropCost).Title("Total Property Cost");
            //columns.Bound(c => c.landRate).Title("Land Rate (sqt.mtr");
            //columns.Bound(c => c.allotmentMoney).Title("Allotment Money");
            //columns.Bound(c => c.earnestMoney).Title("Earnest Money");
            //columns.Bound(c => c.leaseRent).Title("Lease Rent");
            //columns.Bound(c => c.civilCost).Title("Civil Cost");
            if (ViewBag.view != "Yes")
            {
                columns.Bound(c => c.refId).Title("Action").ClientTemplate("<a onclick='javascript:RemoveCostRecord(\"#=refId#\");' class='schemeMasterGrids'>Remove</a>").Filterable(false).Sortable(false);
            }
        })
        .Sortable().Filterable().Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
        .DataSource(dataSource => dataSource
            .Ajax().Model(model => model.Id(p => p.refId))
            .Read(read => read.Action("GetCostData", "Scheme").Data("AdditionalData")).PageSize(20)
            .ServerOperation(true)
        )
        )
    </div>
    <div class="row scheme-rw-btn">
        <div class="col-md-4 col-sm-4 col-xs-4 text-left">
            <button type="button" class="btn btn-add" value="Add" id="btnPre31">Previous <i class="glyphicon glyphicon-backward"></i></button>
        </div>
        <div class="col-md-4 col-sm-4 col-xs-4 text-center">
        </div>
        <div class="col-md-4 col-sm-4 col-xs-4 text-right">
            <button type="button" class="btn btn-add" value="Add" id="btnNext31">Next <i class="glyphicon glyphicon-forward"></i></button>
        </div>
    </div>
</div>

