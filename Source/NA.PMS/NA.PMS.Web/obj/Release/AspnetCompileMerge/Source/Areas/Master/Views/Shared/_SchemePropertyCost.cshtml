@model NA.PMS.Model.SchemeViewModel
@using Kendo.Mvc.UI
@{
    ViewBag.Title = "CostPartial";
}
<style>
    .k-grid-content {
        overflow-y: hidden;
        overflow-x: hidden;
    }
</style>
<div class="CostModelForm">

    <div class="col-md-12" id="costdetail">
        <h2 class="blck-heading">Cost Information</h2>
        <div class="form-bx col-md-12 col-sm-12 col-xs-12">
            <div class="row">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="required">Department</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().DropDownListFor(model => model.DepartmentId)
                        .Name("CostDepartmentId")
                        .DataValueField("id")
                        .Filter("contains")
                        .DataTextField("text")
                        .OptionLabel("Please Select")//.Events(e => e.Change("DepttChange"))
                        .DataSource(source => source.Read(read => read.Action("GetAllDepartmentsByScheme", "Scheme").Data("AdditionalData"))).Events(model => model.Change("OnDepartmentChange"))
                        .HtmlAttributes(new { style = "width: 100%" })
                    )
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="required">Propeprty Type</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().DropDownListFor(model => model.PropertyTypeId)
                     .DataTextField("text")
                     .DataValueField("id")
                     .OptionLabel("Please Select")
                     .Filter("contains")
                     .DataSource(source =>source.Read(read =>read.Action("GetPropTypes", "Scheme").Data("filterdeptt")).ServerFiltering(true))
                     .CascadeFrom("CostDepartmentId")
                     .HtmlAttributes(new { style = "width: 100%" })
                    )
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="required">Sector</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().DropDownListFor(model => model.SectorId)
                        .DataValueField("id")
                        .Filter("contains")
                        .DataTextField("text").OptionLabel("Please Select")
                        .DataSource(source => source.Read(read => read.Action("GetSectorsByPropType", "Scheme")))
                        .HtmlAttributes(new { style = "width: 100%" })
                    )
                </div>

                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="required">Block</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().DropDownListFor(model => model.BlockId)
                        .DataValueField("id")
                        .DataTextField("text")
                        .OptionLabel("Please Select")
                        .Filter("contains")
                        .DataSource(source => source.Read(read => read.Action("GetBlocks", "Scheme")))
                        .HtmlAttributes(new { style = "width: 100%", @class = "schemeForms" })
                    )
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="required">Floor Area</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().DropDownListFor(model => model.FloorAreaTypeId)
                        .DataValueField("id")
                        .DataTextField("text")
                        .OptionLabel("Please Select")
                        .Filter("contains")
                        .DataSource(source => source.Read(read => read.Action("GetFloors", "Scheme").Data("CascadeData")))
                        .HtmlAttributes(new { style = "width: 100%" })
                    )
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="required">Earenest Money</label><i class="glyphicon fa fa-inr"></i></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().NumericTextBoxFor(m => m.EarnestMoney)
                        .Min(0).Max(9999999999999)
                        .Spinners(false).Step(0)
                        .Enable(true)
                        .HtmlAttributes(new { style = "width: 100%", @maxlength = "13", @class = "k-label textBoxValueRightAlign" })
                    )
                    @Html.ValidationMessageFor(model => model.EarnestMoney, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row" id="dvLandRate">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="required">Land Rate</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().NumericTextBoxFor(m => m.PropertyRate)
                    .Min(0).Max(9999999999999)
                    .Spinners(false).Step(0)
                    .Enable(true)
                    .HtmlAttributes(new { style = "width: 100%", @maxlength = "13", @class = "k-label textBoxValueRightAlign" })
                    )
                    @Html.ValidationMessageFor(model => model.PropertyRate, "", new { @id = "landRate", @class = "text-danger" })
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label class="required">Processing Fee</label>
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().NumericTextBoxFor(m => m.ProcessingFee)
                        .Min(0).Max(9999999999999)
                        .Spinners(false).Step(0)
                        .Enable(true)
                        .HtmlAttributes(new { style = "width: 100%", @maxlength = "7", @class = "k-label textBoxValueRightAlign" })
                    )
                </div>
            </div>
            <div class="row" id="dvPropCivilCost">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label class="required">Property Cost</label>
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().NumericTextBoxFor(m => m.PropertyCost)
                        .Min(0).Max(9999999999999)
                        .Spinners(false).Step(0)
                        .Enable(true)
                        .HtmlAttributes(new { style = "width: 100%", @maxlength = "13", onblur = "GetTotalPropertyCost();", @class = "k-label textBoxValueRightAlign" })
                    )
                    @Html.ValidationMessageFor(model => model.PropertyCost, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label class="required">Civil Cost</label><i class="glyphicon fa fa-inr"></i></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().NumericTextBoxFor(m => m.CivilCost)
                        .Min(0).Max(9999999999999)
                        .Spinners(false).Step(0)
                        .Enable(true)
                        .HtmlAttributes(new { style = "width: 100%", @maxlength = "13", onblur = "GetTotalPropertyCost();", @class = "k-label textBoxValueRightAlign" })
                    )
                    @Html.ValidationMessageFor(model => model.CivilCost, "", new { @class = "text-danger" })

                </div>
            </div>
            <div class="row" id="totPropAllotMoney">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label class="required">Total Property Cost</label><i class="glyphicon fa fa-inr"></i>
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @Html.TextBoxFor(m => m.TotalPropertyCost, new { style = "width: 100%", @class = "textBoxValueRightAlign" })
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">@Html.Label("Allotment Money (INR)", htmlAttributes: new { onblur = "GetTotalPropertyCost();", @id = "lblPropCost1", @class = "required" })<i class="glyphicon fa fa-inr"></i></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().NumericTextBoxFor(m => m.AllotmentMoney)
                        .Min(0).Max(9999999999999)
                        .Spinners(false).Step(0)
                        .Enable(true)
                        .HtmlAttributes(new { style = "width: 100%", @maxlength = "13", @class = "k-label textBoxValueRightAlign" })
                    )
                    @Html.ValidationMessageFor(model => model.AllotmentMoney, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row" id="dvLeaseRent">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label class="required">Lease Rent</label><i class="glyphicon fa fa-inr"></i>
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().NumericTextBoxFor(m => m.LeaseRent)
                        .Min(0).Max(9999999999999)
                        .Spinners(false).Step(0)
                        .Enable(true)
                        .HtmlAttributes(new { style = "width: 100%", @maxlength = "13", @class = "k-label textBoxValueRightAlign" })
                    )
                    @Html.ValidationMessageFor(model => model.LeaseRent, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">

                </div>
            </div>


        </div>
    </div>
    <div class="row scheme-rw-btn">
        <div class="col-md-4 col-sm-4 col-xs-4 text-left">
            <button type="button" class="btn btn-add" value="Add" id="btnPre3">Previous <i class="glyphicon glyphicon-backward"></i></button>
        </div>
