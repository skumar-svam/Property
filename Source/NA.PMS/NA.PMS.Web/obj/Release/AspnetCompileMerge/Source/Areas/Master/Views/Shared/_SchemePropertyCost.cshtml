    function SavePropertyCostDetail(){
        var validatecost = ValidatecostMasterScheme();
        if (validatecost) {
            var CostModel = {
                SchemeId: $("#SchemeId").val(),
                DepartmentId: $('#CostDepartmentId').val(),
                PropertyTypeId: $("#PropertyTypeId").val(),
                SectorId: $("#SectorId").val(),
                BlockId:  $('#BlockId').val(),
                FloorAreaTypeId: $("#FloorAreaTypeId").val(),
                processingFee: $("#ProcessingFee").val(), 
                PrpertyRate: $("#PrpertyRate").val(), 
                PropertyCost: $("#PropertyCost").val(), 
                CivilCost: $("#CivilCost").val(), 
                TotalPropertyCost: $("#TotalPropertyCost").val(), 
                EarnestMoney: $("#EarnestMoney").val(), 
                AllotmentMoney: $("#AllotmentMoney").val(), 
                LeaseRent: $("#LeaseRent").val() 
            };
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ model : CostModel }),
                url: '/Scheme/IsCostNameUnique',
                success: function (result) {
                    if (result == true) {
                        alertify.error("This Department already exists");
                        return false;
                    }
                    else {
                        var $form = $("form");
                        if ($form.valid()) {
                            $.ajax({
                                dataType: 'json',
                                type: 'Post',
                                contentType: 'application/json; charset=utf-8',
                                data: JSON.stringify({model : CostModel}),
                                url: "/Scheme/AddCost",
                                success: function (data) {
                                    if (data == true) {
                                        $("#grdCosts").data("kendoGrid").dataSource.read();
                                        alertify.success("Data added successfully");
                                        setTimeout(function () { ActivateScheme(); }, 2000);
                                    }
                                    else {
                                        alertify.error("This Department already exists");
                                        return false;
                                    }
                                },
                                error: function (objAjaxRequest, strError) {
                                    var respText = objAjaxRequest.responseText;
                                }
                            });
                        }
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //$("#btnAddCost").removeAttr('disabled');
                    //alert(respText);
                }
            });
        }
    }

