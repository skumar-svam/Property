    function RemoveCostRecord(refId) {
        var schemeID = $("#scheId").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ refId: refId, schemeID: schemeID }),
            url: '/Scheme/RemoveCostRecord',
            success: function (result) {
                if (result == true) {
                    $("#grdCosts").data("kendoGrid").dataSource.read();
                    var grdCosts = $("#grdCosts").data("kendoGrid").dataSource.data();
                    if (grdCosts.length == 1) {
                        IsSchemeCompletedByRemove(false);
                    }
                    alertify.success("Record deleted successfully.");
                }
            },
            error: function (obj) {
                //alert('Error While Saving Record.');
            }
        });
    }

