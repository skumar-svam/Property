    function GetTotalPropertyCost() {
        if ($("#propCost").val() < 0) {
            alertify.error("Property Cost can't be negative.");
            return false;
        }
        if ($("#civilCost").val() < 0) {
            alertify.error("Civil Cost can't be negative.");
            return false;
        }
        //debugger;
        var propCost = (isNaN(parseFloat($('#propCost').val()))) ? 0 : parseFloat($('#propCost').val());
        var civilCost = (isNaN(parseFloat($('#civilCost').val()))) ? 0 : parseFloat($('#civilCost').val());
        var TotalPropCost = (propCost + civilCost).toFixed(2);
        $('#totPropCost').val(TotalPropCost);
    }

    function ValidatecostMasterScheme() {
        //alert();
        var selectedepttValue = $('#depttID');
        var selectedproptypeValue = $('#propType');
        var selectedsectorValue = $('#sector');
        var selectedfloortypeValue = $('#floorddl');
        var selectedblockValue = $('#blockId');
        var earnestMoney = $.trim($('#earnestMoney').val())
        var allotmentMoney = $.trim($('#allotmentMoney').val())
        var lblFloorVal = ($("#lblFloor").html()).slice(0, -1);
        var totPropCost = $("#totPropCost").val()
        var earnestMoney = $("#earnestMoney").val().trim();

        //alert(lblFloorVal);
        if (selectedepttValue.val() == "") {
            alertify.error('Please select Department');
            return false;
        }
        else if (selectedproptypeValue.val() == "") {
            alertify.error('Please select Property Type');
            return false;
        }
        else if (selectedsectorValue.val() == "") {
            alertify.error('Please select Sector');
            return false;
        }
        else if (selectedfloortypeValue.val() == "") {
            alertify.error('Please select ' + lblFloorVal);
            return false;

        } else if (selectedblockValue.val() == "") {
            alertify.error('Please select Block');
            return false;
        }
        else if (earnestMoney == "") {
            alertify.error('Please enter Earnest Money amount.');
            return false;
        }
        else if (selectedepttValue.val() == 5) {
            if (parseFloat(allotmentMoney) < parseFloat(earnestMoney)) {
                alertify.error('Earnest money should not be greater than allotment money.');
                return false;
            }
            if (parseFloat(allotmentMoney)+parseFloat(earnestMoney) >= parseFloat(totPropCost)) {
                alertify.error('Sum of Allotment and Earnest money cannot exceed total propety cost.');
                return false;
            }
            if ($('#propCost').val().trim() == "") {
                alertify.error('Please enter propety cost.');
                return false;
            }
            if ($('#civilCost').val().trim() == "") {
                alertify.error('Please enter civil cost.');
                return false;
            }
            if ($('#totPropCost').val().trim() == "") {
                alertify.error('Please enter total propety cost.');
                return false;
            }
            if ($('#allotmentMoney').val().trim() == "") {
                alertify.error('Please enter AllotmentMoney.');
                return false;
            }
            if ($('#leaseRent').val().trim() == "") {
                alertify.error('Please enter Lease Rent.');
                return false;
            }
        }
        if (selectedepttValue.val() != 5) {
            if ($("#propCost").val() < 0) {
                alertify.error("Property Cost can't be negative.");
                return false;
            }
            if ($("#civilCost").val() < 0) {
                alertify.error("Civil Cost can't be negative.");
                return false;
            }
            if ($('#landRate').val() <= 0) {
                alertify.error("Please enter Land Rate(/Sq.Mtr).");
                return false;
            }
        }
        return true;
    }

