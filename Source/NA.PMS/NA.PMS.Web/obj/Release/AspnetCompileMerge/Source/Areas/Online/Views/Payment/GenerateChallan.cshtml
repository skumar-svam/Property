        else {
            var rid1 = $("tbody").children("tr:eq(0)").children("td:eq(1)").text();
            var objOnlineChallanViewModel = { RegistrationId: rId, BankId: bankId, BranchId: branchId, AccountNo: DdlAccountNumber, DepartmentId: DepttId, PropertyNo: PropertyNo, ApplicantMaster: ApplicantMaster, Applicant: Applicant, TotalArea: TotalArea, Department: Department, Gender: Gender, PropertyType: PropertyType, FloorArea: FloorArea };
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
