    function FieldsReadonly(status) {
        if (status == false) {
            status = false;
        } else { status = "readonly"; }
        $('#PropertyNo').attr("readonly", status);
        $("#ApplicantMaster").attr("readonly", status);
        $("#Applicant").attr("readonly", status);
        $("#TotalArea").attr("readonly", status);
        $("#Department").attr("readonly", status);
        $("#Gender").attr("readonly", status);
        $("#PropertyType").attr("readonly", status);
        $("#FloorArea").attr("readonly", status);
    }

    function CheckRadioValue() {
        var checkradio = false;
        var radiobtnVal = $('input[name=HasRegistrationId]:checked').val();
        if (radiobtnVal == "no") { checkradio = false; }
        else if (radiobtnVal == "yes") { checkradio = true; }
        return checkradio;
    }
