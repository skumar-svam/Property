@model NA.PMS.Model.OnlineChallanViewModel

@using Kendo.Mvc.UI;

@{
    ViewBag.Title = "Generate Challan";
    Layout = "~/Views/Shared/_LayoutOnline.cshtml";
}

<style>
    #divChallanGrid {
        display: none;
    }
</style>

<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="row">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Generate Challan</h1></div>
                <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
                <h2 class="blck-heading"></h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group rdio-bx" id="FormType">
                            @Html.Label("Do You Have Registration ID?", htmlAttributes: new { @class = "" })
                            <label>@Html.RadioButtonFor(m => m.HasRegistrationId, "yes", new { @class = "", @checked = true, @id = "Yes" }) Yes</label>
                            <label>@Html.RadioButtonFor(m => m.HasRegistrationId, "no", new { @class = "", @id = "No" }) No</label>
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                        </div>
                    </div>
                </div>
                <div class="regId">
                    <h2 class="blck-heading">Registration ID</h2>
                    <div class="form-bx">
                        <div class="row regId">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Registration Id", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @(Html.Kendo().DropDownListFor(m => m.RegistrationId)
                                .Filter("contains")
                                .DataTextField("text")
                                .DataValueField("id")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                    source.Custom()
                                   .ServerFiltering(true)
                                   .ServerPaging(true)
                                   .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                   .Transport(transport =>
                                   {
                                       transport.Read(read => read.Action("GetRIDsForManageAccountDetailsByDataSource", "PropertyRegistration", new { Area = "Property" }));
                                   }).Schema(schema =>
                                   {
                                       schema.Data("Data")
                                       .Total("Total");
                                   }).PageSize(100);
                                })
                                .Events(events => { events.Change("RIdChange"); })
                               .HtmlAttributes(new { @class = "schemeForms", style = "width:100%" })
                                )
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblPropNo">
                            </div>
                        </div>
                    </div>
                </div>
                <h2 class="blck-heading">Applicant Details</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Property No", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblPropNo">
                            @Html.TextBoxFor(model => model.PropertyNo, new { @class = "form-control", @maxlength = "150", placeholder = "" })
                            @Html.ValidationMessageFor(model => model.PropertyNo, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Department", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblDepttName">
                            @Html.HiddenFor(m => m.DepartmentId)
                            @Html.TextBoxFor(model => model.Department, new { @class = "form-control", @maxlength = "150", placeholder = "" })
                            @Html.ValidationMessageFor(model => model.Department, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Allottee Name", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblApNa">
                            @Html.TextBoxFor(model => model.Applicant, new { @class = "form-control", @maxlength = "150", placeholder = "" })
                            @Html.ValidationMessageFor(model => model.Applicant, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Gender")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblGender">
                            @Html.TextBoxFor(model => model.Gender, new { @class = "form-control", @maxlength = "150", placeholder = "" })
                            @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Father's/Husband's Name")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblReNa">
                            @Html.TextBoxFor(model => model.ApplicantMaster, new { @class = "form-control", @maxlength = "150", placeholder = "" })
                            @Html.ValidationMessageFor(model => model.ApplicantMaster, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Property Type")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblPropTy">
                            @Html.TextBoxFor(model => model.PropertyType, new { @class = "form-control", @maxlength = "150", placeholder = "" })
                            @Html.ValidationMessageFor(model => model.PropertyType, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Floor/Area Range")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblFloor">
                            @Html.TextBoxFor(model => model.FloorArea, new { @class = "form-control", @maxlength = "150", placeholder = "" })
                            @Html.ValidationMessageFor(model => model.FloorArea, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Area(sqmt)")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblArea">
                            @Html.TextBoxFor(model => model.TotalArea, new { @class = "form-control textBoxValueRightAlign", @maxlength = "16", onkeypress = "return IsNumeric(event);", placeholder = "" })
                            @Html.ValidationMessageFor(model => model.TotalArea, "", new { @class = "text-danger" })
                        </div>
                    </div>

                </div>
                <h2 class="blck-heading">Bank Information</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Bank Name", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(model => model.BankId)
                            .Name("bankId")
                            .DataTextField("text")
                            .DataValueField("id")
                            .OptionLabel("Select")
                            .Filter("contains")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetAllBanks", "PropertyRegistration", new { Area = "Property" });
                                });
                            })
                                    //.Events(model => model.Change("CleanAccountNumber"))
                            .HtmlAttributes(new { style = "width: 100%", @class = "schemeForms" })
                            )
                            @Html.ValidationMessageFor(model => model.BankId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Branch Address", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(model => model.BranchId)
                            .Name("branchId")
                            .DataTextField("text")
                            .DataValueField("id")
                            .OptionLabel("Select")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetAllBranchs", "PropertyRegistration", new { Area = "Property" })
                                        .Data("filterBranches");
                                }).ServerFiltering(true);
                            })
                            .CascadeFrom("bankId")
                            .Events(model => model.Change("HideShowBranch"))
                            .HtmlAttributes(new { style = "width: 100%", @class = "schemeForms" })
                            )
                            @Html.ValidationMessageFor(model => model.BranchId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Account Number", htmlAttributes: new { @id = "lblAccountddl", @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblDdlAccountNumber">
                            @Html.TextBoxFor(m => m.AccountNo, new { @readonly = "readonly", @class = "form-control" })
                        </div>
                    </div>
                </div>

                <h2 class="blck-heading"> Add Charges</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Account Head", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(model => model.AccountHeadId)
                            .DataTextField("text")
                            .DataValueField("id")
                            .OptionLabel("Select")
                            .Filter("contains")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetAllAccountHead", "PropertyRegistration", new { Area = "Property" });
                                });
                            })

                            .HtmlAttributes(new { style = "width: 100%", @class = "schemeForms" })
                            )
                            @Html.ValidationMessageFor(model => model.AccountHeadId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Account Subhead", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(model => model.AccountSubHeadId)
                                    //.Name("AccountSubHeadId")
                            .DataTextField("text")
                            .DataValueField("id")
                            .OptionLabel("Select")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetAccountSubHead", "PropertyRegistration", new { Area = "Property" })
                                        .Data("filterAccountSubHead");
                                }).ServerFiltering(true);
                            })
                                            .CascadeFrom("AccountHeadId")
                                    //.Events(model => model.Change("HideShowBranch").DataBound("onDataBound"))
                            .HtmlAttributes(new { style = "width: 100%", @class = "schemeForms" })
                            )
                            @Html.ValidationMessageFor(model => model.AccountSubHeadId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Amount", htmlAttributes: new { @id = "lblAccountddl", @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().NumericTextBoxFor(m => m.Amount)
                                       .Name("Amount")
                                      .Min(0)
                                        .Max(999999999999999999)
                                                .Spinners(false).Step(0)
                                        .Enable(true)
                                     .HtmlAttributes(new { style = "width: 100%", @maxlength = "18", @class = "k-label  textBoxValueRightAlign" })
                            )
                            @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                        </div>
                        @*<div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Account Number", htmlAttributes: new { @id = "lblAccountddl", @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblDdlAccountNumber">
                                @Html.TextBoxFor(m => m.DdlAccountNumber, new { @readonly = "readonly", @class = "form-control" })

                            </div>*@
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">

                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            <input type="button" id="btnAdd" value="Add" class="btn btn-add" />
                        </div>
                    </div>
                </div>

                <div class="k-grid-content" id="divChallanGrid">
                    @(Html.Kendo().Grid<NA.PMS.Model.OnlineChallanViewModel>()
                        .Name("gridChargeDetails")
                            .Columns(columns =>
                            {
                                columns.Bound(c => c.ChallanId).Hidden(true);
                                columns.Bound(c => c.RegistrationId).Hidden(true);
                                columns.Bound(c => c.AccountHeadName).Title("Account Head");
                                columns.Bound(c => c.AccountSubHeadName).Title("Account Sub Head");
                                columns.Bound(c => c.Amount).Title("Amount");
                                //columns.Bound(c => c.BankName).Title("Bank");
                                //columns.Bound(c => c.CreatedDate).Title("Date").Format("{0:dd-MMM-yyyy}");
                                columns.Bound(c => c.ChallanTransId).Title("Action").ClientTemplate("<a onclick='javascript:RemoveChallanDetails(this);'class='hyperlinkcss'>Remove</a>").Filterable(false).Sortable(false);
                                //columns.Bound(c => c.ChallanTransID).Title("Action").ClientTemplate("<a onclick='javascript:RemoveDetails(\"#=ChallanTransID#\");'class='hyperlinkcss'>Remove</a>").Filterable(false).Sortable(false);
                            })
                            .Sortable()
                            .Filterable()
                            .Resizable(resize => resize.Columns(true))

                            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                            .DataSource(dataSource => dataSource
                                                    .Ajax()//.Model(model => model.Id(c => c.ChallanTransId))
                                    .ServerOperation(true)
                                                    .Read(read => read.Action("GetGeneratedChallanDetails", "Payment", new { Area = "Online" }).Data("AdditionalInfo")).PageSize(5)
                                    )
                    )
                </div>
                <div>
                    <div class="row">
                        @Html.HiddenFor(model => model.Amount, htmlAttributes: new { @id = "hdnAmmount" })
                        @Html.HiddenFor(model => model.AccountHeadId, htmlAttributes: new { @id = "hdnAccountHeadId" })
                        @Html.HiddenFor(model => model.AccountSubHeadId, htmlAttributes: new { @id = "hdnAccountSubHeadId" })
                    </div>
                </div>
            </div>

            <div class="box-button text-center">
                <input type="button" id="btnBack" value="Back" class="btn  btn-default" />
                <input type="button" value="Generate Challan" id="btnGenerateChallan" class="btn btn-default" />
            </div>
        </div>
    </div>
</div>


<div id="divPrintChallan" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 60%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Challan</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:400px;">
                <div id="divChallanBody"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv();">Print</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1 || keyCode == 46);
        if (ret == false)
            return false;
    }

    $(document).ready(function () {
       // $('input[name=HasRegistrationId][value=no]').attr("disabled", true);
        var RVal = CheckRadioValue();
        if (RVal == false) {
            $('#divChallanGrid').show();
        }

        FieldsReadonly(true);
        $('input:radio[name=HasRegistrationId]').on('change', function () {
            var radiobtnVal = $('input[name=HasRegistrationId]:checked').val();
            if (radiobtnVal == "no") {
                ClearFieldValue();
                $(".regId").hide();
                FieldsReadonly(false);
                $('#divChallanGrid').show();
            }
            else if (radiobtnVal == "yes") {
                ClearFieldValue();
                $(".regId").show();
                FieldsReadonly(true);
                $('#divChallanGrid').hide();
            }
        });
    });

    function FilterDepartmentId() {
        return { departmentId: $("#DepartmentId").val() };
    }

    $("#btnBack").click(function () {
        window.location.href = '@Url.Action("SchemeInformation", "Account")';
    });
    function HideShowBranch() {
        var bankId = $('#bankId').val();
        var branchId = $('#branchId').val();
        if (bankId == '') {
            $("#AccountNo").val('');
            //alertify.error("Please select Bank Name");
            return false;
        }
        if (branchId == '') {
            $("#AccountNo").val('');
            //alertify.error("Please select Branch name");
            return false;
        }
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ bankId: bankId, branchId: branchId }),
            url: '/Payment/GetAccountNumber',
            success: function (result) {
                // $("#DdlAccountNumber").val(result)
                $("#AccountNo").val(result);
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alertify.error("Some Error in saved database.");
            }

        });
    }

    function AdditionalInfo() {
        return {
            rid: $('#RegistrationId').val() != "" ? $("#RegistrationId").val() : 0
        }
    }

    $("#btnAdd").click(function () {

        var radioVal = CheckRadioValue();
        var rId = 0;
        //$("#RegistrationId").val() != "" ? $("#RegistrationId").val() : 0;

        var AccountHeadId = $("#AccountHeadId").val();
        var AccountSubHeadId = $("#AccountSubHeadId").val();
        var Amount = $("#Amount").val();

        $('#hdnAmmount').val(Amount);
        $('#hdnAccountHeadId').val(AccountHeadId);
        $('#hdnAccountSubHeadId').val(AccountSubHeadId);

        if (radioVal == true) {
            rId = $("#RegistrationId").val();
            if (rId == "" || rId == 0) {
                alertify.error("Please select RID.");
                return false;
            }
        }
        if (AccountHeadId == "") {
            alertify.error("Please select Account Head.");
            return false;
        }
        if (AccountSubHeadId == "") {
            alertify.error("Please select Sub Account Head.");
            return false;
        }
        if (Amount == "") {
            alertify.error("Please enter  Amount.");
            return false;
        }

        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rId: rId, AccountHeadId: AccountHeadId, AccountSubHeadId: AccountSubHeadId, Amount: Amount }),
            url: '/Payment/SaveCreateChallan',
            success: function (result) {
                if (result == 0) {
                    $("#AccountHeadId").data("kendoDropDownList").value("");
                    $("#AccountSubHeadId").data("kendoDropDownList").value("");
                    $("#Amount").data("kendoNumericTextBox").value("");
                    $("#gridChargeDetails").data("kendoGrid").dataSource.read();
                    //alertify.success("Data saved successfully.");
                    return false;
                }
                if (result == 2) {
                    $("#AccountHeadId").data("kendoDropDownList").value("");
                    $("#AccountSubHeadId").data("kendoDropDownList").value("");
                    $("#Amount").data("kendoNumericTextBox").value("");
                    $("#gridChargeDetails").data("kendoGrid").dataSource.read();
                    alertify.success("Registration id is changed");
                }
                if (result == 3) {
                    alertify.error("Maximum 3 charges are allowed.");
                    return false;
                }
                else {
                    return true;
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alertify.error("Some Error in adding data.");
            }

        });

    });

    function RemoveChallanDetails(row) {
        var tr = $(row).parent().parent();
        var challanid = $(tr).children("td:eq(0)").text();
        var rid = $(tr).children("td:eq(1)").text();
        var headname = $(tr).children("td:eq(2)").text();
        var subheadname = $(tr).children("td:eq(3)").text();
        var amount = $(tr).children("td:eq(4)").text();
        var removeNotification = confirm('Are you sure to remove this details?');
        if (removeNotification) {
            $.ajax({
                type: 'POST',
                data: { rid: rid, headName: headname, subHeadName: subheadname, amount: amount },
                url: '@(Url.Action("RemoveChallanChargeDetail", "Payment"))',
                success: function (result) {
                    if (result == true) {
                        $('#gridChargeDetails').data('kendoGrid').dataSource.read();
                        $('#gridChargeDetails').data('kendoGrid').refresh();
                        alertify.success("Charges removed successfully.");
                    }
                    else {
                        alert("Charge Details not removed");
                        return false;
                    }
                }
            });
        }
        else {
            return false;
        }
    }

    $("#btnGenerateChallan").click(function () {
        DepttId = $("#DepttId").val();

        var PropertyNo = $('#PropertyNo').val();
        var ApplicantMaster = $("#ApplicantMaster").val();
        var Applicant = $("#Applicant").val();
        var TotalArea = $("#TotalArea").val();
        var Department = $("#Department").val();
        var Gender = $("#Gender").val();
        var PropertyType = $("#PropertyType").val();
        var FloorArea = $("#FloorArea").val();

        var radioVal = CheckRadioValue();
        var rId = 0;
        var bankId = $("#bankId").val();
        var branchId = $("#branchId").val();
        var DdlAccountNumber = $("#AccountNo").val();
        if (radioVal == true) {
            rId = $("#RegistrationId").val();

            if (rId == "" || rId == 0) {
                alertify.error("Please select RID.");
                return false;
            }

        }
        else {
            if (PropertyNo == "") {
                alertify.error("Please select Property No.");
                return false;
            }
            if (ApplicantMaster == "") {
                alertify.error("Please select Father's/Husband's Name.");
                return false;
            }
            if (Applicant == "") {
                alertify.error("Please select Applicant.");
                return false;
            }
            if (TotalArea == "") {
                alertify.error("Please select Total Area.");
                return false;
            }
            if (Department == "") {
                alertify.error("Please select Department.");
                return false;
            }
            if (Gender == "") {
                alertify.error("Please select Gender.");
                return false;
            }
            if (PropertyType == "") {
                alertify.error("Please select Property Type.");
                return false;
            }
            if (FloorArea == "") {
                alertify.error("Please select Floor Area.");
                return false;
            }
        }
        if (bankId == "") {
            alertify.error("Please select Bank.");
            return false;
        }
        if (branchId == "") {
            alertify.error("Please select branch.");
            return false;
        }
        if (DdlAccountNumber == "") {
            alertify.error("Please select Account Number.");
            return false;
        }


        var grid = $("#gridChargeDetails").data("kendoGrid");
        var totalRecords = grid.dataSource.total();
        if (totalRecords == 0) {
