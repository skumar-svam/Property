<script type="text/javascript">
    function filterForms() {
        return {
            SchemeId: $("#SchemeId").val(),
            DepartmentId: $("#DepartmentId").val()
        };
    }

    function GetApplicantDetails() {
        if ($('#formno').val() == "") {
            RemoveApplicantDetails();
        }
        else {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ formno: $("#formno").val(), schemeID: $("#SchemeId").val(), departmentID: $("#DepartmentId").val() }),
                // url: "/Allotment/GetApplicantDetails",
                url: '@Url.Action("GetApplicantDetailsForAllotment", "Allotment")',
                success: function (data) {
                    if (data != null && (data.GenderName == "company" || data.GenderName == "Company")) {
                        $('#divGenderPerson').hide();
                        $('#CompanyName').html(data.ApplicantName);
                        $('#SigningAuthority').html(data.SigningAuthority);
                        $('#RegisteredOffice').html(data.RegisteredOffice);
                        $('#CorrespondingAddress').html(data.CorrespondingAddress);
                        $('#PermanentAddress').html(data.PermanentAddress);
                        $('#MobileNumber').html(data.MobileNumber);
                        $('#PhoneNumber').html(data.PhoneNumber);
                        $('#PanNumber').html(data.PanNumber);
                        $('#EarnestMoney').html(data.earnestMoney);
                        $('#CompanyEmail').html(data.Email);
                        $('#divGenderPerson').hide();
                        $('#divGenderCompany').show();
                        $('#duplicateformValue').val(data.RecordExistsIn);
                    }
                    else {
                        $('#ApplicantName').html(data.ApplicantName);
                        $('#Gender').html(data.GenderName);
                        $('#FatherName').html(data.FatherName);
                        $('#MotherName').html(data.MotherName);
                        $('#Mobile').html(data.MobileNumber);
                        $('#Address').html(data.CorrespondingAddress);
                        $('#Earnest').html(data.earnestMoney);
                        $('#Email').html(data.Email);
                        $('#Category').html(data.CategoryName);
                        $('#PANnumber').html(data.PanNumber);
                        $('#duplicateformValue').val(data.RecordExistsIn);
                        $('#divGenderCompany').hide();
                        $('#divGenderPerson').show();
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //alert(respText);
                }
            });
        }
    }

    function GetPropertyDetails() {
        $('#Block').empty();
        $('#Sector').empty();
        $('#Propertytype').empty();
        $('#TotalArea').empty();
        $('#allotmentmoney').empty();
        $('#duplicatepropertyValue').val("");
        $('#totPropertycost').empty();
        $('#civil').empty();
        $('#totnoofinstallment').empty();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ propertyId: $('#PropertyId').val(), schemeID: $("#SchemeId").val(), departmentID: $("#DepartmentId").val() }),
            url: "/Allotment/GetPropertyDetailsForAllotment",
            success: function (data) {
                if (data != null) {
                    $('#Block').html(data.BlockName);
                    $('#Sector').html(data.SectorName);
                    $('#Propertytype').html(data.PropertyTypeName);
                    $('#TotalArea').val(data.TotalArea);
                    $('#allotmentmoney').html(data.AllotmentMoney);
                    $('#duplicatepropertyValue').val(data.RecordExistsIn);
                    $('#totPropertycost').html(data.TotalPropertyCost);
                    $('#civil').html(data.CivilCost);
                    $('#totnoofinstallment').html(data.TotalnoofInstallment);
                    $('#frequencyValue').val(data.Frequency);
                    $('#hdnEndDate').val(data.EndDate);
                    $('#hdnAreaRange').val(data.FloorName);
                    setDates();
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
            }
        });
    }

    $('#AllotmentDate').blur(function () {
        setDates();
        checkAllotmentDate();
    });

    function setDates() {
        var department = $('#DepartmentId').val();
        if (department != 4) {
            var datepicker = $("#InstalmentStartDate").data("kendoDatePicker");
            var allotmentDate = new Date($("#AllotmentDate").val());
            var month1 = parseInt($("#frequencyValue").val());
            var month = 12 / month1;
            var end_date = new Date(allotmentDate);
            end_date.setMonth(allotmentDate.getMonth() + month);
            datepicker.value(end_date);
        }
        else {
            var allotmentDate = new Date($("#AllotmentDate").val());
            var datepicker = $("#InstalmentStartDate").data("kendoDatePicker");
            var month = 6;
            var end_date = new Date(allotmentDate);
            end_date.setMonth(allotmentDate.getMonth() + month);
            var strdate;
            if (end_date.getMonth() <= 6) {
                strdate = '06' + '/30' + '/' + end_date.getFullYear();
            }
            else {
                strdate = '12' + '/31' + '/' + end_date.getFullYear();
            }
            datepicker.value(strdate);
        }
    }
    function ValidateForm() {
        var formno = $('#formno').val();
        var property = $('#PropertyId').val();
        var scheme = $('#SchemeId').val();
        var department = $('#DepartmentId').val();
        var totalArea = $('#TotalArea').val();
        var allotmentDate = $("#AllotmentDate").val();
        if (scheme == "") {
            alertify.error('Please select a scheme.');
            return false;
        }
        else if (department == "") {
            alertify.error('Please select a department.');
            return false;
        }
        else if (formno == "") {
            alertify.error('Please select a Form.');
            return false;
        }
        else if (property == "") {
            alertify.error('Please select a Property Number.');
            return false;
        }
        else if (totalArea == "" || totalArea == "0") {
            alertify.error('Please enter Area (Sq.Mtr).');
            return false;
        }
        else if (allotmentDate == "") {
            alertify.error('Please enter allotment date.');
            return false;
        }
        else if ($('#duplicateformValue').val() == "true" && (formno != $('#FormID').val())) {
            alertify.error('This applicant has already assigned a property.');
            return false;
        }
        else if ($('#duplicatepropertyValue').val() == "true" && ($('#PropertyId').val() != $('#HdnPropertyID').val())) {
            alertify.error('This property has already been alloted.');
            return false;
        }
        else { return true; }
    }
    $(document).ready(function () {
        GetApplicantDetails();
        GetPropertyDetails();
        var datepicker = $("#InstalmentStartDate").data("kendoDatePicker");
        datepicker.readonly();
        setDates();
        $('#SchemeId').data('kendoDropDownList').enable(false);
        $('#AllotmentDate').data('kendoDatePicker').enable(false);
        $('#InstalmentStartDate').data('kendoDatePicker').enable(false);
    });

    function checkAllotmentDate() {
        var allotmentDate = new Date($("#AllotmentDate").val());
        var schemeEndDate = $("#hdnEndDate").val();
        var date = new Date(parseInt(schemeEndDate.substr(6)));
        var strdate = (date.getMonth() + 1) + '/' + date.getDate() + '/' + date.getFullYear();
        var flag = false;
        if ((Date.parse(strdate) >= Date.parse(allotmentDate))) {
            alertify.error("Allotment date should be earlier than scheme end date.");
            flag = false;
            return flag;
        }
        else { flag = true }
        return flag;
    }

    function FilterDepartment() {
        return { SchemeId: $("#SchemeId").val() };
    }

    function ValidateAreaRange() {
        var totalArea = $('#TotalArea').val();
        var department = $('#DepartmentId').val();
        var areaRange = $('#hdnAreaRange').val();
        var flag = false;
        if (department != 5) {
            if (areaRange.includes(">")) {
                var areaRange1 = areaRange.split(">");
                if (totalArea < parseInt(areaRange1[1].trim())) {
                    alertify.error("Please enter Area within Area Range " + areaRange + ".");
                    flag = false;
                }
                else { flag = true; }
            }
            else {
                var areaRange2 = areaRange.split("-");
                if (totalArea < parseFloat(areaRange2[0].trim()) || totalArea > parseFloat(areaRange2[1].trim())) {
                    alertify.error("Please enter Area within Area Range " + areaRange + ".");
                    flag = false;
                }
                else { flag = true; }
            }
        }
        else {
            flag = true;
        }
        return flag;
    }

