@model NA.PMS.Model.CICModel
@using Kendo.Mvc.UI;


<div class="">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                @Html.Label("Change In Constitution", htmlAttributes: new { @class="required"})
            </div>
            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                @(Html.Kendo().DropDownListFor(model => model.Change_Type)
                      .DataTextField("text")
                      .DataValueField("id")
                      .OptionLabel("Select")
                      .DataSource(source =>
                      {
                          source.Read(read =>
                          {
                              read.Action("GetChangeType", "CIC");
                          });
                      })
                    .HtmlAttributes(new { style = "width:100%;" })
                )
            </div>
            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                @Html.Label("CIC Charge (INR)")
            </div>
            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                @Html.TextBoxFor(m => m.CIC_Charge, htmlAttributes: new { @class = "form-control", @maxlength = "16" })
                @Html.HiddenFor(m => m.CIC_Charge, htmlAttributes: new { @id="hdnCICCharges" })
            </div>
        </div>

    }
</div>