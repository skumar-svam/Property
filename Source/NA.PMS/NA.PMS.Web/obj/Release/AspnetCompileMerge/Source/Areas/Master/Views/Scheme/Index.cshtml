    function ActivateScheme() {
        var gridDepartment = $("#gridDepartment").data("kendoGrid").dataSource.data();
        var grdCosts = $("#grdCosts").data("kendoGrid").dataSource.data();
        //var rebatedepartment = $("#gridReb").data("kendoGrid").dataSource.data();
        var grdBanks = $("#gridBanks").data("kendoGrid").dataSource.data();
        //var grdQuota = $("#gridQuota").data("kendoGrid").dataSource.data();
        var grdLandDevelopment = $("#grdLandDevelopment").data("kendoGrid").dataSource.data();
        if (gridDepartment.length > 0 && grdCosts.length > 0 && grdBanks.length > 0 && grdLandDevelopment.length > 0) {
            $('#btnSubmitScheme').removeAttr('disabled');
        }
        else {
            $('#btnSubmitScheme').attr('disabled', 'disabled');
        }
    }
    function SumbitScheme() {
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ schemeId: $("#SchemeId").val() }),
            url: "/Scheme/ActivateScheme",
            success: function (data) {
                if (data != null && data != '') {
                    if (data == true) {
                        alertify.success("Scheme activated successfully");
                        window.location.href = '@Url.Action("Manage", "Scheme")';

                    }
                    else {
                        alertify.error("Scheme is not activated.");
                    }
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }
        });
    }

    

    function RebindDepartmentDdl() {
        $("#quotaDepartmentId").data("kendoDropDownList").dataSource.read();
        $("#rebatedepartment").data("kendoDropDownList").dataSource.read();
        $("#depttID").data("kendoDropDownList").dataSource.read();
        $("#LandDevelopmentDepartmentId").data("kendoDropDownList").dataSource.read();
    }
