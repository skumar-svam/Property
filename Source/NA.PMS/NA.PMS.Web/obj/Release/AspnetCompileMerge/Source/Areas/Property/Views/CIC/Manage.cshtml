@using Kendo.Mvc.UI;
@model NA.PMS.Model.CICViewModel

@{
    ViewBag.Title = "Manage CIC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="ManageCic">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Change In Constitution</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                <a href="/Property/CIC/AddCIC" class="" target="_blank">Add Request</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12" style="border:solid #e2e3e4; border-width:0 1px 0 1px">
        <ul class="nav nav-tabs content-tabs" id="ulProperty" role="tablist">
            <li class="active"><a href="#one" role="tab" data-toggle="tab">Directors/Shareholders</a></li>
            <li><a href="#two" role="tab" data-toggle="tab">Firm Name/Status/Product Name</a></li>
        </ul>
    </div>
    <div class="col-md-12 tab-content">
        <div class="tab-pane fade in active" id="one">
            <div class="k-grid-content">
                <h2 class="blck-heading-grid">Change In Directors (CID)</h2>
                @(Html.Kendo().Grid<NA.PMS.Model.CICViewModel>()
                      .Name("gridDirectorList")
                      .Columns(columns =>
                      {
                          columns.Bound(c => c.Id).Hidden(true);
                          //columns.Bound(c => c.DirectorId).Title("Request No").Width(130).ClientTemplate("<a href='" + "/Property/CIC/ViewCIC/" + "?ReqID=#= Director_Id #&Type=#=Change_Type#'" + ">#=Director_Id#</a>");
                          columns.Bound(c => c.RegistrationId).Title("Registration Id").Width(150);
                          columns.Bound(c => c.Department).Title("Department");
                          columns.Bound(c => c.Sector).Title("Sector").Width(100);
                          columns.Bound(c => c.Block).Title("Block").Width(100);
                          columns.Bound(c => c.PlotNo).Title("Plot No").Width(130);
                          columns.Bound(c => c.RequestDate).Title("Request Date").Format("{0:dd/MM/yyyy}");
                          columns.Bound(c => c.ApprovedDate).Title("Approved Date").Format("{0:dd/MM/yyyy}");
                          //columns.Bound(c => c.AssignTo).Title("Assigned To");
                          columns.Bound(c => c.CICStatus).Title("Status");
                          //columns.Bound(c => c.ChangeTypeName).Hidden(true);
                          //columns.Bound(c => c.RegistrationId).ClientTemplate("<label onclick='javascript:GenerateLetter(this)' class='hyperlinkcss'>Print Challan</label>").Width(120).Title("Action").Filterable(false);
                      })
                      .Sortable().Filterable().Resizable(resize => resize.Columns(true))
                      .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                      .ClientDetailTemplateId("director-template").AutoBind(true)
                      .DataSource
                      (
                         dataSource => dataSource
                        .Ajax().Model(model => model.Id(p => p.Id))
                        .ServerOperation(true).Sort(sort => sort.Add(s => s.Id).Descending())
                        .Read(read => read.Action("GetDirectorAndShareholderListAsDataSource", "CIC", new { area="Property", ActionType="Director"}))
                        .PageSize(10)
                      )
                )
            </div>

            <script id="director-template" type="text/kendo-tmpl">
                @(Html.Kendo().Grid<NA.PMS.Model.CICViewModel>()
                    .Name("grid_#=Id#") // template expression, to be evaluated in the master context
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.Id).Hidden(true);
                        columns.Bound(c => c.DirectorName).Title("Director/Shareholder");
                        columns.Bound(c => c.DirectorShare).Title("Share(%)").Width(120);
                        columns.Bound(c => c.TypeName).Title("Type").Width(150);
                        columns.Bound(c => c.RequestDate).Title("Request").Width(120).Format("{0:dd-MMM-yyyy}");
                        columns.Bound(c => c.ApprovedDate).Title("Approved").Width(120).Format("{0:dd-MMM-yyyy}");
                        columns.Bound(c => c.CICStatus).Title("Status").Width(120);
                        //columns.Bound(o => o.RequestDate).Format("{0:dd/MM/yyyy}").Width(120);
                    })
                    .DataSource(dataSource => dataSource
                        .Ajax().PageSize(10)
                        .Read(read => read.Action("GetDirectorAndShareholderListAsDataSource", "CIC", new {area="Property", RegistrationId = "#=RegistrationId#", ActionType = "DirectorList"}))
                    )
                    .ToClientTemplate()
                )
            </script>
            <script>
                function dataBound() {
                    this.expandRow(this.tbody.find("tr.k-master-row").first());
                }
            </script>
        </div>

        <div class="tab-pane fade" id="two">
            <div class="k-grid-content">
                <h2 class="blck-heading-grid">Change In Firm Name/Firm Status/Product Name</h2>
                @(Html.Kendo().Grid<NA.PMS.Model.CICViewModel>()
                      .Name("gridFirmProductStatus")
                      .Columns(columns =>
                      {
                          //columns.Bound(c => c.Director_Id).Width(150).ClientTemplate("<a href='" + "/Property/CIC/FirmViewCIC/#= Director_Id #'>#=Director_Id#</a>").Width(70).Filterable(false);
                          columns.Bound(c => c.Id).Title("RegistrationId").Width(150).ClientTemplate("<a href='" + "/Property/CIC/ViewCIC/" + "?ReqID= #=Id# & Type=#=TypeId#'" + ">#=RegistrationId#</a>");
                          //columns.Bound(c => c.RegistrationId).Title("Registration Id").Width(140);
                          columns.Bound(c => c.Department).Title("Department").Width(150);
                          columns.Bound(c => c.Sector).Title("Sector").Width(100);
                          columns.Bound(c => c.Block).Title("Block").Width(100);
                          columns.Bound(c => c.PlotNo).Title("PlotNo").Width(110);
                          columns.Bound(c => c.CICCharge).Title("Charge(Rs)").Width(120);
                          columns.Bound(c => c.RequestDate).Title("Requested").Width(150).Format("{0:dd-MMM-yyyy}");
                          columns.Bound(c => c.ApprovedDate).Title("Approved").Width(150).Format("{0:dd-MMM-yyyy}");
                          //columns.Bound(c => c.AssignTo).Title("AssignedTo");
                          columns.Bound(c => c.CICStatus).Title("Status").Width(110);
                          //columns.Bound(c => c.RegistrationId).ClientTemplate("<label onclick='javascript:GenerateFirmnProductLetter(this)' class='hyperlinkcss'>Print Challan</label>").Width(120).Title("Action").Filterable(false);
                      })
                      .Sortable().Filterable().Resizable(resize => resize.Columns(true))
                      .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                      .DataSource
                      (
                         dataSource => dataSource
                            .Ajax().Model(model => model.Id(p => p.Id))
                            .ServerOperation(true).Sort(sort => sort.Add("Id").Descending())
                            .Read(read => read.Action("GetFirmAndProductNameListAsDataSource", "CIC", new { area="Property"}))
                            .PageSize(10)
                      )
                )
            </div>
        </div>
    </div>



    <div id="divPrintLetters" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
        <div class="modal-dialog" style="width: 60%;">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">  <b>Letter</b></h4>
                </div>
                <div class="modal-body" style="overflow:auto; height:400px;">
                    <div id="divLetterBody"></div>
                </div>
                <div class="modal-footer" style="text-align: center;">
                    <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv();">Print</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function AddRequest(event) {
        event.preventDefault();
        window.location.href = '@Url.Action("AddCIC", "CIC")';
    }

    function GenerateLetter(row) {
        var tr = $(row).parent().parent();
        var rIds = $(tr).children("td:eq(1)").text();
        var directorID = $(tr).children("td:eq(2)").text();
        if (rIds.length > 0) {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ ridList: rIds, directorID: directorID }),
                url: '/DocParser/PrintCICChallan',
                success: function (result) {
                    $("#divLetterBody").html(result);
                    $("#divPrintLetters").modal('show');
                },
                error: function (obj) {
                    alertify.error("Some error occured. Please try again later.");
                }
            });
        } else {
            alertify.error("Please select atleast one record to print Functional Challan.");
        }
    }


    function GenerateFirmnProductLetter(row) {
        var tr = $(row).parent().parent();
        var rIds = $(tr).children("td:eq(1)").text();
        var directorID = $(tr).children("td:eq(2)").text();
        if (rIds.length > 0) {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ ridList: rIds, directorID: directorID }),
                url: '/DocParser/PrintCICFirmnProductChallan',
                success: function (result) {
                    $("#divLetterBody").html(result);
                    $("#divPrintLetters").modal('show');
                },
                error: function (obj) {
                    alertify.error("Some error occured. Please try again later.");
                }
            });
        } else {
            alertify.error("Please select atleast one record to print Functional Challan.");
        }
    }

</script>