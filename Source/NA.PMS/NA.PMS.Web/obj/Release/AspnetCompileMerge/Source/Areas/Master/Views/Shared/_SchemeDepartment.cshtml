@model NA.PMS.Model.SchemeViewModel
@using Kendo.Mvc.UI;

<div class="DeaprtmentForm">

    <div class="row" id="deptDetail">
        <h2 class="blck-heading">Department Information</h2>
        <div class="scheme-form-bx col-md-12 col-sm-12 col-xs-12">          
            <div class="row">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label class="required">Department</label>
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                        .Name("DDLDepartmentId")
                        .DataTextField("text")
                        .DataValueField("id")
                        .Filter("contains")
                        .OptionLabel("Select")
                        .DataSource(source =>source.Read(read =>read.Action("GetAllDepartments", "Scheme")))
                        .Events(m => m.Change("DepartmentChangeEvent"))
                        .HtmlAttributes(new { style = "width:100%" })
                    )
                    @Html.ValidationMessageFor(model => model.DepartmentId, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label class="required">Normal Interest</label>
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @Html.TextBoxFor(model => model.NormalInterest, htmlAttributes: new { @class = "form-control InterestRateCheck", @maxlength = "5" })
                    @Html.ValidationMessageFor(model => model.NormalInterest, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class=" row">

                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label class="required">Penal Interest</label>
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @Html.TextBoxFor(model => model.PenalInterest, htmlAttributes: new { @class = "form-control InterestRateCheck", @maxlength = "5" })
                    @Html.ValidationMessageFor(model => model.PenalInterest, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label class="required">Frequency</label>
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().DropDownListFor(m => m.FrequencyId)
                        .DataTextField("text")
                        .DataValueField("id")
                        .OptionLabel("Select")
                        .Filter("contains")
                        .DataSource(source =>source.Read(read =>read.Action("GetAllFrquency", "Scheme")))
                        .HtmlAttributes(new { style = "width:100% " })
                    )

                    @Html.ValidationMessageFor(model => model.FrequencyId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class=" row">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label class="required">No of Installment</label>
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @Html.TextBoxFor(model => model.InstallmentNo, new { @class = "textBoxValueRightAlign form-control", @maxlength = "3", style = "width:100%" })
                    @Html.ValidationMessageFor(model => model.InstallmentNo, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label class="required">Selection Type</label>
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().DropDownListFor(m => m.SelectionTypeId)
                        .DataTextField("text")
                        .DataValueField("id")
                        .OptionLabel("Select")
                        .Filter("contains")
                        .DataSource(source =>source.Read(read =>read.Action("GetAllSelectionType", "Scheme")))
                        .HtmlAttributes(new { style = "width:100%" })
                    )
                </div>
            </div>

            <div class="row row-non-housing" id="divRowAllotment">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label class="required">Allotment Money</label>
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="allotmentmoneydiv">
                    @(Html.Kendo().NumericTextBoxFor(m => m.AllotmentMoney)
                        .Min(0).Spinners(false).Step(0)
                        .Enable(true)
                        .HtmlAttributes(new { style = "width: 100%;", @maxlength = "5", @class = "k-label textBoxValueRightAlign", onblur = "AllotmentInstallmentMoneyCal('allotmentmoney');" })
                    )
                    @Html.ValidationMessageFor(model => model.AllotmentMoney, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label class="required">Installment Money</label>
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().NumericTextBoxFor(m => m.InstallmentMoney)
                        .Min(0).Spinners(false).Step(0)
                        .Enable(true)
                        .HtmlAttributes(new { style = "width: 100%", onblur = "AllotmentInstallmentMoneyCal('installmentmoney');", @maxlength = "5", @class = "k-label textBoxValueRightAlign" })
                    )
                    @Html.ValidationMessageFor(model => model.InstallmentMoney, "", new { @class = "text-danger" })
                </div>

            </div>

            <div class="row row-non-housing" id="divRowFloorAreaRatio">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label class="required">Floor Area Ratio</label>
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().NumericTextBoxFor(model => model.FloorAreaRatio)
                        .Min(0).Spinners(false).Step(0)
                        .Enable(true)
                        .HtmlAttributes(new { style = "width: 100%", @class = "textBoxValueRightAlign", @maxlength = "5", onblur = "AllotmentInstallmentMoneyCal('floorArearatio');" })
                    )
                    @Html.ValidationMessageFor(model => model.FloorAreaRatio, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    <label class="required">Lease Rent</label>
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().NumericTextBoxFor(m => m.LeaseRent)
                        .Min(0).Spinners(false).Step(0)
                        .Enable(true)
                        .HtmlAttributes(new { style = "width: 100%", @id = "txtdepttleaseRent", @class = "textBoxValueRightAlign", @maxlength = "5" })
                    )
                    @Html.ValidationMessageFor(model => model.LeaseRent, "", new { @class = "text-danger" })
                </div>
            </div>

        </div>

    </div>

    <div class="row backward-forward">
        <div class="col-md-4 col-sm-4 col-xs-4 text-left">
            <button type="button" class="btn btn-add" value="Add" id="btnPre2">Previous <i class="glyphicon glyphicon-backward"></i></button>
        </div>
        <div class="col-md-4 col-sm-4 col-xs-4 text-center">
            <button type="button" class="btn btn-add" value="Add" id="btnAddDeptt"> Add</button>
        </div>
        <div class="col-md-4 col-sm-4 col-xs-4 text-right">
            <button type="button" class="btn btn-add" value="Add" id="btnNext2">Next <i class="glyphicon glyphicon-forward"></i></button>
        </div>
    </div>
   
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 k-grid-content" style="margin-bottom:10px;">
        <div class="">
            @(Html.Kendo().Grid<NA.PMS.Model.Department>()
                .Name("gridDepartment")
                .Columns(columns =>
                {
                    columns.Bound(c => c.departmentName).Title("Department");
                    columns.Bound(c => c.departmentId).Hidden(true);
                    columns.Bound(c => c.normalInterest).Title("Normal Interest");
                    columns.Bound(c => c.penalInterest).Title("Penal Interest");
                    columns.Bound(c => c.frequencyName).Title("Frequency");
                    columns.Bound(c => c.frequency).Hidden(true);
                    columns.Bound(c => c.noInstallment).Title("Max no. of Installment");
                    columns.Bound(c => c.allotmentmoney).Title("Allotment Money");
                    columns.Bound(c => c.installmentmoney).Title("Installment Money");
                    columns.Bound(c => c.leaseRent).Title("Lease Rent");
                    columns.Bound(c => c.floorArearatio).Title("FAR");
                    columns.Bound(c => c.SelectionType).Title("Selection Type");
                    if (ViewBag.view != "Yes")
                    {
                        columns.Bound(c => c.refId).Title("Action").HeaderHtmlAttributes(new { @class = "removeColumnHeader" }).ClientTemplate("<a onclick='javascript:RemoveDepttRecord(\"#=refId#\");' class='schemeMasterGrids'>Remove</a>").Filterable(false).Sortable(false);
                    }
                })
                .Sortable().Filterable().Pageable(pageable => pageable.Enabled(true).PageSizes(true))
                .AutoBind(true)
                .DataSource
                (
                     dataSource => dataSource
                    .Ajax().ServerOperation(true).Model(model => model.Id(p => p.refId))                    
                    .Read(read => read.Action("GetDepttData", "Scheme").Data("AdditionalData")).PageSize(10)
                 )
            )
        </div>
        <div class="row scheme-rw-btn">
            <div class="col-md-4 col-sm-4 col-xs-4 text-left">
                <button type="button" class="btn btn-add" value="Add" id="btnPre21">Previous <i class="glyphicon glyphicon-backward"></i></button>
            </div>
            <div class="col-md-4 col-sm-4 col-xs-4 text-center">

            </div>
            <div class="col-md-4 col-sm-4 col-xs-4 text-right">
                <button type="button" class="btn btn-add" value="Add" id="btnNext21">Next <i class="glyphicon glyphicon-forward"></i></button>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript">
    function DepartmentChangeEvent() {
        var departmentID = $('#DDLDepartmentId').val();
        var schemeID = $("#SchemeId").val();
        if (departmentID == 5) {
            $('.row-non-housing').css("display","none");                      
        }
        else {
            $('.row-non-housing').show();
            if (departmentID == 2) {
                $("#lblInstallFre").html('Installment Frequency');
            }
            else
                $("#lblInstallFre").html('Frequency');          
        }
    }

    function CheckInterestRate(rate){
        if(rate > 99.99 || rate < -1){
            alertify.error("Interest rate can't be more than 99.99");
            return false;
        }
        else{
            return true;
        }
    }

    $(".InterestRateCheck").blur(function(){
        var rate = $('#InterestRateCheck').val();
        CheckInterestRate(rate);
    })

    $(document).ready(function () {
        $('#btnNext2').attr('disabled', 'disabled');
        $('#btnPre2').attr('disabled', 'disabled');
        DepartmentChangeEvent();
        //$("#btnAddDeptt").removeAttr('disabled');
        $("#btnAddDeptt").click(function () {
            
        });
        $('#btnNext2').click(function () {
            $("#acc3").click();
        });
        $('#btnPre2').click(function () {
            $("#acc1").click();
        });
        $('#btnNext21').click(function () {
            //debugger;
            $("#acc3").click();
        });
        $('#btnPre21').click(function () {
            $("#acc1").click();
        });
    });

    function SubmitSchemeDepartmentForm(){
        var flag = ValidateSchemeDepartmentInputFields();
        if (flag == true) {
            var SchemeDepartment={
                SchemeId : $("#SchemeId").val(),
                SelectionTypeId: $("#SelectionTypeId").val(), 
                DepartmentId : $('#departmentId').val(),
                LeaseRent : $("#LeaseRent").val(),
                NormalInterest: $("#NormalInterest").val(),
                PenalInterest: $("#PenalInterest").val(),
                FrequencyId: $("#FrequencyId").val(),
                TotalInstallment: $("#TotalInstallment").val(),
                AllotmentMoney: $("#AllotmentMoney").val(),
                InstallmentMoney: $("#InstallmentMoney").val(),
                FloorAreaRatio: $("#FloorAreaRatio").val()
            };
            
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ departmentID: departmentID, schemeID: schemeID }),
                url: '/Scheme/IsDepatmnetNameUnique',
                success: function (result) {
                    if (result == true) {
                        alertify.error("This Department already exists");
                        //$("#btnAddDeptt").removeAttr('disabled');
                        return false;
                    }
                    else {
                        var $form = $("form");
                        if ($form.valid()) {
                            $.ajax({
                                dataType: 'json',
                                type: 'Post',
                                contentType: 'application/json; charset=utf-8',
                                data: JSON.stringify({  model: SchemeDepartment }),
                                url: "/Scheme/AddDeptt",
                                success: function (data) {
                                    if (data == true) {
                                        ClearSchemeDepartmentInputFields()
                                        alertify.success("Data added successfully");
                                        //RebindDepartmentDdl();
                                        setTimeout(function () { ActivateScheme(); }, 2000);
                                        //$("#btnAddDeptt").removeAttr('disabled');
                                    }
                                    else{
                                        alertify.error("This Department already exists");
                                        //$("#btnAddDeptt").removeAttr('disabled');
                                    }
                                },
                                error: function (objAjaxRequest, strError) {
                                    var respText = objAjaxRequest.responseText;
                                    //$("#btnAddDeptt").removeAttr('disabled');
                                    //alert(respText);
                                }
                            });
                        }
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //$("#btnAddDeptt").removeAttr('disabled');
                    //alert(respText);
                }

            });
            //commented code.
        }
    }

    function RemoveDepttRecord(refId) {
        var schemeID = $("#SchemeId").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ refId: refId, schemeID: schemeID }),
            url: '/Scheme/RemoveDepttRecord',
            success: function (result) {
                if (result == true) {
                    $("#gridDepartment").data("kendoGrid").dataSource.read();
                    var gridDepartment = $("#gridDepartment").data("kendoGrid").dataSource.data();
                    if (gridDepartment.length == 1) {
                        IsSchemeCompletedByRemove(false);
                    }
                    alertify.success("Record deleted successfully.");
                }
                else {
                    alertify.error("Department can't be deleted as a dependent Quota, Rebate or Cost exists for it.");
                }
            },
            error: function (obj) {
                //alert('Error While Saving Record.');
            }
        });
    }


    function ValidateSchemeDepartmentInputFields() {
        if ($('#DDLDepartmentId').val() == "") {
            alertify.error('Please Select Department');
            return false;
        }
        else if ($('#NormalInterest').val() == "") {
            alertify.error('Please Select Normal Interest');
            return false;
        }
        else if ($('#PenalInterest').val() == "") {
            alertify.error('Please Select Penal Interest');
            return false;
        }
        else if ($('#FrequencyId').val() == "") {
            alertify.error('Please Select Frequency');
            return false;
        }
        else if ($('#SelectionTypeId').val() == "") {
            alertify.error('Please Select Selection Type');
            return false;
        }

        else if ($('#TotalInstallment').val().trim() == "") {
            alertify.error('Please Maximum No. of Installment');
            return false;
        }

        else if ($('#DDLDepartmentId').val() != 5) {
            var total = parseFloat($("#InstallmentMoney").val()) + parseFloat($("#AllotmentMoney").val())

            if($('#TotalInstallment').val().trim()=="")
            {
                alertify.error('Please enter Maximum No. of Installment.');
                return false;
            }
            else if($("#AllotmentMoney").val()=="")
            {
                alertify.error('Please enter allotment money.');
                return false;
            }
            else if($("#InstallmentMoney").val()=="")
            {
                alertify.error('Please enter Installment money.');
                return false;
            }
            else if ($("#FloorAreaRatio").val().trim() == "") {
                alertify.error('Please enter Floor Area Ratio.');
                return false;
            }
            else if($('#LeaseRent').val() == "")
            {
                alertify.error('Please enter Lease Rent.');
                return false;
            }
            else if (total != 100) {
                alertify.error('Sum of Allotment Money % and Installment Money % should be equal to 100%.');
                return false;
            }
            else if ($("#FloorAreaRatio").val().trim() > 100) {
                alertify.error('Floor Area Ratio should be less then 100 percents');
                return false;
            }
            else if($('#LeaseRent').val() > 100)
            {
                alertify.error("Department Lease Rent Should be between 0 to 100");
                return false;
            }
        }
        return true;
    }

    function AllotmentInstallmentMoneyCal(controlID) {
        if (controlID == "allotmentmoney") {
            var allotmentmoney = (isNaN(parseFloat($('#allotmentmoney').val()))) ? 0 : parseFloat($('#allotmentmoney').val());
            if (allotmentmoney != 0) {
                if(allotmentmoney>=100)
                {
                    alertify.error("Allotment money value should be between 0 to 99");
                    $("#allotmentmoney").data("kendoNumericTextBox").value(99);
                    var allotmentmoney1 = (isNaN(parseFloat($('#allotmentmoney').val()))) ? 0 : parseFloat($('#allotmentmoney').val());
                    var totalMoney = parseFloat((100.00 - parseFloat(allotmentmoney1)).toFixed(2));
                    $("#installmentmoney").data("kendoNumericTextBox").value(totalMoney);
                }
                else{
                    var totalMoney = parseFloat((100.00 - parseFloat(allotmentmoney)).toFixed(2));
                    $("#installmentmoney").data("kendoNumericTextBox").value(totalMoney);
                }
            }
        }
        else if (controlID == "installmentmoney") {
            var installmentmoney = (isNaN(parseFloat($('#installmentmoney').val()))) ? 0 : parseFloat($('#installmentmoney').val());
            if (installmentmoney != 0) {
                if(installmentmoney>=100)
                {
                    alertify.error("Installment money value should be between 0 to 99");
                    $("#installmentmoney").data("kendoNumericTextBox").value(99);
                    var installmentmoney1 = (isNaN(parseFloat($('#installmentmoney').val()))) ? 0 : parseFloat($('#installmentmoney').val());
                    var totalallotmentMoney = parseFloat((100.00 - parseFloat(installmentmoney1)).toFixed(2));
                    $("#allotmentmoney").data("kendoNumericTextBox").value(totalallotmentMoney);
                }
                else{
                    var totalallotmentMoney = parseFloat((100.00 - parseFloat(installmentmoney)).toFixed(2));
                    $("#allotmentmoney").data("kendoNumericTextBox").value("");
                    $("#allotmentmoney").data("kendoNumericTextBox").value(totalallotmentMoney);
                }
            }
        }
        else if (controlID == "floorArearatio") {
            var floorArearatio = (isNaN(parseFloat($('#floorArearatio').val()))) ? 0 : parseFloat($('#floorArearatio').val());
            if (floorArearatio != 0) {
                if(floorArearatio>=100)
                {
                    alertify.error("Floor Area Ratio value should be between 0 to 99");
                    $("#floorArearatio").data("kendoNumericTextBox").value(99);
                }
            }
        }
        else if (controlID == "txtdepttleaseRent") {
            var txtdepttleaseRent = (isNaN(parseFloat($('#txtdepttleaseRent').val()))) ? 0 : parseFloat($('#txtdepttleaseRent').val());
            if (txtdepttleaseRent != 0) {
                if(txtdepttleaseRent>=100)
                {
                    alertify.error("Department Lease Rent Should be between 0 to 100");
                    //$("#txtdepttleaseRent").data("kendoNumericTextBox").value(100);
                }
            }
        }
    }

    function ClearSchemeDepartmentInputFields(){
        $("#NormalInterest").val("");
        $("#PenalInterest").val("");
        $("#FrequencyId").data("kendoDropDownList").value("");
        $("#SelectionTypeId").data("kendoDropDownList").value("");
        $("#InstallmentNo").val("");
        $("#FloorAreaRatio").data("kendoNumericTextBox").value("");
        $("#Installmentmoney").data("kendoNumericTextBox").value("");
        $("#Allotmentmoney").data("kendoNumericTextBox").value("");
        $("#FloorAreaRatio").data("kendoNumericTextBox").value("");
        $("#LeaseRent").data("kendoNumericTextBox").value("");
    }
</script>
