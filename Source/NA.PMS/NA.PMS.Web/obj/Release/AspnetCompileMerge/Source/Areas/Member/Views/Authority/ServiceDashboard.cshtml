@using Kendo.Mvc.UI
@using NA.PMS.Common
@using System.Linq

@{
    ViewBag.Title = "ServiceDashboard";
    var userInfo = HttpContext.Current.Session["CurrentUser"] as NA.PMS.Web.Models.CurrentUserDetail;
    if (userInfo != null)
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Blank.cshtml";
    }
}

<style>
    .grid-header {
        text-align: center;
    }

    .hyperlink {
        color: darkblue;
        font: bold;
    }

    .HeadBackClr {
        background-color: aliceblue;
    }

    .TotalBackClr {
        background-color: #e7e7e7;
    }

    .compBackClr {
        background-color: #00B050;
    }

    .compBeyondBackClr {
        background-color: #00B050;
    }

    .withdrawnBackClr {
        background-color: #fd360a;
    }

    .RejectBackClr {
        background-color: #ee1616;
    }

    .objectionBackClr {
        background-color: #e08e0b;
    }

    .pendingwithinBackClr {
        background-color: #ff8d00;
    }

    .MoreThanMonthBackClr {
        background-color: #c3491c;
    }

    .MoreThanWeekBackClr {
        background-color: coral;
    }

    .MoreThanFortnightBackClr {
        background-color: orangered;
    }

    .k-grid tr td {
        border-bottom: 0.2px solid white;
        border-right: 0.2px solid white;
        text-align: center;
    }

    .k-grid tr th {
        border: 0.2px solid white;
    }

    .k-grid .k-grid-header .k-header .k-link {
        overflow: visible !important;
        white-space: normal !important;
        text-align: center;
        /*color: white;*/
    }

    .btn_successround {
        /*background-color: #63d827;*/
        color: white;
        border-color: #ddd;
        border-radius: 100%;
    }
    .btn_total{
        color: black;
        border-color: #ddd;
        border-radius: 100%;
    }
    .k-grid tbody .k-button {
        /*min-width: 50px;*/
    }

    .k-grid-header th.k-header {
        background: #78c3b9;
    }
    .blck-heading{
        border:1px solid white;
        margin-bottom:0;
        color:black;
        background:#78c3b9;
    }
    .k-footer-template td{
        background:#78c3b9;
        color:black;
    }
    .textBTN{min-width: 40%;
    text-align: center;
    max-width: 55%;
    border: white;
    
    }
</style>

<div id="div-graph-services">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Service Status Report</h1></div>
        </div>
    </div>
    <div class="col-md-12  blnk-rw" ></div>
    <div class="row" >
        <div class="col-md-3" style="padding:10px;">
            <label>Start Date</label>
            @(Html.Kendo().DatePicker().Name("TimelineServiceStartDate")
                    .Events(e => e.Change("TimelineServiceChangeEvent"))
                    .HtmlAttributes(new { style = "width:90%;" })
            )
        </div>
        <div class="col-md-3" style="padding:10px;">
            <label>End Date</label>
            @(Html.Kendo().DatePicker().Name("TimelineServiceEndDate")
                    .Events(e => e.Change("TimelineServiceChangeEvent"))
                    .HtmlAttributes(new { style = "width:90%;" })
            )
        </div>
        <div class="col-md-3" style="padding:10px;">
            <label>Request Type</label>
            @(Html.Kendo().DropDownList()
                  .Name("DDLRequestType")
                  .DataTextField("Text")
                  .DataValueField("Value")
                  .OptionLabel(" --- Select ---")
                  .BindTo(new List<SelectListItem>() {
                      new SelectListItem() { Text = "Online", Value = "Online" },
                      new SelectListItem() { Text = "JSK", Value = "JSK" },
                      new SelectListItem() { Text = "NIC Nivesh Mitra", Value = "NIC Nivesh Mitra" }
                  })
                  .Value("Online")
                  .HtmlAttributes(new { style = "width: 90%;" })
                  .Events(e => e.Change("TimelineRequestTypeChangeEvent"))
            )
        </div>
        <div class="col-md-3 form-group" style="padding-top:30px;">
            <input type="button" id="btnTimeline" value="Citizen Charter Timeline" class="btn btn-default btnclass" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-12" style="margin-top:20px;">
            <div class="row rw-spce">
                <div class="col-md-12">
                    <input type="hidden" id="DeptId" />
                    @*<h2 class=" blck-heading" style="border-left:1px solid white;border-right:1px solid white;margin-bottom:0;color:white;background-color:#3f3f92;" id="ServiceHead">Timeline Of Services ( Online and JSK )</h2>*@
                    <h2 class=" blck-heading" style="" id="ServiceHead">Timeline Of Services ( Online & JSK )</h2>
                    <div class="col-md-12 k-grid-content" >
