                                info.Bound(c => c.PendingMoreThanWeek).Title("More Than a Week").ClientFooterTemplate("#=sum#").ClientTemplate("<input type='text' value='#= PendingMoreThanWeek #' class='textBTN btn_successround MoreThanWeekBackClr' readonly='readonly'>").HtmlAttributes(new { @class = "" });//.HeaderHtmlAttributes(new { style = "background-color:#fa8072;" })MoreThanWeekBackClr
                                info.Bound(c => c.PendingMoreThanFortNight).Title("More Than Fortnight").ClientFooterTemplate("#=sum#").ClientTemplate("<input type='text' value='#= PendingMoreThanFortNight #' class='textBTN btn_successround MoreThanFortnightBackClr' readonly='readonly'>").HtmlAttributes(new { @class = "" });//.HeaderHtmlAttributes(new { style = "background-color:#ff0000;" })MoreThanFortnightBackClr
