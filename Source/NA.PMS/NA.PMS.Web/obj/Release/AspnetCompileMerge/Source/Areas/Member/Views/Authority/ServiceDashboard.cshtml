                        columns.Group(g =>
                            g.Title("Pending").HeaderHtmlAttributes(new { style = "text-align: center;" })//background-color:orange;
                            .Columns(info =>
                            {
                                info.Bound(x => x.PendingWithTime).Title("Within Time").ClientTemplate("<input type='button' value='#= PendingWithTime #' class='k-button btn_successround pendingwithinBackClr' onclick='javascript:ServiceDetailsByServiceId(#= DepartmentId #,#= ServiceId #,4)'>").ClientFooterTemplate("#=sum#").HtmlAttributes(new { @class = "" });
                                info.Bound(c => c.PendingMoreThanWeek).Title("More Than a Week").ClientTemplate("<input type='button' value='#= PendingMoreThanWeek #' class='k-button btn_successround MoreThanWeekBackClr' onclick='javascript:ServiceDetailsByServiceId(#= DepartmentId #,#= ServiceId #,5)'>").ClientFooterTemplate("#=sum#").HtmlAttributes(new { @class = "" });
                                info.Bound(c => c.PendingMoreThanFortNight).Title("More Than Fortnight").ClientTemplate("<input type='button' value='#= PendingMoreThanFortNight #' class='k-button btn_successround MoreThanFortnightBackClr' onclick='javascript:ServiceDetailsByServiceId(#= DepartmentId #,#= ServiceId #,6)'>").ClientFooterTemplate("#=sum#").HtmlAttributes(new { @class = "" });
                                info.Bound(c => c.PendingMoreThanOneMonth).Title("More Than a Month").ClientTemplate("<input type='button' value='#= PendingMoreThanOneMonth #' class='k-button btn_successround MoreThanMonthBackClr' onclick='javascript:ServiceDetailsByServiceId(#= DepartmentId #,#= ServiceId #,7)'>").ClientFooterTemplate("#=sum#").HtmlAttributes(new { @class = "" });
                                info.Bound(c => c.TotalObjection).Title("Objection").ClientTemplate("<input type='button' value='#= TotalObjection #' class='k-button btn_successround objectionBackClr' onclick='javascript:ServiceDetailsByServiceId(#= DepartmentId #,#= ServiceId #,9)'>").ClientFooterTemplate("#=sum#").HtmlAttributes(new { @class = "" });
                                //info.Group(i => i.Title("Defaulter").HeaderHtmlAttributes(new { style = "text-align: center;" })
                                //    .Columns(location =>
                                //    {
                                //        location.Bound(c => c.PendingMoreThanWeek).Title("More Than a Week").ClientTemplate("<label class='hyperlink' onclick='javascript:ServiceDetailsByServiceId(#= DepartmentId #,#= ServiceId #,5)'>#= PendingMoreThanWeek #</label>").ClientFooterTemplate("#=sum#");
                                //        location.Bound(c => c.PendingMoreThanFortNight).Title("More Than Fortnight").ClientTemplate("<label class='hyperlink' onclick='javascript:ServiceDetailsByServiceId(#= DepartmentId #,#= ServiceId #,6)'>#= PendingMoreThanFortNight #</label>").ClientFooterTemplate("#=sum#");
                                //        location.Bound(c => c.PendingMoreThanOneMonth).Title("More Than a Month").ClientTemplate("<label class='hyperlink' onclick='javascript:ServiceDetailsByServiceId(#= DepartmentId #,#= ServiceId #,7)'>#= PendingMoreThanOneMonth #</label>").ClientFooterTemplate("#=sum#");
                                //        location.Bound(c => c.TotalObjection).Title("Objection").ClientTemplate("<label class='hyperlink' onclick='javascript:ServiceDetailsByServiceId(#= DepartmentId #,#= ServiceId #,9)'>#= TotalObjection #</label>").ClientFooterTemplate("#=sum#");
                                //    })
