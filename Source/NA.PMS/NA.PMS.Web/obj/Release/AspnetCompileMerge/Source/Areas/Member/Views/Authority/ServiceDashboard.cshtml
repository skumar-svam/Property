                                info.Bound(x => x.CompletedWithinTime).Title("Within Time").ClientFooterTemplate("#=sum#").ClientTemplate("<input type='text' value='#= CompletedWithinTime #' class=' textBTN btn_successround compBackClr' readonly='readonly'>").HtmlAttributes(new { @class = ""});//.HeaderHtmlAttributes(new { style = "background-color:lawngreen;" });compBackClr
                               // info.Bound(x => x.CompletedWithinTime).Title("Within Time").ClientFooterTemplate("#=sum#").ClientTemplate("<label class='btn_successround '>#= CompletedWithinTime #</label>");
                                info.Bound(x => x.CompletedBeyondTime).Title("Beyond Time").ClientFooterTemplate("#=sum#").ClientTemplate("<input type='text' value='#= CompletedBeyondTime #' class='textBTN btn_successround compBeyondBackClr' readonly='readonly'>").HtmlAttributes(new { @class = "" });//.HeaderHtmlAttributes(new { style = "background-color:#ffa500;" })compBeyondBackClr
                                info.Bound(x => x.TotalReject).Title("Rejected").ClientFooterTemplate("#=sum#").ClientTemplate("<input type='text' value='#= TotalReject #' class='textBTN btn_successround RejectBackClr' readonly='readonly'>").HtmlAttributes(new { @class = "" });//.HeaderHtmlAttributes(new { style = "background-color:#679b67;"})RejectBackClr
                                info.Bound(x => x.WithDrawn).Title("Withdrawn").ClientFooterTemplate("#=sum#").ClientTemplate("<input type='text' value='#= WithDrawn #' class='textBTN btn_successround withdrawnBackClr' readonly='readonly'>").HtmlAttributes(new { @class = "" });//.HeaderHtmlAttributes(new { style = "background-color:#9acb32;" })withdrawnBackClr
                            })
