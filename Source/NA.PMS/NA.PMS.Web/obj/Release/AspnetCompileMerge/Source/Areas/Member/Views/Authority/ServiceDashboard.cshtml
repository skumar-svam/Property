            <div class="row rw-spce" id="ServiceDetailsDeptWise">
                <div class="col-md-12">
                    <h2 class=" blck-heading" style="border-left:1px solid green;border-right:1px solid green;margin-bottom:0;" id="service">Service Details</h2>
                    <div class="col-md-12 k-grid-content">
                        @(Html.Kendo().Grid<NA.PMS.Model.ServiceViewModel>()
                    .Name("GridSeviceDetails")
                    .Columns(columns =>
                    {
                        //columns.Bound(c => c.ServiceId).Hidden(true);
                        columns.Bound(c => c.RequestId).Title("Ref No").Width(110).ClientTemplate("<a href='" + "/Member/ServiceRequest/RequestDetail/#= RequestId #" + "' target='_blank'>#=RequestId#</a>");
                        columns.Bound(c => c.RegistrationNo).Title("RegistrationId").Width(110);
                        columns.Bound(c => c.PropertyNo).Title("Property No").Width(110);
