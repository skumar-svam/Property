                        columns.Group(g =>
                            g.Title("Completed").HeaderHtmlAttributes(new { style = "text-align: center;" })//background-color:#63d827;
                            .Columns(info =>
                            {
                                info.Bound(x => x.CompletedWithinTime).Title("Within Time").ClientTemplate("<input type='button' value='#= CompletedWithinTime #' class='k-button btn_successround compBackClr' onclick='javascript:ServiceDetailsByServiceId(#= DepartmentId #,#= ServiceId #,2)'>").ClientFooterTemplate("#=sum#").HtmlAttributes(new { @class = "" });
                                info.Bound(x => x.CompletedBeyondTime).Title("Beyond Time").ClientTemplate("<input type='button' value='#= CompletedBeyondTime #' class='k-button btn_successround compBeyondBackClr' onclick='javascript:ServiceDetailsByServiceId(#= DepartmentId #,#= ServiceId #,3)'>").ClientFooterTemplate("#=sum#").HtmlAttributes(new { @class = "" });
                                info.Bound(x => x.TotalReject).Title("Rejected").ClientTemplate("<input type='button' value='#= TotalReject #' class='k-button btn_successround RejectBackClr' onclick='javascript:ServiceDetailsByServiceId(#= DepartmentId #,#= ServiceId #,8)'>").ClientFooterTemplate("#=sum#").HtmlAttributes(new { @class = "" });
                                info.Bound(x => x.WithDrawn).Title("Withdrawn").ClientTemplate("<input type='button' value='#= WithDrawn #' class='k-button btn_successround withdrawnBackClr' onclick='javascript:ServiceDetailsByServiceId(#= DepartmentId #,#= ServiceId #,10)'>").ClientFooterTemplate("#=sum#").HtmlAttributes(new { @class = "" });
                            })
