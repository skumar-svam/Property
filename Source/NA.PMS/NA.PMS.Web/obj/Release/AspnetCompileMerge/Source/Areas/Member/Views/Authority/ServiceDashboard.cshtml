                        columns.Bound(c => c.Total).Title("Total Request").Width(110).ClientFooterTemplate("#=sum#").HtmlAttributes(new { @class = "" }).ClientTemplate("<input type='text' value='#= Total #' class='textBTN btn_total TotalBackClr' readonly='readonly'>");//.HeaderHtmlAttributes(new { style = "background-color:#00bfff;" }) TotalBackClr
                        columns.Group(g =>
                            g.Title("Completed").HeaderHtmlAttributes(new { style = "text-align: center;" })//background-color:#63d827;
