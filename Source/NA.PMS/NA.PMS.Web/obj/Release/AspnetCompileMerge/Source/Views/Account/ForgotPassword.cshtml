@using Kendo.Mvc.UI
@{
    ViewBag.Title = "ForgotPassword";
    Layout = "~/Views/Shared/_Blank.cshtml";
}

<style>
    #step1 .row {
        padding-bottom: 5px;
    }

    #step2 .row {
        padding-bottom: 5px;
    }

    #step3 .row {
        padding-bottom: 5px;
    }

    .btn {
        background-color: #00A182;
        color: #ffffff;
    }

    #step2 {
        display: none;
    }

    #step3 {
        display: none;
    }
    #mobilePad{
        display:none;
    }

    #GenerateOtp{
        display:none;
    }

    @@media (max-width:360px) {
        .col-sm-5 {
            padding-bottom: 5px;
        }

        .col-sm-4 {
            padding-bottom: 5px;
        }
    }
</style>

<div class="container-fluid" id="loginPad">
    <div class="row">
        <div class="col-sm-8 col-sm-offset-2 panel" style="min-height:400px;">
            @using (Html.BeginForm("ChangePassword","Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="row">
                    <div class="col-lg-12" style="background: #00A182;">
                        <img src="~/Content/Images/logo-noida-small.png" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-12">
                        <h4><b>Forgot Password</b></h4><hr />
                    </div>
                </div>

                <div id="step1" >
                    <div class="row form-group" style="padding-bottom:30px">
                        <div class="col-sm-3 col-sm-offset-1">
                            <label>Username</label><span class="text-danger">*</span>
                        </div>
                        <div class="col-sm-6">
                            <input type="text" id="UserName" name="UserName" class="form-control" maxlength="15"/>
                        </div>
                    </div>
                    <div class="row form-group" id="mobilePad">
                        <div class="col-sm-3 col-sm-offset-1" >
                            <label id="lbl-pad"></label>
                        </div>
                        <div class="col-sm-7">
                            <label id="numberPad"></label>
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-sm-4"></div>
                        <div class="col-sm-3">
                            <button class="btn btn-block" type="button" id="GenerateOtp"><b>Generate OTP</b></button>
                            <button class="btn btn-block" type="button" id="btnGenerateOTP"><b>Submit</b></button>
                        </div>
                        <div class="col-sm-3">
                            @Html.ActionLink("Cancel", "Login", "Account", new { @class = "btn btn-block" })
                        </div>
                    </div>
                </div>
                
                <div id="step2" style="padding-bottom:20px;">
                    <div class="row">
                        <div class="col-sm-4" style="text-align:center">
                            <label>Enter OTP</label><span class="text-danger">*</span>
                        </div>
                        <div class="col-sm-6">
                            <input type="text" id="UserInputOTP" class="form-control" />
                        </div>
                        <div class="col-sm-2">
                            <label><a href="#" id="RegenerateOTP">Regenerate OTP</a></label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-12">
                            <input type="hidden" id="GeneratedOTP" value="@ViewBag.OTP" />
                        </div>
                    </div>
                    <div class="row" style="padding-top:40px;">
                        <div class="col-sm-4"></div>
                        <div class="col-sm-3">
                            <button class="btn btn-block" id="EnteredOTP" type="button">OK</button>
                        </div>
                        <div class="col-sm-3">
                            @Html.ActionLink("Cancel", "Login", "Account", new { @class = "btn btn-block" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3 col-sm-offset-1">

                        </div>
                        <div class="col-sm-6">

                        </div>
                    </div>
                </div>

                <div id="step3" style="padding-bottom:20px;">
                    <div class="row">
                        <div class="col-sm-4 col-sm-offset-1">
                            <label>New password</label><span class="text-danger">*</span>
                        </div>
                        <div class="col-sm-6">
                            <input type="password" class="form-control" id="NewPassword" name="NewPassword" maxlength="50" minlength="8"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4 col-sm-offset-1">
                            <label>Confirm new password</label><span class="text-danger">*</span>
                        </div>
                        <div class="col-sm-6">
                            <input type="password" class="form-control" id="ConfirmNewPassword" name="ConfirmNewPassword" maxlength="50" minlength="8" />
                        </div>
                    </div>
                    <div class="row" style="padding-top:40px;">
                        <div class="col-sm-5"></div>
                        <div class="col-sm-3">
                            <button class="btn btn-block" type="submit" id="GenerateNewPassword">Submit</button>
                        </div>
                        <div class="col-sm-3">
                            @Html.ActionLink("Cancel", "Login", "Account", new { @class = "btn btn-block" })
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>

    <div class="row">
        <div class="col-sm-8 col-sm-offset-2 text-center">
            <footer>
                Copyright © @DateTime.Now.Year <b>NOIDA</b>.
            </footer>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        var otp;

        $("#btnGenerateOTP").click(function () {
            var userName = $("#UserName").val();
            $.ajax({
                url: '@(Url.Action("ValidateUserNameForgetPassword", "Account"))',
                type: 'Post',
                data: { userName: userName },
                success: function (result) {
                    if (result.username == null) {
                        //$("#mobilePad").show();
                        //$("#lbl-pad").css("display", "none");
                        //$("#numberPad").text("Invalid user name");
                        alertify.error("Enter valid username");
                    }
                    else {
                        if (result.mobileno != null) {
                            var num = JSON.stringify(result.mobileno);
                            $("#mobilePad").show();
                            $("#lbl-pad").show();
                            $("#lbl-pad").text("OTP will be sent on this No.");
                            $("#numberPad").text("XXXXXXX" + result.mobileno.slice(-3));
                            $("#btnGenerateOTP").css("display", "none");
                            $("#GenerateOtp").show();
                            $("#UserName").attr('readonly', 'true');
                        }
                        else {
                            alertify.error("Please contact administrator.");
                        }
                    }
                }
            });
        });


        @*$("#GenerateOTP").click(function () {
            var mob = /^[1-9]{1}[0-9]{9}$/;
            //alert("generate otp for forgot password");
            var userName = $("#UserName").val();
            var email = $("#Email").val();
            var mobileNo = $("#MobileNo").val();
            if (mob.test(mobileNo) == true && userName != "" && email != "") {
                $.ajax({
                    url: '@(Url.Action("ValidateUserName", "Account"))',
                    type: 'POST',
                    data: { userName: userName },
                    success: function (result) {
                        if (result == true) {
                            $.ajax({
                                url: '@(Url.Action("ResolveForgotPassword", "Account"))',
                                type: 'Post',
                                data: { name: userName, email: email, mobile: mobileNo },
                                success: function (result) {
                                    alert("OTP has been sent to Your Mobile No.");
                                    $("#step1").css("display", "none");
                                    $("#step2").show();
                                }
                            });
                        }
                        else {
                            alert("User Name or Email doesn't exists");
                            return false;
                        }
                    }
                });
            }
            else {
                alert("Please enter valid UserName, E-mail and mobile number");
            }

