        $("#GenerateOtp").click(function () {
            var userName = $("#UserName").val();
            var email = null;
            var mobileNo = null;
            if (userName == "") {
                //alertify.dialog('alert').set({ transition: 'slide', message: 'Enter valid user name.' }).show();
                alertify.error("Enter valid username");
            }
            else {
                $.ajax({
                    url: '@(Url.Action("ValidateUserNameForgetPassword", "Account"))',
                    type: 'Post',
                    data: { userName: userName },
                    success: function (result) {
                        if (result.username == null) {
                            //$("#mobilePad").show();
                            $("#lbl-pad").css("display", "none");
                            //$("#numberPad").text("Invalid user name");
                            //alertify.dialog('alert').set({ transition: 'slide', message: 'Enter valid user name.' }).show();
                            alertify.error("Enter valid username");
                        }
                        //if (result.mobileno == null) {
                        //    $("#mobilePad").show();
                        //    $("#lbl-pad").css("display", "none");
                        //    $("#numberPad").text("Please contact administrator");
                        //}
                        else {
                            $.ajax({
                                url: '@(Url.Action("ResolveForgotPassword","Account"))',
                                type: 'POST',
                                data: { name: userName, email: email, mobile: mobileNo },
                                success: function (result) {
                                    if (result == true) {
                                        //alertify.dialog('alert').set({ transition: 'slide', message: 'OTP has been sent to your registered mobile No.' }).show();
                                        alertify.success("OTP has been sent to your registered mobile No. & Email.");
                                        $("#step1").css("display", "none");
                                        $("#step2").show();
                                    }
                                    else {
                                        alertify.error("Please contact Administrator.");
                                    }
                                }
                            });

                            //if (result.mobileno != null) {
                            //    var num = JSON.stringify(result.mobileno);
                            //    $("#mobilePad").show();
                            //    $("#lbl-pad").show();
                            //    $("#lbl-pad").text("OTP will be sent");
                            //    $("#numberPad").text("XXXXXXX" + num.slice(-3));
                            //}
                            //else {
                               
                            //}
                        }
                    },
                    error: function (objAjaxRequest, strError) {
                        var respText = objAjaxRequest.responseText;
                        //alert(respText);
                    }
                });
            }
        });

        $("#RegenerateOTP").click(function () {
            $.ajax({
                url: '@(Url.Action("RegenerateOTP","Account"))',
                type: 'POST',
                success: function (result) {
                    if (result == true) {
                        alertify.success("OTP has been sent to Your Mobile No. & Email");
                        $("#step1").css("display", "none");
                        $("#step2").show();
                    }
                    else {
                        alertify.success("Please contact administrator.");
                    }
                }
            });
                                      
        });

        $("#EnteredOTP").click(function () {
            var inputUserOTP = $("#UserInputOTP").val();
            $.ajax({
                url: '@Url.Action("VerifyOTP","Account")',
                type: 'POST',
                data: { otp: inputUserOTP },
                success: function (result) {
                    if (result == true) {
                        $("#step2").css("display", "none");
                        $("#step3").show();
                    }
                    else {
                        alertify.error("Incorrect OTP. Please enter again.");
                        return false;
                    }
                }
            });
        });

        $("#GenerateNewPassword").click(function () {
            var validPassword = /^((?=.*\d)(?=.*[A-Z])(?=.*\W).{8,255})$/;
            var password = $("#NewPassword").val();
            var cnfPassword = $("#ConfirmNewPassword").val();
            //var value = '@Request.RequestContext.HttpContext.Session["UserEmail"]';
            if (validPassword.test(password) == true) {
                if (password != "" && cnfPassword != "") {
                    if (password == cnfPassword) {
                        $.ajax({
                            url: '@(Url.Action("CreateNewPassword", "Account"))',
                            type: 'POST',
                            data: { newPassword: password, confirmPassword: cnfPassword },
                            success: function (result) {
                                if (result == true) {
                                    alertify.success("Password changed successfully");
                                }
                                if (result == false) {
                                    alertify.error("Password missmatch");
                                    return false;
                                }
                            }
                        });
                    }
                    else {
                        alertify.error("Password missmatch");
                        return false;
                    }
                }
                else {
                    alertify.error("Password can't be null");
                    return false;
                }
            }
            else {
                alertify.error("Password must have atleast one Upper case, lower case, special character and min length 8 characters");
                return false;
            }
                               
        });

    })
</script>

