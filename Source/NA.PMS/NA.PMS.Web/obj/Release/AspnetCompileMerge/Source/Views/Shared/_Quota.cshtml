    {

        //alert("return" + temp);
        //return temp;
    }


    $('#UnitId').blur(function(){
        var unit = $('#UnitId').val();
        //alert(unit);
        if(unit==1){
            $('#value').attr("maxlength","10")
        }
        if(unit==2){
            $('#value').attr("maxlength","5")
        }
    });

    $('#value').blur(function(){
        var unt = $("#UnitId").val();
        var uvalu = $('#value').val();
        if(unt == 2 && (uvalu >=0 && uvalu <= 99)){
            return true;
        }
        if(unt == 1 && (uvalu >=0 && uvalu <= 9999999)){
            return true;
        }
        else{
            if(unt==1)
            {
                alertify.error('Value should be a number and between 0 to 9999999.');
                return false;
            }
            else if(unt==2)
            {
                alertify.error('Value should be a number and between 0 to 99.');
                return false;
            }
            else{
                alertify.error('Invalid entry.');
                return false;
            }
        }
    });

    $('#UnitId').change(function(){
        $('#value').val(null);
    });


</script>