@using System.Web.Optimization;
@using NA.PMS.Common.Helpers;
@{
    var displayMiniProfiler = SettingsHelper.IsMiniProfilerEnabled;
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewBag.Title</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    @Styles.Render("~/Content/others")
    @Styles.Render("~/bundles/KendoCSS")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/others")
    @Scripts.Render("~/bundles/KendoJS")

    @*<link href="~/Content/CSS/Customer/Main.css" rel="stylesheet" />*@
    @*<link href="~/Content/CSS/Customer/template-style.css" rel="stylesheet" />*@

    <link href="~/Content/CSS/CustomerTemplate.css" rel="stylesheet" />

    <link href="~/Content/CSS/responsive.css" rel="stylesheet" />
    <script src="~/Scripts/kendo.aspnetmvc.min.js"></script>

    <link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">
    <script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>

    <link href='http://fonts.googleapis.com/css?family=Open+Sans:400,300,400italic,700' rel='stylesheet' type='text/css'>
    <link href='http://fonts.googleapis.com/css?family=Lato:100,300,400,700,100italic,400italic,700italic|Abril+Fatface|Open+Sans:300italic,400italic,600italic,700italic,400,300,600,700,800' rel='stylesheet' type='text/css'>
    <style>
        body {
            background-color: #f1f4f8;
        }

        .logo-gda {
            background: rgb(0, 161, 130) url("../../Content/Images/logo-noida-small.png") no-repeat 20px center;
            height: 76px;
        }

        #loginPad {
            padding-top: 80px;
        }

        @@media (max-width:360px) {
            #loginPad {
                padding-top: 20px;
            }

            #tblLogin > h1 {
                font-size: medium;
            }
        }

        .col-10{width:10% !important;}
        .col-20{width:20% !important;}
        .col-30{width:30% !important;}
        .col-40{width:40% !important;}
        .col-50{width:50% !important;}
        .col-60{width:60% !important;}
        .col-70{width:70% !important;}
        .col-80{width:80% !important;}
        .col-90{width:90% !important;}
    </style>



</head>
<body>

    @RenderBody()

</body>
</html>
