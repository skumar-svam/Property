@model NA.PMS.Web.Models.PasswordModel
@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_Blank.cshtml";
}
<style>
    .k-textbox {
        width: 100%;
    }
    .red {
        color:red;
    }
</style>
<div class="container-fluid" style="padding-top:100px;">
    <div class="row">
        <div class="col-sm-6 col-sm-offset-3 panel">
            @using (Html.BeginForm("ChangeExpiredPassword", "Account", FormMethod.Post))
            {
                @Html.HiddenFor(mod=>mod.HiddenVal)
                <div class="row form-group">
                    <div class="col-sm-12">
                        <h3 style="text-align:center">Change Password </h3>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-sm-8 col-sm-offset-4">
                        <label>@Html.ValidationMessageFor(model => model.PasswordMessage,"", new { @class="red"})</label>
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-sm-4">
                        <label>Old password<span class="text-danger">*</span></label>
                    </div>
                    <div class="col-sm-8">
                        @Html.PasswordFor(model => model.OldPassword, new { @class = "form-control", maxlength="50", minlength="8" })
                        @Html.ValidationMessageFor(model => model.OldPassword, "", new { @class = "red" })
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-sm-4">
                        <label>New password<span class="text-danger">*</span></label>
                    </div>
                    <div class="col-sm-8">
                        @Html.PasswordFor(model => model.NewPassword, new { @class = "form-control", maxlength = "50", minlength = "8" })
                        @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "red" })
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-sm-4">
                        <label>Confirm new password<span class="text-danger">*</span></label>
                    </div>
                    <div class="col-sm-8">
                        @Html.PasswordFor(model => model.ConfirmNewPassword, new { @class = "form-control", maxlength = "50", minlength = "8" })
                        @Html.ValidationMessageFor(model => model.ConfirmNewPassword, "", new { @class = "red" })
                    </div>
                </div>
                <div class="row form-group" style="padding-top: 12px;">
                    <div class="col-sm-4"></div>
                    <div class="col-sm-8">
                        <button class="btn btn-block" id="btnSubmit" type="submit" style="background-color: #00A182; color: #ffffff;">Submit</button>
                    </div>
                    @*<div class="col-sm-4">
                        <button class="btn btn-block" type="reset" style="background-color: #00A182; color: #ffffff;">Reset</button>
                    </div>*@
                </div>
            }
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#HiddenVal").val(1);
    });
</script>
