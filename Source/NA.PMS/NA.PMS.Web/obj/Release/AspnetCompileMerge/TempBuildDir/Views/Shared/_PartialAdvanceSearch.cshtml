    $('#btnClear').click(function () {
        $('#RegistrationId').val('');
        $('#DepartmentId').data('kendoDropDownList').value('');
        $('#Sector').val('');
        $('#Block').val('');
        $('#PlotNo').val('');
        $('#Address').val('');
        $('#ApplicantMaster').val('');
        $('#Applicant').val('');
        $('#MobileNo').val('');
        $("#gridAdvanceSearch").data("kendoGrid").dataSource.read();
    });

    function AdvanceSearchAttribute() {
        var ObjAdvanceSearchDetails = {
            RegistrationId: $('#RegistrationId').val(),
            DepartmentId: $('#DepartmentId').val(),
            Sector: $('#Sector').val(),
            Block: $('#Block').val(),
            PlotNo: $('#PlotNo').val(),
            Applicant: $('#Applicant').val(),
            ApplicantMaster: $('#ApplicantMaster').val(),
            MotherName: null,
            MobileNo: $('#MobileNo').val(),
            Address: $('#Address').val(),
        };
        return ObjAdvanceSearchDetails;
