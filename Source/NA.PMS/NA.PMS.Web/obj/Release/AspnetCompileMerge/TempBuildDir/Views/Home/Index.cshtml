@using Kendo.Mvc.Extensions
@model NA.PMS.Model.AdvanceSearchModel
@{
    ViewBag.Title = "Index";
}
<script src="~/Scripts/_references.js"></script>

<div class="bg-logo"></div>
<div style="margin-top:0px">
    <div id="PropertyListHeading">
        <div class="row">
            <div class="col-md-6 col-sm-12 col-xs-12 dsh-btn" style="padding-right:5px;">
               
                <div class="row dsh-btn-rw" style="margin-top:-2%">
                    <div class="col-md-3 col-sm-4 col-xs-12 home-btns-spce">
                        <a class="dashbrd-btn icn-application" href="Property/Allotment/ManageApplication"> Application Entry </a>
                    </div>
                    <div class="col-md-3 col-sm-4 col-xs-12 home-btns-spce">
                        <a class="dashbrd-btn icn-allotment" href="Property/Allotment/ManageAllotment"> Allotment </a>
                    </div>
                    <div class="col-md-3 col-sm-4 col-xs-12  home-btns-spce">
                        <a class=" dashbrd-btn icn-noting" href="Property/PropertyRegistration/ManageNotings"> Noting </a>
                    </div>
                    <div class="col-md-3 col-sm-4 col-xs-12 home-btns-spce">
                        <a class="dashbrd-btn icn-possession" href="Property/Possession/ManagePossessionOrder"> Possession </a>
                    </div>
                    <div class="col-md-3 col-sm-4 col-xs-12 home-btns-spce">
                        <a class="dashbrd-btn icn-lease" href="Property/PropertyRegistration/ManageLeaseDeed"> Lease Deed </a>
                    </div>
                    
                    <div class="col-md-3 col-sm-4 col-xs-12 home-btns-spce">
                        <a class="dashbrd-btn icn-mortgage" href="Property/PropertyRegistration/ManageMortgage"> Mortgage </a>
                    </div>
                    <div class="col-md-3 col-sm-4 col-xs-12 home-btns-spce">
                        <a class="dashbrd-btn icn-transfer" href="Property/PropertyRegistration/ManageTransfers"> Transfer </a>
                    </div>
                    <div class="col-md-3 col-sm-4 col-xs-12 home-btns-spce">
                        <a class="dashbrd-btn icn-gpa" href="Property/PropertyRegistration/ManageGPA"> GPA </a>
                    </div>
                    <div class="col-md-3 col-sm-4 col-xs-12 home-btns-spce">
                        <a class="dashbrd-btn icn-payment" href="Property/PropertyRegistration/CreateChallan"> Payment Challan </a>
                    </div>
                    <div class="col-md-3 col-sm-4 col-xs-12 home-btns-spce">
                        @*<a class="dashbrd-btn icn-online-applications" href="Property/Allotment/ManageOnlineApplication"> Online Application </a>*@
                        <a class="dashbrd-btn icn-online-applications" href="Property/CIC/ManageCIC"> @*Online Application*@CIC </a>
                    </div>

                    <div class="col-md-3 col-sm-4 col-xs-12 home-btns-spce">
                        @*<a class="dashbrd-btn icn-online-services" href="Member/CitizenRequests/ManageCitizenRequests"> Online Services </a>*@
                        <a class="dashbrd-btn icn-online-services" href="/Member/ServiceRequest/Manage"> Services </a>
                    </div>

                    <div class="col-md-3 col-sm-4 col-xs-12 home-btns-spce">
                        <a class="dashbrd-btn icn-allotment" href="Reports/Report/VacantPropertyReport"> Vacant Property </a>
                    </div>

                    <div class="col-md-3 col-sm-4 col-xs-12 home-btns-spce">
                        <a class="dashbrd-btn icn-application" href="Online/Application/Index"> Online Application </a>
                    </div>
                    <div class="col-md-3 col-sm-4 col-xs-12 home-btns-spce">
                        <a class="dashbrd-btn icn-transfer" href="Member/Authority/ManageKYA"> KYA Form </a>
                    </div>
                    @*<div class="col-md-3 col-sm-4 col-xs-12 home-btns-spce">
                        <a class="dashbrd-btn icn-online-services" href="NIC/ManageNiveshMitra/">Nivesh Mitra Services </a>
                    </div>
                    <div class="col-md-3 col-sm-4 col-xs-12 home-btns-spce">
                        <a class="dashbrd-btn icn-checklist" href="/NIC/OnlineProperty/ManageSchemeForm"> Nivesh Mitra Form </a>
                    </div>*@
                    <div class="col-md-3 col-sm-4 col-xs-12 home-btns-spce">
                        <a class="dashbrd-btn icn-checklist" href="/NIC/NoidaAuthority/Dashboard"> Nivesh Mitra </a>
                    </div>
                </div>
                @*<div class="col-md-12 blnk-rw"></div>*@
            </div>
            <div class="col-md-1 col-sm-12 col-xs-12 dsh-btn" style="padding-left:5px;"></div>
            <div class="col-md-5 col-sm-12 col-xs-12 dsh-btn" style="padding-left:5px;">

                @using (Html.BeginForm("ForAllotmentMaster", "Home", FormMethod.Post, new { enctype = "multipart/form-data", id = "searchform" }))
                {
                    <div class="row adv-srch-bx">
                        <h1 class="gridTitle adv-srch-title">Advance Search</h1>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="row search-bx-home adv-srch-frm-bg">
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <span class="advnce-srch-lbl">Department</span>
                                        @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                                            .DataTextField("Name")
                                            .DataValueField("Value")
                                            .OptionLabel("--Select--")
                                            .Filter("contains")
                                            .Enable(true)
                                            .DataSource(source => source.Read(read => read.Action("GetDepartmentForAdvanceSearch", "PropertyAllotment", new { area="Property"})))
                                            .HtmlAttributes(new { style = "width:100%;" })
                                        )
                                    </div>
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <span class="advnce-srch-lbl">Registration ID</span>
                                        @Html.TextBoxFor(m => m.RegistrationId, htmlAttributes: new { @maxlength = "10" })
                                    </div>
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <span class="advnce-srch-lbl">Sector</span>
                                        @Html.TextBoxFor(m => m.Sector, htmlAttributes: new { @maxlength = "10" })
                                    </div>
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <span class="advnce-srch-lbl">Block</span>
                                        @Html.TextBoxFor(m => m.Block, htmlAttributes: new { @maxlength = "10" })
                                    </div>
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <span class="advnce-srch-lbl">Plot No</span>
                                        @Html.TextBoxFor(m => m.PlotNo, htmlAttributes: new { @maxlength = "10" })
                                    </div>
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <span class="advnce-srch-lbl">Name</span>
                                        @Html.TextBoxFor(m => m.Applicant, htmlAttributes: new { @maxlength = "30" })
                                    </div>
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <span class="advnce-srch-lbl">Father Name</span>
                                        @Html.TextBoxFor(m => m.ApplicantMaster, htmlAttributes: new { @maxlength = "30" })
                                    </div>
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <span class="advnce-srch-lbl">Address</span>
                                        @Html.TextBoxFor(m => m.Address, htmlAttributes: new { @maxlength = "100" })
                                    </div>
                                    <div class="col-md-6 col-sm-6 col-xs-12">
                                        <span class="advnce-srch-lbl">Mobile No</span>
                                        @Html.TextBoxFor(m => m.MobileNo, htmlAttributes: new { @maxlength = "10" })
                                    </div>

                                    <div class="col-md-12 text-center">
                                        <input type="button" id="btnAdvanceSearch" value="Search Property" class="adv-srch-bx-btn" />
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }


            </div>
            <div class="col-md-12 col-sm-12 col-xs-12 dsh-btn dsh-btn-mrgin">

                @{
                    TempData["menutest"] = "demo";
                }
            </div>
        </div>
    </div>



</div>

<script>
    
    $('#btnAdvanceSearch').click(function () {
        var Rid = $('#RegistrationId').val();
        var dept = $('#DepartmentId').val();
        var sect = $('#Sector').val();
        var blok = $('#Block').val();
        var prpt = $('#PlotNo').val();
        var addr = $('#Address').val();
        //var mName = $('#MotherName').val();
        var mName = null;
        var fName = $('#ApplicantMaster').val();
        var name = $('#Applicant').val();
        var mobile = $('#MobileNo').val();
        
        if (Rid == "" &&  dept == "" && sect == "" && blok == "" && prpt == "" && addr == ""  && fName == "" && name == "" && mobile == "") {
            alertify.error("Please select at least one field");
        }
        //if (Rid != "") {
        //    ValidateFields();
        //}
        else {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ rid: Rid, department: dept, sector: sect, block: blok, plot: prpt, mobileNumber: mobile, name: name, fatherName: fName, motherName: mName, address: addr }),
                //url: '@Url.Action("CheckDataForAdvanceSearch", "PropertyAllotment", new { area = "Property" })',
                url: '/Property/PropertyAllotment/CheckDataForAdvanceSearch',
                success: function (result) {
                    //alert(result.length);
                    //if (result.length == 0) {
                    //    alertify.error("There is no data regarding these fields");
                    //    return false;
                    //}
                    if (result == 'false' || result == 'False') {
                        alertify.error("There is no data regarding these fields");
                        return false;
                    }
                    else {
                        //window.location.href = "/Property/PropertyAllotment/AllotmentMaster?rid=" + Rid + "&department=" + dept + "&sector=" + sect + "&block=" + blok + "&plot=" + prpt + "&name=" + name + "&fatherName=" + fName + "&motherName=" + mName + "&mobileNumber=" + mobile + "&address=" + addr;
                        $('#searchform').submit();
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Something is wrong, try again later");
                }
            });
        }      
    });

    function ValidateFields() {
        var rid = /^[0-9]+$/;
        var ridt = $('#RegistrationId').val();
        if (rid.test($('#RegistrationId').val())) {
            return true;
        }
        else {
            alertify.error("Registration id should be number");
            return false;
        }
    }

    $("#RegistrationId").keydown(function (e) {
        // Allow: backspace, delete, tab, escape, enter and .
        if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110]) !== -1 ||
            // Allow: Ctrl+A, Command+A
            (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
            // Allow: home, end, left, right, down, up
            (e.keyCode >= 35 && e.keyCode <= 40)) {
            // let it happen, don't do anything
            return;
        }
        // Ensure that it is a number and stop the keypress
        if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
            e.preventDefault();
        }
    });

</script>