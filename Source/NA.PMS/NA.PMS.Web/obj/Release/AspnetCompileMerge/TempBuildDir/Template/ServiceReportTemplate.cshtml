<style>

    .text-position {
        text-align: center;
    }

    .panel-body.challan-body {
        font-size: 11px;
        font-family: Arial;
        border: 1px solid black;
        padding-top: 0;
        padding-bottom: 0;
    }

    h4 {
        margin: 0;
        padding: 0;
    }

    br {
        height: 2px;
    }

    th {
        text-align: center;
        font-size: 12px;
        font-family: Arial;
    }

    td {
        margin: 0px;
    }

    hr.challan-line {
        display: block;
        margin-top: 0;
        margin-bottom: 0;
        margin-left: auto;
        margin-right: auto;
        border-style: inset;
        border-width: 1px;
    }

    .lbl-seperator {
        width: 100%;
        font-family: Arial;
        font-size: 11px;
        text-align: center;
    }

    .tbl-challan {
        width: 100%;
        height: 290px;
    }

    .tbl-challan_one {
        width: 100%;
        /*height: 290px;*/
    }

    .tbl-challan tr td {
        height: 5px;
        font-size: 12px;
        font-family: Arial;
    }

    .challan-table {
        height: 100px;
        width: 100%;
        /*border:1px;*/
        border-left: 1px solid black;
        border-right: 1px solid black;
        border-bottom: 1px solid black;
        border-top: 1px solid black;
    }

    .challan-table-rt {
        height: 100px;
        width: 100%;
        border-left: 0px solid black;
        border-right: 1px solid black;
        border-bottom: 1px solid black;
        border-top: 1px solid black;
    }

    .challan-table tr {
        border-bottom: 0px solid black;
    }

    .challan-table-rt tr {
        border-bottom: 0px solid black;
    }

    .digit-right {
        text-align: right;
        padding: 2px;
    }

    .padd-left {
        padding-left: 2px;
    }
</style>

