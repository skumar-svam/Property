@model NA.PMS.Web.Models.Template.Commericial

<html>
<head>
    <style>
        p {
            font-family: Verdana;
        }
    </style>
</head>
<body>
  
    <h2>New Okhla Industrial Development Authority</h2>
    <p>Hello @Model.FirstName @Model.LastName,</p>
    <p>You have been registered with the following information:</p>
    <table>
        <tr>
            <td>Date of Allotment: </td>
            <td>@Model.DateOfAllotment</td>
            <td>Earnest Money Rs: </td>
            <td>@Model.EarnestMoney</td>
            <td>Rate of Interest: </td>
            <td>@Model.RateofInterest</td>
        </tr>
        <tr>
            <td>Area Of Plot: </td>
            <td>@Model.AreaOfPlot</td>
            <td>Allotment Money: </td>
            <td>@Model.AllotmentMoney</td>
            <td>Balance Amount Rs: </td>
            <td>@Model.BalanceAmount</td>
        </tr>
    </table>
    <p>
    </p>
</body>
</html>

