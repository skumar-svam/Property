@model NA.PMS.OnlineScheme.SchemeFormViewModel
@using NA.PMS.OnlineScheme
@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@{
    ViewBag.Title = "Template Challan";
    Layout = "~/Areas/Online/Views/Shared/_LayoutOnlineScheme.cshtml";
}

<style>
    .text-red {
        color: red;
    }

    .col-20 {
        width: 20% !important;
    }

    .col-30 {
        width: 30% !important;
    }

    .col-40 {
        width: 40% !important;
    }

    .col-60 {
        width: 60% !important;
    }
</style>

<form id="challanapiform">
    <div class="online-registration">
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Scheme Form Template Challan </h1></div>
                <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce" id="first-form">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px" id="divApplicantInformation">

                <h2 class="blck-heading" style="margin-bottom:6px;"></h2>
                <div class="form-bx">
                    <div>
                        @Html.HiddenFor(m => m.Id)
                        @Html.HiddenFor(m => m.EncryptedFormId)

                        @Html.HiddenFor(m => m.DepartmentId)
                        @Html.HiddenFor(m => m.BankId)
                        @Html.HiddenFor(m => m.AreaRange)
                        @Html.HiddenFor(m => m.SchemeType)
                        @Html.HiddenFor(m => m.ApplicationFormType)
                        @Html.HiddenFor(m => m.ApplicantType)
                        @Html.HiddenFor(m => m.AppType)
                        @Html.HiddenFor(m => m.FormType, htmlAttributes: new { @id = "hdnFormType" })

                        @Html.HiddenFor(m => m.ApplicationFee)
                        @Html.HiddenFor(m => m.EarnestMoney)
                        @Html.HiddenFor(m => m.ProcessingCharge)
                        @Html.HiddenFor(m => m.FormFeeGST)
                        @Html.HiddenFor(m => m.FormFeeWithGST)
                        @Html.HiddenFor(m => m.ProcessingChargeGST)

                        @Html.HiddenFor(m => m.NICApplicationId)
                        @Html.HiddenFor(m => m.NICControlId)
                        @Html.HiddenFor(m => m.NICServiceId)
                        @Html.HiddenFor(m => m.NICProcessIndustryId)
                        @Html.HiddenFor(m => m.NICUnitId)
                        @Html.HiddenFor(m => m.IsFromNIC)

                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Scheme Name", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @(Html.Kendo().DropDownListFor(model => model.SchemeId)
                                    .DataValueField("Id")
                                    .DataTextField("Text")
                                    .OptionLabel("--Select--")
                                    .AutoBind(true).Enable(true)
                                    .Filter("contains")
                                    //.CascadeFrom("DepartmentId")
                                    .DataSource(source =>
                                    {
                                        source.Custom()
                                        .ServerFiltering(true)
                                        .ServerPaging(true)
                                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                        .Transport(transport => transport.Read(read => read.Action("GetSchemeListAsDataSource", "Default", new { area = "Online" }).Data("FilterSchemeType")))
                                        .Schema(schema => schema.Data("Data").Total("Total"))
                                        .PageSize(100);
                                    })
                                    .HtmlAttributes(new { style = "width: 100%" })
                            )
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Application Form No", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @(Html.Kendo().DropDownListFor(model => model.ApplicationFormId)
                                    .DataValueField("Id")
                                    .DataTextField("Text")
                                    .OptionLabel("--Select--")
                                    .AutoBind(true).Enable(true)
                                    .Filter("contains")
                                    .CascadeFrom("SchemeId")
                                    .CascadeFromField("SchemeId")
                                    .DataSource(source =>
                                    {
                                        source.Custom()
                                        .ServerFiltering(true)
                                        .ServerPaging(true)
                                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                        .Transport(transport => transport.Read(read => read.Action("GetDropdownOnlineSchemeFormIdListAsDataSource", "Default", new { area = "Online" }).Data("FilterBySchemeId")))
                                        .Schema(schema => schema.Data("Data").Total("Total"))
                                        .PageSize(1000);
                                    })
                                    .Events(events => { events.Change("ApplicationFormChangeEvent"); })
                                    .HtmlAttributes(new { style = "width: 100%" })
                            )
                        </div>
                    </div>
                    <div class="row" id="divCompanyInfo">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.LabelFor(m => m.Applicant, htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", placeholder = "full name " })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group col-company">
                            @Html.Label("Authorized Signatory", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group col-company">
                            @Html.TextBoxFor(model => model.SigningAuthority, new { @class = "form-control", @maxlength = "150", placeholder = "signing authority" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Email", htmlAttributes: new { @class = "required lbl-Email" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @(Html.EditorFor(model => model.Email, new { htmlAttributes = new { @editable = "true", @class = "form-control", @maxlength = "150", placeholder = "skumar@svam.com" } }))
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Mobile Number", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.MobileNumber, new { @class = "form-control", @minlength = "10", @maxlength = "10", onkeypress = "return IsNumeric(event);", placeholder = "1234567899" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("GST Number", htmlAttributes: new { @class = "", @id = "" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.ApplicantGSTNumber, new { @class = "form-control", placeholder = "", @maxlength = "15" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("PAN", htmlAttributes: new { @class = "required lbl-PAN" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.PanNumber, new { @class = "form-control", placeholder = "AAAAA1111A", @onchange = "PanNumberChange();", @maxlength = "10" })
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Address", htmlAttributes: new { @class = "required lbl-permanent-address" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.CorrespondingAddress, new { @class = "form-control", @maxlength = "500", placeholder = "address" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Total Amount", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.TotalAmount, new { @class = "form-control", @maxlength = "20" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20  form-group">
                            @Html.Label("Bank Name", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @(Html.Kendo().DropDownListFor(m => m.RefundBankId)
                                .Filter("contains")
                                .DataTextField("Text")
                                .DataValueField("Id")
                                .OptionLabel("---Select---")
                                .CascadeFrom("SchemeId")
                                .DataSource(source => source.Read(read => read.Action("GetBankListBySchemeId", "Default").Data("FilterBySchemeId")).ServerFiltering(true))
                                .HtmlAttributes(new { @class = "schemeForms", style = "width: 100%" })
                            )
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 col-20 form-group">
                            @Html.Label("Department", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 col-30 form-group">
                            @Html.TextBoxFor(model => model.Department, new { @class = "form-control", @maxlength = "150", placeholder = "" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 col-sm-12 col-xs-12 form-group">
                            <input type="hidden" class="txt-token form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 col-sm-12 col-xs-12 form-group">
                            <div id="div-challan"></div>
                        </div>
                    </div>
                </div>


            </div>
        </div>

        <div class="box-button text-center" id="div-box-button">
            <input type="button" class="btn btn-default" id="btn-cancel" value="Clear" onclick="ClearInputFields()" />
            <input type="button" value="Generate Challan" id="btn-template-challan" class="btn btn-add" onclick="GenerateTemplateChallan()" />
        </div>
    </div>
</form>

<div class="div-popup-window" style="overflow:hidden">
    <div class="row">
        <div class="col-md-12 col-challan-view no-margin no-padding" id="col-challan-view" style="overflow:hidden;min-height:60%;">
            <iframe id="iframe-challan" style="width:100%;height: 100%;"></iframe>
        </div>
    </div>
    <div class="row" style="margin-top:15px;">
        <div class="col-md-12" style="text-align:center;">
            <input type="button" value="Close" class="btn btn-default" onclick="ClosePopupWindow()" style="min-width:110px;" />
            <input type="button" value="Print" class="btn btn-default" onclick="PrintFormChallan()" style="min-width:110px;" />
        </div>
    </div>
</div>






<script>
    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }

    $(document).ready(function () {
        $('.div-popup-window').kendoWindow({
            modal: true,
            title: "Online Scheme Form Challan",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "15%"
            },
            width: "70%", height: "80%"
        });

        

        $("#btnSubmit").click(function () {

        });
        
    });

    function FilterSchemeType() {
        return {
            FilterType: "Online"
        }
    }

    function FilterBySchemeId() {
        return {
            SchemeId: $('#SchemeId').val()
        }
    }

    function GenerateTemplateChallan() {
        var URL = "";
        var formc = {
            SchemeId: $('#SchemeId').val(),
            DepartmentId: $('#DepartmentId').val(),
            ApplicationFormId: $('#ApplicationFormId').val()
        }
        if ($('#DepartmentId').val() == 1) URL = "/Online/Institutional/GenerateSchemeFormChallanByTemplate";
        if ($('#DepartmentId').val() == 5) URL = "/Online/Housing/GenerateSchemeFormChallanByTemplate"

        if (URL != "") {
            var formData = new FormData($('form').get(0));
            $.ajax({
                url: URL,
                type: 'POST',
                dataType: 'json',
                //data: { form: formc },
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: formData,
                success: function (data) {
                    if (data != null) {
                        $('.col-challan-view').html(data)
                        //document.getElementById('iframe-challan').contentWindow.document.write(data);
                        $(".div-popup-window").data("kendoWindow").center();
                        $(".div-popup-window").data("kendoWindow").open();
                        $(".div-popup-window").data("kendoWindow").pin();
                    }

                },
                error: function (err) {
                    alertify.alert("Scheme Form Challan", "Provider failed to create a challan");
                    //$('#col-challan-view').html(err.responseText)
                }
            });
        }
        else {

        }
    }

    function ClosePopupWindow() {
        $(".div-popup-window").data("kendoWindow").close();
    }

    function PrintFormChallan() {
        var contents = document.getElementById("col-challan-view").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('<style>.row-prnt{width:100%;display:table}.row-prnt-pc{width:100%}.row-prnt-hf-lt{width:50%; float:left}.row-prnt-hf-rt{width:50%; float:right}</style>');
        frameDoc.document.write('<style>.form-group{padding:6px 0 6px 0}.col-prnt-lt{width:50%;float:left}.col-prnt-rt{width:50%;float:right}.hdr-ln{display:none;}</style>');
        frameDoc.document.write('<style>#divUserPhoto{width:80px;height:100px;float:right;}#divUserSign{width:80px;height:100px;float:right}</style>');
        frameDoc.document.write('<style>#UserImage{width:80px;height:100px;float:right;margin-right:10px;}#UserSign{width:80px;height:30px;margin-top:70px;margin-right:15px;float:right}</style>');
        frameDoc.document.write('<style>#imguser{width:80px;height:90px;float:right;}#imgsign{width:80px;height:20px;margin-top:60px;float:right}.row-prnt-pc{height:100px;width:100%}</style>');
        frameDoc.document.write('<style>.col-prnt-lt4{width:25%;float:left;display:inline-block}h1{font-size:24px}h2{font-size:20px}</style>');
        frameDoc.document.write('<style>.col-prnt-hd{width:100%;text-align:left;}label{padding-left:10px}textarea{width:95%}.k-datepicker .k-input{width:95%}</style>');
        frameDoc.document.write('<style>.btn{display:none}</style>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }


    function ApplicationFormChangeEvent() {
        var schemeId = $('#SchemeId').val();
        var formId = $('#ApplicationFormId').val();
        if (formId != "" && formId != undefined) {
            $.ajax({
                url: '/Online/Default/GetOnlineSchemeformDetailById',
                type: 'POST',
                dataType: 'json',
                data: { ApplicationFormId: formId },
                success: function (data) {
                    if (data != null) {
                       // alert(data.Applicant);
                        $("#Applicant").val(data.Applicant);
                        $("#SigningAuthority").val(data.SigningAuthority);
                        $("#Email").val(data.Email);
                        $("#MobileNumber").val(data.MobileNumber);
                        $('#ApplicantGSTNumber').val(data.ApplicantGSTNumber);
                        $("#PanNumber").val(data.PanNumber);
                        $("#Sector").val(data.Sector);
                        $("#Block").val(data.Block);
                        //$("#PlotNo").val(result.PlotNo);
                        $("#CorrespondingAddress").val(data.CorrespondingAddress);
                        $('#TotalAmount').val(data.TotalAmount);
                        $("#Department").val(data.Department);
                        $("#DepartmentId").val(data.DepartmentId);
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    //alert(respText);
                }
            });
        }
        else {
            ClearPaymentFields();
        }
    }

    function SubmitChallanForm() {
        var atype = $('#SchemeId').val();
        var ftype = $('#ApplicationFormId').val();

        var formData = new FormData($('form').get(0));
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            data: formData,
            url: '/Online/Default/SaveOnlineSchemeApplicationForm',
            success: function (result) {
                if (result != null) {
                    var totalAmount = parseFloat((parseFloat(result.ApplicationFee) + parseFloat(gst)).toFixed(2));
                    $("#schemeformfee").val(totalAmount);//schemeformfee
                    //$('#ApplicationFee').val(totalAmount);
                    $("#FormFeeWithGST").val(totalAmount);
                    $(".area-form-fee").show();
                    $('#div-box-button').css("display", "none");
                }
            },
            error: function (ajaxRequest, strError) {
                alertify.error("Network error, try again later");
            }
        });
    }

    function ClearInputFields() {
        $('#SchemeId').data("kendoDropDownList").value('');
        $('#CorrespondingAddress').val('');
        $('#Email').val('');
        $('#MobileNumber').val('');
        $('#PanNumber').val('');
        $('#ApplicantGSTNumber').val('');
        $('#TotalAmount').val('');
        $('#Sector').val('');
        $('#Block').val('');
        //$('#PlotNo').val('');
        $('#RefundBankId').data("kendoDropDownList").value('');
        //$('#AllottmentDate').data("kendoDatePicker").value('');

    }

</script>

