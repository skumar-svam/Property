<div class="col-md-12 k-grid-content">
    @(Html.Kendo().Grid<NA.PMS.Model.LeaseRentViewModel>()
        .Name("GridInstallmentDues")
        .Excel(excel => excel.AllPages(true).Filterable(true).FileName("PremiumDuesReport.xlsx"))
        .ToolBar(toolsExcel => toolsExcel.Excel())
        .Columns(columns =>
        {
            columns.Bound(c => c.Id).Title("Id").Width(50).Hidden(true);
            columns.Bound(c => c.RegistrationId).Title("Registration Id").ClientTemplate("<a href='" + "/Property/PropertyAllotment/PropertyDetails/#= RegistrationId #'>#= RegistrationId #</a>").Filterable(true);
            columns.Bound(c => c.PropertyNo).Title("Property");
            //columns.Bound(c => c.BalanceAmount).Title("Balance Amount (<span class='fa fa-rupee'></span>)");
            //columns.Bound(c => c.BalanceUptoDate).Title("Balance Upto").Format("{0:dd-MMM-yyyy}");
            columns.Bound(c => c.PremiumBalance).Title("Premium Dues (<span class='fa fa-rupee'></span>)");//.ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
            columns.Bound(c => c.DuesUptoDate).Title("Premium Dues Upto").Format("{0:dd-MMM-yyyy}");
            columns.Bound(c => c.CurrentDues).Title("Lease Rent Dues (<span class='fa fa-rupee'></span>)");
            columns.Bound(c => c.CurrentDuesDate).Title("Lease Rent Dues Upto").Format("{0:dd-MMM-yyyy}");
            columns.Bound(c => c.RegistrationId).Title("Demand Note").Width(140).ClientTemplate(" <center><a onclick='javascript:PrintInstallmentDuesDemandNote(#=RegistrationId#,#=PremiumBalance#);'><span class='fa fa-print'></span></a></center> ");
            columns.Bound(c => c.IsDuesUptoDate).Title(" ").Width(50).ClientTemplate("<center><a onclick='javascript:CalculateInstallmentDues(#=RegistrationId#);'><span class='fa fa-refresh'></span></a></center> ");
        })
        .Sortable().Filterable().Resizable(resize => resize.Columns(true))
        .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
        .DataSource(dataSource => dataSource
                .Ajax().ServerOperation(true)
                .Model(model => model.Id(p => p.Id))
                .Read(read => read.Action("GetMultiplePaymentStatusList", "Payment", new { area = "Revenue" }).Data("LeaseRent")).PageSize(10)
            //.Aggregates(aggregates => aggregates.Add(p => p.LeaseRentDues).Sum())
            )
    )
</div>

<script>
    function CalculateInstallmentDues(rid) {
        //alert(rid);
        var flag = confirm("Are You sure to update installment dues of RID " + rid);
        if (rid != 0 && flag == true) {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ RegistrationId: rid, ActionType: "Installment" }),
                url: '/Revenue/Payment/UpdateInstallmentDuesPaymentById',
                success: function (result) {
                    if (result != null && result.ReturnTypeId == '@ReturnType.Updated') {
                        $("#GridInstallmentDues").data("kendoGrid").dataSource.read();
                        alertify.success("Dues Updated successfully");
                    }
                    else if (result != null && result.ReturnTypeId == '@ReturnType.Success') {
                        $("#GridInstallmentDues").data("kendoGrid").dataSource.read();
                        alertify.success("Dues Updated successfully");
                    }
                    else {
                        alertify.error("Dues is not Updated.");
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    alertify.error("Some Error in save database.");
                }
            });
        }
    }

    function PrintInstallmentDuesDemandNote(registrationId, dueAmount) {
        //alert(dueAmount);
        var InstallmentModel = { RegistrationId: registrationId, LeaseRentDues: dueAmount };
        //var leaseModel = { RegistrationId: registrationId, LeaseRentDues: dueAmount, TotalPenalInterest: 0, PrincipalAmount: 0, ActionDate: null };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: InstallmentModel }),
            url: '/Revenue/Finance/PrintInstallmentDuesDemandNote',
            //url: '/Revenue/Finance/PrintDemandNote',
            success: function (result) {
                //$("#divApplicationForm").modal('hide');
                $("#divSchemeForm").html(result);
                $("#divPrintSchemeForm").modal('show');
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alertify.error("Some Error in save database.");
            }
        });
    }

</script>