@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@using NA.PMS.Common;
@using NA.PMS.Model
@model NA.PMS.Model.PaymentViewModel

<h2 class="blck-heading" style="margin-bottom:15px;">Lease Rent Detail</h2>
<div class="form-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
    <div class="row">
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label>Date Of Lease Deed</label>
            @(Html.Kendo().DatePickerFor(model => model.LeaseDeedDate).HtmlAttributes(new {@id="lr-leasedeed-date", style = "width:95%;float:right;" }))
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label>Frequency Of Lease Rent (Yearly)</label>
            @Html.TextBoxFor(model => model.FrequencyId, htmlAttributes: new { @id="lr-frequency", @class = "form-control text-right", @maxlength = "8" })
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label>Lease Rent Amount</label>
            @(Html.Kendo().NumericTextBoxFor(m => m.LeaseRentAmount).Name("lr-leaserent-amount")
                    .Min(0).Max(99999999999)
                    .Spinners(false).Step(0).Enable(true)
                    .HtmlAttributes(new { style = "width: 95%;", @maxlength = "13", @class = "text-right" })
            )
        </div>
        
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label title="One Time Lease Rent">One Time Lease Rent</label>
            @(Html.Kendo().NumericTextBoxFor(m => m.OneTimeLeaseRentAmount).Name("lr-onetime-leaserent")
                    .Min(0).Max(99999999999)
                    .Spinners(false).Step(0).Enable(true)
                    .HtmlAttributes(new { style = "width: 95%;", @maxlength = "13", @class = "text-right" })
            )
        </div>
    </div>
    <div class="row">
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label>Revised Lease Rent</label>
            @(Html.Kendo().NumericTextBoxFor(m => m.RevisedLeaseRent).Name("lr-revised-leaserent")
                    .Min(0).Max(99999999999)
                    .Spinners(false).Step(0).Enable(true)
                    .HtmlAttributes(new { style = "width: 95%;", @maxlength = "13", @class = "text-right" })
            )
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label>Penal Interest(%)</label>
            @(Html.Kendo().NumericTextBoxFor(m => m.PenalInterest).Name("lr-penal-interest")
                    .Min(0).Max(99999999999)
                    .Spinners(false).Step(0).Enable(true)
                    .HtmlAttributes(new { style = "width: 95%;", @maxlength = "13", @class = "text-right" })
            )
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label>Interest On Lease Rent</label>
            @(Html.Kendo().NumericTextBoxFor(m => m.InterestAmount).Name("lr-interest-amount")
                    .Min(0).Max(99999999999)
                    .Spinners(false).Step(0).Enable(true)
                    .HtmlAttributes(new { style = "width: 95%;", @maxlength = "13", @class = "text-right" })
            )
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label title="Lease Rent + Interest on Lease Rent">Total Payable Amount</label>
            @(Html.Kendo().NumericTextBoxFor(m => m.TotalPayableAmount).Name("lr-payable-amount")
                    .Min(0).Max(99999999999)
                    .Spinners(false).Step(0).Enable(true)
                    .HtmlAttributes(new { style = "width: 95%;", @maxlength = "13", @class = "text-right", @placeholder = "Lease Rent + Interest on Lease Rent" })
            )
        </div>
    </div>
    <div class="row">
        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
            <label>Dues Upto Date</label>
            @(Html.Kendo().DatePickerFor(model => model.CurrentDuesDate).Value(DateTime.Now).HtmlAttributes(new { @id = "lr-duesupto-date", style = "width:95%;float:right;" }))
        </div>
    </div>
    <div class="row">
        <div class="col-md-12" style="text-align:right;">
            <input type="button" class="btn btn-default btn-leaserent-demand" value="Generate Demand" />
            <input type="button" class="btn btn-default btn-onetime-leaserent" value="One Time Lease Rent" />
            <input type="button" class="btn btn-default btn-calculate-leaserent" value="Calculation Of Lease Rent" />
        </div>
    </div>
</div>

<div class="col-md-12 k-grid-content">
    @(Html.Kendo().Grid<NA.PMS.Model.LeaseRentViewModel>()
        .Name("GridLeaseRentDues")
        .Columns(columns =>
        {
            columns.Bound(c => c.Id).Title("Id").Hidden(true);
            columns.Bound(c => c.LeaseRentPremium).Width(150).Title("Lease Rent (<span class='fa fa-rupee'></span>)").ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
            columns.Bound(c => c.PaidUptoDate).Width(120).Title("Paid Upto").Format("{0:dd-MMM-yyyy}");
            columns.Bound(c => c.CurrentDues).Width(150).Title("Dues (<span class='fa fa-rupee'></span>)").ClientTemplate("<label class='hyperlink' onclick='ShowLeaseRentDetail(#=Id#)'>#= CurrentDues #</label>").ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
            //columns.Bound(c => c.DuesUptoDate).Title("Dues Upto").Format("{0:dd-MMM-yyyy}");
            columns.Bound(c => c.CurrentDuesDate).Title("Dues Upto").Width(120).Format("{0:dd-MMM-yyyy}");
            //columns.Bound(c => c.IsDuesUptoDate).Title(" ").Width(250).ClientTemplate("<center><input class='leaserentDate' id='hdnLeaseRentDateTime_#= Id #' value='" + DateTime.Now + "' title='datepicker' /> <a onclick='javascript:CalculateDuesUptoDate(hdnLeaseRentDateTime_#= Id #,#=RegistrationId#);'><span class='fa fa-refresh hyperlink'></span></a></center> ");
            columns.Bound(c => c.IsDuesUptoDate).Title(" ").Width(50).ClientTemplate("<center><a onclick='javascript:CalculateDuesUptoDate(#=RegistrationId#);'><span class='fa fa-refresh hyperlink'></span></a></center> ");
        })
        .Events(m => m.DataBound("KendoDataBound"))
        .Resizable(resize => resize.Columns(true))
        .ClientDetailTemplateId("template")
        .DataSource(dataSource => dataSource
                .Ajax().ServerOperation(true)
                .Model(model => model.Id(p => p.Id))
                .Read(read => read.Action("GetMultiplePaymentStatusList", "Payment", new { area = "Revenue" }).Data("LeaseRent")).PageSize(10)
                .Aggregates(aggregates => aggregates.Add(p => p.LeaseRentPremium).Sum())
                .Aggregates(aggregates => aggregates.Add(p => p.CurrentDues).Sum())
            )
    )
</div>

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<NA.PMS.Model.LeaseRentViewModel>()
            .Name("grid_#=Id#")
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Title("Id").Width(50).Hidden(true);
                columns.Bound(c => c.LeaseRentPremium).Title("Lease Rent Premium (<span class='fa fa-rupee'></span>)");
                columns.Bound(c => c.DepositDate).Title("Due Date").Format("{0:dd-MMM-yyyy}");
            })
            .Sortable().Filterable().Resizable(resize => resize.Columns(true))
            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(new[] { 10, 20, 50, 100 }).Info(true).PreviousNext(true).Input(true).Numeric(true).ButtonCount(10))
            .DataSource(dataSource => dataSource
                    .Ajax()
                    .Model(model => model.Id(p => p.Id))
                    .ServerOperation(true)
                    //.Read(read => read.Action("GetLeaseRentPaymentTransDetailsById", "Payment", new { area = "Revenue", Id = "#=Id#" }))
                    .Read(read => read.Action("GetLeaseRentTransDetails", "Payment", new { area = "Revenue", RentId = "#=RentId#" }))
            )
            .ToClientTemplate()
    )

</script>
<script>
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
</script>

<div class="col-md-12" id="demand-note-type" style="min-height:150px;">
    <div class="row" style="padding-top:25px;">
        <div class="col-md-8 col-md-offset-2">
            @(Html.Kendo().DropDownList()
                .Name("DDLDemandType")
                .DataTextField("Text")
                .DataValueField("Value")
                .OptionLabel(" --- Select ---")
                .BindTo(new List<SelectListItem>() {
                    new SelectListItem() { Text = "One Time Lease Rent", Value = "OneTimeLeaseRent" },
                    new SelectListItem() { Text = "Normal Lease Rent", Value = "LeaseRent" }
                })
                .HtmlAttributes(new { style = "width: 100%;" })
            )
        </div>
        <div class="col-md-12" style="padding-top:20px;text-align:center">
            <input type="button" class="k-button btn-popup-leaserent-demand" value="Generate Demand" style="background:#299a8b;color:#fff;" />
        </div>
    </div>
</div>

<div id="leaserent-demand-window2" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 60%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title"><b>Lease Rent Demand Note</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:400px;">
                <div id="leaserent-demand-content2"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="" class="k-button" onclick="PrintLeaseRentDemand();">Print</button>
            </div>
        </div>
    </div>
</div>


<div class="" id="leaserent-demand-window">
    <div class="col-md-12 armchair">
        <div class="col-md-12" id="leaserent-demand-content" style="width:70%;height:480px;"></div>
    </div>
    <div class="col-md-12 window-footer">
        <button type="button" class="k-button">Close</button>
        <button type="button" class="k-primary k-button">Save changes</button>
        <button type="button" id="btnPrintDiv" class="k-button" onclick="PrintLeaseRentDemand();">Print</button>
    </div>
    <style scoped>
          .armchair{
            overflow: auto;
            height: calc(100% - 80px);
            padding: 10px;
            width:70%;
          }
          .window-footer{
            position: absolute;
            bottom: 0;
            display: block;
            width: 70%;
            margin-top: 150px;
            padding: 19px 0 20px;
            text-align: right;
            border-top: 1px solid #e5e5e5;
          }
        </style>
</div>


<script type="text/javascript">

    $(document).ready(function () {
        $('.btn-calculate-leaserent').click(function () {
            var rid = $('#hdn-registration-id').val();
            var duesdate = $('#lr-duesupto-date').val();
            if (duesdate != "") {
                CalculateDuesUptoDate(rid);
            }
            else {
                alertify.error("Please select dues upto date.");
                return false;
            }
        });

        $('.btn-leaserent-demand').click(function () {
            if ($('#lr-duesupto-date').val() != "") {
                //PrintLeaseRentDemandNote();
                $("#demand-note-type").data("kendoWindow").center();
                $("#demand-note-type").data("kendoWindow").open();
            }
            else {
                alertify.error("Please select dues upto date.");
            }
        });


        $('#demand-note-type').kendoWindow({
            modal: true,
            title: "Select Demand Note Type",
            visible: false,
            width: "25%"
        });

        $('#leaserent-demand-window').kendoWindow({
            modal: true,
            title: "Lease Rent Demand",
            visible: false,
            width: "70%"
        });

        $('.btn-popup-leaserent-demand').click(function () {
            if ($('#DDLDemandType').val() == "") {
                alertify.error("Please select Demand Type");
                return false;
            }
            else {
                //PrintLeaseRentDemandNote2();
                PrintLeaseRentDemandNote();
            }
        });

        GetLeaseRentInfoDetails();

        //$('#GridLeaseRentDues').find("k-pager-sizes").find("select").append("option").val(50);
    });

    function KendoDataBound() {
        //$("#grid_trans").data("kendoGrid").dataSource.read();
        $(".leaserentDate").kendoDatePicker();
    }

    function LeaseRent() {
        //registrationId = 10001068;// $("#hdnRID").val();
        registrationId = $('#hdn-registration-id').val(); //40011053;
        var model = { RegistrationId: registrationId, ActionType: "LeaseRent" };
        return model;
    }


    function CalculateDuesUptoDate(rid) {
        var flag = confirm("Are You sure to update Lease Rent of RID " + rid);
        if (rid != 0 && flag == true) {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ RegistrationId: rid, CurrentDuesDate: $('#lr-duesupto-date').val(), ActionType: "LeaseRent" }),
                url: '/Revenue/Payment/UpdateLeaseRentDuesPaymentById',
                success: function (result) {
                    if (result != null && result.ReturnTypeId == '@ReturnType.Updated') {
                        $("#GridLeaseRentDues").data("kendoGrid").dataSource.read();
                        $("#GridLeaseRentDues").data("kendoGrid").dataSource.refresh();
                        alertify.success("Dues Updated successfully");
                    }
                    else {
                        alertify.error("Dues is not Updated.");
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    alertify.error("Some Error in save database.");
                }
            });
        }
    }
    function GetLeaseRentInfoDetails() {
        var rid = $('#hdn-registration-id').val();
        var pid = $('#PropertyId').val();
        if (pid != "") {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ RegistrationId: rid, PropertyId: pid }),
                url: "/Revenue/Finance/GetPropertyLeaseRentCostDetailById",
                success: function (result) {
                    if (result != null) {
                        $("#lr-leasedeed-date").data("kendoDatePicker").value(result.LeaseDeedDate);
                        $("#lr-leaserent-amount").data("kendoNumericTextBox").value(result.LeaseRentAmount);
                        $("#lr-revised-leaserent").data("kendoNumericTextBox").value(result.RevisedLeaseRent);
                        $("#lr-penal-interest").data("kendoNumericTextBox").value(result.PenalInterest);
                        $("#lr-interest-amount").data("kendoNumericTextBox").value(result.PenalInterestAmount);
                        $("#lr-payable-amount").data("kendoNumericTextBox").value(result.TotalPayableAmount);
                        $("#lr-duesupto-date").data("kendoDatePicker").value(result.CurrentDuesDate);
                    } 
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                }
            });
        }
    }
    function CalculateFromInstallmentDuesCal(caldate, rid) {
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ RegistrationId: rid, ActionType: "LeaseRent", CurrentDuesDate: caldate }),
            url: '/Revenue/Payment/UpdateLeaseRentDuesPaymentById',
            success: function (result) {
                if (result != null && result.ReturnTypeId == '@ReturnType.Updated') {
                    $("#GridLeaseRentDues").data("kendoGrid").dataSource.read();
                    alertify.success("Lease Rent Dues Updated successfully");
                }
                else {
                    alertify.error("Lease Rent Dues is not Updated.");
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Some Error in save database.");
            }
        });
    }

    function PrintLeaseRentDemandNote2() {
        var widget = $("#demand-note-type").data("kendoWindow");
        kendo.ui.progress(widget.element, true);
        var LeaseRentModel = { RegistrationId: $('#hdn-rid').val(), ActionType: $('#DDLDemandType').val() };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: LeaseRentModel }),
            url: '/Revenue/Finance/PrintLeaseRentDuesDemandNote',
            success: function (result) {
                $('#DDLDemandType').data("kendoDropDownList").value('');
                $("#demand-note-type").data("kendoWindow").close();
                kendo.ui.progress(widget.element, false);

                $("#divSchemeForm").html(result);
                $("#divPrintSchemeForm").modal('show');
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                $('#DDLDemandType').val('');
                $("#demand-note-type").data("kendoWindow").close();
                kendo.ui.progress(widget.element, false);
                alertify.error("Some Error in save database.");
            }
        });
    }


    function PrintLeaseRentDemandNote() {
        var duesDate = $('.lr-duesupto-date').val();
        var rid = $('#hdn-registration-id').val();
        //var leaseModel = { RegistrationId: rid, LeaseRentDues: dues, TotalPenalInterest: penal, PrincipalAmount: principal, ActionDate: duesDate };
        var leaseModel = { RegistrationId: rid, ActionType: $('#DDLDemandType').val(), CurrentDuesDate: duesDate };
        var widget = $("#demand-note-type").data("kendoWindow");
        kendo.ui.progress(widget.element, true);
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: leaseModel }),
            //url: '/Revenue/Finance/PrintDemandNote',
            url: '/Revenue/Finance/PrintLeaseRentDuesDemandNote',
            success: function (result) {
                $('#DDLDemandType').data("kendoDropDownList").value('');
                $("#demand-note-type").data("kendoWindow").close();
                kendo.ui.progress(widget.element, false);

                $("#leaserent-demand-content2").html(result);
                //$("#leaserent-demand-window").data("kendoWindow").center();
                //$("#leaserent-demand-window").data("kendoWindow").open();

                $("#leaserent-demand-window2").modal('show');
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                $('#DDLDemandType').data("kendoDropDownList").value('');
                $("#demand-note-type").data("kendoWindow").close();
                kendo.ui.progress(widget.element, false);
                alertify.error("Some Error in save database.");
            }
            //    $("#divApplicationForm").modal('hide');
            //    $("#divSchemeForm").html(result);
            //    $("#divPrintSchemeForm").modal('show');
            //},
            //error: function (objAjaxRequest, strError) {
            //    var respText = objAjaxRequest.responseText;
            //    alertify.error("Some Error in save database.");
            //}
        });
    }


    function PrintLeaseRentDemand() {
        var contents = document.getElementById("leaserent-demand-content2").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }
</script>