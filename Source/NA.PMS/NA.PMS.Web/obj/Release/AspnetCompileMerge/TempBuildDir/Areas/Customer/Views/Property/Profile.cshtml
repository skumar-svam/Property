<script type="text/javascript">
    $(document).ready(function () {
        $('form').submit(function () {
            $('#loader').show();
        })

        $('#Applicant').attr("readonly", "readonly");

        $('#applicationform input:radio[name=ApplicationFormType]').on('change', function () {
            ToggleApplicantCategory();
        });


        $('#applicationform input:radio[name=ExpansionType]').on('change', function () {
            ToggleExpansion();
        });


        $('#applicationform input:radio[name=ApplicantType]').on('change', function () {
            var radiobtnVal = $('input[name=ApplicantType]:checked', '#applicationform').val();
            if (radiobtnVal == "company") {
                ClearUserImages();
                ClearCommonFields();
                ClearPaymentFields();
                $('.lbl-permanent-address').text("Registered Office");
                $('.lbl-annnual-income').text("Annual Turnover");
                $('.lbl-Email').text("Company Email");
                $('.lbl-PAN').text("Company PAN");
                $('#divIndividualInfo').css("display", "none");
                $('.divCompanyInfo').show();
                $('#Applicant').val('');
                $('#Applicant').attr("readonly", false);
                $("label[for='Applicant']").html("Company");
                $('.col-company').show();
                $('#RefundInfaverof').attr("readonly",true);
                $('#CompanyTypeId').data("kendoDropDownList").dataSource.read();
            }
            else if (radiobtnVal == "individual") {
                ClearIndividualField();
                ClearCommonFields();
                ClearUserImages();
                ClearPaymentFields();
                $('.lbl-permanent-address').text("Permanent Address");
                $('.lbl-annnual-income').text("Annual Income");
                $('.lbl-Email').text("Email");
                $('.lbl-PAN').text("PAN");
                $('#divIndividualInfo').show();
                $('.divCompanyInfo').css("display", "none");
                $('#Applicant').val('');
                $('#SigningAuthority').val('');
                $('#Applicant').attr("readonly", "readonly");
                $("label[for='Applicant']").html("Applicant");
                $('.col-company').css("display", "none");
                $('#RefundInfaverof').attr("readonly", false);
                $('#CompanyTypeId').data("kendoDropDownList").dataSource.read();
            }
        });

        $('.helpsupport').click(function () {
            window.location.href = '@Url.Action("HelpOnline", "Application", new {area="Online", target="_blank"})';
        });

        $('#Applicant').change(function () {
            var radiobtnVal = $('input[name=ApplicantType]:checked', '#applicationform').val();
            if (radiobtnVal == "company") {
                var name = $('#Applicant').val();
                $('#RefundInfaverof').val(name);
            }
        });

    });

    function ToggleApplicantCategory() {
        var formType = $('input[name=ApplicationFormType]:checked', '#applicationform').val();
        if (formType.trim() == "Expansion") {
            $('#divExpansionType').show();
            //$('#divExistingAllottee').show();
            ToggleExpansion();
        }
        else {
            $('#divExpansionType').css("display", "none");
            $('.row-rent').css("display", "none");
            $('.col-rent').css("display", "none");
            $('#divExistingAllottee').css("display", "none");
            $('#ExistingProperty').val('');
            $('#AllottmentDate').data("kendoDatePicker").value('');
            $('#LetterCode').val('');
            $('#LetterDate').data("kendoDatePicker").value('');
        }
    }

    function ToggleExpansion() {
        var formType = $('input[name=ExpansionType]:checked', '#applicationform').val();
        if (formType.trim() == "RentPermission") {
            $('.row-rent').show();
            $('.col-rent').show();
            $('#divExistingAllottee').css("display", "none");
            $('#ExistingProperty').val('');
            $('#AllottmentDate').data("kendoDatePicker").value('');
        }
        if (formType.trim() == "ExistingAllottee") {
            $('.row-rent').css("display", "none");
            $('.col-rent').css("display", "none");
            $('#divExistingAllottee').show();
            $('#LetterCode').val('');
            $('#LetterDate').data("kendoDatePicker").value('');
        }
    }

