@model NA.PMS.Model.PropertyViewModel
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
@using NA.PMS.Common;

@{
    ViewBag.Title = "Noida Property";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .btn {
        margin-top: 20px;
    }

    .applicant-grid, .property-grid, .row-btn-action {
        display: none;
    }

    .hyperlink {
        cursor: pointer;
        color: blue;
    }
</style>

<div id="ManageProperty">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Property Details</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">

            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12" style="border:solid #e2e3e4; border-width:0 1px 1px">
        <div class="row" style="padding:12px 30px 12px 0;">           
            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                @Html.Label("Department")
                @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetDepartmentListAsDataSource", "ServiceRequest", new { area = "Member" })))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                    .Events(events => { events.Change("ChangeInDepartmentEvnet"); })
                    .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                )
            </div>

            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                @Html.Label("Sector")
                @(Html.Kendo().DropDownListFor(model => model.SectorId)
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .Enable(true)
                    .AutoBind(true)
                    .Filter("contains")
                    //.CascadeFromField("DepartmentId")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetSectorListAsDataSource", "ServiceRequest", new { area = "Member" }).Data("FilterDepartmentId")))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                    //.CascadeFrom("DepartmentId")
                    .HtmlAttributes(new { style = "width:90%; float:right;", @class = "input-disabled" })
                    .Events(e => e.Change("ReadPropertyGridEvent"))
                )
            </div>
            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                @Html.Label("Block")
                @(Html.Kendo().DropDownListFor(m => m.BlockId)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .CascadeFrom("SectorId")
                    .CascadeFromField("SectorId")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetBlockListAsDataSource", "ServiceRequest", new { area = "Member" }).Data("FilterSectorIdByDepartment")))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                   .Events(events => { events.Change("ReadPropertyGridEvent"); })
                   .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                )
            </div>
            <div class="col-md-3 col-sm-6 col-xs-12 form-group">

            </div>
        </div>

    </div>

    <div class="col-md-12 alot-prop-grid k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.Model.PropertyViewModel>()
            .Name("GridAllottedProperty")
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.PropertyId).Hidden(true);
                columns.Bound(c => c.RegistrationId).Title("Registration Id").Width(150);               
                columns.Bound(c => c.Department).Title("Department").Width(140);
                columns.Bound(c => c.PropertyNo).Title("Property").Width(130);
                columns.Bound(c => c.Applicant).Title("Applicant (Allottee)");
                columns.Bound(c => c.ApplicantType).Title("Type").Width(110);
                columns.Bound(c => c.MobileNo).Title("Mobile No").Width(130);
                //columns.Bound(c => c.AllotmentDate).Title("Allotment").Width(130).Format("{0:dd/MM/yyyy}");
                //columns.Bound(c => c.Email).Title("Email").Width(130);
            })
            .Sortable()
            .Filterable()
            .Resizable(resize => resize.Columns(true))
            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
            .ClientDetailTemplateId("template")
            .AutoBind(true)
            .DataSource
            (
                dataSource => dataSource
                .Ajax()
                .Model(model => model.Id(p => p.Id))
                .ServerOperation(true)
                .Read(read => read.Action("GetPropertyListForJanSuvidhaKendra", "ServiceRequest", new { area = "Member" }).Data("FilterSearchParameter"))
                .Sort(s => s.Add(x => x.AllotmentDate).Descending())
                .PageSize(10)
            ))
    </div>

</div>


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<NA.PMS.Model.PropertyViewModel>()
            .Name("grid_#=Id#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(c => c.RegistrationId).Hidden(true);
                columns.Bound(c => c.SectorName).Title("Sector").Width(100);
                columns.Bound(c => c.BlockName).Title("Block").Width(100);
                columns.Bound(c => c.PlotNo).Title("Plot No").Width(100);
                columns.Bound(c => c.ApplicantMaster).Title("Allottee Master");
                columns.Bound(c => c.ApplicantAddress).Title("Address");
                columns.Bound(c => c.Email).Title("Email");
                //columns.Bound(c => c.AllotmentDate).Format("{0:dd/MM/yyyy}").Width(120);               
            })
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(10)
                .Read(read => read.Action("GetPropertyListForJanSuvidhaKendra", "ServiceRequest", new { RegistrationId = "#=RegistrationId#" }))
            )
            .ToClientTemplate()
    )
</script>
<script>
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
</script>


<script>
    $(document).ready(function () {
     

    });

    function ChangeInDepartmentEvnet() {
        $('#SectorId').data('kendoDropDownList').dataSource.read();
        $('#GridAllottedProperty').data('kendoGrid').dataSource.read();
    }
    
    function ReadPropertyGridEvent() {
        $('#GridAllottedProperty').data('kendoGrid').dataSource.read();
    }

    function FilterDepartmentId() {
        return {
            DepartmentId: $('#DepartmentId').val()
        };
    }

    function FilterSectorIdByDepartment() {
        return {
            DepartmentId: $('#DepartmentId').val(),
            SectorId: $('#SectorId').val()
        };
    }

    function FilterSearchParameter() {
        var model = {
            DepartmentId: $('#DepartmentId').val(),
            SectorId: $('#SectorId').val(),
            BlockId: $('#BlockId').val()
        };
        return model;
    }


</script>



