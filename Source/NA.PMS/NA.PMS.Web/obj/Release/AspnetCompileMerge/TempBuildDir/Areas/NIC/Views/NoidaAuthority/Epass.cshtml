    function VehicleNoChange() {
        if ($("#VehicleNo").val().trim() == '') {
            $("#VehicleNo").val('');
        }
        var bool = CheckVehicleNoFormat();
        if (bool == false) {
            alertify.error("vehicle Number format is wrong.");
            $("#VehicleNo").val('');
            return false;
        }
    }

    function CheckVehicleNoFormat() {
        var value = $("#VehicleNo").val().trim();
        var regex1 = /^[A-Z]{2}\d{2}[A-Z]{2}\d{4}$/;
        if (!regex1.test(value) || value.length != 10) {
            return false;
        }
        return true;
    }
