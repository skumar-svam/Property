<div class="form-bx" style="width:100%;">
    <div class="row">
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-3" style="border-right-color:green; border-right-width:1px;">
                    <div class="row">
                        <div class="col-md-11">
                            <div id="piechart" style=""></div>
                        </div><div class="col-md-1">&nbsp;</div>
                    </div>
                </div>
                <div class="col-md-3" style="border-right-color:green;  border-right-width:1px;">
                    <div class=" row">
                        <div class="col-md-11">
                            <div id="donutchart"></div>
                        </div><div class="col-md-1">&nbsp;</div>
                    </div>
                </div>
                <div class="col-md-3" style="border-right-color:green;  border-right-width:1px;">
                    <div class=" row">
                        <div class="col-md-11">
                            <div id="barchart" style=""></div>
                        </div><div class="col-md-1">&nbsp;</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class=" row">
                        <div class="col-md-11">
                            <div id="linechart"></div>
                        </div><div class="col-md-1">&nbsp;</div>
                    </div>
                </div>
                <div class="row">&nbsp;</div>
                <div class="row">
                    <div class="col-md-12 col-sm-12 img-responsive">
                        <div id="bubblechart" class="row img-responsive" style=""></div>
                    </div>

                </div>
                <div class="row">&nbsp;</div>
                <div class="row">
                    <div class="col-md-12 col-sm-12 img-responsive">
                        <div id="columnchart_values" class="row img-responsive" style=""></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Raw(Model.Graph)


<script type="text/javascript">
    $("#btnServiceRequestMatrix").click(function () {
        window.location.href = '@Url.Action("ShowServiceRequestMatrix", "Report")';
    });
</script>