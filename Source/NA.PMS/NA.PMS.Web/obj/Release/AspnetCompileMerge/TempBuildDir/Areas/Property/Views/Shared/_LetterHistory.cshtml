@model NA.PMS.Model.LetterHistory
@using Kendo.Mvc.UI;

<div class="col-md-12 k-grid-content">
    <h2 class="blck-heading-grid">Letter Details</h2>
    @Html.HiddenFor(m => m.Rid)
    @(Html.Kendo().Grid<NA.PMS.Model.LetterHistory>()
              .Name("gridLetterHistory")
              .Columns(columns =>
              {
                  columns.Bound(c => c.Id).Hidden(true);
                  columns.Bound(c => c.Sno).Title("Serial No.").Width(50);
                  columns.Bound(c => c.LetterName).Title("Letter Name").Width(100);
                  columns.Bound(c => c.Generate_Date).Title("Generate Date").Format("{0:dd-MM-yyyy}").Width(100);
                  //columns.Bound(c => c.Rid).ClientTemplate("<a href='" + "/Property/PropertyAllotment/XYZ/#= Rid #'>View</a>").Width(50).Title("Action").Filterable(false);
                  columns.Bound(c => c.Rid).ClientTemplate("<label onclick='javascript:GenerateLetter(this)' class='hyperlinkcss'>View</label>").Width(50).Title("Action").Filterable(false);
              })
              .Sortable().Filterable().Resizable(resize => resize.Columns(true))
              .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
              .AutoBind(true)
              .DataSource
              (
                 dataSource => dataSource
                .Ajax().Model(model => model.Id(p => p.Rid))
                .ServerOperation(true)
                .Read(read => read.Action("GetLetterHistory", "PropertyAllotment").Data("additionalPropInfo"))
                .PageSize(10)
              )
    )
</div>

<div class="col-md-12 k-grid-content">
    <h2 class="blck-heading-grid">Approved Letters</h2>
    @Html.HiddenFor(m => m.Rid)
    @(Html.Kendo().Grid<NA.PMS.Model.ServiceViewModel>()
              .Name("gridDigitllySingedLetterHistory")
              .Columns(columns =>
              {
                  columns.Bound(c => c.Id).Hidden(true);
                  columns.Bound(c => c.UploadedDocument).Hidden(true);
                  columns.Bound(c => c.SerialNo).Title("Serial No.");
                  columns.Bound(c => c.TemplateName).Title("Letter Name");
                  columns.Bound(c => c.DispatchDate).Title("Uplaod Date").Format("{0:dd-MM-yyyy}");
                  //columns.Bound(c => c.UploadedDocument).ClientTemplate("<label class='hyperlinkcss'>View</label>").Width(50).Title("Action").Filterable(false);
                  columns.Bound(c => c.StatusId).Title("Letter").ClientTemplate("#if(StatusId == 9 && IsUploaded == true){# <center><a onclick='javascript:ViewApprovedLetter(this);'style='font-weight:bold;cursor:pointer;'>view</a></center> #}#");//.Width(120)
              })
              .Sortable().Filterable().Resizable(resize => resize.Columns(true))
              .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
              .AutoBind(true)
              .DataSource
              (
                 dataSource => dataSource
                .Ajax()//.Model(model => model.Id(p => p.Rid))
                .ServerOperation(true)
                .Read(read => read.Action("GetDigitalSingedLetterHistory", "PropertyAllotment").Data("additionalPropInfo"))
                .PageSize(10)
              )
    )
</div>

<div id="divPrintLetters" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 60%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Letter</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:400px;">
                <div id="divLetterBody"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                @*<button type="button" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintLetterDiv();">Print</button>*@
                <button type="button" class="k-button export-pdf">Export</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function additionalPropInfo() {
        return { rid: $('#Rid').val() };
    }

    function GenerateLetter(row) {
        var tr = $(row).parent().parent();
        var Id = $(tr).children("td:eq(0)").text();
        var rid = $('#hdnRID').val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ Rid: rid,Id: Id }),
            url: '/Allotment/Viewletter',
            success: function (result) {
                $("#divLetterBody").html(result);
                $("#divPrintLetters").modal('show');
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
            }
        });
    }

    function PrintLetterDiv() {
        var contents = document.getElementById("divLetterBody").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }

    function ViewApprovedLetter(row) {
        var tr = $(row).parent().parent().parent();
        var doc = $(tr).children("td:eq(1)").text();
        if (doc != "") {
            window.location.href = doc;
        }
    }

    $(document).ready(function () {
        $(".export-pdf").click(function () {
            // Convert the DOM element to a drawing using kendo.drawing.drawDOM
            //kendo.drawing.drawDOM($(".content-wrapper"))
            kendo.drawing.drawDOM($("#divLetterBody"))
            .then(function (group) {
                // Render the result as a PDF file
                return kendo.drawing.exportPDF(group, {
                    paperSize: "auto",
                    margin: { left: "1cm", top: "1cm", right: "1cm", bottom: "1cm" }
                });
            })
            .done(function (data) {
                // Save the PDF file
                kendo.saveAs({
                    dataURI: data,
                    fileName: "Authority-Letter.pdf",
                    proxyURL: "https://demos.telerik.com/kendo-ui/service/export"
                });
            });
        });
    });

</script>
