            <input type="button" class="k-button" id="btnCancelPopup" value="Cancel" style="width:100px" />
            <input type="button" class="k-button" id="btnSubmitComment" value="submit" style="width:100px" />
        </div>
    </div>
</div>



<div class="col-md-12 popup-window" id="DocumentWindow" style="min-height:500px;background:url(/Content/Images/boxed-bg.jpg) repeat;">
    <div class="row form-group" id="divLetterContent" style="height:500px; overflow:auto;">

    </div>
    <div class="row">
        <div class="col-md-12" style="text-align:center">
            <button type="button" class="k-button" onclick="PrintLetter();" style="width:100px;">Print</button>
            <button type="button" class="k-button" onclick="CloseLetter();" style="width:100px;">Close</button>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#divPopupWindow').kendoWindow({
            modal: true,
            title: "Validate KYA Form",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "30%"
            },
            width: "50%", height: "35%"
        });

        $('.popup-window').kendoWindow({
            modal: true,
            title: "Noida Authority Letter",
            //actions: false,
            actions: ["Pin", "Minimize", "Maximize", "Close"],
            visible: false,
            width: "75%"
        });

        $('#btnCancelPopup').click(function () {
            $("#divPopupWindow").data("kendoWindow").close();
        });

        $('#btnSubmitComment').click(function () {
            UpdateKYAStatus();
        });

    });

    function CloseLetter() {
        $("#DocumentWindow").data("kendoWindow").close();
    }

    function ChangeDepartmentEvent() {
        $("#GridKYASubmittedForm").data("kendoGrid").dataSource.read();
    }

    function OpenIdFile(row, id) {
        $("#divLetterContent").empty();
        //var tr = $(row).parent().parent();
        //var link = $(tr).children("td:eq(4)").text();
        var model = {
            RegistrationId: row,
            ActionId: 1,
            Id: id
        };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: model }),
            url: '/Member/Authority/GetDocumentPath',
            success: function (result) {
                if (result != null) {
                    //$("#divLetterContent").append($('<iframe src=' + link + ' style="width:100%;min-height:500px;"></iframe>'));
                    $("#divLetterContent").append($('<iframe src=' + result + ' style="width:100%;min-height:500px;"></iframe>'));
                    $("#DocumentWindow").data("kendoWindow").center();
                    $("#DocumentWindow").data("kendoWindow").open();
                }
                else {
                    //alertify.success("Data is not approved, try again later");
                }

            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                alertify.error("Network error, try again later");
            }
        });


    }

    function OpenLetterDocument(row, id) {
        $("#divLetterContent").empty();
        var model = {
            RegistrationId: row,
            ActionId: 2,
            Id: id
        };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: model }),
            url: '/Member/Authority/GetDocumentPath',
            success: function (result) {
                if (result != null) {
                    $("#divLetterContent").append($('<iframe src=' + result + ' style="width:100%;min-height:500px;"></iframe>'));
                    $("#DocumentWindow").data("kendoWindow").center();
                    $("#DocumentWindow").data("kendoWindow").open();
                }
                else {
                    //alertify.success("Data is not approved, try again later");
                }

            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                alertify.error("Network error, try again later");
            }
        });


    }

    function OpenOtherDocument(row, id) {
        $("#divLetterContent").empty();
        var model = {
            RegistrationId: row,
            ActionId: 3,
            Id: id
        };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: model }),
            url: '/Member/Authority/GetDocumentPath',
            success: function (result) {
                if (result != null) {
                    $("#divLetterContent").append($('<iframe src=' + result + ' style="width:100%;min-height:500px;"></iframe>'));
                    $("#DocumentWindow").data("kendoWindow").center();
                    $("#DocumentWindow").data("kendoWindow").open();
                }
                else {
                    alertify.error("Other document not uploaded.");
                }

            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                alertify.error("Network error, try again later");
            }
        });


    }


    function OpenFile(row) {
        $("#divLetterContent").empty();
        var tr = $(row).parent().parent();
        var link = $(tr).children("td:eq(4)").text();
        $("#divLetterContent").append($('<iframe src=' + link + ' style="width:100%;min-height:500px;"></iframe>'));
        $("#DocumentWindow").data("kendoWindow").center();
        $("#DocumentWindow").data("kendoWindow").open();
    }
    function OpenFile(row) {
        $("#divLetterContent").empty();
        var tr = $(row).parent().parent();
        var link = $(tr).children("td:eq(4)").text();
        $("#divLetterContent").append($('<iframe src=' + link + ' style="width:100%;min-height:500px;"></iframe>'));
        $("#DocumentWindow").data("kendoWindow").center();
        $("#DocumentWindow").data("kendoWindow").open();
    }

    function FilterSearchParameter() {
        return {
            DepartmentId: $('#DepartmentId').val(),
            StartDate: $('#StartDate').val(),
            EndDate: $('#EndDate').val(),
            ActionId: $('#ActionId').val()
        };
    }

    function ReadKYAFormGrid() {
        $("#GridKYASubmittedForm").data("kendoGrid").dataSource.read();
    }

    function ValidateDocument(row) {
        //alert(row);
        //var tr = $(row).parent().parent();
        //var id = $(tr).children("td:eq(0)").text();
        $('#Id').val(row);
        $("#divPopupWindow").data("kendoWindow").center();
        $("#divPopupWindow").data("kendoWindow").open();
        $("#divPopupWindow").data("kendoWindow").pin();
    }

    function ValidateActionField() {
        var flag = true;
        if ($('#StatusId').val() == "") {
            alertify.error("Select service status");
            flag = false;
        }
        else if (($('#StatusId').val() == '@NAStatusId.Rejected') || ($('#StatusId').val() == '@NAStatusId.Pending')) {
            if ($('#OptionalId').val() == "") {
                alertify.error("Select reason for rejection/pending");
                flag = false;
            }
            if ($('#Remarks').val() == "") {
                alertify.error("Enter remarks for rejection/pending");
                flag = false;
            }
        }
        else if ($('#StatusId').val() == '@NAStatusId.Forwarded') {
            if ($('#ApproverId').val() == "") {
                alertify.error("Select Approver");
                flag = false;
            }
        }
        return flag;
    }

    function ChangeStatusIdEvent() {
        if ($('#StatusId').val() == '') {
            $('.row-approver').css("display", "none");
            $('.row-reason').css("display", "none");
        }
        else if ($('#StatusId').val() == '@NAStatusId.Approved') {
            $('.row-approver').css("display", "none");
            $('.row-reason').css("display", "none");
        }
        else if (($('#StatusId').val() == '@NAStatusId.Rejected') || ($('#StatusId').val() == '@NAStatusId.Pending')) {
            $('.row-approver').css("display", "none");
            $('.row-reason').show();
        }
        else if ($('#StatusId').val() == '@NAStatusId.Forwarded') {
            $('.row-approver').show();
            $('.row-reason').css("display", "none");
        }
    }

    function UpdateKYAStatus() {
        if (ValidateActionField()) {
            var model = {
                Id: $('#Id').val(),
                StatusId: $('#StatusId').val(),
                OptionalId: $('#OptionalId').val(),
                ApproverId: $('#ApproverId').val(),
                OptionalAction: $('#OptionalId').data("kendoDropDownList").text(),
                Remarks: $('#Remarks').val()
            };
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ model: model }),
                url: '/Member/Authority/ValidateKYAForm',
                success: function (result) {
                    if (result == '@ReturnType.None') {
                        $('#divPopupWindow').data("kendoWindow").close();
                        alertify.error("provider failed to update status.");
                    }
                    else if (result == '@ReturnType.Initiated') {
                        $('#divPopupWindow').data("kendoWindow").close();
                        alertify.error("Form can't be approved/reject but forward.");
                    }
                    else if (result == '@ReturnType.Updated') {
                        $('#divPopupWindow').data("kendoWindow").close();
                        alertify.error("KYA form already approved.");
                    }
                    else if (result == '@ReturnType.Approved') {
                        $('#divPopupWindow').data("kendoWindow").close();
                        alertify.success("Data approved successfully.");
                        $("#GridKYASubmittedForm").data("kendoGrid").dataSource.read();
                    }
                    else if (result == '@ReturnType.Rejected') {
                        $('#divPopupWindow').data("kendoWindow").close();
                        alertify.success("KYA rejected successfully.");
                        $("#GridKYASubmittedForm").data("kendoGrid").dataSource.read();
                    }
                    else if (result == '@ReturnType.Forwarded') {
                        $('#divPopupWindow').data("kendoWindow").close();
                        alertify.error("KYA already forwarded, either approve or reject it.");
                    }
                    else if (result == '@ReturnType.Validated') {
                        $('#divPopupWindow').data("kendoWindow").close();
                        alertify.success("KYA validated and forwarded to Approver.");
                        $("#GridKYASubmittedForm").data("kendoGrid").dataSource.read();
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Network error, try again later");
                }
            });
        }

    }

</script>