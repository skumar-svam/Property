@using Kendo.Mvc.UI
@model NA.PMS.Model.ExtensionDetails

@{
    ViewBag.Title = "ViewExtension";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="row">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">View Extension</h1></div>
                <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                    @if (Model.Status == @NA.PMS.Common.Constants.Approved)
                    {
                        <i class=" glyphicon glyphicon-ok-sign" aria-hidden="true"></i>
                        <strong style="color: lightgreen;">  @Html.DisplayFor(model => model.StatusName)</strong>
                    }
                    else if (Model.Status == @NA.PMS.Common.Constants.RejectedProp)
                    {
                        <strong style="color: red;"><i class="glyphicon glyphicon-remove-sign" aria-hidden="true"></i>  @Html.DisplayFor(model => model.StatusName)</strong>
                    }
                    <a href="#" id="btnViewComments" class="" style="display:none">View Comments</a>
                </div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
                @{Html.RenderPartial("_AddEditExtension", Model);}

                @Html.HiddenFor(m => m.Id)
            </div>
            <div class="box-button text-center">
                <button type="button" value="Cancel" class="btn btn-default" onclick="javascript: window.location = '@Url.Action("ManageExtension", "PropertyAllotment")';">Back</button>

                @if (Model.Status == @NA.PMS.Common.Constants.Approved)
                {
                    <button type="button" class="btn btn-default" value="Submit" id="btnGenerateExtensionLetter">Generate Extension Letter</button>
                }
                else if (Model.Status == @NA.PMS.Common.Constants.RejectedProp || Model.Status == @NA.PMS.Common.Constants.Cancelled)
                {
                    <button type="button" class="btn btn-add" value="Submit" id="btnReSubmit">Re-Submit Request for Approval</button>
                }
                else if (Model.Status == @NA.PMS.Common.Constants.InProgress)
                {
                    <button type="button" class="btn btn-default" value="Submit" id="btnCancelRequest">Cancel Request</button>
                }
            </div>

        </div>
    </div>
</div>



<div id='divAssineRequetApproval' class='adminfeediv'>
    <div class="container-fluid">
        <div class="row topSpace">
            <div class="col-md-3 col-md-offset-1">
                @Html.Label("Assign To: ")
            </div>
            <div class="col-md-6">
                @(Html.Kendo().DropDownListFor(model => model.User)
                .DataTextField("text")
                .DataValueField("id")
                .Filter("contains")
                .OptionLabel("Select")
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetAssineTo", "Allotment");
                    });
                })
                .HtmlAttributes(new { style = "width:100%" })
                )
                @Html.ValidationMessageFor(model => model.User)
            </div>
        </div>
        <div class="row topSpace bottomSpace">
            <div class="col-md-6 col-md-offset-4">
                <button type='submit' id="btnReRequetForApproval" class='btn btn-default' value='Save'>Submit</button>
                <button type='button' class='btn btn-default' value='Cancel' onclick="CloseCommnetPopUpForApproval();">Close</button>
            </div>
        </div>
    </div>

</div>

<div id='DivCommentView'>
    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("From :")
        </div>
        <div class="col-md-9 col-sm-9 col-xs-12 form-group">
            @Html.DisplayFor(model => model.AssignTo)
        </div>
    </div>
    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Date :")
        </div>
        <div class="col-md-9 col-sm-9 col-xs-12 form-group">
            @Html.DisplayFor(model => model.Approved_Date)
        </div>
    </div>
    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Comments:")
        </div>
        <div class="col-md-9 col-sm-9 col-xs-12 form-group">
            @Html.TextAreaFor(model => model.Comment, new { style = "width: 100%", disabled = "disabled" })
        </div>
    </div>
    <div class="row topSpace bottomSpace">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">

        </div>
        <div class="col-md-9 col-sm-9 col-md-offset-1">
            <input type='button' class='btn btn-default' style="align-items :center; " value='Cancel' onclick="CloseCommnetPopUp();" />
        </div>
    </div>
</div>

<div id="divPrintChallan" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 60%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Extension Letter</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:400px;">
                <div id="divChallanBody"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv();">Print</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        GetPropertyDetails();
        if(($('#Status').val()== @NA.PMS.Common.Constants.Approved) || ($('#Status').val()== @NA.PMS.Common.Constants.RejectedProp))
        {
            $('#btnViewComments').show();
        }
        $("#btnReSubmit").click(function () {
            if (validateExtension())
                OpenAssineRequetApprovalPopUp();
        });
        $("a#btnViewComments").click(function () {
            OpenCommentViewPopUp()
        });
        $("#btnGenerateExtensionLetter").click(function () {
            GenerateExtensionLetter();
        });
        $("#divAssineRequetApproval").kendoWindow({
            modal: true,
            title: "Assign Request to Approver",
            visible: false,
            //width: "30%"
        });
        $("div[id='DivCommentView']").kendoWindow({
            title: "Comment",
            modal: true,
            visible: false,
            width: "40%"
        });
        var datepicker = $("#Leasedeeddate").data("kendoDatePicker");
        datepicker.readonly();
        var datepicker = $("#Possessiondate").data("kendoDatePicker");
        datepicker.readonly();
        var datepicker = $("#Completion_DueDate").data("kendoDatePicker");
        datepicker.readonly();
        $("#OnlineRequestRefNo").attr("readonly",true);
    });


    function OpenAssineRequetApprovalPopUp() {
        var win = $("#divAssineRequetApproval").data("kendoWindow");
        win.center();
        win.open();
    }

    function CloseCommnetPopUpForApproval() {
        var win = $("#divAssineRequetApproval").data("kendoWindow");
        win.close();
    }

    function OpenCommentViewPopUp() {
        var win = $("#DivCommentView").data("kendoWindow");
        win.center();
        win.open();
    }
    function CloseCommnetPopUp() {
        var win = $("#DivCommentView").data("kendoWindow");
        win.close();
    }

    $("#btnReRequetForApproval").click(function () {
        var Id = $("#Id").val();
        var user = $("#User").val();
        var rid = $("#Rid").val();
        var propertyNu = $("#hdnPropertyNu").val();
        var completionDueDate = $("#Completion_DueDate").val();
        var extensionGivenDate = $("#Extension_Due_Date").val();
        var extensionCharge = $("#Extension_Charge").val();
        if (user != "") {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ Id: Id, rid: rid, propertyNu: propertyNu, completionDueDate: completionDueDate, extensionGivenDate: extensionGivenDate, extensionCharge: extensionCharge, user: user }),
                url: '/PropertyAllotment/UpdateExtension',
                success: function (result) {
                    if (result == true) {
                        window.location.href = '@Url.Action("ManageExtension", "PropertyAllotment")';;
                        return false;
                    }
                    else {
                        return true;
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //alert(respText);
                }
            });
        }
        else {
            alert("Please Select Assine To.");
        }
    });


    $("#btnCancelRequest").click(function () {
        debugger;
        var Id = $("#Id").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ Id: Id }),
            url: '/PropertyAllotment/CancelExtension',
            success: function (result) {
                if (result == true) {
                    window.location.href = '@Url.Action("ManageExtension", "PropertyAllotment")';;
                    return false;
                }
                else {
                    return true;
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }
        });
    });

    function GenerateExtensionLetter()
    {
        var rId = $("#Rid").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rid: rId }),
            url: '/PropertyAllotment/GenerateExtensionLetter',
            success: function (result) {
                $("#divChallanBody").html(result);
                $("#divPrintChallan").modal('show');
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }
        });
    }

    function PrintDiv() {
        var contents = document.getElementById("divChallanBody").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }
</script>