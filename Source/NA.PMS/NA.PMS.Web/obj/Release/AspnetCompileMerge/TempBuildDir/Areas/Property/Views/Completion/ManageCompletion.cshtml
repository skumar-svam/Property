@using Kendo.Mvc.UI
@{
    ViewBag.Title = "ManageCompletion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .schemeMasterGrids {
        color: blue;
        text-decoration: underline;
    } 
    .schemeMasterGrids:hover {
            color: blue;
            cursor: pointer;
            text-decoration: underline;
        }
    /*#btnRequest {
        float: right;
    }*/
</style>

<div class="ManageCompletion">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Completion Request</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                <a href="#" id="btnRequest" class="" onclick="javascript: AddCompletionReq(event);">Add Request</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>

    <div class="k-grid-content">

        @(Html.Kendo().Grid<NA.PMS.Model.PropertyCompletionModel>()
                .Name("gridCompletion")
        .Columns(columns =>
        {
            columns.Bound(c => c.PropertyId).Width(10).Title("").Hidden(true);
            columns.Bound(c => c.SchemeId).Width(10).Title("").Hidden(true);
            columns.Bound(c => c.DepttId).Width(10).Title("").Hidden(true);
            columns.Bound(c => c.ReqNo).Title("Request No").Width(130).ClientTemplate("<a href=\"/Property/Completion/ViewCompletionRequest/#= ReqNo#\" id='v_#=ReqNo#'  style = 'width: 30px;' >#=ReqNo#</a>");
            columns.Bound(c => c.RId).Title("Registration Id").Width(150);
            columns.Bound(c => c.DepttName).Title("Department");
            columns.Bound(c => c.SectorName).Title("Sector").Width(100);
            columns.Bound(c => c.BlockName).Title("Block").Width(100);
            columns.Bound(c => c.PropertyNo).Title("Property No").Width(130);
            //columns.Bound(c => c.PropNo).Title("Property No");
            columns.Bound(c => c.CompletionDate).Title("Completion Date").Format("{0:dd/MM/yyyy}");
            columns.Bound(c => c.ApplicantName).Title("Applicant/Company Name");
            //columns.Bound(c => c.ReqNo).Title("Action").Width(100).ClientTemplate("<a href=\"/Property/Completion/ViewCompletionRequest/#= ReqNo#\" id='v_#=ReqNo#'  style = 'width: 30px;' >Completion Letter</a>");
            //columns.Bound(c => c.ReqNo).Title("Action").Width(100).ClientTemplate("<a onclick='javascript:PrintChallan(#=RID#)' id='v_#=RID#'  style = 'width: 30px;' >Payment Challan</a>");
            columns.Bound(c => c.ReqNo).Title("Letter").ClientTemplate("#{# <a onclick='javascript:PrintCompletionRequestLetter(this);' class='schemeMasterGrids'> Completion Letter</a> #} #").Width(130).Filterable(false).Sortable(false);
            columns.Bound(c => c.ReqNo).Title("Challan").ClientTemplate("#{# <a onclick='javascript:PrintChallan(this);' class='schemeMasterGrids'> Payment Challan</a> #} #").Width(130).Filterable(false).Sortable(false);
        })
        .Sortable()
        .Filterable()
                .Resizable(resize => resize.Columns(true))
                //.ToolBar(toolBar =>
                //{
                //    toolBar.Custom().Text("<i class='fa fa-plus-square' aria-hidden='true'></i> Add Request").HtmlAttributes(new { onclick = "javascript:AddCompletionReq(event);", @class = "k-button", id = "btnRequest" });
                //})
        .Pageable(pageable => pageable
                                               .Enabled(true)
                                               .Refresh(true)
                                               .PageSizes(true)
                                            )
                                            .Groupable()
        .DataSource(dataSource => dataSource
        .Ajax().Model(model => model.Id(c => c.RId))
                        .ServerOperation(true).Sort(sort => sort.Add("ReqNo").Descending())
                .Read(read => read.Action("GetCompletionData", "Completion")).PageSize(20)
        )
        )
    </div>
</div>


@*PopUp to print*@
<div id="divPrintChallan" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" style="width: 55%">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Challan</b></h4>
            </div>
            <div class="modal-body" id="divChallanBody">

            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnChallanPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv('challan');">Print</button>

            </div>
        </div>
    </div>
</div>

<div id="divPrintCompletionRequest" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" style="width: 55%">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Completion Request</b></h4>
            </div>
            <div class="modal-body" id="divCompletionBody">

            </div>
            <div style="page-break-after: always;"></div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnCompletionRequestPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv('completionrequest');">Print</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    function AddCompletionReq(event) {
        event.preventDefault();
        window.location.href = '@Url.Action("AddCompletionRequest", "Completion")';
    }

    function PrintChallan(row) {
        var tr = $(row).parent().parent();
        var propId = $(tr).children("td:eq(0)").text();
        var schemeId = $(tr).children("td:eq(1)").text();
        var deptId = $(tr).children("td:eq(2)").text();
        var rId = $(tr).children("td:eq(4)").text();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ propId: propId, schemeId: schemeId, deptId: deptId, rId: rId }),
            url: '/DocParser/PrintCompletionChallan',
            success: function (result) {
                $("#divChallanBody").html(result);
                $("#divPrintChallan").modal('show');
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
                alertify.error("Some error occured. Please try again later.");
            }
        });
    }

    function PrintCompletionRequestLetter(row) {
        var tr = $(row).parent().parent();
        var rId = $(tr).children("td:eq(4)").text();
        var deptId = $(tr).children("td:eq(2)").text();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rId: rId, deptId: deptId }),
            //url: '/DocParser/PrintCompletionRequest',
            url: '/PropertyRegistration/GenerateCompletionLetter',
            success: function (result) {
                $("#divCompletionBody").html(result);
                $("#divPrintCompletionRequest").modal('show');
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
                alertify.error("Some error occured. Please try again later.");
            }
        });
    }

    function PrintDiv(controlID) {
        var contents;
        if (controlID == "challan")
            contents = document.getElementById("divChallanBody").innerHTML;
        else
            contents = document.getElementById("divCompletionBody").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }
 
</script>

