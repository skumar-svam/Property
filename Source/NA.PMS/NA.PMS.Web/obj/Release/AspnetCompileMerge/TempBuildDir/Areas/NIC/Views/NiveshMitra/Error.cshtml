@model NA.PMS.NICServices.SWPPostViewModel
@using Kendo.Mvc.UI
@using NA.PMS.Common

@{
    ViewBag.Title = "Service - Error";
    Layout = "~/Areas/NIC/Views/Shared/_Layout.cshtml";
}
<style>
    .gridTitle {
        font-size: 230% !important;
    }
</style>

<div class="col-lg-12 col-md-12 col-sm-12 nic-portal" data-nic="property-validation" style="margin-top:80px;">
    <div class="col-md-12 hidden-field">
        @Html.HiddenFor(model => model.TxtControlID)
        @Html.HiddenFor(model => model.TxtUnitID)
        @Html.HiddenFor(model => model.TxtServiceID)
        @Html.HiddenFor(model => model.TxtProcessIndustryID)
        @Html.HiddenFor(model => model.TxtApplicationID)
        @Html.HiddenFor(model => model.TxtRequestID)
    </div>
    <div class="col-md-12" style="position:static">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12"><center><h1 class="gridTitle">Client Service</h1></center></div>
        </div>
    </div>
    <div class="col-md-12" style="position:static">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12"><center><h1 class="gridTitle" id="error_text" style="color:red;"></h1></center></div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {

        @{
            if (TempData["ErrorMessage_NIC"] != null && TempData["ErrorMessage_NIC"] != "")
            {
                @:$("#error_text").html('@TempData["ErrorMessage_NIC"]');
            }
         }
    });
</script>



