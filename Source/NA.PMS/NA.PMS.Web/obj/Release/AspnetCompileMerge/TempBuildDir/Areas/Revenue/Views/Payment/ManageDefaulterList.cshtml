@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@using NA.PMS.Common;
@model NA.PMS.Model.LeaseRentAndInstallmentDashboard

@{
    ViewBag.Title = "ManageDefaulterList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .k-grid .k-grid-header .k-header .k-link {
        overflow: visible !important;
        white-space: normal !important;
        text-align: center;
        color:white;
    }
</style>

<div class="ManageDefaulterList">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Defaulter List</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">

            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 content-top-spce">
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <div class="form-bx">
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <label>Department</label>
                        @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                            .Filter("contains")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel(" --- select ---")
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => transport.Read(read => read.Action("GetDepartmentList", "Finance", new { area = "Revenue" })))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(6);
                            })
                            .Events(events => { events.Change("DeptChange"); })
                            .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                        )
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group" style="text-align:right;">
                        <label>Month</label>
                        @(Html.Kendo().DatePicker()
                          .Name("DDMonth")
                          .Start(CalendarView.Year)
                          .Depth(CalendarView.Year)
                          .Format("MMMM yyyy")
                          .Value(DateTime.Now)
                                //.Min(DateTime.Now)
                          .HtmlAttributes(new { style = "width: 90%; float:right;", onkeydown = "return false;" })
                          .Events(e => e.Change("ChangeEvent"))
                        )
                    </div>
                </div>
            </div>

            <h2 id="grid-head" class="blck-heading" style="margin-bottom: 0px;">Defaulter List</h2>
            <div class="col-md-12 k-grid-content">
                @*id="leaserent-dues-grid"*@
                @(Html.Kendo().Grid<NA.PMS.Model.DefaulterViewModel>()
                        .Name("GridDefaulterList")
                        .Excel(excel => excel.AllPages(true).Filterable(true).FileName("DefaulterList.xlsx"))
                        .ToolBar(toolsExcel => toolsExcel.Excel())
                        .Columns(columns =>
                        {
                            columns.Bound(c => c.Id).Hidden(true);
                            columns.Bound(c => c.RegistrationId).Title("Registration Id").ClientTemplate("<a href='" + "/Property/PropertyAllotment/PropertyDetails/#= RegistrationId #'>#= RegistrationId #</a>").Filterable(true).HeaderHtmlAttributes(new { style = "background-color:#4747f1;" });
                            columns.Bound(c => c.PropertyNo).Title("Property No").HeaderHtmlAttributes(new { style = "background-color:#4747f1;" });
                            columns.Group(g =>
                            g.Title("Leaserent Dues Amount").HeaderHtmlAttributes(new { style = "background-color:#4747f1;" })
                            .Columns(info =>
                            {
                                //info.Bound(c => c.LeaserentDuesAmount).Title("Leaserent (<span class='fa fa-rupee'></span>)");
                                //info.Bound(c => c.LeaserentInterestAmount).Title("Interest (<span class='fa fa-rupee'></span>)");
                                info.Bound(c => c.TotalLeaserentDues).Title("Total Dues (<span class='fa fa-rupee'></span>)").HeaderHtmlAttributes(new { style = "background-color:coral;" });
                                info.Bound(c => c.LeaserentPaidUpto).Title("Paid Upto Date").HeaderHtmlAttributes(new { style = "background-color:#28d3ef;" });
                            })
                        );
                            columns.Group(g =>
                            g.Title("Installment Dues Amount").HeaderHtmlAttributes(new { style = "background-color:#4747f1;" })
                            .Columns(inf =>
                            {
                                //inf.Bound(c => c.InstallmentAmount).Title("Installment (<span class='fa fa-rupee'></span>)");
                                //inf.Bound(c => c.PenalInstallmentInterestAmount).Title("Penal Interest (<span class='fa fa-rupee'></span>)");
                                inf.Bound(c => c.TotalInstallmentDues).Title("Total Dues (<span class='fa fa-rupee'></span>)").HeaderHtmlAttributes(new { style = "background-color:coral;" });
                                inf.Bound(c => c.InstallmentNumber).Title("Installment Number").HeaderHtmlAttributes(new { style = "background-color:#28d3ef;" });
                            })
                        );
                            columns.Bound(c => c.CalculationDate).Title("Calculation Date").Format("{0:dd-MMM-yyyy}").HeaderHtmlAttributes(new { style = "background-color:#4747f1;" });
                            columns.Bound(c => c.CalculationDate).Title("Allotment Date").Format("{0:dd-MMM-yyyy}").HeaderHtmlAttributes(new { style = "background-color:#4747f1;" });
                        })
                        .Sortable().Filterable().Resizable(resize => resize.Columns(true))
                        .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                        .DataSource(dataSource => dataSource
                        .Ajax().ServerOperation(true)
                        .Read(read => read.Action("GetDefaulterList", "Payment", new { area = "Revenue" }).Data("DefaulterParam")).PageSize(10)
                            )
                )
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        //HideFiles();
    });

    function DeptChange() {
        $('#GridDefaulterList').data("kendoGrid").dataSource.read();
        //if ($('#DepartmentId').val() == "") {
        //    alertify.error("Please Select Department");
        //    return false;
        //}
        //else {
        //    $("DDMonth").prop('disabled', false);
        //    $("DDMonth").val('');
        //}
    }

    function HideFiles() {
        $('#grid-head').hide();
        $('#GridDefaulterList').hide();
        $("DDMonth").prop('disabled', true);
    }

    function ChangeEvent() {
        $('#GridDefaulterList').data("kendoGrid").dataSource.read();
        //if ($('#DepartmentId').val() == "") {
        //    alertify.error("Select Department.");
        //    return false;
        //}
        //else if ($('#DDMonth').val() == "") {
        //    alertify.error("Select Month.");
        //    return false;
        //}
        //else {
        //    $('#grid-head').show();
        //    $('#GridDefaulterList').show();
        //    $('#GridDefaulterList').data("kendoGrid").dataSource.read();
        //}
    }

    function DefaulterParam() {
        var month = $('#DDMonth').val();
        var year = null;
        //var d = new Date();
        //var currentYr = d.getFullYear();
        if (year == null) {
            //currentDate = '1 ' + month //+ '-' + currentYr
            startDate = '1 ' + month
        }
        else {
            currentDate = '1 ' + month //+ '-' + year
        }
        var deptId = $("#DepartmentId").val();
        var model = { DepartmentId: deptId, StartDate: startDate, Month: month };
        return model;
