                                                            type: 'Post',
                                                            contentType: 'application/json; charset=utf-8',
                                                            data: JSON.stringify({ bankId: $("#bankId").val(), branchId: $("#branchId").val(), branchName: $("#branchName").val(), newaccountNumber: $("#accountNumber").val(), newBank: $("#bankName").val(), schemeId: $("#scheId").val(), DdlAccountNumber: $("#DdlAccountNumber").val() }),
                                                            url: "/Scheme/AddBank",
                                                            success: function (data) {
                                                                if (data == true) {
                                                                    $("#gridBanks").data("kendoGrid").dataSource.read();
                                                                    $("#bankId").data("kendoDropDownList").value("");
                                                                    $("#branchId").data("kendoDropDownList").value("");
                                                                    $('#bankName').val('');
                                                                    $("#branchName").val('');
                                                                    $("#accountNumber").val('');
                                                                    $("#DdlAccountNumber").data("kendoDropDownList").wrapper.show();
                                                                    $('#branchName').hide();
                                                                    $('#lblBranchAddress').hide();
                                                                    $('label[for="branchName"]').hide();
                                                                    $('label[for="bankName"]').hide();
                                                                    $('span[for="accountNumber"]').hide();
                                                                    $('#bankName').hide();
                                                                    $('#branchName').val("");
                                                                    $('#bankName').val("");
                                                                    $('#accountNumber').hide();
                                                                    $('#lblBankName').hide();
                                                                    $('span[for="bankName"]').hide();
                                                                    $('span[for="branchName"]').hide();
                                                                    $("#bankId").data("kendoDropDownList").dataSource.read();
                                                                    $("#branchId").data("kendoDropDownList").dataSource.read();
                                                                    $('#lblAccounttxt').hide();
                                                                    $('#lblAccountddl').show();
                                                                    $('#btnNext4').removeAttr('disabled');
                                                                    $('#btnPre4').removeAttr('disabled');
                                                                    $(".fifth .fke-link").hide();
                                                                    $(".fifth .accordion-section-title").show();
                                                                    //$('#divBranchName').css("display",false);
                                                                    setTimeout(function () { ActivateScheme(); }, 2000);
                                                                    //$('#spanBankId').hide();
                                                                }
                                                            },
                                                            error: function (objAjaxRequest, strError) {
                                                                var respText = objAjaxRequest.responseText;
                                                                //alert(respText);
                                                            }
                                                        });

                                                    }
                                                }
                                            },
                                            error: function (objAjaxRequest, strError) {
                                                var respText = objAjaxRequest.responseText;
                                                //alert(respText);
                                            }
                                        });
                                        //alert(accnumber);
                                        //alert(checkbankname);

                                    }
                                },
                                error: function (objAjaxRequest, strError) {
                                    var respText = objAjaxRequest.responseText;
                                    //alert(respText);
                                }
                            });

                        }
                    },
                    error: function (objAjaxRequest, strError) {
                        var respText = objAjaxRequest.responseText;
                        //alert(respText);
                    }
                });
            }
        });
        $('#accountNumber').attr('disabled', 'disabled');
        $('label[for="branchName"]').hide();
        $('#lblBranchAddress').hide();
        $('#branchName').hide();
        $('label[for="bankName"]').hide();
        $('#lblBankName').hide();
        $('#bankName').hide();
        $('#spanAccount').hide();
        $('#spanbranch').hide();
        $('#lblAccounttxt').hide();
        $('#bankName').blur(function () {
            CheckBankName();
        });
        $('#accountNumber').blur(function () {
            CheckAccountNumber();
        });
        $('#spanBankId').hide();
        $('#btnNext4').click(function () {
            $("#acc5").click();
        });
        $('#btnPre4').click(function () {
            $("#acc3").click();
        });
        $('#btnNext41').click(function () {
            $("#acc5").click();
        });
        $('#btnPre41').click(function () {
            $("#acc3").click();
        });
    });

    function ValidatebankScheme() {
        var selectebankValue = $('#bankId');
        var selectedbranchValue = $('#branchId');
        var accountId = $('#accountNumber');
        var ddlAccountNumber = $("#DdlAccountNumber").val();
        if (selectebankValue.val() == "") { //Case when no Bank is seleceted.
            alertify.error('Please select a Bank');
            return false;
        }
        if (selectebankValue.val() != -1) { //Case when Bank selected is not "Other".
            //alert();
            if (selectedbranchValue.val() == "") {
                alertify.error('Please select an branch.');
                return false;
            }
            else if (selectedbranchValue.val() != -1) {
                if (ddlAccountNumber == "") {
                    alertify.error('Please select an account number.');
                    return false;
                }
            }
            else {
                if ($("#branchName").val().trim() == "") {
                    alertify.error("Please enter Branch Address.");
                    return false;
                }
                if (accountId.val().trim() == "") {
                    alertify.error('Please enter an account number.');
                    return false;
                }
            }
        }
        else //When "Other" is selected as Bank. No need to check for Branch selection in this case.
        {
            if ($("#bankName").val().trim() == "") {
                alertify.error("Please enter Bank Name");
                return false;
            }
            else if(!(isNaN($("#bankName").val().trim())))
            {
                alertify.error("Please enter valid Bank Name");
                return false;
            }
            else if ($("#branchName").val().trim() == "") {
                alertify.error("Please enter Branch Name");
                return false;
            }
            else if (accountId.val().trim() == "") {
                alertify.error('Please enter an account number.');
                return false;
            }
        }
        return true;
    }

    function CleanAccountNumber() {
        $('#accountNumber').val("");
        var bankID = $('#bankId').val();
        if (bankID == -1) {
            $('#accountNumber').show();
            $('#accountNumber').removeAttr('disabled');
            $('#lblAccountddl').hide();
            $('#lblAccounttxt').show();
            $("#DdlAccountNumber").data("kendoDropDownList").wrapper.hide();
            $('#branchName').show();
            $('label[for="branchName"]').show();
            $('label[for="bankName"]').show();
            $('#lblBankName').show();
            $('#lblBranchAddress').show();
            $('#bankName').show();
            $('#branchName').val("");
            $('#bankName').val("");
            $('span[for="accountNumber"]').hide();
            $('span[for="bankName"]').hide();
            $('span[for="branchName"]').hide();
            $('#lblAccountddl').hide();
            $('#divAccountLabel').hide();
            $('#divAccountDropDown').hide();
        }
        else {
            //$("#DdlAccountNumber").data("kendoDropDownList").wrapper.show();
            $('#branchName').hide();
            $('#lblAccountddl').show();
            $('#lblAccounttxt').hide();
            $('label[for="branchName"]').hide();
            $('label[for="bankName"]').hide();
            $('span[for="accountNumber"]').hide();
            $('#bankName').hide();
            $('#lblBankName').hide();
            $('#lblBranchAddress').hide();
            $('#branchName').val("");
            $('#bankName').val("");
            $('#accountNumber').hide();
            $('span[for="bankName"]').hide();
            $('span[for="branchName"]').hide();
            $('#lblAccountddl').show();
            $('#divAccountLabel').show();
            $('#divAccountDropDown').show();
        }
    }


    function CheckBankName() {
        var bankID = $('#bankId').val();
        var bankName = $('#bankName').val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ bankID: bankID, bankName: bankName }),
            url: '/Scheme/IsBankNameDuplicate',
            success: function (result) {
                if (result == true) {
                    $('#spanBankId').show();
                    return false;
                }
                else {
                    $('#spanBankId').hide();
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }
        });
    }
    function CheckAccountNumber() {
        var bankID = $('#bankId').val();
        var accountNumber = $('#DdlAccountNumber').val();
        if (bankID == -1) {
            accountNumber = $('#accountNumber').val();
        }
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ bankID: bankID, accountNumber: accountNumber }),
            url: '/Scheme/IsAccountNumberDuplicate',
            success: function (result) {
                if (result == true) {
                    alertify.error("Bank A/C No. already exists.")
                    return false;
                }
                else {
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }
        });
    }

    function FilterBankName() {
        $('#accountNumber').val("");
        var bankID = $('#bankId').val();
        if (bankID == -1) {
            $('#divAccountNo').show();
            $('#divAccountLabel').hide();
            $('#lblAccountddl').hide();
            $('#divAccountDropDown').hide();
            $('#DdlAccountNumber').hide();
            $('#divBranchName').show();
            $('#lblBranchAddress').show();
            $('#branchName').show();
            $('#lblAccounttxt').show();
            $('#accountNumber').show();
            $('#accountNumber').removeAttr('disabled');
            $('#lblBankName').show();
            $('#bankName').show();
            VacantInputField();
        }
        else {
            $('#divAccountNo').show();
            $('#divAccountLabel').show();
            $('#lblAccountddl').show();
            $('#divAccountDropDown').show();
            $('#lblBankName').hide();
            $('#bankName').hide();
            $('#divBranchName').hide();
            $('#lblBranchAddress').hide();
            $('#branchName').hide();
            $('#lblAccounttxt').hide();
            $('#accountNumber').hide();
            VacantInputField();
        }
    }

    function FilterBankBranch() {
        var bankVal = $('#bankId').val();
        var branchVal = $('#branchId').val();
        if (bankVal != -1) {
            if (branchVal == -1) {
                $('#divAccountNo').hide();
                $('#divAccountLabel').hide();
                $('#lblAccountddl').hide();
                $('#divAccountDropDown').hide();
                $('#lblBankName').hide();
                $('#bankName').hide();
                $('#divBranchName').show();
                $('#lblBranchAddress').show();
                $('#branchName').show();
                $('#lblAccounttxt').show();
                $('#accountNumber').show();
                $('#accountNumber').removeAttr('disabled');
                VacantInputField();
            }
            else {
                $('#divAccountNo').show();
                $('#divAccountLabel').show();
                $('#lblAccountddl').show();
                $('#divAccountDropDown').show();
                $('#lblBankName').hide();
                $('#bankName').hide();
                $('#divBranchName').hide();
                $('#lblBranchAddress').hide();
                $('#branchName').hide();
                $('#lblAccounttxt').hide();
                $('#accountNumber').hide();
                VacantInputField();
            }
        }
    }

    function VacantInputField(){
        $('#accountNumber').val("");
        $('#bankName').val("");
        $('#branchName').val("");
    }

</script>