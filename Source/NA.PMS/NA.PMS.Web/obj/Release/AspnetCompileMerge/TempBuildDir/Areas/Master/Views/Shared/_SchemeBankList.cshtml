    function RemoveBankRecord(refId) {
        var schemeID = $("#scheId").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ refId: refId, schemeID: schemeID }),
            url: '/Scheme/RemoveBankRecord',
            success: function (result) {
                if (result == true) {
                    $("#gridBanks").data("kendoGrid").dataSource.read();
                    var gridBanks = $("#gridBanks").data("kendoGrid").dataSource.data();
                    if (gridBanks.length == 1) {
                        IsSchemeCompletedByRemove(false);
                    }
                    alertify.success("Record deleted successfully.");
                }
            },
            error: function (obj) {
                //alert('Error While Saving Record.');
            }
        });
    }

