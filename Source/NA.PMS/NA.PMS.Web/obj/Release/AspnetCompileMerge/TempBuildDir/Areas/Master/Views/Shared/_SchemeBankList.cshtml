@model NA.PMS.Model.SchemeViewModel
@using Kendo.Mvc.UI;

<div class="scheme-bank">
    <div class="col-md-12" id="bankDetail">
        <h2 class="blck-heading">Bank Information</h2>
        <div class="form-bx col-md-12 col-sm-12 col-xs-12">
            <div class="row">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label>Bank Name</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().DropDownListFor(model => model.BankId)
                    .DataTextField("text")
                    .DataValueField("id")
                    .OptionLabel("Select")
                    .Filter("contains")
                    .DataSource(source =>source.Read(read => read.Action("GetAllBanks", "Scheme")))
                    .Events(model => model.Change("FilterBankName"))
                    .HtmlAttributes(new { style = "width: 100%", @class = "schemeForms" })
                    )
                    @Html.ValidationMessageFor(model => model.BankId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label>Branch Address</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @(Html.Kendo().DropDownListFor(model => model.BranchId)
                    .DataTextField("text")
                    .DataValueField("id")
                    .OptionLabel("Select")
                    .DataSource(source =>source.Read(read =>read.Action("GetAllBranchs", "Scheme").Data("filterBranches")).ServerFiltering(true))
                    .CascadeFrom("bankId")
                    .Events(model => model.Change("FilterBankBranch").DataBound("onDataBound"))
                    .HtmlAttributes(new { style = "width: 100%", @class = "schemeForms" })
                    )
                    @Html.ValidationMessageFor(model => model.BranchId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row" id="divAccountNo">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="divAccountLabel"><label>Account No</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="divAccountDropDown">
                    @(Html.Kendo().DropDownListFor(model => model.AccountNo)
                    .Name("DDLAccountNo")
                    .DataTextField("text")
                    .DataValueField("id")
                    .OptionLabel("Select")
                    .DataSource(source =>source.Read(read =>read.Action("GetAccountNumber", "Scheme").Data("filterBankAccounts")).ServerFiltering(true))
                    .CascadeFrom("BranchId")
                    .HtmlAttributes(new { style = "width: 100%", @class = "schemeForms" })
                    )
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label>Bank Name</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @Html.TextBoxFor(model => model.BankName, htmlAttributes: new { @class = "form-control", @id = "bankName" })
                    @Html.ValidationMessageFor(model => model.BankName, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row" id="divBranchName">
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label>Branch Address</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @Html.TextBoxFor(model => model.BranchName, htmlAttributes: new { @class = "form-control", @maxlength = "30" })
                    <span id="spanbranch" class="text-danger">This account number already Exists.</span>
                    @Html.ValidationMessageFor(model => model.BranchName, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group"><label>Account No</label></div>
                <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                    @Html.TextBoxFor(model => model.AccountNo, htmlAttributes: new { @class = "form-control", @maxlength = "16" })
                    <span id="spanAccount" class="text-danger">This account number already Exists.</span>
                    @Html.ValidationMessageFor(model => model.AccountNo, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 col-sm-12 col-xs-12 form-group" style="text-align:center;padding-top:10px">
                </div>

            </div>
        </div>
    </div>
    <div class="row scheme-rw-btn">
        <div class="col-md-4 col-sm-4 col-xs-4 text-left">
            <button type="button" class="btn btn-add" value="Add" id="btnPre4">Previous <i class="glyphicon glyphicon-backward"></i></button>
        </div>
        <div class="col-md-4 col-sm-4 col-xs-4 text-center">
            <button type="button" class="btn btn-add" value="Add" id="btnAddBank"> Add</button>
        </div>
        <div class="col-md-4 col-sm-4 col-xs-4 text-right">
            <button type="button" class="btn btn-add" value="Add" id="btnNext4">Next <i class="glyphicon glyphicon-forward"></i></button>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 k-grid-content" style="margin-bottom:10px;">
        @(Html.Kendo().Grid<NA.PMS.Model.Banks>()
            .Name("gridBanks")
            .Columns(columns =>
            {
                columns.Bound(c => c.bankName).Title("Bank Name").Width(100);
                columns.Bound(c => c.bankId).Hidden(true);
                columns.Bound(c => c.branchId).Hidden(true);
                columns.Bound(c => c.branchName).Width(100).Title("Branch Name");
                columns.Bound(c => c.accountNumber).Width(100).Title("Account Number");
                if (ViewBag.view != "Yes")
                {
                    columns.Bound(c => c.refId).Title("Action").ClientTemplate("<a onclick='javascript:RemoveBankRecord(\"#=refId#\");' class='schemeMasterGrids'>Remove</a>").Width(50).Filterable(false).Sortable(false);
                }
            })
            .Sortable().Filterable().Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
            .AutoBind(true)
            .DataSource
            (
                    dataSource => dataSource
                    .Ajax().ServerOperation(true).Model(model => model.Id(p => p.bankId))
                    .Read(read => read.Action("GetBankData", "Scheme").Data("AdditionalData")).PageSize(20)
            )
        )
    </div>
    <div class="row scheme-rw-btn">
        <div class="col-md-4 col-sm-4 col-xs-4 text-left">
            <button type="button" class="btn btn-add" value="Add" id="btnPre41">Previous <i class="glyphicon glyphicon-backward"></i></button>
        </div>
        <div class="col-md-4 col-sm-4 col-xs-4 text-center">
        </div>
        <div class="col-md-4 col-sm-4 col-xs-4 text-right">
            <button type="button" class="btn btn-add" value="Add" id="btnNext41">Next <i class="glyphicon glyphicon-forward"></i></button>
        </div>
    </div>
</div>

<script type="text/javascript">
    function filterBranches() {
        return {
            bankId: $("#BankId").val()
        };
    }

    function filterBankAccounts() {
        return {
