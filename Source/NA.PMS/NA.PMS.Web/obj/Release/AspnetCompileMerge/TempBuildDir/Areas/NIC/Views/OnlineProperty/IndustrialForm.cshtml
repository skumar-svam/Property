    function SubmitOpenSchemeForm() {
        //var windowWidget = $("#divOTPwindow").data("kendoWindow");
        //kendo.ui.progress(windowWidget.element, true);
        var atype = $('#DDLApplicantType').val();
        var ftype = $('#DDLApplicationFormType').val();
        $('#hdnFormType').val("Online"); //$('#hdnFormType').val(form);
        $('#ApplicantType').val(atype);
        $('#ApplicationFormType').val(ftype);

        var formData = new FormData($('form').get(0));
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            data: formData,
            url: '/NIC/OnlineProperty/SaveOpenSchemeFormDetail',
            success: function (result) {
                if (result != null) {
                    $("#Id").val(result.ApplicationFormId);
                    $("#ApplicationFormId").val(result.ApplicationFormId);
                    var gst = CalculateGST(result.ApplicationFee);
                    var totalAmount = parseFloat((parseFloat(result.ApplicationFee) + parseFloat(gst)).toFixed(2));
                    $("#schemeformfee").val(totalAmount);//schemeformfee
                    //$('#ApplicationFee').val(totalAmount);
                    $("#FormFeeWithGST").val(totalAmount);
                    $(".area-form-fee").show();
                    //$('#div-box-button').css("display", "none");
                    $('#btnSubmit').css("disabled", "disabled");
                    //kendo.ui.progress(windowWidget.element, false);
                   
                    alert("To Proceed Further Pay Application Fee via Nivesh Mitra");
                }
                //$('#divOTPwindow').data("kendoWindow").close();
            },
            error: function (ajaxRequest, strError) {
                kendo.ui.progress(windowWidget.element, false);
                //$('#divOTPwindow').data("kendoWindow").close();
                alertify.error("Network error, try again later");
            }
        });
    }

