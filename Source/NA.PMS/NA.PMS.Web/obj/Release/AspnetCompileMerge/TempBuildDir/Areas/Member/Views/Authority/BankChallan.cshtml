@model NA.PMS.Model.ChallanViewModel

@using NA.PMS.Common;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
@{
    ViewBag.Title = "Bank Challan";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    var userInfo = HttpContext.Current.Session["CurrentUser"] as NA.PMS.Web.Models.CurrentUserDetail;
    if (userInfo != null)
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Blank.cshtml";
    }
}

<style>
    #divChallanGrid {
        display: none;
    }

    .lbl-form-control {
        /*background:#ececec;*/
        background: url(/Content/Images/boxed-bg.jpg) repeat;
    }

    .col-custom {
        width: 90%;
        float: right;
    }
    .challan-btn-box{
        /*float: left;*/
        border-radius: 0 0 3px 3px;
        border: solid rgb(218, 218, 218);
        border-width: 0px 1px 1px 1px;
        padding: 10px 30px;
        margin-top: 0;
        margin-bottom: -30px;
        width: 100%;
    }
</style>

<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1" id="bank-challan">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Generate Challan</h1></div>
            <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 content-top-spce">
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading" style="margin-bottom:6px;">Property Details</h2>
            <div class="form-bx">
                <div>
                    @Html.HiddenFor(m => m.DepartmentId)
                    @Html.HiddenFor(m => m.ApplicantType)
                    @Html.HiddenFor(m => m.ApplicantMaster)
                    @Html.HiddenFor(m => m.PropertyType)
                    @Html.HiddenFor(m => m.TotalArea)
                    @Html.HiddenFor(m => m.FloorArea)
                    @Html.HiddenFor(m => m.IFSCCode)
                    @Html.HiddenFor(model => model.Amount, htmlAttributes: new { @id = "hdnAmmount" })
                    @Html.HiddenFor(model => model.AccountHeadId, htmlAttributes: new { @id = "hdnAccountHeadId" })
                    @Html.HiddenFor(model => model.AccountSubHeadId, htmlAttributes: new { @id = "hdnAccountSubHeadId" })
                </div>
                <div class="row">
                    <div class="col-md-5 col-sm-4 col-xs-12 form-group" id="div-allottee-type" style="text-align:right;">
                        <span>Do you have your Registration Id? </span>
                        <input type="radio" name="RegistrationType" id="rbtnRegistered" value="Registered" checked="checked">&nbsp;<b>Yes</b> &nbsp;&nbsp;
                        <input type="radio" name="RegistrationType" id="rbtnUnRegistered" value="UnRegistered" />&nbsp;<b>No</b>
                    </div>
                    <div class="col-md-2 col-sm-4 col-xs-12 form-group">
                        
                    </div>
                    <div class="col-md-5 col-sm-4 col-xs-12 form-group" style="text-align:right;">
                        <a href="/Member/Authority/Challan" target="_blank">Based on plot Click here</a>
                    </div>
                </div>
               
                <div class="row">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group" id="divDropDownRid">
                        @Html.Label("Registration Id", htmlAttributes: new { @class = "required" })
                        @(Html.Kendo().DropDownListFor(m => m.RegistrationId)
                            .Filter("contains")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel("---Select---")
                            .Enable(true)
                            .AutoBind(true)
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => { transport.Read("GetRegistrationIdListAsDataSource", "Authority", new { area = "Member" }); })
                                .Schema(schema => { schema.Data("Data").Total("Total"); })
                                .PageSize(100);
                            })
                            .Events(events => { events.Change("ChangeRegistrationIdEvent"); })
                            .HtmlAttributes(new { @class = "col-custom", style = "width:90%; float:right;" })
                        )
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group" id="divTextBoxRid">
                        @Html.Label("Registration Id", htmlAttributes: new { @class = "required" })
                        <input  type="text" id="RegdId" class="form-control" onchange="ChallanGridEvent()" style="width:90%;float:right;" readonly="readonly"/>
                    </div>

                        <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                            @Html.Label("Department")
                            @Html.TextBoxFor(model => model.Department, htmlAttributes: new { @class = "form-control", style = "width:90%;float:right;", @readonly = "readonly" })
                        </div>
                        <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                            @Html.Label("Property No")
                            @Html.TextBoxFor(model => model.PropertyNo, htmlAttributes: new { @class = "form-control", style = "width:90%;float:right;" })
                        </div>
                    </div>

                <div class="row" id="divUnregisteredLocation">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label>Sector</label>
                        @(Html.Kendo().DropDownListFor(model => model.SectorId)
                        //.Name("Sector")
                        .DataTextField("Text")
                        .DataValueField("Id")
                        .OptionLabel(" -- Select --")
                        .Enable(true)
                        .AutoBind(true)
                        .Filter("contains")
                        .DataSource(source =>
                        {
                            source.Custom()
                            .ServerFiltering(true)
                            .ServerPaging(true)
                            .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                            .Transport(transport => transport.Read(read => read.Action("GetMasterSearchParameterAsDataSource", "Authority", new { area = "Member" }).Data("FilterSectorParameter")))
                            .Schema(schema => schema.Data("Data").Total("Total"))
                            .PageSize(100);
                        })
                        .HtmlAttributes(new { style = "width:90%; float:right;", @class = "input-disabled" })
                                //.Events(e => e.Change("ChangeInSector"))
                        )
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label>Block</label>
                        @(Html.Kendo().DropDownListFor(m => m.BlockId)
                        //.Name("Block")
                        .Filter("contains")
                        .DataTextField("Text")
                        .DataValueField("Id")
                        .OptionLabel(" -- Select --")
                        //.CascadeFrom("SectorId")
                        //.CascadeFromField("SectorId")
                        .DataSource(source =>
                        {
                            source.Custom()
                            .ServerFiltering(true)
                            .ServerPaging(true)
                            .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                //.Transport(transport => transport.Read(read => read.Action("GetMasterSearchParameterAsDataSource", "Property", new { area = "Customer" }).Data("FilterBlockParameter")))
                            .Transport(transport => transport.Read(read => read.Action("GetMasterSearchParameterAsDataSource", "Authority", new { area = "Member" }).Data("FilterBlockParameter")))
                            .Schema(schema => schema.Data("Data").Total("Total"))
                            .PageSize(100);
                        })
                                .Events(events => { events.Change("ChangeInBlock"); })
                        .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                        )
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label>Flat/Plot No</label>
                        @(Html.Kendo().DropDownListFor(m => m.PlotNo)
                        //.Name("Plot")
                        .Filter("contains")
                        .DataTextField("Text")
                        .DataValueField("Value")
                        .OptionLabel(" -- Select --")
                        //.CascadeFrom("SectorId")
                        //.CascadeFromField("SectorId")
                        .DataSource(source =>
                        {
                            source.Custom()
                            .ServerFiltering(true)
                            .ServerPaging(true)
                            .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                            .Transport(transport => transport.Read(read => read.Action("GetMasterSearchParameterAsDataSource", "Authority", new { area = "Member" }).Data("FilterPlotParameter")))
                            .Schema(schema => schema.Data("Data").Total("Total"))
                            .PageSize(100);
                        })
                                .Events(events => { events.Change("ChangeInPlotNo"); })
                        .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                        )
                    </div>
                </div>

                <div class="row" id="divRegisteredLocation">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label>Sector</label>
                        <input type="text" id="Sector" class="form-control" style="width:90%;float:right;" readonly="readonly" />
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label>Block</label>
                        <input type="text" id="Block" class="form-control" style="width:90%;float:right;" readonly="readonly" />
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label>Flat/Plot No</label>
                        <input type="text" id="Plot" class="form-control" style="width:90%;float:right;" readonly="readonly" />
                    </div>
                </div>
                    
                <div class="row">
                    <div class="col-md-6 col-sm-6 col-xs-12 form-group">
                        @Html.Label("Allottee Name")
                        @Html.TextAreaFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", style = "width:94%;float:right;height:32px;" })
                    </div>
                    <div class="col-md-6 col-sm-6 col-xs-12 form-group">
                        @Html.Label("Correspond Address")
                        @Html.TextAreaFor(model => model.CorrespondAddress, htmlAttributes: new { @class = "form-control", style = "width:94%;float:right;height:32px;" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label>Mobile No</label>
                        @Html.TextBoxFor(model => model.MobileNo, htmlAttributes: new { @class="form-control", @maxlength="10", style="width:90%; float:right;"})
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label>Email</label>
                        @Html.TextBoxFor(model => model.Email, htmlAttributes: new { @class = "form-control", @maxlength = "50", style = "width:90%; float:right;" })
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label>
                            @*<input type="radio" group="ref-type-group" class="" name="reference-type" value="RefNo" />RefNo &nbsp;*@
                            <input type="radio" group="ref-type-group" class="" name="reference-type" value="PAN" />PAN &nbsp;&nbsp;
                            <input type="radio" group="ref-type-group" class="" name="reference-type" value="GST" />GST
                        </label>
                        @Html.TextBoxFor(model => model.ReferenceNo, htmlAttributes: new { @class = "form-control", @maxlength = "25", style = "width:90%; float:right;" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Bank Name", htmlAttributes: new { @class = "required" })
                        @(Html.Kendo().DropDownListFor(model => model.BankId)
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel("---select---")
                            .Filter("contains")
                                //.DataSource(source =>source.Read(read =>read.Action("GetAllBanks", "PropertyRegistration")))
                            .DataSource(source =>
                            {
                                source.Custom().ServerFiltering(true).ServerPaging(true).Type("aspnetmvc-ajax")
                                //.Transport(transport => transport.Read("GetBankListAsDataSource", "Authority", new { area = "Member" }))
                                .Transport(transport => transport.Read(read => read.Action("GetBankListForPaymentAsDataSource", "Authority", new { area = "Member" }).Data("FilterBankByPaymentType")))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(100);
                            })
                                //.Events(model => model.Change("CleanAccountNumber"))
                            .HtmlAttributes(new { style = "width: 90%; float:right;" })
                        )
                    </div>

                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Branch Address", htmlAttributes: new { @class = "required" })
                        @(Html.Kendo().DropDownListFor(model => model.BranchId)
                            //.Name("Branch")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .Filter("contains")
                            .OptionLabel("---select---")
                                //.DataSource(source =>source.Read(read =>read.Action("GetAllBranchs", "PropertyRegistration").Data("filterBranches")).ServerFiltering(true))
                            .DataSource(source =>
                            {
                                source.Custom().ServerFiltering(true)//.ServerPaging(true).Type("aspnetmvc-ajax")
                                .Transport(transport => transport.Read(read => read.Action("GetBranchListOfBankAsDataSource", "Authority", new { area = "Member" }).Data("FilterBankId")))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(100);
                            })
                            .CascadeFrom("BankId")
                            .Events(model => model.Change("ChangeInBankBranchEvent"))
                            .HtmlAttributes(new { style = "width: 90%; float:right;" })
                        )
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Account No", htmlAttributes: new { @id = "lblAccountddl", @class = "required" })
                        @Html.TextBoxFor(m => m.AccountNo, new { @class = "form-control", @maxlength="20", style = "width:90%; float:right;"})
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Account Head", htmlAttributes: new { @class = "required" })
                        @(Html.Kendo().DropDownListFor(model => model.AccountHeadId)
                            //.Name("AccountHead")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel("---select---")
                            .Filter("contains")
                            .DataSource(source =>
                            {
                                source.Custom().ServerFiltering(true).ServerPaging(true).Type("aspnetmvc-ajax")
                                .Transport(transport => transport.Read("GetAccountHeadList", "Authority", new { area = "Member" }))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(100);
                            })
                            .HtmlAttributes(new { style = "width: 90%; float:right;" })
                        )
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Account Subhead", htmlAttributes: new { @class = "required" })
                        @(Html.Kendo().DropDownListFor(model => model.AccountSubHeadId)
                            //.Name("AccountSubHead")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel("---select---")
                            .DataSource(source =>
                            {
                                source.Custom().ServerFiltering(true)//.ServerPaging(true).Type("aspnetmvc-ajax")
                                .Transport(transport => transport.Read(read => read.Action("GetAccountSubHeadList", "Authority", new { area = "Member" }).Data("FilterAccountHeadId")))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(100);
                            })
                            .CascadeFrom("AccountHeadId")
                                //.Events(model => model.Change("HideShowBranch").DataBound("onDataBound"))
                            .HtmlAttributes(new { style = "width: 90%; float:right;" })
                        )
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Amount", htmlAttributes: new { @id = "lblAccountddl", @class = "" })
                        @(Html.Kendo().NumericTextBoxFor(m => m.Amount)
                            .Min(0)
                            .Max(999999999999999999)
                            .Spinners(false).Step(0)
                            .Enable(true)
                            .HtmlAttributes(new { style = "width: 90%; float:right;", @maxlength = "18", @class = "k-textbox  text-right" })
                        )
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12 form-group" style="text-align:right">
                        <input type="button" id="btnAdd" value="Add Amount" class="k-button" style="width:100px;" />
                    </div>
                </div>
            </div>


            <div class="col-md-12 k-grid-content" id="divChallanGrid">
                @(Html.Kendo().Grid<NA.PMS.Model.ChallanViewModel>()
                    .Name("gridChargeDetails")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.Id).Hidden(true);
                        columns.Bound(c => c.RegistrationId).Hidden(true);
                        columns.Bound(c => c.AccountHead).Title("Account Head").ClientFooterTemplate("<div>Total Amount :-</div>");
                        columns.Bound(c => c.AccountSubHead).Title("Account Sub Head");
                        columns.Bound(c => c.Amount).Title("Amount").ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
                        //columns.Bound(c => c.BankName).Title("Bank");
                        //columns.Bound(c => c.CreatedDate).Title("Date").Format("{0:dd-MMM-yyyy}");
                        columns.Bound(c => c.Id).Title("Action").ClientTemplate("<a onclick='javascript:RemoveChallanDetails(this);'class='hyperlinkcss'>Remove</a>").Filterable(false).Sortable(false);
                        //columns.Bound(c => c.ChallanTransID).Title("Action").ClientTemplate("<a onclick='javascript:RemoveDetails(\"#=ChallanTransID#\");'class='hyperlinkcss'>Remove</a>").Filterable(false).Sortable(false);
                    })
                        .Sortable().Filterable().Resizable(resize => resize.Columns(true))
                        //.Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                        .Events(e => e.DataBound("ChallanGridEvent"))
                        .DataSource(dataSource => dataSource
                        .Ajax().Model(model => model.Id(c => c.Id))
                        .ServerOperation(true)
                        .Read(read => read.Action("GetTempChallanChargesAsDataSource", "Authority", new { area="Member"}).Data("FilterRegistrationIdParam"))
                        .Aggregates(aggregates => aggregates.Add(p => p.Amount).Sum())
                        //.PageSize(5)
                        )
                )
            </div>

            @*<div class="col-md-12">
                <div class="box-button text-center" style="text-align:right;">
                    <input type="button" value="Generate Challan" id="btnGenerateChallan" class="btn btn-default" style="float:right;"/>
                </div>
            </div>*@
            <div class="col-md-12">
                <div class="row challan-btn-box">
                    <div class="col-md-6" id="payment-type">
                        <input type="radio" name="challan" value="Offline" checked> Offline &nbsp;&nbsp;&nbsp;
                        <input type="radio" name="challan" value="Online"> Online
                    </div>
                    <div class="col-md-6">
                        <input type="button" value="Print Challan" id="btn-generate-challan" class="k-button" style="min-width:110px;border-radius:0;float:right;" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div id="divPrintChallan" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 60%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Challan</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:400px;">
                <style>
                    .td-amount {
                        padding-right: 30px;
                    }
                    #divChallanBody {                        
                        padding: 5px;
                    }

                    #authorityChallan {
                        border: 1px solid black;
                        padding: 5px;
                    }
                </style>
                <div id="divChallanBody"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv();">Print</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#btnBack").click(function () {
            window.location.href = '@Url.Action("ManageChallan", "Authority", new { area="Member"})';
        });

        ShowRId();

        //$("#divDropDownRid").show();
        //$("#divTextBoxRid").css("display", "none");
        //$("#divRegisteredLocation").show();
        //$("#divUnregisteredLocation").css("display", "none");

        $('input[name=RegistrationType]').change(function () {
            ChangeRegistrationType();
        });

        $("#btnAdd").click(function () {
            AddChallanDetail()
        });

        $("#btnGenerateChallan").click(function () {
            //GenerateParsedChallan();
            ValidateChallanDetails();
        });

        $("#btn-generate-challan").click(function () {
            var paytype = $('input[name="challan"]:checked', '#payment-type').val();
            if ((paytype != "") && (paytype != undefined)) {
                ValidateChallanDetails();
            }
            else {
                alertify.error("Select Payment type.");
            }
            //GenerateParsedChallan();
            
        });

        $('#divPrintChallan').on('hidden.bs.modal', function () {
            ClearFieldValue();
            $("#AccountHeadId").data("kendoDropDownList").value("");
            $("#AccountSubHeadId").data("kendoDropDownList").value("");
            $("#Amount").data("kendoNumericTextBox").value("");
            $("#BankId").data("kendoDropDownList").value("");
            $("#gridChargeDetails").data('kendoGrid').dataSource.data([]);
        });

        ChallanGridEvent();

        //if (userInfo.OptionalId==44) {
        //    $('#BankId').data("kendoDropDownList").value(44);
        //}

        var userInfo = '@HttpContext.Current.Session["CurrentUser"]';
        if (userInfo == '') {
            $('#bank-challan').css({"margin-top": "30px"});
        }

        $('#payment-type input:radio[name="challan"]').on('change', function () {
            //TogglePaymentType();
            var paytype = $('input[name="challan"]:checked', '#payment-type').val();
            if (paytype.trim() == "Online") {
                $('#btn-generate-challan').val('Pay Online');               
            }
            else {
                $('#btn-generate-challan').val('Print Challan');
            }
            $('#AccountNo').val("");
            $('#BankId').data("kendoDropDownList").dataSource.read();
        });

    });

    function ShowRId() {
        var radiobtnVal = $('input[name=RegistrationType]:checked', '#div-allottee-type').val();
        if (radiobtnVal == '@Constants.UnRegistered') {
            $("#divTextBoxRid").show();
            $("#divDropDownRid").css("display", "none");
            $("#divRegisteredLocation").css("display", "none");
            $("#divUnregisteredLocation").show();
        }
        if (radiobtnVal == '@Constants.Registered') {
            $("#divTextBoxRid").css("display", "none");
            $("#divDropDownRid").show();
            $("#divRegisteredLocation").show();
            $("#divUnregisteredLocation").css("display", "none");
        }
    }

    function FilterBankByPaymentType() {
        return { FilterType: $('input[name="challan"]:checked', '#payment-type').val() };
    }

    function ChangeInBankBranchEvent() {
        if ($('#BranchId').val() != '') {
            var bank = {
                BankId: $('#BankId').val(),
                BranchId: $('#BranchId').val(),
                FilterType: "AccountNo"
            };
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ model: bank }),
                url: '/Member/Authority/GetBankAccountDetailById',
                success: function (result) {
                    if (result != null && result != '') {
                        $("#AccountNo").val(result.AccountNo);
                        $("#IFSCCode").val(result.IFSCCode);
                        return false;
                    }
                    else {
                        alertify.error("Account No is not available.");
                        return true;
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    alertify.error("Network error, Please try again later.");
                }
            });
        }
    }

    function ChallanGridEvent() {
        //var grid = event.sender;
        //alert("event");
        if ($('#gridChargeDetails').data("kendoGrid").dataSource.total() == 0) {
            $('#divChallanGrid').css("display", "none");
        }
        else {
            var rid = $('#gridChargeDetails').data("kendoGrid").dataSource._data[0].RegistrationId;
            if (rid == $('#RegistrationId').val() || rid == $('#RegdId').val()) {
                $('#divChallanGrid').show();
            }
            else {
                $('#divChallanGrid').css("display", "none");
            }
        }
    }

