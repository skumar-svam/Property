@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@model NA.PMS.Model.AllottedPropertyPaymentModel
@{
    ViewBag.Title = "ManagePayment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    #gridPayment {
        padding: 0;
    }

    .k-widget.k-window {
        padding: 0;
    }

    .k-window-content.k-content {
        padding: 0;
    }

    .k-window-titlebar.k-header {
        background: #299a8b;
        color: #ffffff;
        border-radius: 0;
    }

    .col-for-label {
        margin-right: -40px;
        margin-left: 25px;
    }

    .displace-right {
        /*margin-left: 80px;*/
    }
</style>
<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="row rw-spce">
        <div class="col-sm-8"><h1 class="gridTitle">Payment for Allotted Property</h1></div>
        <div class="col-sm-4 col-btn">
            <a href="#" id="btnShowPayment" class="" onclick="javascript:ShowPaymentModal(event);">Show Payment</a>
        </div>
    </div>

    <div class="col-md-12 blnk-rw"></div>

    @using (Html.BeginForm("AddAllottedPropertyPayment", "PropertyRegistration", FormMethod.Post, new { enctype = "multipart/form-data", id = "PaymentForm" }))
    {
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading">Add Payment</h2>
            <div class="form-bx">
                <div class="row">
                    @Html.HiddenFor(model => model.ALLOTEE_NAME)
                    @Html.HiddenFor(model => model.FIRST_NAME)
                    @Html.HiddenFor(model => model.MIDDLE_NAME)
                    @Html.HiddenFor(model => model.LAST_NAME)
                    @Html.HiddenFor(model => model.SECTOR_ID)
                    @Html.HiddenFor(model => model.SECTOR)
                    @Html.HiddenFor(model => model.BLOCK_ID)
                    @Html.HiddenFor(model => model.BLOCK)
                    @Html.HiddenFor(model => model.DEPARTMENT_ID)
                    @Html.HiddenFor(model => model.DEPARTMENT_NAME)
                    @Html.HiddenFor(model => model.PROPERTY_ID)
                    @Html.HiddenFor(model => model.PROPERTY_NUMBER)
                    @Html.HiddenFor(model => model.PROPERTY_REGESTRY_ID)
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                        <label>Registration Id:</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(model => model.RID)
                              .DataTextField("Name")
                              .DataValueField("Value")
                              .OptionLabel(" -- Please Select --")
                              .Filter("contains")
                              .AutoBind(true)
                              .Enable(true)
                              .DataSource(source =>
                                {
                                    source.Custom()
                                    .ServerFiltering(true)
                                    .ServerPaging(true)
                                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                    .Transport(transport =>
                                    {
                                        transport.Read(read => read.Action("GetAllottedPropertyRidListReq", "PropertyRegistration"));
                                    }).Schema(schema =>
                                    {
                                        schema.Data("Data")
                                        .Total("Total");
                                    }).PageSize(100);
                                })
                              .HtmlAttributes(new { style = "width:100%" })
                              .Events(e => e.Change("GetAllottedPropertyDetails"))
                        )
                        @Html.ValidationMessageFor(model => model.RID)
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                        <label>Applicant's Name</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <label class="lbl-form-control" id="lblAllotteeName"></label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label  form-group">
                        <label>Property No</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <label class="lbl-form-control" id="lblPropertyNumber"></label>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group"><label>Receipt Type</label></div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(model => model.RECIEPT_CODE)
                              .DataTextField("Name")
                              .DataValueField("Value")
                              .OptionLabel(" -- Please Select --")
                              .Filter("contains")
                              .AutoBind(true)
                              .Enable(true)
                              .DataSource(source => source.Read(read => read.Action("GetPropertyPaymentType", "PropertyRegistration")))
                              .HtmlAttributes(new { style = "width:100%" })
                        )
                        @Html.ValidationMessageFor(model => model.RECIEPT_CODE)
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label  form-group">
                        <label>Receipt Sub Type</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(model => model.RECEIPT_SUBHEAD_ID)
                              .DataTextField("Name")
                              .DataValueField("Value")
                              .OptionLabel(" -- Please Select --")
                              .Filter("contains")
                              .AutoBind(true)
                              .Enable(true)
                              .DataSource(source => source.Read(read => read.Action("GetPropertySubPaymentType", "PropertyRegistration").Data("FilterHeadId")).ServerFiltering(true))
                              .CascadeFrom("RECIEPT_CODE")
                              .HtmlAttributes(new { style = "width:100%" })
                        )
                        @Html.ValidationMessageFor(model => model.RECEIPT_SUBHEAD_ID)
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                        <label>Receipt No</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.TextBoxFor(model => model.RECEIPT_ID, new { @class = "form-control integer-only", @maxlength = "12" })
                        @Html.ValidationMessageFor(model => model.RECEIPT_ID)
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label  form-group">
                        <label>Amount</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.TextBoxFor(model => model.AMOUNT, new { @class = "form-control integer-only", @maxlength = "22" })
                        @Html.ValidationMessageFor(model => model.AMOUNT)
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                        <label>Bank ID</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @*@Html.TextBoxFor(model => model.BANK_ID, new { @class = "form-control", @maxlength = "20" })*@
                        @(Html.Kendo().DropDownListFor(model => model.BANK_ID)
                              .DataTextField("Name")
                              .DataValueField("Value")
                              .OptionLabel(" -- Please Select --")
                              .Filter("contains")
                              .AutoBind(true)
                              .Enable(true)
                              .DataSource(source => source.Read(read => read.Action("GetBankNamesForPayment", "PropertyRegistration")))
                              .HtmlAttributes(new { style = "width:100%" })
                        )
                        @Html.ValidationMessageFor(model => model.BANK_ID)
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label  form-group">
                        <label>Challan ID</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.TextBoxFor(model => model.CHALLAN_ID, new { @class = "form-control integer-only", @maxlength = "20" })
                        @Html.ValidationMessageFor(model => model.CHALLAN_ID)
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                        <label>Deposit Date</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DatePickerFor(model => model.DEPOSIT_DATE)
                              .HtmlAttributes(new { style = "width: 100%;", @class = "DisableKeyboardInput" }))
                        @Html.ValidationMessageFor(model => model.DEPOSIT_DATE)
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label  form-group">
                        <label>Entry Date</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DatePickerFor(model => model.ENTRY_DATE)
                  .HtmlAttributes(new { style = "width: 100%;", @class = "DisableKeyboardInput" }).Events(e => e.Change("ValidateEntryDate")))
                        @Html.ValidationMessageFor(model => model.ENTRY_DATE)
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                        <label>Depositor's Name</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.TextBoxFor(model => model.DEPOSITOR_NAME, new { @class = "form-control", @maxlength = "100" })
                        @Html.ValidationMessageFor(model => model.DEPOSITOR_NAME)
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label  form-group">
                        <label>Address</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.TextBoxFor(model => model.ADDRESS, new { @class = "form-control", @maxlength = "200" })
                        @Html.ValidationMessageFor(model => model.ADDRESS)
                    </div>
                </div>
            </div>
        </div>
        <div class="box-button text-center">
            <input type="reset" id="btnReset" value="Reset" class="btn btn-default" style="margin-left:25px;" />
            <input type="submit" id="btnSubmit" value="Add" class="btn btn-add" style="margin-right:25px;" />
        </div>
    }

</div>

<div id="divPropertyPayment">
    <div class="row">
        <div class="col-md-12 k-grid-content">
            @(Html.Kendo().Grid<NA.PMS.Model.AllottedPropertyPaymentModel>()
            .Name("gridPayment")
            .Columns(columns =>
            {
                columns.Bound(c => c.RECEIPT_ID).Title("Receipt ID");
                columns.Bound(c => c.RID_NO).Title("Registration Id");
                columns.Bound(c => c.DEPARTMENT_NAME).Title("Department");
                columns.Bound(c => c.ALLOTEE_NAME).Title("Applicant");
                columns.Bound(c => c.PROPERTY_NUMBER).Title("Property No.");
                columns.Bound(c => c.AMOUNT).Title("Amount");
                columns.Bound(c => c.DEPOSIT_DATE).Title("Deposit Date").Format("{0:dd-MM-yyyy}");
                columns.Bound(c => c.ENTRY_DATE).Title("Entry Date").Format("{0:dd-MM-yyyy}");
            })
            .Sortable()
            .Filterable()
            .Groupable()
                    //.Events(e => e.DataBound("onDataBound"))
            .Resizable(resize => resize.Columns(true))
            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
            .DataSource
            (
                dataSource => dataSource
                    .Ajax().Model(model => model.Id(p => p.RECEIPT_ID)).ServerOperation(true)//.Sort(sort => sort.Add("RECEIPT_ID").Descending())
                    .Read(read => read.Action("GetPropertyPaymentDetails", "PropertyRegistration")).PageSize(12)//.Group(g => g.Add(r => r.RID_NO))
            )
            )
        </div>
    </div>


    <div class="row" style="padding-top:15px;padding-bottom:15px;text-align:center">
        <div class="col-sm-12">
            <button id="btnPopupCancel" class="btn btn-add">close</button>
        </div>
    </div>

</div>



<script>
    $(document).ready(function () {
        @{if (TempData["MesgAdd"] != null && TempData["MesgAdd"] != "")
        {
            if ((bool)TempData["MesgAdd"] == true)
            {
                @:alertify.success('Payment added successfully.');
                    }
            else
            {
                @:alertify.error('Payment is not added, try again.');
                    }
        }
        }
    });

    $('#divPropertyPayment').kendoWindow({
        modal: true,
        title: "Payment against Registration Id",
        visible: false,
        width: "90%", height: "90%"
    });

    $('#btnShowPayment').click(function () {
        $('#gridPayment').data("kendoGrid").dataSource.read();
        var win = $("#divPropertyPayment").data("kendoWindow");
        win.center();
        win.open();
    });

    $('#btnPopupCancel').click(function () {
        $("#divPropertyPayment").data("kendoWindow").close();
    });

    function FilterHeadId() {
        return { receiptId: $('#RECIEPT_CODE').val() }
    }

    function GetAllottedPropertyDetails() {
        var rId = $('#RID').val();
        //alert($('#RID').val());
        if (rId != "") {
            //alert($('#RID').val());
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                //data: { rid: rId },
                data: JSON.stringify({ rid: rId }),
                url: '@Url.Action("GetAllottedPropertyDetail", "PropertyRegistration")',
                success: function (result) {
                    if (result != null) {
                        ClearInputField();
                        $('#lblAllotteeName').text(result.ALLOTEE_NAME);
                        $('#lblPropertyNumber').text(result.SECTOR + "/" + result.BLOCK + "-" + result.PROPERTY_NUMBER);
                        $('#FIRST_NAME').val(result.FIRST_NAME);
                        $('#MIDDLE_NAME').val(result.MIDDLE_NAME);
                        $('#LAST_NAME').val(result.LAST_NAME);
                        $('#SECTOR_ID').val(result.SECTOR_ID);
                        $('#SECTOR').val(result.SECTOR);
                        $('#BLOCK_ID').val(result.BLOCK_ID);
                        $('#BLOCK').val(result.BLOCK);
                        $('#DEPARTMENT_ID').val(result.DEPARTMENT_ID);
                        $('#DEPARTMENT_NAME').val(result.DEPARTMENT_NAME);
                        $('#PROPERTY_ID').val(result.PROPERTY_ID);
                        //$('#PROPERTY_NUMBER').val(result.PROPERTY_NUMBER);
                        $('#PROPERTY_NUMBER').val(result.SECTOR + "/" + result.BLOCK + "-" + result.PROPERTY_NUMBER);
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Please try again.");
                }
            });
        }
        else {
            ClearInputField();
            //alertify.error("Please select Registration Id");
        }
    }

    $('#btnSubmit').click(function () {
        if ($('#RID').val() == "") {
            alertify.error("Please select Registration Id");
            return false;
        }
        else {
            $('#btnSubmit').submit();
        }
    });

    //$("#RECEIPT_ID").keydown(function (e) {
    //    // Allow: backspace, delete, tab, escape, enter and .
    //    if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110]) !== -1 ||
    //        // Allow: Ctrl+A, Command+A
    //        (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
    //        // Allow: home, end, left, right, down, up
    //        (e.keyCode >= 35 && e.keyCode <= 40)) {
    //        // let it happen, don't do anything
    //        return;
    //    }
    //    // Ensure that it is a number and stop the keypress
    //    if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
    //        e.preventDefault();
    //    }
    //});

    $(".integer-only").keydown(function (e) {
        // Allow: backspace, delete, tab, escape, enter and .
        if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110]) !== -1 ||
            // Allow: Ctrl+A, Command+A
            (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
            // Allow: home, end, left, right, down, up
            (e.keyCode >= 35 && e.keyCode <= 40)) {
            // let it happen, don't do anything
            return;
        }
        // Ensure that it is a number and stop the keypress
        if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
            e.preventDefault();
        }
    });

    function ValidateEntryDate() {
        var depositdate = $('#DEPOSIT_DATE').val();
        var entrydate = $('#ENTRY_DATE').val();
        var today = '@DateTime.Now.ToString()';
        if (new Date(depositdate) > new Date(entrydate)) {
            alertify.error("Entry date should not be earlier than deposit date");
            return false;
        }
        if (new Date(entrydate) > new Date(today)) {
            alertify.error("Entry date should not be future date.");
            return false;
        }
    }

    function ClearInputField() {
        //$('#RID').data("kendoDropDownList").Value('');
        $('#lblAllotteeName').html("");
        $('#lblPropertyNumber').text('');
        $('#RECIEPT_CODE').data("kendoDropDownList").value('');
        $('#RECEIPT_ID').val('');
        $('#AMOUNT').val('');
        $('#BANK_ID').data("kendoDropDownList").value('');
        $('#CHALLAN_ID').val('');
        $('#DEPOSIT_DATE').data("kendoDatePicker").value('');
        $('#ENTRY_DATE').data("kendoDatePicker").value('');
        $('#DEPOSITOR_NAME').val('');
        $('#ADDRESS').val('');
    }
</script>