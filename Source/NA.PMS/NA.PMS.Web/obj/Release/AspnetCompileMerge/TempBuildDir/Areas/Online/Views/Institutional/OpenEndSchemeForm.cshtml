    var gblFormid = 0;
    function SubmitOpenSchemeForm() {
        var windowWidget = $("#div-otp-window").data("kendoWindow");
        kendo.ui.progress(windowWidget.element, true);

        var atype = $('#DDLApplicantType').val();
        $('#FormType').val("Online");
        $('#ApplicantType').val(atype);
        $('#ApplicationFormType').val("General");

        var formData = new FormData($('form').get(0));
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            data: formData,
            url: '/Online/Institutional/SaveOpenEndSchemeApplicationForm',
            success: function (result) {
                if (result != null) {
                    if (result.ReturnTypeId == '@OSReturnTypeId.Saved') {
                        alertify.success("Scheme Application Form saved successfully.");
                        window.location.href = '/Online/Institutional/OpenEndSchemeForm?ApplicationFormId=' + result.ApplicationFormId;
                    }
                    else {
                        alertify.error("Provider failed to save Application Form, try again");
                    }
                    kendo.ui.progress(windowWidget.element, false);
                }
            },
            error: function (ajaxRequest, strError) {
                kendo.ui.progress(windowWidget.element, false);
                alertify.error("Network error, try again later");
            }
        });
    }

