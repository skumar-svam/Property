    function GetServiceRequestStatusForLetter() {
        var rid = $('#RegistrationId').val();
        var letterId = $('#LetterId').val();
        if (rid != "" && letterId != "") {
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json;charset=utf-8",
                data: JSON.stringify({ rid: rid, letterId: letterId }),
                url: '@Url.Action("GetServiceRequestValidationForLetter", "Authority", new { area = "Member" })',
                success: function (result) {
                    if (result == 0) {
                        alertify.error("Service is not validated.");
                        return false;
                    }
                    else {
                        alertify.success("validated");
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Something is wrong, try again later.");
                }
            });
        }
    }

    function GetAllotteeDetails() {
        var rid = $('#RegistrationId').val();
        if (rid != "") {
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json;charset=utf-8",
                data: JSON.stringify({ rid: rid }),
                url: '@Url.Action("GetAllottedPropertyDetailByRegistrationId", "Authority", new { area="Member"})',
                success: function (result) {
                    if (result != null) {
                        $('#Applicant').val(result.Applicant);
                        $('#PropertyNo').val(result.PropertyNo);
                        $('#CorrespondAddress').val(result.CorresspondentAddress);
                        $('#DepartmentId').val(result.DepartmentId);
                        $('#Department').val(result.Department);
                        $('#MobileNo').val(result.MobileNo);
                        $('#CorrespondAddress').val(result.CorrespondAddress);

                        $("#gridGeneratedLetter").data("kendoGrid").dataSource.read();
                        $("#LetterId").data("kendoDropDownList").dataSource.read();
                    }
                    else {
                        alertify.error("There is some error, try again");
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Something is wrong, try again later.");
                }
            });
        }
    }


    function GenerateLetterByTemplate() {
        var rid = $('#RegistrationId').val();
        
        $('#LetterHeading').text($('#LetterId').data("kendoDropDownList").text());
        if (rid == "" || rid.length != 8) {
            alertify.error("Please select Registration no");
            return false;
        }
        else if ($('#DepartmentId').val() == "") {
            alertify.error("Please select Department");
            return false;
        }
        else if ($('#LetterDate').val() == "") {
            alertify.error("Please enter letter date");
            return false;
        }
        else if ($('#LetterId').val() == "") {
            alertify.error("Please select letter type.");
            return false;
        }
        else {
            var letterModel = {
                RegistrationId: $('#RegistrationId').val(),
                DepartmentId: $('#DepartmentId').val(),
                TemplateId: $('#LetterId').val(),
                LetterDate: $('#LetterDate').val()
            };
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ model:letterModel }),
                url: '/Member/Authority/GenerateAuthorizedLetterById',
                success: function (result) {
                    if (result.LetterContent == 0) {
                        $("#divLetterBody").html("Service is not approved");
                        $("#divLetterBodyModal").modal('show');
                    }
                    else {
                        $("#divLetterBody").html(result.LetterContent);
                        //$("#inputdata").before("<div id='divBarcode' class='font-barcode' style='text-align:center;'></div>");
                        generateBarcode();
                        $('#divBarcode').html($('#inputdata').html());
                        $('#inputdata').css("display", "none");
                        $("#divLetterBodyModal").modal('show');
                    }
                    //alertify.success(result);
                },
                error: function (obj) {
                    alertify.error("Network error. Please try again later.");
                }
            });
        }
    }


    function PrintDiv() {
        //generateBarcode();
        //var contents = document.getElementById("divmodalbody").innerHTML;
        var contents = document.getElementById("divLetterBody").innerHTML;
        //var contents = document.getElementById("divBarcode").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('<style>#barcodeTarget{ width:30%; margin-left:35%; } #divBarcode{ width:100%; text-align:center; }</style>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }

    $('#downloadLetter').click(function () {
        var rid = $("#Rid").val();
        var departmentId = $("#DepartmentId").val();
        var serviceId = null; //$('#ServiceId').val();
        var letterId = $('#LetterId').val();
        var letterDate = $('#LetterDate').val();
        if (letterDate == "") {
            alertify.error("Please enter letter date.");
            return false;
        }
        else if (letterId == "") {
            alertify.error("Please select letter type.");
            return false;
        }
        else {
            window.location = "/Report/DownloadLetter?rid=" + rid + "&departmentId=" + departmentId + "&serviceId=" + serviceId + "&letterId=" + letterId + "&letterDate=" + letterDate;
        }
    });

</script>
<script type="text/javascript">

    function get_object(id) {
        var object = null;
        if (document.layers) {
            object = document.layers[id];
        } else if (document.all) {
            object = document.all[id];
        } else if (document.getElementById) {
            object = document.getElementById(id);
        }
        return object;
    }
    get_object("inputdata").innerHTML = DrawCode39Barcode(get_object("inputdata").innerHTML, 1);

</script>

