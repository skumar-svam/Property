        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce">
            <div class="inr-bx" style="border: solid #e2e3e4; border-width: 0 1px 1px">
                @*@Html.ValidationSummary(true, "", new { @class = "text-danger" })*@
                <h2 class="blck-heading">Filter Property</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.LabelFor(m => m.DepartmentName)
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                  .Filter("contains")
                  .OptionLabel("-Select-")
                  .DataTextField("Text")
                  .DataValueField("Value")
                  .BindTo(Model.DepartmentCollection)
                                    //.Events(events => { events.Change("DepartmentSelection"); })
                  .HtmlAttributes(new { style = "width: 100%", TabIndex = 1 })
                  .Enable(false)
                            )
                        </div>

                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.LabelFor(m => m.SectorName)
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(m => m.SectorId)
                  .Filter("contains")
                                    //.CascadeFrom("DepartmentId")
                  .DataTextField("Text")
                  .DataValueField("Value")
                  .OptionLabel("-Select-")
                                    //.Events(events => { events.Change("SectorSelection"); })
                  .DataSource(source =>
                  {
                      source.Read(read =>
                      {
                          read.Action("GetSectorsByDeptId", "MergeSplitProperties")
                              .Data("FilterSectorValuesByDeptId");
                      })
                          .ServerFiltering(true);
                  })
                  .HtmlAttributes(new { style = "width: 100%", TabIndex = 4 })
                  .Enable(false)
                  .AutoBind(true)
                            )
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.LabelFor(m => m.BlockName)
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(m => m.BlockId)
                  .Filter("contains")
                  .DataTextField("Text")
                  .DataValueField("Value")
                  .OptionLabel("-Select-")
                                    //.Events(events => { events.Change("BlockSelection"); })
                  .DataSource(source =>
                  {
                      source.Read(read =>
                      {
                          read.Action("GetBlocksByDeptAndSectorId", "MergeSplitProperties")
                              .Data("FilterBlockBySector");
                      })
                          .ServerFiltering(true);
                  })
                  .HtmlAttributes(new { style = "width: 100%", TabIndex = 5 })
                                    //.CascadeFrom("SectorId")
                  .Enable(false)
                  .AutoBind(true)
                            )
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Registration Id")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(m => m.Rid)
                  .Filter("contains")
                  .CascadeFrom("BlockId")
                  .DataTextField("Text")
                  .DataValueField("Value")
                  .OptionLabel("-Select-")
                  .Events(events => { events.Change("RidSelection"); })
                  .DataSource(source =>
                  {
                      source.Read(read =>
                      {
                          read.Action("GetAllRIDsForSplitMerge", "MergeSplitProperties")
                              .Data("FilterRIDs");
                      })
                          .ServerFiltering(true);
                  })
                  .HtmlAttributes(new { style = "width: 100%", TabIndex = 5 })
                  .Enable(true)
                  .AutoBind(false)
                            )
                        </div>
                    </div>

