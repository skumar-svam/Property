<script>
    var gridData = [];
    var PropertyData = [];
    var countIter = 0;

    function getGridData(data) {
        //debugger;

        if (countIter == 0) {
            countIter++;
            $.each(data.items, function (index, item) {

                gridData.push({
                    Rid: item.Rid,
                    Department: item.DepartmentName,
                    PropertyNumber: item.PropertyNumber,
                    CoveredArea: item.CoveredArea,
                    ActualArea: item.ActualArea,
                    TotalArea: item.TotalArea,
                    TotalPropertyCost: item.TotalPropertyCost
                });
            });
        }
    }

    $(".closePopup").click(function () {
        $("#popUpViewComments").data("kendoWindow").close();
    });

    $(document).ready(function () {
        //gridData = [];
        //alert($("#Status").val());
        if ($("#Status").val() > 0) {
            $("#btnViewComments").show();
        } else {
            $("#btnViewComments").hide();
        }

        $("#btnAddProperty").hide();
        //$("#btnSubmit").attr('disabled', 'disabled');
        // $("#btnSubmit").removeAttr('disabled');

        $(".closePopup").click(function () {
            $("#assignToWindow").data("kendoWindow").close();
        });

        var dataSource = $("#gridMergeProperties").data("kendoGrid").dataSource;

        var grid = $("#gridProperties").kendoGrid({
            dataSource: dataSource,
            columns: [
                { field: "Rid", title: "Registration Id", width: "200px" },
                { field: "DepartmentName", title: "Department", width: "200px" },
                { field: "PropertyNumber", title: "Property Number", width: "120px" },
                { field: "CoveredArea", hidden: true, width: "120px" },
                { field: "ActualArea", hidden: true, width: "120px" },
                { field: "TotalArea", hidden: true, width: "120px" },
                { field: "TotalPropertyCost", hidden: true, width: "120px" },
                { command: ["destroy"], title: "Action", width: "200px" }
            ],
            editable: {
                mode: "inline",
                confirmation: false
            }
        });

        $("#btnPopupSubmit").click(function () {
            var charge = $("#Charges").val();
            var rids = $("#hdnAllRids").val().slice(0, $("#hdnAllRids").val().length - 1);
            $.ajax({
                dataType: 'json',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                url: '/MergeSplitProperties/ReSubmitRequestForApproval',
                data: JSON.stringify({ allRids: rids, userId: $("#User").val(), charge: charge }),
                success: function (result) {
                    if (result == true) {
                        $("#assignToWindow").data("kendoWindow").close();
                        alertify.success("Data saved successfully.");
                        window.location.href = '@Url.Action("MergeProperties", "MergeSplitProperties")';
                    } else {
                        alert("There is some error.");
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //alert(respText + "");
                }
            });
        });

        $("#gridMergeProperties").hide();
    });

    PropertyData = gridData;
    $("#btnAddProperty").click(function () {
        //alert($("#Rid").val() + "::---" + PropertyData[0].Rid);
        var found = PropertyData.some(function (el) {
            return el.Rid === parseInt($("#Rid").val());
        });
        if (!found) {
            PropertyData.push({
                Rid: parseInt($("#Rid").val()),
                Department: $("#DepartmentName").val(),
                PropertyNumber: $("#PropertyNumber").val(),
                CoveredArea: $("#CoveredArea").val(),
                ActualArea: $("#ActualArea").val(),
                TotalArea: $("#TotalArea").val(),
                TotalPropertyCost: $("#TotalPropertyCost").val()
            });
        }

        localStorage["grid_data"] = JSON.stringify(PropertyData);

        var dataSource = new kendo.data.DataSource({
            transport: {
                read: function (options) {
                    var localData = JSON.parse(localStorage["grid_data"]);
                    options.success(localData);
                },
                destroy: function (options) {
                    var localData = JSON.parse(localStorage["grid_data"]);
                    for (var i = 0; i < localData.length; i++) {
                        if (localData[i].Rid === options.data.Rid) {
                            localData.splice(i, 1);
                            break;
                        }
                    }
                    localStorage["grid_data"] = JSON.stringify(localData);
                    gridData = JSON.stringify(localData);
                    options.success(localData);
                }
            },
            pageSize: 20
        });

        var grid = $("#gridProperties").kendoGrid({
            dataSource: dataSource,
            columns: [
                { field: "Rid", title: "Rid", width: "200px" },
                { field: "Department", title: "Department", width: "200px" },
                { field: "PropertyNumber", title: "PropertyNumber", width: "120px" },
                { field: "CoveredArea", hidden: false, width: "120px" },
                { field: "ActualArea", hidden: false, width: "120px" },
                { field: "TotalArea", hidden: false, width: "120px" },
                { field: "TotalPropertyCost", hidden: false, width: "120px" },
                { command: ["destroy"], title: "Action", width: "200px" }
            ],
            editable: {
                mode: "inline",
                confirmation: false
            }
        });
        $("#btnAddProperty").attr('disabled', 'disabled');
    });

    function RidSelection(e) {
        var dataItem = this.dataItem(e.item);
        //$("#DepartmentId").val(dataItem.Value);
        var rId = dataItem.Value;
        $("#Rid").val(rId);
        $.ajax({
            url: '@(Url.Action("GetPropertyDetailsByRid", "MergeSplitProperties"))',
            type: 'POST',
            dataType: 'json',
            data: { rId: rId },
            success: function (result) {
                if (result != null) {
                    $("#ApplicantName").val(result.ApplicantName);
                    $("#DepartmentName").val(result.DepartmentName);
                    $("#PropertyType").val(result.PropertyTypeName);
                    $("#TotalArea").val(result.TotalArea);
                    $("#SchemeName").val(result.SchemeName);
                    $("#PropertyNumber").val(result.PropertyNo);
                    $("#PropertyId").val(result.PropertyId);

                    $("#SectorName").val(result.SectorName);
                    $("#BlockName").val(result.BlockName);
                    $("#CoveredArea").val(result.CoveredArea);
                    $("#ActualArea").val(result.ActualArea);
                    $("#TotalArea").val(result.TotalArea);
                    $("#TotalPropertyCost").val(result.TotalPropertyCost);

                    $("#btnAddProperty").show();
                    $("#btnAddProperty").removeAttr('disabled');

                } else {
                    alert("There is some error.");
                }
            }
        });
    }

    function FilterSectorValuesByDeptId() {
        return {
            departmentId: $("#DepartmentId").val()
        };
    }

    function FilterBlockBySector() {
        return {
