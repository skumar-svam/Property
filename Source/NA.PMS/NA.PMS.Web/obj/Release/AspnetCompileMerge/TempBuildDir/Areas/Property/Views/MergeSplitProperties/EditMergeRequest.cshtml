    $("#btnCancelRequest").click(function () {
        if (confirm("Are you sure? You want to cancel the request.")) {

            var requestNo = $("#RequestId").val();
            //var rids = $("#hdnAllRids").val().slice(0, $("#hdnAllRids").val().length - 1);
            $.ajax({
                dataType: 'json',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                url: '/MergeSplitProperties/CancelMergeRequest',
                data: JSON.stringify({ requestNo: requestNo }),
                success: function (result) {
                    if (result == true) {
                        $("#assignToWindow").data("kendoWindow").close();
                        alertify.success("Request submitted successfully.");
                        window.location.href = '@Url.Action("MergeProperties", "MergeSplitProperties")';
                    } else {
                        alert("There is some error.");
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //alert(respText + "");
                }
            });
        } else {
            return false;
        }
    });


    $("#btnCancel").click(function () {
        window.location.href = '@Url.Action("MergeProperties", "MergeSplitProperties")';
    });
    $("#btnAmalgamateProp").click(function () {
        var dataSource = $("#gridProperties").data("kendoGrid").dataSource;
        // Gets the full set of data from the data source
        var filteredData = dataSource.data();
        var allRIDs = "";
        var newPropertyNumber = "";
        var newSchemeName = "";
        var newDepartment = "";
        var newPropertyType = "";
        var newSector = "";
        var newBlock = "";
        var newCoveredArea = 0;
        var newActualArea = 0;
        var newTotalArea = 0;
        var newTotalPropertyCost = 0;
        if (filteredData.length == 0) {
            alertify.error("Please add some properties to amalgamate.");
            return false;
        }

        if (filteredData.length == 1) {
            alertify.error("Please add atleast two properties to amalgamate.");
            return false;
        }


        $.each(filteredData, function (index, item) {

            allRIDs = allRIDs + item.Rid + ",";
            newPropertyNumber = newPropertyNumber + item.PropertyNumber + "-";

            newCoveredArea = parseInt(newCoveredArea) + parseInt(item.CoveredArea);
            newActualArea = parseInt(newActualArea) + parseInt(item.ActualArea);
            newTotalArea = parseInt(newTotalArea) + parseInt(item.TotalArea);
            newTotalPropertyCost = parseInt(newTotalPropertyCost) + parseInt(item.TotalPropertyCost);
        });
        $("#hdnAllRids").val(allRIDs);
        //alert(newPropertyNumber);
        newSchemeName = $("#SchemeName").val();
        newDepartment = $("#DepartmentName").val();
        newPropertyType = $("#PropertyType").val();
        newSector = $("#SectorName").val();
        newBlock = $("#BlockName").val();

        //$("#ApplicantName").val(result.ApplicantName);
        $("#txtPropertyNumber").val(newPropertyNumber.slice(0, newPropertyNumber.length - 1));
        $("#txtSchemeName").val(newSchemeName);
        $("#txtDepartmentName").val(newDepartment);
        $("#txtPropertyType").val(newPropertyType);
        $("#txtSectorName").val(newSector);
        $("#txtBlockName").val(newBlock);
        $("#txtCoveredArea").val(newCoveredArea);
        $("#txtActualArea").val(newActualArea);
        $("#txtTotalArea").val(newTotalArea);
        $("#txtTotalPropertyCost").val(newTotalPropertyCost);

        $("#btnSubmit").removeAttr('disabled');

    });
    $('#btnSubmit').click(function () {
        if ($("#Charges").val() == "") {
            alertify.error("Please enter Charges.");
            $("#Charges").focus();
            return false;
        }

        $("#assignToWindow").data("kendoWindow").center();
        $("#User").data("kendoDropDownList").dataSource.read();
        $("#assignToWindow").data("kendoWindow").open();
    });

    $("#btnClosePopUp").click(function () {
        $("#popUpViewComments").data("kendoWindow").close();
    });

    $("#btnViewComments").click(function () {
        $("#popUpViewComments").data("kendoWindow").center();
        $("#popUpViewComments").data("kendoWindow").open();
    });


</script>
