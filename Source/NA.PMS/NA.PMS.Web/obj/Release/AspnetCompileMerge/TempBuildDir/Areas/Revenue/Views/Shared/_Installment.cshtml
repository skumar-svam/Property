@model NA.PMS.Model.PaymentScheduleModel
@using NA.PMS.Common;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;

<style>
    .float-right {
        float: right;
    }

    .row.form-group {
        padding-right: 30px;
    }
</style>

<div class="panel-body">
    <div>
        @Html.Hidden("Id")
        @Html.Hidden("ScheduleId")
    </div>
    <div class="row form-group">
        <div class="col-md-3 col-sm-6 col-xs-12 ">
            @Html.Label("Registration Id")
            @(Html.Kendo().DropDownList()
                .Name("DDLIPRegistrationId")
                .DataTextField("Text")
                .DataValueField("Id")
                .OptionLabel("---select---")
                .Filter("contains")
                .DataSource(source =>
                {
                    source.Custom()
                    .ServerPaging(true)
                    .ServerFiltering(true)
                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                    .Transport(transport => transport.Read(read => read.Action("GetRegistrationIdListFromPaymentSchedule", "Payment", new { Area = "Revenue" })))
                    .Schema(schema => schema.Data("Data").Total("Total"))
                    .PageSize(100);
                })
                .HtmlAttributes(new { style = "width:90%;float:right;" })
                    //.Events(m => m.Change("GetPaymentDetails"))
            )
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 ">
            @Html.Label("Is One Time Installment Paid")
            @(Html.Kendo().DropDownList()
                .Name("DDLOneTimeInstallmentStatus")
                .DataTextField("Text")
                .DataValueField("Value")
                .OptionLabel("---select---")
                .DataSource(source => source.Read("GetYesNoStatus", "Payment", new { area = "Revenue" }))
                .Events(e => e.Change("ToggleLeaseRentStatus"))
                .HtmlAttributes(new { style = "width:90%;float:right;" })
            )
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 ">
            @Html.Label("Is Installment Paid")
            @(Html.Kendo().DropDownList()
                .Name("DDLInstallmentStatus")
                .DataTextField("Text")
                .DataValueField("Value")
                .OptionLabel("---select---")
                .DataSource(source => source.Read("GetYesNoStatus", "Payment", new { area = "Revenue" }))
                .HtmlAttributes(new { style = "width:90%;float:right;" })
            )
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 ">
            <label>Period Of Installment</label>
            <input type="text" class="k-textbox" id="txtPeriodOfInstallment" maxlength="20" style="width:90%; float:right;" />
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-3 col-sm-6 col-xs-12 ">
            <label>Installment No</label>
            <input type="text" class="k-textbox" id="txtInstallmentNo" maxlength="10" style="width:90%; float:right;" />
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 ">
            <label>Installment Premium</label>
            <input type="text" class="k-textbox" id="txtInstallmentPremium" maxlength="20" style="width:90%; float:right;" />
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 ">
            <label>Installment Interest</label>
            <input type="text" class="k-textbox" id="txtInstallmentInterest" maxlength="20" style="width:90%; float:right;" />
        </div>
        <div class="col-md-3 col-sm-6 col-xs-12 ">
            <label>Balance Amount</label>
            <input type="text" class="k-textbox" id="txtBalanceAmount" maxlength="20" style="width:90%; float:right;" />
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-3 col-sm-3 col-xs-12 ">
            <label>Installment Start Date</label>
            @(Html.Kendo().DatePicker().Name("IPInstalmentStartDate").HtmlAttributes(new { @class = "input-disabled  readonly", style = "width:90%;float:right;" }))
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 ">
            <label>Installment End Date</label>
            @(Html.Kendo().DatePicker().Name("IPInstalmentEndDate").HtmlAttributes(new { @class = "input-disabled  readonly", style = "width:90%;float:right;" }))
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 ">
            <label>Installment Due Date</label>
            @(Html.Kendo().DatePicker().Name("IPInstalmentDueDate").HtmlAttributes(new { @class = "input-disabled  readonly", style = "width:90%;float:right;" }))
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 ">
            <label>Deposit Date</label>
            @(Html.Kendo().DatePicker().Name("IPIDepositDate").HtmlAttributes(new { @class = "input-disabled  readonly", style = "width:90%;float:right;" }))
        </div>
    </div>

    <div class="row form-group">       
        <div class="col-md-3 col-sm-3 col-xs-12 ">
            @Html.Label("Payment Mode", new { @id = "" })
            @(Html.Kendo().DropDownList()
                .Name("DDLIPPaymentMode")
                .DataTextField("Text")
                .DataValueField("Id")
                .OptionLabel("---Select---")
                .Filter("contains")
                .DataSource(source =>
                {
                    source.Custom()
                    .ServerPaging(true)
                    .ServerFiltering(true)
                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                    .Transport(transport => transport.Read(read => read.Action("GetPaymentModeList", "Payment", new { Area = "Revenue" })))
                    .Schema(schema => schema.Data("Data").Total("Total"))
                    .PageSize(100);
                })
                .HtmlAttributes(new { style = "width:90%; float:right; readonly " })
            )
        </div>

        <div class="col-md-3 col-sm-3 col-xs-12 ">
            <label>Transaction Id</label>
            <input type="text" class="k-textbox" id="txtTransactionId" maxlength="20" style="width:90%; float:right;" />
        </div>

        
    </div>


    <div class="row form-group" style="text-align:right;padding-right:30px;">
        <div class="col-md-12">
            <input type="button" id="btnPaymentRequest" class="k-button" value="Update" style="min-width:80px;" />
            <input type="button" id="btnPaymentClear" class="k-button" value="Clear" />
        </div>
    </div>
</div>


<script type="text/javascript">

    $(document).ready(function () {
        $('.row-payment').css("display", "none");
        $(".PaymentDetailsGrid").hide();
        $("#btnSubmit").val("Create Payment Schedule");
        $('#btnCalculate').css("display", "none");
        $('#InstallmentActionType input:radio[name=ActionType]').on('change', function () {
            ToggleActionType();
            if ($('input:radio[name=ActionType]:checked').val() == "InstallmentPayment") $("#btnSubmit").val("Pay Installment");
            else $("#btnSubmit").val("Create Payment Schedule");
        });

        $('input[type=text][name=TotalInstallment]').on('change', function () {
            if ($('input[type=text][name=TotalInstallment]').val() != "") {
                CalculateInstallment();
            }
        });

        $("#btnSubmit").click(function () {
            SubmitFormDetails();
        });

        $("#btnCancel").click(function () {
            $('#RegistrationId').data("kendoDropDownList").value('');
            ClearPaymentScheduleFields();
            ClearInstallmentPaymentFields();
            $('.PaymentDetailsGrid').hide();
        });

        $("#btnCalculate").click(function () {
            CalculateInstallment();
        });
    });

    function FilterRegistrationId() {
        var regId = $('#RegistrationId').val() != "" ? $('#RegistrationId').val() : 0;
        return {
            rid: regId
        }
    }

    function ToggleActionType() {
        var actiontype = $('input[name=ActionType]:checked', '#InstallmentActionType').val();
        if (actiontype.trim() == "InstallmentPayment") {
            $('.row-payment').show();
            $('#btnCalculate').show();
        }
        else {
            $('.row-payment').css("display", "none");
            $('#btnCalculate').css("display", "none");
        }
        ClearInstallmentPaymentFields();
    }

    function ToggleLeaseRentStatus() {
        var oneTimeStatus = $('#DDLOneTimeLeaseRentStatus').data("kendoDropDownList").value();
        if (oneTimeStatus == "Y") {
            $('#DDLLeaseRentStatus').data("kendoDropDownList").value("Y");
            $('#DDLLeaseRentStatus').data("kendoDropDownList").enable(false);
        }
        else if (oneTimeStatus == "N") {
            $('#DDLLeaseRentStatus').data("kendoDropDownList").value("");
            $('#DDLLeaseRentStatus').data("kendoDropDownList").enable(true);
        }
        else {
            $('#DDLLeaseRentStatus').data("kendoDropDownList").value("");
            $('#DDLLeaseRentStatus').data("kendoDropDownList").enable(true);
        }
    }

    function GetPaymentDetails() {
        var rid = $("#RegistrationId").val();
        if (rid != "") {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ rid: rid }),
                url: "/Property/ManagePayment/GetPayScheduleInformation",
                success: function (result) {
                    if (result != null) {
                        ClearPaymentScheduleFields();
                        ClearInstallmentPaymentFields();
                        $("#Applicant").val(result.Applicant);
                        $("#PropertyNo").val(result.PropertyNo);
                        $("#PropertyType").val(result.PropertyType);
                        $("#AllotmentDate").data("kendoDatePicker").value(result.AllotmentDate);
                        if (result.ScheduleId != null && result.ScheduleId != 0) {
                            $("#ScheduleId").val(result.ScheduleId);
                            $("#PrincipalAmount").val(result.PrincipalAmount);
                            $("#PenalInterest").val(result.PenalInterest);
                            $("#NormalInterest").val(result.NormalInterest);
                            $("#Frequency").data("kendoDropDownList").value(result.Frequency);
                            $("#TotalInstallment").val(result.TotalInstallment);
                            $("#ScheduleType").val(result.ScheduleType);
                            $("#PeriodOfInstallment").val(result.PeriodOfInstallment);
                            $("#InstalmentStartDate").data("kendoDatePicker").value(result.InstalmentStartDate);
                            $('#TotalBalanceAmount').val(result.TotalBalanceAmount);
                            $('#PreInstallmentNo').val(result.PreInstallmentNo);

                            $('.readonly').attr("readonly", true);
                            $('#gridPaymentSchedule').data('kendoGrid').dataSource.read();
                            $(".PaymentDetailsGrid").show();
                            //CalculateInstallment();
                        } else {
                            $(".PaymentDetailsGrid").hide();
                            //$('#gridPaymentSchedule').data('kendoGrid').refresh();
                            //ClearPaymentScheduleFields();
                            //ClearInstallmentPaymentFields();
                            $('.readonly').attr("readonly", false);
                            $('.row-payment').css("display", "none");
                            alertify.error("Please add payment schedule for this Registration Id");
                        }
                        //$(".PaymentDetails").show();

                    } else { alertify.error("no data found."); }

                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                }
            });
        }
        else {
            ClearPaymentScheduleFields();
            ClearInstallmentPaymentFields();
            $(".PaymentDetailsGrid").hide();
            $('.readonly').attr("readonly", false);
            //$('#gridPaymentSchedule').data('kendoGrid').refresh();
        }
    }

    function SubmitFormDetails() {
        var actiontype = $("input[type='radio'][name='ActionType']:checked").val();
        $('#FrequencyName').val($('#Frequency').data("kendoDropDownList").text());
        $('#PaymentMode').val($('#PaymentModeId').data("kendoDropDownList").text());
        var formData = new FormData($('form').get(0));
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            data: formData,
            url: '/Property/ManagePayment/SaveInstallmentPaymentSchedule',
            success: function (result) {
                if (result != null) {
                    if (actiontype == "InstallmentSchedule") {
                        alertify.success("Installment Schedule added successfully.");
                        return false;
                    }
                    else {
                        ClearInstallmentPaymentFields();
                        $('#gridPaymentSchedule').data('kendoGrid').dataSource.read();
                        GetPaymentDetails();
                        alertify.success("Installment payment added successfully.");
                    }
                }
            },
            error: function (ajaxRequest, strError) {
                alertify.error("Network error, try again later");
            }
        });
    }

    function CalculateInstallment() {
        var flag = true;
        var rid = $("#RegistrationId").val();
        if (rid == "") {
            alertify.error("Select Reistration Id");
            flag = false;
            return false;
        }
        else if ($("#PrincipalAmount").val() == "") {
            alertify.error("Enter Principal Amount");
            flag = false;
            return false;
        }
        else if ($("#TotalInstallment").val() == "") {
            alertify.error("Enter Total No. of Installment");
            flag = false;
            return false;
        }
        else if ($("#Frequency").data("kendoDropDownList").value() == "") {
            alertify.error("Select Frequency");
            flag = false;
            return false;
        }
        else {
            var principal = parseFloat($("#PrincipalAmount").val()).toFixed(2);
            var totalInstallment = parseInt($("#TotalInstallment").val());
            var normalInterest = parseInt($("#NormalInterest").val());
            var frequency = parseInt($("#Frequency").data("kendoDropDownList").value());
            var premium = parseFloat(principal / (parseInt(totalInstallment) * parseInt(frequency))).toFixed(2);

            if ($('#TotalBalanceAmount').val() == "") {
                var interestMoney = parseFloat((premium * normalInterest) / 100).toFixed(2);
                var installmentMoney = parseFloat(parseFloat(premium) + parseFloat(interestMoney)).toFixed(2);
                var balanceAmount = parseFloat(parseFloat(principal) - parseFloat(installmentMoney)).toFixed(2);
                $('#PremiumAmount').val(installmentMoney);
                $('#InstallmentAmount').val(installmentMoney);
                $('#InstallmentInterest').val(interestMoney);
                $('#BalanceAmount').val(balanceAmount);
                $('#InstallmentNo').val(1);
            }
            else if ($('#TotalBalanceAmount').val() != "") {
                var preBalance = parseFloat($('#TotalBalanceAmount').val());
                var installmentNo = $('#PreInstallmentNo').val();
                $('#InstallmentNo').val(parseInt(installmentNo) + 1);
                if (preBalance <= 0) {
                    $('#PremiumAmount').val(0);
                    $('#InstallmentAmount').val(0);
                    $('#InstallmentInterest').val(0);
                    $('#BalanceAmount').val(0);
                }
                else {
                    var installmentMoney = parseFloat(parseFloat(premium) + parseFloat(interestMoney)).toFixed(2);
                    if (preBalance < premium) {
                        var interestMoney = parseFloat((preBalance * normalInterest) / 100).toFixed(2);
                        var installmentMoney = parseFloat(parseFloat(preBalance) + parseFloat(interestMoney)).toFixed(2);
                        $('#InstallmentAmount').val(installmentMoney);
                        $('#InstallmentInterest').val(interestMoney);
                        $('#BalanceAmount').val(0);
                    }
                    else {
                        var interestMoney = parseFloat((premium * normalInterest) / 100).toFixed(2);
                        var installmentMoney = parseFloat(parseFloat(premium) + parseFloat(interestMoney)).toFixed(2);
                        var balanceAmount = parseFloat(parseFloat(preBalance) - parseFloat(installmentMoney)).toFixed(2);
                        $('#PremiumAmount').val(installmentMoney);
                        if ((preBalance < installmentMoney) || (preBalance == installmentMoney)) {
                            $('#InstallmentAmount').val(preBalance);
                            $('#BalanceAmount').val(0);
                        }
                        else if (preBalance > installmentMoney) {
                            $('#InstallmentAmount').val(installmentMoney);
                            $('#InstallmentInterest').val(interestMoney);
                            $('#BalanceAmount').val(balanceAmount);
                        }
                    }
                }
                //var balanceAmount = parseFloat(parseFloat($('#TotalBalanceAmount').val()) - parseFloat(installmentMoney)).toFixed(2);
                //$('#BalanceAmount').val(balanceAmount);
            }
        }
    }


    $("#btnRemove").click(function () {
        var nRegId = parseInt($('#RegistrationId').val());
        var nScheduleId = $("#ScheduleId").val();
        if (nRegId != "" && nScheduleId != "") {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ Rid: nRegId, ScheduleId: nScheduleId }),
                url: "/ManagePayment/RemovePayScheduleInformation",
                success: function (result) {
                    if (result != null) {
                        if (result == true) {
                            alertify.success("Record has been removed successfully.");
                            setTimeout(function () {
                                window.location.href = '@Url.Action("CreateSchedule", "ManagePayment")';
                            }, 2500);
                        }
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                }
            })
        } else {
            alertify.error("select registration no.");
            return false;
        }
    });


    function onRequestEnd(e) {
        if (e.type == "update") {
            if (!e.response.Errors) {
                alertify.success("Record has been updated successfully.");
                $("#gridPaymentSchedule").data("kendoGrid").dataSource.read();
            }
            else {
                alertify.error("Record not Saved.");
                $("#gridPaymentSchedule").data("kendoGrid").dataSource.read();
            }
        }
    }

    function CheckInterestRate(rate) {
        if (rate > 99.99 || rate < -1) {
            alertify.error("Interest rate can't be more than 99.99");
            return false;
        }
        else {
            return true;
        }
    }

    //$(".InterestRateCheck").blur(function () {
    //    var rate = $('#InterestRateCheck').val();
    //    CheckInterestRate(rate);
    //});

    //$(".InstallmentNo").blur(function () {
    //    CheckInstallment();
    //});

    function GetinstallmentDetails() {
        CheckInstallment();
    }

    function CheckInstallment() {
        var rid = $("#RegistrationId").val();
        if (rid != "") {
            var noInstallment = $('#TotalInstallment').val();
            var frequency = $("#Frequency").data("kendoDropDownList").value();
            if (noInstallment != "" && frequency != "") {
                var reminder = noInstallment % frequency;
                if (reminder != 0) {
                    alertify.error("Installment error.");
                    $('#TotalInstallment').val('');
                    $("#Frequency").data("kendoDropDownList").value('');
                    return false;
                } else { $("#PeriodOfInstallment").val((noInstallment / frequency)); }
            }
            else {
                if (noInstallment == "") {
                    alertify.error("select maximum no. of installment.");
                    return false;
                }
                if (frequency == "") {
                    alertify.error("select frequency of installmet.");
                    return false;
                }
            }
        } else {
            alertify.error("select registration no.");
            return false;
        }
    }


    function ClearPaymentScheduleFields() {
        $("#Applicant").val('')
        $("#PropertyNo").val('')
        $("#PropertyType").val('')
        $("#AllotmentDate").data("kendoDatePicker").value('');
        $("#ScheduleId").val('');
        $("#PrincipalAmount").val('');
        $("#TotalInstallment").val('');
        $("#Frequency").data("kendoDropDownList").value('');
        $("#PeriodOfInstallment").val('');
        $("#NormalInterest").val('');
        $("#PenalInterest").val('');
        $("#ScheduleType").val('');
        $("#InstalmentStartDate").data("kendoDatePicker").value('');
    }

    function ClearInstallmentPaymentFields() {
        $("#InstallmentNo").val('')
        $("#PremiumAmount").val('')
        $("#InstallmentAmount").val('')
        $("#InstallmentInterest").val('')
        $("#BalanceAmount").val('')
        $("#InstallmentDueDate").data("kendoDatePicker").value('');
        $("#DepositDate").data("kendoDatePicker").value('');
        $("#PaymentModeId").data("kendoDropDownList").value('');
    }
</script>

