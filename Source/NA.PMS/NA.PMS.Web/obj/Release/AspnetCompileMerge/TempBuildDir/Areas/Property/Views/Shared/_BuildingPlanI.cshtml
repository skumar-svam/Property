@using Kendo.Mvc.UI
@model NA.PMS.Model.BuildingPlanModel 
<style>
  
    .linkCss {
        color: #337ab7;
        text-decoration: underline;
    }

        .linkCss:hover {
            color: #337ab7;
            cursor: pointer;
            text-decoration: underline;
        }
</style>
<fieldset>
    <legend>Building Details</legend>
    <div class="row">
        <div class="col-md-3">
            @Html.Label("Name Of Tower*")

        </div>
        <div class="col-md-3">
            <div id="lblScNa">
                @Html.TextBoxFor(m => m.NameOfTower, new { @maxlength="100"})

            </div>
        </div>
        <div class="col-md-3">
            @Html.Label("Covered Area (Multi Floors)*")
        </div>
        <div class="col-md-3">
            <div id="lblDeNa">
                <div class="col-md-3">
                    @(Html.Kendo().NumericTextBoxFor(m => m.CoveredAreaMultiFloors)
                                                .Name("CoveredAreaMultiFloors")
                                .Min(0)
                                .Max(999999999)
                                        .Spinners(false).Step(0)
                                .Enable(true)
                                .HtmlAttributes(new { style = "width: 180px", @maxlength = "7", @class = "k-label schemeForms textBoxValueRightAlign" })
                    )
                    @*@Html.TextBoxFor(m => m.CoveredAreaMultiFloors, new { @maxlength="18"})*@
                </div>
            </div>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-3">
            @Html.Label("Building Height (Meter)*")
        </div>
        <div class="col-md-3">
            <div>
                @(Html.Kendo().NumericTextBoxFor(m => m.BuildingHeight)
                                                        .Name("BuildingHeight")
                                .Min(0)
                                .Max(99999)
                                        .Spinners(false).Step(0)
                                .Enable(true)
                                .HtmlAttributes(new { style = "width: 180px", @maxlength = "3", @class = "k-label schemeForms textBoxValueRightAlign" })
                )
               @*@Html.TextBoxFor(m => m.BuildingHeight, new { @maxlength="8"})*@
            </div>
        </div>
        <div class="col-md-3">
            @Html.Label("Covered Area (Ground Floor)*")
        </div>
        <div class="col-md-3">
            <div id="lblDateOfSanction">
                @(Html.Kendo().NumericTextBoxFor(m => m.CoveredAreaGroundFloor)
                                        .Name("CoveredAreaGroundFloor")
                                .Min(0)
                                .Max(999999999)
                                        .Spinners(false).Step(0)
                                .Enable(true)
                                .HtmlAttributes(new { style = "width: 180px", @maxlength = "7", @class = "k-label schemeForms textBoxValueRightAlign" })
                )
                @*@Html.TextBoxFor(m => m.CoveredAreaGroundFloor, new { @maxlength="18"})*@
            </div>

        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-3">
            @Html.Label("Number Of Stories*")
        </div>
        <div class="col-md-3">
            <div id="lblReNa">
                @Html.TextBoxFor(m => m.NumberOfStories2, new { @maxlength="3"})
               </div>
        </div>
      
        <div class="row">
            <div class="col-md-10"></div>
            <div class="col-md-2">
                <button type="button" class="btn btn-default" value="Add" id="btnBuilding"> Add</button>
                @*<button type="button" class="btn-primary" value="Add" id="btnAddScheme"><i class="fa fa-plus-square" aria-hidden="true"></i> Add</button>*@
                <br />
            </div>
        </div>
    </div>
    <br />
    <div class="k-grid-content">
        @Html.HiddenFor(c => c.RId)
        @(Html.Kendo().Grid<NA.PMS.Model.BuildingPlanModel>()
                        .Name("gridBuildingDetails")
        .Columns(columns =>
        {
            columns.Bound(c => c.NameOfBuilding).Width(100).Title("Name Of Building");
            columns.Bound(c => c.TotalCoveredAreaAllFloor).Width(100).Title("Total Covered Area");
            columns.Bound(c => c.BuildingHeight).Width(100).Title("Building Height");
            columns.Bound(c => c.TotalCoveredAreaGroundFloor).Width(100).Title("Covered Area");
            columns.Bound(c => c.NoOfStories).Width(100).Title("No Of Stories");
            columns.Bound(c => c.RequestNo).Title("Action").ClientTemplate("<a onclick='javascript:RemoveBuildingDetails(\"#=RequestNo#\");'class='linkCss'>Remove</a>").Width(50).Filterable(false).Sortable(false);
              })
        .Sortable()
        .Filterable()
                .Resizable(resize => resize.Columns(true))
                //.ToolBar(toolBar =>
                //{
                //    toolBar.Custom().Text("<i class='fa fa-plus-square' aria-hidden='true'></i> Add Request").HtmlAttributes(new { onclick = "javascript:AddCompletionReq(event);", @class = "k-button", id = "btnRequest" });
                //})
        .Pageable(pageable => pageable
                                               .Enabled(true)
                                               .Refresh(true)
                                               .PageSizes(true)
                                            )
        .DataSource(dataSource => dataSource
                .Ajax().Model(model => model.Id(c => c.RequestNo))
        .ServerOperation(true)
                                        .Read(read => read.Action("GetBuildingDetail", "PropertyRegistration").Data("AdditionalInfo")).PageSize(20)
        )
        )
    </div>
