        <fieldset>
            <legend>NOC Details</legend>
            <div class="row">
                <div class="col-md-3">
                    @Html.Label("NOC Type*")
                </div>
                <div class="col-md-3">
                    <div>
                        @(Html.Kendo().DropDownListFor(model => model.NocType )
                      .DataTextField("text")
                                      .DataValueField("id")
                      .OptionLabel("Select")
                      .DataSource(source =>
                      {
                          source.Read(read =>
                          {
                              read.Action("GetNOCType", "PropertyRegistration");
                          });
                      })

                        )
                    </div>
                </div>
                <div class="col-md-3">
                    @Html.Label("Submitted*")
                </div>
                <div class="col-md-3">
                    <div id="lblDateOfSanction">
                        @(Html.Kendo().DropDownListFor(model => model.Submitted )
                      .DataTextField("text")
                              .DataValueField("text")
                      .OptionLabel("Select")
                      .DataSource(source =>
