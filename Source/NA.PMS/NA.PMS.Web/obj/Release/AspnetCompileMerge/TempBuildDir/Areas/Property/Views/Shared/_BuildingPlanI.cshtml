<div class="container-fluid">
    <div class="row">
        <div class="col-md-9"></div>
        <div class="col-md-3">
            <input type="button" id="btnSubmit" value="Submit" class="btn btn-block btn-default" />
            @*<input type="button" value="Back" id="btnBack" />*@
        </div>
    </div>
</div>
<script type="text/javascript">
    function AdditionalInfo() {
        return {
            rid: $('#RId').val()
        }
    }
    $("#btnBuilding").click(function () {

        var rId = $("#RId").val();

        var NameOfTower = $("#NameOfTower").val();
        var CoveredAreaMultiFloors = $("#CoveredAreaMultiFloors").val();

        var BuildingPlanFileNo = $("#BuildingPlanFileNo").val();
        alert("BuildingPlanFileNo=" + BuildingPlanFileNo)
        var BuildingHeight = $("#BuildingHeight").val();
        var CoveredAreaGroundFloor = $("#CoveredAreaGroundFloor").val();
        var NumberOfStories2 = $("#NumberOfStories2").val();


        if (rId == "") {
            alertify.error("Please select RId.");
            return false;
        }
        if (NameOfTower == "") {
            alertify.error("Please enter Name Of Tower.");
            return false;
        }
        if (CoveredAreaMultiFloors == "") {
            alertify.error("Please enter Covered Area Multi Floors.");
            return false;
        }

        if (BuildingHeight == "") {
            alertify.error("Please select Building Height.");
            return false;
        }
        if (CoveredAreaGroundFloor == "") {
            alertify.error("Please select Covered Area Ground Floor.");
            return false;
        }
        if (NumberOfStories2 == "") {
            alertify.error("Please enter Number Of Stories.");
            return false;
        }

        //if (user != "") {
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rId: rId, NameOfTower: NameOfTower, CoveredAreaMultiFloors: CoveredAreaMultiFloors, BuildingHeight: BuildingHeight, CoveredAreaGroundFloor: CoveredAreaGroundFloor, NumberOfStories2: NumberOfStories2 }),
            url: '/PropertyRegistration/SaveBuildingDetails',
            success: function (result) {
                if (result == 1) {
                    $("#NameOfTower").val("");
                    $("#CoveredAreaMultiFloors").data("kendoNumericTextBox").value("");
                    $("#BuildingHeight").data("kendoNumericTextBox").value("");
                    $("#CoveredAreaGroundFloor").data("kendoNumericTextBox").value("");
                                    
                    $("#NumberOfStories2").val("");
                    $("#gridBuildingDetails").data("kendoGrid").dataSource.read();
                    alertify.success("Data saved successfully.");

                    @*window.location.href = '@Url.Action("ManageBuildingPlan", "PropertyRegistration")';*@
                    return false;
                }
                if (result == 2) {
                    alertify.error("Building Details already saved .");
                    return false;
                }
                if (result == 3) {
                    alertify.error("Number of stories in  Building plan details would be less than or equal to No of Stories (Max) in tab 1.");
                    return false;
                }
                else {
                    alertify.error("Some Error in save database.");
                    //return true;
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }

        });
    });

    $("#btnAddBPCharges").click(function () {

        var rId = $("#RId").val();

        var Charges = $("#Charges").val();
        var FeeAmount = $("#FeeAmount").val();



        if (rId == "") {
            alertify.error("Please select RId.");
            return false;
        }
        if (Charges == "") {
            alertify.error("Please select Charges.");
            return false;
        }
        if (FeeAmount == "") {
            alertify.error("Please enter Fee Amount.");
            return false;
        }


        //if (user != "") {
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rId: rId, Charges: Charges, FeeAmount: FeeAmount }),
            url: '/PropertyRegistration/SaveBuildingCharge',
            success: function (result) {
                if (result == 1) {
                    $("#Charges").data("kendoDropDownList").value("");
                    $("#FeeAmount").data("kendoNumericTextBox").value("");
                      $("#gridBuildingCharge").data("kendoGrid").dataSource.read();
                    alertify.success("Data saved successfully.");
                    return false;
                }
                if (result == 2) {
                    alertify.error("Building Charge already saved .");
                    return false;
                }
                else {
                    return true;
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alertify.error("Some Error in save database.");
            }

        });

    });

    $("#btnNOC").click(function () {

        var rId = $("#RId").val();

        var NocType = $("#NocType").val();
        var Submitted = $("#Submitted").val();



        if (rId == "") {
            alertify.error("Please select RId.");
            return false;
        }
        if (NocType == "") {
            alertify.error("Please select Noc Type.");
            return false;
        }
        if (Submitted == "") {
            alertify.error("Please select Submitted.");
            return false;
        }


        //if (user != "") {
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rId: rId, NocType: NocType, Submitted: Submitted }),
            url: '/PropertyRegistration/SaveNOCType',
            success: function (result) {
                if (result == 1) {
                    $("#NocType").data("kendoDropDownList").value("");
                    $("#Submitted").data("kendoDropDownList").value("");

                    $("#gridNOCType").data("kendoGrid").dataSource.read();
                    alertify.success("Data saved successfully.");
                    return false;
                }
                if (result == 2) {
                    alertify.error("Building Plan Data already saved .");
                    return false;
                }
                else {
                    return true;
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alert(respText);
            }

        });

    });
    function RemoveBuildingDetails(RequestNo) {

        var removeNotification = confirm('Are you sure you want to remove ?');
        var rId = $("#RId").val();
        if (removeNotification) {
            $.ajax({
                url: '@(Url.Action("RemoveBuildingDetails", "PropertyRegistration"))',
                type: 'POST',
                data: { RequestNo: RequestNo, rId: rId },
                success: function (result) {
                    if (result == true) {
                        $('#gridBuildingDetails').data('kendoGrid').dataSource.read();
                        $('#gridBuildingDetails').data('kendoGrid').refresh();
                        alertify.success("Record deleted successfully.");
                    }
                    else {
                        alert("Building Details not removed");
                        return false;
                    }
                }
            });
        }
        else {
            return false;
        }
    }
    function RemoveBuildingCharge(RequestNo) {
        var removeNotification = confirm('Are you sure you want to remove ?');
        var rId = $("#RId").val();
        if (removeNotification) {
            $.ajax({
                url: '@(Url.Action("RemoveBPCharges", "PropertyRegistration"))',
                type: 'POST',
                data: { RequestNo: RequestNo, rId: rId },
                success: function (result) {
                    if (result == true) {
                        $('#gridBuildingCharge').data('kendoGrid').dataSource.read();
                        $('#gridBuildingCharge').data('kendoGrid').refresh();
                        alertify.success("Record deleted successfully.");
                    }
                    else {
                        alert("Building Charge not removed");
                        return false;
                    }
                }
            });
        }
        else {
            return false;
        }
    }
    function RemoveNOCType(RequestNo) {
        var removeNotification = confirm('Are you sure you want to remove ?');
        var rId = $("#RId").val();
        if (removeNotification) {
            $.ajax({
                url: '@(Url.Action("RemoveNocType", "PropertyRegistration"))',
                type: 'POST',
                data: { RequestNo: RequestNo, rId: rId },
                success: function (result) {
                    if (result == true) {
                        $('#gridNOCType').data('kendoGrid').dataSource.read();
                        $('#gridNOCType').data('kendoGrid').refresh();
                        alertify.success("Record deleted successfully.");
                    }
                    else {
                        alert("NOC Type not removed");
                        return false;
                    }
                }
            });
        }
        else {
            return false;
        }
    }

    $("#btnSubmit").click(function () {

        var rId = $("#RId").val();
        if (rId == "") {
            alertify.error("Please select RId.");
            return false;
        }
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rId: rId}),
            url: '/PropertyRegistration/SubmitBuildingPlan',
            success: function (result) {
                if (result == 1) {

                    alertify.success("Data saved successfully.");
                    window.location.href = '@Url.Action("ManageBuildingPlan", "PropertyRegistration")';
                    return false;
                }
                if (result == 0) {
                    alertify.error("Building Plan Data not saved .");
                    return false;
                }
                else {
                    return true;
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alert(respText);
            }

        });

    });
</script>