        columns.Bound(c => c.SubmitStatus).Title("Submit Status");
        columns.Bound(c => c.RequestNo).Title("Action").ClientTemplate("<a onclick='javascript:RemoveNOCType(\"#=RequestNo#\");'class='linkCss'>Remove</a>").Filterable(false).Sortable(false);
