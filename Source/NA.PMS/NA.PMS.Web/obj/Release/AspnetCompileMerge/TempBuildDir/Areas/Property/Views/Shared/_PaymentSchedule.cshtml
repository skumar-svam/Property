@model NA.PMS.Model.PaymentSchedule
@using Kendo.Mvc.UI;

<style>
    #div-rscheduled-installment {
        display: none;
    }
</style>

<div class="col-md-12">
    <div class="row blck-heading-grid">
        <div class="col-md-6 col-sm-6 col-xs-12">
            <span>Payment Schedule</span>
        </div>
        <div class="col-md-6 col-sm-6 col-xs-12" style="text-align:right">
            @*@if (Convert.ToDateTime(DateTime.Now) > Convert.ToDateTime(@Model.InstalmentStartDate))
            {
                <span style="color:red">Installment amount payable till date: @Model.TotalDueAmount</span>
                <input type="button" id="btnReschedule" class="k-button" value="Reschedule Payment" />
            }
            else
            {
                <input type="button" id="btnReschedule" class="k-button" value="Reschedule Payment" />
            }*@
            @*<input type="button" id="btnReschedule" class="k-button" value="Reschedule Payment" />*@
            <span class="hyperlink" id="btnReschedule">Reschedule Payment</span>
        </div>
    </div>
</div>
<div class="col-md-12 k-grid-content">
    @Html.HiddenFor(c => c.Rid)
    @Html.HiddenFor(c => c.TotalDueAmount)
    @(Html.Kendo().Grid<NA.PMS.Model.PaymentSchedule>()
           .Name("gridPaymentSchedule")
           .Columns(columns =>
           {
               columns.Bound(c => c.Id).Title("ID").Hidden(true);
               columns.Bound(c => c.InstallmentNumber).Title("INo").Width(80);
               columns.Bound(c => c.InstallmentDueDate).Format("{0:dd-MMM-yyyy}").Title("Due Date");
               columns.Bound(c => c.PrincipalInstallmentAmount).Title("Premium");
               columns.Bound(c => c.InterestInstallmentAmount).Title("Interest");
               columns.Bound(c => c.TotalBalAmount).Title("Receivable Amount");
               columns.Bound(c => c.PrincipalBalAmount).Title("Balance");
               columns.Bound(c => c.IsInstallmentPaid).Title("Action").Width(110).ClientTemplate("#if(IsInstallmentPaid==null || IsInstallmentPaid==false){# <div class='text-center'><button class='btn btn-xs btn-success' onclick='updateStatus(this,#= Id#)'>Not Paid</button></div> #}else if(IsInstallmentPaid==true){# <div class='text-center'><button class='btn btn-xs btn-danger' onclick='updateStatus(this,#= Id#)'>Paid</button></div> #}else{# <div class='text-center'> <span class='badge badge-danger text-center'>Un Paid</span></div> #}#");
           })
           .Sortable().Filterable().Resizable(resize => resize.Columns(true))
           .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
           .DataSource
           (
               dataSource => dataSource
                   .Ajax().ServerOperation(true)
                   .Model(model => model.Id(p => p.Id))
                   .Read(read => read.Action("GetPaymentSchedule", "PropertyAllotment").Data("AdditionalInfo"))
                   .Sort(s => s.Add(c => c.InstallmentNumber).Ascending())
                   .PageSize(20)
           )
    )
</div>

<div class="col-md-12 k-grid-content" id="div-rscheduled-installment">
    <h2 class="blck-heading-grid">Payment Reschedule</h2>
    @(Html.Kendo().Grid<NA.PMS.Model.PaymentSchedule>()
              .Name("gridPaymentReschedule")
             .Columns(columns =>
             {
                 columns.Bound(c => c.InstallmentNumber).Title("Number of Installment").Width(80);
                 columns.Bound(c => c.InstallmentDueDate).Format("{0:dd-MMM-yyyy}").Title("Installment Due Date").Width(80);
                 columns.Bound(c => c.PrincipalInstallmentAmount).Title("Principal Installment Amount").Width(80);
                 columns.Bound(c => c.InterestInstallmentAmount).Title("Interest Installment Amount").Width(80);
                 columns.Bound(c => c.TotalBalAmount).Title("Total Installment Amount").Width(80);
                 columns.Bound(c => c.PrincipalBalAmount).Title("Balance Principal Amount").Width(80);
             })
             .Sortable().Filterable().Resizable(resize => resize.Columns(true))
             .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
             .Events(e=>e.DataBound("PaymentRescheduledGridEvent"))
             .DataSource
             (
                 dataSource => dataSource
                     .Ajax()
                     .Model(model => model.Id(p => p.Id))
                     .ServerOperation(true)
                     .Read(read => read.Action("GetPaymentReschedule", "PropertyAllotment").Data("AdditionalInfo"))
                     .PageSize(10)
             )
    )
</div>

<script type="text/javascript">
    function AdditionalInfo() {
        return {
            rid: $('#Rid').val()
        }
    }

    $(document).ready(function () {
        var rId = $('#Rid').val();
        var dueAmnt = $('#TotalDueAmount').val();
        var duesamount = $('#TotalDueAmount').val();
        if (dueAmnt) { }
        $("#btnReschedule").click(function () {
            alert(rId + "-" + duesamount);
            var flag = confirm("Are You sure to Re Schedule Its Installment");
            if(flag){
                ReScheduleInstallmentDues(rId, duesamount);
            }
              
        });
    });

    function updateStatus(e, ScheduleId) {
        var grid = $("#gridPaymentSchedule").data("kendoGrid");
        var row = $(e).closest("tr");
        var currentIndex = $("tr", grid.tbody).index(row);

        var preIndex = currentIndex > 0 ? currentIndex - 1 : 0;
        var postIndex = currentIndex + 1;
        var rid = $('#Rid').val();
        if(currentIndex == 0){
            var PostRow = grid.dataSource._data[postIndex];
            if(PostRow != null){
                if(PostRow.IsInstallmentPaid == true){
                    alertify.error("Post Installment is paid.");
                    return false;
                }
                else{
                    UpdatePaidStatus(rid,ScheduleId);
                }
            }
            else{
                UpdatePaidStatus(rid,ScheduleId);
            }
        }
        else if (preIndex > 0 || preIndex == 0) {
            var PreviouRow = grid.dataSource._data[preIndex];
            var PostRow = grid.dataSource._data[postIndex];
            if (PreviouRow != null) {
                if (PreviouRow.IsInstallmentPaid == true) {
                    if(PostRow != null){
                        if(PostRow.IsInstallmentPaid == true){
                            alertify.error("Pre and Post Installments are paid.");
                            return false;
                        }
                        else{
                            UpdatePaidStatus(rid,ScheduleId);
                        }
                    }
                    else{
                        UpdatePaidStatus(rid,ScheduleId);
                    }
                }
                else{
                    alertify.error("Previous Installment is not paid.");
                }
            }
        }
    }

    function UpdatePaidStatus(rid, scheduleId){
        if (scheduleId > 0) {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({
                    ScheduleId: scheduleId, Rid: rid
                }),
                url: '/PropertyAllotment/UpdatePaymentScheduleStatus',
                success: function (result) {
                    if (result == true) {
                        alertify.success("updated");
                        $("#gridPaymentSchedule").data('kendoGrid').dataSource.read();
                    }
                    else {
                        alertify.error("Failed to update data. Please try again.");
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Network Error. Please try again after some time.");
                }
            });
        }
    }


    function ReScheduleInstallmentDues(rid, duesamount){
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rId: rid, dueAmnt: duesamount }),
            url: '/PropertyAllotment/ReschedulePayments',
            success: function (result) {
                if (result == true) {
                    $('#gridPaymentReschedule').data("kendoGrid").dataSource.read();
                    $("#div-rscheduled-installment").show();
                }
                else {
                    alertify.error("Payment is not rescheduled.");
                    //alertify.error("Some error occurred. Please try again after some time.");
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Some error occurred. Please try again after some time.");
            }
        });
    }

    function PaymentRescheduledGridEvent(){
        if($('#gridPaymentReschedule').data("kendoGrid").dataSource.total()==0){
            $("#div-rscheduled-installment").css("display","none");
        }
        else{
            $("#div-rscheduled-installment").show();
        }
    }
</script>