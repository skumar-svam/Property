@using Kendo.Mvc.UI
@using NA.PMS.Common
@using System.Linq

@*<script src="~/Scripts/Kendo/kendo.dataviz.min.js"></script>*@

<div id="div-graph-ndc-demand">
    <div class="row" style="padding-bottom:8px;">
        <div class="col-md-3">
            <label>Start Date</label>
            @(Html.Kendo().DatePicker().Name("DTStartDate").Events(e => e.Change("DTStartDateChangeEvent")).HtmlAttributes(new { style = "width:90%;" }))
        </div>
        <div class="col-md-3">
            <label>End Date</label>
            @(Html.Kendo().DatePicker().Name("DTEndDate").Events(e => e.Change("DTStartDateChangeEvent")).HtmlAttributes(new { style = "width:90%;" }))
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 demo-section k-content wide">
            <div id="DivDemandPieChart"></div>
        </div>
        <div class="col-md-6 demo-section k-content wide">
            <div id="DivDemandNDCPieChart"></div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 demo-section k-content wide">
            
            <div class="demo-section k-content wide">
                <h2 class=" blck-heading" style="border-left:1px solid green;border-right:1px solid green;margin-bottom:0;">NDC/Demand Letter generated by Department</h2>
                @(Html.Kendo().Chart<NA.PMS.Model.NDCVeiwModel>()
                    .Name("DemandNDCchart")
                        //.Title("NDC/Demand Letter generated by Department")
                    .Legend(legend => legend
                        .Position(ChartLegendPosition.Top)
                    )
                    .DataSource(ds => ds.Read(read => read.Action("GetNDCAndDemandReportsForGraph", "Authority", new { area = "Member" }).Data("FilterDateForNDC")))
                    .Series(series =>
                    {
                        series.Bar(model => model.NDCCount).Name("NDC Letter").CategoryField("Department").Labels(labels => labels.Background("transparent").Visible(true));
                        series.Bar(model => model.DemandCount).Name("Demand Letter").Color("blue").Labels(labels => labels.Background("transparent").Visible(true));
                    })

                    .CategoryAxis(axis => axis
                        .MajorGridLines(lines => lines.Visible(false))
                    )
                    .ValueAxis(axis => axis.Numeric()
                        .Labels(labels => labels.Format("{0:N0}"))
                        .MajorUnit(1000)
                        .Line(line => line.Visible(false))
                    )
                    .Tooltip(tooltip => tooltip
                        .Visible(true)
                        .Format("{0:N0}")
                        )
                        .ChartArea(chartArea=>chartArea.Width(1100))
                    .Events(e => e.SeriesClick("OnNDCSeriesClickEvent"))
                    .HtmlAttributes(new { style = "width:100%;" })
                )
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="col-md-12 k-grid-content">
                
                @(Html.Kendo().Grid<NA.PMS.Model.NDCVeiwModel>()
                    .Name("GridDemandAndNDC")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.Department).Title("Department").ClientFooterTemplate("Total Count:");
                        columns.Bound(c => c.NDCCount).Title("NDC Letter").ClientFooterTemplate("#=sum#");
                        columns.Bound(c => c.DemandCount).Title("Demand Letter").ClientFooterTemplate("#=sum#");
                    })
                    .Resizable(resize => resize.Columns(true)).AutoBind(true)
                    .DataSource
                    (
                        dataSource => dataSource
                        .Ajax().ServerOperation(true)
                        .Read(read => read.Action("GetDemandAndNDCListByDepartmentAsDataSource", "Authority", new { area = "Member" }).Data("FilterDateForNDC"))
                        .Aggregates(aggregates =>
                        {
                            aggregates.Add(p => p.NDCCount).Sum();
                            aggregates.Add(p => p.DemandCount).Sum();
                        })
                    ))
            </div>

        </div>
    </div>
</div>
<script>

    $(document).ready(function () {
        var startdate = new Date("2018/11/01");
        $('#DTStartDate').data("kendoDatePicker").value(startdate);
        $('#DTEndDate').data("kendoDatePicker").value('@DateTime.Now');

        //GetDemandAndNDCListForGraph();
        //CreateBarGraphForServices();
    });

    //$(document).bind("kendo:skinChange", GetDemandAndNDCListForGraph());

    function FilterDateForNDC() {
        return{
            StartDate: $('#DTStartDate').val(),
            EndDate: $('#DTEndDate').val()
        }        
    }

    function DTStartDateChangeEvent() {
        GetDemandAndNDCListForGraph();
        $('#GridDemandAndNDC').data("kendoGrid").dataSource.read();
        $('#DemandNDCchart').data("kendoChart").dataSource.read();
    }

    function CreatePieChartForDemandAndNDC(GraphData) {
        $("#DivDemandNDCPieChart").kendoChart({
            title: {
                text: "NDC Letter Generated by Department "
            },
            legend: {
                //position: "bottom"
                visible: false
            },
            dataSource: {
                data: GraphData
            },
            seriesDefaults: {
                labels: {
                    visible: true,
                    background: "transparent",
                    template: "#= category #: \n #= value#"
                }
            },
            series: [{
                type: "pie",
                field: "NDCCount",
                categoryField: "Department"
            }],
            seriesColors: ["#03a9f4", "#ff9800", "#fad84a", "#4caf50", "#FF0000", "#FF00FF", "#000080"],
            tooltip: {
                visible: true,
                template: "#= category #: \n #= value#"
            },
            seriesClick: onNDCPieChartSeriesClick,
        });
    }

    function CreatePieChartForDemand(GraphData) {
        $("#DivDemandPieChart").kendoChart({
            title: {
                text: "Demand Letter Generated by Department "
            },
            legend: {
                //position: "bottom"
                visible: false
            },
            dataSource: {
                data: GraphData
            },
            seriesDefaults: {
                labels: {
                    visible: true,
                    background: "transparent",
                    template: "#= category #: \n #= value#"
                }
            },
            series: [{
                type: "pie",
                field: "DemandCount",
                categoryField: "Department"
            }],
            seriesColors: ["#03a9f4", "#ff9800", "#fad84a", "#4caf50", "#FF0000", "#FF00FF", "#000080"],
            tooltip: {
                visible: true,
                template: "#= category #: \n #= value#"
            },
            seriesClick: onDemandPieChartSeriesClick,
        });
    }
    //$(document).bind("kendo:skinChange", GetServiceListForGraph());

    function GetDemandAndNDCListForGraph() {
        var startDate = $('#DTStartDate').val();
        var endDate = $('#DTEndDate').val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ DepartmentId: 1, StartDate: startDate, EndDate: endDate }),
            url: '/Member/Authority/GetNDCAndDemandReportsForGraph',
            success: function (result) {
                if (result != null) {
                    CreatePieChartForDemandAndNDC(result);
                    CreatePieChartForDemand(result);
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Network error, Please try again later.");
            }
        });
    }

    function OnNDCSeriesClickEvent(e) {
        //alert(kendo.format("Series click :{0} ({1}): {2}", e.series.field, e.category, e.value));
        //window.location.href = "/Reports/Report/ManageNDC";
    }

    function onNDCPieChartSeriesClick(e) {
        //var id = e.category == "Institutional" ? 1 : (e.category == "Commercial" ? 2 : (e.category == "Residential" ? 3 : (e.category == "Industrial" ? 4 : (e.category == "Housing" ? 5 : (e.category == "GroupHousing" ? 6 : (e.category == "Village" ? 7 : null))))))
        //window.location.href = "/Reports/Report/RedirectToDemandAndNDC?filter=ndc&" + "id=" + id;
        var dept = e.category;
        var startdate = $('#DTStartDate').val();
        var enddate = $('#DTEndDate').val();
        window.location.href = "/Reports/Report/NDC?department=" + e.category + "&startDate=" + startdate + "&endDate=" + enddate;
    }

    function onDemandPieChartSeriesClick(e) {
        //var id = e.category == "Institutional" ? 1 : (e.category == "Commercial" ? 2 : (e.category == "Residential" ? 3 : (e.category == "Industrial" ? 4 : (e.category == "Housing" ? 5 : (e.category == "GroupHousing" ? 6 : (e.category == "Village" ? 7 : null))))))
        //window.location.href = "/Reports/Report/RedirectToDemandAndNDC?filter=demand&" + "id=" + id;
        var dept = e.category;
        var startdate = $('#DTStartDate').val();
        var enddate = $('#DTEndDate').val();
        window.location.href = "/Reports/Report/Demand?department=" + e.category + "&startDate=" + startdate + "&endDate=" + enddate;
    }
</script>








