                    }
                    if (size / 1024 > 5) {
                        alertify.error(FileNoCount + " " + FileName + " Max 5Mb file size is allowed");
                        return flag = false;;
                    }
                }
                else {
                    alertify.error("Please upload documents.");
                    return flag = false;;
                }
            }
        }
        else {
            alertify.alert("Upload Documents", "No file found to upload.");
            return flag;
        }
        return flag;
    }

