<script type="text/javascript">

    $(document).ready(function () {
        ChangeService();
        var _status = '@Model.ServiceModel.StatusId';
        if (_status == '10') {
            GetFileUploadOption_Objection();

    }

        $('#divDocumentView').kendoWindow({
            modal: true,
            title: "Document",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "15%"
            },
            width: "70%", height: "80%"
        });

        $('.divPopupWindow').kendoWindow({
            modal: true,
            title: "Validate Service Request",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "15%"
            },
            width: "40%"
        });


        $("#btnSubmit").click(function () {
            var files = $(".single");
            if (CheckFileToUpload()) {
                if (CheckFileSize(files)) {
                    $("#btnSubmit").submit();
                    return true;
                } else { return false; }
            } else { return false; }

        });



        $('#btn-approve-hod').click(function () {
            $(".divPopupWindow").data("kendoWindow").center();
            $(".divPopupWindow").data("kendoWindow").open();
            $(".divPopupWindow").data("kendoWindow").pin();
        });

        $('#btn-approve-asst').click(function () {
            $(".divPopupWindow").data("kendoWindow").center();
            $(".divPopupWindow").data("kendoWindow").open();
            $(".divPopupWindow").data("kendoWindow").pin();
        });

        $('#btnStatusClose').click(function () {
            $(".divPopupWindow").data("kendoWindow").close();
        });

        $('#btnStatusSubmit').click(function () {
            UpdateServiceStatus();
        });

        $("#btn-cancel").click(function () {
            window.location.href = "/Member/ServiceRequest/Manage";
        });

        if ($('#hdn-status-id').val() == '@NAStatusId.Forwarded') {
            $('#btn-approve-asst').val("Cancel/Complete");
        }
        else if (($('#hdn-status-id').val() == '@NAStatusId.Completed') || ($('#hdn-status-id').val() == '@NAStatusId.Cancelled')) {
            $('#btn-approve-asst').css("display", "none");
            $('#btn-approve-hod').css("display", "none");
        }



        $('#btn-back-nic').click(function () {
            var cid = $("input[name = 'SWPPostModel.TxtControlID']").val();
            var uid = $("input[name = 'SWPPostModel.TxtUnitID']").val();
            var sid = $("input[name = 'SWPPostModel.TxtServiceID']").val();
            var rid = $("input[name = 'SWPPostModel.TxtApplicationID']").val();
            
            var postmodel = {
                TxtControlID: $("input[name = 'SWPPostModel.TxtControlID']").val(),
                TxtUnitID: $("input[name = 'SWPPostModel.TxtUnitID']").val(),
                TxtServiceID: $("input[name = 'SWPPostModel.TxtServiceID']").val(),
                TxtApplicationID: $("input[name = 'SWPPostModel.TxtApplicationID']").val(),
                TxtDepartmentID: "22"
            };
             $.ajax({
                 type: 'POST',
                 dataType: 'json',
                 data: { model: postmodel },
                 url: '/NIC/NiveshMitra/GetEncryptedNicPostDetail',
                 success: function (result) {
                     if (result != null) {
                         //$.post("http://72.167.225.87/testing_nmswp/nmmasters/Entrepreneur_Bck_page.aspx", { TxtDept_Code: result.TxtDepartmentID, TxtControlID: result.TxtControlID, TxtUnitID: result.TxtUnitID, TxtServiceID: result.TxtServiceID, TxtPassSalt: result.PassSalt },{Type: "POST"});
                         //$.post("http://72.167.225.87/testing_nmswp/nmmasters/Entrepreneur_Bck_page.aspx?Dept_Code:"+ result.TxtDepartmentID + "&ControlID:"+ result.TxtControlID+"&UnitID:"+ result.TxtUnitID+ "&ServiceID:"+ result.TxtServiceID+"&PassSalt:"+ result.PassSalt);
                         //$('#TxtDept_Code').val(result.TxtDepartmentID);
                         //$('#TxtControlID').val(result.TxtControlID);
                         //$('#TxtUnitID').val(result.TxtUnitID);
                         //$('#TxtServiceID').val(result.TxtServiceID);
                         //$('#TxtPassSalt').val(result.PassSalt);
                         //$('#NICBackForm').submit();
                         $('#divbackNiveshMitraPortal').append('<form action="'+ result.SWPBackUrl +'" method="POST" id="nicbackform">'
