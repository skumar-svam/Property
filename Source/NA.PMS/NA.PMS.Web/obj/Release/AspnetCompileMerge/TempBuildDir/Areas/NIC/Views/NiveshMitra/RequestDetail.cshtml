@model NA.PMS.NICServices.SWPServicesViewModel
@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions;
@using NA.PMS.Common;
@using NA.PMS.Web.Models

@{
    ViewBag.Title = "Request Detail";
    Layout = "~/Areas/NIC/Views/Shared/_Layout.cshtml";
}

<style>
    .row-approver {
        display: none;
    }

    .doc {
        display: none;
    }

    #divStatusMaster {
        display: none;
    }


    .msg-red {
        color: red;
    }
     .col-md-3.col-20{
        width:20% !important;
    }
    .col-md-3.col-30{
        width:30% !important;
    }
    .col-80.form-group{
        width:80%;
    }
    .col-md-3.col-lbl-sn{
        width:20% !important;
    }
    .col-md-6.col-lbl{
        width:60% !important;
    }
    .col-md-3.col-lbl-vl{
         width:20% !important;
    }
    .btn {
        min-width : 110px;
        border-radius: 0 !important;
        /*box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);*/
    }
</style>

<div class="col-lg-12 col-md-12 col-sm-12 nic-portal" data-nic="services">
   
    <div class="col-md-12" style="position:static">
        <div class="row rw-spce" style="margin-top:10px;margin-bottom:10px;">
            <div class="col-md-6 col-sm-6 col-xs-12">
                <h1 class="gridTitle">Request Detail [@Html.DisplayFor(model => model.ServiceModel.RequestStatus)]</h1>
                @{ <small class="msg-red">@Model.ServiceModel.StatusMessage</small> }
            </div>
            <div class="col-md-6 col-sm-6 col-xs-12" style="text-align:right;">
               
                <input type="button" id="btnAcknowledgement" value="Acknowledgement" class="btn btn-add" data-toggle="modal" data-target="#divAcknowledgementModal" />
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 content-top-spce">
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading" style="margin-bottom:5px;">Applicant Information</h2>
            <div class="form-bx">
                <div class="row" style="display:none">
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group"></div>
                    <div class="col-md-6 col-sm-6 col-xs-12 form-group" id="divRequestService">
                        <input type="radio" id="rbtnRegistered" name="RegistrationType" value="Registered" checked="checked">&nbsp;Registered &nbsp;&nbsp;
                        <input type="radio" id="rbtnUnRegistered" name="RegistrationType" value="UnRegistered" />&nbsp;UnRegistered
                        <input type="radio" id="rbtnOther" name="RegistrationType" value="Other" />&nbsp;Samadhan Diwas
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.HiddenFor(model => model.SWPPostModel.TxtControlID)
                        @Html.HiddenFor(model => model.SWPPostModel.TxtUnitID)
                        @Html.HiddenFor(model => model.SWPPostModel.TxtServiceID)
                        @Html.HiddenFor(model => model.SWPPostModel.TxtApplicationID)
                        @Html.HiddenFor(model => model.SWPPostModel.TxtProcessIndustryID)
                        @Html.HiddenFor(model => model.SWPPostModel.TxtRequestID)

                        @Html.HiddenFor(model => model.ServiceId)
                        @Html.HiddenFor(model => model.ServiceModel.RequestStatus)
                        @Html.HiddenFor(model => model.ServiceModel.RequestId)
                        @Html.HiddenFor(model => model.ServiceModel.DepartmentId)
                        @Html.HiddenFor(model => model.ServiceModel.SubDepartmentId)
                        @Html.HiddenFor(model => model.ServiceModel.ServiceId)
                        @Html.HiddenFor(model => model.ServiceModel.Sector)
                        @Html.HiddenFor(model => model.ServiceModel.Block)
                        @Html.HiddenFor(model => model.ServiceModel.PlotNo)
                        @Html.HiddenFor(model => model.ServiceModel.StatusId, htmlAttributes: new { @id = "hdn-status-id" })
                        @Html.HiddenFor(model => model.ServiceModel.RequestStatus)
                    </div>
                </div>
               
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                        <label class=""> Registration Id </label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                        @Html.TextBoxFor(model => model.ServiceModel.RegistrationId, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                        <label>Service Request Id</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                        @Html.TextBoxFor(model => model.ServiceModel.Id, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                        <label class=""> Property No </label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                        @Html.TextBoxFor(model => model.ServiceModel.PropertyNo, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                        <label class=" ">  Department </label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                        @Html.TextBoxFor(model => model.ServiceModel.Department, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                        <label class=" "> Services </label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                        @Html.TextBoxFor(model => model.ServiceModel.ServiceName, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                        <label class="">Sub Department </label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                        @Html.TextBoxFor(model => model.ServiceModel.SubDepartment, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                        <label class=" ">Allottee Name</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                        @Html.TextAreaFor(model => model.ServiceModel.Applicant, htmlAttributes: new { @class = "form-control", @readonly = "readonly", style = "height: 30px;" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                        <label class=" ">Requestor Name </label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                        @Html.TextAreaFor(model => model.ServiceModel.Requestor, htmlAttributes: new { @class = "form-control", @readonly = "readonly", style = "height: 30px;" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                        <label class=" "> Allottee Address </label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                        @Html.TextAreaFor(model => model.ServiceModel.ApplicantAddress, htmlAttributes: new { @class = "form-control", @readonly = "readonly", style = "height: 30px;" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                        <label class=" "> Requestor Address </label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                        @Html.TextAreaFor(model => model.ServiceModel.RequestorAddress, htmlAttributes: new { @class = "form-control", @readonly = "readonly", style = "height: 30px;" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                        <label class=" "> Mobile No </label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                        @Html.TextBoxFor(model => model.ServiceModel.MobileNo, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                        <label class="">  Email ID </label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                        @Html.TextBoxFor(model => model.ServiceModel.Email, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                        <label class=" ">NIC Request Id </label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                        @Html.TextBoxFor(model => model.ServiceModel.NICRequestId, htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-20 form-group">
                        @if (Model.ServiceModel.ResubmitDate != null)
                        {
                            <label class="">Resubmit Date</label>
                        }
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-30 form-group">
                        @if (Model.ServiceModel.ResubmitDate != null)
                        {
                            @(Html.Kendo().DatePickerFor(model => model.ServiceModel.ResubmitDate).HtmlAttributes(new { style = "width:100%;", @class = "input-disabled" }))
                        }
                    </div>
                </div>


                <div id="div-extension">
                    @{Html.RenderPartial("_PartialExtensionRequest");}
                </div>

                <div id="div-transfer">
                    @{Html.RenderPartial("_PartialTransferRequest");}
                </div>

                <div id="div-cic">
                    @{Html.RenderPartial("_PartialCICRequest");}
                </div>

                <div id="div-mortgage">
                    @{Html.RenderPartial("_PartialMortgageRequest");}
                </div>

                <div id="div-mutation">
                    @{Html.RenderPartial("_PartialMutationRequest");}
                </div>

                <div id="div-gpa">
                    @{Html.RenderPartial("_PartialGPARequest");}
                </div>

                <div id="div-rent">
                    @{Html.RenderPartial("_PartialRentRequest");}
                </div>

                <div class="row" id="divDescription">
                    <div class="col-md-3 col-sm-12 col-xs-12 col-20 form-group">
                        <label>Description</label>
                    </div>
                    <div class="col-md-9 col-sm-12 col-xs-12 col-80 form-group">
                        @Html.TextAreaFor(model => model.ServiceModel.Description, htmlAttributes: new { @class = "form-control", @readonly = "readonly", style = "height: 30px;" })
                    </div>
                </div>
                <div class="row" id="divPendencyLevel">
                    <div class="col-md-3 col-sm-12 col-xs-12 col-20 form-group">
                        <label>Current Pendency Level</label>
                    </div>
                    <div class="col-md-9 col-sm-12 col-xs-12 col-80 form-group">
                        @Html.TextAreaFor(model => model.ServiceModel.PendencyLevel, htmlAttributes: new { @class = "form-control", @readonly = "readonly", style = "height: 30px;" })
                    </div>
                </div>
                <div class="row" style="padding-left:30px;">
                    <div class="col-md-12 k-grid-content">
                        @(Html.Kendo().Grid<NA.PMS.NICServices.SWPDocumentViewModel>()
                            .Name("gridDocs")
                            .Columns(columns =>
                            {
                                columns.Bound(c => c.Id).Title("S.No.").Width(60).ClientTemplate("# if (DocumentName != null) {#<a onclick='javascript:OpenDocument(this);' class='hyperlink'>#=Id#</a>#}else {#<span>#=Id#</span>#} #").Filterable(false);
                                columns.Bound(c => c.DocumentName).Title("Document Uploaded").ClientTemplate("# if (DocumentName != null) {#<a onclick='javascript:OpenDocument(this);' class='hyperlink'>#=DocumentName#</a>#}else {#<span>---</span>#} #").Filterable(false);
                                columns.Bound(c => c.DocumentPath).Hidden(true);
                            })
                            .Resizable(resize => resize.Columns(true))
                            .AutoBind(true)
                            .DataSource(dataSource => dataSource
                                    .Ajax().ServerOperation(true)
                                    .Model(model => model.Id(c => c.Id))
                                    .Read(read => read.Action("GetServiceRequestDocumentsById", "NiveshMitra", new { Area = "NIC" }).Data("FilterRequestId2"))
                            )
                            .Events(e => e.DataBound("dataBound"))
                        )
                    </div>
                </div>
                <div class="row" style="padding-left:20px;">
                    @{
                        <br />
                        <span class="msg-red">Note:- @Model.ServiceModel.StatusMessage</span>
                    }
                </div>
                <div class="row">
                    <div class="col-md-12 form-group" style="text-align:right">
                        @{
                            if (Model.ServiceModel.StatusId == NAStatusId.Objection)
                            {
                                using (Html.BeginForm("ReSubmitRequest", "NiveshMitra", FormMethod.Post, new { id = "ReSubmitRequestForm", name = "ReSubmitRequestForm", enctype = "multipart/form-data" }))
                                {
                                <div class="row">
                                    <input type="hidden" value="@Model.ServiceModel.RequestId" id="OnlineRequestId" name="OnlineRequestId" />

                                    <div class="col-md-12" id="file-option" style="padding:0 0 10px 0px;"></div>
                                </div>

                                <input type="submit" id="btn-re-submit" value="Re-Submit" class="btn btn-primary" style="min-width:100px; margin-right:12px;border-radius:0;" />
                                <input type="button" id="btn-cancel" value="Back" class="btn btn-primary" style="width:100px; margin-right:12px;border-radius:0;" />
                                }

                            }
                        }

                        @*<input type="button" id="btn-back-nic" value="Back To NIC" class="btn btn-primary" style="min-width:100px; margin-right:12px;border-radius:0;" />*@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="divAcknowledgementModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" style="width: 65%">
        <div class="modal-content" style="border-radius:0;background:url(/Content/Images/boxed-bg.jpg) repeat;">
            <div class="modal-header" style="padding:6px">
                <h4 class="modal-title">  <b>Service Request Acknowledgement</b></h4>
            </div>
            <div class="modal-body" id="divAcknowledgementReceiptBody" style="overflow:auto;height:420px;">
                <div class="row">
                    <div class="col-md-12">
                        <h2 style="text-align:center;padding:0;margin-bottom:4px;">NEW OKHLA INDUSTRIAL DEVELOPMENT AUTHORITY</h2>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <h4 style="text-align:center;padding:0;margin-bottom:4px;">Sector-6 Administrator Office, NOIDA</h4>
                    </div>
                </div>
                <div class="row ">
                    <div class="col-md-12">
                        <h5 style="text-align:center;padding:0;margin-top:4px;">Nivesh Mitra - Acknowledgement Receipt</h5>
                    </div>
                </div>
                <div class="row rw-pad">
                    <div class="col-md-12">
                        <span style="width:50%;text-align:right;float:right"> <b>Date: @Model.ServiceModel.CreatedDate.Value.ToString("dd-MMM-yyyy")</b></span>
                    </div>
                </div>
                <div class="row rw-pad">
                    <div class="col-md-12">
                        <span style="width:70%;float:left"><b> Acknowledgement No: &nbsp;NIC-@Model.ServiceModel.RequestId</b></span>
                        @{
                            if (Model.ServiceModel.RegistrationNo != null && Model.ServiceModel.RegistrationNo != "")
                            {
                                <span style="width:30%;text-align:right;float:right"><b> Registration No: &nbsp;@Model.ServiceModel.RegistrationNo</b></span>
                            }
                        }
                    </div>
                </div>
                <div class="row rw-pad">
                    <div class="col-md-12">
                        <span style="width:70%;float:left"><b> Applicant Name: &nbsp;@Model.ServiceModel.Applicant</b></span>
                        <span style="width:30%;text-align:right;float:right"><b>Property No: &nbsp;@Model.ServiceModel.PropertyNo</b></span>
                    </div>
                </div>
                <div class="row rw-pad">
                    <div class="col-md-12">
                        <span style="width:70%;float:left"><b> Department: &nbsp;@Model.ServiceModel.Department</b> &nbsp;&nbsp;( @Model.ServiceModel.SubDepartment )</span>
                        <span style="width:30%;text-align:right;float:right"><b>Mobile No.: &nbsp;@Model.ServiceModel.MobileNo</b></span>
                    </div>
                </div>
                <div class="row rw-pad">
                    <div class="col-md-12">
                        @{
                            <b> Request Type: &nbsp;@Model.ServiceModel.ServiceName</b>
                        }
                    </div>
                </div>
                <div class="row rw-pad">
                    <div class="col-md-12">
                        @{
                            <b> Subject: &nbsp;<label id="lblDescription">@Model.ServiceModel.Description</label> </b>
                        }
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12" style="text-align:justify;text-justify:inter-word">
                        <p>
                            <b> Note:</b> The information provided in application shall be validated against the available information with the department.
                            In case where addition information like payment info addition supporting document etc.is required, the same shall be communicated on registered
                            mobile number and mail You can also track the status of service request on <b> http://www.mynoida.in </b>,Please quote this service request number for any
                            communication regarding the application.
                        </p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <b>
                            Thanks for using services online.<br />
                            Your Thankfully<br />
                            NOIDA
                        </b>
                    </div>
                </div>
            </div>
            <div style="page-break-after: always;"></div>
            <div class="modal-footer" style="text-align: center;padding:6px;">
                <button type="submit" id="btnPrintDiv" class="k-button" onclick="PrintDiv();">Print</button>
                <button type="submit" id="btnNext" class="k-button" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<div id="divDocumentView" style="overflow:hidden">
    <div class="row  no-margin no-padding">
        <div class="col-md-12 no-margin no-padding" id="divPageView" style="overflow:hidden">
            <iframe id="ifrmViewPdf"></iframe>
        </div>
    </div>
</div>

