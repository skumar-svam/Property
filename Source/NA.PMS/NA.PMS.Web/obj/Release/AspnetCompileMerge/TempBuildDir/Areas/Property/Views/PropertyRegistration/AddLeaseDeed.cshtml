            //    return false;
            //}
            

            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ rId: rId }),
                url: '/PropertyRegistration/IsChecklistGenerated',
                success: function (result) {
                    if (result == true) {
                        $.ajax({
                            dataType: 'json',
                            type: 'Post',
                            contentType: 'application/json; charset=utf-8',
                            data: JSON.stringify({ rId: rId, LDExecDate: LDExecDate, SA: SA, w1N: w1N, w1A: w1A, w1M: w1M, w2N: w2N, w2A: w2A, w2M: w2M, w3N: w3N, w3A: w3A, w3M: w3M, w4N: w4N, w4A: w4A, w4M: w4M, LDDueDate: LDDueDate, regType: regType, SDAmt: SDAmt, DSDAmt: DSDAmt, prevDues: prevDues, balDueTD: balDueTD, viewName: viewName, type: type, docCharges: docCharges }),
                            url: '/PropertyRegistration/SaveLeaseDeedDetails',
                            success: function (result1) {
                                if (result1 == true) {
                                    alertify.success("Lease Deed details added successfully.");
                                    window.location.href = '@Url.Action("ManageLeaseDeed", "PropertyRegistration")';
