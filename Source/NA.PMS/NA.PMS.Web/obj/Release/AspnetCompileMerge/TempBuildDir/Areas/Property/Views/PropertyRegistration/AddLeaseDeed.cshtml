    function RIdChange() {
        $('#btnAdd').removeAttr('disabled');
        var rId = $("#RId").val();
        $("#LeaseDeedExecutionDate").data("kendoDatePicker").value('');
        $("#lblSDA").html('');
        $("#lblDSV").html('');
        if (rId == '') {
            ClearValues();
            $("#LeaseDeedExecutionDate").data("kendoDatePicker").value('');
            $("#lblSDA").html('');
            $("#lblDSV").html('');
            alertify.error("Please select an RID");
            return false;
        }
        //GetKYADetails(rId);
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rId: rId }),
            url: '/PropertyRegistration/GetDetailsByRID',
            success: function (result) {
                if (result != null) {
                    if (result.ChecklistDate == null || result.ChecklistDate == '') {
                        ClearValues();
                        alertify.error("Please generate Checklist before adding Lease Deed.");
                        var dropdownlist = $("#RId").data("kendoDropDownList").value("");
                        $('#btnAdd').removeAttr('disabled');
                        return false;
                    }
                    else {
                        $("#lblAN").html(result.AllotteName);
                        if (result.Gender.toLowerCase() != "company".toLowerCase()) {
                            $("#lblFatherName").show();
                            $("#lblfaN").show();
                            $("#lblFN").html(result.FatherName);
                        }
                        else {
                            //alert($("#lblFN").html());
                            $("#lblFatherName").hide();
                            $("#lblFN").html('');
                            $("#lblfaN").hide();
                        }
                        $("#lblDeptt").html(result.DepttName);
                        $("#lblPT").html(result.PropType);
                        $("#lblPN").html(result.PropNo);
                        $("#lblPC").html(result.PropCost);
                        $("#lblPD").html(result.PreviousDues);
                        $("#lblBDD").html(result.BalanceDues);
                        $("#lblRT").html(result.RegistryType);
                        $("#LeaseDeedDueDate").data("kendoDatePicker").value(result.LeaseDeedDueDate);
                        $("#AllotmentDate").data("kendoDatePicker").value(result.AllotmentDate);
                        $("#ChckLstDate").data("kendoDatePicker").value(result.ChecklistDate);
                        //$("#AllotmentDate").val(result.AllotmentDate);
                        //$("#hdnPropType").val(result.PropTypeVal);
                    }
                }
                else {
                    ClearValues();
                    alertify.error("Some error occurred. Please try again later.");
                }
            },
            error: function (obj) {
                //ClearValues();
                alertify.error("Some error occurred. Please try again later.");
            }
        });
    }

    function GetKYADetails(rId) {
        //var rId = $("#RId").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ RegistrationId: rId }),
            url: '/Property/PropertyRegistration/GetKYADetailsForRid',
            success: function (result) {
                if (result != null) {
                    if (result.StatusId == "2") {
                        alertify.error("Your KYA has been Rejected. Please Complete your KYA again.");
                        $('#btnAdd').attr('disabled', 'disabled');
                        return false;
                    }
                    else if (result.StatusId == "" || result.StatusId == null) {
                        alertify.error("Please Complete your KYA.");
                        $('#btnAdd').prop('disabled', true);
                        return false;
                    }
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }
        });
    }

    function ClearValues() {
        $("#lblAN").html('');
        $("#lblFN").html('');
        $("#lblDeptt").html('');
        $("#lblPT").html('');
        $("#lblPN").html('');
        $("#lblPC").html('');
        $("#lblPD").html('');
        $("#lblBDD").html('');
        $("#lblRT").html('');
        $("#LeaseDeedDueDate").data("kendoDatePicker").value('');
        $("#AllotmentDate").data("kendoDatePicker").value('');
        $("#ChckLstDate").data("kendoDatePicker").value('');
    }

    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }
</script>
