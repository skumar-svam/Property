@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions;
@model NA.PMS.Model.LeaseDeedProperty
@{
    ViewBag.Title = "Add Lease Deed";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="row">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Add Lease Deed</h1></div>
                <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">

                <h2 class="blck-heading">Select Registration Id</h2>

                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">@Html.Label("Registration Id", htmlAttributes: new { @class = "required" })</div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(po => po.RId)
                    .Filter("contains")
                    .DataTextField("text")
                    .DataValueField("id")
                    .OptionLabel("Select")
                                    //.AutoBind(false)
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport =>
                        {
                            transport.Read("GetRIDsForLeaseDeed", "PropertyRegistration");
                        }).Schema(schema =>
                        {
                            schema.Data("Data")
                            .Total("Total");
                        }).PageSize(100);
                    })
                    .Events(events => { events.Change("RIdChange"); })
             .HtmlAttributes(new { style = "width:100%", @class = "schemeForms" })
                            )
                            @Html.HiddenFor(po => po.ViewName)
                            @Html.HiddenFor(po => po.Type)
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Document Charges", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().NumericTextBoxFor(trans => trans.DocCharges)
                            .Name("DocCharges")
                            .Min(0)
                            .Max(9999999999999)
                            .Spinners(false).Step(0)
                    .Enable(true)
                    .HtmlAttributes(new { style = "width: 100%", @maxlength = "13", @class = "k-label schemeForms textBoxValueRightAlign" })
                            )
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">@Html.Label("Lease Deed Execution Date", htmlAttributes: new { @class = "required" })</div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
