<script type="text/javascript">
    $(document).ready(function () {
        $('#LeaseDeedDueDate').data('kendoDatePicker').enable(false);
        $("#hdnDiv").hide();
        $("#ViewName").val("AddLeaseDeed");

        ////Hiding Witness div on Page Load
        //$("#divWitness").hide();

        ////Change event of "Witness" radio buttons
        //$('input[type=radio][name=witness]').change(function () {
        //    if (this.value == 'Yes') {
        //        //$("#divWitness").show();
        //        $("#divWitness").fadeIn();
        //    }
        //    else if (this.value == 'No') {
        //        //$("#divWitness").hide();
        //        $("#divWitness").fadeOut();
        //    }
        //});

        $("#btnBack").click(function () {
            window.location.href = '@Url.Action("ManageLeaseDeed", "PropertyRegistration")';
        });

        $('#LeaseDeedExecutionDate').change(function () {
            var rId = $("#RId").val();
            var LDExecDate = $('#LeaseDeedExecutionDate').val();
            if (rId == '') {
                ClearValues();
                alertify.error("Please select an RID");
                $("#LeaseDeedExecutionDate").data("kendoDatePicker").value('');
                $("#lblSDA").html('');
                $("#lblDSV").html('');
                return false;
            }
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ rId: rId, LDExecDate: LDExecDate }),
                url: '/PropertyRegistration/GetStampDetailsByLeaseExcutionDate',
                success: function (result) {
                    if (result != null) {
                        if (result.StampDutyAmount == null) {
                            $("#lblSDA").html('@NA.PMS.Common.Constants.NA');
                            alertify.error("Allotment Money has not been paid for this RID.");
                            $("#btnAdd").attr('disabled', 'disabled');
                        }
                        else {
                            $("#lblSDA").html(result.StampDutyAmount);
                        }
                        $("#lblDSV").html(result.DuplicateStampValue);
                    }
                    else {
                        ClearValues();
                        alertify.error("Some error occurred. Please try again later.");
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //alert(respText);
                    //alertify.error("Some error occurred. Please try again later.");
                }
            });
        });

        $("#btnAdd").click(function () {
            $("#btnAdd").attr('disabled', 'disabled');
            var rId = $("#RId").val();
            var LDExecDate = $('#LeaseDeedExecutionDate').val();
            var chLiDate = $("#ChckLstDate").val();
            var SA = $("#SignatoryAuthority").val().trim();
            var w1N = $("#Witness1Name").val().trim();
            var w1A = $("#Witness1Add").val().trim();
            var w1M = $("#Witness1Mob").val().trim();
            var w2N = $("#Witness2Name").val().trim();
            var w2A = $("#Witness2Add").val().trim();
            var w2M = $("#Witness2Mob").val().trim();
            var w3N = $("#Witness3Name").val().trim();
            var w3A = $("#Witness3Add").val().trim();
            var w3M = $("#Witness3Mob").val().trim();
            var w4N = $("#Witness4Name").val().trim();
            var w4A = $("#Witness4Add").val().trim();
            var w4M = $("#Witness4Mob").val().trim();
            var docCharges = $("#DocCharges").val();
            //Fixed Bug#131
            var LDDueDate = $("#LeaseDeedDueDate").data("kendoDatePicker").value();
            var allotmentDate = $("#AllotmentDate").data("kendoDatePicker").value();
            var regType = $("#lblRT").html();
            var SDAmt = $("#lblSDA").html();
            var DSDAmt = $("#lblDSV").html();
            var prevDues = parseFloat($("#lblPD").html());
            var balDueTD = parseFloat($("#lblBDD").html());

            var dtLDExecDate = new Date(LDExecDate);
            var dtAllotmentDate = new Date(allotmentDate);            
            if (chLiDate != "") {
                var dtChLiDate = new Date(chLiDate);
            }

            var viewName = $("#ViewName").val();
            var type = $("#Type").val();
            if (rId == '') {
                ClearValues();
                alertify.error("Please select an RID");
                $('#btnAdd').removeAttr('disabled');
                return false;
            }
            if (LDExecDate == '') {
                alertify.error("Please enter Lease Deed Execution Date");
                $('#btnAdd').removeAttr('disabled');
                return false;
            }
            if (docCharges == '') {
                alertify.error("Please enter Document Charges");
                $('#btnAdd').removeAttr('disabled');
                return false;
            }
            if (SDAmt == '@NA.PMS.Common.Constants.NA') {
                alertify.error("Allotment Money has not been paid for this RID.");
                //$('#btnAdd').removeAttr('disabled');
                return false;
            }
            if (SA == '') {
                alertify.error("Please enter Signatory Authority");
                $('#btnAdd').removeAttr('disabled');
                return false;
            }
            if (!/^[a-zA-Z ]*$/g.test(SA)) {
                alertify.error("Authorized Signatory should contain only alphabets and spaces");
                $('#btnAdd').removeAttr('disabled');
                return false;
            }
            if (w1N == '') {
                alertify.error("Please enter Witness 1 Name");
                $('#btnAdd').removeAttr('disabled');
                return false;
            }
            if (w1A == '') {
                alertify.error("Please enter Witness 1 Address");
                $('#btnAdd').removeAttr('disabled');
                return false;
            }
            //if (w1M == '') {
            //    alertify.error("Please enter Witness 1 Mobile No.");
            //    $('#btnAdd').removeAttr('disabled');
            //    return false;
            //}
            if (w1M != '' && w1M.length < 10) {
                alertify.error("Please enter correct Witness 1 Mobile No.");
                $('#btnAdd').removeAttr('disabled');
                return false;
            }
            if (w2N == '') {
                alertify.error("Please enter Witness 2 Name");
                $('#btnAdd').removeAttr('disabled');
                return false;
            }
            if (w2A == '') {
                alertify.error("Please enter Witness 2 Address");
                $('#btnAdd').removeAttr('disabled');
                return false;
            }
            //if (w2M == '') {
            //    alertify.error("Please enter Witness 2 Mobile No.");
            //    $('#btnAdd').removeAttr('disabled');
            //    return false;
            //}
            if (w2M != '' && w2M.length < 10) {
                alertify.error("Please enter correct Witness 2 Mobile No.");
                $('#btnAdd').removeAttr('disabled');
                return false;
            }
            if (w3M != '' && w3M.length < 10) {
                alertify.error("Please enter correct Witness 3 Mobile No.");
                $('#btnAdd').removeAttr('disabled');
                return false;
            }
            if (w4M != '' && w4M.length < 10) {
                alertify.error("Please enter correct Witness 4 Mobile No.");
                $('#btnAdd').removeAttr('disabled');
                return false;
            }
            if (!/^[a-zA-Z ]*$/g.test(w1N)) {
                alertify.error("Witness 1 Name should contain only alphabets and spaces");
                $('#btnAdd').removeAttr('disabled');
                return false;
            }
            if (!/^[a-zA-Z ]*$/g.test(w2N)) {
                alertify.error("Witness 2 Name should contain only alphabets and spaces");
                $('#btnAdd').removeAttr('disabled');
                return false;
            }
            if (w3N != '') {
                if (!/^[a-zA-Z ]*$/g.test(w3N)) {
                    alertify.error("Witness 3 Name should contain only alphabets and spaces");
