            //Bug#199 - Resolved
            if (chLiDate != "") {
                if (dtLDExecDate < dtChLiDate) { //Removed equal to validation on 7th March 2017, as discussed with Vishal Shukla
                    alertify.error("Lease Deed Execution Date can't be earlier than Checklist Date");
                    $('#btnAdd').removeAttr('disabled');
                    return false;
                }
            }
            if (prevDues > 0 || balDueTD > 0) {
                alertify.error("Please clear your dues before executing Lease Deed.");
                $('#btnAdd').removeAttr('disabled');
