    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<MortgageModel>()
                .Name("gvMortgageServiceRequest")
                .Columns(columns =>
                {
                    columns.Bound(c => c.BankName).Title("Bank Name");
                    columns.Bound(c => c.PreviousLoanNoc).Title("Previous Loan Noc");
                    columns.Bound(c => c.BranchAddress).Title("Branch Address");
                    columns.Bound(c => c.SanctionedAmount).Title("Sanctioned Amount");
                    columns.Bound(c => c.MortgageType).Title("Mortgage Type");
                })
                .Sortable()
                .Filterable()
                .Pageable
                    (
                        pageable => pageable
                        .Enabled(true)
                        .PageSizes(true)
                     )
                .DataSource
                (
                     dataSource => dataSource
                    .Ajax().Model(model => model.Id(p => p.RID))
                    .ServerOperation(true)
                                            .Read(read => read.Action("GetMortgageServiceReqByRid", "CitizenRequests", new { area = "Member" }).Data("GetRid")).PageSize(20)
                 ).AutoBind(false)
        )
    </div>

