    function ApplicationFormIdChangeEvent() {
        var formId = $('#ApplicationFormId').val();
        if (formId != "") {
            $.ajax({
                type: 'POST',
                dataType: 'json',
                data: { ApplicationFormId: formId },
                url: '/NIC/NoidaAuthority/GetApplicationFormDetailByFormId',
                success: function (result) {
                    if (result != null) {
                        $('#ApplicantType').data("kendoDropDownList").value(result.ApplicantType);
                        //$('#CompanyTypeId').data("kendoDropDownList").value(result.CompanyTypeId);
                        $('#AreaRangeId').data("kendoDropDownList").value(result.AreaRangeId);
                        $('#ApplicationFormType').data("kendoDropDownList").value(result.ApplicationFormType);
                        $('#ExpansionType').data("kendoDropDownList").value(result.ExpansionType);
                        if (result.UserImage != null) {
                            $('#userphoto').attr("src", result.UserImage);
                            $('#userid').css("display", "none");
                            $('#userphoto').show();
                        }
                        if (result.SignImage != null) {
                            $('#signature').attr("src", result.SignImage);
                            $('#signatureid').css("display", "none");
                            $('#signature').show();
                        }
                        if (result.ApplicantType == "Company") {
                            $('#Applicant').val(result.Applicant);
                            $('#SigningAuthority').val(result.SigningAuthority);
                            $('#ApplicantMaster').val(result.ApplicantMaster);
                            //$('#CompanyTypeId').data("kendoDropDownList").value(result.CompanyTypeId);
                            $('#SigningAuthorityId').data("kendoDropDownList").value(result.SigningAuthorityId);
                            $('.row-company').show();
                            $('#divIndividualInfo').css("display","none");
                        }
                        else {
                            $('#FirstName').val(result.FirstName);
                            $('#MiddleName').val(result.MiddleName);
                            $('#LastName').val(result.LastName);
                            $('#Gender').data("kendoDropDownList").value(result.Gendger);
                            $('#FatherName').val(result.FatherName);
                            $('#MotherName').val(result.MotherName);
                            $('#DOB').data("kendoDatePicker").value(result.DOB);
                            $('#MaritalStatus').data("kendoDropDownList").value(result.MaritalStatus);
                            $('.row-company').css("display", "none");
                            $('#divIndividualInfo').show();
                        }

                        if (result.ExpansionType != null) {
                            ExpansionTypeChangeEvent();
                        }

                        $('#PermanentAddress').val(result.PermanentAddress);
                        $('#CorrespondingAddress').val(result.CorrespondingAddress);
                        $('#Email').val(result.Email);
                        $('#MobileNumber').val(result.MobileNumber);
                        $('#PhoneNumber').val(result.PhoneNumber);
                        $('#AadharNumber').val(result.AadharNumber);
                        $('#PanNumber').val(result.PanNumber);
                        $('#AnnualIncome').val(result.AnnualIncome);

                        if (result.ExpansionType == "Expansion") {
                            $('#ExistingProperty').val(result.ExistingProperty);
                            $('#AllottmentDate').data("kendoDatePicker").value(result.AllottmentDate);
                            
                            $('.row-ex-alote').show();
                            $('.row-rent').css("display", "none");
                            $('.col-rent').css("display", "none");
                        }
                        if (result.ExpansionType == "RentPermission") {
                            $('#LetterDate').data("kendoDatePicker").value(result.LetterDate);
                            $('#LetterCode').val(result.LetterCode);
                            $('#PropertyNo').val(result.PropertyNo);
                            $('.row-ex-alote').css("display", "none");
                            $('.row-rent').show();
                            $('.col-rent').show();
                        }
                        
                        $('#ApplicantGSTNumber').val(result.ApplicantGSTNumber);
                        //$('#CompanyTypeId').data('kendoDropDownList').dataSource.read();
                        $('#CompanyTypeId').data("kendoDropDownList").value(result.CompanyTypeId);
                        $('#CompanyTypeId').data('kendoDropDownList').dataSource.read();
                        ApplicantTypeChangeEvent();
                    }
                    else {
                        
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    //alert(respText);
                }
            });
        }
    }

