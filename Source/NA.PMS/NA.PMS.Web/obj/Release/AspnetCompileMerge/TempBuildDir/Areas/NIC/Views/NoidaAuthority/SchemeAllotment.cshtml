    function readURL(input) {
        if (CheckUserImage(input)) {
            if (input.files && input.files[0]) {
                var imgsize = input.files[0].size / 1024;
                if (imgsize > 11 && imgsize < 51) {
                    var reader = new FileReader();
                    $('#userid').css("display", "none");
                    reader.onload = function (e) {
                        $('#userphoto').attr('src', e.target.result);
                    }
                    $('#userphoto').show();
                    reader.readAsDataURL(input.files[0]);
                }
                else {
                    alertify.error("user image min(10kb) and max(50kb)");
                    $('#imguser').val('');
                }
            }
        }
        else {
            $('#imguser').val('');
        }
    }

    //$('#signatureid').click(function () {
    //    $('#imgsign').click();
    //});

    //$('#signature').click(function () {
    //    $('#imgsign').click();
    //});

    $('#imgsign').change(function () {
        displaySignatueImage(this);
    });

    function displaySignatueImage(input) {
        if (CheckUserImage(input)) {
            if (input.files && input.files[0]) {
                var imgsize = input.files[0].size / 1024;
                if (imgsize > 5 && imgsize < 20) {
                    var reader = new FileReader();
                    $('#signatureid').css("display", "none");
                    reader.onload = function (e) {
                        $('#signature').attr('src', e.target.result);
                    }
                    $('#signature').show();
                    reader.readAsDataURL(input.files[0]);
                }
                else {
                    alertify.error("Signature image min(5kb) and max(20kb)");
                    $('#imgsign').val('');
                }
            }
        }
        else {
            $('#imgsign').val('');
        }
    }

    function CheckUserImage(input) {
        var file = input.files[0].name;
        var count = file.lastIndexOf('.') + 1;
        var ext = file.substr(count);
        if (ext.toLowerCase() == "jpg") {
            return true;
        }
        else {
            alertify.error("Only jpg file allowed.");
            return false;
        }
    }

