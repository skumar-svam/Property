    function SubmitSchemeFormData() {
        var windowWidget = $(document).body();
        kendo.ui.progress(windowWidget.element, true);

        var atype = $('#ApplicantType').val();
        var ftype = $('#ApplicationFormType').val();
        $('#hdnFormType').val("Online");
        $('#ApplicantType').val(atype);
        $('#ApplicationFormType').val(ftype);
        $('#IsDeclarationChecked').val(true);
        var formData = new FormData($('form').get(0));
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            data: formData,
            url: '/NIC/NoidaAuthority/SaveAllottedPropertyDocument',
            success: function (result) {
                if (result != null && result.IsAllotmentLetterSaved == true) {
                    alertify.success("Document updloaded successfully");
                    kendo.ui.progress(windowWidget.element, false);

                    //alertify.alert('Scheme Form Status', "To Proceed Further, Pay Application Fee via Nivesh Mitra");
                }
                else {
                    kendo.ui.progress(windowWidget.element, false);
                    alertify.alert('Scheme Form Status', 'Provider failed to save form, try again later!', function () { alertify.success('Ok'); })
                }
            },
            error: function (ajaxRequest, strError) {
                kendo.ui.progress(windowWidget.element, false);
                alertify.error("Network error, try again later");
            }
        });
    }

