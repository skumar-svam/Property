    }
</script>
<script type="text/javascript">
    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }

    var floatKeys = new Array();
    floatKeys.push(8); //Backspace
    floatKeys.push(190); // (.)dot
    function IsFloatNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || floatKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }

