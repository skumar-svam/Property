@using Kendo.Mvc.UI
@{
    ViewBag.Title = "Manage Transfers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #btnRequest {
        float: right;
    }
    .k-grid-content{
        overflow-y:hidden;
        overflow-x:hidden;
    }
</style>

<div class="TransferApprover">
 
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Transfers</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                @*<a href="#" id="btnAddApplication" class="" onclick="javascript:AddApplication(event);">Add Application</a>*@
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 k-grid-content">

        @(Html.Kendo().Grid<NA.PMS.Model.TransferModel>()
        .Name("gridTransfers")
        .Columns(columns =>
        {
            columns.Bound(c => c.ReqNo).Title("Request No").Width(130).ClientTemplate("<a href=\"/Property/PropertyRegistration/ViewTransferDetails_Approver/#= ReqNo#\" id='v_#=ReqNo#'  style = 'width: 30px;' >#=ReqNo#</a>");
            columns.Bound(c => c.RId).Title("Registration Id").Width(150);
            columns.Bound(c => c.DepttName).Title("Department");
            columns.Bound(c => c.Sector).Title("Sector").Width(100);
            columns.Bound(c => c.Block).Title("Block").Width(100);
            columns.Bound(c => c.PropertyNo).Title("Property No").Width(150);
            //columns.Bound(c => c.PropNo).Title("Property No");
            columns.Bound(c => c.ReqDate).Title("Request Date").Format("{0:dd/MM/yyyy}");
            columns.Bound(c => c.ApprovedDate).Title("Approved/Rejected Date").Format("{0:dd/MM/yyyy}");//Bug#191 (Note) - Resolved
            columns.Bound(c => c.AssignedTo).Title("Assigned To");
            columns.Bound(c => c.Status).Title("Status").Width(130);
        })
        .Sortable()
        .Filterable()
                .Resizable(resize => resize.Columns(true))
                //.ToolBar(toolBar =>
                //{
                //    toolBar.Custom().Text("<i class='fa fa-plus-square' aria-hidden='true'></i> Add Request").HtmlAttributes(new { onclick = "javascript:AddTransferReq(event);", @class = "k-button", id = "btnRequest" });
                //})
        .Pageable(pageable => pageable
                                               .Enabled(true)
                                               .Refresh(true)
                                               .PageSizes(true)
                                            )
                                            .Groupable()
        .DataSource(dataSource => dataSource
        .Ajax().Model(model => model.Id(c => c.ReqNo))
                .ServerOperation(true).Sort(sort => sort.Add("ReqNo").Descending())
        .Read(read => read.Action("GetTransferData_Approver", "PropertyRegistration")).PageSize(20)
        )
        )
    </div>
</div>

<script type="text/javascript">
    function AddTransferReq(event) {
        event.preventDefault();
        window.location.href = '@Url.Action("AddTransferRequest", "PropertyRegistration")';
    }
</script>