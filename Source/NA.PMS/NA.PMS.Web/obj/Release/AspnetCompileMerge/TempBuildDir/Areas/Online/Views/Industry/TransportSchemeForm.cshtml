@model NA.PMS.Model.OnlineFormViewModel
@using Kendo.Mvc.UI
@using NA.PMS.Common
@using NA.PMS.Model

@{
    ViewBag.Title = "Transport Scheme Form";

    if (Session["WBasicDetailsNIC"] != null || Model.AppType == Constants.AppType)
    {
        Layout = "~/Views/Shared/_LayoutNIC.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_LayoutOnline.cshtml";
    }
}

<style type="text/css">
    .contentWrapper {
        padding-top: 95px !important;
    }

    .text-red {
        color: red;
    }

    .upload-user-image {
        width: 140px;
        height: 140px;
        padding-top: 60px;
    }

    .upload-sign-image {
        width: 140px;
        height: 55px;
        line-height: 14px;
        padding-top: 5px;
    }

    .upload-image {
        background: #fff;
        border: 1px solid #ccc;
        font-size: 11px;
        text-align: center;
        float: right;
    }

    .form-heading {
        text-transform: uppercase;
        color: #0b2d23;
        font-size: 110%;
        font-weight: bold;
        /* border-top: 1px solid #299a8b; */
        /* border-bottom: 1px solid #299a8b; */
        line-height: 30px;
        margin-bottom: -1px;
        background: #e2e3e4;
        padding: 0 15px;
    }

    .form-sub-heading {
        text-transform: uppercase;
        color: #0b2d23;
        font-weight: bold;
        background: #e2e3e4;
        padding: 0 15px;
        margin-bottom: 20px;
        font-size: 14px;
        border-bottom: 1px solid #299a8b;
        line-height: 12px;
    }

    .divCompanyInfo {
        display: none;
    }

    #divExpansionType {
        display: none;
    }

    #divExistingAllottee {
        display: none;
    }

    .row-rent {
        display: none;
    }

    .col-rent {
        display: none;
    }

    #second-form {
        display: none;
    }

    .k-button.k-upload-button {
        margin: 0;
    }

    .k-upload-files {
        margin: 0;
    }



    #userphoto:hover {
        cursor: pointer;
    }

    .glyphicon-user:hover {
        cursor: pointer;
    }



    #signature:hover {
        cursor: pointer;
    }

    .img-upld-bx:hover {
        cursor: pointer;
    }

    #loader {
        display: none;
    }

    .content-top-spce {
        padding: 0 0 20px;
        margin-top: -20px;
    }
</style>

@if (Session["SchemeUserLoginDetails"] != null && Session["SchemeUserLoginDetails"] != "")
{
    <style type="text/css">
        #userphoto {
            /*display: none;*/
        }

        #signature {
            /*display: none;*/
        }
    </style>
}
else
{
    <style type="text/css">
        #userphoto {
            display: none;
        }

        #signature {
            display: none;
        }
    </style>
}
@using (Html.BeginForm("RegisterTransportSchemeForm", "Application", FormMethod.Post, new { enctype = "multipart/form-data", id = "applicationTransportform" }))
{
    <div class="online-registration">
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Online Transport Scheme Application Form</h1></div>
                <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce" id="first-form">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px" id="divApplicantInformation">
                <label id="errormessage">@Html.ValidationMessageFor(m => m.ErrorMessage, "", new { @class = "red" })</label>
                <h2 class="blck-heading" style="">
                    <span style="text-decoration:underline;">Applicant Information</span>
                    @{
                        if (Model.ApplicationFormId != null)
                        {
                            <span class="pull-right">Form No: @Html.DisplayFor(model => model.ApplicationFormId)</span>
                        }
                    }
                </h2>
                <div class="form-bx">
                    <div>
                        @Html.HiddenFor(model => model.Id)
                        @Html.HiddenFor(model => model.ApplicationFormId)
                        @Html.HiddenFor(model => model.SchemeId)
                        @Html.HiddenFor(model => model.SchemeType)
                        @Html.HiddenFor(model => model.DepartmentId)
                        @Html.HiddenFor(model => model.AreaRange)
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-md-4 col-sm-6 col-xs-12 form-group">
                                    <label>Applicant Type</label>
                                </div>
                                <div class="col-md-8 col-sm-6 col-xs-12 form-group" id="FormType">
                                    <label>@Html.RadioButtonFor(m => m.ApplicantType, "Individual", new { @class = "", @checked = true, @id = "Individual" }) Individual</label>
                                    <label>@Html.RadioButtonFor(m => m.ApplicantType, "Company", new { @id = "Company" }) Company</label>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-sm-6 col-xs-12 form-group">
                                    @Html.Label("Scheme Name", htmlAttributes: new { @class = "required" })
                                </div>
                                <div class="col-md-8 col-sm-6 col-xs-12 form-group">
                                    @Html.TextBoxFor(model => model.SchemeName, new { @readonly = "readonly", @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.SchemeName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-sm-6 col-xs-12 form-group">@Html.Label("Department", htmlAttributes: new { @class = "required" })</div>
                                <div class="col-md-8 col-sm-6 col-xs-12 form-group">
                                    @Html.TextBoxFor(model => model.Department, new { @readonly = "readonly", @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Department, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-sm-6 col-xs-12 form-group">@Html.Label("Previous Form No If Refund Not Taken", htmlAttributes: new { @class = "" })</div>
                                <div class="col-md-8 col-sm-6 col-xs-12 form-group">
                                    @Html.TextBoxFor(model => model.PreviousFormNo, new { @minlength = "4", @maxlength = "10", @class = "form-control", @placeholder = "Previous Form No If Refund Not Taken" })
                                    @Html.ValidationMessageFor(model => model.PreviousFormNo, "", new { @class = "text-danger" })
                                    <small class="text-info">Previous Form No. should be minimun 4 digits & 10 digit maximum.</small>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                                    @Html.Label("Applicant Constitution", htmlAttributes: new { @class = "required" })
                                </div>
                                <div class="col-md-8 col-sm-3 col-xs-12 form-group">
                                    @(Html.Kendo().DropDownListFor(model => model.CompanyTypeId)
                                    .DataTextField("Text")
                                    .DataValueField("Id")
                                    .OptionLabel(" -- Please Select --")
                                    .DataSource(source => source.Read(read => read.Action("GetCompanyTypeList", "Application").Data("FilterCategory")).ServerFiltering(true))
                                    .Enable(true)
                                    .AutoBind(true)
                                    .Filter("contains")
                                    .HtmlAttributes(new { style = "width:100%", @class = "DisableKeyboardInput" })
                                    )
                                    @Html.ValidationMessageFor(model => model.CompanyTypeId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                                    @Html.Label("Area Applied For", htmlAttributes: new { @class = "required" })
                                </div>
                                <div class="col-md-8 col-sm-3 col-xs-12 form-group">
                                    @(Html.Kendo().DropDownListFor(model => model.AreaRangeId)
                                    .DataValueField("Id")
                                    .DataTextField("Text")
                                    .OptionLabel("--Please Select--")
                                    .AutoBind(true).Enable(true)
                                    .Events(events => { events.Change("ApplicationFeeAndCharges"); })
                                    .Filter("contains")
                                    .CascadeFrom("DepartmentId")
                                    .DataSource(source => source.Read(read => read.Action("GetFloorAreaList", "Application").Data("FilterIdForAreaRange")).ServerFiltering(true))
                                    .HtmlAttributes(new { style = "width: 100%" })
                                    )
                                    @Html.ValidationMessageFor(model => model.AreaRangeId, "", new { @class = "text-danger" })
                                </div>
                            </div>

                        </div>
                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-md-4 col-sm-6 col-xs-12">
                                </div>
                                <div class="col-md-8 col-sm-6 col-xs-12 form-group">
                                    <div class="row">
                                        <div class="col-md-12 text-right" style="margin-bottom:5px;">
                                            @if (Session["SchemeUserLoginDetails"] != null && Session["SchemeUserLoginDetails"] != "")
                                            {
                                                <img id="userphoto" src="@Model.UserImage" alt="your image" height="150" width="140" name="userImage2" />
                                            }
                                            else
                                            {
                                                <div id="userid" class="img-upld-bx upload-image upload-user-image">Upload Your Image User<small class="text-red"> User Image Size Min(10kb) and Max(50kb)</small></div>
                                                <img id="userphoto" src="#" alt="your image" height="150" width="140" name="userImage2" />
                                                <input type='file' id="imguser" name="userImage" accept="image/jpg" style="display:none" />
                                            }

                                        </div>
                                        <div class="col-md-12 text-right">

                                            @if (Session["SchemeUserLoginDetails"] != null && Session["SchemeUserLoginDetails"] != "")
                                            {
                                                <img id="signature" src="@Model.SignImage" alt="your sign" height="40" width="140" name="usersign" />
                                            }
                                            else
                                            {
                                                <div id="signatureid" class="img-upld-bx upload-image upload-sign-image" style="">Upload Your Signature<small class="text-red"> Signature Image Min(5kb) and Max(20kb)</small></div>
                                                <img id="signature" src="#" alt="your sign" height="40" width="140" name="usersign" />
                                                <input type='file' id="imgsign" name="signatureImage" accept="image/jpg" style="display:none" />
                                            }

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row divCompanyInfo" id="divCompanyInfo">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.LabelFor(m => m.Applicant, htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", placeholder = "full name " })
                            @Html.ValidationMessageFor(model => model.Applicant, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group col-company">
                            @Html.Label("Authorized Signatory", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group col-company">
                            @Html.TextBoxFor(model => model.SigningAuthority, new { @class = "form-control", @maxlength = "150", placeholder = "signing authority" })
                            @Html.ValidationMessageFor(model => model.SigningAuthority, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row divCompanyInfo" id="">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Signatory's Father Name", htmlAttributes: new { @class = "" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.ApplicantMaster, htmlAttributes: new { @class = "form-control", placeholder = "father's name " })
                            @Html.ValidationMessageFor(model => model.ApplicantMaster, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group col-company">
                            @Html.Label("Signatory Status", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group col-company">
                            @(Html.Kendo().DropDownListFor(model => model.SigningAuthorityId)
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel("--Select--")
                            .DataSource(source =>source.Read(read =>read.Action("GetDirectorTypeList", "Application", new { area = "Online" })))
                            .HtmlAttributes(new { @class = "", style = "width:100%;" })
                            )
                            @Html.ValidationMessageFor(model => model.SigningAuthority, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row" id="divIndividualInfo">
                        @{Html.RenderPartial("_IndividualForm", Model);}
                    </div>
                </div>
                <div id="CommonInfo" class="form-bx">
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Permanent Address", htmlAttributes: new { @class = "required lbl-permanent-address" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextAreaFor(model => model.PermanentAddress, new { @class = "form-control", @maxlength = "500", placeholder = "address" })
                            @Html.ValidationMessageFor(model => model.PermanentAddress, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Correspondence Address", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextAreaFor(model => model.CorrespondingAddress, new { @class = "form-control", @maxlength = "500", placeholder = "address" })
                            @Html.ValidationMessageFor(model => model.CorrespondingAddress, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Email", htmlAttributes: new { @class = "required lbl-Email" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @(Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", @maxlength = "150", placeholder = "skumar@svam.com" } }))
                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Mobile Number", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.MobileNumber, new { @class = "form-control", @minlength = "10", @maxlength = "10", onkeypress = "return IsNumeric(event);", placeholder = "0123456789" })
                            @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Phone Number")
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.PhoneNumber, new { @class = "form-control", @maxlength = "14", placeholder = "011 29968337" })
                            @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Aadhar Number", htmlAttributes: new { @class = "required", @id = "lblPanNumber" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.AadharNumber, new { @class = "form-control", @minlength = "12", @maxlength = "12", onkeypress = "return IsNumeric(event);", placeholder = "0000 1111 2222" })
                            @Html.ValidationMessageFor(model => model.AadharNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("PAN", htmlAttributes: new { @class = "required lbl-PAN" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.PanNumber, new { @class = "form-control", placeholder = "AAAAA1111A", @onchange = "PanNumberChange();", @maxlength = "10" })
                            @Html.ValidationMessageFor(model => model.PanNumber, "", new { @class = "text-danger" })
                            <small class="text-info">PANCARD Format Like AAAAA1111A</small>
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Annual Income", htmlAttributes: new { @class = "required lbl-annnual-income" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.AnnualIncome, new { @class = "form-control textBoxValueRightAlign", @placeholder = "in rupees", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                            <small class="text-info">Value in Rupees.</small>
                            @Html.ValidationMessageFor(model => model.AnnualIncome, "", new { @class = "text-danger" })
                        </div>
                    </div>
                   
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("GST Number", htmlAttributes: new { @class = "", @id = "" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.ApplicantGSTNumber, new { @class = "form-control", placeholder = "", @maxlength = "15" })
                        </div>
                    </div>
                   
                </div>
                <h2 class="blck-heading">Payment Information</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Form Fee (INR)", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.ApplicationFee, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                            @Html.ValidationMessageFor(model => model.ApplicationFee, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Processing Fee", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.ProcessingCharge, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                            @Html.ValidationMessageFor(model => model.ProcessingCharge, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("GST(18%) on Form Fee ", htmlAttributes: new { @class = "" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.FormFeeGST, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("GST(18%) on Processing Charge", htmlAttributes: new { @class = "" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.ProcessingChargeGST, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Earnest Money (INR)", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.EarnestMoney, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                            @Html.ValidationMessageFor(model => model.EarnestMoney, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Amount Payable (INR)", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.TotalAmount, new { @readonly = "readonly", @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                            @Html.ValidationMessageFor(model => model.TotalAmount, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <h2 class="blck-heading">Refund Information</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Bank Name", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(m => m.RefundBankId)
                                        .Filter("contains")
                                        .DataTextField("Text")
                                        .DataValueField("Id")
                                        .OptionLabel("---Select---")
                                        .DataSource(source =>source.Read(read =>read.Action("GetBankListforOnline", "Application")))
                                        .HtmlAttributes(new { @class = "schemeForms", style = "width: 100%" })
                            )
                            @Html.ValidationMessageFor(model => model.RefundBankId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Branch Name", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.BranchName, new { @class = "form-control", @maxlength = "150", placeholder = "" })
                            @Html.ValidationMessageFor(model => model.BranchName, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Infavour of", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.RefundInfaverof, new { @class = "form-control", @maxlength = "150", placeholder = "Shatrughna kumar" })
                            @Html.ValidationMessageFor(model => model.RefundInfaverof, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Account No", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.RefundAccountNo, new { @class = "form-control textBoxValueRightAlign", @minlength = "6", @maxlength = "16", placeholder = "110000001100011", onkeypress = "return IsNumeric(event);", })
                            @Html.ValidationMessageFor(model => model.RefundAccountNo, "", new { @class = "text-danger" })
                            <small class="text-info">Refund Account No Should Be Minimun 6 Digits</small>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.Label("IFSC Code", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
