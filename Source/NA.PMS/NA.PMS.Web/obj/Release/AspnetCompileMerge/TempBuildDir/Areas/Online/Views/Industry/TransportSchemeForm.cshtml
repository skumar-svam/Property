                        <a href="@Url.Action("TransportSchemeDocument", new { id = CommonHelper.Encode(Model.ApplicationFormId.ToString()) })" value="Skip & Proceed to Upload Documents" id="btnSkipSubmit" class="btn btn-add">Skip & Proceed to Upload Documents</a>
                    }
                    else
                    {
                        <a class="btn btn-add" href="@Url.Action("PreviewForm", "Application", new { area = "Online", id = CommonHelper.Encode(Model.ApplicationFormId.ToString()) })">Go to Preview</a>
                    }
                }
                else
                {
                    <input type="button" value="Submit & Proceed to Upload Documents" id="btnSubmit" class="btn btn-add" />
                }
            </div>
        </div>
    </div>
}

