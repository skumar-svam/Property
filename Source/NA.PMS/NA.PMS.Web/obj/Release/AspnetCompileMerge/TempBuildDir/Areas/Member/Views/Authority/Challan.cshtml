@model NA.PMS.Model.ChallanViewModel

@using NA.PMS.Common;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;

@{
    ViewBag.Title = "Authority Challan";
    var userInfo = HttpContext.Current.Session["CurrentUser"] as NA.PMS.Web.Models.CurrentUserDetail;
    if (userInfo != null)
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Blank.cshtml";
    }
}

<style>
    #divChallanGrid {
        display: none;
    }

    .lbl-form-control {
        /*background:#ececec;*/
        background: url(/Content/Images/boxed-bg.jpg) repeat;
    }

    .col-custom {
        width: 90%;
        float: right;        
    }
    #divPrintChallan{
        display:none;
    }
    .modal-content{
        border-radius:0;
    }
</style>

<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1" id="property-challan">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Generate Challan</h1></div>
            <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 content-top-spce">
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading" style="margin-bottom:6px;">Property Details</h2>
            <div class="form-bx">
                <div>


                    @Html.HiddenFor(m => m.Sector)

                    @Html.HiddenFor(m => m.Block)

                    @Html.HiddenFor(m => m.ApplicantType)
                    @Html.HiddenFor(m => m.ApplicantMaster)
                    @Html.HiddenFor(m => m.PropertyType)
                    @Html.HiddenFor(m => m.TotalArea)
                    @Html.HiddenFor(m => m.FloorArea)
                    @Html.HiddenFor(m => m.IFSCCode)
                    @Html.HiddenFor(model => model.Amount, htmlAttributes: new { @id = "hdnAmmount" })
                    @Html.HiddenFor(model => model.AccountHeadId, htmlAttributes: new { @id = "hdnAccountHeadId" })
                    @Html.HiddenFor(model => model.AccountSubHeadId, htmlAttributes: new { @id = "hdnAccountSubHeadId" })
                </div>
                <div class="row" style="display:none;">
                    <div class="col-md-5 col-sm-4 col-xs-12 form-group" id="div-allottee-type" style="text-align:right;">
                        <span>Do you have your Registration Id? </span>
                        <input type="radio" name="RegistrationType" id="rbtnRegistered" value="Registered" checked="checked">&nbsp;<b>Yes</b> &nbsp;&nbsp;
                        <input type="radio" name="RegistrationType" id="rbtnUnRegistered" value="UnRegistered" />&nbsp;<b>No</b>
                    </div>
                    <div class="col-md-2 col-sm-4 col-xs-12 form-group"></div>
                    <div class="col-md-5 col-sm-4 col-xs-12 form-group"></div>
                </div>
                <div class="row" style="display:none;">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Registration Id", htmlAttributes: new { @class = "required" })
                        @(Html.Kendo().DropDownListFor(m => m.RegistrationId)
                            .Filter("contains")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel("---Select---")
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => { transport.Read("GetRegistrationIdListAsDataSource", "Authority", new { area = "Member" }); })
                                .Schema(schema => { schema.Data("Data").Total("Total"); })
                                .PageSize(100);
                            })
                            .Events(events => { events.Change("ChangeRegistrationIdEvent"); })
                            .HtmlAttributes(new { @class = "col-custom", style = "width:90%; float:right;" })
                        )
                    </div>

                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Department")
                        @Html.TextBoxFor(model => model.Department, htmlAttributes: new { @class = "form-control", style = "width:90%;float:right;", @readonly = "readonly" })
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Property No")
                        @Html.TextBoxFor(model => model.PropertyNo, htmlAttributes: new { @class = "form-control", style = "width:90%;float:right;", @readonly = "readonly" })
                    </div>
                </div>

                <div class="row" id="divUnregisteredLocation">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label>Sector</label>
                        @(Html.Kendo().DropDownListFor(model => model.SectorId)
                        .DataTextField("Text")
                        .DataValueField("Id")
                        .OptionLabel(" -- Select --")
                        .Enable(true)
                        .AutoBind(true)
                        .Filter("contains")
                        .DataSource(source =>
                        {
                            source.Custom()
                            .ServerFiltering(true)
                            .ServerPaging(true)
                            .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                            .Transport(transport => transport.Read(read => read.Action("GetSectorListAsDataSourceII", "Authority", new { area = "Member" })))
                            .Schema(schema => schema.Data("Data").Total("Total"))
                            .PageSize(100);
                        })
                        .HtmlAttributes(new { style = "width:90%; float:right;", @class = "input-disabled" })
                        )
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label>Block</label>
                        @(Html.Kendo().DropDownListFor(m => m.BlockId)
                        .Filter("contains")
                        .DataTextField("Text")
                        .DataValueField("Id")
                        .OptionLabel(" -- Select --")
                        .DataSource(source =>
                        {
                            source.Custom()
                            .ServerFiltering(true)
                            .ServerPaging(true)
                            .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                            .Transport(transport => transport.Read(read => read.Action("GetBlockListAsDataSourceII", "Authority", new { area = "Member" })))
                            .Schema(schema => schema.Data("Data").Total("Total"))
                            .PageSize(100);
                        })
                                // .Events(events => { events.Change("ChangeInBlock"); })
                        .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                        )
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label class="required">Flat/Plot No</label>
                        @Html.TextBoxFor(model => model.PlotNo, htmlAttributes: new { @class = "form-control", @maxlength = "50", style = "width:90%; float:right;" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label class="required">Department</label>
                        @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                        .Filter("contains")
                        .DataTextField("Text")
                        .DataValueField("Id")
                        .OptionLabel(" -- Select --")
                        .DataSource(source =>
                        {
                            source.Custom()
                            .ServerFiltering(true)
                            .ServerPaging(true)
                            .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                            .Transport(transport => transport.Read(read => read.Action("GetDepartmentListAsDataSource", "Authority", new { area = "Member" })))
                            .Schema(schema => schema.Data("Data").Total("Total"))
                            .PageSize(100);
                        })
                        .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                        )
                    </div>
                    <div class="col-md-4 col-sm-6 col-xs-12 form-group">
                        @Html.Label("Allottee Name", new { @class="required"})
                        @Html.TextAreaFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", @maxlength = "200", style = "width:90%;float:right;height:32px;" })
                    </div>
                    <div class="col-md-4 col-sm-6 col-xs-12 form-group">
                        @Html.Label("Correspond Address", new { @class = "required" })
                        @Html.TextAreaFor(model => model.CorrespondAddress, htmlAttributes: new { @class = "form-control", @maxlength = "200", style = "width:90%;float:right;height:32px;" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label class="required">Mobile No</label>
                        @Html.TextBoxFor(model => model.MobileNo, htmlAttributes: new { @class = "form-control", @maxlength = "10", style = "width:90%; float:right;" })
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label>Email</label>
                        @Html.TextBoxFor(model => model.Email, htmlAttributes: new { @class = "form-control", @maxlength = "50", style = "width:90%; float:right;" })
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label>
                            @*<input type="radio" group="ref-type-group" class="" name="reference-type" value="RefNo" />RefNo &nbsp;*@
                            <input type="radio" group="ref-type-group" class="" name="reference-type" value="PAN" />PAN &nbsp;&nbsp;
                            <input type="radio" group="ref-type-group" class="" name="reference-type" value="GST" />GST
                        </label>
                        @Html.TextBoxFor(model => model.ReferenceNo, htmlAttributes: new { @class = "form-control", @maxlength = "25", style = "width:90%; float:right;" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Bank Name", htmlAttributes: new { @class = "required" })
                        @(Html.Kendo().DropDownListFor(model => model.BankId)
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel("---select---")
                            .Filter("contains")
                                //.DataSource(source =>source.Read(read =>read.Action("GetAllBanks", "PropertyRegistration")))
                            .DataSource(source =>
                            {
                                source.Custom().ServerFiltering(true).ServerPaging(true).ServerPaging(true).Type("aspnetmvc-ajax")
                                .Transport(transport => transport.Read("GetBankListAsDataSource", "Authority", new { area = "Member" }))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(100);
                            })
                            .HtmlAttributes(new { style = "width: 90%; float:right;" })
                        )
                    </div>

                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Branch Address", htmlAttributes: new { @class = "required" })
                        @(Html.Kendo().DropDownListFor(model => model.BranchId)
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .Filter("contains")
                            .OptionLabel("---select---")
                                //.DataSource(source =>source.Read(read =>read.Action("GetAllBranchs", "PropertyRegistration").Data("filterBranches")).ServerFiltering(true))
                            .DataSource(source =>
                            {
                                source.Custom().ServerFiltering(true)//.ServerPaging(true).ServerPaging(true).Type("aspnetmvc-ajax")
                                .Transport(transport => transport.Read(read => read.Action("GetBranchListOfBankAsDataSource", "Authority", new { area = "Member" }).Data("FilterBankId")))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(100);
                            })
                            .CascadeFrom("BankId")
                            .Events(model => model.Change("ChangeInBankBranchEvent"))
                            .HtmlAttributes(new { style = "width: 90%; float:right;" })
                        )
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Account No", htmlAttributes: new { @id = "lblAccountddl", @class = "required" })
                        @Html.TextBoxFor(m => m.AccountNo, new { @class = "form-control", @maxlength = "20", style = "width:90%; float:right;" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Account Head", htmlAttributes: new { @class = "required" })
                        @(Html.Kendo().DropDownListFor(model => model.AccountHeadId)
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel("---select---")
                            .Filter("contains")
                            .DataSource(source =>
                            {
                                source.Custom().ServerFiltering(true).ServerPaging(true).ServerPaging(true).Type("aspnetmvc-ajax")
                                .Transport(transport => transport.Read("GetAccountHeadList", "Authority", new { area = "Member" }))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(100);
                            })
                            .HtmlAttributes(new { style = "width: 90%; float:right;" })
                        )
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Account Subhead", htmlAttributes: new { @class = "required" })
                        @(Html.Kendo().DropDownListFor(model => model.AccountSubHeadId)
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel("---select---")
                            .DataSource(source =>
                            {
                                source.Custom().ServerFiltering(true).ServerPaging(true)//.ServerPaging(true).Type("aspnetmvc-ajax")
                                .Transport(transport => transport.Read(read => read.Action("GetAccountSubHeadList", "Authority", new { area = "Member" }).Data("FilterAccountHeadId")))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(100);
                            })
                            .CascadeFrom("AccountHeadId")
                            .HtmlAttributes(new { style = "width: 90%; float:right;" })
                        )
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Amount", htmlAttributes: new { @id = "lblAccountddl", @class = "required" })
                        @(Html.Kendo().NumericTextBoxFor(m => m.Amount)
                            .Min(0)
                            .Max(999999999999999999)
                            .Spinners(false).Step(0)
                            .Enable(true)
                            .HtmlAttributes(new { style = "width: 90%; float:right;", @maxlength = "18", @class = "k-textbox  text-right" })
                        )
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12 form-group" style="text-align:right">
                        <input type="button" id="btnAdd" value="Add Amount" class="k-button" style="width:100px;" />
                    </div>
                </div>
            </div>


            <div class="col-md-12 k-grid-content" id="divChallanGrid">
                @(Html.Kendo().Grid<NA.PMS.Model.ChallanViewModel>()
                    .Name("gridChargeDetails")
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.Id).Title("Id").Width(50);
                        columns.Bound(c => c.RegistrationId).Hidden(true);
                        columns.Bound(c => c.AccountHead).Title("Account Head");
                        columns.Bound(c => c.AccountSubHead).Title("Account Sub Head");
                        columns.Bound(c => c.Amount).Title("Amount");
                        //columns.Bound(c => c.BankName).Title("Bank");
                        //columns.Bound(c => c.CreatedDate).Title("Date").Format("{0:dd-MMM-yyyy}");
                        columns.Bound(c => c.Id).Title("Action").ClientTemplate("<a onclick='javascript:RemoveChallanDetails(this);'class='hyperlinkcss'>Remove</a>").Filterable(false).Sortable(false);
                        //columns.Bound(c => c.ChallanTransID).Title("Action").ClientTemplate("<a onclick='javascript:RemoveDetails(\"#=ChallanTransID#\");'class='hyperlinkcss'>Remove</a>").Filterable(false).Sortable(false);
                    })
                        .Sortable().Filterable().Resizable(resize => resize.Columns(true))
                        .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                        .DataSource(dataSource => dataSource
                                .Ajax().Model(model => model.Id(c => c.Id))
                                .ServerOperation(true)
                                .Read(read => read.Action("GetTempChallanChargesAsDataSourceII", "Authority").Data("AdditionalInfo")).PageSize(5)
                        )
                        .Events(e => e.DataBinding("ChallanGridDataBoundEvent"))
                )
            </div>

            <div class="col-md-12">
                <div class="box-button text-center">
                    @*<input type="button" id="btnBack" value="Back" class="btn  btn-default" />*@
                    <input type="button" value="Generate Challan" id="btnGenerateChallan" class="btn btn-default" />
                </div>
            </div>
        </div>
    </div>
</div>


<div id="divPrintChallan" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 65%;">
        <div class="modal-content" style="overflow:auto;">
            <div class=" modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            <h4 class="modal-title">  <b>Challan</b></h4>
        </div>
            <div class="modal-body" style="overflow:auto; height:450px;">
                <style>
                    .td-amount {
                        padding-right: 30px;
                    }

                    #divChallanBody {
                        padding: 5px;
                    }

                    #authorityChallan {
                        border: 1px solid black;
                        padding: 5px;
                    }
                </style>
                <div id="divChallanBody"></div>
            </div>

            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv();" style="width:100px;">Print</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {

        var userInfo = '@HttpContext.Current.Session["CurrentUser"]';
        if (userInfo == '') {
            $('#property-challan').css({ "margin-top": "30px" });
        }

        $("#btnBack").click(function () {
            window.location.href = '@Url.Action("ManageChallan", "Authority", new { area="Member"})';
        });

        $("#btnAdd").click(function () {
            AddChallanDetail()
        });

        $("#btnGenerateChallan").click(function () {
            //GenerateParsedChallan();
            var flag = ValidateChallanDetails();
            if (flag) {
                GenerateParsedChallan();
            }
        });

        $('#divPrintChallan').on('hidden.bs.modal', function () {
            ClearFieldValue();
            $("#AccountHeadId").data("kendoDropDownList").value("");
            $("#AccountSubHeadId").data("kendoDropDownList").value("");
            $("#Amount").data("kendoNumericTextBox").value("");
            $("#BankId").data("kendoDropDownList").value("");
            $("#gridChargeDetails").data('kendoGrid').dataSource.data([]);
        });

        ChallanGridDataBoundEvent();
    });


    function AdditionalInfo() {
        return {
            RegistrationId: $('#RegistrationId').val()
        }
    }

    function FilterBankId() {
        return {
            bankId: $("#BankId").val()
        };
    }
    function FilterAccountHeadId() {
        return {
            id: $("#AccountHeadId").val()
        };
    }
    //function filterBankAccounts() {
    //    return {
    //        bankId: $("#BankId").val(),
    //        branchId: $("#BranchId").val()
    //    };
    //}

    function ChallanGridDataBoundEvent() {
        var total = $('#gridChargeDetails').data("kendoGrid").dataSource.total();
        if (total == 0) {
            $('#divChallanGrid').css("display", "none");
        }
        else if (total > 0) {
            $('#divChallanGrid').show();
        }
    }

    function ChangeInBankBranchEvent() {
        if ($('#BranchId').val() != '') {
            var bank = {
                BankId: $('#BankId').val(),
                BranchId: $('#BranchId').val(),
                FilterType: "AccountNo"
            };
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ model: bank }),
                url: '/Member/Authority/GetBankAccountDetailById',
                success: function (result) {
                    if (result != null && result != '') {
                        $("#AccountNo").val(result.AccountNo);
                        $("#IFSCCode").val(result.IFSCCode);
                        return false;
                    }
                    else {
                        alertify.error("Account No is not available.");
                        return true;
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    alertify.error("Network error, Please try again later.");
                }
            });
        }
    }

    function AddChallanDetail() {
        //if ($("#RegistrationId").val() == "") {
        //    alertify.error("Please select RegistrationId.");
        //    return false;
        //}
        if ($("#AccountHeadId").val() == "") {
            alertify.error("Please select Account Head.");
            return false;
        }
        if ($("#AccountSubHeadId").val() == "") {
            alertify.error("Please select Sub Account Head.");
            return false;
        }
        if ($("#Amount").val() == "") {
            alertify.error("Please enter  Amount.");
            return false;
        }
        var challan = {
            RegistrationId: $("#RegistrationId").val(),
            AccountHeadId: $("#AccountHeadId").val(),
            AccountSubHeadId: $("#AccountSubHeadId").val(),
            AccountHead: $("#AccountHeadId").data("kendoDropDownList").text(),
            AccountSubHead: $("#AccountSubHeadId").data("kendoDropDownList").text(),
            Amount: $("#Amount").val()
        };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: challan }),
            url: '/Member/Authority/SaveTempChallanChargeDetailII',
            success: function (result) {
                if (result == '@ReturnType.Saved') {
                    $("#AccountHeadId").data("kendoDropDownList").value("");
                    $("#AccountSubHeadId").data("kendoDropDownList").value("");
                    $("#Amount").data("kendoNumericTextBox").value("");
                    $("#gridChargeDetails").data("kendoGrid").dataSource.read();
                    alertify.success("Data saved successfully.");
                    $("#gridChargeDetails").show();
                    return false;
                }
                else {
                    alertify.error("Data is not saved.");
                    return true;
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Network error, Please try again later.");
            }
        });
    }

    function RemoveChallanDetails(row) {
        var tr = $(row).parent().parent();
        var id = $(tr).children("td:eq(0)").text();
        var rid = $(tr).children("td:eq(1)").text();
        var headname = $(tr).children("td:eq(2)").text();
        var subheadname = $(tr).children("td:eq(3)").text();
        var amount = $(tr).children("td:eq(4)").text();
        var removeNotification = confirm('Are you sure to remove this details?');
        if (removeNotification) {
            var challan = {
                Id: id,
                RegistrationId: rid,
                AccountHead: headname,
                AccountSubHead: subheadname,
                Amount: amount
            };
            $.ajax({
                type: 'POST',
                data: { model: challan },
                url: '@(Url.Action("RemoveTempChallanChargeDetailII", "Authority", new { area = "Member" }))',
                success: function (result) {
                    if (result == '@ReturnType.Removed') {
                        $('#gridChargeDetails').data('kendoGrid').dataSource.read();
                        //$('#gridChargeDetails').data('kendoGrid').refresh();
                        alertify.success("Charges removed successfully.");
                    }
                    else {
                        alert("Charge Detail is not removed");
                        return false;
                    }
                }
            });
        }
        else {
            return false;
        }
    }

    function ValidateChallanDetails() {
        var flag = true;
        //if ($("#RegistrationId").val() == "") {
        //    alertify.error("Please select RegistrationId.");
        //    return false;
        //}

        //if ($("#SectorId").val() == "") {
        //    alertify.error("Please select Sector.");
        //    return flag = false;
        //}
        //if ($("#BlockId").val() == "") {
        //    alertify.error("Please select Block.");
        //    return flag = false;
        //}
        if ($("#PlotNo").val().trim() == "") {
            alertify.error("Please enter plot no.");
            return flag = false;
        }
        if ($("#DepartmentId").val() == "") {
            alertify.error("Please select Department.");
            return flag = false;
        }
        if ($("#Applicant").val().trim() == "") {
            alertify.error("Please enter Allottee Name.");
            return flag = false;
        }
        if ($("#CorrespondAddress").val().trim() == "") {
            alertify.error("Please enter address.");
            return flag = false;
        }
        if ($("#BankId").val() == "") {
            alertify.error("Please select Bank.");
            return flag = false;
        }
        if ($("#BranchId").val() == "") {
            alertify.error("Please select branch.");
            return flag = false;
        }
        if ($("#MobileNo").val() == "") {
            alertify.error("Please enter Mobile No.");
            return flag = false;
        }
        if ($("#AccountNo").val() != "") {
            if ($("#AccountNo").val().length < 6) {
                alertify.error("Please enter atleast 6 digits in Account No.");
                return flag = false;
            }
        }

        //CheckChallanSessionData();

        var grid = $("#gridChargeDetails").data("kendoGrid");
        var totalRecords = grid.dataSource.total();
        if (totalRecords == 0) {
            alertify.error("Please enter atleast one record in Charge Details.");
            return flag = false;
        }
        return flag;
    }

    function GenerateParsedChallan() {
        var radiobtnRefNo = $('input[name=reference-type]:checked').val();
        var challan = {
            RegistrationId: $("#RegistrationId").val(),
            DepartmentId: $("#DepartmentId").val(),
            Department: $("#DepartmentId").data("kendoDropDownList").text(),
            //SectorId: $("#SectorId").val(),
            //Sector: $("#SectorId").data("kendoDropDownList").text(),
            SectorId: $("#SectorId").val() != "" ? $("#SectorId").val() : 211,
            Sector: $("#SectorId").val() != "" ? $("#SectorId").data("kendoDropDownList").text() : "",
            BlockId: $("#BlockId").val() != "" ? $("#BlockId").val() : 14,
            Block: $("#BlockId").val() != "" ? $("#BlockId").data("kendoDropDownList").text() : "",
            PlotNo: $("#PlotNo").val().trim(),
            BankId: $("#BankId").val(),
            BankName: $("#BankId").data("kendoDropDownList").text(),
            BranchId: $("#BranchId").val(),
            BranchName: $("#BranchId").data("kendoDropDownList").text(),
            AccountNo: $("#AccountNo").val(),
            IFSCCode: $("#IFSCCode").val(),
            MobileNo: $("#MobileNo").val(),
            Email: $("#Email").val(),
            //ServiceRequestId: $("#ServiceRequestId").val(),
            ReferenceNo: (radiobtnRefNo == undefined || radiobtnRefNo == "") ? null : $("#ReferenceNo").val(),
            ReferenceType: (radiobtnRefNo == undefined || radiobtnRefNo == "") ? null : radiobtnRefNo,
            //FilterType: (radiobtnRefNo == undefined || radiobtnRefNo == "") ? null : radiobtnRefNo,
            Applicant: $('#Applicant').val().trim(),
            CorrespondAddress: $("#CorrespondAddress").val().trim(),
            PropertyType: $("#PropertyType").val()
        };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: challan }),
            url: '/Member/Authority/GetGeneratedChallanByPropertyNo',
            success: function (result) {
                if (result == '@Constants.Mismatch') {
                    alertify.error("Challan data not available.");
                }
                else {
                    $('#gridChargeDetails').data('kendoGrid').dataSource.read();
                    $('#gridChargeDetails').data('kendoGrid').refresh();
                    $("#divChallanBody").html(result);
                    $("#divPrintChallan").modal('show');
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Network Error, please try again later.");
            }
        });
    }


