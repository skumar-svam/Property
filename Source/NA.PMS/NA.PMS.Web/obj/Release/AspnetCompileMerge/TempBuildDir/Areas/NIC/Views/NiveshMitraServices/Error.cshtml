
@{
    ViewBag.Title = "Request Service - Error";
    Layout = "~/Areas/NIC/Views/Shared/_Layout.cshtml";
}
<style>
    .gridTitle {
        font-size: 230% !important;
    }
</style>

<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="col-md-12" style="position:static">
        <div class="row">
            <div class="col-md-6 col-sm-6 col-xs-12"><center><h1 class="gridTitle">Request Service - Error </h1></center></div>
            <div class="col-md-6 col-sm-6 col-xs-12 mandatory"></div>
        </div>
    </div>
    <div class="col-md-12" style="position:static">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12"><center><h1 class="gridTitle" id="error_text"></h1></center></div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {

        @{
            if (TempData["ErrorMessage_NIC"] != null && TempData["ErrorMessage_NIC"] != "")
            {
                @:$("#error_text").html('@TempData["ErrorMessage_NIC"]');
            }
         }
    });
</script>

