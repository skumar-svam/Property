@*PopUp to print*@
<div id="divPrintPossession" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:20px;">
    <div class="modal-dialog" style="width: 65%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Possession Order Letter</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:480px;">
                <div id="divPossessionOrderBody"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv();">Print</button>
                <button type="button" id="downloadLetter" class="k-button">Download</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#divSigningAuthority").css("display", "none");
        //alert($("#Gender").val().toLowerCase());
        if ($("#Gender").val().toLowerCase() == "company") {
            $("#divSigningAuthority").show();
            $('#divParentsName').hide();
        }
        else {
            $("#divSigningAuthority").hide();
            $('#divParentsName').show();
        }
    });

    $("#btnPrint").click(function () {
        var rid = $("#Rid").val();
        var departmentId = $("#DepartmentId").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rid: rid, departmentId: departmentId }),
            url: '/Possession/PrintPossessionOrder',
            success: function (result) {

                $("#divPossessionOrderBody").html(result);
                $("#divPrintPossession").modal('show');
                //alertify.success(result);
            },
            error: function (obj) {
                alertify.error("Some error occured. Please try again later.");
            }
        });

    });

    $('#downloadLetter').click(function () {
        var rid = $("#Rid").val();
        var departmentId = $("#DepartmentId").val();
        var possession = '@NA.PMS.Common.PossessionType.Order.ToString()';
        window.location = "/Possession/DownloadPossessionLetter?rid=" + rid + "&departmentId=" + departmentId + "&possession=" + possession;
    });
</script>
