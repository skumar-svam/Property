@using Kendo.Mvc.UI

@{
    ViewBag.Title = "Manage Citizen Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="CitizenRequestServices">
    <div class="row">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Manage Citizen Requests</h1></div>
                <div class="col-md-6 col-sm-6 col-xs-12 col-btn">
                    @Html.ActionLink("Request Service", "Index", new { controller = "ServiceRequest", area = "Member" }, htmlAttributes: new { target="_blank"})
                </div>
            </div>
        </div>
        
        <div class="col-md-12 blnk-rw"></div>
       
        <div class="k-grid-content">
            @(Html.Kendo().Grid<NA.PMS.Model.CitizenRequestsModel>()
            .Name("gridCitizenReq")
                    .ToolBar(tools => tools.Excel())
                        .ToolBar(tools => tools.Pdf())
                        .Pdf(pdf => pdf
                            .AllPages()
                            .AvoidLinks()
                            .PaperSize("A4")
                            .Scale(0.8)
                            .Margin("2cm", "1cm", "1cm", "1cm")
                            .Landscape()
                            .RepeatHeaders()
                            .TemplateId("page-template")
                            .FileName("ServiceRequestReport.pdf")
                            .ProxyURL(Url.Action("Pdf_Export_Save", "Report"))
                        )
                        .Excel(excel => excel
                            .FileName("ServiceRequestReport.xlsx")
                            .AllPages(true)
                            .Filterable(true)
                            .ProxyURL(Url.Action("Excel_Export_Save", "Report"))
                        )
            .Columns(columns =>
            {
                columns.Bound(c => c.EncryptedRId).Hidden();
                columns.Bound(c => c.EncryptedRefNo).Hidden();
                columns.Bound(c => c.DepartmentId).Hidden();
                columns.Bound(c => c.ServiceId).Hidden();
                columns.Bound(c => c.RId).Title("Registration Id");//.ClientTemplate("<label class='hyperlinkcss' onclick='javascript:RedirectForServices(#=ServiceId#, #=RId#)'>#=RId#</label>");
                columns.Bound(c => c.RefNo).Title("Reference No");
                columns.Bound(c => c.Department).Title("Department");
                //columns.Bound(c => c.SectorName).Title("Sector");
                //columns.Bound(c => c.BlockName).Title("Block");
                columns.Bound(c => c.PropertyNo).Title("PropertyNo");
                //columns.Bound(c => c.PropNo).Title("Property No.");
                columns.Bound(c => c.ReqDate).Title("Request Date").Format("{0:dd/MM/yyyy}");
                //columns.Bound(c => c.SLA).Title("SLA (In Days)");
                columns.Bound(c => c.ServiceName).Title("Service Name");
                columns.Bound(c => c.Status).Title("Status");
                columns.Bound(c => c.RId).Title("Action").ClientTemplate("<a href='" + "/Member/CitizenRequests/ViewRequestDetails/#= Id #" + "'>View</a>").Sortable(false).Filterable(false);
                columns.Bound(c => c.RId).Title("").ClientTemplate("<a href='" + "/Member/CitizenRequests/CitizenChallan?regId=#= EncryptedRId #" + "&refid=#=EncryptedRefNo#" + "'>Create Challan</a>").Sortable(false).Filterable(false);
                columns.Bound(c => c.ReqDate).Title("Print Receipt").ClientTemplate("<a  onclick='javascript:OpenFile(this);'><center><span class='glyphicon glyphicon-print'></span></center></a>").Width(110).Filterable(false).Sortable(false);
                columns.Bound(c => c.ApplicantName).Hidden();
                columns.Bound(c => c.MobileNumber).Hidden();
                columns.Bound(c => c.SubDepartment).Hidden();
                columns.Bound(c => c.Description).Hidden();
            })
            .Sortable()
            .Filterable()
            .Resizable(resize => resize.Columns(true))
            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
            .AutoBind(true)
            .DataSource(dataSource => dataSource
                .Ajax()
                .Model(model => model.Id(c => c.RId))
                .ServerOperation(true)
                .Read(read => read.Action("GetCitizenRequests", "CitizenRequests")).PageSize(20)
            )
            )
        </div>
        </div>
    </div>

