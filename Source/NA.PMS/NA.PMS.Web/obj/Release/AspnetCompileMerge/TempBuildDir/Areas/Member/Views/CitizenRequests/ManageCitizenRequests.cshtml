<script type="text/javascript">
    $(document).ready(function () {

    })

    function RedirectForServices(serviceid, rid) {
        if (serviceid == 1) {
           // window.location.href = "/Property/PropertyRegistration/AddRentRequest" + "?id=" + rid;
        }
        if (serviceid == 2) {
            window.location.href = "/Property/PropertyRegistration/AddRentRequest" + "?id=" + rid;
        }
        if (serviceid == 3) {

        }
    }

    function OpenFile(row) {
        $("#windowDiv").empty();
        var tr = $(row).parent().parent();
        var RegistrationNo = $(tr).children("td:eq(4)").text();
        var ServiceRequestId = $(tr).children("td:eq(5)").text();   
        var DepartmentName = $(tr).children("td:eq(6)").text();
        var PropertyNo = $(tr).children("td:eq(7)").text();
        var CreatedDate = $(tr).children("td:eq(8)").text();
        var ApplicantName = $(tr).children("td:eq(14)").text();
        var MobileNo = $(tr).children("td:eq(15)").text();
        var SubDepartment = $(tr).children("td:eq(16)").text();
        //var Sector = $(tr).children("td:eq(7)").text();
        //var Block = $(tr).children("td:eq(8)").text();
        var ServiceName = $(tr).children("td:eq(9)").text();
        var Description = $(tr).children("td:eq(17)").text();
     
        $('#CreatedDate').text(CreatedDate);
        $('#ServiceRequestId').text(ServiceRequestId);
        $('#Registration_No').text(RegistrationNo != "" ? ("Registration No: "+ RegistrationNo) : "");
        $('#Name').text(ApplicantName);
        //$('#Property_No').text(Sector + "-/" + Block + "-" + PropertyNo);
        $('#Property_No').text(PropertyNo);
        $('#DepartmentName').text(DepartmentName);
        $('#SubDepartment').text(SubDepartment);
        $('#Mobile').text(MobileNo);
        $('#ServiceName').text(ServiceName);
        $('#lblDescription').text(Description);
        $("#IDWindow").data("kendoWindow").center();
        $("#IDWindow").data("kendoWindow").open();
    }

    $("#btnClose").click(function () {
        $("#IDWindow").data("kendoWindow").close();
    });

    function PrintAcknowledgementReciept() {
        var contents = document.getElementById("divAcknowledgementReceiptBody").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }


</script>