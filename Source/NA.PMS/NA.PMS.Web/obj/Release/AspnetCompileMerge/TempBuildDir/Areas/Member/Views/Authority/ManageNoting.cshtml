@model NA.PMS.Model.NotingViewModel
@using Kendo.Mvc.UI;
@using NA.PMS.Model

@{
    ViewBag.Title = "Manage Noting";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .form-group {
        /*padding-left: 10px !important;*/
    }
</style>


<div class="col-md-12 col-sm-12">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Noting Files</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                @*<a href='javascript:void(0);' alt="click to open Check List popup" class="" id="frcontractreviewchklstlink">Create File</a>*@
                <a href='/Member/Authority/Noting' target="_blank" class="">Create Noting File</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 content-top-spce">
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading" style="margin-bottom:12px;">Search</h2>
            <div class="form-bx1" >
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.Label("Registration Id")
                        @(Html.Kendo().DropDownListFor(m => m.RegistrationId)
                            .Filter("contains")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel("---select---")
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => transport.Read(read => read.Action("GetRegistrationIdListAsDataSource", "Authority", new { area = "Member" })))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(100);
                            })
                            .HtmlAttributes(new { style = "width:90%; float:right;" })
                        )
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.Label("Department")
                        @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                            .Filter("contains")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel("---select---")
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => transport.Read(read => read.Action("GetDepartmentListAsDataSource", "Authority", new { area = "Member" })))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(100);
                            })
                            .HtmlAttributes(new { style = "width:90%; float:right;" })
                        )
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.Label("File Number")
                        @Html.TextBoxFor(m => m.FileName, htmlAttributes: new { @class = "form-control", style="width:90%; float:right;" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group" style="text-align:center;">
                        <br />
                        <button type='button' id="btnSearchFilter" class='btn btn-default' value='Save' style="height:30px;margin-top:5px;">Search Filter</button>
                        <button type='button' id="btnClearSearch" class='btn btn-default' value='Save' style="height:30px;margin-top:5px;">Clear</button>
                    </div>

                </div>

            </div>

            <div class="col-md-12 k-grid-content">
                @(Html.Kendo().Grid<NotingViewModel>()
                      .Name("gridNotingDetails")
                      .Columns(columns =>
                      {
                          columns.Bound(c => c.Id).Title("Noting Id");//.ClientTemplate("<a href='" + "/Member/Authority/Noting/#= EncryptedRegistrationId #'>#=NotingFileId#</a>");
                          columns.Bound(c => c.RegistrationId).Title("Registration Id");//.ClientTemplate("<a href='" + "/Property/PropertyRegistration/ViewNotingDetails/#= EncodedRid #'>#=Rid#</a>");
                          columns.Bound(c => c.Department).Title("Department");
                          columns.Bound(c => c.FileName).Title("File Name");
                          columns.Bound(c => c.CreatedDate).Title("Created Date").Format("{0:dd-MM-yyyy}");
                          columns.Bound(c => c.CreatedBy).Title("Created By");
                          columns.Bound(c => c.Receiver).Title("Received By");
                          columns.Bound(c => c.ReceivedDate).Title("Received Date").Format("{0:dd-MM-yyyy}");
                      })
                      .Sortable()
                      .Filterable()
                      .Resizable(resize => resize.Columns(true))
                      .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                      .DataSource
                      (
                         dataSource => dataSource.Ajax().ServerOperation(true)
                        .Model(model => model.Id(p => p.Id))
                        .Read(read => read.Action("GetNotingFileDetailList", "Authority", new { area="Member"}).Data("FilterSearchParameter"))
                        .PageSize(10)
                        //.Group(g => g.Add(r => r.Department))
                      )
                )
            </div>

        </div>
    </div>
</div>


