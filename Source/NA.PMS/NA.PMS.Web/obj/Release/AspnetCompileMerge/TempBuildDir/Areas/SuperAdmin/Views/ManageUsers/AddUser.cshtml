@model NA.PMS.Model.UsersModel

@{
    ViewBag.Title = "Add User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .k-textbox {
        width: 100%;
    }
</style>

@using (Html.BeginForm("SaveUser", "ManageUsers", FormMethod.Post, new { enctype = "multipart/form-data", id = "userform" }))
{
    <div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
        <div class="row">
            <div class="col-md-12">
                <div class="row rw-spce">
                    <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Add User</h1></div>
                    <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
                </div>
            </div>
            <div class="col-md-12 blnk-rw"></div>
            <div class="col-md-12 content-top-spce">
                <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
                    <h2 class="blck-heading">User Information</h2>
                    <div class="form-bx">
                        <div class="row">
                            <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                                @Html.LabelFor(u => u.empID, htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(u => u.empID, new { @class = "form-control", @maxlength = "15" })
                                @Html.ValidationMessageFor(u => u.empID, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                                @Html.LabelFor(u => u.firstName, htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(u => u.firstName, new { @class = "form-control", @maxlength = "100" })
                                @Html.ValidationMessageFor(u => u.firstName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                                @Html.LabelFor(u => u.middleName)
                            </div>
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(u => u.middleName, new { @class = "form-control", @maxlength = "100" })
                                @Html.ValidationMessageFor(u => u.middleName, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                                @Html.LabelFor(u => u.lastName, htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(u => u.lastName, new { @class = "form-control", @maxlength = "100" })
                                @Html.ValidationMessageFor(u => u.lastName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                                @Html.LabelFor(u => u.mobile, htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(u => u.mobile, new { @class = "form-control", Value = "", @maxlength = "10" })
                                @Html.ValidationMessageFor(u => u.mobile, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                                @Html.LabelFor(u => u.email, htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(u => u.email, new { @class = "form-control", @maxlength = "150" })
                                @Html.ValidationMessageFor(u => u.email, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Department(s)", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-10 col-sm-9 col-xs-12 form-group">
                                @for (var i = 0; i < Model.depttIDs.Count(); i++)
                                {
                                    @Html.Raw("&nbsp;&nbsp;&nbsp;")
                                    @Html.HiddenFor(u => u.depttIDs[i].id)
                                    @Html.CheckBoxFor(u => u.depttIDs[i].isChecked)
                                    @Html.Raw("&nbsp;")
                                    @Html.DisplayFor(u => u.depttIDs[i].display)
                                }
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Sub Department(s)", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-9 col-sm-9 col-xs-12 form-group">
                                @for (var i = 0; i < Model.SubDepartmentList.Count(); i++)
                                {
                                    @Html.Raw("&nbsp;&nbsp;&nbsp;")
                                    @Html.HiddenFor(u => u.SubDepartmentList[i].Id)
                                    @Html.CheckBoxFor(u => u.SubDepartmentList[i].IsChecked)
                                    @Html.Raw("&nbsp;")
                                    @Html.DisplayFor(u => u.SubDepartmentList[i].CheckBoxName)
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="box-button text-center">
                    <input type="button" id="btnCancel" value="Cancel" class="btn btn-default" />
                    <input type="submit" id="btnSubmit" value="Add" class="btn btn-add" />
                </div>
            </div>
        </div>
    </div>

}


<script>
    $(document).ready(function () {
        $("#btnCancel").click(function () {
            window.location.href = '@Url.Action("ManageUsers", "ManageUsers")';
        });
        $("#btnSubmit").click(function () {
            if ($('input:checked').length < 1) {
                alertify.error("Please select atleast one Department");
                return false;
            }
        });

        //var subdepartlist = [];
        //$("input[name='subdepartment']:checked").change(function () {
        //    $.each($("input[name='subdepartment']:checked"), function () {
        //        subdepartlist.push($(this).val());
        //    });
        //    $("#subDepartment").val(subdepartlist);
        //    $("#SubDepartmentList").val(subdepartlist);
        //});
    });

    function ValidateDeptt() {
        if ($('input:checked').length < 1) {
            alert("Please select atleast one Department");
            return false;
        }
    }
</script>
