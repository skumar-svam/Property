<div id="divLetterBodyModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:20px;">
    <div class="modal-dialog" style="width: 65%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title"><b><span id="LetterHeading"></span></b></h4>
            </div>
            <div class="modal-body" id="divmodalbody" style="overflow:auto; height:480px;">
                <div>
                    <input type="hidden" name="btype" id="code128" value="code128">
                    <input type="hidden" id="bgColor" value="#FFFFFF" size="7">

                    <input type="hidden" id="color" value="#000000" size="7">

                    <input type="hidden" id="barWidth" value="1" size="3">

                    <input type="hidden" id="barHeight" value="50" size="3">

                    <input type="hidden" id="moduleSize" value="5" size="3">

                    <input type="hidden" id="quietZoneSize" value="1" size="3">

                    <input type="hidden" name="rectangular" id="rectangular">
                    <input type="hidden" id="posX" value="10" size="3">

                    <input type="hidden" id="posY" value="20" size="3">
                    <input type="hidden" id="css" name="renderer" value="css" checked="checked">

                </div>
                @*<div id="barcodeTarget" class="barcodeTarget"></div>*@
                <canvas id="canvasTarget" width="100" height="100"></canvas>
                <div id="divLetterBody"></div>

            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintLetter" class="k-button" data-dismiss="modal" onclick="PrintDiv();">Print</button>
                @*<input type="button" onclick="generateBarcode();" value="&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Generate the barcode&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;">*@
                <button type="button" id="downloadLetter" class="k-button">Download</button>
            </div>

        </div>
    </div>
</div>






<script type="text/javascript">

    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }

    $(document).ready(function () {

        $('#LeaserentpaidNo').hide();
        $('#ndcdate').hide();
        $('#IsPremiumPaid').val("Y");
        //$('#IsLeaseRentPaid').val("Y");

        $('#btnNDC').click(function () {
            var rid = $('#RegistrationId').data('kendoDropDownList').value();
            var propNo = $('#PropertyNo').val();
            var aplcnt = $('#Applicant').val();
            var addr = $('#Address').val();
            var regdate = $('#RegistryDate').data("kendoDatePicker").value();
            var prempaid = $('#IsPremiumPaid').data('kendoDropDownList').value();
            var rentpaid = $('#IsLeaseRentPaid').data('kendoDropDownList').value();

            //if one time lease rent paid is yes
            var ndcDate = $('#NDCDate').data("kendoDatePicker").value();

            //if one time lease rent paid is no
            var lyLeaseRentPaidUpto = $('#LastYearLeaseRentPaidUpto').val();
            var leaseAmount = $('#LeaseRentAmount').val();
            //var rentDues = $('#LeaseRentDues').val();
            //var lstRentPaidDate = $('#LeaseRentPaidDate').data("kendoDatePicker").value();
            //var leaseRentRAY = $('#LeaseRentRevisedAfterYear').data('kendoDropDownList').value();
            //var Percentage = $('#LeaseRentRevisedPercentage').data('kendoDropDownList').value();

            if (rid == "" || rid.length != 8) {
                alertify.error("Please enter Registration Id");
                return false;
            }
            if (prempaid != "") {
                if (prempaid == "Y") {

                    if (rentpaid != "") {
                        if (rentpaid == "Y") {
                            if (ndcDate == "" || ndcDate == null) {
                                alertify.error("Please enter ndc date.");
                                return false;
                            }
                            else {
                                $('#userform').submit();
                            }
                        }
                        if (rentpaid == "N") {
                            //if (rentDues == "") {
                            //    alertify.error("Please enter lease rent dues.");
                            //    return false;
                            //}
                            //if (lstRentPaidDate == "" || lstRentPaidDate == null) {
                            //    alertify.error("Please enter lease rent paid date.");
                            //    return false;
                            //}
                            //if (LyLeaseRentPaidUpto == "") {
                            //    alertify.error("Please enter last year lease rent paid upto.");
                            //    return false;
                            //}
                            //if (leaseRentRAY == "") {
                            //    alertify.error("Please enter lease rent revised after year.");
                            //    return false;
                            //}
                            //if (Percentage == "") {
                            //    alertify.error("Please enter percentage.");
                            //    return false;
                            //}

                            if (lyLeaseRentPaidUpto == "") {
                                alertify.error("Please enter lease rent paid upto");
                                return false;
                            }
                            if (leaseAmount == "") {
                                alertify.error("Please enter lease rent Amount");
                                return false;
                            }

                            $('#userform').submit();
                        }
                    }
                    else {
                        alertify.error("Please enter one time lease rent paid.");
                        return false;
                    }
                } else {
                    alertify.error("Please enter total premium paid to yes.");
                    return false;
                }
            } else {
                alertify.error("Please enter total premium paid.");
                return false;
            }
        });



        $('#btn-generate-letter').click(function () {
            GenerateNDCLetter();
        });

    });

    function GenerateNDCLetter() {
        $.ajax({
            type: "post",
            dataType: "json",
            contentType: "application/json;charset=utf-8",
            data: JSON.stringify({ RegistrationId: 10000013 }),
            url: '/Reports/Report/GenerateNDCLetter',
            success: function (result) {
                if (result != null) {
                    $("#divLetterBody").html(result);
                    //$("#inputdata").before("<div id='divBarcode' class='font-barcode' style='text-align:center;'></div>");
                    //generateBarcode();
                    //$('#divBarcode').html($('#inputdata').html());
                    //$('#inputdata').css("display", "none");
                    $("#divLetterBodyModal").modal('show');
                }
                else {
                    alertify.error("Property doesn't exist for this Rid");
                }
            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                alertify.error("Lease Rent doesn't exist for this Property, Please enter Lease Rent for this property.");
            }
        });
    }



    function GetApplicantDetails() {
        var rid = $('#RegistrationId').val().trim();
        if (rid != "" && rid.length == 8) {
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json;charset=utf-8",
                data: JSON.stringify({ registrationId: rid }),
                url: '@Url.Action("GetApplicantDetailsForNDC","Report")',
                success: function (result) {
                    if (result != null) {
                        $('#Applicant').val(result.Applicant);
                        $('#PropertyNo').val(result.PropertyNo);
                        $('#Address').val(result.Address);
                        $('#Mobile').val(result.Mobile);
                        $('#Email').val(result.Email);
                        $('#RegistryDate').data("kendoDatePicker").value(result.RegistryDate);
                        $('#LastYearLeaseRentPaidUpto').val(result.LastYearLeaseRentPaidUpto);
                        $('#LeaseRentAmount').val(result.LeaseRentAmount);
                        $('#NDCDate').data("kendoDatePicker").value(result.NDCDate);
                    }
                    else {
                        alertify.error("Property doesn't exist for this Rid");
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Lease Rent doesn't exist for this Property, Please enter Lease Rent for this property.");
                }
            });
        }
    }

