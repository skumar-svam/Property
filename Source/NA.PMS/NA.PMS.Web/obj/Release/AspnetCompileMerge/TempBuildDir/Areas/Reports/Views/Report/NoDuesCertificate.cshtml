    function LeaseRentStatusChange() {
        var status = $('#IsLeaseRentPaid').val();
        if (status == "N") {
            $('#ndcdate').hide();
            $("#LeaserentpaidNo").show()
        }
        else {
            $('#ndcdate').show();
            $("#LeaserentpaidNo").hide()
        }
    }    

