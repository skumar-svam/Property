@model NA.PMS.Model.NDCVeiwModel
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
<style type="text/css">
    .box {
        border: solid #e2e3e4;
        border-width: 0 1px 1px;
    }
</style>
<div class="col-md-12 divHeaderClass" id="divPropertyDetailHeader2">
    <h4 class="PropertyDetailHeader alot-prop-header">NDC Details</h4>
</div>
<br />
<div class="col-md-12 box">
    <div class="form-bx">
        <div class="row">
            <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                @Html.Label("Total Premium Paid")
            </div>
            <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                <label class="form-control">
                    @Html.DisplayFor(m => m.IsPremiumPaid)
                </label>
            </div>
            <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                @Html.Label("One Time Lease Rent Paid")
            </div>
            <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                <label class="form-control">
                    @Html.DisplayFor(m => m.IsLeaseRentPaid)
                </label>
            </div>
        </div>
        <div class="row">
            <div class=" col-md-2 col-sm-3 col-xs-12 form-group">
                @Html.Label("NDC Date")
            </div>
            <div class="col-md-4 col-sm-3 col-xs-12 form-group">                
                    @(Html.Kendo().DatePickerFor(model => model.NDCDate).HtmlAttributes(new { style = "width:100%;", @Readonly = "readonly" }))               
            </div>
            @{ 
                 if (Model.IsLeaseRentPaid == NA.PMS.Common.NDCOptions.Value_No)
                 {
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                        @Html.Label("Lease Rent Paid Upto")
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                        <label class="form-control">
                            @Html.DisplayFor(m => m.LastYearLeaseRentPaidUpto)
                        </label>
                    </div>
                 }
            }
        </div>
        <div class="row">
            <div class="col-md-12 form-group" style="text-align:center">
                <button id="btn-ndc" class="btn btn-primary btn-add" style="padding:6px 35px;">Generate NDC</button>
            </div>
        </div>
    </div>
</div>


<div id="LetterPopupWindow" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 60%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title"><b>No Dues Certificate</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:400px;">
                <div id="divNDCLetter"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintLetter();">Print</button>
            </div>
        </div>
    </div>
</div>



<script>
    $(document).ready(function () {
        $('#btn-ndc').click(function () {
            PrintNDCLetter();
        });
    });

    function PrintNDCLetter() {
        var rid = $("#hdnRID").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ RegistrationId: rid }),
            url: '/Property/PropertyAllotment/GenerateNDCByRegistrationId',
            success: function (result) {
                $("#divNDCLetter").html(result.LetterContent);
                $("#LetterPopupWindow").modal('show');
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Network Error. Try again later");
            }
        });
    }

    function PrintLetter() {
        var contents = document.getElementById("divNDCLetter").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }
</script>