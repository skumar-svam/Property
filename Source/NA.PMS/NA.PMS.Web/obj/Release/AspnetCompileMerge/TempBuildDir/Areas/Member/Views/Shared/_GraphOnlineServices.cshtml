    function GetInProcessOnlineServiceListForGraph() {
        var today = new Date().toDateString();
        var departmentId = $('#OnlineServiceDepartmentId').val();
        var startDate = $('#OnlineServiceStartDate').val();
        var endDate = $('#OnlineServiceEndDate').val();
        var reqThrough = "Online";
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ DepartmentId: departmentId, StartDate: startDate, EndDate: endDate, RequestThrough: reqThrough, FilterType: "PendingServices" }),
            url: '/Reports/Report/GetServiceReportsForGraphII',
            success: function (result) {
                if (result != null) {
                    //CreateTotalOnlineServiceRequestChart(result);
                    CreateTotalOnlineServiceInProcessPieChart(result);
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Network error, Please try again later.");
            }
        });
    }

