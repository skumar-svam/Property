@model NA.PMS.Model.UserViewModel
@using Kendo.Mvc.UI;
@using System.Web.Optimization;
@using NA.PMS.Common;

@{
    ViewBag.Title = "Manage Customers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style type="text/css">
    .k-window div.k-window-content {
        overflow: hidden;
    }

    div#UserListGrid .k-grid-content {
        min-height: 50px;
        max-height: 600px;
    }

    .view-docs {
        color: blue;
        text-decoration: underline;
    }

    .view-docs:hover {
        color: blue;
        cursor: pointer;
        text-decoration: underline;
    }
    /*td.td-active1{
        padding:0;
        background-color:green;
        color:#fff;
    }*/
     /*.td-active{
        background-color:green;
        color:#fff;
    }*/
      .td-action:hover{
        cursor:pointer;
    }
    td .k-button{
        width:100%;
    }
</style>

<div class="manage-customers">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Customers</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                <a href="/Admin/Application/Index"  target="_blank">Register</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12" style="border:solid #e2e3e4; border-width:0 1px 1px">
        <div>
            @Html.HiddenFor(model => model.Id)
            @Html.HiddenFor(model => model.UserName)
        </div>
        <div class="row">
            <div class="col-md-3 form-group">
                <label>Department</label>
                @(Html.Kendo().DropDownListFor(model => model.DepartmentId)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetDepartmentListAsDataSource", "Application", new { area = "Admin" })))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                    .Events(e => e.Change("CustomerGridEvent"))
                   .HtmlAttributes(new { style = "width:95%;float:right;", @class = "input-disabled" })
                )
            </div>
            <div class="col-md-3 form-group">
                <label>Status</label>
                @(Html.Kendo().DropDownListFor(model => model.IsActive)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("IsActive")
                    .OptionLabel(" -- Select --")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetUserStatusListAsDataSource", "Application", new { area = "Admin" })))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                     .Events(events => { events.Change("CustomerGridEvent"); })
                    .HtmlAttributes(new { @class = "input-disabled", style = "width:95%;float:right;" })
                )
            </div>
        </div>
    </div>
    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.Model.UserViewModel>()
            .Name("CustomerListGrid")
            .Columns(columns =>
            {
                columns.Bound(p => p.Id).Visible(false);
                columns.Bound(p => p.RoleId).Visible(false);
                columns.Bound(p => p.UserName).Title("User Name").Width(130);
                columns.Bound(p => p.Department).Title("Department").Width(130);
                columns.Bound(p => p.FullName).Title("Customer").HtmlAttributes(new { @class = "longTextPopup" });
                columns.Bound(p => p.PropertyId).Width(140).Title("Property No").ClientTemplate("# {#<a href='/Property/PropertyDetail/#=PropertyId#'>#=PropertyNo#</a>#}#").HtmlAttributes(new { @class = "longTextPopup" });
                columns.Bound(p => p.MobileNo).Width(120).Title("Mobile No");               
                columns.Bound(p => p.Email).Width(160).Title("Email");
                columns.Bound(p => p.CreatedOn).Width(120).Title("Date").Format("{0:dd-MMM-yyyy}");
                columns.Bound(p => p.Status).Width(100).Title("Status").ClientTemplate("#if(IsRejected == true) {#<label class=='rej'>Rejected</label> #} else if(Status == true) {# <label class='act'>Active</label> #} else{#<label class='inact'>InActive</label> #}#").HtmlAttributes(new { @class="td-active1"});
            })
            .Filterable().Resizable(resize => resize.Columns(true))
            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(new[] { 10, 20, 50, 100 }).Info(true).PreviousNext(true).Input(true).Numeric(true).ButtonCount(10))
            .ClientDetailTemplateId("template")
            .AutoBind(true)
            .DataSource(dataSource => dataSource
                .Ajax()
                .ServerOperation(true) // paging, sorting, filtering and grouping will be applied client-side
                .Read(read => read.Action("GetPropertyCustomersList", "Application", new { area = "Admin" }).Data("FilterSearchParameter"))
                .Model(model =>model.Id(x=>x.Id))
                .Sort(s=>s.Add(o=>o.Id).Descending())
                //.Events(events => events.Error("error_handler"))
            )
        )
    </div>

</div>

<div class="col-md-12 popup-window" id="document-window">
    <div style="width:100%">
        <img alt="Document" id="document-link" style="max-width:100%" />
    </div>
</div>


<div class="col-md-12" id="comment-box" style="min-height:200px;background:url(/Content/Images/boxed-bg.jpg) repeat;">
    <div class="row">
        <div class="col-sm-12 form-group" style="margin-top:12px;">
            <label>Reason for Rejection</label>
            <textarea class="k-textbox" id="txtRemarks" maxlength="200" onkeypress=" return IsAlpha(event);" style="width:100%; height:70px;"></textarea>           
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 form-group">
            <input type="button" class="k-button" id="btnSubmit" value="Submit" style="width:100%;background-color:blue; color:#fff;"/>
        </div>
    </div>
</div>

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<NA.PMS.Model.UserViewModel>()
            .Name("grid_#=Id#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(p => p.UserName).Hidden(true);
                columns.Bound(p => p.CustomerIdFileName).Hidden(true);
                columns.Bound(p => p.AuthorityLetter).Hidden(true);
                columns.Bound(p => p.IsActive).Title("Status").ClientTemplate("<input type='button' class='k-button' value='#if(IsActive == true){# Active #}else{# InActive #}#' onclick='javascript:ToggleActivation(this)'>").HtmlAttributes(new { @class = "td-active td-action" });
                columns.Bound(p => p.IsLocked).Title("Locked").ClientTemplate("<input type='button'  class='k-button' value='#if(IsLocked == true){# Unlock #} else{# Lock #}#' onclick='javascript:LockUnLockCustomer(this);'>");
                //columns.Bound(p => p.IsRejected).Title("Activate").ClientTemplate("#if(IsRejected == true){#<input type='button' value='Approve' onclick='javascript:ApprovalAction(this);' class='k-button'>#}else {#<input type='button' value='Reject' onclick='javascript:ApprovalAction(this);' class='k-button'>#}#");
                columns.Bound(p => p.Pasword).Title("Reset Password").ClientTemplate("<input type='button' value='Reset' onclick='javascript:ResetPassword(this);' class='k-button'>");
                columns.Bound(p => p.Remarks).Title("Remarks").ClientTemplate("<input type='button' value='Reject' onclick='javascript:OpenRemarksPopUp(this);' class='k-button'>").HtmlAttributes(new { @class = "td-link" });
                columns.Bound(p => p.CustomerIdFileName).Title("Id Document").ClientTemplate("#if(IsIdFileUploaded == true){# <a onclick='javascript:OpenCustomerFile(this);' class='view-docs'>View</a> #}else{# <label>NA</label> #}#");
                columns.Bound(p => p.AuthorityLetter).Title("Letter Document").ClientTemplate("#if(IsPropertyFileUploaded == true){#<a onclick='javascript:OpenLetterFile(this);' class='view-docs'>View</a>#}else{# <label>NA</label> #}#");
                columns.Bound(p => p.IsApproved).Width(120).Title("Action").ClientTemplate("#if(IsApproved==true){# <label>Approved</label> #}else{#<input type='button' class='k-button' onclick='javascript:ApproveCustomer(this)' value='Approve'/>#}#").HtmlAttributes(new { @class = "td-btn-approve" });
                //columns.Bound(o => o.RequestDate).Format("{0:dd/MM/yyyy}").Width(120);
            })
            .DataSource(dataSource => dataSource
                .Ajax().Read(read => read.Action("GetPropertyCustomersListById", "Application", new { username = "#=UserName#" }))
            )
            .ToClientTemplate()
    )
</script>
<script>
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
</script>


