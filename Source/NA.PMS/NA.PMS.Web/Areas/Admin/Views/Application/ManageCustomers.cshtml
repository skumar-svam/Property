<script type="text/javascript">

    function FilterSearchParameter() {
        return {
            DepartmentId: $('#DepartmentId').val(),
            IsActive: $('#IsActive').val()
        }       
    }

    function CustomerGridEvent() {
        $("#CustomerListGrid").data("kendoGrid").dataSource.read();
    }

    function OpenRemarksPopUp(row) {
        var flag = confirm('Are you sure you want to update remarks?');
        if (flag == true) {
            var tr = $(row).parent().parent();
            var username = $(tr).children("td:eq(0)").text();
            $('#UserName').val(username);
            $("#comment-box").data("kendoWindow").center();
            $("#comment-box").data("kendoWindow").open();
            //return false;
        }
    }

    function ToggleActivation(row) {
        var status = confirm('Are you sure you want to change status of user?');
        if (status == true) {
            var tr = $(row).parent().parent();
            var username = $(tr).children("td:eq(0)").text();
            //var mobileNo = $(tr).children("td:eq(1)").text();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ UserName: username, ActionType: "Active" }),
                url: '/Admin/Application/UpdateCustomerStatus',
                success: function (result) {
                    if (result == '@ReturnType.Updated') {
                        alertify.success("User updated successfully.");
                    }

                    $("#CustomerListGrid").data("kendoGrid").dataSource.read();
                    //$("#UserListGrid").data("kendoGrid").dataSource.read();
                },
                error: function (obj) {
                }
            });
        }
    }

    function ApproveCustomer(row) {
        var status = confirm('Are you sure you want to approve allottee?');
        if (status == true) {
            var tr = $(row).parent().parent();
            var username = $(tr).children("td:eq(0)").text();
            //var mobileNo = $(tr).children("td:eq(1)").text();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ UserName: username, ActionType: "Approval" }),
                url: '/Admin/Application/UpdateCustomerStatus',
                success: function (result) {
                    if (result == '@ReturnType.Updated') {
                        alertify.success("User updated successfully.");
                    }

                    $("#CustomerListGrid").data("kendoGrid").dataSource.read();
                    //$("#UserListGrid").data("kendoGrid").dataSource.read();
                },
                error: function (obj) {
                }
            });
        }
    }

    function SaveRemarks() {
        var remarks = $('#txtRemarks').val();
        var username = $('#UserName').val();
        var userid = $('#UserId').val();
        if (remarks.trim() != '' && username.trim() != "") {
            //wnd.center().close();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ ActionType: "Remarks", Remarks: remarks, UserName: username, UserId: userid }),
                url: '/Admin/Application/UpdateCustomerStatus',
                success: function (result) {
                    if (result == '@ReturnType.Rejected') {
                        alertify.success("User Rejected successfully.");
                    }
                    else alertify.success("User updated successfully");
                    $("#CustomerListGrid").data("kendoGrid").dataSource.read();
                    //$("#UserListGrid").data("kendoGrid").dataSource.read();
                },
                error: function (obj) {
                }
            });
        }
        else {
            alert("Blank space and special characters are not allowed")
        }
    }

    function ApprovalAction(row) {
        var tr = $(row).parent().parent();
        var username = $(tr).children("td:eq(0)").text();
        var statusText = $(tr).children("td:eq(5)").children("input:button").val();
        $('#UserName').val(username);
        var flag = confirm('Are you sure you want to ' + statusText.trim() + ' user?');
        if (flag == true && statusText.trim() == "Reject") {
            $("#comment-box").data("kendoWindow").center();
            $("#comment-box").data("kendoWindow").open();
        }
        else {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ UserName: username, ActionType: "Approval" }),
                url: '/Admin/Application/UpdateCustomerStatus',
                success: function (result) {
                    if (result == '@ReturnType.Updated') {
                        alertify.success("User updated successfully.");
                    }

                    $("#CustomerListGrid").data("kendoGrid").dataSource.read();
                    //$("#UserListGrid").data("kendoGrid").dataSource.read();
                },
                error: function (obj) {
                }
            });
        }
    }

    function ResetPassword(row) {
        var flag = confirm('Are you sure you want to Reset User Password?');
        if (flag == true) {
            var tr = $(row).parent().parent();
            var username = $(tr).children("td:eq(0)").text();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ UserName: username, ActionType: "Password" }),
                url: '/Admin/Application/UpdateCustomerStatus',
                success: function (result) {
                    if (result == '@ReturnType.Updated') {
                        alertify.success("User password reset successfully.");
                    }
                    else alertify.error("Provider failed to update");
                    $("#CustomerListGrid").data("kendoGrid").dataSource.read();
                    //$("#UserListGrid").data("kendoGrid").dataSource.read();
                },
                error: function (obj) {
                }
            });
        }
    }


    function LockUnLockCustomer(row) {
        var tr = $(row).parent().parent();
        var username = $(tr).children("td:eq(0)").text();      
        var statusText = $(tr).children("td:eq(4)").children("input:button").val();
        var flag = confirm('Are you sure you want to ' + statusText.trim() + ' Customer?');
        if (flag == true) {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ UserName: username, ActionType: "Locked" }),
                url: '/Admin/Application/UpdateCustomerStatus',
                success: function (result) {
                    if (result == '@ReturnType.Locked') {
                        alertify.success("User Locked successfully.");
                    }
                    else { alert("User Unlocked successfully."); }
                    $("#CustomerListGrid").data("kendoGrid").dataSource.read();
                },
                error: function (obj) {
                }
            });
        }
    }

    //$(document).ready(function () {
    //    setCurrentTab('admi')

    //});
</script>

