</div>

<div id="progressbar" style="width:100%; text-align:center;">
    <div id="loader" style="position: fixed;top:210px; left:0;  width:100%; height: 100%;  ">
        <img src="~/Content/Images/ajax_loader_red.gif" style="width:200px;height:200px;" />
        @*<img src="~/Content/Images/Chimply_progress.gif" style="width:200px;height:200px;background:#e2e3e4;" />*@
    </div>
</div>

<script type="text/javascript">
    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }

    function ChangeInAllotteeType() {
        //alert("change in allottee type");
        if ($('#AllotteeType').val() == "Company") {
            $('#lbl-allottee-name').text("Name Of Organisation");
            $('#lbl-mobile-no').text("Organisation's Contact No");
            $('#lbl-email').text("Organisation's Email Id");
            $('#lbl-idproof').text("Organisation PAN/GST Reg.");
            $('#lbl-pan').text("Organisation PAN")
            $('.row-company').show();
            $('.col-company').show();
            $('.col-individual').css("display", "none");
        }
        else {
            $('#lbl-allottee-name').text("Allottee Name");
            $('#lbl-mobile-no').text("Allottee's Mobile No");
            $('#lbl-email').text("Allottee's Email Id");
            $('#lbl-idproof').text("Id Proof")
            $('#lbl-pan').text("Allottee PAN")
            $('.row-company').css("display", "none");
            $('.col-company').css("display", "none");
            $('.col-individual').show();
        }

        $('#AllotteeIdFileType').data('kendoDropDownList').dataSource.read();
        $('#PlotOwnershipFileType').data('kendoDropDownList').dataSource.read();
    }

    function ReadDropdownParameter() {
        $('#SectorId').data('kendoDropDownList').dataSource.read();
        $('#BlockId').data('kendoDropDownList').dataSource.read();
        $('#PlotNo').data('kendoDropDownList').dataSource.read();
    }

    function GetAllotteeDetails() {
        var sectorId = $('#SectorId').val();
        var blockId = $('#BlockId').val();
        var plotNo = $('#PlotNo').val();
        if (sectorId != "" && blockId != "" && plotNo != "") {
            var kya = {
                SectorId: sectorId,
                BlockId: blockId,
                PlotNo: plotNo
            };
            $.ajax({
                url: '@(Url.Action("GetPropertyDetailForKYA", "Property", new { area="Customer"}))',
                type: 'POST',
                dataType: 'json',
                data: { model: kya },
                success: function (result) {
                    if (result != null) {
                        if (result.ActionId == '@ReturnType.NotExist') {
                            alertify.error("Contact Authority for this property");
                            return false;
                        }
                        if (result.ActionId == '@ReturnType.Exist') {
                            alertify.error("KYA form has been submitted for this prorperty.");
                            return false;
                        }
                        else {
                            $('#RegistrationId').val(result.RegistrationId);
                            $('#AllotteeType').val(result.AllotteeType);
                            $('#AllotteeName').val(result.AllotteeName);
                            $('#CorrespondAddress').val(result.CorrespondAddress);
                            $('#MobileNo').val(result.MobileNo);
                            $('#Email').val(result.Email);
                            $('#AuthorizedSignatory').val(result.AuthorizedSignatory);
                            $('#GSTNo').val(result.GSTNo);
                            $('#DepartmentId').val(result.DepartmentId);
                            $('#Department').val(result.Department);
                            ChangeInAllotteeType();
                        }
                    }
                }
            });
        }
    }

    function FilterAllotteeType() {
        return {
            ActionType: $('#AllotteeType').val()
        };
    }

    function FilterSectorParameter() {
        return {
            ActionType: "Sector",
            SchemeId: null,
