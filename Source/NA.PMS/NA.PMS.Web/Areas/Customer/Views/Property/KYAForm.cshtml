    function CheckUserImage(input) {
        var file = input.files[0].name;
        var count = file.lastIndexOf('.') + 1;
        var ext = file.substr(count);
        if (ext.toLowerCase() == "jpg" || ext.toLowerCase() == "pdf") {
            return true;
        }
        else {
            alertify.error("Only jpg/pdf file allowed.");
            return false;
        }
    }


    function ValidateEmail(email) {
        var expr = /^([\w-\.]+)@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$/;
        return expr.test(email);
    };


    function PanNumberChange() {
        if ($("#PAN").val().trim() == '') {
            $("#PAN").val('');
        }
        var bool = CheckPanNoFormat();
        if (bool == false) {
            alertify.error("Pan Number format is wrong.");
            $("#PAN").val('');
            return false;
        }
    }
    function CheckPanNoFormat() {
        var value = $("#PAN").val().trim();
        var regex1 = /^[A-Z]{5}\d{4}[A-Z]{1}$/;
        if (!regex1.test(value) || value.length != 10) {
            return false;
        }
        return true;
    }


