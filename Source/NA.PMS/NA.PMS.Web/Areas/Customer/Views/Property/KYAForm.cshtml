        </div>
        <div class="col-md-3 col-sm-12 col-xs-12" style="padding:0;">
            <input class="k-button" type="button" value="Resend" id="btnResend" style="width:150px;"/>
        </div>
    </div>
    <div class="row form-group" style="margin:15px 0 15px 0;">
        <div class="col-md-4 col-sm-4 col-xs-12"></div>
        <div class="col-md-4 col-sm-4 col-xs-12">
            <input type="button" class="k-button btn btn-primary" id="btnMobileOTP" value="submit" style="width:100%" />
        </div>
