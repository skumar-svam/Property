@model NA.PMS.Model.KYAViewModel
@using Kendo.Mvc.UI
@using NA.PMS.Common

@{
    ViewBag.Title = "KYA Form";
    //Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
    Layout = "~/Views/Shared/_BlankCustomer.cshtml";
}
<script src="//code.jquery.com/ui/1.11.2/jquery-ui.js"></script>

<style type="text/css">
    .textBoxWidth {
        width: 50px;
    }
    textarea.form-control{
        /*height:34px;*/
    }

    .row-company{
        display:none;
    }
    .col-company{
        display:none;
    }
    .glyphicon.glyphicon-arrow-right{
            color: #fff;
            background-color: #204d74;
            border-color: #122b40;
            padding:11px 18px;
    }
    .col-md-3.col-sm-6.col-xs-12.form-group.col-file{
        margin-top:6px;
        margin-bottom:6px;
    }

    input[type=file] {
        padding-top:4px;
    }
    #kya-form-content{
        display:none;
