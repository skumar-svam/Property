                        .DataTextField("Text")
                        .DataValueField("Id")
                        .OptionLabel(" -- Select --")
                        .Enable(true)
                        .AutoBind(true)
                        .Filter("contains")
                        .DataSource(source =>
                        {
                            source.Custom()
                            .ServerFiltering(true)
                            .ServerPaging(true)
                            .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                            .Transport(transport => transport.Read(read => read.Action("GetMasterSearchParameterAsDataSource", "Property", new { area = "Customer" }).Data("FilterSectorParameter")))
                            .Schema(schema => schema.Data("Data").Total("Total"))
                            .PageSize(100);
                        })
                        .HtmlAttributes(new { style = "width:100%; float:right;", @class = "input-disabled" })
                        .Events(e => e.Change("ChangeInSector"))
                    )
                </div>
                <div class="col-md-3 col-20 col-sm-12 form-group">
                    @Html.Label("Block", new { @class = "required" })
                </div>
                <div class="col-md-3 col-30 col-sm-6 col-xs-12 form-group">
                    @(Html.Kendo().DropDownListFor(m => m.BlockId)
                        .Filter("contains")
                        .DataTextField("Text")
                        .DataValueField("Id")
                        .OptionLabel(" -- Select --")
                        .CascadeFrom("SectorId")
                        .CascadeFromField("SectorId")
                        .DataSource(source =>
                        {
                            source.Custom()
                            .ServerFiltering(true)
                            .ServerPaging(true)
                            .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                //.Transport(transport => transport.Read(read => read.Action("GetMasterSearchParameterAsDataSource", "Property", new { area = "Customer" }).Data("FilterBlockParameter")))
                            .Transport(transport => transport.Read(read => read.Action("GetMasterSearchParameterAsDataSource", "Property", new { area = "Customer" }).Data("FilterBlockParameter")))
                            .Schema(schema => schema.Data("Data").Total("Total"))
                            .PageSize(100);
                        })
                        .Events(events => { events.Change("ChangeInBlock"); })
                        .HtmlAttributes(new { @class = "input-disabled", style = "width:100%; float:right;" })
                    )
                </div>

            </div>

            <div class="row">
                <div class="col-md-3 col-20 col-sm-12 form-group">
                    @Html.Label("Plot/Flat", new { @class = "required" })
                </div>
                <div class="col-md-3 col-30 col-sm-6 col-xs-12 form-group">
                    @(Html.Kendo().DropDownListFor(m => m.PlotNo)
                        .Filter("contains")
                        .DataTextField("Text")
                        .DataValueField("Value")
                        .OptionLabel(" -- Select --")
                        .CascadeFrom("BlockId")
                        .CascadeFromField("BlockId")
                        .DataSource(source =>
                        {
                            source.Custom()
                            .ServerFiltering(true)
                            .ServerPaging(true)
                            .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                            .Transport(transport => transport.Read(read => read.Action("GetMasterSearchParameterAsDataSource", "Property", new { area = "Customer" }).Data("FilterPlotParameter")))
