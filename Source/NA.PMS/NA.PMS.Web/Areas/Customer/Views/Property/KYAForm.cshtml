@using (Html.BeginForm("SaveKYAForm", "Property", new { area = "Customer" }, FormMethod.Post, new { enctype = "multipart/form-data", id = "userform" }))
{
    @Html.AntiForgeryToken()
    <div class="user-template" style="padding-top:30px;">
        <div class="col-md-12">
            <div class="row row-heading">
                <div class="col-md-4 col-20 col-sm-6 col-xs-12"><h1 class="h1-title">KYA Form</h1></div>
                <div class="col-md-8 col-80 col-sm-6 col-xs-12" style="text-align:right;">
                    <b>[ Help line No. :- 0120-2425027, Email: helpdesk@noidaauthorityonline.com (Mon-Fir, 10:00AM - 5:00PM)] </b> <br />
                    Fields marked with an asterisk (<span class="star">*</span>) are required.
                </div>
            </div>
        </div>
        <div class="col-md-12  hr-div"></div>
        <div class="col-md-12" id="kya-instruction">
            @{
                Html.RenderPartial("_KYAInstruction");
             }
        </div>

        <div class="col-md-12 content-border" id="kya-form-content" style="border:solid #e2e3e4; border-width:0 1px 1px; margin-bottom:15px;">
            <div class="row">
                <input type="hidden" id="hdnOTP" />
                @Html.HiddenFor(model=>model.DepartmentId)
            </div>
            <div class="row">
                <div class="col-md-12">
                    <h2 class="grid-title">Allottee Information</h2>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12" style="height:12px;">
