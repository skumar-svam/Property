@model NA.PMS.Web.Models.PasswordModel
@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .k-textbox{
        width:100%;
    }
</style>
<div class="container-fluid">
    <div class="row">
        <div class="col-sm-8 col-sm-offset-2 panel" style=" background-color: #00ffff; padding-bottom: 30px;">
            @using (Html.BeginForm("ChangeNewPassword", "ManageUsers", FormMethod.Post))
            {
                <div class="row form-group">
                    <div class="col-sm-12">
                        <h3>Change Password</h3><hr />
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-sm-7 col-sm-offset-4">
                       @Html.ValidationMessageFor(model => model.PasswordMessage)
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-sm-3 col-sm-offset-1">
                        <label>Old Password</label>
                    </div>
                    <div class="col-sm-7">
                        @*<input type="password" name="oldPassword" class="k-textbox" />*@ 
                        @Html.PasswordFor(model => model.OldPassword, new { @class = "k-textbox" })
                        @Html.ValidationMessageFor(model => model.OldPassword)
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-sm-3 col-sm-offset-1">
                        <label>New Password</label>
                    </div>
                    <div class="col-sm-7">
                        @*<input type="password" name="newPassword" class="k-textbox" />*@
                        @Html.PasswordFor(model => model.NewPassword, new { @class = "k-textbox" })
                        @Html.ValidationMessageFor(model => model.NewPassword)
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col-sm-3 col-sm-offset-1">
                        <label>Confirm New Password</label>
                    </div>
                    <div class="col-sm-7">
                        @*<input type="password" name="confirmNewPassword" class="k-textbox" />*@
                        @Html.PasswordFor(model => model.ConfirmNewPassword, new { @class = "k-textbox" })
                        @Html.ValidationMessageFor(model => model.ConfirmNewPassword)
                    </div>
                </div>
                <div class="row form-group" style="padding-top: 12px;">
                    <div class="col-sm-5 col-sm-offset-1">
                        <button class="btn btn-block" type="submit" style="background-color: #ff006e; color: #ffffff;">Submit</button>
                    </div>
                    <div class="col-sm-5">
                        <button class="btn btn-block" type="reset" style="background-color: #ff006e; color: #ffffff;">Cancel</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
