@model NA.PMS.Model.RolesModel
@using Kendo.Mvc.UI;

@{
    ViewBag.Title = "View Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="row">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">View Admin Role</h1></div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <h2 class="blck-heading">Role Information</h2>
                <div class="form-bx">
                    <div class="row">
                        @Html.HiddenFor(model => model.RoleId)
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.LabelFor(model => model.ApplicationName)
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(model => model.ApplicationId)
                                .Name("applications")
                                .DataTextField("ApplicationName")
                                 .DataValueField("ApplicationId")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("GetApplications", "ManageAdminRoles");
                                    });
                                })
                                .HtmlAttributes(new { style = "width: 100%" })
                            )
                        </div>

                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">

                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.LabelFor(model => model.RoleName)
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(model => model.RoleName, new { @class = "form-control", @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                            @Html.LabelFor(model => model.RoleDescription)
                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                            @Html.TextAreaFor(model => model.RoleDescription, new { @class = "form-control", @disabled = "disabled" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 col-sm-3 col-xs-12 form-group">

                        </div>
                        <div class="col-md-4 col-sm-3 col-xs-12 form-group">

                        </div>
                    </div>
                </div>
            </div>
            <div class="box-button text-center">
                <input type="button" id="btnBack" value="Back" class="btn btn-default" onclick="javascript: window.location = '@Url.Action("ManageAdminRoles", "ManageAdminRoles")';" />
            </div>
        </div>
    </div>
</div>



<script>
    $(document).ready(function () {
        $('#RoleName').attr('disabled', 'disabled');
       // $('#RoleName').css('background-color', 'gray');
        $('#RoleDescription').attr('disabled', 'disabled');
        $('#applications').attr('disabled', 'disabled');
        $("#applications").data("kendoDropDownList").enable(false);
    });
</script>