@model NA.PMS.Model.OnlineFormViewModel
@using Kendo.Mvc.UI
@using NA.PMS.Common
@using NA.PMS.Model

@{
    ViewBag.Title = "Scheme Draw";
    Layout = "~/Views/Shared/_LayoutOnline.cshtml";
}


@using (Html.BeginForm("AllotPropertyAfterDraw", "Application", FormMethod.Post, new { enctype = "multipart/form-data", id = "applicationform" }))
{ 
    <div class="scheme-draw">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Scheme Draw</h1></div>
                <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce" id="first-form">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px" id="divApplicantInformation">
                <h2 class="blck-heading" style="margin-bottom:6px;">Applicant Information</h2>
                <div class="form-bx">
                    <div class="row">
                        
                        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                            @Html.Label("Scheme Name", htmlAttributes: new { @class = "required" })
                            @(Html.Kendo().DropDownListFor(model => model.SchemeId)
                                .DataTextField("Text")
                                .DataValueField("Id")
                                .OptionLabel(" -- Select --")
                                .DataSource(source => source.Read(read => read.Action("GetSchemeList", "Application")))
                                .Enable(true)
                                .AutoBind(true)
                                .Filter("contains")
                                .Events(e=>e.Change("GetAllottedProperty"))
                                .HtmlAttributes(new { style = "width:90%; float:right;", @class = "input-disabled" })
                            )
                            @Html.ValidationMessageFor(model => model.SchemeId, "", new { @class = "text-danger" })
                        </div>
                        
                        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                            @Html.Label("Department", htmlAttributes: new { @class = "required" })
                            @(Html.Kendo().DropDownListFor(model => model.DepartmentId)
                                .DataTextField("Text")
                                .DataValueField("Id")
                                .OptionLabel(" -- Select --")
                                .DataSource(source => source.Read(read => read.Action("GetDepartmentListByScheme", "Application").Data("FilterSchemeId")).ServerFiltering(true))
                                .Enable(true)
                                .AutoBind(true)
                                .Filter("contains")
                                .CascadeFrom("SchemeId")
                                .Events(e => e.Change("GetAllottedProperty"))
                                .HtmlAttributes(new { style = "width:90%; float:right;", @class = "input-disabled" })
                            )
                            @Html.ValidationMessageFor(model => model.DepartmentId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                            @Html.Label("Application Id", htmlAttributes: new { @class = "required" })                           
                            @(Html.Kendo().DropDownListFor(model => model.ApplicationFormId)
                                .Filter("contains")
                                .DataTextField("Text")
                                .DataValueField("Id")
                                .OptionLabel("---Select---")
                                .AutoBind(false)
                                //.CascadeFrom("SchemeId")
                                .DataSource(source =>
                                {
                                    source.Custom()
                                   .ServerFiltering(true)
                                   .ServerPaging(true)
                                   .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                   .Transport(transport => transport.Read(read => read.Action("GetOnlineApplicationFormIdList", "Application").Data("FilterSchemeAndDepartmentId")))
                                   .Schema(schema =>schema.Data("Data").Total("Total"))
                                   .PageSize(100);
                                })
                                .Events(events => { events.Change("GetApplicantDetails"); })
                                .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                            )
                            @Html.ValidationMessageFor(model => model.ApplicationFormId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                            @Html.Label("Scheme Draw Date", htmlAttributes: new { @class = "required" })
                            @(Html.Kendo().DatePickerFor(model => model.SchemeDrawDate).HtmlAttributes(new { style = "width:90%;float:right;", @class = "input-disabled" }))
                            @Html.ValidationMessageFor(model => model.SchemeDrawDate, "", new { @class = "text-danger" })
                        </div>
                        
                    </div>

                    <div class="row">
                       
                        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                            <label>Sector</label>
                            @Html.TextBoxFor(model => model.Sector, htmlAttributes: new { @class = "form-control", @maxlength="15", @style = "width:90%; float:right;" })
                        </div>
                        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                            <label>Block</label>
                            @Html.TextBoxFor(model => model.Block, htmlAttributes: new { @class = "form-control", @maxlength = "15", @style = "width:90%; float:right;" })
                        </div>
                        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                            <label>Plot No</label>
                            @Html.TextBoxFor(model => model.PlotNo, htmlAttributes: new { @class = "form-control", @maxlength = "15", @style = "width:90%; float:right;" })
                        </div> 
                        <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                            <label>Area(sqm)</label>
                            @Html.TextBoxFor(model => model.Area, htmlAttributes: new { @class = "form-control", @maxlength = "15", @style = "width:90%; float:right;" })
                        </div>                       
                    </div>

                    <div class="row k-grid-content" id="ApplicantDetails" style="padding-left:30px; padding-bottom:12px;">
                        @( Html.Kendo().Grid<NA.PMS.Model.OnlineFormViewModel>()
                        .Name("gridOnlineApplicantDetail")
                        .Columns(columns =>
                        {
                            columns.Bound(c => c.Id).Hidden(true);
                            columns.Bound(c => c.ApplicationFormId).Title("Application Id").Width(150).Filterable(false).Sortable(false);//.ClientTemplate("<a target='_blank' href='" + "/Online/Application/FormDetail/#= EncryptedFormId #'>#= ApplicationFormId #</a>").ClientFooterTemplate("Total Count: #=count#");
                            columns.Bound(c => c.FirstName).Title("Applicant").Filterable(false).Sortable(false);
                            columns.Bound(c => c.ApplicantType).Title("Applicant Type").Filterable(false).Sortable(false);
                            columns.Bound(c => c.AreaRange).Title("Area").Filterable(false).Sortable(false);
                            columns.Bound(c => c.PanNumber).Title("PAN").Filterable(false).Sortable(false);
                            columns.Bound(c => c.CorrespondingAddress).Title("Address").Filterable(false).Sortable(false);
                            columns.Bound(c => c.MobileNumber).Title("Mobile No").Filterable(false).Sortable(false);
                        })
                        .Resizable(resize => resize.Columns(true))
                        .DataSource
                        (
                            dataSource => dataSource
                            .Ajax()
                            .Model(model => model.Id(p => p.ApplicationFormId))
                            .ServerOperation(true)
                            .Read(read => read.Action("GetApplicantDetailForDraw", "Application").Data("FilterData"))
                       ))
                    </div>

                    <div class="row">
                        <div class="col-md-12 col-sm-12 col-xs-12 form-group" style="text-align:right">
                            <input type="button" class="k-button" value="Allot Property" id="btnAddDrawProperty" style="width:120px;" />
                        </div>
                    </div>
                </div>

                @*<div class="form-bx2" id="DivSubmitButton"> 
                    <div class="col-md-12 col-sm-12 col-xs-12" style="text-align:right;padding:6px 30px 12px 0;border-bottom:1px solid #000; background:url(/Content/Images/boxed-bg.jpg) repeat;">
                        <input type="button" class="k-button" value="Allot Property" id="btnAddDrawProperty" style="width:120px;"/>
                    </div>
                </div>*@


                <h2 class="blck-heading allotted-grid" style="margin-bottom:0px;">Allotted Property Applicant</h2>
                <div class="col-md-12 k-grid-content allotted-grid">
                    @( Html.Kendo().Grid<NA.PMS.Model.OnlineFormViewModel>()
                        .Name("gridAllottedApplicantDetail")
                        .Excel(excel => excel.AllPages(true).Filterable(true).FileName("OnlineApplications.xlsx"))
                        .ToolBar(toolsExcel => toolsExcel.Excel())
                        .Columns(columns =>
                        {
                            columns.Bound(c => c.Id).Hidden(true);
                            columns.Bound(c => c.ApplicationFormId).Title("Application Id").Width(150);//.ClientTemplate("<a target='_blank' href='" + "/Online/Application/FormDetail/#= EncryptedFormId #'>#= ApplicationFormId #</a>").ClientFooterTemplate("Total Count: #=count#");
                            columns.Bound(c => c.FirstName).Title("Applicant");
                            columns.Bound(c => c.ApplicantType).Title("Applicant Type");
                            columns.Bound(c => c.AreaRange).Title("Area");
                            columns.Bound(c => c.PropertyNo).Title("Property");                           
                            columns.Bound(c => c.MobileNumber).Title("Mobile No");
                            columns.Bound(c => c.ApplicationFormId).Title("Action").Width(150).ClientTemplate("<span class='hyperlink' onclick='UpdateProperty(#= ApplicationFormId #)'>Cancel</span>");
                       })
                        .Sortable()
                        .Filterable()
                        .Resizable(resize => resize.Columns(true))
                        .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                        .DataSource
                        (
                            dataSource => dataSource
                            .Ajax()
                            .Model(model => model.Id(p => p.ApplicationFormId))
                            .ServerOperation(true)
                            .Read(read => read.Action("GetApplicantListAfterDraw", "Application").Data("FilterData"))
                            .Sort(s => s.Add(x=>x.ApplicationFormId).Descending())
                            .PageSize(10)
                            //.Aggregates(aggregates =>aggregates.Add(p => p.ApplicationFormId).Count())
                       ))
                </div>
            </div>
        </div>
    </div>
}


<script>
    $(document).ready(function () {
        $('#ApplicantDetails').css("display", "none");
        $('.allotted-grid').css("display", "none");
        //$('#DivSubmitButton').css("display", "none");
        $('#ApplicationFormId').data('kendoDropDownList').enable(false);

        $('#btnAddDrawProperty').click(function () {
            if (ValidateFormFields()) {
                ValidateProperty();
            }
        });


    });

    function FilterSchemeId() {
        return { schemeId: $('#SchemeId').val() };
    }

    function FilterSchemeAndDepartmentId() {
        return {
            schemeId: $('#SchemeId').val(),
            departmentId: $('#DepartmentId').val()
        };
    }

    function FilterData() {
        var ApplicationModal = {
            SchemeId: parseInt($("#SchemeId").val()),
            DepartmentId: parseInt($("#DepartmentId").val()),
            ApplicationFormId: $('#ApplicationFormId').val()
        };
        return ApplicationModal;
    }

    function GetApplicantDetails() {
        if ($('#ApplicationFormId').val() == "") {
            $('#ApplicantDetails').css("display", "none");
        }
        else {
            $('#gridOnlineApplicantDetail').data("kendoGrid").dataSource.read();
            $('#ApplicantDetails').show();
        }

    }

    function GetAllottedProperty() {
        if ($('#SchemeId').val() != "") {
            $('#gridAllottedApplicantDetail').data("kendoGrid").dataSource.read();
            $('.allotted-grid').show();
            //$('#DivSubmitButton').show();
            $('#ApplicationFormId').data('kendoDropDownList').dataSource.read();
            $('#ApplicationFormId').data('kendoDropDownList').enable(true);
        }
        else {
            $('.allotted-grid').css("display", "none");
            $('#ApplicantDetails').css("display", "none");
            //$('#DivSubmitButton').css("display", "none");
            $('#ApplicationFormId').data('kendoDropDownList').value('');
            $('#ApplicationFormId').data('kendoDropDownList').enable(false);
        }
    }

    function SubmitFormDetail() {
        var formData = new FormData($('form').get(0));
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            data: formData,
            url: '/Online/Application/AllotPropertyAfterDraw',
            success: function (result) {
                if (result == '@ReturnType.Saved') {
                    $('#gridAllottedApplicantDetail').data('kendoGrid').dataSource.read();
                    ClearInputFields();
                    $('.allotted-grid').show();
                    //$('#DivSubmitButton').show();
                    $('#ApplicantDetails').css("display", "none");
                    $('#ApplicationFormId').data('kendoDropDownList').enable(false);
                    alertify.success("Data saved successfully.");
                }
                else if (result == '@ReturnType.Updated') {
                    $('#gridAllottedApplicantDetail').data('kendoGrid').dataSource.read();
                    ClearInputFields();
                    $('.allotted-grid').show();
                    //$('#DivSubmitButton').show();
                    $('#ApplicationFormId').data('kendoDropDownList').enable(false);
                    alertify.success("Data updated successfully.");
                }
                else {
                    alertify.error("Data is not saved, try again");
                }
            },
            error: function (ajaxRequest, strError) {
                alertify.error("Network error, try again later");
            }
        });
    }

    function UpdateProperty(id) {
        //alert(id);
        if (id != "" && id != undefined) {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ formId: id, actionType: "Canceled" }),
                url: '/Online/Application/UpdateAllottedPropertyAfterDraw',
                success: function (result) {
                    if (result == '@ReturnType.Updated') {
                        $('#gridAllottedApplicantDetail').data('kendoGrid').dataSource.read();
                        alertify.success("Property has been canceled.");
                    }
                    else if (result == '@ReturnType.NotExist') {
                        alertify.error("Property is not exist. Try again.");
                    }
                    else {
                        alertify.error("Property is not canceled. Please try again.");
                    }
                },
                error: function (obj) {
                    alertify.error("Network error. Please try after some time");
                }
            });
        }
        else {

        }
    }

    function ValidateProperty() {
        var sector = $.trim($('#Sector').val());
        var block = $.trim($('#Block').val());
        var plot = $.trim($('#PlotNo').val());
        if (sector != "" && plot != "") {
            if (plot != "") {
                $.ajax({
                    dataType: 'json',
                    type: 'Post',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({ sector: sector, block: block, plot: plot }),
                    url: '/Online/Application/ValidatePropertyForAllotment',
                    success: function (result) {
                        if (result == '@ReturnType.NotExist') {
                            SubmitFormDetail();
                        }
                        else {
                            alertify.error("Property already allotted to someone.");
                        }
                    },
                    error: function (obj) {
                        alertify.error("Network error. Please try after some time");
                    }
                });
            }
        }
    }

    function ValidateFormFields() {
        var flag = true;
        if ($('#SchemeId').val() == "") {
            flag = false;
            alertify.error("Please Select Scheme");
        }
        if ($('#DepartmentId').val() == "") {
            flag = false;
            alertify.error("Please Select Department");
        }
        if ($('#ApplicationFormId').val() == "") {
            flag = false;
            alertify.error("Please Select Application form no.");
        }
        if ($('#SchemeDrawDate').val() == "") {
            flag = false;
            alertify.error("Please Select scheme draw date.");
        }
        if ($.trim($('#Sector').val()) == "") {
            flag = false;
            alertify.error("Please enter sector");
        }
        //if ($('#Block').val() == "") {
        //    flag = false;
        //    alertify.error("Please enter Block");
        //}
        if ($.trim($('#PlotNo').val()) == "") {
            flag = false;
            alertify.error("Please enter plot no.");
        }
        //if ($('#Area').val() == "") {
        //    flag = false;
        //    alertify.error("Please enter area.");
        //}
        return flag;
    }

    function ClearInputFields() {
        $('#SchemeId').data('kendoDropDownList').value('');
        $('#DepartmentId').data('kendoDropDownList').value('');
        $('#ApplicationFormId').data('kendoDropDownList').value('');
        $('#SchemeDrawDate').data('kendoDatePicker').value('');
        $('#Sector').val('');
        $('#Block').val('');
        $('#PlotNo').val('');
        $('#Area').val('');
    }
</script>