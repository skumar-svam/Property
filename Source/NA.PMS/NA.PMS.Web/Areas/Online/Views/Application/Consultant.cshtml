@model NA.PMS.Model.OnlineFormViewModel
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
@using NA.PMS.Common;

@{
    ViewBag.Title = "Consultant";
    Layout = "~/Views/Shared/_LayoutOnline.cshtml";
}


<style type="text/css">
    [class*="col-"] {
        /*padding-left: 15px;
        padding-right: 15px;*/
    }

    .form-bx {
        padding-left: 30px;
    }
    #divDocumentView{
        display:none;
    }
</style>
<div class="ManageAllotment">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Online Applications</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                @*<a href="#" id="btnRequest" class="" onclick="javascript: RegisterForm(event);">Register Form</a>*@
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12">
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading" style="margin-bottom:6px;">Search Application</h2>
            @Html.HiddenFor(m => m.ApplicationIdList)
            <div class="form-bx">
                <div class="row">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        @Html.Label("Scheme Name")
                        @(Html.Kendo().DropDownListFor(model => model.SchemeId)
                            .Name("SchemeId")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel(" -- Please Select --")
                            .DataSource(source => source.Read(read => read.Action("GetSchemeList", "Application")))
                            .Enable(true)
                            .AutoBind(true)
                            .Filter("contains")
                            .HtmlAttributes(new { style = "width:100%", @class = "DisableKeyboardInput" })
                            .Events(e => e.Change("ChangeDeptEvent"))
                        )
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 col-md-offset-1 form-group">
                        @Html.Label("Department")
                        @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                                .Name("DepartmentId")
                                .Filter("contains")
                                .DataTextField("Text")
                                .DataValueField("Id")
                                .OptionLabel(" -- Please Select --")
                                .CascadeFromField("SchemeId")
                                .DataSource(source =>
                                {
                                    source.Custom()
                                   .ServerFiltering(true)
                                   .ServerPaging(true)
                                   .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                   .Transport(transport => transport.Read(read => read.Action("GetDepartmentListBySchemeSearch", "Application").Data("FilterSchemeId")))
                                   .Schema(schema => schema.Data("Data").Total("Total"))
                                   .PageSize(100);
                                })
                                .CascadeFrom("SchemeId")
                                .Events(events => { events.Change("ChangeDeptEvent"); })
                                .HtmlAttributes(new { @class = "DisableKeyboardInput", style = "width:100%" })
                        )
                    </div>

                    <div class="col-md-2 col-sm-3 col-xs-12 form-group" style="text-align:right">
                        @Html.Label("")<br />
                        <input type="button" id="btnSearch" class="btn btn-add" value="Search" />
                        <input type="button" id="btnClear" class="btn btn-default" value="Clear" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-12 k-grid-content">
        @( Html.Kendo().Grid<NA.PMS.Model.OnlineFormViewModel>()
            .Name("gridOnlineApplicationDetail")
            //.Excel(excel => excel.AllPages(true).Filterable(true).FileName("OnlineApplications.xlsx"))
            //.ToolBar(toolsExcel => toolsExcel.Excel())
            .Columns(columns =>
            {
                columns.Bound(c => c.ApplicationFormId).Hidden(true);
                columns.Bound(c => c.TotalAmount).Hidden(true);
                //columns.Bound(c => c.ApplicationFormId).Title("").Width(40).ClientTemplate("#if(ChallanStatus=='Paid' || ChallanStatus=='PC Paid'){#<input  type='checkbox' class='IsAppProcess' id='c_#= ApplicationFormId #' />#}else{# #}#").Filterable(false);
                columns.Bound(c => c.ApplicationFormId).Width(150).ClientTemplate("<a target='_blank' href='" + "/Online/Application/FormDetail/#= EncryptedFormId #'>#= ApplicationFormId #</a>").Title("Application ID").ClientFooterTemplate("Total Count: #=count#").Sortable(false);
                columns.Bound(c => c.FirstName).Title("Applicant");
                columns.Bound(c => c.AreaRange).Title("Area").Width(100);
                //columns.Bound(c => c.TotalAmount).Title("Amount").ClientTemplate("#if(TotalAmount!=null){# #=TotalAmount# #}else{# 0 #}#").ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
                columns.Bound(c => c.ApplicantType).Title("Type").Width(120);
                columns.Bound(c => c.SubmitDate).Title("Submit Date").Format("{0:dd-MM-yyyy}").Width(120);
                //columns.Bound(c => c.AmountPaidDate).Title("Payment/Challan Date").ClientTemplate("#if(AmountPaidDate!=null){# #=kendo.toString(AmountPaidDate, 'dddd, MMM dd, yyyy')# #}else{# -- #}#");
                //columns.Bound(c => c.ChallanBank).Title("Bank(RTGS)");
                // columns.Bound(c => c.IsPaid).Title("Payment Mode");
                //columns.Bound(c => c.PayType).Title("Payment Mode");
                //columns.Bound(c => c.ProcessType).Title("App Process");
                //else if(ChallanStatus=='SWP Paid'){# SWP Paid #}else if(ChallanStatus=='SWP Not Paid'){# <a onclick='javascript:UpdateSWPStatus(this);'><center><span value='SWP Not Paid' class='glyphicon glyphicon-edit text-danger'>SWP Not Paid</span></center></a> #}
                //columns.Bound(c => c.ChallanStatus).Title("Challan/Online Payment Status").ClientTemplate("#if(ChallanStatus=='Challan Updated'){# <a onclick='javascript:UpdateChallanStatus(this);'><center><span value='Challan Updated' class='glyphicon glyphicon-edit text-danger'>Challan Updated</span></center></a> #}else if(ChallanStatus=='Challan Generated'){# Challan Generated #}else if(ChallanStatus=='Paid'){# Paid #}else if(ChallanStatus=='Paid'){# Paid #}else if(ChallanStatus=='Not Paid'){# Not Paid #}else if(ChallanStatus=='PC Paid'){# PC Paid #}else if(ChallanStatus=='PC Not Paid'){# <a onclick='javascript:UpdatePreviousChallanStatus(this);'><center><span value='PC Not Paid' class='glyphicon glyphicon-edit text-danger'>PC Not Paid</span></center></a> #}else if(ChallanStatus=='SWP Paid'){# SWP Paid #}else if(ChallanStatus=='SWP Not Paid'){# <a onclick='javascript:UpdateSWPStatus(this);'><center><span value='SWP Not Paid' class='glyphicon glyphicon-edit text-danger'>SWP Not Paid</span></center></a> #}else{# -- #}#").Filterable(true);
                columns.Bound(c => c.IsDeleted).ClientTemplate("#if(IsDeleted=='Accepted'){# <a onclick='javascript:RejectApplication(this);'><center><span value='Reject Application' class='glyphicon glyphicon-remove text-danger'></span></center></a> #}else{# Rejected #}#").Title("Reject").Width(80).Filterable(false);
                columns.Bound(c => c.SubmitDate).Title("Status").Width(100).ClientTemplate("#if(ChallanStatus=='PC Paid' || ChallanStatus=='SWP Paid' || ChallanStatus=='Paid'){# <a onclick='javascript:UpdateApplicationDetails(this);'><center><span value='Allotment Process' class='glyphicon glyphicon-edit text-danger'>Allotment Process</span></center></a> #}else{# -- #}#");
            })
            .Sortable().Filterable().Resizable(resize => resize.Columns(true))
            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
            .ClientDetailTemplateId("template")
            .DataSource
            (
                dataSource => dataSource
                .Ajax().Model(model => model.Id(p => p.ApplicationFormId))
                .ServerOperation(true)
                    //.Group(group => group.Add(m => m.SchemeName))
                .Read(read => read.Action("GetOnlineApplicationsForConsultant", "Application", new { area = "Online" }).Data("FilterData"))
                .Sort(s => s.Add("ApplicationFormId").Descending())
                .PageSize(10)
                .Aggregates(aggregates =>
                {
                    aggregates.Add(p => p.ApplicationFormId).Count();
                    aggregates.Add(p => p.TotalAmount).Sum();
                })
            ))
    </div>

</div>


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<NA.PMS.Model.OnlineFormViewModel>()
            .Name("grid_#=Id#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.TotalAmount).Title("Amount").Width(120);
                columns.Bound(c => c.ChallanBank).Title("Bank(RTGS)").Width(150);
                columns.Bound(c => c.PayType).Title("Payment Mode").Width(150);
                columns.Bound(c => c.AmountPaidDate).Title("Payment/Challan Date").Format("{0:dd-MM-yyyy}").Width(150);
                columns.Bound(c => c.ChallanStatus).Title("Payment Status").Width(120);
                columns.Bound(c => c.Email).Title("Email");
                columns.Bound(c => c.MobileNumber).Title("Mobile No").Width(120);
                //columns.Bound(c => c.GSTNo).Title("Status").Width(120).ClientTemplate("#if(IsPropertyAllotted==true){#<label>Allotted</label>#}else{#<label>Not Allotted</label>#}#");
            })
            //.ClientDetailTemplateId("template2").AutoBind(true)
            .DataSource(dataSource => dataSource
                .Ajax()
                //.PageSize(10)
                .Read(read => read.Action("GetOnlineApplicationsForConsultant", "Application", new { area = "Online", Id = "#=Id#" }))
            )
            .ToClientTemplate()
    )
</script>
<script>
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
</script>


