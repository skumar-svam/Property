<div id='divAssineRequetApproval' class='adminfeediv'>
    <div class="container-fluid">
        <div class="row topSpace">
            <div class="col-md-3 col-md-offset-1">
                @Html.Label("Assign To: ")
            </div>
            <div class="col-md-6">
                @(Html.Kendo().DropDownListFor(model => model.User)
                .DataTextField("text")
                .DataValueField("id")
                .Filter("contains")
                .OptionLabel("Select")
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetAssineTo", "Allotment", new { area = "Property" });
                    });
                })
                .HtmlAttributes(new { style = "width:100%" })
                )
                @Html.ValidationMessageFor(model => model.User)
            </div>
        </div>
        <div class="row topSpace bottomSpace">
            <div class="col-md-6 col-md-offset-4">
                <button type='submit' id="btnRequetForApproval" class='btn btn-default' value='Save'>Submit</button>
                <button type='button' class='btn btn-default' value='Cancel' onclick="CloseCommnetPopUpForApproval();">Close</button>
            </div>
        </div>
    </div>
</div>
<br />
<br />
<script type="text/javascript">
    var checkedIDs = [];
    $(document).ready(function () {
        $('#divDocumentView').kendoWindow({
            modal: true,
            title: "Document",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "15%"
            },
            width: "70%", height: "80%"
        });

        $("#divAssineRequetApproval").kendoWindow({
            modal: true,
            title: "Assign Request to Approver",
            visible: false,
            //width: "30%"
        });

        $(function () {
            $('#gridOnlineApplicationDetail').on('change', '.IsAppProcess', function () {
                var checked = $(this).is(':checked');
                var grid = $('#gridOnlineApplicationDetail').data().kendoGrid;
                var dataItem = grid.dataItem($(this).closest('tr'));
                if (checked == true) {
                    checkedIDs.push({ 'text': dataItem.ApplicationFormId, 'id': dataItem.ApplicationFormId.toString() });
                }
                else {
                    var arr = checkedIDs.map(function (o) { return o.id; });
                    var i = arr.indexOf(dataItem.ApplicationFormId);
                    checkedIDs.splice(i, 1);
                }
                var arr = checkedIDs.map(function (o) { return parseInt(o.id); });
                $('#ApplicationIdList').val(arr);
            });
        });
    });

    $("#btnAddService").click(function () {
        OpenAssineRequetApprovalPopUp();
    });

    $("#btnRequetForApproval").click(function () {
        var DpVal = $('#DpApplicationProcess').val();
        if (DpVal != "" && DpVal != null) {
            UpdateApplicationProcess(DpVal);
        } else {
            CloseCommnetPopUpForApproval();
            alertify.error("Please select application process.");
        }
    });

    function UpdateApplicationProcess(Type) {
        var optionTexts = checkedIDs.map(function (o) { return parseInt(o.id); });;
        var processStage = Type;

        var userVal = $("#User").val();

        if (userVal == '' || userVal == null) {
            CloseCommnetPopUpForApproval();
            alertify.error("Please select a User.");
            return false;
        }

        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ ProcessType: processStage, ApplicationIdList: optionTexts, User: userVal }),
            url: '/Online/Application/UpdateApplicationProcess',
            success: function (result) {
                if (result != null) {
                    if (result.ReturnType = 200) {
                        CloseCommnetPopUpForApproval();
                        alertify.success(result.Message);
                        alertify.success("Online application send for approval.");
                    } else { CloseCommnetPopUpForApproval(); }
                } else { CloseCommnetPopUpForApproval(); }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alertify.error("Some Error in save database.");
            }
        });
    }

    $('input:radio[name=PayType]').on('change', function () {
        $("#gridOnlineApplicationDetail").data("kendoGrid").dataSource.read();
    });

    function OpenAssineRequetApprovalPopUp() {
        var win = $("#divAssineRequetApproval").data("kendoWindow");
        win.center();
        win.open();
    }

    function CloseCommnetPopUpForApproval() {
        var win = $("#divAssineRequetApproval").data("kendoWindow");
        win.close();
    }

    function RegisterForm(event) {
        event.preventDefault();
        window.location.href = '@Url.Action("RegisterForm", "Application")';
    }

    function FilterSchemeId() {
        return { schemeId: $("#SchemeId").val() };
    }

    function FilterData() {
        var ApplicationModal = {
            SchemeId: parseInt($("#SchemeId").val()),
            DepartmentId: parseInt($("#DepartmentId").val()),
            PayType: $('input[name=PayType]:checked').val()
        };
        return ApplicationModal;
    }

    function RejectApplication(row) {
        var tr = $(row).parent().parent();
        var ApplicationId = $(tr).children("td:eq(1)").text();
        if (confirm("Are you sure? You want to reject this application.")) {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ AppId: ApplicationId }),
                url: '/Online/Application/RejectApplication',
                success: function (result) {
                    if (result == true) {
                        alertify.success("Application rejected successfully.");
                    } else { alertify.error("Application not rejected."); }
                    $("#gridOnlineApplicationDetail").data("kendoGrid").dataSource.read();
                },
                error: function (obj) {
                }
            });
        }
    }

    function UpdateApplicationDetails(row) {
        var tr = $(row).parent().parent();
        var ApplicationId = $(tr).children("td:eq(1)").text();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ FormId: ApplicationId }),
            url: '/Online/Application/AddToAllotment',
            success: function (result) {
                if (result == '@ReturnType.Updated') {
                    alertify.success("Online application added to application detail.");
                }
                else if (result == '@ReturnType.NotPaid') {
                    alertify.error("Application Detail updated but payment not.");
                }
                else if (result == '@ReturnType.Exist') {
                    alertify.error("Application Detail already exist.");
                }
                else {
                    alertify.error("Some Error in save database.");
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alertify.error("Some Error in save database.");
            }
        });
    }

    function UpdateChallanStatus(row) {
        $("#FormId_Challan_trans").val('');
        $("#Amount_Challan_trans").val('');
        $("#filepath_Challan_trans").val('');
        var tr = $(row).parent().parent();
        var ApplicationId = $(tr).children("td:eq(1)").text();
        var Amount = $(tr).children("td:eq(2)").text();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ ApplicationFormId: ApplicationId }),
            url: '/Online/Payment/GetChallanDetailsTrans',
            success: function (result) {
                $("#challanBankName").html(result.BankName);
                $("#transactionId").html(result.TransactionId);
                var ModDate = (new Date(parseInt(result.modifiydate.replace("/Date(", "").replace(")/", ""), 10))).toString("dd/MM/yyyy");
                $("#submittedDate").html(ModDate);
                $("#FormId_Challan_trans_Id").html(ApplicationId);
                $("#utrNo").html(result.TransactionKey);

                $("#FormId_Challan_trans").val(ApplicationId);
                $("#Amount_Challan_trans").val(Amount);
                $("#filepath_Challan_trans").val(result.docPath);
                $("#divChallanDetails").modal('show');
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alertify.error("Some Error in save database.");
            }
        });
    }

    function UpdatePreviousChallanStatus(row) {
        $("#FormId_Previous_Challan_trans").val('');
        $("#Amount_Previous_Challan_trans").val('');
        $("#filepath_Previous_Challan_trans").val('');
        var tr = $(row).parent().parent();
        var ApplicationId = $(tr).children("td:eq(1)").text();
        var Amount = $(tr).children("td:eq(2)").text();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ ApplicationFormId: ApplicationId }),
            url: '/Online/Payment/GetPreviousChallanDetailsTrans',
            success: function (result) {
                $("#PreviousChallanBankName").html(result.IssuingBank);
                $("#AppTransactionId").html(result.TransactionId);
                $("#PreviousChallanTransactionId").html(result.TransactionKey);
                var ModDate = (new Date(parseInt(result.EntryDate.replace("/Date(", "").replace(")/", ""), 10))).toString("dd/MM/yyyy");
                $("#PreviousChallanSubmittedDate").html(ModDate);
                $("#FormId_Previous_Challan_trans_Id").html(ApplicationId);
                $("#PreviousChallanAmount").html(result.Amount);
                $("#FormId_Previous_Challan_trans").val(ApplicationId);
                $("#Amount_Previous_Challan_trans").val(Amount);
                $("#filepath_Previous_Challan_trans").val(result.docPath);
                $("#divPreviousChallanDetails").modal('show');
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alertify.error("Some Error in save database.");
            }
        });
    }

    function ShowChallanDocument() {
        $("#divDocumentView").empty();
        var link = $("#filepath_Challan_trans").val();
        $("#divDocumentView").append($('<iframe src=' + link + ' style="width:100%; height:100%;"></iframe>'));
        $("#divDocumentView").data("kendoWindow").center();
        $("#divDocumentView").data("kendoWindow").open();
    }

    function ShowPreviousChallanDocument() {
        $("#divDocumentView").empty();
        var link = $("#filepath_Previous_Challan_trans").val();
        $("#divDocumentView").append($('<iframe src=' + link + ' style="width:100%; height:100%;"></iframe>'));
        $("#divDocumentView").data("kendoWindow").center();
        $("#divDocumentView").data("kendoWindow").open();
    }

    function ChangeDeptEvent() {
        $("#gridOnlineApplicationDetail").data("kendoGrid").dataSource.read();
    }

    $("#btnCancel_ChallanTrans").click(function () {
        $("#divChallanDetails").modal('hide');
    });

    $("#btnCancel_PreviousChallanTrans").click(function () {
        $("#divPreviousChallanDetails").modal('hide');
    });

    $("#btnSearch").click(function () {
        $("#gridOnlineApplicationDetail").data("kendoGrid").dataSource.read();
    });

    $('#btnClear').click(function () {
        $('#SchemeId').data('kendoDropDownList').value('');
        $('#DepartmentId').data('kendoDropDownList').value('');
        $('#PayType_all').prop("checked", true);
        $("#gridOnlineApplicationDetail").data("kendoGrid").dataSource.read();
    });

    $('#btnUpdateChallan_trans').click(function () {
        var ApplicationId = $("#FormId_Challan_trans").val();
        var Amount = $("#Amount_Challan_trans").val();
        var PaymentType = '@Constants.offlineApplicationPayment';
        if (confirm("Are you sure? You want to update challan status of this application.")) {
            UpdateAppStatus_AjaxRequest(ApplicationId, PaymentType, Amount);
        } else {
            event.preventDefault();
        }
    });

    $('#btnUpdatePreviousChallan_trans').click(function () {

        var ApplicationId = $("#FormId_Previous_Challan_trans").val();
        var Amount = $("#Amount_Previous_Challan_trans").val();
        var PaymentType = '@Constants.offlinePrevoiusChallanApplicationPayment';
        if (confirm("Are you sure? You want to update status of this application paid by previous challan.")) {

            UpdateAppStatus_AjaxRequest(ApplicationId, PaymentType, Amount);
        }
        else {
            event.preventDefault();
        }
    });

    function UpdateSWPStatus(row) {
        var tr = $(row).parent().parent();
        var ApplicationId = $(tr).children("td:eq(1)").text();
        var Amount = $(tr).children("td:eq(2)").text();
        var PaymentType = '@Constants.singleWindowPortalApplicationPayment';

        if (confirm("Are you sure? You want to update of this application paid through single window portal.")) {

            UpdateAppStatus_AjaxRequest(ApplicationId, PaymentType, Amount);
        }
        else {
            event.preventDefault();
        }
    }

    function UpdateAppStatus_AjaxRequest(ApplicationId, PaymentType, Amount) {
        var paymentType = PaymentType;
        var applicationId = ApplicationId;
        var amount = Amount;
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ AppId: applicationId, PaymentType: paymentType, Amount: amount }),
            url: '/Online/Payment/UpdateChallanStatus',
            success: function (result) {
                if (result == true) {
                    alertify.success("Application updated successfully.");
                } else { alertify.error("Application not updated."); }
                $("#gridOnlineApplicationDetail").data("kendoGrid").dataSource.read();
            },
            error: function (obj) {
            }
        });
    }

</script>

