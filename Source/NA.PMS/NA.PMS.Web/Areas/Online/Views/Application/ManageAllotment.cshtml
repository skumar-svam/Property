@model NA.PMS.Model.OnlineFormViewModel
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
@using NA.PMS.Common;
@{
    ViewBag.Title = "Manage Allotment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .btn{
        margin-top:20px;
    }
    .applicant-grid, .property-grid{
        display:none;
    }

</style>

<div id="ManageAllotment">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Online Applications Allotment</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                @*<a href="#" id="btnRequest" class="" onclick="javascript: RegisterForm(event);">Register Form</a>*@
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12" style="border:solid #e2e3e4; border-width:0 1px 1px">
        <div class="row" style="padding:12px 30px 12px 0;">
            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                @Html.Label("Scheme Name")
                @(Html.Kendo().DropDownListFor(model => model.SchemeId)
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .DataSource(source => source.Read(read => read.Action("GetSchemeList", "Application", new { area="Online"})))
                    .Enable(true)
                    .AutoBind(true)
                    .Filter("contains")
                    .HtmlAttributes(new { style = "width:90%; float:right;", @class = "input-disabled" })
                        //.Events(e => e.Change("ChangeDeptEvent"))
                )
            </div>
            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                @Html.Label("Department")
                @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .CascadeFromField("SchemeId")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetDepartmentListBySchemeSearch", "Application", new { area="Online"}).Data("FilterSchemeId")))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                    .CascadeFrom("SchemeId")
                    //.Events(events => { events.Change("ChangeDeptEvent"); })
                    .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                )
            </div>    
            
            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                @Html.Label("Application Form")
                @(Html.Kendo().DropDownListFor(model => model.ApplicationFormId)
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .Enable(true)
                    .AutoBind(true)
                    .Filter("contains")
                    .CascadeFromField("DepartmentId")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetOnlineApplicationFormIdListForAllotment", "Application", new { area = "Online" }).Data("FilterParam")))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                    .CascadeFrom("DepartmentId")
                    .HtmlAttributes(new { style = "width:90%; float:right;", @class = "input-disabled" })
                    .Events(e => e.Change("ChangeApplicationForm"))
                )
            </div>
            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                @Html.Label("Property")
                @(Html.Kendo().DropDownListFor(m => m.PropertyId)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .CascadeFrom("DepartmentId")
                    .CascadeFromField("DepartmentId")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetPropertyListForAllotment", "Application", new { area = "Online" }).Data("FilterParam")))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                   .Events(events => { events.Change("ChangePropertyNo"); })
                   .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                )
            </div>       
        </div>

    </div>
    <div class="col-md-12 k-grid-content applicant-grid">
        <h2 class="blck-heading" style="margin-bottom:0;">Applicant</h2>
        @(Html.Kendo().Grid<NA.PMS.Model.OnlineFormViewModel>()
            .Name("GridOnlineApplicationForm")
            .Columns(columns =>
            {
                columns.Bound(c => c.ApplicationFormId).ClientTemplate("<a target='_blank' href='" + "/Online/Application/FormDetail/#= EncryptedFormId #'>#= ApplicationFormId #</a>").Title("Application ID").Width(150).Filterable(false).Sortable(false);
                columns.Bound(c => c.Applicant).Title("Applicant").Filterable(false).Sortable(false);
                columns.Bound(c => c.AreaRange).Title("Area").Width(110).Filterable(false).Sortable(false);
                columns.Bound(c => c.TotalAmount).Title("Amount").Width(110).Filterable(false).Sortable(false);
                columns.Bound(c => c.ApplicationFormType).Title("Form Type").Width(120).Filterable(false).Sortable(false);
                columns.Bound(c => c.ExpansionType).Title("Expansion Type").Width(140).Filterable(false).Sortable(false);
                columns.Bound(c => c.ApplicantType).Title("Applicant Type").Width(120).Filterable(false).Sortable(false);
            })
            .DataSource
            (
                dataSource => dataSource
                .Ajax()
                .Model(model => model.Id(p => p.ApplicationFormId))
                .ServerOperation(true)
                .Read(read => read.Action("GetApplicationDetailAsDataSourceByApplicationId", "Application", new { area = "Online" }).Data("FilterApplicationFormId"))
             )
         )
    </div>

    <div class="col-md-12 k-grid-content property-grid">
        <h2 class="blck-heading" style="margin-bottom:0;">Property</h2>
        @(Html.Kendo().Grid<NA.PMS.Model.PropertyViewModel>()
            .Name("GridPropertyDetail")
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Visible(false);
                columns.Bound(c => c.EncryptedPropertyId).Visible(false);
                columns.Bound(c => c.PropertyId).Title("Property ID");                   
                columns.Bound(c => c.SchemeName).Title("Scheme Name");
                columns.Bound(c => c.Department).Title("Department");
                columns.Bound(c => c.PropertyNo).Title("PropertyNo");
                //columns.Bound(c => c.SectorName).Title("Sector");
                //columns.Bound(c => c.BlockName).Title("Block");
                columns.Bound(c => c.TotalArea).Title("Area (sqm)");
                //columns.Bound(c => c.FloorAreaRatio).Title("Floor Area Ratio");
                columns.Bound(c => c.TotalPropertyCost).Title("Property Cost");                   
                columns.Bound(c => c.PropertyType).Title("Property Type");                   
                //columns.Bound(c => c.Id).HeaderHtmlAttributes(new { style = "text-align:center;" }).HtmlAttributes(new { style = "text-align:center;" }).ClientTemplate("# if (IsAllotted == 0) {#<span>UnAllotted</span>#}else {#<span>Allotted</span>#} #").Title("Status").Filterable(false);
                //columns.Bound(c => c.Id).HeaderHtmlAttributes(new { style = "text-align:center;" }).HtmlAttributes(new { style = "text-align:center;" }).ClientTemplate("<a class='gridEdit' href='" + "/Master/ManageProperty/EditPropertyDetail/#= EncryptedRefId #'> Edit </a>").Title("Edit").Filterable(false);                   
            })
            .DataSource
            (
                dataSource => dataSource
                .Ajax()
                .Model(model => model.Id(p => p.Id))
                .ServerOperation(true)
                .Read(read => read.Action("GetPropertyDetailAsDataSourceByPropertyId", "Application", new { area = "Online" }).Data("FilterPropertyId"))
            )
        )
    </div>

    <div class="col-md-12 form-group row-btn-action" style="border:solid #e2e3e4; border-width:0 1px 1px;">
        <div class="row" style="padding:12px 30px 12px 0;">
            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                <label>Allotment Date</label>
                @(Html.Kendo().DatePickerFor(model => model.AllottmentDate).HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" }))
            </div>
            <div class="col-md-3 col-sm-6 col-xs-12 form-group">
               
            </div>
            <div class="col-md-3 col-sm-6 col-xs-12 form-group">

            </div>
            <div class="col-md-3 col-sm-6 col-xs-12 form-group" style="text-align:right;">
                <input type="button" id="btnSubmit" class="btn btn-add" value="Submit" />
                <input type="button" id="btnClear" class="btn btn-default" value="Clear" />
            </div>
        </div>       
    </div>


    <div class="col-md-12 alot-prop-grid k-grid-content">
        <h2 class="blck-heading" style="margin-bottom:0;">Allotted Property</h2>
        @(Html.Kendo().Grid<NA.PMS.Model.OnlineFormViewModel>()
            .Name("GridAllottedProperty")
            .Columns(columns =>
            {
                columns.Bound(c => c.ApplicationFormId).Hidden(true);
                columns.Bound(c => c.RegistrationId).Title("Registration Id").Width(150);
                columns.Bound(c => c.ApplicationFormId).Title("Application Id").Width(150);//.ClientTemplate("<a target='_blank' href='" + "/Online/Application/FormDetail/#= EncryptedFormId #'>#= ApplicationFormId #</a>").ClientFooterTemplate("Total Count: #=count#").Title("Application ID").Width(150);
                columns.Bound(c => c.FirstName).Title("Applicant");
                columns.Bound(c => c.AreaRange).Title("Area").Width(110);
                columns.Bound(c => c.TotalAmount).Title("Amount").Width(120);//.ClientTemplate("#if(TotalAmount!=null){# #=TotalAmount# #}else{# 0 #}#").ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>").Width(120);
                columns.Bound(c => c.ApplicationFormType).Title("Form Type").Width(120);
                columns.Bound(c => c.ExpansionType).Title("Expansion Type").Width(140);
                columns.Bound(c => c.ApplicantType).Title("Applicant Type").Width(120);
                //columns.Bound(c => c.SubmitDate).Title("Form Submittion Date").Format("{0:dd-MM-yyyy}");
                //columns.Bound(c => c.AmountPaidDate).Title("Payment/Challan Date").ClientTemplate("#if(AmountPaidDate!=null){# #=kendo.toString(AmountPaidDate, 'dddd, MMM dd, yyyy')# #}else{# -- #}#").Width(200);
                //columns.Bound(c => c.PayType).Title("Payment Mode");
                // columns.Bound(c => c.ChallanStatus).Title("Challan/Online Payment Status").ClientTemplate("#if(ChallanStatus=='Challan Updated'){# <center><span value='Challan Updated' class=''>Challan Updated</span></center> #}else if(ChallanStatus=='Challan Generated'){# Challan Generated #}else if(ChallanStatus=='Paid'){# Paid #}else if(ChallanStatus=='Paid'){# Paid #}else if(ChallanStatus=='Not Paid'){# Not Paid #}else{# -- #}#").Filterable(false).Sortable(false);

            })
            .Sortable()
            .Filterable()
            .Resizable(resize => resize.Columns(true))
            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
            .DataSource
            (
                dataSource => dataSource
                .Ajax()
                .Model(model => model.Id(p => p.ApplicationFormId))
                .ServerOperation(true)
                .Group(group => group.Add(m => m.SchemeName))
                .Read(read => read.Action("GetAllottedOnlineFormPropertyList", "Application", new { area = "Online" }).Data("FilterParam"))
                .Sort(s => s.Add("ApplicationFormId").Descending())
                .PageSize(10)
                //.Aggregates(aggregates =>
                //{
                //    aggregates.Add(p => p.ApplicationFormId).Count();
                //    aggregates.Add(p => p.TotalAmount).Sum();
                //})
            ))
    </div>

</div>

<script>
    var actionType, flag;

    $('#btnSubmit').click(function () {
        AllotPropertyToApplicant();
    });

    function FilterSchemeId() {
        return { schemeId: $('#SchemeId').val() };
    }

    function FilterApplicationFormId() {
        return { applicationId: $('#ApplicationFormId').val() };
    }

    function FilterPropertyId() {
        return { rid: $('#PropertyId').val() };
    }

    function FilterParam() {
        return {
            schemeId: $('#SchemeId').val(),
            departmentId: $('#DepartmentId').val()
        };
    }

    function ChangeApplicationForm() {
        if ($('#ApplicationFormId').val() != "" && $('#ApplicationFormId').val().length == 8) {
            actionType = '@ActionType.Application';
            ValidateFormAndProperty();
            $('#GridOnlineApplicationForm').data('kendoGrid').dataSource.read();
            $('.applicant-grid').show();
        }
        else {
            $('.applicant-grid').css("display", "none");
            $('.row-btn-action').css("display", "none");
        }
    }

    function ChangePropertyNo() {
        if ($('#PropertyId').val() != "" && $('#PropertyId').val().length == 8) {
            actionType = '@ActionType.Property';
            ValidateFormAndProperty();
            $('#GridPropertyDetail').data('kendoGrid').dataSource.read();
            $('.property-grid').show();
        }
        else {
            $('.property-grid').css("display", "none");
            $('.row-btn-action').css("display", "none");
        }

    }

    function ValidateFormAndProperty() {
        var model = {
            ActionType: actionType,
            SchemeId: $('#SchemeId').val(),
            DepartmentId: $('#DepartmentId').val(),
            ApplicationFormId: $('#ApplicatonFormId').val(),
            PropertyId: $('#PropertyId').val()
        }
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: model }),
            url: '/Online/Application/ValidatePropertyAndApplicationForm',
            success: function (result) {
                if (actionType == '@ActionType.Application') {
                    if (result == '@ReturnType.Exist') {
                        flag = '@ReturnType.Exist';
                        alertify.error("This Applicant already allotted.");
                    }
                }
                if (actionType == '@ActionType.Application') {
                    if (result == '@ReturnType.Exist') {
                        flag = '@ReturnType.Exist';
                        alertify.error("This Property already allotted.");
                    }
                }
                ToggleGridView();
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Network error.");
            }
        });
    }

    function AllotPropertyToApplicant() {
        var model = {
            ActionType: actionType,
            SchemeId: $('#SchemeId').val(),
            DepartmentId: $('#DepartmentId').val(),
            ApplicationFormId: $('#ApplicationFormId').val(),
            PropertyId: $('#PropertyId').val(),
            AllottmentDate: $('#AllottmentDate').val()
        }
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: model }),
            url: '/Online/Application/PropertyAllotmentForOnlineApplicationForm',
            success: function (result) {
                if (actionType == '@ActionType.Application') {
                    if (result == '@ReturnType.Exist') {
                        flag = '@ReturnType.Exist';
                        alertify.error("This Applicant already allotted.");
                    }
                }
                if (actionType == '@ActionType.Application') {
                    if (result == '@ReturnType.Exist') {
                        flag = '@ReturnType.Exist';
                        alertify.error("This Property already allotted.");
                    }
                }
                
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Network error.");
            }
        });
    }

    function ToggleGridView() {
        if (actionType == '@ActionType.Application' && flag == '@ReturnType.Exist') {
            $('#ApplicationFormId').data("kendoDropDownList").value('');
            $('.applicant-grid').css("display", "none");
        }
        else if (actionType == '@ActionType.Property' && flag == '@ReturnType.Exist') {
            $('#PropertyId').data("kendoDropDownList").value('');
            $('.property-grid').css("display", "none");
        }
        else {
            $('.property-grid').show();
        }
    }

</script>