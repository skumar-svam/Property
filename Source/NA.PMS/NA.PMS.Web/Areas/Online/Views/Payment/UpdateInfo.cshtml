@using NA.PMS.Common;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions

@{
    ViewBag.Title = "Update Info";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/common-validation.js"></script>
<style>
    .left-pad-15 {
        padding-left: 15px;
    }

    .panel-title a {
        text-decoration: none;
    }

    .k-textbox {
        width: 100%;
    }

    .form-control {
        border-radius: 0;
    }

    .more-less {
        float: right;
        color: #212121;
    }

    .panel-body {
        padding-bottom: 0;
    }

    .row.form-group {
        padding-right: 30px;
    }
</style>
<script src="~/Scripts/common-validation.js"></script>

<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Update Payment Info</h1></div>
            <div class="col-md-6 col-sm-6 col-xs-12 mandatory"></div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 content-top-spce">
        <div class="panel-group" id="accordion" role="tablist" aria-multiselectable="true">
            <div class="panel panel-default">
                <div class="panel-heading" role="tab" id="headingOne">
                    <h4 class="panel-title">
                        <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapse1" aria-expanded="true" aria-controls="collapse1">
                            <i class="more-less glyphicon glyphicon-plus"></i>
                            Online Payment
                        </a>
                    </h4>
                </div>
                <div id="collapse1" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingOne">
                    @{Html.RenderPartial("_UpdatePayment");}
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading" role="tab" id="headingTwo">
                    <h4 class="panel-title">
                        <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapse2" aria-expanded="true" aria-controls="collapse2">
                            <i class="more-less glyphicon glyphicon-plus"></i>
                            Receipt
                        </a>
                    </h4>
                </div>
                <div id="collapse2" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingTwo">
                    @*@{Html.RenderPartial("_PartialDepartment");}*@
                </div>
            </div>

        </div>
    </div>
</div>
