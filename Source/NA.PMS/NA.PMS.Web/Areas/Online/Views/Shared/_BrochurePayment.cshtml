@model NA.PMS.Model.OnlineFormViewModel
@using NA.PMS.Common
@using Kendo.Mvc.UI


@Html.HiddenFor(m => m.ApplicationFormId)
@Html.HiddenFor(m => m.SchemeId)
@Html.HiddenFor(m => m.ChallanAccountNo)
@Html.HiddenFor(m => m.ChallanBranchName)
@Html.HiddenFor(m => m.ChallanBranchId)
@Html.HiddenFor(m => m.BankIFSCCode)
@Html.HiddenFor(m => m.VirtualAccPrefix)
<style type="text/css">
    .RBank {
        font-weight: bold;
        font-size: 16px;
    }

    .banklogo {
        /*width: 125px;*/
        height: 15px;
    }

    .banklbl {
        margin-left: -28px;
    }
</style>

@*kendo Pop Up Choose Payment Option*@
<div class="col-md-12" id="divPaymentwindow" style="background: url(/Content/Images/boxed-bg.jpg) repeat;">
    <div class="row">
        <div class="inr-bx" style="">
            <div class="form-bx">
                <div class="row" style="margin-top:25px;">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group" style="text-align:center">
                        <label class="RBank">Payment mode</label>
                    </div>
                    <div class="col-md-8 col-sm-8 col-xs-12 form-group banklbl" id="PaymentMode">
                        <label class="RBank">@Html.RadioButtonFor(m => m.PaymentTypeId, "1", new { @class = "", @checked = true, @id = "PaymentOnline" }) Online</label>
                        @*<label class="RBank">@Html.RadioButtonFor(m => m.PaymentTypeId, "2", new { @class = "", @id = "PaymentOffline" }) RTGS/NEFT Generate Challan</label>*@
                        @*@{
                            //Only in case of transport scheme.
                            if (Model.SchemeType == OnlineSchemeType.Transport)
                            {
                        <label class="RBank">@Html.RadioButtonFor(m => m.PaymentTypeId, "3", new { @class = "", @id = "PreviousApplicant" }) For previous Applicant. (If form already submitted and refund not taken)</label>
                            }
                        }*@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12 form-group" id="OnlinePayment">
            <div class="inr-bx" style="">
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-4 col-sm-4 col-xs-12 form-group" style="text-align:center">
                            @Html.Label("Select Gateway: ", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-8 col-sm-8 col-xs-12 form-group">
                            @*<label class="banklbl">
                                <input type="radio" name="BankType" value="1" checked="checked" />
                                <img class="banklogo" src="~/Content/Images/Payment/BankLogo/indus-1.png" />
                            </label>*@
                            <label class="banklbl">
                                <input type="radio" name="BankType" value="2" checked="checked" />
                                <img class="banklogo" style="height: 20px;" src="~/Content/Images/Payment/BankLogo/hdfc.png" />
                            </label>
                            @*<label class="banklbl">
                                <input type="radio" name="BankType" value="3" />
                                <img class="banklogo" style="height: 22px;" src="~/Content/Images/Payment/BankLogo/icici.png" />
                            </label>*@
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12 form-group text-center">
                            <input type="button" class="btn btn-add" id="btnOnlinePaymentOTP" value="Submit" />
                            <input type="button" id="btnPopUpWindowCancel" value="Cancel" class="btn btn-default" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-12 col-sm-12 col-xs-12 form-group" id="OfflinePayment">
            <div class="inr-bx" style="">
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-4 col-sm-4 col-xs-12 form-group" style="text-align:center">
                            @Html.Label("Bank Name", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-6 col-sm-6 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(m => m.ChallanBankId)
                            .Filter("contains")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel("---Select---")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetBankListforOnline", "Payment").Data("FilterSchemeID");
                                });
                            })
                            .Events(events => { events.Change("GetAccountNo"); })
                            .HtmlAttributes(new { @class = "DisableKeyboardInput", style = "width: 100%" })
                            )
                            @Html.ValidationMessageFor(model => model.ChallanBankId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12 form-group text-center">
                            <input type="button" class="btn btn-add" id="btnGenerateChallan" value="Generate Challan" />
                            <input type="button" id="btnPopUpWindowCancel_challan" value="Cancel" class="btn btn-default" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-12 col-sm-12 col-xs-12 form-group" id="OfflinePayment_RTGS">
            <div class="inr-bx" style="">
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-4 col-sm-4 col-xs-12 form-group" style="text-align:center">
                            @Html.Label("Select Bank:", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-8 col-sm-8 col-xs-12 form-group">
                            @foreach (var item in Model.BankModel)
                            {
                                <input type="radio" name="ChallanRTGS" value="@item.Id" checked="checked" /> @item.Text
                            }
                            @*<img class="banklogo" src="~/Content/Images/Payment/BankLogo/indus-1.png" />*@
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12 form-group text-center">
                            <input type="button" class="btn btn-add" id="btnGenerateChallan_RTFS" value="Generate Challan" />
                            <input type="button" id="btnPopUpWindowCancel_challan_rtgs" value="Cancel" class="btn btn-default" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-12 col-sm-12 col-xs-12 form-group" id="DivUploadPreviousChallan">
            <div class="inr-bx" style="">
                <div class="form-bx">
                    @using (Html.BeginForm("UploadPreviousChallan", "Payment", FormMethod.Post, new { enctype = "multipart/form-data", id = "UploadPreChallanform" }))
                    {
                        @Html.HiddenFor(m => m.ApplicationFormId)
                        @Html.HiddenFor(m => m.AppType)
                        <div class="row">
                            <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                                @Html.Label("Trans ID/Challan No:", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-8 col-sm-8 col-xs-12 form-group">
                                @Html.TextBoxFor(m => m.PaymentModel.TransactionId, htmlAttributes: new { @maxlength = "15", @class = "form-control" })
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                                @Html.Label("Amount:", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-8 col-sm-8 col-xs-12 form-group">
                                @Html.TextBoxFor(m => m.PaymentModel.Amount, htmlAttributes: new { @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                                @Html.Label("Trans/Challan Date:", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-8 col-sm-8 col-xs-12 form-group">
                                @(Html.Kendo().DatePickerFor(model => model.PaymentModel.EntryDate)
                                    .HtmlAttributes(new { style = "width:100%", @class = "DisableKeyboardInput" })
                                )
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                                @Html.Label("Bank:", htmlAttributes: new { @class = "required", @maxlength = "15", })
                            </div>
                            <div class="col-md-8 col-sm-8 col-xs-12 form-group">
                                @Html.TextBoxFor(m => m.PaymentModel.BankName, htmlAttributes: new { @class = "form-control" })
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12 form-group" style="text-align:center">
                                @Html.Label("Upload Challan:", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-8 col-sm-8 col-xs-12 form-group">
                                <input type='file' id='UploadPreviousChallan_file' class='PreviousUploadChallan' name='files' onchange='CheckFilePreChallanSize(this)' />
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12 form-group text-center">
                                <input type="button" class="btn btn-add" id="btnUploadChallan" value="Upload Previous Challan" />
                                <input type="button" value="Cancel" id="btnPopUpWindowCancel_uploadPreChallan" class="btn btn-default" />
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div id="divPrintChallan" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 60%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close challanWindowClose" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Challan</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:400px;">
                <div id="divChallanBody"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintchallanDiv();">Print</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $("#OnlinePayment").show();
    $("#OfflinePayment").hide();
    $("#OfflinePayment_RTGS").hide();
    $("#DivUploadPreviousChallan").hide();

    $(document).ready(function () {

        //Disbable Offline Payment
        //$("input[type='radio'][name=PaymentTypeId][value=2]").attr("disabled", "disabled");
        //Disable Bank In Online Bank
        $("input[type='radio'][name=BankType][value=2]").attr("disabled", "disabled");
        $("input[type='radio'][name=BankType][value=3]").attr("disabled", "disabled");
        //Disable Bank In RTGS
        // $("input[type='radio'][name=ChallanRTGS][value=67]").attr("disabled", "disabled");//HDFC
        $("input[type='radio'][name=ChallanRTGS][value=48]").attr("disabled", "disabled");//ICICI
        // $("input[type='radio'][name=ChallanRTGS][value=74]").attr("disabled", "disabled");//INDUSIND
        $('#divPaymentwindow').kendoWindow({
            modal: true,
            title: "Online Payment",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "30%"
            },
            width: "50%", height: "45%"
        });

        $('#btnOnlinePaymentOTP').click(function () {
            var BankType = $('input[name=BankType]:checked').val();
            if (BankType.trim() != "") {
                var formId = $("#ApplicationFormId").val();
                window.location.href = '@Url.Action("BrochureOnlinePayment", "Payment", new { area = "Online"})' + "/?id=" + formId + "&banktype=" + BankType;
            }
            else {
                alertify.success("Select Bank.");
                return false;
            }
        });

        $('#PaymentMode input:radio[name=PaymentTypeId]').on('change', function () {
            var formType = $('input[name=PaymentTypeId]:checked', '#PaymentMode').val();
            if (formType.trim() == "1") {
                $("#OnlinePayment").show();
                // $("#OfflinePayment").hide();
                $("#OfflinePayment_RTGS").hide();
                $("#DivUploadPreviousChallan").hide();

            } else if (formType.trim() == "2") {
                //$("#OfflinePayment").show();
                $("#OnlinePayment").hide();
                $("#OfflinePayment_RTGS").show();
                $("#DivUploadPreviousChallan").hide();
            }
            else if (formType.trim() == "3") {
                $("#OnlinePayment").hide();
                $("#OfflinePayment_RTGS").hide();
                $("#DivUploadPreviousChallan").show();
            }
            else {
                alertify.success("Select payment Method.");
                return false;
            }
        });

        $("#btnPopUpWindowCancel").click(function () {
            $("#divPaymentwindow").data("kendoWindow").close();
        });

        $("#btnPopUpWindowCancel_challan").click(function () {
            $("#divPaymentwindow").data("kendoWindow").close();
        });

        $("#btnPopUpWindowCancel_challan_rtgs").click(function () {
            $("#divPaymentwindow").data("kendoWindow").close();
        });

        $("#btnPopUpWindowCancel_uploadPreChallan").click(function () {
            $("#divPaymentwindow").data("kendoWindow").close();
        });

        $(".challanWindowClose").click(function () {
            window.location.href = '@Url.Action("SchemeInformation", "Application", new { area = "Online"})';
        });

        $("#btnPayment").click(function () {
            var formId = $("#ApplicationFormId").val();
            var type = "Payment";
            ValidatePayment(formId, type);
        });
    });

    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }

    $("#btnUploadChallan").click(function () {
        bflag = true;
        var transactionId = $("#PaymentModel_TransactionId").val();
        var amount = $("#PaymentModel_Amount").val();
        var entryDate = $("#PaymentModel_EntryDate").val();
        var bankName = $("#PaymentModel_BankName").val();
        var challanFile = $("#UploadPreviousChallan_file").val();

        if (transactionId == "") {
            alertify.error("Please enter transaction/challan Id.");
            return bflag = false;
        }
        else if (amount == "") {
            alertify.error("Please enter amount.");
            return bflag = false;
        }
        else if (entryDate == "") {
            alertify.error("Please enter transaction/challan date.");
            return bflag = false;
        }
        else if (bankName == "") {
            alertify.error("Please enter bank name.");
            return bflag = false;
        }
        else if (challanFile == '') {
            return alertify.error("Please upload challan/transaction reciept.");
        }

        $("#UploadPreChallanform").submit();
        bflag = true;


    });

    function GetAccountNo() {
        var schemeId = $("#SchemeId").val();
        var bankId = $("#ChallanBankId").val();

        $.ajax({
            type: 'POST',
            dataType: 'json',
            data: { schemeId: schemeId, bankId: bankId },
            url: '/Online/Payment/GetAccountNo',
            success: function (result) {
                if (result != null) {
                    $("#ChallanAccountNo").val(result.AccountNo);
                    $("#ChallanBranchName").val(result.BranchName);
                    $("#ChallanBranchId").val(result.BranchId);
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                //alert(respText);
            }
        });
    }

    function GetIFSCAccountPrefix(nschemeId, nbankId) {
        var schemeId = nschemeId;
        var bankId = nbankId;

        $.ajax({
            type: 'POST',
            dataType: 'json',
            data: { schemeId: schemeId, bankId: bankId },
            url: '/Online/Payment/GetAccountNo',
            success: function (result) {
                if (result != null) {
                    $("#ChallanAccountNo").val(result.AccountNo);
                    $("#ChallanBranchName").val(result.BranchName);
                    $("#ChallanBranchId").val(result.BranchId);
                    $("#BankIFSCCode").val(result.BankIFSC);
                    $("#VirtualAccPrefix").val(result.VirtualAccountPrefix);
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                //alert(respText);
            }
        });
    }

    $("#btnGenerateChallan").click(function () {
        var schemeId = $("#SchemeId").val()
        var FormId = $("#ApplicationFormId").val();
        var bankId = $("#ChallanBankId").val();
        //GetAccountNo(schemeId, bankId);

        var DdlAccountNumber = $("#ChallanAccountNo").val();
        var branchId = $("#ChallanBranchId").val();

        if (bankId == "") {
            alertify.error("Please select Bank.");
            return false;
        }

        var objOnlineModel = { ApplicationFormId: FormId, ChallanBankId: bankId, ChallanBranchId: branchId, ChallanAccountNo: DdlAccountNumber };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(objOnlineModel),
            url: '/Online/Payment/GenerateChallanForScheme',
            success: function (result) {
                $("#divPaymentwindow").data("kendoWindow").close();
                $("#divChallanBody").html(result);
                $("#divPrintChallan").modal('show');
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alertify.error("Some Error in save database.");
            }
        });
    });

    $("#btnGenerateChallan_RTFS").click(function () {

        var FormId = $("#ApplicationFormId").val();
        var BankType = $('input[name=ChallanRTGS]:checked').val();
        var schemeId = $("#SchemeId").val();
        $.ajax({
            type: 'POST',
            dataType: 'json',
            data: { schemeId: schemeId, bankId: BankType },
            url: '/Online/Payment/GetAccountNo',
            success: function (result) {
                if (result != null) {
                    //$("#ChallanAccountNo").val(result.AccountNo);
                    //$("#ChallanBranchName").val(result.BranchName);
                    //$("#ChallanBranchId").val(result.BranchId);
                    $("#BankIFSCCode").val(result.BankIFSC);
                    $("#VirtualAccPrefix").val(result.VirtualAccountPrefix);
                    var nBankIFSCCode = $("#BankIFSCCode").val();
                    var nVirtualAccPrefix = $("#VirtualAccPrefix").val();
                    var objOnlineModel = { ApplicationFormId: FormId, ChallanBankId: BankType, BankIFSCCode: nBankIFSCCode, VirtualAccPrefix: nVirtualAccPrefix };
                    GenerateRTGS_Challan_Ajax(objOnlineModel);
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                //alert(respText);
            }
        });
    });

    //Re-Print Challan
    $("#btnRePrintSchemeChallan").click(function () {
        var FormId = $("#ApplicationFormId").val();
        var objOnlineModel = { ApplicationFormId: FormId };
        GenerateRTGS_Challan_Ajax(objOnlineModel);
    });

    function GenerateRTGS_Challan_Ajax(objOnlineModel) {
        var nobjOnlineModel = objOnlineModel;
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(objOnlineModel),
            url: '/Online/Payment/GenerateChallanRTGSForScheme',
            success: function (result) {
                $("#divPaymentwindow").data("kendoWindow").close();
                $("#divChallanBody").html(result);
                $("#divPrintChallan").modal('show');
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                alertify.error("Some Error in save database.");
            }
        });
    }

    function FilterbankId() {
        return { bankId: $("#ChallanBankId").val() };
    }

    function FilterSchemeID() {
        return { schemeId: $("#SchemeId").val() };
    }

    function PrintchallanDiv() {
        var contents = document.getElementById("divChallanBody").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('<link href="/Content/CSS/font-awesome.min.css" rel="stylesheet"/>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }

    $('#divPrintChallan').on('hidden.bs.modal', function () {
        ClearFieldValue();
    });

    function ClearFieldValue() {
        $("#ChallanBankId").data("kendoDropDownList").value("");
        $("#ChallanBranchId").data("kendoDropDownList").value("");
        $("#ChallanAccountNo").val('');
    }

    $("#UploadPreviousChallan_file").change(function () {
        CheckFileSizePCExt(this);
    });

    function CheckFileSizePCExt(input) {
        var file = input.files[0].name;
        var fileSize = input.files[0].size / 1024 //Size in KB
        var count = file.lastIndexOf('.') + 1;
        var ext = file.substr(count);
        if (ext == "pdf") {
            if (fileSize < 10) {
                IsError = false;
                alertify.error(file + " Min 10kb file size is allowed");
                return false;
            }
            if (fileSize / 1024 > 5) {
                IsError = false;
                alertify.error(file + " Max 5Mb file size is allowed");
                return false;
            }
        }
        else {
            alertify.error("Only jpg, png, jpeg & pdf file allowed.");
            return false;
        }
    }

    var IsError = false;
    function CheckFilePreChallanSize(row) {
        var filename = row.files[0].name;
        var size = row.files[0].size / 1024;
        var extension = filename.substr(filename.lastIndexOf('.') + 1);
        if (extension.toLowerCase() == "pdf") {
            if (size / 1024 > 5) {
                IsError = true;
                alertify.error("Maximum 5Mb file size is allowed");
            }
            if (IsError == true) {
                row.value = '';
            }
        }
        else {
            alertify.error("Please upload pdf documents.");
            row.value = '';
        }
    }
</script>