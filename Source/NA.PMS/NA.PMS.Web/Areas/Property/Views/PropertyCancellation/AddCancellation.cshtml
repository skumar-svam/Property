@model NA.PMS.Model.PropertyCancellationModel
@using Kendo.Mvc.UI
@{
    ViewBag.Title = "Cancellation Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}




<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="row">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Add New Request</h1></div>
                <div class="col-md-6 col-sm-6 col-xs-12 mandatory"></div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">

                <div class="form-bx">
                    <br />
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">@Html.Label("Type of Cancellation")</div>
                        <div class="col-md-6 col-sm-3 col-xs-12 form-group">
                            @Html.RadioButtonFor(model => model.TypeOfCancel, NA.PMS.Common.Constants.intCancellation) Cancellation
                            @Html.RadioButtonFor(model => model.TypeOfCancel, NA.PMS.Common.Constants.intSurrender) Surrender
                            @Html.RadioButtonFor(model => model.TypeOfCancel, NA.PMS.Common.Constants.intRestoration) Restoration
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">

                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">@Html.Label("Registration Id")</div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(m => m.RId)
                                .Filter("contains")
                                .DataTextField("text")
                                .DataValueField("id")
                                .OptionLabel("Select")
                                .AutoBind(false)
                                .DataSource(source =>
                                {
                                    source.Custom()
                                    .ServerFiltering(true)
                                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                    .Transport(transport =>
                                    {
                                        transport.Read(read => read.Action("GetRIDsByCancellationType", "PropertyCancellation").Data("GetCanType"));
                                    })
                                    .Schema(schema =>
                                    {
                                        schema.Data("Data").Total("Total");
                                    }).PageSize(100);
                                })
                                .Events(events => { events.Change("RIdChange"); })
                                .HtmlAttributes(new { @class = "schemeForms", style="width:100%" })
                            )
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group"></div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        </div>
                    </div>
                </div>
                <div id="divAllotteeDetails">
                    <h2 class="blck-heading">Allottee Details</h2>
                    @{Html.RenderPartial("_TransferAllotteDetails");}
                </div>

                <div id="divCancellationDetails">
                    <h2 class="blck-heading">Cancellation Details</h2>
                    <div class="form-bx">
                        <div class="row">
                            @{Html.RenderPartial("_CancellationDetails", Model);}
                        </div>
                        <div class="row" id="hdnDiv">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Cancellation Date")
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @(Html.Kendo().DatePickerFor(can => can.CancellationDate).HtmlAttributes(new { @class = "DisableKeyboardInput", style="width:100%;" }))
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group"></div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group"></div>
                        </div>
                    </div>
                </div>
                <br />

                <div id="divRestorationDetails">
                    <h2 class="blck-heading">Restoration Details</h2>
                    <div class="form-bx">
                        <div class="row">
                            @{Html.RenderPartial("_RestorationDetails", Model);}
                        </div>
                    </div>
                </div>

                <div id="RefundDetails">
                    <h2 class="blck-heading">Refund Details</h2>
                    <div class="form-bx">
                        <div class="row">
                            @{Html.RenderPartial("_RefundDetails");}
                        </div>
                    </div>
                </div>

            </div>
            <div class="box-button text-center">
                <input type="button" value="Back" id="btnBck"  class="btn btn-add"/>
                <input type="button" value="Submit for Approval" id="btnSubmit"  class="btn btn-add"/>
            </div>
        </div>
    </div>
</div>

<div id="divApproverWindow" class="container-fluid" style="min-height:200px;">
    <div class="row" style="margin-top:20px;">
        <div class="col-md-4 form-group" style="text-align:right"><label class="font-bold">@Html.Label("Assign To: ")</label></div>
        <div class="col-md-5 form-group">
            @(Html.Kendo().DropDownListFor(model => model.User)
                .Name("User")
                .DataTextField("text")
                .DataValueField("id")
                .OptionLabel("Select").Filter("contains").AutoBind(false)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetAssineToByDepttId", "PropertyRegistration").Data("AdditionalData");
                    });
                })
                .HtmlAttributes(new { style = "width:100%" })
            )
        </div>
    </div>
    <div class="row">
        <div class="col-md-4"> </div>
        <div class="col-md-8">
            <input type="button" class="btn btn-default" id="btnPopupSubmit" value="Submit" />
            <input type="button" class="btn btn-default closePopup" value="Close" />
        </div>
    </div>
</div>


