<script type="text/javascript">
    $(document).ready(function () {
        $('#divApproverWindow').kendoWindow({
            modal: true,
            title: "Approver",
            visible: false,
            width: "40%"
        });


        $("#divAllotteeDetails").hide();
        $("#divCancellationDetails").hide();
        $("#divRestorationDetails").hide();
        $("#RefundDetails").hide();
        $("#hdnDiv").hide();

        var ddlRid = $("#RId").data("kendoDropDownList");
        ddlRid.enable(false);

        //Cancellation Type Change event
        $('input[type=radio][name=TypeOfCancel]').change(function () {
            $("#divAllotteeDetails").hide();
            $("#divCancellationDetails").hide();
            $("#divRestorationDetails").hide();
            $("#RefundDetails").hide();
            $("#RId").data("kendoDropDownList").value("");
            var ddlRid = $("#RId").data("kendoDropDownList");
            ddlRid.enable(true);
            $("#RId").data("kendoDropDownList").dataSource.read();
            var cancelType = $("input[name='TypeOfCancel']:checked").val();
            if (cancelType == '@NA.PMS.Common.Constants.intCancellation' || cancelType == '@NA.PMS.Common.Constants.intSurrender') {
                $("#divRestorationDetails").hide();
                $("#hdnDiv").hide();
                $("#divCancellationDetails").show();
                //Enable fields if they are disabled
                $("#ReasonOfCancel").prop("disabled", false);
                var ddlYesNo = $("#RefundYesNo").data("kendoDropDownList");
                ddlYesNo.enable(true);
                var ddlType = $("#RefundType").data("kendoDropDownList");
                ddlType.enable(true);
                $("#RefundAmt").prop("disabled", false);
            }
            else {
                $("#divCancellationDetails").show();
                $("#divRestorationDetails").show();
                $("#hdnDiv").show();
                //Disable Cancellation Details fields
                $("#ReasonOfCancel").prop("disabled", true);
                var ddlYesNo = $("#RefundYesNo").data("kendoDropDownList");
                ddlYesNo.enable(false);
                var ddlType = $("#RefundType").data("kendoDropDownList");
                ddlType.enable(false);
                $("#RefundAmt").prop("disabled", true);
            }
        });

        //Button clicks
        $("#btnBck").click(function () {
            window.location.href = '@Url.Action("ManageCancellations", "PropertyCancellation")';
        });

        $(".closePopup").click(function () {
            $("#assignToWindow").data("kendoWindow").close();
        });

        $("#btnSubmit").click(function () {
            //Validations
            var rId = $("#RId").val();
            //var cancelType = $("#TypeOfCancel").val();
            var cancelType = $("input[name='TypeOfCancel']:checked").val();
            var cancelReason = $("#ReasonOfCancel").val();
            var refundYesNo = $("#RefundYesNo").val();
            var refundType = $("#RefundType").val();
            var refundAmt = $("#RefundAmt").val();
            var restoreReason = $("#RestorationReason").val();
            var restoreCharges = $("#RestorationCharges").val();
            var cancelDate = $("#CancellationDate").val();
            if (rId == '') {
                $("#divAllotteeDetails").hide();
                $("#RefundDetails").hide();
                ClearValues();
                alertify.error("Please select an RID");
                return false;
            }
            if (cancelType == '') {
                alertify.error("Please select Type of Cancellation");
                return false;
            }
            if (cancelType == '@NA.PMS.Common.Constants.intCancellation' || cancelType == '@NA.PMS.Common.Constants.intSurrender') {
                if (cancelReason == '') {
                    alertify.error("Please enter Reason for Cancellation");
                    return false;
                }
                if (refundYesNo == '') {
                    alertify.error("Please select Refund");
                    return false;
                }
                @*if (refundYesNo == '@NA.PMS.Common.MortPrevLoan.yes') {
                    if (refundType == '') {
                        alertify.error("Please select Refund Type");
                        return false;
                    }
                    if (refundAmt == '') {
                        alertify.error("Please enter Refund Amount");
                        return false;
                    }
                }*@
            }
            else {
                if (restoreReason == '') {
                    alertify.error("Please enter Reason for Restoration");
                    return false;
                }
                if (restoreCharges == '') {
                    alertify.error("Please enter Restoration Charges");
                    return false;
                }
                var dtCancelDate = new Date(cancelDate);
                if (dtCancelDate <= new Date()) {
                    alertify.error("Restoration Date can't be earlier than, or equal to Cancellation Date");
                    return false;
                }
            }
            
            $("#User").data("kendoDropDownList").dataSource.read();
            $("#divApproverWindow").data("kendoWindow").center();
            $("#divApproverWindow").data("kendoWindow").open();
        });

        $("#btnPopupSubmit").click(function () {
            var userVal = $("#User").val();
            var rId = $("#RId").val();
            var cancelType = $("input[name='TypeOfCancel']:checked").val();
            var cancelReason = $("#ReasonOfCancel").val();
            var refundYesNo = $("#RefundYesNo").val();
            var refundType = $("#RefundType").val();
            var refundAmt = $("#RefundAmt").val();
            var restoreReason = $("#RestorationReason").val();
            var restoreCharges = $("#RestorationCharges").val();
            if (userVal == "" || userVal == null) {
                alertify.error("Please select a User.");
                return false;
            }
            else {
                $.ajax({
                    dataType: 'json',
                    type: 'Post',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({
                        rId: rId, cancelType: cancelType, cancelReason: cancelReason, refundYesNo: refundYesNo, refundType: refundType, refundAmt: refundAmt, userVal: userVal, restoreReason: restoreReason, restoreCharges: restoreCharges
                    }),
                    url: '/PropertyCancellation/SaveCancellation',
                    success: function (result) {
                        if (result == true) {
                            $("#divApproverWindow").data("kendoWindow").close();
                            alertify.success("Data saved successfully.");
                            window.location.href = '@Url.Action("ManageCancellations", "PropertyCancellation")';
                        }
                        else if (result == false) {
                            $("#divApproverWindow").data("kendoWindow").close();
                            alertify.error("This property can't be Restored as refund has already been initiated for this RID");
                        }
                    },
                    error: function (objAjaxRequest, strError) {
                        var respText = objAjaxRequest.responseText;
                        alertify.error("Some error occured. Please try again later.");
                        //alert(respText);
                    }
                });

            }
        });
    });

    //Change event of Refund DDL to enable disable Refund related fields accordingly
    function RefundYesNoChange() {
        var refundYesNo = $("#RefundYesNo").val();
        if (refundYesNo == '@NA.PMS.Common.MortPrevLoan.no') {
            var ddlType = $("#RefundType").data("kendoDropDownList");
            ddlType.enable(false);
            $("#RefundAmt").prop("disabled", true);
        }
        else {
            var ddlType = $("#RefundType").data("kendoDropDownList");
            ddlType.enable(true);
            $("#RefundAmt").prop("disabled", false);
        }
    }

    function RIdChange() {
        var rId = $("#RId").val();
        var cancelType = $("input[name='TypeOfCancel']:checked").val();
        if (rId == '') {
            $("#divAllotteeDetails").hide();
            $("#RefundDetails").hide();
            ClearValues();
            alertify.error("Please select an RID");
            return false;
        }
        //GetKYADetails(rId);
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rId: rId }),
            url: '/PropertyRegistration/GetOriginalDetailsForTransferByRID',
            success: function (result) {
                if (result != null) {
                    $("#lblScNa").html(result.SchemeName);
                    $("#lblDeNa").html(result.DepttName);
                    $("#lblApNa").html(result.ApplicantName);
                    $("#lblCoNa").html(result.TransfereeCompanyName);
                    $("#lblGend").html(result.Gender);
                    $("#lblReNa").html(result.RelationName);
                    $("#lblSiAu").html(result.TransfereeCompanySigningAuth);
                    $("#lblPropTy").html(result.PropType);
                    $("#lblArea").html(result.Area);
                    $("#lblFloo").html(result.Floor);
                    $("#lblProMo").html(result.PropMortgaged);
                    $("#lblProFu").html(result.PropFunctional);
                    $("#lblOTLR").html(result.OneTimeLeaseRent);
                    $("#hdnDepttId").val(result.DepttId);
                    $("#hdnPropId").val(result.PropId);
                    $("#BalanceDues").val(result.BalanceDues);
                    //Refund Details data
                    $("#lblDedAmt").html(result.DeductionAmnt);
                    $("#lblUnit").html(result.Unit);
                    $("#lblDedApp").html(result.DeductionApplyOn);
                    $("#lblRLP").html(result.RefundLockPeriod);
                    $("#lblIntRate").html(result.InterestRate);
                    $("#lblDAI").html(result.DaysAfterInterest);
                    //Get Cancellation details in case of Restoration
                    if (cancelType == '@NA.PMS.Common.Constants.intRestoration') {
                        $("#ReasonOfCancel").val(result.ReasonOfCancel);
                        $("#CancellationDate").data("kendoDatePicker").value(result.CancellationDate);
                    }

                    if (result.Gender.toLowerCase() == '@NA.PMS.Common.Constants.genderCompany'.toLowerCase()) {
                        $(".mfGender").hide();
                        $(".comGender").show();
                    }
                    else {
                        $(".mfGender").show();
                        $(".comGender").hide();
                    }

                    $("#divAllotteeDetails").show();
                    $("#RefundDetails").show();
                }
                else {
                    $("#divAllotteeDetails").hide();
                    $("#RefundDetails").hide();
                    ClearValues();
                    alertify.error("Some error occured. Please try again later.");
                }
            },
            error: function (obj) {
                $("#divAllotteeDetails").hide();
                $("#RefundDetails").hide();
                ClearValues();
                alertify.error("Some error occured. Please try again later.");
            }
        });
    }

    function GetKYADetails(rId) {
        //var rId = $("#RId").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ RegistrationId: rId }),
            url: '/Property/PropertyRegistration/GetKYADetailsForRid',
            success: function (result) {
                if (result != null) {
                    if (result.StatusId == "2") {
                        alertify.error("Your KYA has been Rejected. Please Complete your KYA again.");
                        $('#btnSubmit').attr('disabled', 'disabled');
                        return false;
                    }
                    else if (result.StatusId == "" || result.StatusId == null) {
                        alertify.error("Please Complete your KYA.");
                        $('#btnSubmit').prop('disabled', true);
                        return false;
                    }
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }
        });
    }

    function ClearValues() {
        $("#lblScNa").html('');
        $("#lblDeNa").html('');
        $("#lblApNa").html('');
        $("#lblGend").html('');
        $("#lblReNa").html('');
        $("#lblPropTy").html('');
        $("#lblArea").html('');
        $("#lblFloo").html('');
        $("#lblProMo").html('');
        $("#lblProFu").html('');
        $("#BalanceDues").val('');
        $("#DepttId").val('');
        //Refund Details data
        $("#lblDedAmt").html('');
        $("#lblUnit").html('');
        $("#lblDedApp").html('');
        $("#lblRLP").html('');
        $("#lblIntRate").html('');
        $("#lblDAI").html('');
    }

    function AdditionalData() {
        return {
            depttId: $("#hdnDepttId").val()
        };
    }

    function GetCanType() {
        var type = $("input[name='TypeOfCancel']:checked").val();
        return {
            type: type
        };
    }

    function RefundTypeData() {
        var rId = $("#RId").val();
        var depttId = $("#hdnDepttId").val();
        return { rId: rId, depttId: depttId };
    }
</script>