@model NA.PMS.Model.PropertyCancellationModel
@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions;
@{
    ViewBag.Title = "View Cancellation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="row">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">View Cancellation</h1></div>
                <div class="col-md-6 col-sm-6 col-xs-12 col-btn">
                    <a  href="#" id="btnComment" >View Comments</a>
                </div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">

                <div class="form-bx">
                    <br />
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">@Html.Label("Type of Cancellation")</div>
                        <div class="col-md-6 col-sm-3 col-xs-12 form-group">
                            @Html.RadioButtonFor(model => model.TypeOfCancel, NA.PMS.Common.Constants.intCancellation) Cancellation
                            @Html.RadioButtonFor(model => model.TypeOfCancel, NA.PMS.Common.Constants.intSurrender) Surrender
                            @Html.RadioButtonFor(model => model.TypeOfCancel, NA.PMS.Common.Constants.intRestoration) Restoration
                        </div>                     
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">@Html.Label("Registration Id")</div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(m => m.RId, htmlAttributes: new { @class = "form-control", onchange = "RIdChange()" , @readonly="readonly"})
                            @*@(Html.Kendo().DropDownListFor(m => m.RId)
                            .Filter("contains")
                            .DataTextField("text")
                            .DataValueField("id")
                            .OptionLabel("Select")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetRIDsByCancellationType", "PropertyCancellation").Data("GetCanType");
                                });
                            })
                            .Events(events => { events.Change("RIdChange"); })
                            .HtmlAttributes(new { @class = "schemeForms" })
                            )*@
                            @Html.HiddenFor(m => m.Status)
                            @Html.HiddenFor(m => m.ReqNo)
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group"></div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        </div>
                    </div>
                </div>
                <div id="divallotteedetails">
                    <h2 class="blck-heading">Allottee Details</h2>
                    @{Html.RenderPartial("_TransferAllotteDetails");}
                </div>

                <div id="divCancellationDetails">
                    <h2 class="blck-heading">Cancellation Details</h2>
                    <div class="form-bx">
                        <div class="row">
                            @{Html.RenderPartial("_CancellationDetails", Model);}
                        </div>
                    </div>
                </div>
                <br />

                <div id="divRestorationDetails">
                    <h2 class="blck-heading">Restoration Details</h2>
                    <div class="form-bx">
                        <div class="row">
                            @{Html.RenderPartial("_RestorationDetails", Model);}
                        </div>
                    </div>
                </div>

                <div id="RefundDetails">
                    <h2 class="blck-heading">Refund Details</h2>
                    <div class="form-bx">
                        <div class="row">
                            @{Html.RenderPartial("_RefundDetails");}
                        </div>
                    </div>
                </div>
               
            </div>
            <div class="box-button text-center">
                <input type="button" value="Re-Submit" class="btn btn-default" id="btnResubmit" />
                <button type="button" id="btnCancel" class="btn btn-default">Cancel</button>
                <button type="button" value="back" class="btn btn-default" onclick="javascript: window.location = '@Url.Action("ManageCancellations", "PropertyCancellation")';">Back</button>
            </div>
        </div>
    </div>
</div>

<div id="divApproverWindow" class="container-fluid pop-up-window" style="min-height:200px;">
    <div class="row">
        <div class="col-md-4 form-group" style="text-align:right"><label class="font-bold">@Html.Label("Assign To: ")</label></div>
        <div class="col-md-4 form-group">
            @(Html.Kendo().DropDownListFor(model => model.User)
                .Name("User")
                .DataTextField("text")
                .DataValueField("id")
                .OptionLabel("Select").Filter("contains").AutoBind(false)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetAssineToByDepttId", "PropertyRegistration").Data("AdditionalData");
                    });
                })
            )
        </div>
    </div>
    <div class="row">
        <div class="col-md-4"> </div>
        <div class="col-md-8" style="text-align:right">
            <input type="button" class="btn btn-default" id="btnPopupSubmit" value="Submit" />
            <input type="button" class="btn btn-default closePopup" value="Close" />
        </div>
    </div>
</div>


<div id="divCommentBox" class="container-fluid pop-up-window" style="min-height:200px;">
    <div class="row">
        <div class="col-md-3"><label class="font-bold">From:</label></div>
        <div class="col-md-9"> <label>@Html.DisplayFor(model => model.From)</label> </div>
    </div>
    <div class="row">
        <div class="col-md-3"> <label class="font-bold">Date:</label> </div>
        <div class="col-md-9"> <label>@Convert.ToString(string.Format("{0:dd/MM/yyyy}", Model.SubmittedDate))</label> </div>
    </div>
    <div class="row">
        <div class="col-md-3"> <label class="font-bold">Comment: </label> </div>
        <div class="col-md-9"> <label>@Html.DisplayFor(model => model.Comment)</label> </div>
    </div>
</div>


