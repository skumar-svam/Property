<script type="text/javascript">
    $(document).ready(function () {
        $('.pop-up-window').kendoWindow({
            modal: true,
            title: "Comments",
            visible: false,
            width: "40%"
        });

        //Gets Readonly values according to RID
        var rId = $("#RId").val();
        if (rId == '') {
            $("#divAllotteeDetails").hide();
            $("#RefundDetails").hide();
            ClearValues();
            alertify.error("Please select an RID");
            return false;
        }
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rId: rId }),
            url: '/PropertyRegistration/GetOriginalDetailsForTransferByRID',
            success: function (result) {
                if (result != null) {
                    $("#lblScNa").html(result.SchemeName);
                    $("#lblDeNa").html(result.DepttName);
                    $("#lblApNa").html(result.ApplicantName);
                    $("#lblCoNa").html(result.TransfereeCompanyName);
                    $("#lblGend").html(result.Gender);
                    $("#lblReNa").html(result.RelationName);
                    $("#lblPropTy").html(result.PropType);
                    $("#lblArea").html(result.Area);
                    $("#lblFloo").html(result.Floor);
                    $("#lblProMo").html(result.PropMortgaged);
                    $("#lblProFu").html(result.PropFunctional);
                    $("#lblOTLR").html(result.OneTimeLeaseRent);
                    $("#hdnDepttId").val(result.DepttId);
                    $("#hdnPropId").val(result.PropId);
                    $("#BalanceDues").val(result.BalanceDues);
                    //Refund Details data
                    $("#lblDedAmt").html(result.DeductionAmnt);
                    $("#lblUnit").html(result.Unit);
                    $("#lblDedApp").html(result.DeductionApplyOn);
                    $("#lblRLP").html(result.RefundLockPeriod);
                    $("#lblIntRate").html(result.InterestRate);
                    $("#lblDAI").html(result.DaysAfterInterest);

                    if (result.Gender.toLowerCase() == '@NA.PMS.Common.Constants.genderCompany'.toLowerCase()) {
                        $(".mfGender").hide();
                        $(".comGender").show();
                    }
                    else {
                        $(".mfGender").show();
                        $(".comGender").hide();
                    }

                    $("#divAllotteeDetails").show();
                    $("#RefundDetails").show();
                }
                else {
                    $("#divAllotteeDetails").hide();
                    $("#RefundDetails").hide();
                    ClearValues();
                    alertify.error("Some error occured. Please try again later.");
                }
            },
            error: function (obj) {
                $("#divAllotteeDetails").hide();
                $("#RefundDetails").hide();
                ClearValues();
                alertify.error("Some error occured. Please try again later.");
            }
        });

        //Show hide Partial Views according to Type of Request
        $("#divCancellationDetails").hide();
        $("#divRestorationDetails").hide();
        var cancelTypeOnLoad = $("input[name='TypeOfCancel']:checked").val();
        if (cancelTypeOnLoad == '@NA.PMS.Common.Constants.intCancellation' || cancelTypeOnLoad == '@NA.PMS.Common.Constants.intSurrender') {
            $("#divRestorationDetails").hide();
            $("#divCancellationDetails").show();
        }
        else {
            $("#divCancellationDetails").hide();
            $("#divRestorationDetails").show();
        }

        //Button show/hide according to the Status
        $("#btnResubmit").hide();
        $("#btnComment").hide();
        DisableControls();

        var status = $("#Status").val();
        if (status == '@NA.PMS.Common.AllotmentStatus.Rejected') {
            $("#btnComment").show();
            EnableControls();

            $("#btnResubmit").show();
        }

        if (status == '@NA.PMS.Common.AllotmentStatus.Approved') {
            $("#btnCancel").hide();
            $("#btnComment").show();
        }

        if (status == '@NA.PMS.Common.AllotmentStatus.Cancelled') {
            EnableControls();
            $("#btnCancel").hide();
            $("#btnResubmit").show();
        }

        //Always keep these two fields disabled
        $('input[name=TypeOfCancel]').attr("disabled", true);
        //var ddlRid = $("#RId").data("kendoDropDownList");
        //ddlRid.enable(false);

        //Cancellation Type Change event
        $('input[type=radio][name=TypeOfCancel]').change(function () {
            var ddlRid = $("#RId").data("kendoDropDownList");
            ddlRid.enable(true);
            $("#RId").data("kendoDropDownList").dataSource.read();
            var cancelType = $("input[name='TypeOfCancel']:checked").val();
            if (cancelType == '@NA.PMS.Common.Constants.intCancellation' || cancelType == '@NA.PMS.Common.Constants.intSurrender') {
                $("#divRestorationDetails").hide();
                $("#divCancellationDetails").show();
            }
            else {
                $("#divCancellationDetails").hide();
                $("#divRestorationDetails").show();
            }
        });

        //Button clicks
        $("#btnCancel").click(function () {
            var requestId = $('#ReqNo').val();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ requestId: requestId }),
                url: '/PropertyCancellation/CancelRequest',
                success: function (result) {
                    if (result == true) {

                    }
                    else {
                        //return true;
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    alert(respText);
                }
            });
        });

        $("#btnPopupSubmit").click(function () {
            var userVal = $("#User").val();
            var rId = $("#RId").val();
            var cancelType = $("input[name='TypeOfCancel']:checked").val();
            var cancelReason = $("#ReasonOfCancel").val();
            var refundYesNo = $("#RefundYesNo").val();
            var refundType = $("#RefundType").val();
            var refundAmt = $("#RefundAmt").val();
            var reqNo = $("#ReqNo").val();
            if (userVal == "" || userVal == null) {
                alertify.error("Please select a User.");
                return false;
            }
            else {
                $.ajax({
                    dataType: 'json',
                    type: 'Post',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({
                        rId: rId, cancelType: cancelType, cancelReason: cancelReason, refundYesNo: refundYesNo, refundType: refundType, refundAmt: refundAmt, userVal: userVal, reqNo: reqNo
                    }),
                    url: '/PropertyCancellation/SaveCancellation',
                    success: function (result) {
                        if (result == true) {
                            $("#assignToWindow").data("kendoWindow").close();
                            alertify.success("Data saved successfully.");
                            window.location.href = '@Url.Action("ManageCancellations", "PropertyCancellation")';
                        }
                        else {
                            alertify.error("Some error occured. Please try again later.");
                        }
                    },
                    error: function (objAjaxRequest, strError) {
                        var respText = objAjaxRequest.responseText;
                        alertify.error("Some error occured. Please try again later.");
                        //alert(respText);
                    }
                });

            }
        });

        $(".closePopup").click(function () {
            $("#viewCommentsWindow").data("kendoWindow").close();
            $("#commentsWindow").data("kendoWindow").close();
        });

        $("#btnComment").click(function () {
            $("#divCommentBox").data("kendoWindow").center();
            $("#divCommentBox").data("kendoWindow").open();
        });

        $("#btnResubmit").click(function () {
            //Validations
            var cancelType = $("input[name='TypeOfCancel']:checked").val();
            var cancelReason = $("#ReasonOfCancel").val();
            var refundYesNo = $("#RefundYesNo").val();
            var refundType = $("#RefundType").val();
            var refundAmt = $("#RefundAmt").val();
            if (cancelReason == '') {
                alertify.error("Please enter Reason of Cancellation");
                return false;
            }
            if (refundYesNo == '') {
                alertify.error("Please select Refund");
                return false;
            }
            if (refundYesNo == '@NA.PMS.Common.MortPrevLoan.yes') {
                if (refundType == '') {
                    alertify.error("Please select Refund Type");
                    return false;
                }
                if (refundAmt == '') {
                    alertify.error("Please enter Refund Amount");
                    return false;
                }
            }
           
            $("#User").data("kendoDropDownList").dataSource.read();
            $("#divApproverWindow").data("kendoWindow").center();
            $("#divApproverWindow").data("kendoWindow").open();
        });
    });

    //Change event of Refund DDL to enable disable Refund related fields accordingly
    function RefundYesNoChange() {
        var refundYesNo = $("#RefundYesNo").val();
        if (refundYesNo == '@NA.PMS.Common.MortPrevLoan.no') {
            var ddlType = $("#RefundType").data("kendoDropDownList");
            ddlType.enable(false);
            $("#RefundAmt").prop("disabled", true);
        }
        else {
            var ddlType = $("#RefundType").data("kendoDropDownList");
            ddlType.enable(true);
            $("#RefundAmt").prop("disabled", false);
        }
    }

    function DisableControls() {
        $("#ReasonOfCancel").prop("disabled", true);
        var ddlYesNo = $("#RefundYesNo").data("kendoDropDownList");
        ddlYesNo.enable(false);
        var ddlType = $("#RefundType").data("kendoDropDownList");
        ddlType.enable(false);
        $("#RefundAmt").prop("disabled", true);
        $("#RestorationReason").prop("disabled", true);
        $("#RestorationCharges").prop("disabled", true);
    }

    function EnableControls() {
        $("#ReasonOfCancel").prop("disabled", false);
        var ddlYesNo = $("#RefundYesNo").data("kendoDropDownList");
        ddlYesNo.enable(true);
        var ddlType = $("#RefundType").data("kendoDropDownList");
        ddlType.enable(true);
        $("#RefundAmt").prop("disabled", false);
        $("#RestorationReason").prop("disabled", false);
        $("#RestorationCharges").prop("disabled", false);
    }

    function RIdChange() {
        var rId = $("#RId").val();
        if (rId == '') {
            $("#divAllotteeDetails").hide();
            $("#RefundDetails").hide();
            ClearValues();
            alertify.error("Please select an RID");
            return false;
        }
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rId: rId }),
            url: '/PropertyRegistration/GetOriginalDetailsForTransferByRID',
            success: function (result) {
                if (result != null) {
                    $("#lblScNa").html(result.SchemeName);
                    $("#lblDeNa").html(result.DepttName);
                    $("#lblApNa").html(result.ApplicantName);
                    $("#lblGend").html(result.Gender);
                    $("#lblReNa").html(result.RelationName);
                    $("#lblPropTy").html(result.PropType);
                    $("#lblArea").html(result.Area);
                    $("#lblFloo").html(result.Floor);
                    $("#lblProMo").html(result.PropMortgaged);
                    $("#lblProFu").html(result.PropFunctional);
                    $("#lblOTLR").html(result.OneTimeLeaseRent);
                    $("#hdnDepttId").val(result.DepttId);
                    $("#hdnPropId").val(result.PropId);
                    $("#BalanceDues").val(result.BalanceDues);
                    //Refund Details data
                    $("#lblDedAmt").html(result.DeductionAmnt);
                    $("#lblUnit").html(result.Unit);
                    $("#lblDedApp").html(result.DeductionApplyOn);
                    $("#lblRLP").html(result.RefundLockPeriod);
                    $("#lblIntRate").html(result.InterestRate);
                    $("#lblDAI").html(result.DaysAfterInterest);
                    $("#divAllotteeDetails").show();
                    $("#RefundDetails").show();
                }
                else {
                    $("#divAllotteeDetails").hide();
                    $("#RefundDetails").hide();
                    ClearValues();
                    alertify.error("Some error occured. Please try again later.");
                }
            },
            error: function (obj) {
                $("#divAllotteeDetails").hide();
                $("#RefundDetails").hide();
                ClearValues();
                alertify.error("Some error occured. Please try again later.");
            }
        });
    }

    function GetCanType() {
        var type = $("input[name='TypeOfCancel']:checked").val();
        return {
            type: type
        };
    }

    function RefundTypeData() {
        var rId = $("#RId").val();
        var depttId = $("#hdnDepttId").val();
        return { rId: rId, depttId: depttId };
    }

    function AdditionalData() {
        return {
            depttId: $("#hdnDepttId").val()
        };
    }

    function ClearValues() {
        $("#lblScNa").html('');
        $("#lblDeNa").html('');
        $("#lblApNa").html('');
        $("#lblGend").html('');
        $("#lblReNa").html('');
        $("#lblPropTy").html('');
        $("#lblArea").html('');
        $("#lblFloo").html('');
        $("#lblProMo").html('');
        $("#lblProFu").html('');
        $("#BalanceDues").val('');
        $("#DepttId").val('');
        //Refund Details data
        $("#lblDedAmt").html('');
        $("#lblUnit").html('');
        $("#lblDedApp").html('');
        $("#lblRLP").html('');
        $("#lblIntRate").html('');
        $("#lblDAI").html('');
    }
</script>
