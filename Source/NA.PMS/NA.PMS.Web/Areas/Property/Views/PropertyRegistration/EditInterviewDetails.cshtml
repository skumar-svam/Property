        <script type="text/javascript">
            $("#lblDepartmentDrop").addClass("hide");
            $("#lblDepartmentId").addClass("show");

            $("#lblSchemeNameDrop").addClass("hide");
            $("#lblSchemeName").addClass("show");

            $("#lblFormDrop").addClass("hide");
            $("#lblForm").addClass("show");
            $("#btnBack").click(function () {
                window.location.href = '@Url.Action("ManageInterviewDetails", "PropertyRegistration")';
            });


            $("#btnSubmit").click(function () {
                var InterviewDetails = $("#InterviewDetails").val();
                var InterviewDate = $("#InterviewDate").val();
                var ApplicationId = $("#ApplicationId").val();
                var SchemeId = $("#SchemeId").val();
                alert("SchemeId=" + SchemeId);
                var Id = $("#Id").val();
                if (InterviewDate == "") {
                    alertify.error("Please enter Interview Date.");
                    return false;
                }
                if (InterviewDetails == "") {
                    alertify.error("Please enter Interview Details.");
                    return false;
                }
                $.ajax({
                    dataType: 'json',
                    type: 'Post',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({ InterviewDetails: InterviewDetails, InterviewDate: InterviewDate, ApplicationId: ApplicationId, Id: Id, SchemeId: SchemeId }),
                    url: '/PropertyRegistration/UpdateInterviewDetails',
                    success: function (result) {
                        if (result == 1) {
                            alertify.success("Data saved successfully.");
                            window.location.href = '@Url.Action("ManageInterviewDetails", "PropertyRegistration")';
                            return false;
                        }
                        if (result == 2) {
                            alertify.error("Interview Details Data already saved .");
                            return false;
                        }
                        if (result == 3) {
                            alertify.error("Interview Date must be between Scheme Start Date and Scheme End Date.");
                            return false;
                        }
                        else {
                            alertify.error("Some error occured. Please try again later.");
                        }
                    },
                    error: function (objAjaxRequest, strError) {
                        var respText = objAjaxRequest.responseText;
                        alertify.error("Some error occured. Please try again later.");
                    }

                });


            });
        </script>
