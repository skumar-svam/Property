@(Html.Kendo().Window().Name("challanWindow").Title("Generate Challan").Modal(true).Visible(false).Content(@<text>
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-5 col-sm-6 col-md-offset-1 form-group">
                    @Html.Label("Lease Rent Type ")
                </div>
                <div class="col-md-5 col-sm-6 form-group">
                    @(Html.Kendo().DropDownListFor(m => m.ChallanOption)
                        .DataTextField("text")
                        .DataValueField("id")
                        .OptionLabel("Select")//.Filter("conatins")
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetChallanOptions", "PropertyRegistration");
                            });
                        })
                    )
                </div>
            </div>
            <div class="row">
                <div class="col-md-10 col-md-offset-1 topSpace" style="text-align:center">
                    <input type="button" class="btn btn-add" id="btnPopupSubmit" value="Ok" />
                    <input type="button" id="closePopup" class="btn btn-default" value="Close" />
                </div>
            </div>
        </div>
</text>)
.Draggable()
.Resizable()
//.Width(400)
.Actions(actions => actions.Close())
)

@*PopUp to print*@
<div id="divPrintChallan" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" style="width: 60%">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Lease Rent Challan</b></h4>
            </div>
            <div class="modal-body" id="divChallanBody">

            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="btn btn-add" data-dismiss="modal" onclick="PrintDiv();">Print</button>
            </div>
        </div>
    </div>
</div>

@*Prints Lease Deed*@
<div id="divPrintLetters" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 60%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Lease Deed</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:400px;">
                <div id="divLetterBody"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv1();">Print</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $('#LeaseDeedDueDate').data('kendoDatePicker').enable(false);
        $('#LeaseDeedExecutionDate').data('kendoDatePicker').enable(false);

        $("#btnBack").click(function () {
            window.location.href = '@Url.Action("ManageLeaseDeed", "PropertyRegistration")';
        });

        $("#btnGenerateChallan").click(function () {
            $("#challanWindow").data("kendoWindow").center();
            $("#challanWindow").data("kendoWindow").open();
        });

        $("#closePopup").click(function () {
            $("#challanWindow").data("kendoWindow").close();
        });

        $("#btnPrintDeed").click(function () {
            var rId = $("#RId").val();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ rId: rId }),
                url: '/PropertyRegistration/PrintLeaseDeedByRId',
                success: function (result) {
                    $("#divLetterBody").html(result);
                    $("#divPrintLetters").modal('show');
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //alert(respText);
                }
            });
        });

        $("#btnPopupSubmit").click(function () {
            var type = $("#ChallanOption").val();
            if (type == '') {
                alertify.error('Please select Lease Rent Type');
                return false;
            }
            $("#challanWindow").data("kendoWindow").close();

            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ rId: $('#RId').val(), deptId: $('#DepttId').val(), type: type, propId: $('#PropId').val(), schemeId: $('#SchemeId').val() }),
                url: '/DocParser/PrintLeaseDeedChallan',
                success: function (result) {
                    $("#divChallanBody").html(result);
                    $("#divPrintChallan").modal('show');
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //alert(respText);
                    alertify.error("Some error occured. Please try again later.");
                }
            });
        });
    });

    function PrintDiv() {
        var contents = document.getElementById("divChallanBody").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }

    function PrintDiv1() {
        var contents = document.getElementById("divLetterBody").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }
</script>
