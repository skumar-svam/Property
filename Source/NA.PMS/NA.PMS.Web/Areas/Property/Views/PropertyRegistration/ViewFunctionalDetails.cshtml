@model NA.PMS.Model.FunctionalModel
@using Kendo.Mvc.UI;
@using NA.PMS.Model

@{
    ViewBag.Title = "ManageFunctional";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .hide {
        display: none !important;
    }

    .show {
        display: block !important;
    }

    .disable_a_href {
        pointer-events: none;
    }
    ,
    #hdnFunctionalDate {
        display: none;
    }

    #hdnRId {
        display: none;
    }

    #DivCommentView {
        min-height: 180px;
    }
</style>



<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="row">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">View Functional Request</h1></div>
                <div class="col-md-6 col-sm-6 col-xs-12 col-btn">
                    @Html.HiddenFor(model => model.Status)

                    @if (Model.Status == "Approved")
                    {
                        <i class=" glyphicon glyphicon-ok-sign" aria-hidden="true"></i>
                        <strong style="color: lightgreen;"> Property Is Functional</strong>
                    }
                    else if (Model.Status == "Rejected")
                    {
                        <strong style="color: red;"><i class="glyphicon glyphicon-remove-sign" aria-hidden="true"></i>  Property not in Functional</strong>
                    }
                    <a href='javascript:void(0);' alt="click to open Check List popup" class="" id="frcontractreviewchklstlink">View Comments</a>
                    <a href='#' alt="click to open Check List popup" class="" id="btnGenerateLetter">Print Certificate</a>
                </div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
                <div>
                    <input type="hidden" value="@Model.RId" id="hdnRId" />
                    @Html.HiddenFor(c => c.RequestNo)
                    @Html.HiddenFor(c => c.PropertyNumber)
                    @Html.HiddenFor(c => c.FunctionalDate, htmlAttributes: new { @id = "hdnFunctionalDate" })
                    @Html.HiddenFor(c => c.RId, htmlAttributes: new { @id="hdnRid"})
                </div>

                @{Html.RenderPartial("_FunctionalDetails", Model);}

            </div>
            <div class="box-button text-center">
                <input type="button" id="btnBack" value="Back" class="btn btn-default" />
                <a href='javascript:void(0);' alt="click to open Check List popup" class="btn btn-add" id="btnSubmitForApprovallink">Submit for approval</a>
                <input type="button" value="Cancel Request" class="btn btn-default" id="btnCancel" />
                <input type="button" value="Functional Charge Challan" id="btnFunctionalChargeChalan" class="btn btn-default" />
                @*<input type="button" value="Generate Functional Certificate" id="btnGenerateLetter" class="btn btn-default"/>*@
            </div>
        </div>
    </div>
</div>


<div id='divAssineRequetApproval' class='col-md-12 adminfeediv'>
    <div class="row" style="margin:20px 0;">
        <div class="col-md-3" style="text-align:right">
            @Html.LabelFor(model => model.User)
        </div>
        <div class="col-md-6">          
            @(Html.Kendo().DropDownListFor(model => model.User)
            .Name("User")
            .DataTextField("text")
            .DataValueField("id")
            .Filter("contains")
            .OptionLabel("Select")
            .DataSource(source =>
            {
                source.Read(read =>
                {
                    read.Action("GetAssineTo", "Allotment");
                });
            })

            )
            @Html.ValidationMessageFor(model => model.User)
        </div>
    </div>
    <div class="row">
        <div class="col-md-3"></div>
        <div class="col-md-7">
            <button type='submit' id="btnRequetForApproval" class='btn btn-default' value='Save'>Submit</button>
            <button type='button' class='btn btn-default' value='Cancel' onclick="CloseCommnetPopUpForApproval();">Close</button>
        </div>
    </div>
</div>

<div id='DivCommentView'>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3">
                @Html.Label("From :", htmlAttributes: new { @class = "font-bold" })
            </div>
            <div class="col-md-9">
                @Html.DisplayFor(model => model.From)
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                @Html.Label("Date :", htmlAttributes: new { @class = "font-bold" })
            </div>
            <div class="col-md-9">
                @Html.DisplayFor(model => model.ApproveDate)
            </div>
        </div>
        <div class="row">
            <div class="col-md-9 col-sm-9 col-xs-12 col-md-offset-3 form-group" id="divCommentViewApprover">
                @Html.TextAreaFor(model => model.Comment, new { @class = "form-control", style = "min-height:80px;margin:0;padding:0;", disabled = "disabled" })
            </div>
        </div>
        <div class="row">
            <div class="col-md-12" style="text-align:center">
                <button type='button' class='btn btn-default' style="align-items :center; " value='Cancel' onclick="CloseCommnetPopUp();">Close</button>
            </div>
        </div>
    </div>
</div>




<div id="divPrintChallan" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 60%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Functional Permission Letter/Challan</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:400px;">
                <div id="divChallanBody"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv();">Print</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#ReqRefNo").attr("readonly", "readonly");
        @*if ($('#hdnRid').val() != "") {
            $('.ddl-rid').css("display", "none");
            $('#hdnRid2').val(@Model.RId);
        }*@
        //$('#divCommentViewApprover').html($('#Comment').val());
        if ($("#Status").val() != "Cancelled") {
            $("#fileMeterSealing").hide();
            $("#fileAffidavit").hide();
            $("#fileRegistrationCertificate").hide();
            $("#fileNDCAccount").hide();
        }
        $("div[id='DivCommentView']").kendoWindow({
            title: "Comment",
            modal: true,
            visible: false,
            width: "39%"
        });
        $("div[id='divAssineRequetApproval']").kendoWindow({
            modal: true,
            title: "Assign Request to Approver",
            visible: false,
            width: "39%"
        });
        $("a#btnSubmitForApprovallink").click(function () {
            OpenAssineRequetApprovalPopUp()
        });

        $("#RId").data('kendoDropDownList').value($("#hdnRId").val());

        //Disable fields in the case of View Request
        $('#FunctionalDueDate').data('kendoDatePicker').enable(false);
        $('#FunctionalDate').data('kendoDatePicker').enable(false);
        $("#FunctionalCharge").data("kendoNumericTextBox").enable(false);
        $('#MeterSealing').attr("disabled", true);
        $('#Affidavit').attr("disabled", true);
        $('#RegistrationCertificate').attr("disabled", true);
        $('#NDCAccount').attr("disabled", true);
        var dropDown = $("#RId").data("kendoDropDownList");
        dropDown.enable(false);
        var status = $("#Status").val();
        $("#ReqRefNo").attr("disabled", true);
        //Hide buttons according to Status.


        if (status == '@NA.PMS.Common.AllotmentStatus.Pending') {
            $("#btnAdd").hide();
            $("#btnGenerateLetter").hide();
            $("#frcontractreviewchklstlink").hide();
            $("#btnFunctionalChargeChalan").hide();



        }
        else if (status == '@NA.PMS.Common.AllotmentStatus.InProgress') {
            //$("#btnAdd").attr("disabled", true);;
            $("#btnSubmitForApprovallink").addClass("disable_a_href");
            $("#btnSubmitForApprovallink").hide();
            $("#btnGenerateLetter").hide();
            $("#frcontractreviewchklstlink").hide();
            $("#btnFunctionalChargeChalan").hide();

        }
        else if (status == "Cancelled") {
            //$("#btnAdd").hide();
            $("#btnGenerateLetter").hide();
            $("#btnCancel").hide();
            $("#frcontractreviewchklstlink").hide();
            $("#btnFunctionalChargeChalan").hide();
            $("a#btnSubmitForApprovallink").text("Re-Submit for Approval");
            //$("#btnAdd").val("Re-Submit for Approval");
            $('#FunctionalDueDate').data('kendoDatePicker').enable(true);
            $('#FunctionalDate').data('kendoDatePicker').enable(true);
            $('#MeterSealing').attr("disabled", false);
            $('#Affidavit').attr("disabled", false);
            $('#RegistrationCertificate').attr("disabled", false);
            $('#NDCAccount').attr("disabled", false);
            $("#FunctionalCharge").data("kendoNumericTextBox").enable(true);

        }
        else if (status == '@NA.PMS.Common.AllotmentStatus.Approved') {
            $("#btnAdd").hide();
            $("a#btnSubmitForApprovallink").hide();
            $("#btnCancel").hide();
        }
        else if (status == '@NA.PMS.Common.AllotmentStatus.Rejected') {
            $('#FunctionalDueDate').data('kendoDatePicker').enable(true);
            $('#FunctionalDate').data('kendoDatePicker').enable(true);
            $("#FunctionalCharge").data("kendoNumericTextBox").enable(true);
            $('#MeterSealing').attr("disabled", false);
            $('#Affidavit').attr("disabled", false);
            $('#RegistrationCertificate').attr("disabled", false);
            $('#NDCAccount').attr("disabled", false);

            $("#btnGenerateLetter").hide();
            $("#btnCancel").hide();
            $("#btnFunctionalChargeChalan").hide();
            $("a#btnSubmitForApprovallink").text("Re-Submit for Approval");
            $("#fileMeterSealing").show();
            $("#fileAffidavit").show();
            $("#fileRegistrationCertificate").show();
            $("#fileNDCAccount").show();

        }

        $("#btnFunctionalChargeChalan").click(function () {
            //var rId = $("#RId").val();
            var rId = $("#hdnRId").val();
            var RequestNo = $("#RequestNo").val();
            //alert(rId, RequestNo);
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ rid: rId, requestNo: RequestNo }),
                url: '/DocParser/PrintFunctionalChargeChallan',
                success: function (result) {
                    $("#divChallanBody").html(result);
                    $("#divPrintChallan").modal('show');
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    //alert(respText);
                    //alertify.error("Some error occured. Please try again later.");
                }
            });
        });

        $("#btnGenerateLetter").click(function () {
            //var rId = $("#RId").val();
            var rId = $("#hdnRId").val();
            var RequestNo = $("#RequestNo").val();
            //var DepttId = $("#DepttId").val();
            //alert("DepttId=" + DepttId);
            //$.ajax({
            //    dataType: 'json',
            //    type: 'Post',
            //    contentType: 'application/json; charset=utf-8',
            //    data: JSON.stringify({ rid: rId, requestNo: RequestNo }),
            //    url: '/DocParser/PrintFunctionalChargeChallan',
            //    success: function (result) {
            //        $("#divChallanBody").html(result);
            //        $("#divPrintChallan").modal('show');
            //    },
            //    error: function (ajaxRequest, strError) {
            //        alertify.error("Some error occured. Please try again later.");
            //    }
            //});

            //var rId = $("#RId").val();
            //var RequestNo = $("#RequestNo").val();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ rid: rId }),
                //url: '/PropertyRegistration/GenerateFunctionalCertificater',
                url: '@Url.Action("GenerateFunctionalCertificater", "PropertyRegistration")',
                success: function (result) {
                    $("#divChallanBody").html(result);
                    $("#divPrintChallan").modal('show');
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    alertify.error("Some error occured. Please try again later.");
                }
            });
        });

        $("#btnCancel").click(function () {
            var reqNo = $("#RequestNo").val();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ reqNo: reqNo }),
                url: '/PropertyRegistration/CancelFunctionRequest',
                success: function (result) {
                    if (result == true) {
                        //Enable fields
                        //$('#MutationDate').data('kendoDatePicker').enable(true);
                        //$('#TransferDeedDate').data('kendoDatePicker').enable(true);
                        //$('#BahiNo').attr("disabled", false);
                        //$('#BahiZildNo').attr("disabled", false);
                        //$('#BahiPageNo').attr("disabled", false);
                        //$('#SINo').attr("disabled", false);
                        //var dropDown = $("#RId").data("kendoDropDownList");
                        //dropDown.enable(true);
                        //Show/Hide buttons
                        $("#btnGenerateLetter").hide();
                        $("#btnCancel").hide();
                        $("#btnComment").hide();
                        $("#btnAdd").show();
                        alertify.success("Request cancelled successfully.");
                        window.location.href = '@Url.Action("ManageFunctional", "PropertyRegistration")';
                    }
                    else {
                        alertify.error("Some error occured. Please try again later.");
                    }
                },
                error: function (obj) {
                    alertify.error("Some error occured. Please try again later.");
                }
            });
        });

    });
    function CloseCommnetPopUp() {
        var win = $("#DivCommentView").data("kendoWindow");
        win.close();
    }
    function OpenFRContractReviewChkLstPopUp() {
        var win = $("#DivCommentView").data("kendoWindow");
        win.center();
        win.open();
    }
    $("a#frcontractreviewchklstlink").click(function () {
        OpenFRContractReviewChkLstPopUp()
    });
    function OpenAssineRequetApprovalPopUp() {
        var win = $("#divAssineRequetApproval").data("kendoWindow");
        win.center();
        win.open();
    }
    function CloseCommnetPopUpForApproval() {
        var win = $("#divAssineRequetApproval").data("kendoWindow");
        win.close();
    }
    $("#btnBack").click(function () {
        window.location.href = '@Url.Action("ManageFunctional", "PropertyRegistration")';
    });
    $("#btnRequetForApproval").click(function () {
        var rId = $("#RId").val();
        var FunctionalDueDate = $("#FunctionalDueDate").val();
        var FunctionalDate = $("#FunctionalDate").val();
        var MeterSealing = $('#MeterSealing').is(':checked');//$("#MeterSealing").val();
        var Affidavit = $('#Affidavit').is(':checked');
        var RegistrationCertificate = $('#RegistrationCertificate').is(':checked');
        var NDCAccount = $('#NDCAccount').is(':checked');
        var user = $("#User").val()
        var PropertyNumber = $("#PropertyNumber").val();
        var reqNo = $("#RequestNo").val();
        var FunctionalCharge = $("#FunctionalCharge").val()
        var lblPropNo = $("#PropertyNumber").val();
        if (user != "") {
            var formData = new FormData();
            var file = $('#fileMeterSealing')[0];
            formData.append("fileMeterSealing", file.files[0]);
            var fileAffidavit = $('#fileAffidavit')[0];
            formData.append("fileAffidavit", fileAffidavit.files[0]);
            var fileRegistrationCertificate = $('#fileRegistrationCertificate')[0];
            formData.append("fileRegistrationCertificate", fileRegistrationCertificate.files[0]);
            var fileNDCAccount = $('#fileNDCAccount')[0];
            formData.append("fileNDCAccount", fileNDCAccount.files[0]);
            //formData.append("FileName", uploadSign);
            formData.append("rId", rId);
            formData.append("FunctionalDate", FunctionalDate);
            formData.append("FunctionalDueDate", FunctionalDueDate);
            formData.append("MeterSealing", MeterSealing);
            formData.append("Affidavit", Affidavit);
            formData.append("RegistrationCertificate", RegistrationCertificate);
            formData.append("NDCAccount", NDCAccount);
            formData.append("user", user);
            formData.append("PropertyNumber", lblPropNo);
            formData.append("FunctionalCharge", FunctionalCharge);

            $.ajax({
                dataType: 'json',
                type: 'Post',
                data: formData,
                url: '/PropertyRegistration/ReSubmitFunctionalDetails',
                cache: false,
                contentType: false,
                processData: false,

                //$.ajax({
                //    dataType: 'json',
                //    type: 'Post',
                //    contentType: 'application/json; charset=utf-8',
                //    data: JSON.stringify({ rId: rId, FunctionalDate: FunctionalDate, FunctionalDueDate: FunctionalDueDate, MeterSealing: MeterSealing, Affidavit: Affidavit, RegistrationCertificate: RegistrationCertificate, NDCAccount: NDCAccount, user: user, PropertyNumber: lblPropNo, FunctionalCharge: FunctionalCharge }),
                //    url: '/PropertyRegistration/ReSubmitFunctionalDetails',
                success: function (result) {
                    if (result == 1) {
                        alertify.success("Data saved successfully.");
                        window.location.href = '@Url.Action("ManageFunctional", "PropertyRegistration")';
                        return false;
                    }
                    else {
                        return true;
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    alertify.error("Some error occured. Please try again later.");
                }

            });
        }
        else {
            alert("Please select a User");
        }
    });
    function PrintDiv() {
        var contents = document.getElementById("divChallanBody").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }
</script>