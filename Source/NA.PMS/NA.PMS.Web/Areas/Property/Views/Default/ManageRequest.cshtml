@model NA.PMS.Model.PropertyViewModel
@using Kendo.Mvc.UI
@using NA.PMS.Common
@{
    ViewBag.Title = "Manage Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #divStatusMaster{
        display:none;
    }
</style>

<div class="manage-request">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Surrenders/Cancellation Request</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">

            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>

    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.Model.PropertyViewModel>()
        .Name("gridCancelledProperty")
        .Columns(columns =>
        {
            columns.Bound(c => c.Id).Hidden(true);
            //columns.Bound(c => c.RequestId).Title("Request No").Width(130);//.ClientTemplate("<a href=\"/Property/PropertyCancellation/ViewCancellation_Approver/#= ReqNo#\" id='v_#=ReqNo#'  style = 'width: 30px;' >#=ReqNo#</a>");
            columns.Bound(c => c.RegistrationId).Title("Registration Id").Width(150);
            columns.Bound(c => c.Department).Title("Department");
            columns.Bound(c => c.Approver).Title("Assigned To");
            columns.Bound(c => c.RequestDate).Title("Request Date").Format("{0:dd/MM/yyyy}");
            columns.Bound(c => c.ApprovalDate).Title("Approval Date").Format("{0:dd/MM/yyyy}");
            columns.Bound(c => c.RefundType).Title("Request").Width(130);
            columns.Bound(c => c.Status).Title("Status").Width(130);
        })
        .Filterable().Resizable(resize => resize.Columns(true))
        .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
        .ClientDetailTemplateId("template")
        .DataSource(dataSource => dataSource
                .Ajax().Model(model => model.Id(c => c.Id))
                .ServerOperation(true).Sort(sort => sort.Add("Id").Descending())
                .Read(read => read.Action("GetCancelledPropertyListAsDataSource", "Default"))
        )
        )
    </div>

    <script id="template" type="text/kendo-tmpl">
        @(Html.Kendo().Grid<NA.PMS.Model.PropertyViewModel>()
            .Name("grid_#=Id#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.RegistrationId).Hidden(true);
                columns.Bound(c => c.RefundAmount).Title("Refund Amount").Width(150);
                columns.Bound(c => c.RestorationCharge).Title("Restoration Charge").Width(150);
                columns.Bound(c => c.Comment).Title("Reason");
                columns.Bound(c => c.Status).Width(120).Title("Action").ClientTemplate("#if(IsApproved == false){#<label class='hyperlink' onclick='javascript:OpenStatusWindow(this)'>#=Status#</label>#}else{#<label>#=Status#</label>#}#");
                //columns.Bound(c => c.Id).Title("Status").Width(120).ClientTemplate("#if(IsPropertyAllotted==true){#<lable>Allotted</label>#}else{#<label>Not Allotted</label>#}#");
            })
            .DataSource(dataSource => dataSource.Ajax().Read(read => read.Action("GetCancelledPropertyListAsDataSource", "Default", new { Id = "#=Id#" })))
            .ToClientTemplate()
        )
    </script>
    <script>
        function dataBound() {
            this.expandRow(this.tbody.find("tr.k-master-row").first());
        }
    </script>
</div>


<div class="col-md-12 popup-window" id="divStatusMaster" style="min-height:250px;background:url(/Content/Images/boxed-bg.jpg) repeat;">
    <div class="row form-group" style="padding-top:15px;">
        <div class="col-md-3">
            <label>Service Status</label>
        </div>
        <div class="col-md-6">
            @(Html.Kendo().DropDownListFor(model => model.StatusId)
                .Filter("contains")
                .DataTextField("Text")
                .DataValueField("Id")
                .OptionLabel(" -- Select --")
                .DataSource(source =>
                {
                    source.Custom()
                    .ServerFiltering(true)
                    .ServerPaging(true)
                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                    .Transport(transport => transport.Read(read => read.Action("GetStatusListAsDataSource", "Allotment", new { area = "Property" })))
                    .Schema(schema => schema.Data("Data").Total("Total"))
                    .PageSize(100);
                })
                .HtmlAttributes(new { @class = "input-disabled", style = "width:100%; float:right;" })
            )
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-3">
            <label>Comment</label>
        </div>
        <div class="col-md-9">
            @Html.TextAreaFor(model => model.Comment, htmlAttributes: new { @class = "k-textbox", style = "width:93%;height:70px;" })
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-3">
            <input type="hidden" class="hdn-id" />
            <input type="hidden" class="hdn-rid" />
        </div>
        <div class="col-md-3">
            <input type="button" class="k-button" id="btnStatusSubmit" value="Submit" style="width:98%;" />
        </div>
        <div class="col-md-3" style="text-align:right;">
            <input type="button" class="k-button" id="btnStatusClose" value="Close" style="width:98%;" />
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        $('.popup-window').kendoWindow({
            modal: true,
            title: "Approval Window",
            //actions: false,
            actions: ["Pin", "Close"],
            visible: false,
            width: "40%"
        });

        $('#btnStatusSubmit').click(function () {
            if ($('#StatusId').val() != "" && $('#Comment').val() != "") {
                UpdateAllotmentStatus();
            }
            else {
                alertify.error("Select Status and write comment.");
                return false;
            }
        });

        $('#btnStatusClose').click(function () {
            $(".popup-window").data("kendoWindow").close();
        });
    });

    function OpenStatusWindow(row) {
        var tr = $(row).parent().parent();
        var id = $(tr).children("td:eq(0)").text();
        var rid = $(tr).children("td:eq(1)").text();
        $('.hdn-id').val(id);
        $('.hdn-rid').val(rid);
        $(".popup-window").data("kendoWindow").center();
        $(".popup-window").data("kendoWindow").open();
    }


    function UpdateAllotmentStatus() {
        var model = {
            Id: $('.hdn-id').val(),
            RegistrationId: $('.hdn-rid').val(),
            StatusId: $('#StatusId').val(),
            Comment: $('#Comment').val()
        };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: model }),
            url: '/Property/Default/SaveCancellationStatus',
            success: function (result) {
                $(".popup-window").data("kendoWindow").close();
                if (result == '@ReturnType.Saved') {
                    $('#gridCancelledProperty').data('kendoGrid').dataSource.read();
                    alertify.success("Property updated successfully.");
                }
                else {
                    alertify.error("Provider failed to update data.");
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                alertify.error("Network error.");
            }
        });
    }
</script>
