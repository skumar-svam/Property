@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@model NA.PMS.Model.PaymentViewModel
@{
    ViewBag.Title = "Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #gridPayment {
        padding: 0;
    }

    .k-widget.k-window {
        padding: 0;
    }

    .k-window-content.k-content {
        padding: 0;
    }

    .k-window-titlebar.k-header {
        background: #299a8b;
        color: #ffffff;
        border-radius: 0;
    }

    .col-for-label {
        margin-right: -40px;
        margin-left: 25px;
    }

    .displace-right {
        /*margin-left: 80px;*/
    }
</style>
<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="row rw-spce">
        <div class="col-sm-8"><h1 class="gridTitle">Payment for Allotted Property</h1></div>
        <div class="col-sm-4 col-btn">
            <a href="#" id="btnShowPayment" class="" onclick="javascript:ShowPaymentModal(event);">Show Payment</a>
        </div>
    </div>

    <div class="col-md-12 blnk-rw"></div>

    @using (Html.BeginForm("SavePropertyPayment", "ManagePayment", FormMethod.Post, new { enctype = "multipart/form-data", id = "PaymentForm" }))
    {
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading">Add Payment</h2>
            <div class="form-bx">
                <div class="row">
                    @Html.HiddenFor(model => model.AllotteeName)
                    @Html.HiddenFor(model => model.FirstName)
                    @Html.HiddenFor(model => model.MiddleName)
                    @Html.HiddenFor(model => model.LastName)
                    @Html.HiddenFor(model => model.SectorId)
                    @Html.HiddenFor(model => model.SectorName)
                    @Html.HiddenFor(model => model.BlockId)
                    @Html.HiddenFor(model => model.BlockName)
                    @*@Html.HiddenFor(model => model.DepartmentId)*@
                    @Html.HiddenFor(model => model.DepartmentName)
                    @Html.HiddenFor(model => model.PropertyId)
                    @Html.HiddenFor(model => model.PropertyNo)
                    @Html.HiddenFor(model => model.PropertyRegistryId)
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                        <label>Department:</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(model => model.DepartmentId)
                              .Name("DepartmentId")
                              .DataTextField("text")
                              .DataValueField("id")
                              .OptionLabel(" -- Please Select --")
                              .Filter("contains")
                              .AutoBind(true)
                              .Enable(true)
                              .DataSource(source => source.Read(read => read.Action("GetDepartmentList", "ManagePayment")))
                              .HtmlAttributes(new { style = "width:100%" })
                              //.Events(e => e.Change("GetAllottedPropertyDetails"))
                        )
                        @Html.ValidationMessageFor(model => model.DepartmentId)
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                        <label>Registration Id:</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(model => model.RegistrationNo)
                              .DataTextField("text")
                              .DataValueField("id")
                              .OptionLabel(" -- Please Select --")
                              .Filter("contains")
                              .AutoBind(true)
                              .Enable(true)                             
                              .DataSource(source => source.Read(read => read.Action("GetRegistrationIdByDepartment", "ManagePayment").Data("FilterDepartment")).ServerFiltering(true))
                              .HtmlAttributes(new { style = "width:100%" })
                              .CascadeFrom("DepartmentId")
                              .Events(e => e.Change("GetAllottedPropertyDetails"))
                        )
                        @Html.ValidationMessageFor(model => model.RegistrationNo)
                    </div>
                    
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                        <label>Applicant's Name</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <label class="lbl-form-control" id="lblAllotteeName"></label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label  form-group">
                        <label>Property No</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        <label class="lbl-form-control" id="lblPropertyNumber"></label>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group"><label>Receipt Type</label></div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(model => model.ReceiptCode)
                              .DataTextField("Name")
                              .DataValueField("Value")
                              .OptionLabel(" -- Please Select --")
                              .Filter("contains")
                              .AutoBind(true)
                              .Enable(true)
                              .DataSource(source => source.Read(read => read.Action("GetPropertyPaymentType", "ManagePayment")))
                              .HtmlAttributes(new { style = "width:100%" })
                        )
                        @Html.ValidationMessageFor(model => model.ReceiptCode)
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label  form-group">
                        <label>Receipt Sub Type</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(model => model.ReceiptSubHeadId)
                              .DataTextField("Name")
                              .DataValueField("Value")
                              .OptionLabel(" -- Please Select --")
                              .Filter("contains")
                              .AutoBind(true)
                              .Enable(true)
                              .DataSource(source => source.Read(read => read.Action("GetPropertySubPaymentType", "ManagePayment").Data("FilterHeadId")).ServerFiltering(true))
                              .CascadeFrom("ReceiptCode")
                              .HtmlAttributes(new { style = "width:100%" })
                        )
                        @Html.ValidationMessageFor(model => model.ReceiptSubHeadId)
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                        <label>Receipt No</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.TextBoxFor(model => model.ReceiptId, new { @class = "form-control integer-only", @maxlength = "12" })
                        @Html.ValidationMessageFor(model => model.ReceiptId)
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label  form-group">
                        <label>Amount</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.TextBoxFor(model => model.Amount, new { @class = "form-control integer-only", @maxlength = "22" })
                        @Html.ValidationMessageFor(model => model.Amount)
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                        <label>Bank ID</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(model => model.BankId)
                              .DataTextField("Name")
                              .DataValueField("Value")
                              .OptionLabel(" -- Please Select --")
                              .Filter("contains")
                              .AutoBind(true)
                              .Enable(true)
                              .DataSource(source => source.Read(read => read.Action("GetBankNamesForPayment", "ManagePayment")))
                              .HtmlAttributes(new { style = "width:100%" })
                        )
                        @Html.ValidationMessageFor(model => model.BankId)
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label  form-group">
                        <label>Challan ID</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.TextBoxFor(model => model.ChallanId, new { @class = "form-control integer-only", @maxlength = "20" })
                        @Html.ValidationMessageFor(model => model.ChallanId)
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                        <label>Deposit Date</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DatePickerFor(model => model.DepositDate)
                              .HtmlAttributes(new { style = "width: 100%;", @class = "DisableKeyboardInput" }))
                        @Html.ValidationMessageFor(model => model.DepositDate)
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label  form-group">
                        <label>Entry Date</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DatePickerFor(model => model.EntryDate)
                              .HtmlAttributes(new { style = "width: 100%;", @class = "DisableKeyboardInput" }).Events(e => e.Change("ValidateEntryDate")))
                        @Html.ValidationMessageFor(model => model.EntryDate)
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label form-group">
                        <label>Depositor's Name</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.TextBoxFor(model => model.DepositorName, new { @class = "form-control", @maxlength = "100" })
                        @Html.ValidationMessageFor(model => model.DepositorName)
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 col-for-label  form-group">
                        <label>Address</label>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.TextBoxFor(model => model.CorresspondentAddress, new { @class = "form-control", @maxlength = "200" })
                        @Html.ValidationMessageFor(model => model.CorresspondentAddress)
                    </div>
                </div>
            </div>
        </div>
        <div class="box-button text-center">
            <input type="reset" id="btnReset" value="Reset" class="btn btn-default" style="margin-left:25px;" />
            <input type="submit" id="btnSubmit" value="Add" class="btn btn-add" style="margin-right:25px;" />
        </div>
    }

</div>


<script>
    $(document).ready(function () {
        @{if (TempData["MesgAdd"] != null && TempData["MesgAdd"] != "")
        {
            if ((bool)TempData["MesgAdd"] == true)
            {
                @:alertify.success('Payment added successfully.');
            }
            else
            {
                @:alertify.error('Payment is not added, try again.');
            }
        }
        }
    });

    $('#').kendoWindow({
        modal: true,
        title: "Payment against Registration Id",
        visible: false,
        width: "90%",height:"90%"
    });

    $('#btnShowPayment').click(function () {
        $('#gridPayment').data("kendoGrid").dataSource.read();
        var win = $("#divPropertyPayment").data("kendoWindow");
        win.center();
        win.open();
    });

    $('#btnPopupCancel').click(function () {
        $("#divPropertyPayment").data("kendoWindow").close();
    });

    function FilterHeadId() {
        return { receiptId: $('#ReceiptCode').val() }
    }

    function FilterDepartment() {
        return {            
            departmentId: $('#DepartmentId').val()
        }
    }

    function GetAllottedPropertyDetails() {
        var rId = $('#RegistrationNo').val();
        //alert($('#RID').val());
        if (rId != "") {
            //alert($('#RID').val());
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                //data: { rid: rId },
                data: JSON.stringify({ rid: rId }),
                url: '@Url.Action("GetAllottedPropertyDetail", "PropertyRegistration")',
                success: function (result) {
                    if (result != null) {
                        ClearInputField();
                        $('#lblAllotteeName').text(result.ALLOTEE_NAME);
                        $('#lblPropertyNumber').text(result.SECTOR + "/" + result.BLOCK + "-" + result.PROPERTY_NUMBER);
                        $('#FIRST_NAME').val(result.FIRST_NAME);
                        $('#MIDDLE_NAME').val(result.MIDDLE_NAME);
                        $('#LAST_NAME').val(result.LAST_NAME);
                        $('#SECTOR_ID').val(result.SECTOR_ID);
                        $('#SECTOR').val(result.SECTOR);
                        $('#BLOCK_ID').val(result.BLOCK_ID);
                        $('#BLOCK').val(result.BLOCK);
                        $('#DEPARTMENT_ID').val(result.DEPARTMENT_ID);
                        $('#DEPARTMENT_NAME').val(result.DEPARTMENT_NAME);
                        $('#PROPERTY_ID').val(result.PROPERTY_ID);
                        //$('#PROPERTY_NUMBER').val(result.PROPERTY_NUMBER);
                        $('#PROPERTY_NUMBER').val(result.SECTOR + "/" + result.BLOCK + "-" + result.PROPERTY_NUMBER);
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Please try again.");
                }
            });
        }
        else {
            ClearInputField();
            //alertify.error("Please select Registration Id");
        }
    }

    $('#btnSubmit').click(function () {
        if ($('#RegistrationId').val() == "") {
            alertify.error("Please select Registration Id");
            return false;
        }
        else {
            $('#btnSubmit').submit();
        }
    });

    //$("#RECEIPT_ID").keydown(function (e) {
    //    // Allow: backspace, delete, tab, escape, enter and .
    //    if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110]) !== -1 ||
    //        // Allow: Ctrl+A, Command+A
    //        (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
    //        // Allow: home, end, left, right, down, up
    //        (e.keyCode >= 35 && e.keyCode <= 40)) {
    //        // let it happen, don't do anything
    //        return;
    //    }
    //    // Ensure that it is a number and stop the keypress
    //    if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
    //        e.preventDefault();
    //    }
    //});

    $(".integer-only").keydown(function (e) {
        // Allow: backspace, delete, tab, escape, enter and .
        if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110]) !== -1 ||
            // Allow: Ctrl+A, Command+A
            (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
            // Allow: home, end, left, right, down, up
            (e.keyCode >= 35 && e.keyCode <= 40)) {
            // let it happen, don't do anything
            return;
        }
        // Ensure that it is a number and stop the keypress
        if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
            e.preventDefault();
        }
    });

    function ValidateEntryDate() {
        var depositdate = $('#DepositDate').val();
        var entrydate = $('#EntryDate').val();
        var today = '@DateTime.Now.ToString()';
        if (new Date(depositdate) > new Date(entrydate)) {
            alertify.error("Entry date should not be earlier than deposit date");
            return false;
        }
        if (new Date(entrydate) > new Date(today)) {
            alertify.error("Entry date should not be future date.");
            return false;
        }
    }

    function ClearInputField() {
        //$('#RegistrationId').data("kendoDropDownList").Value('');
        $('#lblAllotteeName').html("");
        $('#lblPropertyNumber').text('');
        $('#ReceiptCode').data("kendoDropDownList").value('');
        $('#ReceiptId').val('');
        $('#Amount').val('');
        $('#BankId').data("kendoDropDownList").value('');
        $('#ChallanId').val('');
        $('#DepositDate').data("kendoDatePicker").value('');
        $('#EntryDate').data("kendoDatePicker").value('');
        $('#DepositorName').val('');
        $('#CorresspondentAddress').val('');
    }
</script>

