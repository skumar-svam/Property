                    })
                    .Events(events => { events.Change("ChangeInDepartment"); })
                    .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                )
            </div>

            <div class="col-md-2 col-sm-6 col-xs-12 form-group">
                @Html.Label("Registration Id")
                @(Html.Kendo().DropDownListFor(m => m.RegistrationId)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetMasterSearchParameterAsDataSource", "PropertyAllotment", new { area = "Property" }).Data("FilterRegistrationId")))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                    .Events(events => { events.Change("ChangeInRegistrationId"); })
                    .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                )
            </div>

            <div class="col-md-2 col-sm-6 col-xs-12 form-group">
                @Html.Label("Sector")
                @(Html.Kendo().DropDownListFor(model => model.SectorId)
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .Enable(true)
                    .AutoBind(true)
                    .Filter("contains")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetMasterSearchParameterAsDataSource", "PropertyAllotment", new { area = "Property" }).Data("FilterSectorParameter")))
