    <div class="col-md-12 alot-prop-grid k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.Model.PropertyViewModel>()
            .Name("GridAllottedProperty")
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.PropertyId).Hidden(true);
                columns.Bound(c => c.RegistrationId).Title("Registration Id").Width(130).ClientTemplate("#if(IsActive==true){#<a target='_blank' href='/Property/PropertyAllotment/PropertyDetails/#=RegistrationId#'>#=RegistrationId#</a>#}else{#<label>#=RegistrationId#</label>#}#").Sortable(false);
                columns.Bound(c => c.Department).Title("Department").Width(120).Sortable(false).Filterable(false);
                columns.Bound(c => c.SectorName).Title("Sector").Width(100);
                columns.Bound(c => c.BlockName).Title("Block").Width(100);
                columns.Bound(c => c.PlotNo).Title("Plot").Width(90);
                columns.Bound(c => c.Applicant).Title("Applicant (Allottee)");
                //columns.Bound(c => c.ApplicantType).Title("Type").Width(110);
                columns.Bound(c => c.AllotmentDate).Title("Allotment").Width(120).Format("{0:dd-MMM-yyyy}").Sortable(false);
                columns.Bound(c => c.IsActive).Title("Active").Width(100).ClientTemplate("#if(IsActive==true){#<label>Active</label>#}else{#<label>InActive</label>#}#");
                columns.Bound(c => c.Status).Title("Status").Width(100);
                //columns.Bound(c => c.IsDocumentAvailable).Title(" ").Width(80).ClientTemplate("<label class='hyperlink' onclick='javascript:UpdateDocument(this)'>#=IsDocumentAvailable#</label>");
                columns.Bound(c => c.IsDocumentAvailable).Title(" ").Width(50).ClientTemplate("#if(IsDocumentAvailable){#<center><span class='glyphicon glyphicon-download'></span></center> #}else{#<center><span class='glyphicon glyphicon-refresh' onclick='javascript:UpdateDocument(this)'></span></center>#}#").Sortable(false);
            })
            .Sortable().Filterable().Resizable(resize => resize.Columns(true))
            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
            .ClientDetailTemplateId("template")
            .AutoBind(true)
            .DataSource
            (
                dataSource => dataSource
                .Ajax()
                .Model(model => model.Id(p => p.Id))
                .ServerOperation(true)
                .Read(read => read.Action("GetPropertyListAsDataSource", "PropertyAllotment", new { area = "Property" }).Data("FilterSearchParameter"))
                .Sort(s => s.Add(x => x.AllotmentDate).Descending())
                .PageSize(10)
            ))
    </div>
</div>

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<NA.PMS.Model.PropertyViewModel>()
            .Name("grid_#=Id#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.RegistrationId).Hidden(true);
                columns.Bound(c => c.PropertyId).Title("Property Id").Width(110);
                columns.Bound(c => c.TotalArea).Title("Area (sqm)").Width(100);
                columns.Bound(c => c.TotalPropertyCost).Title("Cost (<span class='fa fa-rupee'></span>)").Width(110);
                columns.Bound(c => c.MobileNo).Title("Mobile No").Width(120);
                //columns.Bound(c => c.Email).Title("Email").Width(120);
                columns.Bound(c => c.ApplicantAddress).Title("Address");
                columns.Bound(c => c.SchemeName).Title("Scheme");
                columns.Bound(c => c.IsPropertyAllotted).Title("Status").Width(120).ClientTemplate("#if(IsPropertyAllotted==true){#<label>Allotted</label>#}else{#<label>Not Allotted</label>#}#");
            })
            .ClientDetailTemplateId("template2").AutoBind(true)
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(10)
                .Read(read => read.Action("GetPropertyListAsDataSource", "PropertyAllotment", new { area = "Property", RegistrationId = "#=RegistrationId#" }))
            )
            .ToClientTemplate()
    )
</script>
<script>
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
</script>


<script id="template2" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<NA.PMS.Model.PropertyViewModel>()
            .Name("grid2_#=Id#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Group(group => group
                    .Title("First Allottee")
                    .Columns(info =>
                    {
                        info.Bound(c => c.FirstApplicant).Title("Name").HeaderHtmlAttributes(new { style = "text-align: center;" });
                        info.Bound(c => c.FirstApplicantAdd).Title("Address").HeaderHtmlAttributes(new { style = "text-align: center;" });
                    })
                    .HeaderHtmlAttributes(new { @class = "group-column", style = "text-align:center;background:CornflowerBlue" })
                );
                columns.Group(group => group
                    .Title("Current Allottee")
                    .Columns(info =>
                    {
                        info.Bound(c => c.Applicant).Title("Name").HeaderHtmlAttributes(new { style = "text-align: center;" });
                        info.Bound(c => c.ApplicantAddress).Title("Address").HeaderHtmlAttributes(new { style = "text-align: center;" });
                    })
                    .HeaderHtmlAttributes(new { style = "text-align:center;background:CornflowerBlue" })
                );
            })
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(10)
                .Read(read => read.Action("GetPropertyListAsDataSource", "PropertyAllotment", new { area = "Property", RegistrationId = "#=RegistrationId#" }))
            )
            .ToClientTemplate()
    )
</script>


<script>
    $(document).ready(function () {
        $('#Applicant').change(function () {
            $('#GridAllottedProperty').data('kendoGrid').dataSource.read();
        });

        //$('#Applicant').autocomplete(function () {
        //    source: $('#GridAllottedProperty').data('kendoGrid').dataSource.read();
        //});

        $('#MobileNo').change(function () {
            $('#GridAllottedProperty').data('kendoGrid').dataSource.read();
        });
    });

    function ChangeInDropdownFilter() {
        $('#RegistrationId').data('kendoDropDownList').dataSource.read();
        $('#DepartmentId').data('kendoDropDownList').dataSource.read();
        $('#SectorId').data('kendoDropDownList').dataSource.read();
        $('#BlockId').data('kendoDropDownList').dataSource.read();
        $('#GridAllottedProperty').data('kendoGrid').dataSource.read();
    }

    function ChangeInScheme() {
        //$('#ActionType').val("Scheme");
        ChangeInDropdownFilter();
    }
    function FilterSchemeParameter() {
        return {
            ActionType: "Scheme",
            SchemeId: $('#SchemeId').val(),
            DepartmentId: $('#DepartmentId').val(),
            SectorId: $('#SectorId').val(),
            BlockId: $('#BlockId').val()
        };
    }

    function FilterRegistrationId() {
        return {
            ActionType: "RegistrationId",
            RegistrationId: $('#RegistrationId').val(),
            DepartmentId: $('#DepartmentId').val(),
            SectorId: $('#SectorId').val(),
            BlockId: $('#BlockId').val()
        };
    }

    function ChangeInRegistrationId() {
        ChangeInDropdownFilter();
    }

    function ChangeInDepartment() {
        //$('#ActionType').val("Department");
        ChangeInDropdownFilter();
    }
    function FilterDepartmentParameter() {
        return {
            ActionType: "Department",
            SchemeId: $('#SchemeId').val(),
            DepartmentId: $('#DepartmentId').val(),
            SectorId: $('#SectorId').val(),
            BlockId: $('#BlockId').val()
        };
    }

    function ChangeInSector() {
        //$('#ActionType').val("Sector");
        ChangeInDropdownFilter();
    }
    function FilterSectorParameter() {
        return {
            ActionType: "Sector",
            SchemeId: $('#SchemeId').val(),
            DepartmentId: $('#DepartmentId').val(),
            SectorId: $('#SectorId').val(),
            BlockId: $('#BlockId').val()
        };
    }

    function ChangeInBlock() {
        //$('#ActionType').val("Block");
        ChangeInDropdownFilter();
    }
    function FilterBlockParameter() {
        return {
            ActionType: "Block",
            SchemeId: $('#SchemeId').val(),
            DepartmentId: $('#DepartmentId').val(),
            SectorId: $('#SectorId').val(),
            BlockId: $('#BlockId').val()
        };
    }


    function ReadPropertyGridEvent() {
        $('#GridAllottedProperty').data('kendoGrid').dataSource.read();
    }
    //var action = "Scheme";
    function FilterSearchParameter() {
        return {
            ActionType: $('#ActionType').val(),
            RegistrationId: $('#RegistrationId').val(),
            DepartmentId: $('#DepartmentId').val(),
            SectorId: $('#SectorId').val(),
            BlockId: $('#BlockId').val(),
            Applicant: $('#Applicant').val(),
            MobileNo: $('#MobileNo').val()
        };
    }

    function SearchPropertyByParameter() {
        var model = {
            SchemeId: $('#SchemeId').val(),
            DepartmentId: $('#DepartmentId').val(),
            SectorId: $('#SectorId').val(),
            BlockId: $('#BlockId').val()
        };
        return model;
    }


    function UpdateDocument(row) {
        var tr = $(row).parent().parent().parent();
        var rid = $(tr).children("td:eq(3)").text();
        alert(rid);
        if (rid.length > 0) {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ RegistrationId: rid, ActionType: "RegistrationId" }),
                url: '/Property/PropertyAllotment/UpdateDocumentStatusOfProperty',
                success: function (result) {
                    if (result == '@ReturnType.Updated') {
                        alertify.success("Data updated successfully.");
                        $('#GridAllottedProperty').data('kendoGrid').dataSource.read();
                    }
                    else {
                        alertify.error("Document is not available.");
                    }
                },
                error: function (obj) {
                    alertify.error("Some error occured. Please try again later.");
                }
            });
        } else {
            alertify.error("Registration Id is not selected.");
        }
    }

    function UpdateDocumentByDepartment(e) {
        var departmentId = $('#DepartmentId').val();
        if (departmentId != "") {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ DepartmentId: departmentId, ActionType: "Department" }),
                url: '/Property/PropertyAllotment/UpdateDocumentStatusOfProperty',
                success: function (result) {
                    if (result == '@ReturnType.Updated') {
                        alertify.success("Data updated successfully.");
                        $('#GridAllottedProperty').data('kendoGrid').dataSource.read();
                    }
                    else {
                        alertify.error("Data is not updated.");
                    }
                },
                error: function (obj) {
                    alertify.error("Some error occured. Please try again later.");
                }
            });
        } else {
            alertify.error("Select Department.");
        }
    }

</script>