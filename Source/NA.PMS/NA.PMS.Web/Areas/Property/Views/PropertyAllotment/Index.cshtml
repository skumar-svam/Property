            <div class="col-md-2 col-sm-6 col-xs-12 form-group">
                @Html.Label("Allottee")
                @Html.TextBoxFor(model => model.Applicant, htmlAttributes: new { @class = "k-textbox", style = "width:90%; float:right;" })
                @*@(Html.Kendo().AutoCompleteFor(model => model.Applicant)
