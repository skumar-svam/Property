<div class="property-content">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Search Property</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
