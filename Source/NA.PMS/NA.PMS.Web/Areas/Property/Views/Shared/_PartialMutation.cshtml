            @{Html.RenderPartial("_FileUpload", Model);}
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
        </div>
    </div>
    @Html.HiddenFor(m => m.DepttId)
</div>


<script type="text/javascript">
    $(document).ready(function () {
        $('#TransferDate').data('kendoDatePicker').enable(false);
        $("#GPAEffectiveFrom").data("kendoDatePicker").enable(false);
        $("#GPAEffectiveto").data("kendoDatePicker").enable(false);
        $('.row-gpa').hide();
        //$('#txtRId').hide();
        //$('#RId').hide();
    });

    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }

    function RIdChange() {
        var rId = $("#RId").val();
        if (rId == '') {
            ClearValues();
            alertify.error("Please select an RID");
            return false;
        }
        //GetKYADetails(rId);
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rId: rId }),
            url: '/PropertyRegistration/GetTransferDetailsByRID',
            success: function (result) {
                if (result != null) {
                    $("#lblPropNo").html(result.PropNo);
                    $("#lblScNa").html(result.SchemeName);
                    $("#lblDeNa").html(result.DepttName);
                    $("#lblApNa").html(result.AllotteName);
                    $("#lblGender").html(result.Gender);
                    $("#lblReNa").html(result.FatherName);
                    $("#lblPropTy").html(result.PropType);
                    $("#lblArea").html(result.Area);
                    $("#lblFloor").html(result.Floor);
                    $("#lblTrNa").html(result.TransfereeName);
                    $("#lblTrGender").html(result.TransfereeGender);
                    $("#lblTrReNa").html(result.TransfereeRelationName);
                    $("#lblTransTy").html(result.TransferType);
                    $("#TransferDate").data("kendoDatePicker").value(result.TransferDate);
                    $("#ReqNo").val(result.ReqNo);
                    $("#DepttId").val(result.DepttID);
                    $("#GPAEffectiveFrom").data("kendoDatePicker").value(result.GPAEffectiveFrom);
                    $("#GPAEffectiveto").data("kendoDatePicker").value(result.GPAEffectiveto);
                    $("#lblGpaHolderName").html(result.GPAHolderName);
                    $("#lblGpaHolderAddress").html(result.GPAHolderAddress);

                    if (result.TransferType == "GPA") {
                        $('.row-gpa').show();
                    }
                }
                else {
                    ClearValues();
                    alertify.error("Some error occured. Please try again later.");
                }
            },
            error: function (obj) {
                ClearValues();
                alertify.error("Some error occured. Please try again later.");
            }
        });
    }

    function GetKYADetails(rId) {
        //var rId = $("#RId").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ RegistrationId: rId }),
            url: '/Property/PropertyRegistration/GetKYADetailsForRid',
            success: function (result) {
                if (result != null) {
                    if (result.StatusId == "2") {
                        alertify.error("Your KYA has been Rejected. Please Complete your KYA again.");
                        $('#btnAdd').attr('disabled', 'disabled');
                        return false;
                    }
                    else if (result.StatusId == "" || result.StatusId == null) {
                        alertify.error("Please Complete your KYA.");
                        $('#btnAdd').prop('disabled', true);
                        return false;
                    }
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }
        });
    }

    function ClearValues() {
        $("#lblPropNo").html('');
        $("#lblScNa").html('');
        $("#lblDeNa").html('');
        $("#lblApNa").html('');
        $("#lblGender").html('');
        $("#lblReNa").html('');
        $("#lblPropTy").html('');
        $("#lblArea").html('');
        $("#lblFloor").html('');
        $("#lblTrNa").html('');
        $("#lblTrGender").html('');
        $("#lblTrReNa").html('');
        $("#lblTransTy").html('');
        $("#TransferDate").data("kendoDatePicker").value('');
        $("#GPAEffectiveFrom").data("kendoDatePicker").value('');
        $("#GPAEffectiveto").data("kendoDatePicker").value('');
        $("#ReqNo").val('');
        $("#lblGpaHolderName").val('');
        $("#lblGpaHolderAddress").val('');
    }

    function RequestIdCheck() {
        var request = $("#OnlineRequestRefNo").val();
        rModel = {
            RequestId: $("#OnlineRequestRefNo").val(),
            RegistrationId: $("#RId").val(),
            ServiceId: "9"
        }
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: rModel }),
            url: '/Property/PropertyRegistration/IsRequestIdIsExist',
            success: function (result) {
                if (result != '@ReturnType.Exist') {
                    if (result == '@NAStatusId.Completed') {
                        alertify.error("This Request is Completed");
                    }
                    else if (result == '@NAStatusId.Initiated') {
                        alertify.error("This Request is in Initiated State. Please Forward this request first.");
                    }
                    else if (result == '@NAStatusId.Objection') {
                        alertify.error("This Request in Objection State.");
                    }
                    else if (result == '@NAStatusId.Rejected') {
                        alertify.error("This Request is Rejected");
                    }
                    else if (result == '@NAStatusId.Cancelled') {
                        alertify.error("This Request is cancelled");
                    }
                    else if (result == '@NAStatusId.Withdrawn') {
                        alertify.error("This Request is Withdrawn by Allottee.");
                    }
                    else {
                        alertify.error("Request no. mismatch. Please enter a valid Request No.");
                    }
                    $("#OnlineRequestRefNo").val('');
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }
        });
    }
</script>

