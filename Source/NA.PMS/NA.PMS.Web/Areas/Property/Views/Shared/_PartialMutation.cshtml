@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
@model NA.PMS.Model.MutationModel
@using NA.PMS.Common;

<h2 class="blck-heading">Registration Id</h2>
<div class="form-bx">
    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Registration Id", htmlAttributes: new { @class = "required" })
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @(Html.Kendo().DropDownListFor(m => m.RId)
                    .Filter("contains")
                    .DataTextField("text")
                    .DataValueField("id")
                    .OptionLabel("Select")
                    .DataSource(source =>
                    {
                        //source.Read(read =>
                        //{
                        //    read.Action("GetRIDsForMutation", "PropertyRegistration");
                        //});
                        source.Custom()
                    .ServerFiltering(true)
                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                    .Transport(transport =>
                    {
                        transport.Read("GetRIDsForMutation", "PropertyRegistration");
                    }).Schema(schema =>
                    {
                        schema.Data("Data")
                        .Total("Total");
                    }).PageSize(100);
                    })
                    .Events(events => { events.Change("RIdChange"); })
                    .HtmlAttributes(new { @class = "schemeForms", style = "width:100%" })
            )
            @*@Html.TextBoxFor(m => m.RId, htmlAttributes: new { @class = "form-control schemeForms", @onchange = "RIdChange();",@id="txtRId" })*@
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">

        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">

        </div>
    </div>
    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Property No")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            <span class="lbl-form-control">
                <div id="lblPropNo">
                    @Html.DisplayFor(m => m.PropNo)
                </div>
            </span>
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Request Ref No", htmlAttributes: new { @class = "required" })
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.TextBoxFor(m => m.OnlineRequestRefNo, htmlAttributes: new { @class = "form-control", onkeypress = "return IsNumeric(event);", @maxlength = "8", @onchange = "RequestIdCheck();" })
        </div>
    </div>
</div>

