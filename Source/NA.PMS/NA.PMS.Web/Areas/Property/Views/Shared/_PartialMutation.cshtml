<h2 class="blck-heading">Mutation Details</h2>
<div class="form-bx">
    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Mutation Date", htmlAttributes: new { @class = "required" })
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @(Html.Kendo().DatePickerFor(m => m.MutationDate).Max(DateTime.Now)
                                  .HtmlAttributes(new { @class = "DisableKeyboardInput", style = "width:100%" }))
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Transfer Deed Date", htmlAttributes: new { @class = "required" })
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @(Html.Kendo().DatePickerFor(m => m.TransferDeedDate).Max(DateTime.Now)
                                  .HtmlAttributes(new { @class = "DisableKeyboardInput", style = "width:100%" }))
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Bahi Number", htmlAttributes: new { @class = "required" })
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.TextBoxFor(m => m.BahiNo, htmlAttributes: new { @class = "form-control", @maxlength = "10" })
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Bahi Zild Number", htmlAttributes: new { @class = "required" })
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.TextBoxFor(m => m.BahiZildNo, htmlAttributes: new { @class = "form-control", @maxlength = "10" })
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Bahi Page Number", htmlAttributes: new { @class = "required" })
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.TextBoxFor(m => m.BahiPageNo, htmlAttributes: new { @class = "form-control", @maxlength = "10" })
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("SI Number", htmlAttributes: new { @class = "required" })
        </div>
