    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<TransferServiceRequestModel>()
                .Name("gvTransferServiceRequest")
                .Columns(columns =>
                {
                    columns.Bound(c => c.StrTransType).Title("Transfer Type");
                    columns.Bound(c => c.StrTransSybType).Title("Transfer Sub Type");
                    columns.Bound(c => c.StrGender).Title("Gender");
                    columns.Bound(c => c.Name).Title("Name");
                    columns.Bound(c => c.RelativeName).Title("Husband Name");
                    columns.Bound(c => c.MotherName).Title("Mother Name");
                    columns.Bound(c => c.MobileNo).Title("Mobile No.");
                    columns.Bound(c => c.Email).Title("Email");
                    columns.Bound(c => c.CorrespondenceAdd).Title("Correspondence Add.");
                    columns.Bound(c => c.PermanentAdd).Title("Permanent Add.");                   
                })
                .Sortable()
                .Filterable()
                .Pageable
                    (
                        pageable => pageable
                        .Enabled(true)
                        .PageSizes(true)
                     )
                .DataSource
                (
                     dataSource => dataSource
                            .Ajax()//.Model(model => model.Id(p => p.StrTrans))
                    .ServerOperation(true)
                            .Read(read => read.Action("GetTransferServiceReqByRid", "CitizenRequests", new { area = "Member" }).Data("GetRid")).PageSize(20)
                 ).AutoBind(false)
        )
    </div>
