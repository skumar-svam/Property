@*PopUp to print*@
<div id="divPrintChallan" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog" style="width: 50%">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Challan</b></h4>
            </div>
            <div class="modal-body" id="divChallanBody">

            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv();">Print</button>

            </div>
        </div>
    </div>
</div>

@Html.HiddenFor(model => model.RID)
@Html.HiddenFor(m => m.SchemeId)
@Html.HiddenFor(m => m.PropertyId)
@Html.HiddenFor(m => m.DepartmentId)
<script type="text/javascript">
    $(document).ready(function () {
        GetApplicantDetails();
        GetPropertyDetails();
        $("#installmentStartDate").kendoDatePicker().closest(".k-widget").attr("id", "datepicker_wrapper");
        $("#allotmentDate").kendoDatePicker().closest(".k-widget").attr("id", "datepicker_wrapper");
        $("#btnallotMoney").click(function () {
            var id = $("#ReqNo").val();
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ propId: $('#PropertyId').val(), schemeId: $('#SchemeId').val(), deptId: $('#DepartmentId').val() }),
                url: '/DocParser/PrintAllotmentChallan',
                success: function (result) {
                    $("#divChallanBody").html(result);
                    $("#divPrintChallan").modal('show');
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    //alert(respText);
                    alertify.error("Some error occured. Please try again later.");
                }
            });
        });
    });

    function PrintDiv() {
        var contents = document.getElementById("divChallanBody").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }

    function GetApplicantDetails() {
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ propId: $("#RID").val() }),
            url: "/Allotment/GetApplicantDetails",
            success: function (data) {
                if (data != null) {
                    if (data.GenderName.toUpperCase() == "C" || data.GenderName.toUpperCase() == "COMPANY") {
                        $("#_Father").text("Authorized Signatory");
                        $('#Father').html(data.SigningAuthority);
                        $('#Gender').html("Company");
                        $("#divCatOcup").hide();
                        $("#divReligionIncome").hide();
                    }
                    else {
                        $('#Gender').html(data.GenderName);
                        $('#Father').html(data.FatherName);
                    }
                    $('#FormID').html(data.FormNo);
                    $('#ApplicantName').html(data.FirstName);
                    //$('#Gender').html(data.GenderName);
                    //$('#Father').html(data.FatherName);
                    var mobileno = (data.MobileNumber == null || data.MobileNumber == "") ? "NA" : data.MobileNumber;
                    $('#Mobile').html(mobileno);
                    var email = (data.Email == null || data.Email == "") ? "NA" : data.Email;
                    $('#Email').html(email);
                    $('#PermanentAddress').html(data.PermanentAddress);
                    $('#Address').html(data.CorrespondingAddress);
                    $('#Earnest').html(data.earnestMoney);
                    $('#ApplicationId').val(data.ApplicationId);
                    $('#AnnualIncome').html(data.AnnualIncome);
                    $('#PanCard').html(data.PanNumber);
                    var ocupation = (data.OccupationName == null || data.OccupationName == "") ? "NA" : data.OccupationName;
                    $('#occupation').html(ocupation);
                    var religion = (data.ReligionName == null || data.ReligionName == "") ? "NA" : data.ReligionName;
                    $('#Religion').html(religion);
                    var category = (data.CategoryName == null || data.CategoryName == "") ? "NA" : data.CategoryName;
                    $('#Category').html(category);
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert("error");
            }
        });
    }


    function GetPropertyDetails() {
        $('#schemeName').empty();
        $('#propertytype').empty();
        $('#Block').empty();
        $('#floor').empty();
        $('#coveredArea').empty();
        $('#propertyCost').empty();
        $('#totalpropertyCost').empty();
        $('#locationType').empty();
        $('#locationCharges').empty();
        $('#Department').empty();
        $('#sector').empty();
        $('#propertynu').empty();
        $('#totalarea').empty();
        $('#actualarea').empty();
        $('#civil').empty();
        $('#landRate').empty();
        $('#totPropertycost').empty();
        $('#totalInstallment').empty();
        $('#earnestMoney').empty();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rID: $("#RID").val() }),
            url: "/Allotment/GetPropertyDetails",
            success: function (data) {
                if (data != null) {
                    //debugger;
                    $('#schemeName').html(data.SchemeName);
                    $('#propertytype').html(data.PropertyTypeName);
                    $('#Block').html(data.BlockName);
                    $('#floor').html(data.FloorName);
                    $('#coveredArea').html(data.CoveredArea);
                    $('#propertyCost').html(data.PropertyCost);
                    $('#totalpropertyCost').html(data.TotalPropertyCost);

                    var locationtype = (data.LocationType == null || data.LocationType == "") ? "NA" : data.LocationType;
                    $('#locationType').html(locationtype);
                    var locationcharge = (data.LocationCharges == null || data.LocationCharges == "") ? "NA" : data.LocationCharges;
                    $('#locationCharges').html(locationcharge);
                    $('#earnestMoney').html(data.EarnestMoney);
                    $('#Department').html(data.DepartmentName);
                    $('#sector').html(data.SectorName);
                    $('#propertynu').html(data.PropertyNo);
                    $('#totalarea').html(data.TotalArea);
                    $('#actualarea').html(data.ActualArea);
                    var civilcost = (data.CivilCost == null || data.CivilCost == "") ? "NA" : data.CivilCost;
                    $('#civil').html(civilcost);
                    $('#landRate').html(data.LandRate);
                    $('#totPropertycost').html(data.TotalPropertyCost);
                    $('#totalInstallment').html(data.TotalnoofInstallment);
                    $('#hidinstallmentStartDate').val(data.InstalmentStartDate);
                    $('#hidallotmentDate').val(data.AllotmentDate);
                    $('#hidPropertyId').val(data.PropertyId);
                    $('#hidSchemeId').val(data.SchemeId);
                    $('#hiddepartmentId').val(data.DepartmentId);
                    var datepicker = $("#installmentStartDate").data("kendoDatePicker");
                    datepicker.value($("#hidinstallmentStartDate").val());
                    var datepicker1 = $("#allotmentDate").data("kendoDatePicker");
                    datepicker1.value($("#hidallotmentDate").val());                    
                    $('#SchemeId').val(data.SchemeId);
                    $('#PropertyId').val(data.PropertyId);
                    $('#DepartmentId').val(data.DepartmentId);
                }
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert("error");
            }
        });
    }

    function ChallanViewPrint() {
        var propertyId = $('#hidPropertyId').val();
        var schemeID = $("#hidSchemeId").val();
        var departmentID = $("#hiddepartmentId").val();       
        window.location.href = '../../Allotment/PrintViewAllotment?propertyId=' + propertyId + '&schemeID=' + schemeID + '&departmentID=' + departmentID;
    }

    $("#btnGenerateletter").click(function () {
        var rId = $("#RID").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rid: rId }),
            url: '/Allotment/Generateletter',
            success: function (result) {
                $("#divChallanBody").html(result);
                $("#divPrintChallan").modal('show');
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }
        });
    });
</script>
