@model NA.PMS.Model.PropertyCancellationModel
@using Kendo.Mvc.UI;

<div class="container-fluid">
    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Refund Type")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @(Html.Kendo().DropDownListFor(can => can.RefundType)
                    .Filter("contains")
                    .DataTextField("text")
                    .DataValueField("id")
                    .OptionLabel("Select")
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetRefundTypes", "PropertyCancellation").Data("RefundTypeData");
                        });
                    })
                    //.Events(events => { events.Change("RegisteredChange"); })
                    .HtmlAttributes(new { @class = "schemeForms", style = "width:100%" })
            )
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group col-sm-3 col-xs-12 form-group">
            @Html.Label("Refund")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @(Html.Kendo().DropDownListFor(can => can.RefundYesNo)
                    .Filter("contains")
                    .DataTextField("text")
                    .DataValueField("id")
                    .OptionLabel("Select")
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("YesNoDDL", "PropertyRegistration");
                        });
                    })
                    .Events(events => { events.Change("RefundYesNoChange"); })
                    .HtmlAttributes(new { @class = "schemeForms" , style="width:100%"})
            )
        </div>
    </div>
 
    <div class="row">
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @Html.Label("Refund Amount")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
            @(Html.Kendo().NumericTextBoxFor(can => can.RefundAmt)
                    .Name("RefundAmt")
                    .Min(0)
                    .Max(9999999999999)
                    .Spinners(false).Step(0)
                    .Enable(true)
                    .HtmlAttributes(new { style = "width: 100%", @maxlength = "13", @class = "k-label schemeForms textBoxValueRightAlign" })
            )
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group col-sm-3 col-xs-12 form-group">
            @Html.Label("Reason for Cancellation")
        </div>
        <div class="col-md-3 col-sm-3 col-xs-12 form-group col-sm-3 col-xs-12 form-group">
            @Html.TextAreaFor(can => can.ReasonOfCancel, htmlAttributes: new { @class="form-control"})
        </div>
    </div>
</div>

