    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<CICModel>()
                .Name("gvCICServiceRequest")
                .Columns(columns =>
                {
                    columns.Bound(c => c.ChangeTypeName).Title("Change Type Name");                   
                })
                .Sortable()
                .Filterable()
                .Pageable
                    (
                        pageable => pageable
                        .Enabled(true)
                        .PageSizes(true)
                     )
                .DataSource
                (
                     dataSource => dataSource
                    .Ajax().Model(model => model.Id(p => p.Rid))
                    .ServerOperation(true)
                                    .Read(read => read.Action("GetGetCICServiceReqByRid", "CitizenRequests", new { area = "Member" }).Data("GetRid")).PageSize(20)
                 ).AutoBind(false)
        )
