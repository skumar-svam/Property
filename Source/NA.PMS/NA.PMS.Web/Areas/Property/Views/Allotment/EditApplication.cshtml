                                @Html.Label("Branch Address", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @(Html.Kendo().DropDownListFor(m => m.BranchId)
                                .Filter("contains")
                                .DataTextField("text")
                                .DataValueField("id")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetSchemeWiseBranchs", "Allotment")
                                                    .Data("filterBranches");
                                            })
                                            .ServerFiltering(true);
                                        })
                            .HtmlAttributes(new { style = "width: 100%" })
                            .CascadeFrom("BankId")
                            .Enable(true)
                            .AutoBind(false)
                                )
                                @Html.ValidationMessageFor(model => model.BranchId, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Demand Draft Number", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(model => model.DemandDraftNumber, new { @class = "form-control", @onchange = "CheckUTROrDDNumber();", @maxlength = "6" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="divIssueBank">
                                @*<div class="col-sm-5 col-sm-offset-1" id="divIssueBank">*@
                                @Html.Label("Issuing Bank")
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="divIssueBankTxt">
                                @Html.TextBoxFor(model => model.IssueBank, new { @class = "form-control", @onchange = "IssueBankChange();", @maxlength = "50" })
                                @*@Html.ValidationMessageFor(model => model.issueDate, "", new { @class = "text-danger" })*@
                            </div>
                            @*<div class="col-sm-5 col-sm-offset-1" id="divUTRnumber">*@
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="divUTRnumber">
                                @Html.Label("UTR Number", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="divUTRnumberTxt">
                                @Html.TextBoxFor(model => model.UTRNumber, new { @class = "lbl-form-control", @maxlength = "50", @onchange = "CheckUTROrDDNumber();" })
                                @Html.ValidationMessageFor(model => model.UTRNumber, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Issue Date", htmlAttributes: new { @class = "required" })
                            </div>

                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @(Html.Kendo().DatePickerFor(model => model.IssueDate).HtmlAttributes(new { style = "width:100%", @class = "DisableKeyboardInput" }))
                                @Html.ValidationMessageFor(model => model.IssueDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="box-button text-center">
                    <input type="button" id="btnCancel" value="Cancel" class="btn btn-default" />
                    <input type="submit" value="Update" id="btnSubmit" class="btn btn-add" />
                </div>
            </div>
        </div>
    </div>
}


<script type="text/javascript">
    function filterGender() {
        return {
            genderId: $("#GenderName").val()
        };
    }

    function FilterDepartment() {
        return { SchemeId: $("#SchemeId").val() };
    }

    function filterBankForms() {
        return {
            SchemeId: $("#SchemeId").val()

        };
    }
    function filterForms() {
        return {
            SchemeId: $("#SchemeId").val(),
            DepartmentId: $("#DepartmentId").val()
        };
    }

    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }
    function FormNoChange() {
        CheckFormNo($("#SchemeId").val(), $("#DepartmentId").val(), $("#FormNo").val());
    }

    function CheckFormNo(schemeId, departmentId, formNo) {
        $.ajax({
            url: '@(Url.Action("CheckFormNo", "Allotment"))',
            type: 'POST',
            dataType: 'json',
            data: { schemeId: schemeId, departmentId: departmentId, formNo: formNo, applicationId: 0 },
