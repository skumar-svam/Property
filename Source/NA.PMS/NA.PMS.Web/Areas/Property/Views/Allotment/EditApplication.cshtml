@model NA.PMS.Model.ApplicationFormModel
@using Kendo.Mvc.UI
@using NA.PMS.Common

@{
    ViewBag.Title = "Edit Application";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style type="text/css">
    .textBoxWidth {
        width: 50px;
    }
</style>

@using (Html.BeginForm("SaveApplicationForm", "Allotment", FormMethod.Post, new { enctype = "multipart/form-data", id = "userform" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ApplicationId)
    @Html.HiddenFor(m => m.PaymentType, new { @id = "hdnPaymentType" })
    @Html.HiddenFor(m => m.GenderName, new { @id = "hdnGenderName" })
    @Html.HiddenFor(m => m.SchemeId, new { @id = "hdnSchemeId" })

    <div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
        <div class="row">
            <div class="col-md-12">
                <div class="row rw-spce">
                    <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Edit Application Form: @Html.DisplayFor(model => model.FormNo)</h1></div>
                    <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
                </div>
            </div>
            <div class="col-md-12 blnk-rw"></div>
            <div class="col-md-12 content-top-spce">
                <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <h2 class="blck-heading">Personal Information</h2>
                    <div class="form-bx">
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group rdio-bx">
                                <input type="radio" id="rbtnIndividual" name="companyType" value="individual" checked="checked" disabled="disabled">&nbsp;Individual &nbsp;&nbsp;
                                <input type="radio" id="rbtnCompany" name="companyType" value="company" disabled="disabled" />&nbsp;Company
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Scheme Name", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @(Html.Kendo().DropDownListFor(model => model.SchemeId)
                      .Name("SchemeId")
                      .DataTextField("schemeName")
                      .DataValueField("schemeId")
                        .OptionLabel(" -- Please Select --")
                        .Events(events => { events.Change("SchemeOrDeptChange"); })
                      .DataSource(source => source.Read(read => read.Action("GetSchemeListForAllotment", "Allotment")))
                      .Enable(true)
                      .AutoBind(true)
                      .Filter("contains")
                      .HtmlAttributes(new { style = "width:100%", @class = "DisableKeyboardInput" })
                                )
                                @Html.ValidationMessageFor(model => model.SchemeId, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Department", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @(Html.Kendo().DropDownListFor(model => model.DepartmentId)
                      .Name("DepartmentId")
                      .DataTextField("DepartmentName")
                      .DataValueField("DepartmentId")
                      .OptionLabel(" -- Please Select --")
                        .Events(events => { events.Change("SchemeOrDeptChange"); })
                      .DataSource(source => source.Read(read => read.Action("FilterDepartmentOnScheme", "Allotment").Data("FilterDepartment")).ServerFiltering(true))
                      .Enable(false)
                      .AutoBind(false)
                              .Filter("contains")
                      .CascadeFrom("SchemeId")
                      .HtmlAttributes(new { style = "width:100%", @class = "DisableKeyboardInput" })
                                )        @Html.ValidationMessageFor(model => model.DepartmentId, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Form Number", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(model => model.FormNo, new { @class = "form-control", @maxlength = "10", @disabled = "disabled" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Gender", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                <div id="ddlGenderName">
                                    @(Html.Kendo().DropDownListFor(m => m.GenderName).Filter("contains")
                    .Events(events => { events.Change("GenderChange"); })
        //.Name("SelectGender")
                    .DataTextField("text")
                    .DataValueField("text")
                    .OptionLabel("Select")
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetGenderOnly", "Allotment")
                            .Data("filterGender");
                        });
                    })
                    .HtmlAttributes(new { @class = "schemeForms", style = "width: 100%" })
                                    )
                                </div>
                            </div>
                        </div>
                        <div class="row" id="divFirstAndMiddleName">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("First Name", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(model => model.FirstName, new { @class = "form-control", @onchange = "FirstNameChange();", @maxlength = "100" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Middle Name")
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(model => model.MiddleName, new { @class = "form-control", @maxlength = "100" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Last Name", new { @class = "required", id = "lblLastName" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(model => model.LastName, new { @class = "form-control", @onchange = "LastNameChange();", @maxlength = "100" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Email")
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @(Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", @maxlength = "150" } }))
                            </div>
                        </div>
                        <div class="row" id="divParentsName">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Father's Name", new { @class = "required", @id = "lblFatherName" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(model => model.FatherName, new { @class = "form-control", @onchange = "FatherNameChange();", @maxlength = "150" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Mother's Name", htmlAttributes: new { @class = "" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @*@Html.TextBoxFor(model => model.MotherName, new { @class = "form-control", @onchange = "MotherNameChange();", @maxlength = "150" })*@
                                @Html.TextBoxFor(model => model.MotherName, new { @class = "form-control", @maxlength = "150" })
                            </div>
                        </div>
                        <div class="row" id="divSigningAuthority">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Authorized Signatory", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(model => model.SigningAuthority, new { @class = "form-control", @onchange = "SigningAuthorityChange();", @maxlength = "150" })
                                @Html.ValidationMessageFor(model => model.SigningAuthority, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Registered Office")
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(model => model.RegisteredOffice, new { @class = "form-control", @maxlength = "150" })
                            </div>
                        </div>
                        <div class="row" id="dvDOB">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Date Of Birth", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                <div class="col-md-6 col-sm-6 col-xs-6">
                                    @(Html.Kendo().DatePickerFor(model => model.DOB)
                            .Events(e =>
                                      {
                                          e.Change("change");
                                      })
                    .HtmlAttributes(new { style = "width:100%", @class = "DisableKeyboardInput" })
                                    )
                                    @Html.ValidationMessageFor(model => model.DOB, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-6 col-sm-6 col-xs-6">
                                    <div class="age-bx">
                                        @Html.Label("Age")
                                        @Html.TextBoxFor(model => model.Age, new { @class = "form-control", style = "width:50px", @readonly = "readonly" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Marital Status", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @(Html.Kendo().DropDownListFor(m => m.MaritialStatusName).Filter("contains")
        //.Name("frequency")
                            .DataTextField("text")
                            .DataValueField("text")
                            .OptionLabel("Select")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetMaritialStatus", "Allotment");
                                });
                            })
                            .HtmlAttributes(new { @class = "schemeForms", style = "width: 100%" })
                                )
                                @Html.ValidationMessageFor(model => model.MaritialStatusName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Correspondence", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.TextAreaFor(model => model.CorrespondingAddress, new { @class = "form-control", @onchange = "CorrespondingAddressChange();", @maxlength = "500" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Permanent Address", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.TextAreaFor(model => model.PermanentAddress, new { @class = "form-control", @onchange = "PermanentAddressChange();", @maxlength = "500" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Phone Number")
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(model => model.PhoneNumberP1, new { @class = "form-control ph-input-sml pull-left", @maxlength = "8", @onchange = "CheckZeroInSTD();", onkeypress = "return IsNumeric(event);" })
                                @Html.TextBoxFor(model => model.PhoneNumber, new { @class = "form-control ph-input-lg pull-right", @maxlength = "12", @onchange = "CheckZeroInSTD();", onkeypress = "return IsNumeric(event);" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Mobile Number", htmlAttributes: new { @class = "" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @*@Html.TextBoxFor(model => model.MobileNumber, new { @class = "form-control", @maxlength = "12", @onchange = "CheckZeroInSTD();", onkeypress = "return IsNumeric(event);" })*@
                                @Html.TextBoxFor(model => model.MobileNumber, new { @class = "form-control", @maxlength = "12", onkeypress = "return IsNumeric(event);" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Fax Number")
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(model => model.FaxNumberP1, new { @class = "form-control ph-input-sml pull-left", @maxlength = "8", @onchange = "CheckZeroInSTD();", onkeypress = "return IsNumeric(event);" })
                                @Html.TextBoxFor(model => model.FaxNumber, new { @class = "form-control ph-input-lg pull-right", @maxlength = "12", @onchange = "CheckZeroInSTD();", onkeypress = "return IsNumeric(event);" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="divOccupation">

                                @Html.Label("Occupation", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="divOccupationTxt">
                                @(Html.Kendo().DropDownListFor(m => m.OccupationId).Filter("contains")
        //.Name("frequency")
                    .DataTextField("text")
                    .DataValueField("id")
                    .OptionLabel("Select")
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetOccupation", "Allotment");
                        });
                    })
                    .HtmlAttributes(new { @class = "schemeForms", style = "width: 100%" })
                                )
                                @Html.ValidationMessageFor(model => model.OccupationId, "", new { @class = "text-danger" })
                            </div>

                        </div>
                        <div class="row" id="divReligion">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Religion", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @(Html.Kendo().DropDownListFor(m => m.ReligionId).Filter("contains")
        //.Name("frequency")
                    .DataTextField("text")
                    .DataValueField("id")
                    .OptionLabel("Select")
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetReligion", "Allotment");
                        });
                    })
                    .HtmlAttributes(new { @class = "schemeForms", style = "width: 100%" })
                                )
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Category", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="divOccupation">
                                @(Html.Kendo().DropDownListFor(m => m.CategoryId).Filter("contains")
        //.Name("frequency")
                    .DataTextField("text")
                    .DataValueField("id")
                    .OptionLabel("Select")
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetCategory", "Allotment");
                        });
                    })
                    .HtmlAttributes(new { @class = "schemeForms", style = "width: 100%" })
                                )
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Pan Number", htmlAttributes: new {@id = "lblPanNumber" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(model => model.PanNumber, new { @class = "form-control", placeholder = "e.g.- AAAAA1111A", @onchange = "PanNumberChange();", @maxlength = "10" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Annual Income", htmlAttributes: new { @class = "", @id = "lblAnnualIncome" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.TextBoxFor(model => model.AnnualIncome, new { @class = "form-control textBoxValueRightAlign", @maxlength = "15", onkeypress = "return IsNumeric(event);" })
                                @Html.ValidationMessageFor(model => model.AnnualIncome, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <h2 class="blck-heading">Payment Information</h2>
                    <div class="form-bx">
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Payment Type")
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group rdio-bx">
                                <label>@Html.RadioButtonFor(m => m.PaymentType, "DD", new { @class = "ChangePaymentType", @disabled = "disabled", @checked = true }) Demand Draft</label>
                                <label>@Html.RadioButtonFor(m => m.PaymentType, "RTGS", new { @class = "ChangePaymentType", @disabled = "disabled" }) RTGS</label>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Amount Deposited", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @(Html.Kendo().DropDownListFor(model => model.AmountDepositedId).Filter("contains")
                            .DataTextField("text")
                            .DataValueField("id")
                            .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("GetEarnestMoneyBySchemeAndDeptId", "Allotment").Data("filterForms");
                                    }).ServerFiltering(true);
                                })
                                .CascadeFrom("DepartmentId")
                            .HtmlAttributes(new { @class = "schemeForms", style = "width:100%" })
                                )
                                @Html.ValidationMessageFor(model => model.AmountDepositedId, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @Html.Label("Bank Name", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                                @(Html.Kendo().DropDownListFor(model => model.BankId).Filter("contains")
        //.Name("bankId")
                            .DataTextField("text")
                            .DataValueField("id")
                            .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("GetSchemeWiseBanks", "Allotment").Data("filterBankForms");
                                    }).ServerFiltering(true);
                                })

                            .HtmlAttributes(new { @class = "schemeForms", style = "width:100%" })
                            .CascadeFrom("SchemeId")
                                )
                                @Html.ValidationMessageFor(model => model.BankId, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="row" id="divDemandDraft">
