    function CheckUTROrDDNumber() {
        var isDDNumber = $('#PaymentType').is(':checked');
        if (isDDNumber == true) {
            if ($("#DemandDraftNumber").val().trim() == '') {
                $("#DemandDraftNumber").val('');
            }
            //var type1 = @Constants.DD;
            $.ajax({
                url: '@(Url.Action("CheckUTROrDDNumber", "Allotment"))',
                type: 'POST',
                dataType: 'json',
                data: { number: $("#DemandDraftNumber").val(), type: "DD", appId: $("#ApplicationId").val() },
                success: function (result) {
                    if (result == true) {
                        alertify.error("Demand Draft Number already exists in the system.");
                        $("#DemandDraftNumber").val('');
                        return false;
                    }
                }
            });
        }
        else {
            if ($("#UTRNumber").val().trim() == '') {
                $("#UTRNumber").val('');
            }
            $.ajax({
                url: '@(Url.Action("CheckUTROrDDNumber", "Allotment"))',
                type: 'POST',
