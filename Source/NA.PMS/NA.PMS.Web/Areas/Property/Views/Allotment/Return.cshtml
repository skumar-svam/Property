@model NA.PMS.Model.OnlineApplicationDetailsTrans
@using Kendo.Mvc.UI
@{
    ViewBag.Title = "Return";
    Layout = "~/Views/Shared/_OnlineRequestLayout.cshtml";
}

@{Html.RenderPartial("~/Areas/Online/Views/Shared/_Reciept.cshtml", Model);}

<script type="text/javascript">

    $(document).ready(function () {

        @{
    if (TempData["PaymentStatus"] != null || TempData["PaymentStatus"] != "")
    {
        if (TempData["PaymentStatus"] == "success")
        {
            @:alertify.success('@NA.PMS.Common.NAMessages.OAFPaymentSuccess');
                                        }

    }
}

    });
</script>