    $("#btnCommentPostApprove").click(function () {
        var requestNo = $("#ApplicationId").val();
        var comment = $("#Comment").val();
        var mobNo = $("#MobileNumber").val();
        var emailId = $("#Email").val();
        var acceptReject = $('#hdnAcceptReject').val();
        if (comment == "") {
            alert("Please enter Comment.");
        }
        else {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ requestNo: requestNo, comment: comment, acceptReject: acceptReject, MobNo: mobNo, EmailId: emailId }),
                url: '/Allotment/SaveCommentByAppID',
                success: function (result) {
                    if (result == true) {
                        if (acceptReject == "true") {
                            alertify.success("Application accepted successfully.");
                        }
                        else {
                            alertify.success("Application rejected successfully.");
                        }
                        CloseCommnetPostPopUp();
                        window.location.href = '@Url.Action("ManageOnlineApplication", "Allotment")';
                        //return false;
                    }
                    else {
                        alertify.error("Comment not updated.");
                    }
                },
                error: function (objAjaxRequest, strError) {
                    var respText = objAjaxRequest.responseText;
                    alert(respText);
                }
            });
        }
    });
</script>