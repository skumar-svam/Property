@model NA.PMS.Model.ManageRequestModel
@using Kendo.Mvc.UI
@using NA.PMS.Common

@{
    ViewBag.Title = "Manage Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .k-grid-content {
        overflow-y: hidden;
        overflow-x: hidden;
    }
</style>

<div>
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Manage Allottee List Request</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">

            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.Model.ManageRequestModel>()
                      .Name("gridViewAllUsers")
                      .Columns(columns =>
                      {
                          columns.Bound(c => c.SchemeName).Title("Scheme Name");
                          columns.Bound(c => c.Department).Title("Department");
                          columns.Bound(c => c.Status).Title("Status");
                          columns.Bound(c => c.ReuestedBy).Title("Requested By");
                          columns.Bound(c => c.RequestedReceived).Title("Request Received");
                          columns.Bound(c => c.ApprovedBy).Title("Approved/Rejected By");
                          columns.Bound(c => c.ApprovedOn).Title("Approved/Rejected On");
                          columns.Bound(c => c.SchemeId).Title("Action").ClientTemplate("<a href='" + "/Property/Allotment/ManageAllotteeRequest/" + "?SchemeId=#= EncryptedSchemeId #&DepartmentId=#=EncryptedDeptId#&AllotmentDate=#=EncryptedAllotmentDate#'" + ">View List</a>").Filterable(false);
                          //columns.Bound(c => c.SchemeId).Title("Actions").ClientTemplate("<a href='" + "/Property/Allotment/ManageUnsuccessfullAllottees/#=GetSchemeIdAndDept(SchemeId, DepartmentId,Status)#'>View List</a>").Filterable(false);
                      })
                        .Filterable().Resizable(resize => resize.Columns(true))
                        .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                        .DataSource(dataSource => dataSource
                            .Ajax().Model(model => model.Id(p => p.Status))
                            .ServerOperation(true).Sort(sort => sort.Add("CreatedDate").Descending())
                            .Read(read => read.Action("GetAllRequest", "Allotment")).PageSize(10)
                      )
        )
    </div>
