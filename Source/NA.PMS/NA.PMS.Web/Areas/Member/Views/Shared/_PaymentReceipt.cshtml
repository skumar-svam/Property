                        <span style="width:50%;text-align:right;float:right"><b>Online Request No.: &nbsp;<span id="recpt-request-id">[OnlineRequestId]</span></b></span>
                    </div>
                </div>
                <div class="row row-pad">
                    <div class="col-md-12">
                        <span style="width:50%;float:left"><b> Sector: &nbsp;<span id="recpt-sector">[Sector]</span></b> </span>
                        <span style="width:50%;text-align:right;float:right"><b>Block: &nbsp;<span id="recpt-block">[Block]</span></b></span>
                    </div>
                </div>
                <div class="row row-pad">
                    <div class="col-md-12">
                        <span style="width:50%;float:left"><b> Plot No: &nbsp;<span id="recpt-plotno">[PlotNo]</span></b> </span>
                        <span style="width:50%;text-align:right;float:right"><b>Challan Date: &nbsp;<span id="recpt-challan-date">[ChallanDate]</span></b></span>
                    </div>
                </div>
                <div class="row row-pad">
                    <div class="col-md-12">
                        <span style="width:50%;float:left"><b> Mobile No: &nbsp;<span id="recpt-mobileno">[MobileNo]</span></b> </span>
                        <span style="width:50%;text-align:right;float:right"><b>Email: &nbsp;<span id="recpt-email">[Email]</span></b></span>
                    </div>
                </div>
                <div class="row row-pad">
                    <div class="col-md-12">
                        <span style="width:50%;float:left"><b> Bank Name: &nbsp;<span id="recpt-bankname">[BankName]</span></b> </span>
                        <span style="width:50%;text-align:right;float:right"><b>Account No: &nbsp;<span id="recpt-accountno">[AccountNo]</span></b></span>
                    </div>
                </div>

                <div class="row row-pad">
                    <div class="col-md-12">
                        <span style="width:50%;float:left"><b> Paid Amount: &nbsp;<span id="recpt-amount">[Amount]</span></b></span>
                        <span style="width:50%;text-align:right;float:right"><b>Payment Status: &nbsp;<span id="recpt-transaction-status">[TransactionStatus]</span></b></span>
                    </div>
                </div>
                <div class="row row-pad">
                    <div class="col-md-12">
                        <span style="width:50%;float:left"><b> Payment Mode: &nbsp;<span id="recpt-mode">[Mode]</span></b></span>
                        <span style="width:50%;text-align:right;float:right"><b>Transaction Id: &nbsp;<span id="recpt-transactionid">[TransactionId]</span></b></span>
                    </div>
                </div>
                <div class="row row-pad">
                    <div class="col-md-12">
                        <span style="width:50%;float:left"><b> Payment Date: &nbsp;<span id="recpt-entry-date">[EntryDate]</span></b></span>
                        <span style="width:50%;text-align:right;float:right"><b>Bank Reference No: &nbsp;<span id="recpt-bankrefno">[BankReferenceNo]</span></b></span>
                    </div>
                </div>

                <div class="row row-pad row-btn">
                    <div class="col-md-12" style="text-align: center; padding:15px 0px;">
                        <button type="button" id="btnPrintDiv" class="btn btn-success" onclick=" PrintAcknowledgementReciept();">Print</button>
                        <button type="button" id="btn-close-popup" class="btn btn-danger" onclick="ClosePaymentReceipt();">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<script>
    @{
        if (TempData["Success"] != null || TempData["Success"] == "")
        {
            @:alertify.success('Payment completed successfully');
       }
