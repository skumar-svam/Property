    function ClosePaymentReceipt() {
        $('#div-payment-receipt').data("kendoWindow").close();
    }

    function ToJavaScriptDate(value) {
        var pattern = /Date\(([^)]+)\)/;
        var results = pattern.exec(value);
        //return value;
        if (results != null) {
            var dt = new Date(parseFloat(results[1]));
            return dt.getDate() + "/" + (dt.getMonth() + 1) + "/" + dt.getFullYear();
        }
    }

    function DisplayPaymentReceipt(id) {
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ Id: id }),
            url: '/Member/Authority/GetOnlinePaymentDetailById',
            success: function (result) {
                if (result != null) {
                    $('#recpt-challan-content').html(result.HtmlContent);
                    $('#recpt-challanref-id').html(result.ChallanRefId);
                    $('#recpt-applicant').html(result.Applicant);
                    $('#recpt-department').html(result.Department);
                    $('#recpt-request-id').html(result.OnlineRequestId == null ? "---------------" : result.OnlineRequestId);
                    $('#recpt-sector').html(result.Sector);
                    $('#recpt-block').html(result.Block);
                    $('#recpt-plotno').html(result.PlotNo);
                    $('#recpt-challan-date').html(ToJavaScriptDate(result.ChallanDate));
                    $('#recpt-mobileno').html(result.MobileNo);
                    $('#recpt-email').html(result.Email);
                    $('#recpt-bankname').html(result.BankName);
                    $('#recpt-accountno').html(result.AccountNo);
                    $('#recpt-amount').html(result.Amount);
                    $('#recpt-transaction-status').html(result.TransactionStatus);
                    $('#recpt-mode').html(result.Mode);
                    $('#recpt-transactionid').html(result.TransactionId);
                    $('#recpt-entry-date').html(ToJavaScriptDate(result.EntryDate));
                    $('#recpt-bankrefno').html(result.BankReferenceNo == null ? "----------------" : result.BankReferenceNo);

                    $('#div-payment-receipt').data("kendoWindow").open();
                    $('#div-payment-receipt').data("kendoWindow").center();
                }
            },
            error: function (ajaxRequest, strError) {
                var respText = ajaxRequest.responseText;
                //alertify.error("Network Error, please try again later.");
            }
        });
    }

    function PrintAcknowledgementReciept() {
        var contents = document.getElementById("payment-receipt-body").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<style>.td-amount {padding-right: 30px;}#recpt-challan-content {padding: 5px;font-size:10pt;}#authorityChallan {border: 1px solid black;padding: 5px;} .h4-dept{margin-top:0px; margin-bottom:0px;}.h4-noida{margin-bottom:2px;}</style>');
        frameDoc.document.write('<style>.row-btn{display:none;}</style>');
        frameDoc.document.write('</head><body style="font-size:10pt;">');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }


