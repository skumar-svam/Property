<script type="text/javascript">
    $(document).ready(function () {
        $('.popup-window').kendoWindow({
            modal: true,
            title: "Service Acknowledgement",
            actions: false, // [ "Minimize", "Maximize"],
            visible: false,
            width: "70%",
            //height: "60%",
        });

        $('#btnClose').click(function () {
            $(".popup-window").data("kendoWindow").close();
            //ClearFields();
        });

        $('.status-window').kendoWindow({
            modal: true,
            title: "Validate Service Request",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "15%"
            },
            width: "40%"
        });

        $('#btnStatusSubmit').click(function () {
            UpdateServiceStatus();
            //if (ValidateActionField()) {
            //    $('#btnStatusSubmit').submit();
            //}
        });
        $("#btnStatusClose").click(function () {
            $("#divStatusMaster").data("kendoWindow").close();
        });

        $('#btn-update-rid').click(function () {
            UpdateRegistrationId();
        });

        $("#btn-update-close").click(function () {
            $('#div-registrationid-window').data("kendoWindow").close();
        });

        $('#btnSearch').click(function () {
            ChangeDepartmentEvent();
        });

        $('#btnClear').click(function () {
            $('#DepartmentId').data("kendoDropDownList").value("");
            $('#ServiceId').data("kendoDropDownList").value("");
            $('#ServiceStatusId').data("kendoDropDownList").value("");
            $('#StartDate').data("kendoDatePicker").value("");
            $('#EndDate').data("kendoDatePicker").value("");
            $("#GridServiceRequest").data("kendoGrid").dataSource.read();
        });

    })

    function FilterDepartment() {
        return { departmentId: $('#DepartmentId').val() }
    }

    function FilterSearchParameter() {
        return {
            DepartmentId: $('#DepartmentId').val(),
            ServiceId: $('#ServiceId').val(),
            ServiceStatusId: $('#ServiceStatusId').val(),
            StartDate: $('#StartDate').val(),
            EndDate: $('#EndDate').val()
        };
    }
    function ChangeDepartmentEvent() {
        $("#GridServiceRequest").data("kendoGrid").dataSource.read();
    }

    function RedirectForServices(serviceid, rid) {
        if (serviceid == 1) {
            // window.location.href = "/Property/PropertyRegistration/AddRentRequest" + "?id=" + rid;
        }
        if (serviceid == 2) {
            window.location.href = "/Property/PropertyRegistration/AddRentRequest" + "?id=" + rid;
        }
        if (serviceid == 3) {

        }
    }

    function OpenStatusWindow(row) {
        var tr = $(row).parent().parent();
        var id = $(tr).children("td:eq(0)").text();
        $('#RequestId').val(id);
        $('#divStatusMaster').data("kendoWindow").center();
        $('#divStatusMaster').data("kendoWindow").open();
    }

    function OpenUpdateWindow(id) {
        $('#RequestId').val(id);
        $('#txtrequestid').val(id);
        $('#div-registrationid-window').data("kendoWindow").center();
        $('#div-registrationid-window').data("kendoWindow").open();
    }

    function UpdateRegistrationId() {
        var id = $('#RequestId').val();
        var rid = $('#txtregistrationid').val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ Id: id, RegistrationId: rid }),
            url: '/Member/ServiceRequest/UpdateRegistrationIdToServiceRequestById',
            success: function (result) {
                if (result == '@ReturnType.Updated') {
                    alertify.success("Registration Id updated successfully.");
                }
                $("#GridServiceRequest").data("kendoGrid").dataSource.read();
                $('#div-registrationid-window').data("kendoWindow").close();
            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                alertify.error("Something is wrong, try again later");
            }
        });
    }

    function ValidateActionField() {
        var flag = true;
        if ($('#letterfiles').val() != "") {
            if (CheckOtherFileType() == false) {
                return flag = false;
            }
        }

        if ($('#StatusId').val() == "") {
            alertify.error("Select service status");
            flag = false;
        }
        else if (($('#StatusId').val() == '@NAStatusId.Cancelled') || ($('#StatusId').val() == '@NAStatusId.Pending')) {
            if ($('#Comment').val() == "") {
                alertify.error("Enter remarks for Cancellation/pending");
                flag = false;
            }
        }
        else if ($('#StatusId').val() == '@NAStatusId.Forwarded') {
            if ($('#ApproverId').val() == "") {
                alertify.error("Select Approver");
                flag = false;
            }
        }
        return flag;
    }

    function ChangeStatusIdEvent() {
        if ($('#StatusId').val() == '@NAStatusId.Forwarded') {
            $('.row-approver').show();
            $('.doc').css("display", "none");
        }
        else if ($('#StatusId').val() == '@NAStatusId.Completed') {
            $('.doc').show();
            $('.row-approver').css("display", "none");
        }
        else {
            $('.row-approver').css("display", "none");
            $('.doc').css("display", "none");
        }
        @*if ($('#StatusId').val() == '') {
            $('.row-approver').css("display", "none");
        }
        else if ($('#StatusId').val() == '@NAStatusId.Completed') {
            $('.row-approver').css("display", "none");
        }
        else if (($('#StatusId').val() == '@NAStatusId.Cancelled') || ($('#StatusId').val() == '@NAStatusId.Pending')) {
            $('.row-approver').css("display", "none");
        }
        else if ($('#StatusId').val() == '@NAStatusId.Forwarded') {
            $('.row-approver').show();
        }*@
    }

    function UpdateServiceStatus() {
        if (ValidateActionField()) {
            //var model = {
            //    Id: $('#RequestId').val(),
            //    StatusId: $('#StatusId').val(),
            //    ApproverId: $('#ApproverId').val(),
            //    Comment: $('#Comment').val()
            //};
            var Id = $('#RequestId').val();
            var StatusId = $('#StatusId').val();
            var ApproverId = $('#ApproverId').val();
            var Comment = $('#Comment').val();

            var formData = new FormData($('#userform2').get(0));
            formData.append("StatusId", StatusId);
            formData.append("RequestId", Id);
            formData.append("ApproverId", ApproverId);
            formData.append("Id", Id);
            formData.append("Comment", Comment);
            formData.append("letterfiles", $('#letterfiles')[0].files[0]);
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: formData,
                url: '/Member/ServiceRequest/UpdateCustomerServiceRequestStatus',
                success: function (result) {
                    if (result == '@ReturnType.None') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.error("provider failed to update status.");
                    }
                    else if (result == '@ReturnType.Initiated') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.error("Form can't be Complete/Cancel but forward.");
                    }
                    else if (result == '@ReturnType.Updated') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.error("Service Request Closed.");
                    }
                    else if (result == '@ReturnType.Completed') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.success("Request Completed successfully.");
                        $("#GridServiceRequest").data("kendoGrid").dataSource.read();
                    }
                    else if (result == '@ReturnType.Cancelled') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.success("Request Cancelled successfully.");
                        $("#GridServiceRequest").data("kendoGrid").dataSource.read();
                    }
                    else if (result == '@ReturnType.Forwarded') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.error("Request has already forwarded.");
                    }
                    else if (result == '@ReturnType.Pending') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.error("Service Request put on hold.");
                        $("#GridServiceRequest").data("kendoGrid").dataSource.read();
                    }
                    else if (result == '@ReturnType.Exist') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.error("Service Request is already on hold.");
                    }
                    else if (result == '@ReturnType.Validated') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.success("Request forwarded successfully.");
                        $("#GridServiceRequest").data("kendoGrid").dataSource.read();
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Something is wrong, try again later");
                }
            });
        }
    }

    function UpdatePaymentStatus(row) {
        var tr = $(row).parent().parent();
        var _RequestId = $(tr).children("td:eq(4)").text();

        if (_RequestId > 0) {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                data: { RequestId: _RequestId},
                url: '/Member/ServiceRequest/UpdatePaymentStatusByRequestId',
                success: function (result) {
                    if (result != null) {
                        if (result == true) {
                            window.locationbar.href = "/Member/ServiceRequest/ManageNICRequests";
                        }
                    }
                },
                error: function (ajaxRequest, strError) {
                    alertify.error("Something is wrong, try again later");
                }
            });

        }
    }

