<div id="div-charges">
    @{Html.RenderPartial("_ServiceChargeRequest");}
</div>


<div id="divDocumentView" style="overflow:hidden">
    <div class="row  no-margin no-padding">
        <div class="col-md-12 no-margin no-padding" id="divPageView" style="overflow:hidden">
            <iframe id="ifrmViewPdf" style="width:100%;"></iframe>
        </div>
    </div>
</div>

<div id="update-window" class="popup-update-window" style="min-height:200px; overflow:hidden">
    <div class="row form-group" style="margin-top:30px;">
        <div class="col-md-3">
            <label style="padding-left:15px;padding-right:0;">Service Id:</label>
        </div>
        <div class="col-md-5">
            @(Html.Kendo().DropDownListFor(model => model.ServiceModel.ServiceId)
                    .Name("txtServiceId")
                    .DataTextField("Text")
                    .DataValueField("ServiceId")
                    .OptionLabel("---select---")
                    .DataSource(dataSource => dataSource
                    .Read(read => read.Action("GetServiceListByDepartmentForNAServices", "ServiceRequest").Data("FilterDepartment")).ServerFiltering(true)
                    )
                    .CascadeFrom("ServiceModel_DepartmentId")
                    .HtmlAttributes(new { style = "width:100%;" })
            )
        </div>
        <div class="col-md-3" style="padding-left:30px;">
            <input type="button" id="btn-submit-serviceid" class="k-button" value="Update" />
        </div>
    </div>
    <div class="row form-group" style="margin-top:30px;" id="divRid">
        <div class="col-md-3">
            <label style="padding-left:15px;padding-right:0;">Registration Id:</label>
