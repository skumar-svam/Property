            //if (SumOfTotalFileSize > 20000000) {
            //    toastr.error('Total Uploaded File having is greater than 15 mb.');
            //    e.preventDefault();
            //    return false;
            //}
        }
        else {
            alertify.error('Please select a file.')
            return flag = false;
        }
        return flag;
    }


    function UpdateRegistrationId() {
        var rid = $('#txtRegistrationId').val();
        if (rid != "" && rid.length == 8) {
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ Id: $('#ServiceModel_RequestId').val(), RegistrationId: rid, ActionType: '@ActionType.RegistrationId' }),
                url: '@Url.Action("UpdateServiceRequestDetail", "Report", new { area="Reports"})',
                success: function (result) {
                    if (result == '@ReturnType.Updated') {
                        alertify.success("Registration Id updated successfully.");
                        $('#txtRegistrationId').val('');
                        //$(".popup-update-window").data("kendoWindow").close();
                        //window.location.href = "/Member/ServiceRequest/RequestDetail/" + $('#ServiceModel_RequestId').val();
                    }
                    $(".popup-update-window").data("kendoWindow").close();
                    window.location.reload();
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Network error.");
                }
            });
        }
    }

    function UpdateServiceId() {
        var serviceid = $('#txtServiceId').val();
        if (serviceid != "") {
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ Id: $('#ServiceModel_RequestId').val(), ActionType: '@ActionType.ServiceId', ServiceId: serviceid }),
                url: '@Url.Action("UpdateServiceRequestDetail", "Report", new { area="Reports"})',
                success: function (result) {
                    if (result == '@ReturnType.Updated') {
                        alertify.success("Service Id updated successfully.");
                        $('#txtServiceId').val('');
                    }
                    $(".popup-update-window").data("kendoWindow").close();
                    window.location.reload();
                },
                error: function (ajaxRequest, strError) {
                    alertify.error("Network error.");
                }
            });
        }
    }

    function FilterDepartment() {
        return { departmentId: $('#ServiceModel_DepartmentId').val() };
    }

    function FilterService() {
        return {
            serviceId: $('#ServiceModel_ServiceId').val(),
            RequestDate: $('#ServiceModel_CreatedDate').val()
        };
    }

    function IsRidExists() {
        var rid = $('#txtRegistrationId').val();
        var prop = $('#ServiceModel_PropertyNo').val();
        if (rid != "" && rid.length == 8) {
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ Id: $('#ServiceModel_RequestId').val(), RegistrationId: rid, PropertyNo: prop }),
                url: '@Url.Action("IsRidExists", "Report", new { area="Reports"})',
                success: function (result) {
                    if (result == '@ReturnType.NotExist') {
                        alertify.error("RegistrationId is not exist.");
                        $('#txtRegistrationId').val('');
                    }
                    if (result == '@ReturnType.Mismatch') {
                        alertify.error("RegistrationId mismatch");
                        $('#txtRegistrationId').val('');
                    }
                },
                error: function (ajaxRequest, strError) {
                    alertify.error("Network error.");
                }
            });
        }
    }

</script>
