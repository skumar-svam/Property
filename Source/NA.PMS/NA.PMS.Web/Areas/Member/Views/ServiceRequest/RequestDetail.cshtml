    function UpdateServiceStatus() {
        if (ValidateActionField()) {
            //var model = {
            //    Id: $('#ServiceModel_RequestId').val(),
            //    StatusId: $('#ServiceModel_StatusId').val(),
            //    ApproverId: $('#ServiceModel_ApproverId').val(),
            //    Comment: $('#ServiceModel_Comment').val(),
            //};
            var Id = $('#ServiceModel_RequestId').val();
            var StatusId = $('#ServiceModel_StatusId').val();
            var ApproverId = $('#ServiceModel_ApproverId').val();
            var Comment = $('#ServiceModel_Comment').val();
            //ServiceModel.RegistrationId
            var formData = new FormData($('#userform2').get(0));
            formData.append("StatusId", StatusId);
            formData.append("RegistrationId", $('#ServiceModel_RegistrationId').val());
            formData.append("DepartmentId", $('#ServiceModel_DepartmentId').val());
            formData.append("RequestId", Id);
            formData.append("ApproverId", ApproverId);
            formData.append("Id", Id);
            formData.append("IsDocumentRequired", $("#doc-checkbox").is(':checked'));
            formData.append("IsChargesRequired", $("#charge-checkbox").is(':checked'));
            formData.append("Comment", Comment);
            formData.append("letterfiles", $('#letterfiles')[0].files[0]);
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: formData,
                url: '/Member/ServiceRequest/UpdateCustomerServiceRequestStatus',
                success: function (result) {
                    if (result == '@ReturnType.None') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.error("provider failed to update status.");
                    }
                    else if (result == '@ReturnType.Initiated') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.error("Form can't be Complete/Cancel but forward.");
                    }
                    else if (result == '@ReturnType.Updated') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.error("Service Request Closed.");
                    }
                    else if (result == '@ReturnType.Completed') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.success("Request Completed successfully.");
                        window.location.reload();
                    }
                    else if (result == '@ReturnType.Cancelled' || result == '@ReturnType.Rejected') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.success("Request Rejected successfully.");
                        window.location.reload();
                    }
                    else if (result == '@ReturnType.Forwarded') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.error("Request has already forwarded.");
                    }
                    else if (result == '@ReturnType.Pending') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        //alertify.error("Service Request put on hold.");
                        alertify.success("Service Request put on Objection.");
                        window.location.reload();
                    }
                    else if (result == '@ReturnType.Exist') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.error("Service Request is already on hold.");
                    }
                    else if (result == '@ReturnType.Validated') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.success("Request forwarded successfully.");
                        window.location.reload();
                    }
                    else if (result == '@ReturnType.NotRegistered') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.success("Update Registration Id to complete this request.");
                        window.location.reload();
                    }
                    else if (result == '@ReturnType.NotAvailable') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.error("Request can be put in objection only once.");
                        window.location.reload();
                    }
                    else if (result == '@ReturnType.Appointment') {
                        $('#divStatusMaster').data("kendoWindow").close();
                        alertify.success("Request is successfully stored in appointment state.");
                        window.location.reload();
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Something is wrong, try again later");
                }
            });
        }
    }

