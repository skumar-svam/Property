<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<NA.PMS.Model.ServiceViewModel>()
            .Name("grid_#=Id#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(o => o.ServiceName).Width(250).Sortable(false).Filterable(false);//.ClientTemplate("<span>#= ServiceName #<br/><small ><b>Receiving Date:</b>&nbsp;#= CreatedDate#</small></span>");
                columns.Bound(o => o.Description).Sortable(false).Filterable(false);
                columns.Bound(o => o.Comment).Sortable(false).Filterable(false);
                columns.Bound(o => o.Status).Width(120).Title("Update Status").ClientTemplate("<label class='lbl-status-action' onclick='javascript:OpenStatusWindow(this)'>#=Status#</label>").Sortable(false).Filterable(false);
                //columns.Bound(o => o.RequestDate).Format("{0:dd/MM/yyyy}").Width(120);
            })
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(10)
                .Read(read => read.Action("GetPradhikaranDiwasRequestById", "ServiceRequest", new { Id = "#=Id#" }))
            )
            //.Pageable()
            .ToClientTemplate()
    )
</script>
<script>
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
</script>


<script>
    $(document).ready(function () {
        $('.popup-window').kendoWindow({
            modal: true,
            title: "Service Acknowledgement",
            actions: false, // [ "Minimize", "Maximize"],
            visible: false,
            width: "70%",
            //height: "60%",
        });

        $('#btnClose').click(function () {
            $(".popup-window").data("kendoWindow").close();
            //ClearFields();
        });

        $("#btnStatusClose").click(function () {
            $(".status-window").data("kendoWindow").close();
        });

        $('#divDocumentView').kendoWindow({
            modal: true,
            title: "Document",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "15%"
            },
            width: "70%", height: "80%"
        });

        $('#divStatusMaster').kendoWindow({
            modal: true,
            title: "Service Status",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "15%"
            },
            width: "40%"
        });

        $('#btnStatusSubmit').click(function () {
            UpdateServiceStatus();
        });
    })

    function AddRequest(event) {
        event.preventDefault();
        window.location.href = '@Url.Action("Index", "ServiceRequest")';
    }

    function OpenStatusWindow(row){
        var tr = $(row).parent().parent();
        var id = $(tr).children("td:eq(0)").text();
        $('#hdnServiceRequestId').val(id);
        $('.status-window').data("kendoWindow").center();
        $('.status-window').data("kendoWindow").open();
    }

    function UpdateServiceStatus() {
        var model = {
            Id: $('#hdnServiceRequestId').val(),
            StatusId: $('#ddl-ServiceStatus').val(),
            Comment: $('#txtAreaComment').val()
        };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: model }),
            url: '/Member/ServiceRequest/UpdateCustomerServiceRequestStatus',
            success: function (result) {
                $("#GridSDServiceRequest").data("kendoGrid").dataSource.read();
                $('.status-window').data("kendoWindow").close();
            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                alertify.error("Something is wrong, try again later");
            }
        });
    }
   

   

    function FilterDepartment() {
        return { departmentId: $('#DepartmentId').val() }
    }

    function FilterSearchParameter() {
        return {
            DepartmentId: $('#DepartmentId').val(),
            //ServiceId: $('#ServiceId').val(),
            StartDate: $('#StartDate').val(),
            EndDate: $('#EndDate').val()
        };
    }
    function ChangeDepartmentEvent() {
        $("#GridSDServiceRequest").data("kendoGrid").dataSource.read();
    }

    $('#btnSearch').click(function () {
        var model = {
            DepartmentId: $('#DepartmentId').val(),
            //ServiceId: $('#ServiceId').val(),
            StartDate: $('#StartDate').val(),
            EndDate: $('#EndDate').val(),
            //RegistrationNo: $('#RegistrationNo').val()
        };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model:model }),
            url: '/Property/GetServiceRequestReport',
            success: function (result) {
                $("#GridSDServiceRequest").data("kendoGrid").dataSource.read();
            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                alertify.error("Something is wrong, try again later");
            }
        });
    });

    $('#btnClear').click(function () {
        $('#DepartmentId').data("kendoDropDownList").value("");
        //$('#ServiceId').data("kendoDropDownList").value("");
        $('#StartDate').data("kendoDatePicker").value("");
        $('#EndDate').data("kendoDatePicker").value("");
        //$('#RegistrationId').val("");
        $("#GridSDServiceRequest").data("kendoGrid").dataSource.read();
    });

    function OpenFile(row) {
        //$("#windowDiv").empty();
        var tr = $(row).parent().parent();
        var RegistrationNo = $(tr).children("td:eq(1)").text();
        var RequestId = $(tr).children("td:eq(2)").text();       
        var Department = $(tr).children("td:eq(3)").text();
        var Applicant = $(tr).children("td:eq(16)").text();
        var PropertyNo = $(tr).children("td:eq(4)").text();
        var ServiceName = $(tr).children("td:eq(14)").text();
        var Description = $(tr).children("td:eq(15)").text();
        var CreatedDate = $(tr).children("td:eq(13)").text();      
        var MobileNo = $(tr).children("td:eq(11)").text();
        var SubDepartment = $(tr).children("td:eq(12)").text();
       
        $('#CreatedDate').text(CreatedDate);
        $('#RequestId').text(RequestId);
        $('#RegistrationNo').text(RegistrationNo != "" ? ("Registration No: "+RegistrationNo) : "");
        $('#Name').text(Applicant);
        $('#PropertyNo').text(PropertyNo);
        $('#Department').text(Department);
        //$('#SubDepartment').text(SubDepartment);
        $('#Mobile').text(MobileNo);
        $('#ServiceName').text(ServiceName);
        $('#Description').text(Description);

        $('.popup-window').data("kendoWindow").center();
        $('.popup-window').data("kendoWindow").open();
    }

    function OpenDocument_user(row) {
        $("#divDocumentView").empty();
        var tr = $(row).parent().parent();
        var link = $(tr).children("td:eq(16)").text();
        var ServiceRequestId = $(tr).children("td:eq(0)").text();
        var path = "http://" + $("#DocPath").val() + "//" + ServiceRequestId.trim() + "//";
        $("#divDocumentView").append($('<iframe src=' + path + link + ' style="width:900px;height:500px;overflow:hidden;"></iframe>'));
        $("#divDocumentView").data("kendoWindow").center();
        $("#divDocumentView").data("kendoWindow").open();
        $("#divDocumentView").data("kendoWindow").pin();
    }

    function OpenDocument_officer(row) {
        $("#divDocumentView").empty();
        var tr = $(row).parent().parent();
        var link = $(tr).children("td:eq(17)").text();
        var ServiceRequestId = $(tr).children("td:eq(0)").text();
        var path = "http://" + $("#DocPath").val() + "//" + ServiceRequestId.trim() + "//";
        $("#divDocumentView").append($('<iframe src=' + path + link + ' style="width:900px;height:500px;overflow:hidden;"></iframe>'));
        $("#divDocumentView").data("kendoWindow").center();
        $("#divDocumentView").data("kendoWindow").open();
        $("#divDocumentView").data("kendoWindow").pin();
    }

   


    function excelex(e) {
        var rows = e.workbook.sheets[0].rows;
        var StrParam = GetSearchParam();
        if (StrParam != "") {
            rows.unshift({
                cells: [{ value: GetSearchParam(), background: "#FFFFFF", fontSize: 16, colSpan: 10, textAlign: "right" }]
            });
        }
        rows.unshift({
            cells: [{ value: "", background: "#FFFFFF", fontSize: 18, colSpan: 3, textAlign: "right" }, { value: "Service Report - " + (new Date()).toDateString(), fontSize: 20, background: "#FFFFFF", colSpan: 4, textAlign: "right" }]
        });
    }

    //String for Excel
