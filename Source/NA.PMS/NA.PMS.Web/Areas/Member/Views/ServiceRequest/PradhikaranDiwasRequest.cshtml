@model NA.PMS.Model.ServiceViewModel
@using Kendo.Mvc.UI;

@{
    ViewBag.Title = "Pradhikaran Diwas Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style type="text/css">
    .top-margin {
        margin-top: 6px;
    }

    .col-md-2.pad-left {
        /*margin-left: 12px;*/
    }
    .lbl-status-action{
        cursor:pointer;
        color:blue;
    }
</style>

<div id="SDServiceReports">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Samadhan Diwas Service Request</h1></div>
            <div class="col-md-6 col-sm-6 col-xs-12 col-btn">
                <a href="/Member/ServiceRequest/PradhikaranDiwas" id="btnAddRequest" class="" target="_blank">Add Request</a>
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12" style="border-left:1px solid #abc;border-right:1px solid #abc ;padding-bottom:15px;">
        <div class="row form-group">
            <div class="col-md-2 pad-left">
                @Html.Label("Department")
                @(Html.Kendo().DropDownListFor(model=>model.DepartmentId)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .DataSource(source =>source.Read(read =>read.Action("GetDepartmentList", "ServiceRequest")))
                    .Events(e => e.Change("ChangeDepartmentEvent"))
                   .HtmlAttributes(new { style = "width:95%;float:right;", @class = "input-disabled" })
                )
            </div>
            <div class="col-md-2 pad-left">
                @Html.Label("Start Date")
                @(Html.Kendo().DatePickerFor(model => model.StartDate).Events(e => e.Change("ChangeDepartmentEvent")).HtmlAttributes(new { style = "width:95%;float:right;" }))
            </div>
            <div class="col-md-2 pad-left">
                @Html.Label("End Date")
                @(Html.Kendo().DatePickerFor(model => model.EndDate).Events(e => e.Change("ChangeDepartmentEvent")).HtmlAttributes(new { style = "width:95%;float:right;" }))
            </div>
            <div class="col-md-2 pad-left">
                <label>Status</label>
                @(Html.Kendo().DropDownListFor(m => m.StatusId)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetStatusMasterAsDataSource", "ServiceRequest", new { area = "Member" })))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                    .Events(events => { events.Change("ChangeDepartmentEvent"); })
                    .HtmlAttributes(new { @class = "input-disabled", style = "width:95%;float:right;" })
                )
            </div>
            <div class="col-md-2 pad-left">
                @*<label>Service Name</label>
                @(Html.Kendo().DropDownListFor(model => model.ServiceId)
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel("---select---")
                    .DataSource(dataSource => dataSource
                        .Read(read => read.Action("GetServiceListByDepartment", "ServiceRequest").Data("FilterDepartment")).ServerFiltering(true)
                    )
                    .CascadeFrom("DepartmentId")
                    .HtmlAttributes(new { style = "width:95%;float:right;" })
                    .Events(e => e.Change("ChangeDepartmentEvent"))
                )*@
            </div>
            <div class="col-md-2" style="text-align:center;">
                <label style="width:100%;"> </label>
                <button type="button" id="btnSearch" class="k-button top-margin" value="Search">Search</button>
                <button type="button" id="btnClear" class="k-button top-margin" value="Clear">Clear</button>
            </div>
        </div>
    </div>
    <div class="col-md-12 k-grid-content" style="overflow-y:hidden;">
        @(Html.Kendo().Grid<NA.PMS.Model.ServiceViewModel>()
              .Name("GridSDServiceRequest")
              .Excel(excel => excel.AllPages(true).Filterable(true).FileName("ServiceReport.xlsx"))
              .ToolBar(toolsExcel => toolsExcel.Excel())
              .Columns(columns =>
              {
                  columns.Bound(c => c.RegistrationNo).Hidden(true);
                  columns.Bound(c => c.Id).Title("Ref No").Width(100).ClientFooterTemplate("Total Count: #=count#");                  
                  columns.Bound(c => c.Department).Title("Department").Width(120).ClientTemplate("<span>#= Department #<br/>#if(SubDepartment!=null){# <small>(#=SubDepartment#)</small> #}else{# -- #}#</span>").Sortable(false).Filterable(false);
                  columns.Bound(c => c.PropertyNo).Title("Property No.").Width(140);
                  columns.Bound(c => c.Applicant).Title("Applicant").ClientTemplate("<span>#= Applicant #<br/>#if(MobileNo!=null){# <small class='glyphicon glyphicon-phone'>&nbsp;#=MobileNo#</small> #}else{# -- #}#</span>");                 
                  //columns.Bound(c => c.ServiceName).Title("Services").ClientTemplate("<span>#= ServiceName #<br/><small ><b>Receiving Date:</b>&nbsp;#= kendo.toString(CreatedDate, 'D')#</small></span>");                 
                  columns.Bound(c => c.RequestDate).Width(120).Format("{0:dd/MM/yyyy}");
                  columns.Bound(c => c.Status).Title("Status").Width(100);
                  columns.Bound(c => c.CreatedDate).Title(" ").Width(80).ClientTemplate("<a  onclick='javascript:OpenFile(this);'><center><span class='glyphicon glyphicon-print'></span></center></a>").Filterable(false).Sortable(false);
                  //columns.Bound(c => c.IsServiceHasDoc).ClientTemplate("#if(IsServiceHasDoc){# <center><span class='glyphicon glyphicon-download'></span></center> #}else{# <center>--</center> #}#").Title(" ").Filterable(false).Width(50);
                  //columns.Bound(c => c.UploadedDocument).ClientTemplate("#if(UploadedDocument!=''){# <a  onclick='javascript:OpenDocument_user(this);'><center><span class='glyphicon glyphicon-download'></span></center></a> #}else{# <center>--</center> #}#").Title("User").Filterable(false).Width(50);
                  //columns.Bound(c => c.DispatchedDocument).ClientTemplate("#if(DispatchedDocument!=''){# <a  onclick='javascript:OpenDocument_officer(this);'><center><span class='glyphicon glyphicon-download'></span></center></a> #}else{# <center>--</center> #}#").Title("Officer").Filterable(false).Width(50);
                  columns.Bound(c => c.UploadedDocument).Hidden(true);
                  columns.Bound(c => c.DispatchedDocument).Hidden(true);
                  columns.Bound(c => c.MobileNo).Hidden(true);
                  columns.Bound(c => c.SubDepartment).Hidden(true);
                  columns.Bound(c => c.CreatedDate).Format("{0:dd/MM/yyyy}").Hidden(true);
                  columns.Bound(c => c.ServiceName).Hidden(true);
                  columns.Bound(c => c.Description).Hidden(true);
                  columns.Bound(c => c.Applicant).Hidden(true);           
              })
              .Sortable()
              .Filterable()
              .Resizable(resize => resize.Columns(true))
              .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
              .ClientDetailTemplateId("template")
              //.HtmlAttributes(new { style = "height:600px;" })
              .DataSource
              (
                  dataSource => dataSource
                      .Ajax()
                      .Sort(x => x.Add("CreatedDate").Descending())
                      .Model(model => model.Id(p => p.Id))
                      .ServerOperation(true)
                      .Read(read => read.Action("GetPradhikaranDiwasRequestList", "ServiceRequest", new { area = "Member" }).Data("FilterSearchParameter")).PageSize(10)
                      .Aggregates(aggregates => aggregates.Add(p => p.Id).Count())
              )
              .Events(events => events.ExcelExport("excelex"))
        )
    </div>
</div>

<input type="hidden" value="@System.Configuration.ConfigurationManager.AppSettings["FTPSiteRootPath"]" id="DocPath" />
<div id="divDocumentView" style="overflow:hidden">
    <div class="row">
        <div class="col-md-12 no-margin no-padding" id="divPageView" style="overflow:hidden">
            <iframe id="ifrmViewPdf"></iframe>
        </div>
    </div>
</div>


<div class="col-md-12 status-window" id="divStatusMaster" style="min-height:250px;background:url(/Content/Images/boxed-bg.jpg) repeat;">
    <div class="row form-group" style="padding-top:15px;">
        <div class="col-md-3">
            <label>Service Status</label>
        </div>
        <div class="col-md-6">
            @(Html.Kendo().DropDownList()
                .Name("ddl-ServiceStatus")
                .Filter("contains")
                .DataTextField("Text")
                .DataValueField("Id")
                .OptionLabel(" -- Select --")
                .DataSource(source =>
                {
                    source.Custom()
                    .ServerFiltering(true)
                    .ServerPaging(true)
                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                    .Transport(transport => transport.Read(read => read.Action("GetStatusMasterAsDataSource", "ServiceRequest", new { area = "Member" })))
                    .Schema(schema => schema.Data("Data").Total("Total"))
                    .PageSize(100);
                })
                .Events(events => { events.Change("ChangeDepartmentEvent"); })
                .HtmlAttributes(new { @class = "input-disabled", style = "width:100%; float:right;" })
            )
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-3">
            <label>Comment</label>
        </div>
        <div class="col-md-9">
            <textarea class="k-textbox" id="txtAreaComment" style="width:93%;height:70px;"></textarea>
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-3">
            <input type="hidden" id="hdnServiceRequestId" />
        </div>
        <div class="col-md-9">
            <input type="button" class="k-button" id="btnStatusSubmit" value="Submit" style="width:100px;" />
            <input type="button" class="k-button" id="btnStatusClose" value="Close" style="width:100px;" />
        </div>
    </div>
</div>


