        </div>
        <div class="row row-pad">
            <div class="col-md-12">
                <b>
                    Thanks for using services online.<br />
                    Your Thankfully<br />
                    NOIDA
                </b>
            </div>
        </div>
        <div class="row row-pad row-btn">
            <div class="col-md-12" style="text-align: center; padding:15px 0 15px 0;">
                <button type="button" id="btnPrintDiv" class="btn btn-success" onclick=" PrintAcknowledgementReciept();">Print</button>
                <button type="submit" id="btnClose" class="btn btn-danger">Close</button>
            </div>
        </div>
    </div>
</div>


<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<NA.PMS.Model.ServiceViewModel>()
            .Name("grid_#=Id#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(o => o.Applicant);//.ClientTemplate("<span>#= ServiceName #<br/><small ><b>Receiving Date:</b>&nbsp;#= CreatedDate#</small></span>");
                columns.Bound(o => o.Description);
                columns.Bound(o => o.Comment);//.ClientTemplate("<label>#=Comment#</label>");
                //columns.Bound(o => o.Status).Width(120).Title("Status").ClientTemplate("<label>#=Status#</label>");
                //columns.Bound(o => o.Status).Width(120).Title("Update Status").ClientTemplate("<label class='lbl-status-action' onclick='javascript:OpenStatusWindow(this)'>#=Status#</label>");
                //columns.Bound(o => o.RequestDate).Format("{0:dd/MM/yyyy}").Width(120);
            })
            .DataSource(dataSource => dataSource
                .Ajax().Read(read => read.Action("GetCustomerServiceRequestListById", "ServiceRequest", new { Id = "#=Id#" }))
            )
            .ToClientTemplate()
    )
</script>
<script>
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
</script>

<script type="text/javascript">
    $(document).ready(function () {
        $('.popup-window').kendoWindow({
            modal: true,
            title: "Service Acknowledgement",
            actions: false, // [ "Minimize", "Maximize"],
            visible: false,
            width: "70%",
            //height: "60%",
        });

        $('#btnClose').click(function () {
            $(".popup-window").data("kendoWindow").close();
            //ClearFields();
        });

        $('#divStatusMaster').kendoWindow({
            modal: true,
            title: "Service Status",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "15%"
            },
            width: "40%"
        });

        $('#btnStatusSubmit').click(function () {
            UpdateServiceStatus();
        });
        $("#btnStatusClose").click(function () {
            $(".status-window").data("kendoWindow").close();
        });


        $('#btnSearch').click(function () {
            ChangeDepartmentEvent();
        });

        $('#btnClear').click(function () {
            $('#DepartmentId').data("kendoDropDownList").value("");
            $('#ServiceId').data("kendoDropDownList").value("");
            $('#ServiceStatusId').data("kendoDropDownList").value("");
            $('#StartDate').data("kendoDatePicker").value("");
            $('#EndDate').data("kendoDatePicker").value("");
            $("#GridServiceRequest").data("kendoGrid").dataSource.read();
        });

    })

    function FilterDepartmentForServices() {
        return { DepartmentId: $('#DepartmentId').val() }
    }

    function FilterDepartment() {
        return { departmentId: $('#DepartmentId').val() }
    }

    function FilterSearchParameter() {
        return {
            DepartmentId: $('#DepartmentId').val(),
            ServiceId: $('#ServiceId').val(),
            ServiceStatusId: $('#ServiceStatusId').val(),
            StartDate: $('#StartDate').val(),
            EndDate: $('#EndDate').val()
        };
    }
    function ChangeDepartmentEvent() {
        $('#ServiceId').data("kendoDropDownList").dataSource.read();
        $("#GridServiceRequest").data("kendoGrid").dataSource.read();
    }

    function RedirectForServices(serviceid, rid) {
        if (serviceid == 1) {
           // window.location.href = "/Property/PropertyRegistration/AddRentRequest" + "?id=" + rid;
        }
        if (serviceid == 2) {
            window.location.href = "/Property/PropertyRegistration/AddRentRequest" + "?id=" + rid;
        }
        if (serviceid == 3) {

        }
    }

    function OpenStatusWindow(row) {
        var tr = $(row).parent().parent();
        var id = $(tr).children("td:eq(0)").text();
        $('#RequestId').val(id);
        $('#divStatusMaster').data("kendoWindow").center();
        $('#divStatusMaster').data("kendoWindow").open();
    }

    function UpdateServiceStatus() {
        var model = {
            Id: $('#RequestId').val(),
            StatusId: $('#StatusId').val(),
            Comment: $('#Comment').val()
        };
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ model: model }),
            url: '/Member/ServiceRequest/UpdateCustomerServiceRequestStatus',
            success: function (result) {
                if (result == '@ReturnType.Updated') {
                    alertify.success("Data updated successfully.");
                }
                $("#GridServiceRequest").data("kendoGrid").dataSource.read();
                $('.status-window').data("kendoWindow").close();
            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                alertify.error("Something is wrong, try again later");
            }
        });
    }



    function OpenFile(row) {
        //$("#windowDiv").empty();
        var tr = $(row).parent().parent();
        var RequestId = $(tr).children("td:eq(4)").text();
        var RegistrationNo = $(tr).children("td:eq(5)").text();
        var Department = $(tr).children("td:eq(6)").text();
        var PropertyNo = $(tr).children("td:eq(7)").text();
        var ServiceName = $(tr).children("td:eq(8)").text();
        var CreatedDate = $(tr).children("td:eq(9)").text();
        var Applicant = $(tr).children("td:eq(12)").text();
        var MobileNo = $(tr).children("td:eq(13)").text();
        var SubDepartment = $(tr).children("td:eq(14)").text();
        var Description = $(tr).children("td:eq(15)").text();
        RegistrationNo = RegistrationNo != "" ? RegistrationNo : "NA";
        $('#CreatedDate').text(CreatedDate);
        $('#RequestId').text(RequestId);
        $('#RegistrationNo').text(RegistrationNo);
        $('#Name').text(Applicant);
        $('#PropertyNo').text(PropertyNo);
        $('#Department').text(Department);
        $('#SubDepartment').text(SubDepartment);
        $('#Mobile').text(MobileNo);
        $('#ServiceName').text(ServiceName);
        $('#Description').text(Description);

        $('.popup-window').data("kendoWindow").center();
        $('.popup-window').data("kendoWindow").open();
    }

    function PrintAcknowledgementReciept() {
        var contents = document.getElementById("AcknowledgementContent").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('<style>.row-btn{display:none;}</style>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }

