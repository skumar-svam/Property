@model NA.PMS.Model.ServiceViewModel
@using Kendo.Mvc.UI;
@using NA.PMS.Common;

@{
    ViewBag.Title = "Online Services";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .top-margin {
        margin-top: 6px;
        width: 80px;
    }

    .lbl-status-action {
        cursor: pointer;
        color: blue;
    }

    .glyphicon-print {
        cursor: pointer;
    }
    #divStatusMaster{
        display:none;
    }
    #AcknowledgementContent{
        display:none;
    }
</style>

<div class="ManageRequestServices">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Manage Online Requests</h1></div>
            <div class="col-md-6 col-sm-6 col-xs-12 col-btn">
                @*@Html.ActionLink("Request Service", "Index", new { controller = "ServiceRequest", area = "Member" }, htmlAttributes: new { target = "_blank" })*@
            </div>
        </div>
    </div>

    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12" style="border-left:1px solid #abc;border-right:1px solid #abc;">
        <div class="row form-group">
            <div class="col-md-2 pad-left">
                @Html.Label("Department")
                @(Html.Kendo().DropDownListFor(model => model.DepartmentId)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    //.DataSource(source => source.Read(read => read.Action("GetDepartmentList", "ServiceRequest")))
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetUsersDepartmentListAsDataSource", "ServiceRequest", new { area = "Member" })))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                    .Events(e => e.Change("ChangeDepartmentEvent"))
                   .HtmlAttributes(new { style = "width:95%;float:right;", @class = "input-disabled" })
                )
            </div>
            <div class="col-md-2 pad-left">
                @Html.Label("Start Date")
                @(Html.Kendo().DatePickerFor(model => model.StartDate).Events(e => e.Change("ChangeDepartmentEvent")).HtmlAttributes(new { style = "width:95%;float:right;" }))
            </div>
            <div class="col-md-2 pad-left">
                @Html.Label("End Date")
                @(Html.Kendo().DatePickerFor(model => model.EndDate).Events(e => e.Change("ChangeDepartmentEvent")).HtmlAttributes(new { style = "width:95%;float:right;" }))
            </div>
            <div class="col-md-2 pad-left">
                <label>Status</label>
                @(Html.Kendo().DropDownListFor(m => m.ServiceStatusId)
                    .Filter("contains")
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel(" -- Select --")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        .Transport(transport => transport.Read(read => read.Action("GetStatusMasterAsDataSource", "ServiceRequest", new { area = "Member" })))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                    .Events(events => { events.Change("ChangeDepartmentEvent"); })
                    .HtmlAttributes(new { @class = "input-disabled", style = "width:95%;float:right;" })
                )
            </div>
            <div class="col-md-2 pad-left">
                <label>Service Name</label>
                @(Html.Kendo().DropDownListFor(model => model.ServiceId)
                    .DataTextField("Text")
                    .DataValueField("Id")
                    .OptionLabel("---select---")
                    .DataSource(source =>
                    {
                        source.Custom()
                        .ServerFiltering(true)
                        .ServerPaging(true)
                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                        //.Transport(transport => transport.Read(read => read.Action("GetServiceListAsDataSource", "ServiceRequest", new { area = "Member" })))
                        .Transport(transport => transport.Read(read => read.Action("GetServicesByDepartmentAsDataSource", "ServiceRequest", new { area = "Member" }).Data("FilterDepartmentForServices")))
                        .Schema(schema => schema.Data("Data").Total("Total"))
                        .PageSize(100);
                    })
                    .HtmlAttributes(new { style = "width:95%;float:right;" })
                    .Events(e => e.Change("ChangeDepartmentEvent"))
                )
            </div>
            <div class="col-md-2" style="text-align:center;">
                <label style="width:100%;"> </label>
                <button type="button" id="btnSearch" class="k-button top-margin" value="Search">Search</button>
                <button type="button" id="btnClear" class="k-button top-margin" value="Clear">Clear</button>
            </div>
        </div>
    </div>
    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.Model.ServiceViewModel>()
                .Name("GridServiceRequest")
                .ToolBar(tools => tools.Excel())
                .Excel(excel => excel
                    .FileName("ServiceRequestList.xlsx")
                    .AllPages(true)
                    .Filterable(true)
                    .ProxyURL(Url.Action("Excel_Export_Save", "Report"))
                )
                .Columns(columns =>
                {
                    columns.Bound(c => c.EncryptedId).Hidden();
                    columns.Bound(c => c.DepartmentId).Hidden();
                    columns.Bound(c => c.IsUploaded).Hidden();
                    columns.Bound(c => c.ServiceId).Hidden();
                    columns.Bound(c => c.RequestId).Title("Ref No").Width(100).ClientTemplate("<a href='" + "/Member/ServiceRequest/RequestDetail/#= Id #" + "' target='_blank'>#=Id#</a>");
                    columns.Bound(c => c.RegistrationNo).Title("RId").Width(120).ClientTemplate("<a target='_blank' href='/Property/PropertyAllotment/PropertyDetails/#=RegistrationNo#'>#=RegistrationNo#</a>").Sortable(false);//.ClientTemplate("<label class='hyperlinkcss' onclick='javascript:RedirectForServices(#=ServiceId#, #=RId#)'>#=RId#</label>");
                    columns.Bound(c => c.Department).Title("Department").Width(130).Sortable(false);
                    columns.Bound(c => c.PropertyNo).Title("Property").Width(110).Sortable(false);
                    //columns.Bound(c => c.Sector).Title("Sector").Width(110).Sortable(false);
                    //columns.Bound(c => c.Block).Title("Block").Width(110).Sortable(false);
                    //columns.Bound(c => c.PlotNo).Title("PlotNo").Width(110).Sortable(false);
                    columns.Bound(c => c.ServiceName).Title("Service Name");
                    columns.Bound(c => c.RequestDate).Title("Request Date").Width(140).Format("{0:dd/MM/yyyy}").Sortable(false);
                    columns.Bound(c => c.Status).Title("Status").Width(100).Sortable(false);
                    //columns.Bound(c => c.RId).Title("Action").ClientTemplate("<a href='" + "/Member/CitizenRequests/ViewRequestDetails/#= Id #" + "'>View</a>").Sortable(false).Filterable(false);
                    //columns.Bound(c => c.RId).Title("").ClientTemplate("<a href='" + "/Member/CitizenRequests/CitizenChallan?regId=#= EncryptedRId #" + "&refid=#=EncryptedId#" + "'>Create Challan</a>").Sortable(false).Filterable(false);
                    columns.Bound(c => c.RequestDate).Title("Print").ClientTemplate("<a  onclick='javascript:OpenFile(this);'><center><span class='glyphicon glyphicon-print'></span></center></a>").Width(100).Filterable(false).Sortable(false);
                    columns.Bound(c => c.Applicant).Hidden();
                    columns.Bound(c => c.MobileNo).Hidden();
                    columns.Bound(c => c.SubDepartment).Hidden();
                    columns.Bound(c => c.Description).Hidden();
                    columns.Bound(c => c.Approver).Title("Forwarded To").Sortable(false).Width(140);
                    columns.Bound(c => c.Status).Title("Letter").Width(120).ClientTemplate("#if(StatusId == 9 && IsUploaded==true){# <center><a onclick='javascript:ViewLetter(#=Id#,#=RegistrationNo#);'style='font-weight:bold;cursor:pointer;'>view</a></center> #}#");
                })
                .Sortable().Filterable().Resizable(resize => resize.Columns(true))
                .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                .ClientDetailTemplateId("template")
                .AutoBind(true)
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Model(model => model.Id(c => c.Id))
                    .ServerOperation(true)
                    .Read(read => read.Action("GetOnlineCustomerServiceRequestAsDataSource", "ServiceRequest", new { area = "Member" }).Data("FilterSearchParameter")).PageSize(10)
                    .Sort(s => s.Add(r => r.RequestDate).Descending())
                )
        )
    </div>

</div>

<div class="col-md-12 status-window" id="divStatusMaster" style="min-height:250px;background:url(/Content/Images/boxed-bg.jpg) repeat;">
    <div class="row form-group" style="padding-top:15px;">
        <div class="col-md-3">
            <label>Service Status</label>
        </div>
        <div class="col-md-6">
            @(Html.Kendo().DropDownListFor(model => model.StatusId)
                .Filter("contains")
                .DataTextField("Text")
                .DataValueField("Id")
                .OptionLabel(" -- Select --")
                .DataSource(source =>
                {
                    source.Custom()
                    .ServerFiltering(true)
                    .ServerPaging(true)
                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                    .Transport(transport => transport.Read(read => read.Action("GetStatusMasterAsDataSource", "ServiceRequest", new { area = "Member" })))
                    .Schema(schema => schema.Data("Data").Total("Total"))
                    .PageSize(100);
                })
                .Events(events => { events.Change("ChangeDepartmentEvent"); })
                .HtmlAttributes(new { @class = "input-disabled", style = "width:100%; float:right;" })
            )
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-3">
            <label>Comment</label>
        </div>
        <div class="col-md-9">
            @Html.TextAreaFor(model => model.Comment, htmlAttributes: new { @class = "k-textbox", style = "width:93%;height:70px;" })
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-3">
            @Html.HiddenFor(model => model.RequestId)
        </div>
        <div class="col-md-3">
            <input type="button" class="k-button" id="btnStatusSubmit" value="Submit" style="width:98%;" />
        </div>
        <div class="col-md-3" style="text-align:right;">
            <input type="button" class="k-button" id="btnStatusClose" value="Close" style="width:98%;" />
        </div>
    </div>
</div>

