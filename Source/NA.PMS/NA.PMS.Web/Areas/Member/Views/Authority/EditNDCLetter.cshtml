<script>
    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }

    $(document).ready(function () {
        var actionType = $('#ActionType').val();
        var rid = $('#RegistrationId').val();
        //$("#RegistrationId").data('kendoDropDownList').value(rid);
        if (actionType == "Hindi") {
            $('#rbtnHindi').attr('checked', true);
        }
        else if (actionType == "English") {
            $('#rbtnEnglish').attr('checked', true);
        }
        
        $('#LanguageType').val(actionType);

        $('#LeaserentpaidNo').hide();
        $('#ndcdate').hide();
        $('#IsPremiumPaid').val("Y");
        //$('#IsLeaseRentPaid').val("Y");

        $('#btn-generate-letter').click(function () {
            var radiobtnVal = $('input[name=LanguageType]:checked', '#div-language-type').val();
            var rid = $('#RegistrationId').val();
            var allottee = $('#Applicant').val();
            var property = $('#PropertyNo').val();
            var letterDate = $('#NDCDate').val();

            if (radiobtnVal == "" || radiobtnVal == null) {
                alertify.error("please Select a language.");
                return false;
            }
            else if (rid == "" || rid == null) {
                alertify.error("please Select RegistrationId.");
                return false;
            }
            else if (allottee == "" || allottee == null) {
                alertify.error("please enter Applicant Name.");
                return false;
            }
            else if (property == "" || property == null) {
                alertify.error("please enter Property.");
                return false;
            }
            else if (letterDate == "" || letterDate == null) {
                alertify.error("please enter Letter Date.");
                return false;
            }
            else {
                GenerateNDCLetter();
            }
        });

        $('#btnUpdate').click(function () {
            UpdateNDCLetterDetails();
        });

    });

    function UpdateNDCLetterDetails() {
        var radiobtnVal = $('input[name=LanguageType]:checked', '#div-language-type').val();
        var ndc = {
            Id: $('#Id').val(),
            RegistrationId: $('#RegistrationId').val(),
            DepartmentId: $('#DepartmentId').val(),
            Department: $('#Department').val(),
            Applicant: $('#Applicant').val(),
            Address: $('#Address').val(),
            //InstallmentPaidUpto: $('#InstallmentPaidUpto').val(),
            InstallmentDateInWord: $('#InstallmentDateInWord').val(),
            InstallmentInWord: $('#InstallmentInWord').val(),
            //InstallmentInterestPaidUpto: $('#InstallmentInterestPaidUpto').val(),
            InterestDateInWord: $('#InterestDateInWord').val(),
            InterestInWord: $('#InterestInWord').val(),
            //LeaseRentPaidUpto: $('#LeaseRentPaidUpto').val(),
            LeaseRentDateInWord: $('#LeaseRentDateInWord').val(),
            LeaseRentInWord: $('#LeaseRentInWord').val(),
            ChallanId: $('#ChallanId').val(),
            ChalanAmount: $('#ChalanAmount').val(),
            BankId: $('#BankId').val(),
            BankName: $('#BankId').val() == "" ? null : $('#BankId').data("kendoDropDownList").text(),
            Remarks: $('#Remarks').val(),
            Sector: $('#Sector').val(),
            Block: $('#Block').val(),
            PlotNo: $('#PlotNo').val(),
            NDCDate: $('#NDCDate').val(),
            LetterNo: $('#LetterNo').val(),
            OnlineReqNo: $('#OnlineReqNo').val(),
            ActionType: radiobtnVal
        };
        $.ajax({
            type: "post",
            dataType: "json",
            contentType: "application/json;charset=utf-8",
            data: JSON.stringify({ model: ndc }),
            url: '/Member/Authority/UpdateNDCLetterDetails',
            success: function (result) {
                if (result == '@ReturnType.Updated') {
                    alertify.success("Updated Successfully.");
                }
                else {
                    alertify.error("Network Error");
                }
            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                //alertify.error("Lease Rent doesn't exist for this Property, Please enter Lease Rent for this property.");
            }
        });
    }

    function GenerateNDCLetter() {
        var radiobtnVal = $('input[name=LanguageType]:checked', '#div-language-type').val();
        var ndc = {
            Id: $('#Id').val(),
            RegistrationId: $('#RegistrationId').val(),
            DepartmentId: $('#DepartmentId').val(),
            Department: $('#Department').val(),
            Applicant: $('#Applicant').val(),
            Address: $('#Address').val(),
            //InstallmentPaidUpto: $('#InstallmentPaidUpto').val(),
            InstallmentDateInWord: $('#InstallmentDateInWord').val(),
            InstallmentInWord: $('#InstallmentInWord').val(),
            //InstallmentInterestPaidUpto: $('#InstallmentInterestPaidUpto').val(),
            InterestDateInWord: $('#InterestDateInWord').val(),
            InterestInWord: $('#InterestInWord').val(),
            //LeaseRentPaidUpto: $('#LeaseRentPaidUpto').val(),
            LeaseRentDateInWord: $('#LeaseRentDateInWord').val(),
            LeaseRentInWord: $('#LeaseRentInWord').val(),
            ChallanId: $('#ChallanId').val(),
            ChalanAmount: $('#ChalanAmount').val(),
            BankId: $('#BankId').val(),
            BankName: $('#BankId').val() == "" ? null : $('#BankId').data("kendoDropDownList").text(),
            Remarks: $('#Remarks').val(),
            Sector: $('#Sector').val(),
            Block: $('#Block').val(),
            PlotNo: $('#PlotNo').val(),
            NDCDate: $('#NDCDate').val(),
            LetterNo: $('#LetterNo').val(),
            OnlineReqNo: $('#OnlineReqNo').val(),
            ActionType: radiobtnVal
        };
        $.ajax({
            type: "post",
            dataType: "json",
            contentType: "application/json;charset=utf-8",
            data: JSON.stringify({ model: ndc }),
            url: '/Reports/Report/GenerateNDCLetter',
            success: function (result) {
                if (result != null) {
                    $("#divLetterBody").html(result);
                    //$("#inputdata").before("<div id='divBarcode' class='font-barcode' style='text-align:center;'></div>");
                    //generateBarcode();
                    //$('#divBarcode').html($('#inputdata').html());
                    //$('#inputdata').css("display", "none");

                    $("#divLetterBodyModal").modal('show');
                    $('#barcode').kendoBarcode({
                        value: "10000013",
                        height: "50"
                    });
                }
                else {
                    alertify.error("Property doesn't exist for this Rid");
                }
            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                alertify.error("Lease Rent doesn't exist for this Property, Please enter Lease Rent for this property.");
            }
        });
    }

    function PrintNDCLetter() {
        var contents = document.getElementById("divLetterBody").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }
</script>

