            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintLetter" class="k-button" data-dismiss="modal" onclick="PrintNDCLetter();">Print</button>
                @*<input type="button" onclick="generateBarcode();" value="&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Generate the barcode&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;">*@
                @*<button type="button" id="downloadLetter" class="k-button">Download</button>*@
            </div>

        </div>
    </div>
