@model NA.PMS.Model.LitigationViewModel
@using Kendo.Mvc.UI;

@{
    ViewBag.Title = "Litigation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Litigation</h1></div>
            <div class="col-md-6 col-sm-6 col-xs-12 mandatory"></div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 content-top-spce">
        <div id="DivPropertyInformation" class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading">Legal Information</h2>
            <div class="form-bx">
                <div class="row">
                    @Html.HiddenFor(model => model.DepartmentId)
                </div>
                <div class="row">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Registration Id:", htmlAttributes: new { @class = "required" })
                        @(Html.Kendo().DropDownListFor(m => m.RegistrationId)
                                .Filter("contains")
                                .DataTextField("Text")
                                .DataValueField("Id")
                                .OptionLabel("---Select---")
                                .DataSource(source =>
                                {
                                    source.Custom()
                                    .ServerFiltering(true)
                                    .ServerPaging(true)
                                    .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                    .Transport(transport => transport.Read(read => read.Action("GetRegistrationIdListAsDataSource", "Authority", new { area = "Member" })))
                                    .Schema(schema => schema.Data("Data").Total("Total"))
                                    .PageSize(100);
                                })
                               .Events(events => { events.Change("GetAllotteeDetails"); })
                               .HtmlAttributes(new { @class = "ddl-rid", style = "width:92%; float:right;" })
                        )
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Department:", htmlAttributes: new { })
                        @Html.TextBoxFor(model => model.Department, htmlAttributes: new { @class = "form-control", @Readonly = "readonly", style = "width:92%;float:right;" })
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Property No:", htmlAttributes: new { @class = "" })
                        @Html.TextBoxFor(model => model.PropertyNo, htmlAttributes: new { @class = "form-control", @Readonly = "readonly", style = "width:92%;float:right;" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 col-sm-6 col-xs-12 form-group">
                        @Html.Label("Allottee:", htmlAttributes: new { @class = "" })
                        @Html.TextAreaFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", style = "width:95%;float:right;height:34px;" })
                    </div>
                    <div class="col-md-6 col-sm-6 col-xs-12 form-group">
                        @Html.Label("Correspond Address:", htmlAttributes: new { @class = "" })
                        @Html.TextAreaFor(model => model.Address, htmlAttributes: new { @class = "form-control", style = "width:95%;float:right;height:34px;" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Case No:", htmlAttributes: new { @class = "" })
                        @Html.TextBoxFor(model => model.CaseNo, htmlAttributes: new { @class = "form-control", @maxlength = "100", style = "width:92%;float:right;" })
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Case Filed Date:", htmlAttributes: new { @class = "" })
                        @Html.Kendo().DatePickerFor(model => model.CaseFiledDate).HtmlAttributes(new { @class = "form-control", @maxlength = "100", style = "width:92%;float:right;" })
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Civil Court:", htmlAttributes: new { @class = "" })
                       @Html.TextBoxFor(model => model.Court, htmlAttributes: new { @class = "form-control", @maxlength = "100", style = "width:92%;float:right;" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Parties:", htmlAttributes: new { @class = "" })
                        @Html.TextBoxFor(model => model.Party, htmlAttributes: new { @class = "form-control", @maxlength = "100", style = "width:92%;float:right;" })
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Description", htmlAttributes: new { @class = "" })
                        @Html.TextBoxFor(model => model.Description, htmlAttributes: new { @class = "form-control", @maxlength = "100", style = "width:92%;float:right;" })
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Advocate", htmlAttributes: new { @class = "" })
                        @Html.TextBoxFor(model => model.Advocate, htmlAttributes: new { @class = "form-control", @maxlength = "100", style = "width:92%;float:right;" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Advocate Details", htmlAttributes: new { @class = "" })
                        @Html.TextBoxFor(model => model.AdvocateDetail, htmlAttributes: new { @class = "form-control", @maxlength = "100", style = "width:92%;float:right;" })
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Stay Order", htmlAttributes: new { @class = "" })
                        @Html.TextBoxFor(model => model.StayOrder, htmlAttributes: new { @class = "form-control", @maxlength = "100", style = "width:92%;float:right;" })
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Case Status", htmlAttributes: new { @class = "" })
                        @Html.TextBoxFor(model => model.CaseFiledStatus, htmlAttributes: new { @class = "form-control", @maxlength = "100", style = "width:92%;float:right;" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Legal Date:", htmlAttributes: new { @class = "" })
                        @Html.Kendo().DatePickerFor(model => model.LegalDate).HtmlAttributes(new { @class = "form-control", @maxlength = "100", style = "width:92%;float:right;" })
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Narrative Eyes", htmlAttributes: new { @class = "" })
                        @Html.TextBoxFor(model => model.NarrativeEyes, htmlAttributes: new { @class = "form-control", @maxlength = "100", style = "width:92%;float:right;" })
                    </div>
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        @Html.Label("Remarks", htmlAttributes: new { @class = "" })
                        @Html.TextBoxFor(model => model.Remarks, htmlAttributes: new { @class = "form-control", @maxlength = "100", style = "width:92%;float:right;" })
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.Model.LitigationViewModel>()
            .Name("gridLitigation")
            .Columns(columns =>
            {
                columns.Bound(c => c.CaseNo).Title("Case No").Width(80);
                columns.Bound(c => c.Department).Title("Department").Width(80);
                columns.Bound(c => c.Description).Title("Description").Width(80);
                columns.Bound(c => c.Address).Title("Address").Width(80);
                columns.Bound(c => c.LegalDate).Title("Legal Date").Format("{0:dd/MM/yyyy}").Width(80);
                columns.Bound(c => c.Advocate).Title("Advocate").Width(80);
            })
            .Sortable()
            .Filterable()
            .Resizable(resize => resize.Columns(true))
            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
            .DataSource
            (
                dataSource => dataSource
                .Ajax()
                .Model(model => model.Id(p => p.Id))
                .ServerOperation(true)
                .Read(read => read.Action("GetLitigationDataList", "Property", new { area = "Customer" }))
                .PageSize(10)
            )
        )
    </div>

</div>


<script>
    $(document).ready(function () {
        $(".num-only").keydown(function (e) {
            // Allow: backspace, delete, tab, escape, enter and .
            if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110, 190]) !== -1 ||
                // Allow: Ctrl+A, Command+A
                (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
                // Allow: home, end, left, right, down, up
                (e.keyCode >= 35 && e.keyCode <= 40)) {
                // let it happen, don't do anything
                return;
            }
            // Ensure that it is a number and stop the keypress
            if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
                e.preventDefault();
            }
        });

        $('#RegistrationId').change(function () {
            var rid = $('#RegistrationId').val();
            if (rid == "" || rid.length != 8) {
                alertify.error("Please enter Registration id.");
                return false;
            }
            else {
                GetAllotteeDetails();
                //$("#gridGeneratedLetter").data("kendoGrid").dataSource.read();
                //$("#LetterId").data("kendoDropDownList").dataSource.read();
            }
        });

       
    });


    function GetAllotteeDetails() {
        var rid = $('#RegistrationId').val();
        if (rid != "") {
            $.ajax({
                type: "post",
                dataType: "json",
                contentType: "application/json;charset=utf-8",
                data: JSON.stringify({ rid: rid }),
                url: '@Url.Action("GetAllottedPropertyDetailByRegistrationId", "Authority", new { area="Member"})',
                success: function (result) {
                    if (result != null) {
                        $('#Applicant').val(result.Applicant);
                        $('#PropertyNo').val(result.PropertyNo);
                        $('#Address').val(result.CorresspondentAddress);
                        $('#DepartmentId').val(result.DepartmentId);
                        $('#Department').val(result.Department);
                        $('#MobileNo').val(result.MobileNo);
                        $('#CorrespondAddress').val(result.CorrespondAddress);

                        //$("#gridGeneratedLetter").data("kendoGrid").dataSource.read();
                        //$("#LetterId").data("kendoDropDownList").dataSource.read();
                    }
                    else {
                        alertify.error("There is some error, try again");
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Something is wrong, try again later.");
                }
            });
        }
    }
</script>