@model NA.PMS.Model.BankAccountManagementModel

@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
@{
    ViewBag.Title = "Citizen Challan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /*#divChallanGrid {
        display: none;
    }*/
</style>
<div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
    <div class="row">
        <div class="col-md-12">
            <div class="row rw-spce">
                <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Create Challan</h1></div>
                <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
            </div>
        </div>
        <div class="col-md-12 blnk-rw"></div>
        <div class="col-md-12 content-top-spce">
            <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">

                @Html.HiddenFor(m => m.RId, htmlAttributes: new { id = "hdnRid" })
                <h2 class="blck-heading">Applicant Details</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Registration Id", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @*@Html.TextBoxFor(m => m.RId, htmlAttributes: new {@class="form-control", @Readonly="Readonly" })*@
                            @*@(Html.Kendo().DropDownListFor(m => m.RId)
                                .Filter("contains")
                                .DataTextField("text")
                                .DataValueField("id")
                                .OptionLabel("Select")
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("GetRIDsForManageAccountDetails", "PropertyRegistration", new { area="Property"});
                                    });
                                })
                                .Enable(true)
                                .Events(events => { events.Change("RIdChange"); })
                                .HtmlAttributes(new { @class = "schemeForms", style = "width:100%" })
                                )*@
                            @(Html.Kendo().DropDownListFor(model => model.RId)
                            .DataTextField("text")
                            .DataValueField("id")
                            .OptionLabel("Select")
                            .Filter("contains")
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport =>
                                {
                                    transport.Read(read => read.Action("GetRIDsForManageAccountDetailsByDataSource", "PropertyRegistration", new { area = "Property" }));
                                }).Schema(schema =>
                                {
                                    schema.Data("Data")
                                    .Total("Total");
                                }).PageSize(100);
                            })
                                .HtmlAttributes(new { style = "width:100%;" })
                                .Events(m => m.Change("RIdChange"))
                            )
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Property No")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblPropNo">
                            @Html.TextBoxFor(m => m.PropertyNumber, htmlAttributes: new { @class = "form-control", @Readonly = "Readonly" })
                            @*@Html.DisplayFor(m => m.PropertyNumber)*@
                        </div>
                    </div>
                </div>

                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Allottee Name")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblApNa">
                            @Html.TextBoxFor(m => m.ApplicationName, htmlAttributes: new { @class = "form-control", @Readonly = "Readonly" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Department")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblDepttName">
                            @Html.TextBoxFor(m => m.DepttName, htmlAttributes: new { @class = "form-control", @Readonly = "Readonly" })

                            @Html.HiddenFor(m => m.DepttId)
                        </div>
                    </div>

                    <div class="row">

                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Gender")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblGender">
                            @Html.TextBoxFor(m => m.Gender, htmlAttributes: new { @class = "form-control", @Readonly = "Readonly" })

                        </div>

                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Father's/Husband's Name")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblReNa">
                            @Html.TextBoxFor(m => m.RelationName, htmlAttributes: new { @class = "form-control", @Readonly = "Readonly" })
                        </div>

                    </div>

                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Property Type")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblPropTy">
                            @Html.TextBoxFor(m => m.PropertyType, htmlAttributes: new { @class = "form-control", @Readonly = "Readonly" })
                        </div>

                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Area(sqmt)")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblArea">
                            @Html.TextBoxFor(m => m.Area, htmlAttributes: new { @class = "form-control", @Readonly = "Readonly" })
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Floor/Area Range")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblFloor">
                            @Html.TextBoxFor(m => m.Floor, htmlAttributes: new { @class = "form-control", @Readonly = "Readonly" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Reference No")
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.TextBoxFor(m => m.ReferenceNo, htmlAttributes: new { @class = "form-control", @Readonly = "Readonly" })
                        </div>
                        @*<div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblFloor">
                                @(Html.Kendo().DropDownListFor(m => m.ServiceRequestId)
                                .Filter("contains")
                                .DataTextField("text")
                                .DataValueField("id")
                                .OptionLabel("Select")
                                .CascadeFrom("DepttId")
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("GetServiceRequestsByDepartment", "CitizenRequests", new { area = "Member" }).Data("filterDepartment");
                                    });
                                })
                                .HtmlAttributes(new { @class = "schemeForms", style = "width:100%" })
                                )
                            </div>*@
                    </div>
                </div>

                <h2 class="blck-heading">Bank Information</h2>
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Bank Name", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(model => model.bankId)
                            .Name("bankId")
                            .DataTextField("text")
                            .DataValueField("id")
                            .OptionLabel("Select")
                            .Filter("contains")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetAllBanks", "PropertyRegistration", new { area = "Property" });
                                });
                            })
                                    //.Events(model => model.Change("CleanAccountNumber"))
                            .HtmlAttributes(new { style = "width: 100%", @class = "schemeForms" })
                            )
                            @Html.ValidationMessageFor(model => model.bankId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Branch Address", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(model => model.branchId)
                            .Name("branchId")
                            .DataTextField("text")
                            .DataValueField("id")
                            .OptionLabel("Select")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetAllBranchs", "PropertyRegistration", new { area = "Property" })
                                        .Data("filterBranches");
                                }).ServerFiltering(true);
                            })
                            .CascadeFrom("bankId")
                            .Events(model => model.Change("HideShowBranch"))
                            .HtmlAttributes(new { style = "width: 100%", @class = "schemeForms" })
                            )
                            @Html.ValidationMessageFor(model => model.branchId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Account Number", htmlAttributes: new { @id = "lblAccountddl", @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group" id="lblDdlAccountNumber">
                            @Html.TextBoxFor(m => m.DdlAccountNumber, new { @readonly = "readonly", @class = "form-control" })

                        </div>

                    </div>
                </div>

                <h2 class="blck-heading"> Add Charges</h2>
                <div class="form-bx">
                    @*<div class="row">
                            @Html.HiddenFor(m => m.Amount)
                        </div>*@
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Account Head", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(model => model.AccountHeadId)
                                    //.Name("AccountHeadId")
                            .DataTextField("text")
                            .DataValueField("id")
                            .OptionLabel("Select")
                            .Filter("contains")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetAllAccountHead", "PropertyRegistration", new { area = "Property" });
                                });
                            })

                            .HtmlAttributes(new { style = "width: 100%", @class = "schemeForms" })
                            )
                            @Html.ValidationMessageFor(model => model.AccountHeadId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Account Subhead", htmlAttributes: new { @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().DropDownListFor(model => model.AccountSubHeadId)
                                    //.Name("AccountSubHeadId")
                            .DataTextField("text")
                            .DataValueField("id")
                            .OptionLabel("Select")
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetAccountSubHead", "PropertyRegistration", new { area = "Property" })
                                        .Data("filterAccountSubHead");
                                }).ServerFiltering(true);
                            })
                                            .CascadeFrom("AccountHeadId")
                                    //.Events(model => model.Change("HideShowBranch").DataBound("onDataBound"))
                            .HtmlAttributes(new { style = "width: 100%", @class = "schemeForms" })
                            )
                            @Html.ValidationMessageFor(model => model.AccountSubHeadId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @Html.Label("Amount", htmlAttributes: new { @id = "lblAccountddl", @class = "required" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            @(Html.Kendo().NumericTextBoxFor(m => m.Amount)
                                  .Name("Amount")
                                  .Min(0)
                                  .Max(999999999999999999)
                                  .Spinners(false).Step(0)
                                  .Enable(true)
                                 .HtmlAttributes(new { style = "width: 100%", @maxlength = "18", @class = "k-label  textBoxValueRightAlign" })
                            )
                            @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">

                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                            <input type="button" id="btnAdd" value="Add" class="btn btn-add" />
                        </div>
                    </div>
                </div>

                <div class="k-grid-content" id="divChallanGrid">
                    @*@Html.HiddenFor(c => c.RId)*@
                    @(Html.Kendo().Grid<NA.PMS.Model.BankAccountManagementModel>()
                        .Name("gridChargeDetails")
                            .Columns(columns =>
                            {
                                columns.Bound(c => c.ChallanId).Hidden(true);
                                columns.Bound(c => c.RId).Hidden(true);
                                columns.Bound(c => c.AccountHeadName).Title("Account Head");
                                columns.Bound(c => c.AccountSubHeadName).Title("Account Sub Head");
                                columns.Bound(c => c.Amount).Title("Amount");
                                //columns.Bound(c => c.BankName).Title("Bank");
                                //columns.Bound(c => c.CreatedDate).Title("Date").Format("{0:dd-MMM-yyyy}");
                                columns.Bound(c => c.ChallanTransID).Title("Action").ClientTemplate("<a onclick='javascript:RemoveChallanDetails(this);'class='hyperlinkcss'>Remove</a>").Filterable(false).Sortable(false);
                                //columns.Bound(c => c.ChallanTransID).Title("Action").ClientTemplate("<a onclick='javascript:RemoveDetails(\"#=ChallanTransID#\");'class='hyperlinkcss'>Remove</a>").Filterable(false).Sortable(false);
                            })
                            .Sortable()
                            .Filterable()
                            .Resizable(resize => resize.Columns(true))

                            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                              .DataSource(dataSource => dataSource
                                                    .Ajax().Model(model => model.Id(c => c.ChallanTransID))
                                    .ServerOperation(true)
                                                    .Read(read => read.Action("GetGeneratedChallanDetails", "PropertyRegistration", new { area = "Property" }).Data("AdditionalInfo")).PageSize(5)
                            //.Read(read => read.Action("GetGeneratedChallanDetails", "PropertyRegistration").Data("AdditionalInfo")).PageSize(5)
                                    )
                    )
                </div>
                <div>
                    <div class="row">
                        @Html.HiddenFor(model => model.Amount, htmlAttributes: new { @id = "hdnAmmount" })
                        @Html.HiddenFor(model => model.AccountHeadId, htmlAttributes: new { @id = "hdnAccountHeadId" })
                        @Html.HiddenFor(model => model.AccountSubHeadId, htmlAttributes: new { @id = "hdnAccountSubHeadId" })
                    </div>
                </div>
            </div>

            <div class="box-button text-center">
                <input type="button" id="btnBack" value="Back" class="btn  btn-default" />
                <input type="button" value="Generate Challan" id="btnGenerateChallan" class="btn btn-default" />
            </div>
        </div>
    </div>
</div>


<div id="divPrintChallan" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 60%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Challan</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:400px;">
                <div id="divChallanBody"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintDiv();">Print</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {


    });


    function filterDepartment() {
        return { department: $("#DepttId").val() }
    }

    $("#btnBack").click(function () {
        window.location.href = '@Url.Action("ManageCitizenRequests", "CitizenRequests")';
    });
    function HideShowBranch() {
        var bankId = $('#bankId').val();
        var branchId = $('#branchId').val();
        if (bankId == '') {
            $("#DdlAccountNumber").val('');
            //alertify.error("Please select Bank Name");
            return false;
        }
        if (branchId == '') {
            $("#DdlAccountNumber").val('');
            //alertify.error("Please select Branch name");
            return false;
        }
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ bankId: bankId, branchId: branchId }),
            url: '/PropertyRegistration/GetAccountNumber',
            success: function (result) {
                $("#DdlAccountNumber").val(result)
            },
            error: function (objAjaxRequest, strError) {
                //var respText = objAjaxRequest.responseText;
                alertify.error("Some Error in saved database.");
            }

        });
    }

    function AdditionalInfo() {
        return {
            rid: $('#RId').val()
        }
    }

    $("#btnAdd").click(function () {

        var rId = $("#RId").val();

        var AccountHeadId = $("#AccountHeadId").val();
        var AccountSubHeadId = $("#AccountSubHeadId").val();
        var Amount = $("#Amount").val();

        $('#hdnAmmount').val(Amount);
        $('#hdnAccountHeadId').val(AccountHeadId);
        $('#hdnAccountSubHeadId').val(AccountSubHeadId);

        if (rId == "") {
            alertify.error("Please select RId.");
            return false;
        }
        if (AccountHeadId == "") {
            alertify.error("Please select Account Head.");
            return false;
        }
        if (AccountSubHeadId == "") {
            alertify.error("Please select Sub Account Head.");
            return false;
        }
        if (Amount == "") {
            alertify.error("Please enter  Amount.");
            return false;
        }

        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ rId: rId, AccountHeadId: AccountHeadId, AccountSubHeadId: AccountSubHeadId, Amount: Amount }),
            //url: '/PropertyRegistration/SaveCreateChallan',
            url: '@Url.Action("SaveCreateChallan", "PropertyRegistration", new { area="Property"})',
            success: function (result) {
                if (result == 0) {
                    $("#AccountHeadId").data("kendoDropDownList").value("");
                    $("#AccountSubHeadId").data("kendoDropDownList").value("");
                    $("#Amount").data("kendoNumericTextBox").value("");
                    $("#gridChargeDetails").data("kendoGrid").dataSource.read();
                    //alertify.success("Data saved successfully.");
                    return false;
                }
                if (result == 2) {
                    $("#AccountHeadId").data("kendoDropDownList").value("");
                    $("#AccountSubHeadId").data("kendoDropDownList").value("");
                    $("#Amount").data("kendoNumericTextBox").value("");
                    $("#gridChargeDetails").data("kendoGrid").dataSource.read();
                    alertify.success("Registration id is changed");
                }
                if (result == 3) {
                    alertify.error("Maximum 3 charges are allowed.");
                    return false;
                }
                else {
                    return true;
                }
            },
            error: function (objAjaxRequest, strError) {
                //var respText = objAjaxRequest.responseText;
                alertify.error("Some Error in adding data.");
            }

        });

    });


    function RemoveChallanDetails(row) {
        var tr = $(row).parent().parent();
        var challanid = $(tr).children("td:eq(0)").text();
        var rid = $(tr).children("td:eq(1)").text();
        var headname = $(tr).children("td:eq(2)").text();
        var subheadname = $(tr).children("td:eq(3)").text();
        var amount = $(tr).children("td:eq(4)").text();
        var removeNotification = confirm('Are you sure to remove this details?');
        if (removeNotification) {
            $.ajax({
                type: 'POST',
                data: { rid: rid, headName: headname, subHeadName: subheadname, amount: amount },
                url: '@(Url.Action("RemoveChallanChargeDetail", "PropertyRegistration", new { area="Property"}))',
                success: function (result) {
                    if (result == true) {
                        $('#gridChargeDetails').data('kendoGrid').dataSource.read();
                        $('#gridChargeDetails').data('kendoGrid').refresh();
                        alertify.success("Charges removed successfully.");
                    }
                    else {
                        alert("Charge Details not removed");
                        return false;
                    }
                }
            });
        }
        else {
            return false;
        }
    }

    $("#btnGenerateChallan").click(function () {
        DepttId = $("#DepttId").val();

        var rId = $("#RId").val();
        var bankId = $("#bankId").val();
        var branchId = $("#branchId").val();
        //var serviceId = $('#ServiceRequestId').val();
        var serviceId = $('#ReferenceNo').val();
        var DdlAccountNumber = $("#DdlAccountNumber").val();

        if (rId == "") {
            alertify.error("Please select RId.");
            return false;
        }
        if (serviceId == "") {
            alertify.error("Please select Service request.");
            return false;
        }

        var grid = $("#gridChargeDetails").data("kendoGrid");
        var totalRecords = grid.dataSource.total();
        if (totalRecords == 0) {
            alertify.error("Please enter atleast one record in Charge Details section.");
            return false;
        }
        else {
            var rid1 = $("tbody").children("tr:eq(0)").children("td:eq(1)").text();

            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ rId: rId, bankId: bankId, branchId: branchId, ddlAccountNumber: DdlAccountNumber, deptId: DepttId, serviceId: serviceId }),
                //url: '/DocParser/GeneratePaymentChallan',
                url: '@Url.Action("GenerateChallanByServices", "DocParser", new { area = "" })',
                success: function (result) {
                    alertify.success("Data saved successfully.");
                    $('#gridChargeDetails').data('kendoGrid').dataSource.read();
                    $('#gridChargeDetails').data('kendoGrid').refresh();
                    $("#divChallanBody").html(result);
                    //$("#divPrintChallan").modal('show');

                    window.location.href = '@Url.Action("ManageCitizenRequests", "CitizenRequests", new { area="Member"})';
                },
                error: function (objAjaxRequest, strError) {
                    //var respText = objAjaxRequest.responseText;
                    alertify.error("Some Error in save database.");
                }
            });
        }

    });

    $('#divPrintChallan').on('hidden.bs.modal', function () {
        ClearFieldValue();
        $("#AccountHeadId").data("kendoDropDownList").value("");
        $("#AccountSubHeadId").data("kendoDropDownList").value("");
        $("#Amount").data("kendoNumericTextBox").value("");
        $("#bankId").data("kendoDropDownList").value("");
        $("#ServiceRequestId").data("kendoDropDownList").value("");
        $("#gridChargeDetails").data('kendoGrid').dataSource.data([]);
    });

    function filterBranches() {
        return {
            bankId: $("#bankId").val()
        };
    }
    function filterAccountSubHead() {
        return {
            AccountHeadId: $("#AccountHeadId").val()
        };
    }
    function filterBankAccounts() {
        return {
            bankId: $("#bankId").val(),
            branchId: $("#branchId").val()
        };
    }

    function RIdChange() {
        var rId = $("#RId").val();
        if (rId == '') {
            //alertify.error("Please select an Registration Id");
            ClearFieldValue();
            //$('#divChallanGrid').hide();
            return false;
        }
        else {
            //var kid = $("tbody").children("tr:eq(0)").children("td:eq(1)").text();
            //alert(kid);
            //if (kid != "") {
            //    if (kid != rId) {
            //        alertify.error("Registration id should be same.");
            //        return false;
            //    }
            //}
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ rId: rId }),
                url: '/PropertyRegistration/GetFunctionalTransferDetailsByRID',
                success: function (result) {
                    if (result != null) {
                        $("#PropertyNumber").val(result.PropertyNumber);
                        //$("#lblScNa").html(result.SchemeName);
                        $("#DepttName").val(result.DepttName);
                        $("#ApplicationName").val(result.ApplicationName);
                        $("#Gender").val(result.Gender);
                        $("#RelationName").val(result.RelationName);
                        $("#PropertyType").val(result.PropertyType);
                        $("#Area").val(result.Area);
                        $("#Floor").val(result.Floor);

                        $("#DepttId").val(result.DepttId);

                        $("#gridChargeDetails").data("kendoGrid").dataSource.read();
                        $('#divChallanGrid').show();
                    }
                    else {

                        alertify.error("Some error occured. Please try again later.");
                    }
                },
                error: function (obj) {

                    alertify.error("Some error occured. Please try again later.");
                }
            });
        }

    }
    function ToJavaScriptDate(value) {
        var pattern = /Date\(([^)]+)\)/;
        var results = pattern.exec(value);
        if (results != null) {
            var dt = new Date(parseFloat(results[1]));
            return (dt.getMonth() + 1) + "/" + dt.getDate() + "/" + dt.getFullYear();
        }
    }
    function PrintDiv() {
        var contents = document.getElementById("divChallanBody").innerHTML;
        var frame1 = document.createElement('iframe');
        frame1.name = "frame1";
        frame1.style.position = "absolute";
        frame1.style.top = "-1000000px";
        document.body.appendChild(frame1);
        var frameDoc = frame1.contentWindow ? frame1.contentWindow : frame1.contentDocument.document ? frame1.contentDocument.document : frame1.contentDocument;
        frameDoc.document.open();
        frameDoc.document.write('<html><head><title></title>');
        frameDoc.document.write('</head><body>');
        frameDoc.document.write(contents);
        frameDoc.document.write('</body></html>');
        frameDoc.document.close();
        setTimeout(function () {
            window.frames["frame1"].focus();
            window.frames["frame1"].print();
            document.body.removeChild(frame1);
        }, 500);
        return false;
    }

