@using Kendo.Mvc.UI
@model NA.PMS.Model.GPAModel
@{
    ViewBag.Title = "GPA Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .margin-left {
        width:90%;
    }
</style>

<div class="ApplicationForm">
    <div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
        <div class="row">
            <div class="col-md-12">
                <div class="row rw-spce">
                    <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">GPA Report</h1></div>
                    <div class="col-md-6 col-sm-6 col-xs-12 mandatory"></div>
                </div>
            </div>
            <div class="col-md-12 blnk-rw"></div>
            <div class="col-md-12" style="border:solid #e2e3e4; border-width:0 1px 1px">
                <h2 class="blck-heading" style="margin-bottom:0;">Search</h2>
                <div class="search-form-bx">
                    <div class="row">
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group text-right">
                            @Html.Label("From Date", htmlAttributes: new { @class = "" })
                            @(Html.Kendo().DatePickerFor(m => m.FromSearch).HtmlAttributes(new { style = "width:90%", @class = "DisableKeyboardInput" }))
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group text-right">
                            @Html.Label("To Date", htmlAttributes: new { @class = "" })
                            @(Html.Kendo().DatePickerFor(m => m.ToSearch).HtmlAttributes(new { style = "width:90%", @class = "DisableKeyboardInput" }))
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group text-right">
                            @Html.Label("Department", htmlAttributes: new { @class = "" })
                            @(Html.Kendo().DropDownListFor(m => m.DepttId)
                                    .Filter("contains")
                                    .DataTextField("text")
                                    .DataValueField("id")
                                    .OptionLabel("Select")
                                    .DataSource(source =>
                                    {
                                        source.Read(read =>
                                        {
                                            read.Action("GetDepttsByUserId", "Report");
                                        });
                                    })
                                    .HtmlAttributes(new { @class = "schemeForms", style = "width:90%" })
                            )
                        </div>
                        <div class="col-md-3 col-sm-3 col-xs-12 form-group text-right">
                            @Html.Label("  ", htmlAttributes: new { style="width:100%"})
                            <input type="button" value="Search" id="btnGetData" class="btn btn-add" style="margin-right:30px;"/>
                        </div>
                    </div>
                </div>

            </div>
            <div class="col-md-12 blnk-rw"></div>
            <div class="k-grid-content">
                @(Html.Kendo().Grid<NA.PMS.Model.GPAModel>()
                    .Name("gridGPAReport")
                    .ToolBar(tools => tools.Pdf())
                    .Pdf(pdf => pdf
                        .AllPages()
                        .AvoidLinks()
                        .PaperSize("A4")
                        .Scale(0.8)
                        .Margin("2cm", "1cm", "1cm", "1cm")
                        .Landscape()
                        .RepeatHeaders()
                        .TemplateId("page-template")
                        .FileName("GPAReport.pdf")
                        .ProxyURL(Url.Action("Pdf_Export_Save", "Report"))
                    )
                    .Columns(columns =>
                    {
                        columns.Bound(c => c.RId).Title("Registration Id").Width(50).ClientTemplate("<a href='" + "/Property/PropertyRegistration/ViewGPA/" + "?RId=#= RId #&Type=#=GPAType#'" + ">#=RId#</a>");
                        columns.Bound(c => c.DepttName).Title("Department").Width(50);
                        columns.Bound(c => c.PropNo).Title("Property No").Width(50);
                        columns.Bound(c => c.EffectiveFrom).Title("Effective From").Width(50).Format("{0:dd/MM/yyyy}");
                        columns.Bound(c => c.EffectiveTo).Title("Effective To").Width(50).Format("{0:dd/MM/yyyy}");
                    })
                    .Sortable()
                    .Filterable()
                    .Resizable(resize => resize.Columns(true))
                    .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))//.AutoBind(false)
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Model(model => model.Id(c => c.RId))
                        .ServerOperation(true)
                        .Read(read => read.Action("GetGPAReportData", "Report").Data("AdditionalData")).PageSize(20)
                    )
                )
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#btnGetData").click(function () {
            $("#gridGPAReport").data("kendoGrid").dataSource.read();
        });
    });

    function AdditionalData() {
        var fromSearch = $("#FromSearch").val();
        var toSearch = $("#ToSearch").val();
        var depttId = $("#DepttId").val();
        return {
            fromSearch: fromSearch, toSearch: toSearch, depttId: depttId
        };
    }
</script>
