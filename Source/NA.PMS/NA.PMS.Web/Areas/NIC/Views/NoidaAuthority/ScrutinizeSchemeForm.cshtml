<script type="text/javascript">
    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }

    $(document).ready(function () {
        $("#documenttable").hide();
        $('.row-reason').css("display", "none");
        $('#divDocumentView').kendoWindow({
            modal: true,
            title: "Document",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "15%"
            },
            width: "70%", height: "80%"
        });

        $('#div-remark-window').kendoWindow({
            modal: true,
            title: "Approval Window",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "25%"
            },
            width: "50%"
        });

        var formType = $('#ApplicationFormType').val();
        if (formType.trim() == "Expansion") {
            $('#divExpansionType').show();
        }
        else {
            $('#divExpansionType').css("display", "none");
            $('#divRentPermission').css("display", "none");
            $('.row-rent').css("display", "none");
            $('.col-rent').css("display", "none");
            $('#divExistingAllottee').css("display", "none");
        }

        var expansionType = $('#ExpansionType').val();
        if (expansionType.trim() == "Rent Permission") {
            $('#divRentPermission').show();
            $('.row-rent').show();
            $('.col-rent').show();
            $("input[type='radio'][name=ExpansionType][value='RentPermission']").attr("checked", true);
            $('#divExistingAllottee').css("display", "none");
        }
        if (expansionType == "ExistingAllottee") {
            $('#divRentPermission').css("display", "none");
            $('.row-rent').css("display", "none");
            $('.col-rent').css("display", "none");
            $("input[type='radio'][name=ExpansionType][value='ExistingAllottee']").attr("checked", true);
            $('#divExistingAllottee').show();
        }

        var radiobtnVal = $('#ApplicantType').val();
        if (radiobtnVal == "Company") {
            $('.lbl-permanent-address').text("Registered Office");
            $('.row-individual').css("display", "none");
            $('.row-company').show();
        }
        else if (radiobtnVal == "Individual") {
            $('.lbl-permanent-address').text("Permanent Address");
            $('.row-individual').show();
            $('.row-company').css("display", "none");
        }

        $("input[type='radio']").attr("disabled", "disabled");

        $('#btn-validate-form').click(function () {
            $("#div-remark-window").data("kendoWindow").center().open();
        });

        $('#btn-close-remark').click(function () {
            $("#div-remark-window").data("kendoWindow").close();
        });

        $("#btn-submit-remark").click(function () {
            var process = $('#ProcessDDL').val();
            var statusId = $('#StatusDDL').val();
            if (statusId != "0" && statusId != undefined) {
                if ($('#txt-area-remark').val().trim() != "" && $('#txt-area-remark').val().trim() != undefined) {
                    UpdateApplicationProcess(statusId);
                }
                else {
                    alertify.error("Please enter remarks.");
                }
            } else {
                $("#div-remark-window").data("kendoWindow").close();
                alertify.error("Please select status.");
            }
        });

        $('#StatusDDL').change(function () {
            if ($('#StatusDDL').val() == "1" || $('#StatusDDL').val() == "11") {
                $('.row-reason').css("display", "none");
            }
            else {
                $('.row-reason').show();
            }
        });

    });

    function FilterFormId() {
        return {
            formId: $("#ApplicationFormId").val()
        };
    }

    function FilterNicServiceCode() {
        return {
            FilterType: "NICReason",
            ReturnType: "SC22002" //$("input[name='SWPPostModel.TxtServiceID']").val()
        }
    }

    function OpenDocument(row) {
        $("#divDocumentView").empty();
        var tr = $(row).parent().parent();
        var link = $(tr).children("td:eq(1)").text();
        $("#divDocumentView").append($('<iframe src=' + link + ' style="width:100%;height:100%;overflow:hidden;"></iframe>'));
        $("#divDocumentView").data("kendoWindow").center();
        $("#divDocumentView").data("kendoWindow").open();
        $("#divDocumentView").data("kendoWindow").pin();
    }

    function UpdateApplicationProcess(statusId) {
        var remarks = $('#txt-area-remark').val().trim();
        var formId = $('#ApplicationFormId').val();
        var rezonid = $('#NICReasonId').val();
        var reazon = ($('#NICReasonId').val() != "" && $('#NICReasonId').val() != undefined) ? $('#NICReasonId').data("kendoDropDownList").text() : "";
        var flag = true;

        if (flag) {
            var amodel = {
                ProcessTypeId: null,
                FormStatusId: statusId,
                ApplicationIdList: formId,
                //ApproverId: userVal,
                ActionType: "Status",
                ProcessType: "Status",
                Message: remarks,
                NICReasonId: rezonid,
                NICReasonText: reazon
            }
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ model: amodel }),
                url: '/NIC/NoidaAuthority/SaveOnlineSchemeFormProcessRequest',
                success: function (result) {
                    $("#div-remark-window").data("kendoWindow").close();
                    if (result != null) {
                        alertify.success("Status updated successfully.");
                    }
                    $("#gridOnlineApplicationDetail").data("kendoGrid").dataSource.read();
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    alertify.error("Network error, Please try again later.");
                }
            });
        }

    }
</script>

