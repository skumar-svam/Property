@model NA.PMS.NICServices.SWPFormViewModel
@using NA.PMS.NICServices

@{
    ViewBag.Title = "Online Scheme";
    //Layout = "~/Views/Shared/_LayoutNIC.cshtml";
    Layout = "~/Areas/NIC/Views/Shared/_Layout.cshtml";
}

<style type="text/css">
    .btn {
        padding: 4px 18px;
    }

    .gridTitle {
        margin-bottom: 5px;
    }

    .lbl-header-btn-nw:hover {
        cursor: pointer;
    }

    .lbl-header-btn-ex:hover {
        cursor: pointer;
    }

    .lbl-header-btn-nw {
        padding: 6px;
        background: #c0c0c0;
        /*background-image: linear-gradient(to button, #fff 0, #c0c0c0 100%) ;*/
    }

    .lbl-header-btn-ex {
        padding: 6px;
        background: #f0ad4e;
        /*background: green;*/
    }

    .form-group label {
        padding-left: 10px;
        padding-right: 10px;
    }

    div.k-window-content {
        padding: 0;
    }
    .btn{border-radius:0 !important;}
</style>
@using (Html.BeginForm("IndustrialOpenEndForm", "NoidaAuthority", FormMethod.Post, new { enctype = "multipart/form-data", id = "OESform" }))
{
    <div class="scheme-dashboard" data-nic="forms">
        <div class="col-md-12 content-top-spce">
            <div class="inr-bx">
                <div class="form-bx">
                    <div>
                        @Html.HiddenFor(model => model.Id)
                        @Html.HiddenFor(model => model.ApplicationFormId)
                        @Html.HiddenFor(m => m.SchemeId)
                        @Html.HiddenFor(m => m.DepartmentId)
                        @Html.HiddenFor(m => m.AreaRange)
                        @Html.HiddenFor(m => m.SchemeType)
                        @Html.HiddenFor(m => m.ApplicationFormType)
                        @Html.HiddenFor(m => m.ApplicantType)
                        @Html.HiddenFor(m => m.FormType, htmlAttributes: new { @id = "hdnFormType" })
                        @Html.HiddenFor(m => m.AppType)
                        @Html.HiddenFor(m => m.NICApplicationId)
                        @Html.HiddenFor(m => m.NICControlId)
                        @Html.HiddenFor(m => m.NICServiceId)
                        @Html.HiddenFor(m => m.NICProcessIndustryId)
                        @Html.HiddenFor(m => m.NICUnitId)
                        @Html.HiddenFor(m => m.IsFromNIC)
                        @Html.HiddenFor(m => m.NICRequestId)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Annual_Turnover)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.ApplicationID)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Company_Name)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Control_ID)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.ControlID)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Expected_date_construction)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Expected_date_production)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Fee_Amount)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Fee_Status)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Industry_Address)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Industry_District)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Industry_District_Id)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Industry_Type_ID)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Industry_Type_Name)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Installed_Capacity)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Occupier_Name)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Occupier_PAN)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Occupier_Pin_Code)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Occupier_Mobile_No)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Occupier_Email_ID)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Occupier_Address)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Occupier_DOB)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Occupier_District_ID)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.OnlineApplicationId)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Unit_Id)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Nature_of_Activity)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Employees)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Project_Cost)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Nature_of_Operation)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Organization_Type_ID)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Organization_Type)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Unit_Category)
                        @Html.HiddenFor(m => m.SWPApiXMLData.Table.Items_Manufactured)
                    </div>
                    <div class="row" style="display:none;">
                        <div class="col-md-12 jumbotron" style="text-align:center;">
                            <h1 style="text-transform:uppercase">!No live shceme</h1>
                        </div>
                    </div>
                    @{
                        var todate = DateTime.Now;
                        var endate = Convert.ToDateTime("2021-02-22");
                        if (endate >= todate)
                        {
                            <div class="row" style="margin-top:20px;">
                                <div class="col-md-12 col-sm-12 col-xs-12 form-group" style="text-align:center">
                                    <h4 style="background:#008069;color:#fff;padding:6px 0;">Open Ended Scheme : NOIDA/IP/2020-21/OES/01</h4>
                                </div>
                                <div class="col-md-12 col-sm-12 col-xs-12 form-group" style="text-align:center;">
                                    <label class="lbl-header-btn-nw"> <input type="radio" group="OEUserGroup" class="" name="OERegisteredUser" value="OEUnRegistered" /> <b> New Application Form</b></label>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-md-12 jumbotron" style="text-align:center;">
                                    <h1 style="text-transform:uppercase">!No live shceme</h1>
                                </div>
                            </div>
                        }
                    }
                   
                    <div class="row" style="display:none;">
                        <div class="col-md-12 col-sm-12 col-xs-12 form-group" style="text-align:center">
                            <h4 style="background:#008069;color:#fff;padding:6px 0;">Industrial Plot Scheme : NOIDA/IP/2019-20/03</h4>
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12 form-group" style="text-align:center;">
                            <label class="lbl-header-btn-nw"> <input type="radio" group="IPUserGroup" class="" name="IPRegisteredUser" value="IPUnRegistered" /> <b> New Application Form</b></label>
                            <label class="lbl-header-btn-ex"> <input type="radio" group="IPUserGroup" class="" name="IPRegisteredUser" value="IPRegistered" /><b> Existing Application Form</b></label>
                        </div>
                    </div>

                    <div class="row" style="display:none;">
                        <div class="col-md-12 col-sm-12 col-xs-12 form-group" style="text-align:center">
                            <h4 style="background:#008069;color:#fff;padding:6px 0;">Transport Scheme : NOIDA/TN/2019-20/02</h4>
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12 form-group" style="text-align:center;">
                            <label class="lbl-header-btn-nw"><input type="radio" group="TUserGroup" class="" name="TRegisteredUser" value="TUnRegistered" /><b> New Application Form</b></label>
                            <label class="lbl-header-btn-ex"> <input type="radio" group="TUserGroup" class="" name="TRegisteredUser" value="TRegistered" /><b> Existing Application Form</b></label>
                        </div>
                    </div>
                </div>
                <h2 class="blck-heading" style="margin-bottom:6px; background:#d8b1b1; color:#fff;display:none;">Terms and conditions for Allotment of Industrial Plot</h2>
                <div class="form-bx" style="display:none;">
                    @{Html.RenderPartial("_IndustrialSchemeInfo");}
                </div>
            </div>
        </div>
    </div>
}


<div class="col-md-12 div-popup-window" id="divLoginWindow">
    @{
        using (Html.BeginForm("SchemeLogin", "NoidaAuthority", new { area = "Online" }, FormMethod.Post, new { enctype = "multipart/form-data", id = "SchemeLoginform" }))
        {
            <div class="row" style="padding-top:25px;">
                <div class="col-md-4 col-sm-6 col-xs-12 form-group" style="">
                    <label><b>Username/Form Id:</b></label>
                </div>
                <div class="col-md-6 col-sm-6 col-xs-12 form-group">
                    <input type="text" class="k-textbox" id="UserName" name="UserName" maxlength="10" placeholder="Enter Your User Name/Form Id" style="width:100%" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 col-sm-6 col-xs-12 form-group" style="">
                    <label><b>Password:</b></label>
                </div>
                <div class="col-md-6 col-sm-6 col-xs-12 form-group">
                    <input type="password" class="k-textbox" id="Password" name="Password" maxlength=" 10" placeholder="Enter Your Password" style="width:100%" />
                </div>
            </div>
            <div class="row" style="">
                <div class="col-md-12 col-sm-12 col-xs-12 form-group text-center">
                    <input class="btn btn-success" type="submit" value="Login" id="btnSchemeLogin" style="box-shadow: 0 4px 8px 0 #a27e7e;"/>
                    <input class="btn btn-danger" type="button" value="Cancel" id="btnCancelLogin" style=" box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);"/>
                </div>
                <div class="col-md-12 col-sm-12 col-xs-12 form-group text-center">
                    <p class="message"><a href="#" id="ForgotPasswordWindow">Forgot Your Password?</a></p>
                </div>
            </div>
        }
    }
</div>


<div class="col-md-12 div-popup-window" id="divForgotPasswordWindow">
    <div class="row" style="padding-top:25px;">
        <div class="col-md-4 col-sm-6 col-xs-12 form-group" style="">
            <label><b>Username/Form Id:</b></label>
        </div>
        <div class="col-md-6 col-sm-6 col-xs-12 form-group">
            <input type="text" class="k-textbox" id="ApplicationFormId-FFP" name="ApplicationFormId-FFP" maxlength="10" placeholder="Enter Your User Name/Form Id" style="width:100%" />
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12 form-group" style="">
            <label><b>Mobile No.:</b></label>
        </div>
        <div class="col-md-6 col-sm-6 col-xs-12 form-group">
            <input type="text" class="k-textbox" id="MobileNumber" name="MobileNumber" maxlength="10" placeholder="Enter Your Mobile Number" style="width:100%" />
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12 form-group" style="">
            <label><b>Email Id:</b></label>
        </div>
        <div class="col-md-6 col-sm-6 col-xs-12 form-group">
            <input type="text" class="k-textbox" id="Email" name="Email" maxlength="40" placeholder="Enter Your Email" style="width:100%" />
        </div>
        <div class="col-md-12 col-sm-12 col-xs-12 form-group text-center">
            <input class="btn btn-success" type="submit" value="Submit" id="btnForgotPassword" style="box-shadow: 0 4px 8px 0 #a27e7e;" />
            <input class="btn btn-danger" type="button" value="Cancel" id="btnCancelForgotPassword" style="box-shadow: 0 4px 8px 0 #a27e7e;" />
        </div>
        <div class="col-md-12 col-sm-12 col-xs-12 form-group text-center">
            <p class="message"><a href="#" id="LoginWindow">Back to Login.</a></p>
        </div>
    </div>
</div>

<script type="text/javascript">
    @{
        if (TempData["PasswordMessage"] != null && TempData["PasswordMessage"] != "")
        {
            @:alertify.error('@TempData["PasswordMessage"]');
        }
            
        if (TempData["ErrorLoginMessage"] != null && TempData["ErrorLoginMessage"] != "")
        {
            @:alertify.error('@TempData["ErrorLoginMessage"]');
        }
    };

    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }

    var redirectType;
    $(document).ready(function () {
        $('input[name=TRegisteredUser]').prop('checked', false);
        $('input[name=OERegisteredUser]').prop('checked', false);
        $('input[name=IPRegisteredUser]').prop('checked', false);

        $('input:radio[name=OERegisteredUser]').on('click', function () {
            var radiobtnVal = $('input[name=OERegisteredUser]:checked').val();
            if (radiobtnVal == "OERegistered") {
                $("#SchemeType").val('@SWPSchemeType.OpenEnded');
                $("#divLoginWindow").data("kendoWindow").center();
                $("#divLoginWindow").data("kendoWindow").open();
                $("#divLoginWindow").data("kendoWindow").pin();
            }
            else if (radiobtnVal == "OEUnRegistered") {
                //alert("Open Ended Scheme has been closed on 31-Dec-2018");
                //var id = $('#ApplicationFormId').val();
                window.location.href = "/NIC/NoidaAuthority/IndustrialOpenEndForm?id=" + $('#ApplicationFormId').val() + "&controlid=" + $('#NICControlId').val() + "&unitid=" + $('#NICUnitId').val() + "&serviceid=" + $('#NICServiceId').val() + "&requestid=" + $('#NICRequestId').val()
            }
        });

        $('input:radio[name=TRegisteredUser]').on('click', function () {
            var radiobtnVal = $('input[name=TRegisteredUser]:checked').val();
            if (radiobtnVal == "TRegistered") {
                $("#SchemeType").val('@SWPSchemeType.Transport');
                $("#divLoginWindow").data("kendoWindow").center();
                $("#divLoginWindow").data("kendoWindow").open();
                $("#divLoginWindow").data("kendoWindow").pin();
            }
            else if (radiobtnVal == "TUnRegistered") {
                //alert("Scheme has been closed on 31-03-2018");
                window.location.href = '@Url.Action("TransportSchemeForm", "Application", new { area = "Online" })';
            }
        });

        $('input:radio[name=IPRegisteredUser]').on('click', function () {
            var radiobtnVal = $('input[name=IPRegisteredUser]:checked').val();
            if (radiobtnVal == "IPRegistered") {
                $("#SchemeType").val('@SWPSchemeType.IndustrialScheme');
                $("#divLoginWindow").data("kendoWindow").center();
                $("#divLoginWindow").data("kendoWindow").open();
                $("#divLoginWindow").data("kendoWindow").pin();
            }
            else if (radiobtnVal == "IPUnRegistered") {
                //alert("Scheme has been closed on 30-Nov-2018 : 5:00PM");
                @*window.location.href = '@Url.Action("IndustrialForm", "OnlineProperty", new { area = "NIC" })';*@
                //$.post("/NIC/OnlineProperty/IndustrialForm?id=" + $('#ApplicationFormId').val() + "&controlid=" + $('#NICControlId').val() + "&unitid=" + $('#NICUnitId').val() + "&serviceid=" + $('#NICServiceId').val());
                window.location.href = "/NIC/NoidaAuthority/IndustrialForm?id=" + $('#ApplicationFormId').val() + "&controlid=" + $('#NICControlId').val() + "&unitid=" + $('#NICUnitId').val() + "&serviceid=" + $('#NICServiceId').val() + "&requestid=" + $('#NICRequestId').val();
            }
        });

        $("#btnCancelLogin").click(function () {
            $('input[name=TRegisteredUser]:checked').prop('checked', false);
            $('input[name=OERegisteredUser]:checked').prop('checked', false);
            $("#divLoginWindow").data("kendoWindow").close();
        });

        $("#btnCancelForgotPassword").click(function () {
            $('input[name=TRegisteredUser]:checked').prop('checked', false);
            $('input[name=OERegisteredUser]:checked').prop('checked', false);
            $("#divForgotPasswordWindow").data("kendoWindow").close();
        });

        $("#btnForgotPassword").click(function () {

            var formId = $("#ApplicationFormId-FFP").val();
            var Email = $("#Email").val();
            var mobileNo = $("#MobileNumber").val();

            $.ajax({
                url: '@Url.Action("ForgotPasswordAction", "NoidaAuthority", new { area = "Online" })',
                type: 'POST',
                data: { ApplicationFormId: formId, Mobile: mobileNo, Email: Email },
                success: function (result) {
                    if (result.ReturnTypeId == '@SWPReturnTypeId.Exist') {
                        alertify.success("Password has been send to your registed mobile no and email both.");
                        $('#divForgotPasswordWindow').data("kendoWindow").close();
                    }
                    else if (result.ReturnTypeId == '@SWPReturnTypeId.Failure') {
                        alertify.error("Application is inactive.");
                    }
                    else if (result.ReturnTypeId == '@SWPReturnTypeId.UserNameNotExist') {
                        alertify.error("please enter valid credentials.");
                    }
                    else {
                        alertify.error("Please enter again.");
                        return false;
                    }
                }
            });
        });

        $("#ForgotPasswordWindow").click(function () {
            $("#divForgotPasswordWindow").data("kendoWindow").center();
            $("#divForgotPasswordWindow").data("kendoWindow").open();
            $("#divForgotPasswordWindow").data("kendoWindow").pin();
            $("#divLoginWindow").data("kendoWindow").close();
        });

        $("#LoginWindow").click(function () {
            $("#divLoginWindow").data("kendoWindow").center();
            $("#divLoginWindow").data("kendoWindow").open();
            $("#divLoginWindow").data("kendoWindow").pin();
            $("#divForgotPasswordWindow").data("kendoWindow").close();
        });

        $('.div-popup-window').kendoWindow({
            modal: true,
            title: "Login Form for Online Scheme",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "25%"
            },
            width: "50%", height: "40%"
        });

        //$('#divLoginWindow').kendoWindow({
        //    modal: true,
        //    title: "Login Form for Online Scheme",
        //    visible: false,
        //    position: {
        //        top: 60, // or "100px"
        //        left: "25%"
        //    },
        //    width: "50%", height: "35%"
        //});


        //$('#divForgotPasswordWindow').kendoWindow({
        //    modal: true,
        //    title: "Forgot Password Form for Online Scheme",
        //    visible: false,
        //    position: {
        //        top: 60, // or "100px"
        //        left: "25%"
        //    },
        //    width: "50%", height: "40%"
        //});
    });

</script>

