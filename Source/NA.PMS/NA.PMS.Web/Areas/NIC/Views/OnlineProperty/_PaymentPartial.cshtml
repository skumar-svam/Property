@model NA.PMS.Model.OnlineFormViewModel
@using NA.PMS.Common
@using Kendo.Mvc.UI

<style type="text/css">
    .font-16-bold {
        font-weight: bold;
        font-size: 16px;
        padding-top: 4px;
    }

    .bank-logo {
        height: 15px;
    }

    .ml-28 {
        margin-left: -28px;
    }
    .rbtn-challan-update{
        display:none;
    }
    .lbl-bank-ref-no{
        display:none;
    }
    #PaymentModel_BankReferenceNo{
        display:none;
    }
</style>

<div class="hidden-fields">
    @Html.HiddenFor(model => model.ApplicationFormId)
    @Html.HiddenFor(model => model.SchemeId)
    @Html.HiddenFor(model => model.ChallanAccountNo)
    @Html.HiddenFor(model => model.ChallanBranchName)
    @Html.HiddenFor(model => model.ChallanBranchId)
    @Html.HiddenFor(model => model.BankIFSCCode)
    @Html.HiddenFor(model => model.VirtualAccPrefix)
    @Html.HiddenFor(model => model.VirtualAccountPrefix)
</div>

@*kendo Pop Up Choose Payment Option*@
<div class="col-md-12" id="divPaymentwindow" style="background: url(/Content/Images/boxed-bg.jpg) repeat;">
    <div class="row row-payment-mode">
        <div class="inr-bx" style="">
            <div class="form-bx">
                <div class="row" style="margin-top:25px;">
                    <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                        <label class="font-16-bold lbl-payment-mode">Payment mode :</label>
                    </div>
                    <div class="col-md-8 col-sm-8 col-xs-12 form-group ml-28" id="PaymentMode">
                        <label class="font-16-bold lbl-onl">@Html.RadioButtonFor(m => m.PaymentTypeId, "1", new { @class = "", @checked = true, @id = "PaymentOnline" }) Online</label>
                        <label class="font-16-bold lbl-off">@Html.RadioButtonFor(m => m.PaymentTypeId, "2", new { @class = "", @id = "PaymentOffline" }) Offline (RTGS/NEFT Challan)</label>
                        <label class="font-16-bold lbl-upd">@Html.RadioButtonFor(m => m.PaymentTypeId, "3", new { @class = "", @id = "rbtn-challan-update" }) Update Challan (If generated challan paid.)</label>
                        @*@{
                                //Only in case of transport scheme.
                                if (Model.SchemeType == OnlineSchemeType.Transport)
                                {
                                    <label class="font-16-bold">@Html.RadioButtonFor(m => m.PaymentTypeId, "3", new { @class = "", @id = "PreviousApplicant" }) For previous Applicant. (If form already submitted and refund not taken)</label>
                                }
                            }*@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12 form-group" id="OnlinePayment">
            <div class="inr-bx" style="">
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                            <label class="font-16-bold">Select Gateway :</label>
                        </div>
                        <div class="col-md-8 col-sm-8 col-xs-12 form-group">
                            @*<label class="ml-28">
                                <input type="radio" name="BankType" value="1" checked="checked" />
                                <img class="bank-logo" src="~/Content/Images/Payment/BankLogo/indus-1.png" />
                            </label>*@
                            <label class="ml-28">
                                <input type="radio" name="BankType" value="2" />
                                <img class="bank-logo" style="" src="~/Content/Images/Payment/BankLogo/hdfc.png" />
                            </label>
                            @*<label class="ml-28">
                                <input type="radio" name="BankType" value="4" />
                                <img class="bank-logo" style="" src="~/Content/Images/Payment/BankLogo/bank_of_baroda_logo.png" />
                            </label>*@
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12 form-group text-center">
                            <input type="button" class="btn btn-add" id="btn-online-payment" value="Submit" />
                            <input type="button" class="btn btn-default btn-close-payment-window" id="btn-cancel-payment" value="Cancel" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12 col-sm-12 col-xs-12 form-group" id="OfflinePayment">
            <div class="inr-bx" style="">
                <div class="form-bx">
                    <div class="row">
                        <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                            <label class="font-16-bold">Select Bank :</label>
                        </div>
                        <div class="col-md-8 col-sm-8 col-xs-12 form-group">
                            @foreach (var item in Model.BankModel)
                            {
                                <input type="radio" name="rtgs-challan" value="@item.Id" checked="checked" /><span class="">@item.Text</span>
                            }
                        </div>
                        <div class="col-md-12 col-sm-12 col-xs-12 form-group text-center">
                            <input type="button" class="btn btn-add" id="btn-create-challan" value="Generate Challan" />
                            <input type="button" class="btn btn-default btn-close-payment-window" id="btn-cancel-challan" value="Cancel" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12 col-sm-12 col-xs-12 form-group" id="div-challan-upload">
            <div class="inr-bx" style="">
                <div class="form-bx">
                    @using (Html.BeginForm("SubmitOfflinePayment", "Payment", new { area = "Online" }, FormMethod.Post, new { enctype = "multipart/form-data", id = "UploadChallanForm" }))
                    {
                        @Html.HiddenFor(model => model.PaymentModel.ApplicationFormId)
                        @Html.HiddenFor(model => model.AppType, new { @id="apptype-challan"})
                        @Html.HiddenFor(model => model.ActionType, new { @id = "action-type-challan" })
                        <div class="row">
                            <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                                @Html.Label("Transaction Id :", htmlAttributes: new { @class = "required font-16-bold" })
                            </div>
                            <div class="col-md-8 col-sm-8 col-xs-12 form-group">
                                @Html.TextBoxFor(m => m.PaymentModel.TransactionId, htmlAttributes: new { @maxlength = "15", @class = "k-textbox",style="width:100%;" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                                @Html.Label("Trans/Challan Date:", htmlAttributes: new { @class = "required font-16-bold" })
                            </div>
                            <div class="col-md-8 col-sm-8 col-xs-12 form-group">
                                @(Html.Kendo().DatePickerFor(model => model.PaymentModel.EntryDate)
                                    .HtmlAttributes(new { style = "width:100%", @class = "input-disabled" })
                                )
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                                @Html.Label("Challan Type:", htmlAttributes: new { @class = "required font-16-bold" })
                            </div>
                            <div class="col-md-8 col-sm-8 col-xs-12 form-group">
                                <label class="font-16-bold">@Html.RadioButtonFor(m => m.PayType, "RTGS", new { @class = "", @checked = true }) RTGS</label>
                                <label class="font-16-bold">@Html.RadioButtonFor(m => m.PayType, "Other", new { @class = "", @id = "" }) Other</label>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                                @Html.Label("Upload Challan:", htmlAttributes: new { @class = "required font-16-bold" })
                            </div>
                            <div class="col-md-8 col-sm-8 col-xs-12 form-group">
                                <input type='file' id='file-challan' name='challan' onchange='CheckFilePreChallanSize(this)' />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 col-sm-4 col-xs-12 form-group">
                                @Html.Label("UTR No:", htmlAttributes: new { @class = "required font-16-bold lbl-utr-no" })
                                @Html.Label("Bank Reference No:", htmlAttributes: new { @class = "required font-16-bold lbl-bank-ref-no" })
                            </div>
                            <div class="col-md-8 col-sm-8 col-xs-12 form-group">
                                @Html.TextBoxFor(m => m.PaymentModel.Udf1, htmlAttributes: new { @class = "k-textbox", style="width:100%" })
                                @Html.TextBoxFor(m => m.PaymentModel.BankReferenceNo, htmlAttributes: new { @class = "k-textbox", style = "width:100%" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 col-sm-12 col-xs-12 form-group text-center">
                                <input type="button" class="btn btn-add" id="btn-challan-upload" value="Upload Challan" />
                                <input type="button" class="btn btn-default btn-close-payment-window" id="btn-cancel-challan-upload" value="Cancel" />
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div id="divPrintChallan" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" style="padding-top:40px;">
    <div class="modal-dialog" style="width: 60%;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close close-challan-window" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title">  <b>Challan</b></h4>
            </div>
            <div class="modal-body" style="overflow:auto; height:400px;">
                <div id="divChallanBody"></div>
            </div>
            <div class="modal-footer" style="text-align: center;">
                <button type="submit" id="btnPrintDiv" class="k-button" data-dismiss="modal" onclick="PrintchallanDiv();">Print</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#OnlinePayment").show();
        $("#OfflinePayment").hide();
        $("#div-challan-upload").hide();

        $("input[type='radio'][name=BankType][value=3]").attr("disabled", "disabled");//ICICI
        $("input[type='radio'][name=rtgs-challan][value=48]").attr("disabled", "disabled");//ICICI
        $('#divPaymentwindow').kendoWindow({
            modal: true,
            title: "Online Payment",
            visible: false,
            position: {
                top: 60, // or "100px"
                left: "30%"
            },
            width: "50%", height: "45%"
        });

        $('#PaymentMode input:radio[name=PaymentTypeId]').on('change', function () {
            var formType = $('input[name=PaymentTypeId]:checked', '#PaymentMode').val();
            if (formType.trim() == "1") {
                $("#OnlinePayment").show();
                $("#OfflinePayment").hide();
                $("#div-challan-upload").hide();

            } else if (formType.trim() == "2") {
                $("#OnlinePayment").hide();
                $("#OfflinePayment").show();
                $("#div-challan-upload").hide();
            }
            else if (formType.trim() == "3") {
                $("#OnlinePayment").hide();
                $("#OfflinePayment").hide();
                $("#div-challan-upload").show();
            }
            else {
                alertify.success("Select payment Method.");
                return false;
            }
        });

        $('input:radio[name=PayType]').on('change', function () {
            var formType = $('input[name=PayType]:checked').val();
            if (formType.trim() == "RTGS") {
                $(".lbl-utr-no").show();
                $(".lbl-bank-ref-no").hide();
                $("#PaymentModel_Udf1").show();
                $("#PaymentModel_BankReferenceNo").hide();
            }
            else {
                $(".lbl-utr-no").hide();
                $(".lbl-bank-ref-no").show();
                $("#PaymentModel_Udf1").hide();
                $("#PaymentModel_BankReferenceNo").show();
            }
        });

        $('#btn-online-payment').click(function () {
            var BankType = $('input[name=BankType]:checked').val();
            if (BankType.trim() != "") {
                var formId = $("#ApplicationFormId").val();
                window.location.href = '@Url.Action("OnlineSchemePayment", "OnlineProperty", new { area = "NIC"})' + "/?id=" + formId + "&banktype=" + BankType;
            }
            else {
                alertify.success("Select Bank.");
                return false;
            }
        });

        //for updating challan after generated
        //if ($('#IsChallanGenerated').val() == true) {
        //    $('.lbl-payment-mode').text("Update Challan :");
        //    $("#PaymentOnline").hide();
        //    $("#PaymentOffline").hide();
        //    $('#rbtn-challan-update').show();
        //    $("#OnlinePayment").hide();
        //    $("#OfflinePayment").hide();
        //    $("#div-challan-upload").show();
        //}

        $(".btn-close-payment-window").click(function () {
            $("#divPaymentwindow").data("kendoWindow").close();
        });

        $(".close-challan-window").click(function () {
            //window.location.href = "/Online/Application/SchemeInformation";
            window.location.reload(true);
        });

        $("#btnPayment").click(function () {
            if ($('#IsChallanGenerated').val() == 'True') {
                $('input[name=PaymentTypeId][value=3]', '#PaymentMode').prop("checked", true);
                //$('.lbl-payment-mode').text("Update Challan :");
                $('#divPaymentwindow_wnd_title').text("Update Challan");
                $(".lbl-onl").css("display", "none");
                $(".lbl-off").css("display", "none");
                $('#rbtn-challan-update').show();
                $("#OnlinePayment").hide();
                $("#OfflinePayment").hide();
                $('.row-payment-mode').css("display", "none");
                $("#div-challan-upload").show();
            }

            var formId = $("#ApplicationFormId").val();
            var type = "Payment";
            ValidatePayment(formId, type);
        });


    });

    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1);
        if (ret == false)
            return false;
    }

    $("#btn-challan-upload").click(function () {
        bflag = true;
        var transactionId = $("#PaymentModel_TransactionId").val();
        var entryDate = $("#PaymentModel_EntryDate").val();
        var challanFile = $("#file-challan").val();
        var payType = $('input[name=PayType]:checked').val();
        if (transactionId == "") {
            alertify.error("Please enter transaction/challan Id.");
            return bflag = false;
        }
        else if (entryDate == "") {
            alertify.error("Please enter transaction/challan date.");
            return bflag = false;
        }
        else if (challanFile == '') {
            return alertify.error("Please upload challan/transaction reciept.");
        }
        else if (payType == 'RTGS' && $("#PaymentModel_Udf1").val().trim() == "") {
            alertify.error("Please enter UTR No.");
            return bflag = false;
        }
        else if (payType == 'Other' && $("#PaymentModel_BankReferenceNo").val().trim() == "") {
            alertify.error("Please enter Bank Reference No.");
            return bflag = false;
        }
        else {
            UpdateGeneratedChallan();
        }

        //$("#UploadPreChallanform").submit();
        bflag = true;
    });

    function UpdateGeneratedChallan() {
        $('#action-type-challan').val("UpdateChallan");
        $('#PaymentModel_ApplicationFormId').val($('#ApplicationFormId').val());
        var formData = new FormData($('#UploadChallanForm').get(0));
        $.ajax({
            url: '/NIC/OnlineProperty/UploadOnlineSchemeFormPaidChallan',
            type: 'POST',
            data: formData,
            processData: false,  // tell jQuery not to process the data
            contentType: false,  // tell jQuery not to set contentType
            success: function (result) {
                if (result != null && result.ReturnTypeId == '@ReturnType.Success') {
                    alertify.success(result.Message);
                }
                else if (result != null && result.ReturnTypeId == '@ReturnType.Mismatch') {
                    alertify.error(result.Message);
                }
                else if (result != null && result.ReturnTypeId == '@ReturnType.NotExist') {
                    alertify.error(result.Message);
                }
                $("#divPaymentwindow").data("kendoWindow").close();
                window.location.reload(true);
            }
        });
    }

