<div class="online-epass" style="margin-top:25px;margin-left:15%;margin-right:15%;">
    <div class="col-md-12">
        <div class="row" style="margin-top:6px;">
            <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Online E-Pass Form</h1></div>
            <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 content-top-spce">
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading" style="margin-bottom:6px;">
                Search e-pass
            </h2>
            <div class="form-bx">
                <div class="row" style="padding-top:20px;">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group ">
                        <label class="required">E-Pass No</label>
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group ">
                        <input id="EpassNo" type="text" class="form-control numeric" maxlength="20" onchange="CheckNumericDigits(this)" />
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                        <input type="hidden" id="hdn-mbl-no" />
                        <input type="hidden" id="hdn-email" />
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                        <input type="button" class="btn btn-default" id="btn-validate-epass" value="Search" />
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                        <input type="button" class="btn btn-default" id="btn-clear-epass" value="Clear" />
                    </div>
                </div>
                
                <div class="row" id="divotp">
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                        <label class="required">Enter OTP</label>
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                        <input type="text" class="k-textbox" id="text-otp" maxlength="10" placeholder="123" style="width:100%" />
                    </div>
                    <div class="col-md-2 col-sm-3 col-xs-12 form-group">
                        <input type="hidden" id="hdn-otp" />
                    </div>
                    <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                        <input type="button" class="btn btn-default" id="btn-validate-otp" value="Submit" />
                    </div>
                </div>
            </div>

            <div id="divPartialContent" class="form-bx" style="margin-top: 25px;background:#fff;">
                <div class="row" style="margin-left:12%;margin-right:12%;">
                    @{Html.RenderPartial("_PartialPrintEpass");}
                </div>
            </div>
            <div id="divbtnprint" style="margin-top: 20px;">
                <div class="row">
                    <div class="col-md-6 col-md-offset-3" style="text-align:center;">
                        <input id="btnprint" type="button" class="btn btn-default" value="Print" />
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>


