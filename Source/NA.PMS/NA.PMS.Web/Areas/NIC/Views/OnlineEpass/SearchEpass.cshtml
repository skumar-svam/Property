    function ValidateEpass() {
        var epass = $('#EpassNo').val();
        if (epass != "") {
            $.ajax({
                type: 'POST',
                dataType: 'json',
                data: { EpassNo: epass },
                url: '/NIC/OnlineEpass/GetEpassFormDetailById',
                success: function (result) {
                    if (result != null && result.StatusId == 1) {
                        $('#hdn-mbl-no').val(result.MobileNo);
                        $('#hdn-email').val(result.Email);

                        SendOTP()
                    }
                    else if (result != null && result.StatusId == 0) {
                        $('#divPartialContent').css("display", "none");
                        $('#btnprint').css("display", "none");
                        $('#divotp').css("display", "none");
                        alertify.error("E-Pass is not approved.");
                    }
                    else if (result != null && result.StatusId == 4) {
                        $('#divPartialContent').css("display", "none");
                        $('#btnprint').css("display", "none");
                        $('#divotp').css("display", "none");
                        alertify.error("E-Pass does not exist.");
                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    //alert(respText);
                }
            });
        }
        else {
            alertify.error("Please enter e-pass No");
        }
    }

    function SendOTP() {
        var mobile = $('#hdn-mbl-no').val();
        var mailId = $('#hdn-email').val();
        if (mobile != "") {
            $.ajax({
                type: 'POST',
                dataType: 'json',
                data: { mobileNo: mobile, email: mailId },
                url: '/NIC/OnlineEpass/SendOTP',  //GetEpassFormDetailById
                success: function (result) {
                    if (result != null) {
                        $('#hdn-otp').val(result);
                        $('#divotp').show();
                        alertify.success("OTP has been sent on your mobile and email id successfuly.");
                        return false;
                    }
                    else {

                    }
                },
                error: function (ajaxRequest, strError) {
                    var respText = ajaxRequest.responseText;
                    //alert(respText);
                }
            });
        }
        else {
            alertify.error("Please enter Mobile No");
        }
    }

    function ValidateOtpOnPage() {
        var otp_sent = $('#text-otp').val();
        var otp_return = $('#hdn-otp').val();
        if (otp_sent != "") {
            if (otp_sent == otp_return) {
                GetEpassUserDetail();
            }
            else {
                
                alertify.error("OTP mismatch");
            }
        }
    }

