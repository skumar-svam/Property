        status = $("#floorId").kendoValidator().data("kendoValidator").validate();
        status = $("#totalArea").kendoValidator().data("kendoValidator").validate();
        status = $("#actualArea").kendoValidator().data("kendoValidator").validate();
        status = $("#RegistryName").kendoValidator().data("kendoValidator").validate();
        status = $("#locationId").kendoValidator().data("kendoValidator").validate();
        status = $("#charges").kendoValidator().data("kendoValidator").validate();
        status = $("#PropertyCost").kendoValidator().data("kendoValidator").validate();
        status = $("#civilCost").kendoValidator().data("kendoValidator").validate();
        return status;
    }

</script>
