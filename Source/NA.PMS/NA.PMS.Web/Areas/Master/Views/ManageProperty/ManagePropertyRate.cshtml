<div class="col-md-12 k-grid-content">
    @(Html.Kendo().Grid<NA.PMS.Model.PropertyViewModel>()
            .Name("gridPropertyRateList")
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.Department).Title("Department");
                columns.Bound(c => c.SectorName).Title("Sector");
                columns.Bound(c => c.BlockName).Title("Block");
                columns.Bound(c => c.LandRate).Title("Rate (sqmt)");
                columns.Bound(c => c.AllotmentYear).Title("Allotment Year");
                columns.Bound(c => c.PropertyRateStartDate).Title("Start Date").Format("{0:dd-MMM-yyyy}");
                columns.Bound(c => c.PropertyRateEndDate).Title("End Date").Format("{0:dd-MMM-yyyy}");
                columns.Bound(c => c.IsActive).Title("Status").HeaderHtmlAttributes(new { style = "text-align:center;" }).HtmlAttributes(new { style = "text-align:center;" }).ClientTemplate("# if (IsActive == true) {#<label>Active</label>#}  else {#<span>InActive</span>#} #").Filterable(false);
                columns.Bound(c => c.Id).Title("Action").HeaderHtmlAttributes(new { style = "text-align:center;" }).HtmlAttributes(new { style = "text-align:center;" }).ClientTemplate("<a onclick='javascript:return RemoveCircleRate(#=Id#)' class='gridRemove hyperlinkcss'>Remove</a>").Filterable(false);
            })
            .Sortable().Filterable().Resizable(resize => resize.Columns(true))
            .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(new[] { 10, 50, 100, 500 }).Info(true).PreviousNext(true).Input(true).Numeric(true).ButtonCount(10))
            .ClientDetailTemplateId("template").AutoBind(true)
            .DataSource
            (
                dataSource => dataSource
                .Ajax().Model(model => model.Id(p => p.Id))
                .ServerOperation(true)
                .Read(read => read.Action("GetPropertyRateListAsDataSource", "ManageProperty", new { area = "Master" }).Data("FilterDepartmentId")).PageSize(10)
            )
    )
</div>

<script id="template" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<NA.PMS.Model.PropertyViewModel>()
            .Name("grid_#=Id#") // template expression, to be evaluated in the master context
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.SchemeName).Title("Scheme");
                columns.Bound(c => c.PropertyType).Title("Property Type");
                columns.Bound(c => c.AllotmentMethod).Title("Allotment Method");
                columns.Bound(c => c.AreaRange).Title("Area").Width(100);
                columns.Bound(c => c.AreaPhase).Title("Phase").Width(100);
                columns.Bound(c => c.PenalInterest).Title("PI").Width(50);
                columns.Bound(c => c.NormalInterest).Title("NI").Width(50);
                columns.Bound(c => c.AllotmentMoney).Title("Plot Premium").Width(120);              
                //columns.Bound(c => c.Id).Title("Status").Width(120).ClientTemplate("#if(IsPropertyAllotted==true){#<lable>Allotted</label>#}else{#<label>Not Allotted</label>#}#");
                //columns.Bound(c => c.AllotmentDate).Format("{0:dd/MM/yyyy}").Width(120);
            })
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(10)
                .Read(read => read.Action("GetPropertyRateListAsDataSource", "ManageProperty", new { area = "Master", Id = "#=Id#" }))
                //.Read(read => read.Action("GetMasterPropertyList", "ManageProperty", new { Id = "#=Id#" }))
            )
            .ToClientTemplate()
)
</script>
<script>
    function dataBound() {
        this.expandRow(this.tbody.find("tr.k-master-row").first());
    }
    $('.panel').on('hidden.bs.collapse', toggleIcon);
    $('.panel').on('shown.bs.collapse', toggleIcon);
    function toggleIcon(e) {
        $(e.target).prev('.panel-heading').find(".more-less").toggleClass('glyphicon-plus glyphicon-minus');
    }
</script>

<script type="text/javascript">

    $(document).ready(function () {
        $("#btn-clear").click(function () {
            ClearInputFields();
        });

        $("#btn-property-Rate").click(function () {
            SavePropertyRate();
        });
    });

    function ChangeInSchemeEvent() {
        var scheme = $('#SchemeId').data("kendoDropDownList").text();
        $('#SchemeName').val(scheme);
    }

    function SavePropertyRate() {
        if ($("#DepartmentId").val() == "") {
            alertify.error('Please select Department');
            return false;
        }
        else if ($("#LandRate").val() == "") {
            alertify.error('Please enter Rate value.');
            return false;
        }
        else if ($("#PropertyRateStartDate").val() == "") {
            alertify.error('Please enter Start Date.');
            return false;
        }
        else {
            var model = {
                DepartmentId: $("#DepartmentId").val(),
                SectorId: $("#SectorId").val(),
                BlockId: $("#BlockId").val(),
                PropertyTypeId: $("#PropertyTypeId").val(),
                LandRate: $("#LandRate").val(),
                PropertyRateStartDate: $("#PropertyRateStartDate").val(),
                PropertyRateEndDate: $("#PropertyRateEndDate").val(),
                SchemeId: $("#SchemeId").val(),
                SchemeName: $('#SchemeName').val(),
                AllotmentYear: $('#AllotmentYear').val(),
                AreaRange: $('#AreaRange').val(),
                AreaPhase: $('#AreaPhase').val(),
                NormalInterest: $('#NormalInterest').val(),
                PenalInterest: $('#PenalInterest').val(),
                AllotmentMethod: $('#AllotmentMethod').val(),
                AllotmentMoney: $('#AllotmentMoney').val(),
                SectorName: $('#SectorName').val(),
                TransferRateInPercent: $('#TransferRateInPercent').val(),
                TransferRateInINR: $('#TransferRateInINR').val(),
                Comment: $('#Comment').val()
            };
            //var formdata = new FormData($('form').get(0));
            $.ajax({
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ model: model }),
                dataType: 'json',
                type: 'Post',
                //contentType: false, // Not to set any content header
                //processData: false, // Not to process data
                //data: formdata,
                url: "/Master/ManageProperty/SavePropertyRateDetail",
                success: function (result) {
                    if (result == '@ReturnType.Saved') {
                        $('#gridPropertyRateList').data('kendoGrid').dataSource.read();
                        alertify.success("Property rate added successfully");
                        $("#btn-geneate-Rate").removeAttr('disabled');
                        ClearInputFields();
                    }
                    else if (result == '@ReturnType.Exist') {
                        $('#gridPropertyRateList').data('kendoGrid').dataSource.read();
                        alertify.error("Property rate already exist against Department and Sector.");
                    }
                    else if (result == '@ReturnType.None') {
                        alertify.error("Provider failed to save rate, try again.");
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Network error, try again later.");
                }
            });
        }
    }

    function RemoveCircleRate(id) {
        var flag = confirm('Are you sure to remove this property rate?');
        if (flag) {
            $.ajax({
                url: '/Master/ManageProperty/RemovePropertyRateDetailById',
                type: 'POST',
                data: { Id: id },
                success: function (result) {
                    if (result == true) {
                        $('#gridPropertyRateList').data('kendoGrid').dataSource.read();
                        alertify.success("Record deleted successfully.");
                    }
                    else {
                        alert("Notification not removed");
                        return false;
                    }
                }
            });
        }
        else {
            return false;
        }
    }

    function ChangeInDropdownFilter() {
        //$('#SchemeId').data('kendoDropDownList').dataSource.read();
        $('#DepartmentId').data('kendoDropDownList').dataSource.read();
        //$('#SectorId').data('kendoDropDownList').dataSource.read();
        $('#BlockId').data('kendoDropDownList').dataSource.read();
        $('#gridPropertyRateList').data('kendoGrid').dataSource.read();
    }

    function FilterSchemeParameter() {
        return {
            ActionType: "Scheme",
            DepartmentId: $('#DepartmentId').val()
        };
    }

    function FilterDepartmentId() {
        return { DepartmentId: $('#DepartmentId').val() };
    }

    function FilterDepartmentParameter() {
        return {
