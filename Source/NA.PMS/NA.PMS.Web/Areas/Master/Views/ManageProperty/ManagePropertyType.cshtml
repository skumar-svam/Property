@model NA.PMS.Model.PropertyViewModel
@using Kendo.Mvc.UI;
@using NA.PMS.Common;

@{
    ViewBag.Title = "Manage Property Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .padding-top{
        margin-top:25px;
        min-width:100px;
    }
</style>

<div class="col-md-12" id="ManagePropertyType">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Manage Property Type</h1></div>
            <div class="col-md-6 col-sm-6 col-xs-12 col-btn"></div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12">
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading" style="margin-bottom:10px;">Property Type</h2>
            <div class="form-bx">
                <div class="row" style="">
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        @Html.Label("Department")
                        @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                            .Filter("contains")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel(" -- Select --")
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => transport.Read(read => read.Action("GetMasterSearchParameterAsDataSource", "ManageProperty", new { area = "Master" }).Data("FilterDepartmentParameter")))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(100);
                            })
                            .Events(events => { events.Change("ChangeInDepartment"); })
                            .HtmlAttributes(new { @class = "input-disabled", style = "width:90%; float:right;" })
                        )
                    </div>

                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                        <label>Property Type</label>
                        @(Html.Kendo().DropDownListFor(model => model.PropertyTypeId)
                          .OptionLabel("---select---")
                          .DataTextField("Text")
                          .DataValueField("Id")
                          .CascadeFrom("DepartmentId")
                           //.Events(e => e.Change("GetPropertyTypeDetail"))
                          .DataSource(source => source.Read(read => read.Action("GetPropertyTypeByDepartment", "ManageProperty", new { area = "Master" }).Data("FilterDepartmentId")).ServerFiltering(true))
                          .HtmlAttributes(new { style = "width:90%; float:right;" })
                        )                       
                    </div>
                    <div class="col-md-3 col-sm-6 col-xs-12 form-group">
                       <label>New Property Type</label>
                        @Html.TextBoxFor(model => model.PropertyType, htmlAttributes: new { @class="form-control", style="width:90%; float:right;"})
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group" style="text-align:right">
                        <input type="button" class="k-button padding-top" value="Add" id="btn-add" />
                        <input type="button" class="k-button padding-top" value="Update" id="btn-update" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-12 k-grid-content">
        @(Html.Kendo().Grid<NA.PMS.Model.PropertyViewModel>()
            .Name("GridPropertyTypeList")
            .Columns(columns =>
            {
                columns.Bound(c => c.Id).Hidden(true);
                columns.Bound(c => c.Department).Title("Department").Width(140);
                columns.Bound(c => c.PropertyTypeId).Title("Id").Width(100);
                columns.Bound(c => c.PropertyType).Title("Property Type");
                columns.Bound(c => c.Status).Title("Status").Width(100).ClientTemplate("<label onclick='javascript:return ActivatePropertyType(#=Id#)' class='hyperlink'>#=Status#</label>").Filterable(false);
                columns.Bound(c => c.IsActive).Title("Action").Width(110).ClientTemplate("<a onclick='javascript:return RemovePropertyType(#=Id#)' class='gridRemove hyperlinkcss'>Remove</a>").Filterable(false);
            })
            .Sortable().Filterable()
            .Pageable(pageable => pageable.Enabled(true).PageSizes(true))
            .DataSource
            (
                dataSource => dataSource
                .Ajax().Model(model => model.Id(p => p.Id))
                .ServerOperation(true)
                .Read(read => read.Action("GetPropertyTypeList", "ManageProperty", new { area = "Master" }).Data("FilterDepartmentId")).PageSize(10)
            )
        )
    </div>
</div>

<script type="text/javascript">

    $(document).ready(function(){
        $("#btn-add").click(function () {
            var actionType = "Add";
            SavePropertyType(actionType);
        });

        $("#btn-update").click(function () {
            var actionType = "Update";          
            if ($("#PropertyTypeId").val() == "") {
                alertify.error('Please select Property type');
                return false;
            }
            else {
                SavePropertyType(actionType);
            }
        });
    });

    function SavePropertyType(actionType){
        if ($("#DepartmentId").val() == "") {
            alertify.error('Please select Department');
            return false;
        }
        else if ($("#PropertyType").val() == "") {
            alertify.error('Please enter property type name.');
            return false;
        }
        else{
            var model = {
                ActionType: actionType,
                DepartmentId: $("#DepartmentId").val(),
                PropertyType: $("#PropertyType").val()
            };
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ model: model  }),
                url: "/Master/ManageProperty/SavePropertyTypeByDepartment",
                success: function (result) {
                    if (result == '@ReturnType.Saved') {
                        $('#GridPropertyTypeList').data('kendoGrid').dataSource.read();
                        alertify.success("Property type added successfully");
                        $("#btn-add").removeAttr('disabled');
                    }
                    else if (data == '@ReturnType.Updated') {
                        $('#GridPropertyTypeList').data('kendoGrid').dataSource.read();
                        alertify.success("Property type updated successfully");
                        $("#btn-update").removeAttr('disabled');
                    }
                    else if (data == '@ReturnType.None') {
                        alertify.error("Provider failed to save data, try again.");
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Network error, try again later.");
                }
            });
        }
    }

    function RemovePropertyType(id) {
        var flag = confirm('Are you sure to remove this property rate?');
        if (flag) {
            $.ajax({
                url: '/Master/ManageProperty/ChangeStatusOfPropertyType',
                type: 'POST',
                data: { PropertyTypeId: id, ActionType: "Remove" },
                success: function (result) {
                    if (result == '@ReturnType.Removed') {
                        $('#GridPropertyTypeList').data('kendoGrid').dataSource.read();
                        alertify.success("Record removed successfully.");
                    }
                    else {
                        alert("Notification not removed");
                        return false;
                    }
                }
            });
        }
        else {
            return false;
        }
    }

    function ActivatePropertyType(id) {
        var flag = confirm('Are you sure to change its status?');
        if (flag) {
            $.ajax({
                url: '/Master/ManageProperty/ChangeStatusOfPropertyType',
                type: 'POST',
                data: { PropertyTypeId: id, ActionType: "ChangeStatus" },
                success: function (result) {
                    if (result == '@ReturnType.Updated') {
                        $('#GridPropertyTypeList').data('kendoGrid').dataSource.read();
                        alertify.success("Record updated successfully.");
                    }
                    else {
                        alert("Notification not removed");
                        return false;
                    }
                }
            });
        }
        else {
            return false;
        }
    }

    function ChangeInDepartment() {
        $('#GridPropertyTypeList').data('kendoGrid').dataSource.read();
    }

    function FilterDepartmentId() {
        return { DepartmentId: $('#DepartmentId').val() };
    }

    function FilterDepartmentParameter() {
        return {
            ActionType: "Department",
            DepartmentId: $('#DepartmentId').val()
        };
    }

</script>

