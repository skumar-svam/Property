@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@using NA.PMS.Common;

<div class="col-md-12 k-grid-content">
    @(Html.Kendo().Grid<NA.PMS.Model.LeaseRentViewModel>()
        .Name("GridNDCList")
        .Excel(excel => excel.AllPages(true).Filterable(true).FileName("NDCReport.xlsx"))
        .ToolBar(toolsExcel => toolsExcel.Excel())
        .Columns(columns =>
        {
            columns.Bound(c => c.Id).Title("Id").Width(50).Hidden(true);
            columns.Bound(c => c.RegistrationId).Title("Registration Id").ClientTemplate("<a href='" + "/Property/PropertyAllotment/PropertyDetails/#= RegistrationId #'>#= RegistrationId #</a>").Filterable(true);
            columns.Bound(c => c.Sector).Title("Sector");
            columns.Bound(c => c.Block).Title("Block");
            columns.Bound(c => c.PlotNo).Title("Plot No");
            columns.Bound(c => c.NDCDate).Title("NDC Date").Format("{0:dd-MMM-yyyy}");
            columns.Bound(c => c.NDCStatus).Title("Status");
        })
        .Sortable()
        .Filterable()
        .Resizable(resize => resize.Columns(true))
        .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
        .DataSource(dataSource => dataSource
                .Ajax()
                .Model(model => model.Id(p => p.Id))
                .ServerOperation(true)
                .Read(read => read.Action("GetMultiplePaymentStatusList", "Payment", new { area = "Revenue" }).Data("LeaseRent")).PageSize(10)
                //.Aggregates(aggregates => aggregates.Add(p => p.LeaseRentDues).Sum())
            )
    )
</div>

