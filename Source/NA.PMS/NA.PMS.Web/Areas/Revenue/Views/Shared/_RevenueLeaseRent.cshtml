<script>

    

    function GetRevenueWithDefaulters() {
        $.ajax({
            type: "post",
            dataType: "json",
            contentType: "application/json;charset=utf-8",
            data: JSON.stringify({ DepartmentId: $("#DepartmentId").val() }),
            url: '@Url.Action("GetRevenueWithDefaulterList", "Payment", new { area = "Revenue" })',
            success: function (result) {
                if (result != null) {
                    $('#totalrevenue').text(result.TotalPremium);
                    $('#totaldues').text(result.DuesAmount);
                    $('#totalareas').text(result.TotalArear);
                    $('#defaulterdues').text(result.DefaulterAmount);
                }
                else {
                    //alertify.error("Dues is not updated");
                    return false;
                }
            },
            error: function (ajaxRequest, strError) {
                //alert(ajaxRequest.responseText);
                alertify.error("Something is wrong, try again later");
            }
        });
    }
</script>