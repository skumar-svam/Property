<style>
    .advnce-srch-lbl {
        padding: 3px 0;
        display: block;
        width: 100%;
        font-size: 100%;
        color: #b2fff5;
    }

    .search-bx-home .k-dropdown-wrap .k-input {
        /*padding: 7px 10px !important;*/
    }

    .search-bx-home input[type="text"] {
        margin: 8px 0;
        padding: 7px;
        font-size: 100%;
        border: 2px solid #2da797;
        background: transparent;
        width: 100%;
        background: rgba(255,255,255,0.7);
        color: #333;
    }
    .adv-srch-bx-btn {
        background: #fff;
        padding: 10px 0;
        color: #333;
        text-align: center;
        border: 0;
        width: 100%;
        display: block;
        margin: 25px auto 10px;
        transition: background-color 0.5s ease;
    }

    .search-bx-home .k-widget.k-dropdown.k-header {
        width: 99% !important;
        border: 1px solid #299a8b;
        background: rgba(255,255,255,0.7);
        margin-top: 3px;
    }
   .k-textbox{
       float:right;
   }
   label{
       padding-left:15px;
   }
</style>


