<script>

    $('#btnAdvanceSearch').click(function () {
        var Rid = $('#RegistrationId').val();
        var dept = $('#DepartmentId').val();
        var sect = $('#Sector').val();
        var blok = $('#Block').val();
        var prpt = $('#PlotNo').val();
        //var addr = $('#Address').val();
        //var mName = $('#MotherName').val();
        //var mName = null;
        //var fName = $('#ApplicantMaster').val();
        //var name = $('#Applicant').val();
        //var mobile = $('#MobileNo').val();
        $('#FilterType').val("Accountant");
        if (Rid == "" &&  dept == "" && sect == "" && blok == "" && prpt == "" && mobile == "") {
            alertify.error("Please select at least one field");
        }
        //if (Rid != "") {
        //    ValidateFields();
        //}
        else {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ rid: Rid, department: dept, sector: sect, block: blok, plot: prpt, mobileNumber: null, name: null, fatherName: null, motherName: null, address: null }),
                //url: '@Url.Action("CheckDataForAdvanceSearch", "PropertyAllotment", new { area = "Property" })',
                url: '/Property/PropertyAllotment/CheckDataForAdvanceSearch',
                success: function (result) {
                    if (result == 'false' || result == 'False') {
                        alertify.error("There is no data regarding these fields");
                        return false;
                    }
                    else {
                        //window.location.href = "/Property/PropertyAllotment/AllotmentMaster?rid=" + Rid + "&department=" + dept + "&sector=" + sect + "&block=" + blok + "&plot=" + prpt + "&name=" + name + "&fatherName=" + fName + "&motherName=" + mName + "&mobileNumber=" + mobile + "&address=" + addr;
                        $('#searchform').submit(); //uncomment for search property payment detail
                    }
                },
                error: function (ajaxRequest, strError) {
                    //alert(ajaxRequest.responseText);
                    alertify.error("Something is wrong, try again later");
                }
            });
        }
    });

    function ValidateFields() {
        var rid = /^[0-9]+$/;
        var ridt = $('#RegistrationId').val();
        if (rid.test($('#RegistrationId').val())) {
            return true;
        }
        else {
            alertify.error("Registration id should be number");
            return false;
        }
    }

    $("#RegistrationId").keydown(function (e) {
        // Allow: backspace, delete, tab, escape, enter and .
        if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110]) !== -1 ||
            // Allow: Ctrl+A, Command+A
            (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
            // Allow: home, end, left, right, down, up
            (e.keyCode >= 35 && e.keyCode <= 40)) {
            // let it happen, don't do anything
            return;
        }
        // Ensure that it is a number and stop the keypress
        if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
            e.preventDefault();
        }
    });

</script>

