@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@model NA.PMS.Model.LeaseRentViewModel

@{
    ViewBag.Title = "Premium Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="ManagePremiumList">
    <div class="col-md-12">
        <div class="row rw-spce">
            <div class="col-md-6 col-sm-12 col-xs-12"><h1 class="gridTitle">Property Premium Report</h1></div>
            <div class="col-md-6 col-sm-12 col-xs-12 col-btn">
                @*<a href="/Revenue/Payment/LeaseRent" id="btnAddLeaseDeed" target="_blank"><i class="fa fa-plus"></i> <span> Add Lease Rent</span></a>*@
            </div>
        </div>
    </div>
    <div class="col-md-12 blnk-rw"></div>

    <div class="col-md-12 content-top-spce">
        <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
            <h2 class="blck-heading" style="margin-bottom:15px;">Search</h2>
            <div class="form-bx">
                <div class="row">
                    <div class="col-md-2 col-sm-2 col-xs-12 form-group">
                        <b>@Html.Label("Department")</b>
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(m => m.DepartmentId)
                            .Filter("contains")
                            .DataTextField("Text")
                            .DataValueField("Id")
                            .OptionLabel(" --- select ---")
                            .DataSource(source =>
                            {
                                source.Custom()
                                .ServerFiltering(true)
                                .ServerPaging(true)
                                .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                .Transport(transport => transport.Read(read => read.Action("GetDepartmentList", "Finance", new { area = "Revenue" })))
                                .Schema(schema => schema.Data("Data").Total("Total"))
                                .PageSize(6);
                            })
                            .Events(events => { events.Change("ChangeDeptEvent"); })
                            .HtmlAttributes(new { @class = "input-disabled", style = "width:100%" })
                        )
                    </div>
                </div>
            </div>

            <h2 class="blck-heading" style="margin-bottom: 0px;">Lease Rent Details</h2>
            <div class="k-grid-content">
                @(Html.Kendo().Grid<NA.PMS.Model.LeaseRentViewModel>()
                .Name("GridPremiumReport")
                .Columns(columns =>
                {
                    columns.Bound(c => c.Id).Hidden(true);
                    columns.Bound(c => c.RegistrationId).Title("Registration Id");
                    columns.Bound(c => c.Department).Title("Department");
                    columns.Bound(c => c.PropertyNo).Title("Property");
                    columns.Bound(c => c.LeaseRentPremium).Title("Lease Rent (<span class='fa fa-rupee'></span>)");
                    columns.Bound(c => c.RevisedDate).Title("Revise Date").Format("{0:dd-MMM-yyyy}");
                    columns.Bound(c => c.PremiumPaidStatus).Title("Premium Paid");
                    columns.Bound(c => c.IsLeaseRentPaid).Title("Lease Rent Paid");
                    columns.Bound(c => c.PaidUptoDate).Title("Paid Upto Date").Format("{0:dd-MMM-yyyy}");
                    columns.Bound(c => c.TotalBalance).Title("Total Balance (<span class='fa fa-rupee'></span>)").ClientFooterTemplate("<div><span class='fa fa-rupee'></span> #= sum #</div>");
                    columns.Bound(c => c.Id).Title("Edit").ClientTemplate("#if(IsActive==false){# <a href=\"/Revenue/Payment/LeaseRent/#= Id#\" id='e_#=Id#'><span class='glyphicon glyphicon-pencil'></span></a> #}else{# --- #}#").Filterable(false).Sortable(false).Width(50);
                    //columns.Bound(c => c.Id).Title("View").ClientTemplate("<a href=\"/Revenue/Finance/ViewLeaseDeedDetails/#= Id#\" id='e_#=Id#'><span class='glyphicon glyphicon-eye-open'></span></a>").Filterable(false).Sortable(false).Width(50);
                })
                .Sortable()
                .Filterable()
                .Resizable(resize => resize.Columns(true))
                .Pageable(pageable => pageable.Enabled(true).Refresh(true).PageSizes(true))
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Model(model => model.Id(p => p.Id))
                    .ServerOperation(true)
                    .Read(read => read.Action("GetPropertyPremiumReportDetails", "Finance", new { area = "Revenue" }).Data("LeaseRent")).PageSize(10)
                    .Aggregates(aggregates => aggregates.Add(p => p.TotalBalance).Sum())
                    )
                )
            </div>
        </div>
    </div>

</div>


<script type="text/javascript">
        function ChangeDeptEvent() {
            $("#GridLeaseRentReport").data("kendoGrid").dataSource.read();
        }

        function NDC() {
            var objNDC = { DepartmentId: $("#DepartmentId").val(), IsLeaseRentPaid: '@NA.PMS.Common.NDCOptions.Id_Yes' }
            return objNDC;
        }

        function LeaseRent() {
            var model = { DepartmentId: $("#DepartmentId").val(), PremiumPaidStatus: '@NA.PMS.Common.NDCOptions.Id_No' };
            return model;
        }
</script>
