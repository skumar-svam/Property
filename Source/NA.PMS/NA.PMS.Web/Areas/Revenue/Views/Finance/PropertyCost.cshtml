                                )
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Earnest Money", htmlAttributes: new { @class = "required" })
                                @(Html.Kendo().NumericTextBoxFor(m => m.EarnestMoney)
                                        .Min(0).Max(999999999)
                                        .Spinners(false).Step(0).Enable(true)
