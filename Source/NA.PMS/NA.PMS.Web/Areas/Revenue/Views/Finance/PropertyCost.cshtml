                                    .Spinners(false).Step(0).Enable(true)
                                    .HtmlAttributes(new { style = "width: 90%", @maxlength = "14", @class = "text-right" })
                                )
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Actual Area(sqm)", htmlAttributes: new { @class = "" })
                                @(Html.Kendo().NumericTextBoxFor(m => m.ActualArea)
                                    .Min(0).Max(99999999999999)
                                    .Spinners(false).Step(0).Enable(true)
                                    .HtmlAttributes(new { style = "width: 90%;", @maxlength = "14", @class = "text-right" })
                                )
                            </div>
                            
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                <label>Allotment Rate (sqm)</label>
                                @(Html.Kendo().NumericTextBoxFor(m => m.AllotmentRate)
                                    .Min(0).Max(99999999999999)
                                    .Spinners(false).Step(0).Enable(true)
                                    .Events(e=>e.Change("AllotmentRateChangeEvent"))
                                    //.Events(e => e.Change("CalculateTotalPropertyCost"))
                                    .HtmlAttributes(new { style = "width: 90%;", @maxlength = "14", @class = "text-right" })
                                )
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                <label>Allotment Money</label>
                                @(Html.Kendo().NumericTextBoxFor(m => m.AllotmentMoney)
