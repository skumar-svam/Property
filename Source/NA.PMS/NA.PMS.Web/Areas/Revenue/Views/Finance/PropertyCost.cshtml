@model NA.PMS.Model.PropertyViewModel
@using Kendo.Mvc.UI
@using NA.PMS.Common
@{
    ViewBag.Title = "Property Cost";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style type="text/css">
    .col-cost .form-control{
        width:90%;
        float:right;
    }
    .k-numerictextbox{
        float:right;
    }
</style>

@using (Html.BeginForm("SavePropertyDetail", "ManageProperty", FormMethod.Post, new { enctype = "multipart/form-data", id = "propertyform" }))
{
    @Html.AntiForgeryToken()
    <div class="col-lg-12 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-0">

        <div class="row">
            <div class="col-md-12">
                <div class="row rw-spce">
                    <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Allotted Property Cost</h1></div>
                    <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
                </div>
            </div>
            <div class="col-md-12 blnk-rw"></div>
            <div class="col-md-12 content-top-spce">
                <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
                    <h2 class="blck-heading">Property Cost Detail</h2>
                    <div class="form-bx">
                        <div style="text-align:center">
                            @Html.HiddenFor(model => model.PropertyId)
                            @Html.HiddenFor(model => model.DepartmentId)
                            @Html.HiddenFor(model => model.IsLocationCharged)
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Registration Id", htmlAttributes: new { @class = "required" })
                                @(Html.Kendo().DropDownListFor(m => m.RegistrationId)
                                    .Filter("contains")
                                    .DataTextField("Text")
                                    .DataValueField("Id")
                                    .OptionLabel("---Select---")
                                    .Enable(true)
                                    .AutoBind(true)
                                    .DataSource(source =>
                                    {
                                        source.Custom()
                                        .ServerFiltering(true)
                                        .ServerPaging(true)
                                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                        .Transport(transport => { transport.Read("GetRegistrationIdListAsDataSource", "Authority", new { area = "Member" }); })
                                        .Schema(schema => { schema.Data("Data").Total("Total"); })
                                        .PageSize(100);
                                    })
                                    .Events(events => { events.Change("RegistrationIdChangeEvent"); })
                                    .HtmlAttributes(new { @class = "col-custom", style = "width:90%; float:right;" })
                                )
                            </div>
                            
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Department", htmlAttributes: new { @class = "required" })
                                @Html.TextBoxFor(model => model.Department, htmlAttributes: new { @class="form-control" })
                            </div>
                            <div class="col-md-6 col-sm-6 col-xs-12 col-cost form-group">
                                @Html.Label("Allottee Name", htmlAttributes: new { @class = "required" })
                                @Html.TextBoxFor(model => model.Applicant, htmlAttributes: new { @class = "form-control", style="width:95%;float:right;" })
                            </div>
                            
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Sector", htmlAttributes: new { @class = "required" })
                                @Html.TextBoxFor(model => model.SectorName, htmlAttributes: new { @class = "form-control" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Block", htmlAttributes: new { @class = "required" })
                                @Html.TextBoxFor(model => model.BlockName, htmlAttributes: new { @class = "form-control" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Property/Plot No", htmlAttributes: new { @class = "required" })
                                @Html.TextBoxFor(m => m.PlotNo, new { @class = "form-control", @maxlength = "10", onkeypress = "return ValidateSpace(event);" })
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Floor/Area Range", new { @id = "lblFloor", @class = "required" })
                                @(Html.Kendo().DropDownListFor(m => m.FloorAreaId)
                                    .Filter("contains")
                                    .DataTextField("Text")
                                    .DataValueField("Id")
                                    .OptionLabel("---Select---")
                                    .DataSource(source =>
                                    {
                                        source.Custom()
                                        .ServerFiltering(true)
                                        .ServerPaging(true)
                                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                        .Transport(transport => { transport.Read(read => read.Action("GetFloorAreaListAsDataSource", "Finance", new { area = "Revenue" }).Data("FilterDepartmentId")); })
                                        .Schema(schema => { schema.Data("Data").Total("Total"); })
                                        .PageSize(100);
                                    })
                                    .HtmlAttributes(new { style = "width: 90%; float:right;" })
