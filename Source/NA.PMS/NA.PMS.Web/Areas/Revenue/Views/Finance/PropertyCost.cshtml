                                )
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Processing Fee", htmlAttributes: new { @class = "" })
                                @(Html.Kendo().NumericTextBoxFor(m => m.ProcessingFee)
                                        .Min(0).Max(999999999)
                                        .Spinners(false).Step(0).Enable(true)
                                        .HtmlAttributes(new { style = "width: 90%;", @maxlength = "16", @class = "text-right"})
                                )
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Property Cost", htmlAttributes: new { @class = "required" })
                                @(Html.Kendo().NumericTextBoxFor(m => m.PropertyCost)
                                    .Min(0).Max(99999999999999)
                                    .Spinners(false).Step(0).Enable(true)
                                    .HtmlAttributes(new { style = "width: 90%;", @maxlength = "14", @class = "text-right", @onchange="CalculateTotalPropertyCost()" })
                                )
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Civil Cost", htmlAttributes: new { @class = "" })
                                @(Html.Kendo().NumericTextBoxFor(m => m.CivilCost)
                                    .Min(0).Max(99999999999999)
                                    .Spinners(false).Step(0).Enable(true)
                                    .HtmlAttributes(new { style = "width: 90%;", @maxlength = "14", @class = "text-right", @onchange = "CalculateTotalPropertyCost()" })
                                )
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Lease Rent(%)", htmlAttributes: new { @class = "" })
                                @(Html.Kendo().NumericTextBoxFor(m => m.LeaseRent)
                                        .Min(0).Max(99)
                                        .Spinners(false).Step(0)
                                        .Enable(true)
                                        .HtmlAttributes(new { style = "width: 90%;", @maxlength = "16", @class = "text-right" })
                                        .Events(e => e.Change("LeaseRentChangeEvent"))
                                )
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Advance Lease Rent", htmlAttributes: new { @class = "" })
                                @(Html.Kendo().NumericTextBoxFor(m => m.AdvanceLeaseRent)
                                        .Min(0).Max(99999999999999)
                                        .Spinners(false).Step(0).Enable(true)
                                        .HtmlAttributes(new { style = "width: 90%;", @maxlength = "16", @class = "text-right" })
                                )
                            </div>
                        </div>
                                                 
                        <div class="row" id="div-location-detail">
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Location Type", htmlAttributes: new { @class = "" })
                                @(Html.Kendo().DropDownListFor(m => m.LocationId)
                                    .Filter("contains")
                                    .DataTextField("Text")
                                    .DataValueField("Id")
                                    .OptionLabel("---Select---")
                                    .DataSource(source =>
                                    {
                                        source.Custom()
                                        .ServerFiltering(true)
                                        .ServerPaging(true)
                                        .Type("aspnetmvc-ajax") //Set this type if you want to use DataSourceRequest and ToDataSourceResult instances.
                                        .Transport(transport => { transport.Read(read => read.Action("GetLocationTypeListAsDataSource", "Finance", new { area = "Revenue" }).Data("FilterDepartmentId")); })
                                        .Schema(schema => { schema.Data("Data").Total("Total"); })
                                        .PageSize(100);
                                    })
                                    .HtmlAttributes(new { style = "width:90%;float:right;" })
                                    .Events(e => e.Change("LocationTypeChangeEvent"))
                                )
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Location Charge(%)", htmlAttributes: new { @class = "" })
                                @(Html.Kendo().NumericTextBoxFor(m => m.LocationCharge)
                                    .Min(0).Max(99)
                                    .Spinners(false).Step(0).Enable(true)
                                    .HtmlAttributes(new { style = "width: 90%", @maxlength = "16", @class = "text-right", @onchange = "LocationTypeChangeEvent()" })
                                )
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Location Charge Rate(sqm)", htmlAttributes: new { @class = "" })
                                @(Html.Kendo().NumericTextBoxFor(m => m.LocationChargeRate)
                                    .Min(0).Max(999999999)
                                    .Spinners(false).Step(0).Enable(true)
                                    .HtmlAttributes(new { style = "width: 90%", @maxlength = "16", @class = "text-right" })
                                )
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Total Allotment Rate(sqm)", htmlAttributes: new { @class = "required" })
                                @(Html.Kendo().NumericTextBoxFor(m => m.TotalAllotmentRate)
                                    .Min(0).Max(99999999)
                                    .Spinners(false).Step(0).Enable(true)
                                    .HtmlAttributes(new { style = "width: 90%", @maxlength = "16", @class = "text-right" })
                                )
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                @Html.Label("Registry", htmlAttributes: new { @class = "required" })
                                @(Html.Kendo().DropDownListFor(m => m.RegistryType)
                                    .Filter("contains")
                                    .DataTextField("Text")
                                    .DataValueField("Text")
                                    .OptionLabel("---Select---")
                                    .DataSource(source => source.Read(read => read.Action("GetRegistryTypeList", "Finance", new { area = "Revenue" }).Data("FilterRegistryType")))
                                    .HtmlAttributes(new { style = "width: 90%;float:right;" })
                                )
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                <label>Total Property Cost (INR)</label>
                                @(Html.Kendo().NumericTextBoxFor(m => m.TotalPropertyCost)
                                    .Min(0).Max(99999999999999)
                                    .Spinners(false).Step(0).Enable(true)
                                    .HtmlAttributes(new { style = "width: 90%;", @maxlength = "14", @class = "text-right" })
                                )
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                <label>Balance Allotment Money</label>
                                @(Html.Kendo().NumericTextBoxFor(m => m.BalanceAllotmentMoney)
                                    .Min(0).Max(99999999999999)
                                    .Spinners(false).Step(0).Enable(true)
                                    .HtmlAttributes(new { style = "width: 90%;", @maxlength = "14", @class = "text-right" })
                                )
                            </div>
                            <div class="col-md-3 col-sm-3 col-xs-12 col-cost form-group">
                                <label>Total Balance Amount</label>
                                @(Html.Kendo().NumericTextBoxFor(m => m.BalanceAmount)
                                    .Min(0).Max(99999999999999)
                                    .Spinners(false).Step(0).Enable(true)
                                    .HtmlAttributes(new { style = "width: 90%;", @maxlength = "14", @class = "text-right" })
                                )
                            </div>
                        </div>
                    </div>
                </div>

                <div class="box-button text-center">
                    <input type="button" id="btnCancel" value="Cancel" class="btn btn-default" />
                    <input value="Update" type="button" id="btnSubmit" class="btn btn-add" />
                </div>
            </div>
        </div>
    </div>
}

<script type="text/javascript">
    $(document).ready(function () {
        $("#btnCancel").click(function () {
            @*window.location.href = '@Url.Action("Manage", "ManageProperty")';*@
        });

        TotalAreaChange();

        $('#btnSubmit').click(function () {
            //SubmitPropertyForm();
            SubmitPropertyCost();
        });
    });

    var spaceKeys = new Array();
    spaceKeys.push(8); //Backspace
    function ValidateSpace(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = (keyCode != 32);
        if (ret == false)
            return false;
    }

    var specialKeys = new Array();
    specialKeys.push(8); //Backspace
    function IsNumeric(e) {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = ((keyCode >= 48 && keyCode <= 57) || specialKeys.indexOf(keyCode) != -1 || keyCode == 46);
        if (ret == false)
            return false;
    }



    function FilterDepartmentId() {
        return {
            DepartmentId: $('#DepartmentId').val() == "" ? 1 : $('#DepartmentId').val()
        }
    }

    function FilterRegistryType() {
        return {
            category: "RegistryType"
        }
    }

