    function RegistrationIdChangeEvent() {
        if ($("#RegistrationId").val() != '') {
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ RegistrationId: $("#RegistrationId").val() }),
                url: '/Revenue/Finance/GetPropertyCostDetailAsPerScheme',
                success: function (result) {
                    if (result != null) {
                        $("#PropertyId").val(result.PropertyId);
                        $("#DepartmentId").val(result.DepartmentId);
                        $("#Department").val(result.Department);
                        $("#Applicant").val(result.Applicant);
                        $("#SectorName").val(result.SectorName);
                        $("#BlockName").val(result.BlockName);
                        $("#PlotNo").val(result.PlotNo);
                        $("#FloorAreaId").data("kendoDropDownList").value(result.FloorAreaId);
                        $("#PropertyNo").val(result.PropertyNo);
                        $("#PropertyType").val(result.PropertyType);
                        $("#TotalArea").data("kendoNumericTextBox").value(result.TotalArea);
                        $("#ActualArea").data("kendoNumericTextBox").value(result.ActualArea);
                        $("#CoveredArea").data("kendoNumericTextBox").value(result.CoveredArea);
                        $("#AllotmentRate").data("kendoNumericTextBox").value(result.LandRate);
                        $("#TotalAllotmentRate").data("kendoNumericTextBox").value(result.TotalAllotmentRate);
                        $("#PropertyCost").data("kendoNumericTextBox").value(result.PropertyCost);
                        $("#TotalPropertyCost").data("kendoNumericTextBox").value(result.TotalPropertyCost);
                        $("#CivilCost").data("kendoNumericTextBox").value(result.CivilCost);
                        $("#AllotmentMoney").data("kendoNumericTextBox").value(result.AllotmentMoney);
                        $("#EarnestMoney").data("kendoNumericTextBox").value(result.EarnestMoney);
                        $("#LocationId").data("kendoDropDownList").value(result.LocationId);
                        $("#LocationCharge").data("kendoNumericTextBox").value(result.LocationCharge);
                        $("#LocationChargeRate").data("kendoNumericTextBox").value(result.LocationChargeRate);
                        $("#LeaseRent").data("kendoNumericTextBox").value(result.LeaseRent);
                        $("#AdvanceLeaseRent").data("kendoNumericTextBox").value(result.AdvanceLeaseRent);
                        $("#RegistryType").data("kendoDropDownList").value(result.RegistryType);
                        if (result.DepartmentId == '@NADepartment.Housing') {
                            $("#CivilCost").data("kendoNumericTextBox").value(result.CivilCost);
                            $("#CivilCost").data("kendoNumericTextBox").enable(true);
                        }
                        else {
                            $("#CivilCost").data("kendoNumericTextBox").value('');
                            $("#CivilCost").data("kendoNumericTextBox").enable(false);
                        }
                        CalculateBalanceAmount();
                    }
                    else {
                        alertify.error("Network Error. Please try again later.");
                    }
                },
                error: function (obj) {
                    //ClearValues();
                    alertify.error("Some error occured. Please try again later.");
                }
            });
        }
        else {
            ClearInputFields();
        }
    }

    function SubmitPropertyCost() {
        if ($('#RegistrationId').val() != "") {
            var formData = new FormData($('form').get(0));
            $.ajax({
                dataType: 'json',
                type: 'Post',
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: formData,
                url: '/Revenue/Finance/SavePropertyCostAsPerScheme',
                success: function (result) {
                    if (result == '@ReturnType.Updated') {
                        alertify.success("Property cost updated successfully.");
                        ClearInputFields();
                    }
                    else if (result == '@ReturnType.Exist') {
                        alertify.error("Property already updated");
                    }
                    else {
                        return false;
                    }
                    //ClearFields();
                },
                error: function (ajaxRequest, strError) {
                    alertify.error("Network error, try again later");
                }
            });
        }
    }

    function AllotmentRateChangeEvent() {
        //CalculateTotalPropertyCost();
        TotalAreaChange();
        LocationTypeChangeEvent();
    }

    function CalculateBalanceAmount() {
        var allotmentMoney = $('#AllotmentMoney').val() == "" ? 0 : $('#AllotmentMoney').val();
        var earnestMoney = $('#EarnestMoney').val() == "" ? 0 : $('#EarnestMoney').val();
        var totalCost = $('#TotalPropertyCost').val() == "" ? 0 : $('#TotalPropertyCost').val();
        var balanceAllotment = Number(parseFloat(allotmentMoney).toFixed(2)) - Number(parseFloat(earnestMoney).toFixed(2));
        var balanceAmount = Number(parseFloat(totalCost).toFixed(2)) - Number(parseFloat(allotmentMoney).toFixed(2));
        $('#BalanceAllotmentMoney').data("kendoNumericTextBox").value(balanceAllotment);
        $('#BalanceAmount').data("kendoNumericTextBox").value(balanceAmount);
    }

    function CalculateTotalPropertyCost() {
        if ($('#DepartmentId').val() != "") {
            if ($('#DepartmentId').val() == '@NADepartment.Housing') {
                $('#CivilCost').data("kendoNumericTextBox").enable(true);
                $("#AllotmentRate").data("kendoNumericTextBox").value('');
                $("#TotalAllotmentRate").data("kendoNumericTextBox").value('');
                var propertycost = $('#PropertyCost').val();
                var civilcost = $('#CivilCost').val();
                propertycost = (isNaN(Math.round(parseFloat(propertycost).toFixed(2)))) ? 0 : (parseFloat(propertycost).toFixed(2))
                civilcost = (isNaN(Math.round(parseFloat(civilcost).toFixed(2)))) ? 0 : (parseFloat(civilcost).toFixed(2));

                var totalcost = Number(parseFloat(propertycost).toFixed(2)) + Number(parseFloat(civilcost).toFixed(2));
                totalcost = (isNaN(Math.round(parseFloat(totalcost).toFixed(2)))) ? '' : Math.round(parseFloat(totalcost).toFixed(2));
                $("#PropertyCost").data("kendoNumericTextBox").value(totalcost);
                $("#TotalPropertyCost").data("kendoNumericTextBox").value(totalcost);
            }
            else {
                $('#CivilCost').data("kendoNumericTextBox").value('');
                $('#CivilCost').data("kendoNumericTextBox").enable(false);
                var totalcost;
                var landrate = $("#AllotmentRate").val() == "" ? 0 : $("#AllotmentRate").val();
                var totalrate = $("#TotalAllotmentRate").val() == "" ? 0 : $("#TotalAllotmentRate").val();
                var totalarea = $("#TotalArea").val() == "" ? 0 : $("#TotalArea").val();
                landrate = (parseFloat(landrate).toFixed(2));
                if ($("#LocationId").val() != '') {                    
                    var chargepercent = $("#LocationCharge").val();
                    var charges = (parseFloat($("#LocationChargeRate").val()).toFixed(2));
                    var totalCharges = parseFloat(landrate) + parseFloat(charges);
                    $("#PropertyCost").data("kendoNumericTextBox").value(parseFloat(landrate * parseFloat(totalarea).toFixed(2)).toFixed(2));
                    totalcost = (isNaN(Math.round(parseFloat(totalCharges * parseFloat(totalarea).toFixed(2)).toFixed(2)))) ? '' : Math.round(parseFloat(totalCharges * parseFloat(totalarea).toFixed(2)).toFixed(2));
                }
                else {
                    totalcost = (isNaN(Math.round(parseFloat(landrate * parseFloat(totalarea).toFixed(2)).toFixed(2)))) ? '' : Math.round(parseFloat(landrate * parseFloat(totalarea).toFixed(2)).toFixed(2));
                }
                    
                $("#PropertyCost").data("kendoNumericTextBox").value(parseFloat(landrate * parseFloat(totalarea).toFixed(2)).toFixed(2));
                $("#TotalPropertyCost").data("kendoNumericTextBox").value(totalcost);
            }

            CalculateBalanceAmount();
        }
        else {

        }
    }

    function TotalAreaChange() {
        if ($("#DepartmentId").val() != '') {
            var dropdownlist = $("#FloorAreaId").data("kendoDropDownList");
            var totalArea = $("#TotalArea").val();
            if ($("#DepartmentId").val() != '@NADepartment.Housing') {
                var actualarea = $("#ActualArea").val();
                var coveredarea = $("#CoveredArea").val();
                if (dropdownlist.text().includes(">")) {
                    var areaRange = dropdownlist.text().split(">");
                    if (totalArea <= parseInt(areaRange[1].trim())) {
                        alertify.error("Enter Total Area greater than Area Range.");
                        $("#TotalArea").data("kendoNumericTextBox").value('');
                    }
                }
                else if (dropdownlist.text().includes("<")) { //Added on 27th Feb. 2017 for the following missing validation:
                    var areaRange = dropdownlist.text().split("<");
                    if (totalArea >= parseInt(areaRange[1].trim())) {
                        alertify.error("Please enter Total Area less than Area Range.");
                        $("#TotalArea").data("kendoNumericTextBox").value('');
                    }
                }
                else {   //New validatione ends here
                    var areaRange = dropdownlist.text().split("-");
                    if (totalArea < parseFloat(areaRange[0].trim()) || totalArea > parseFloat(areaRange[1].trim())) {
                        alertify.error("Please enter Total Area within Area Range.");
                        $("#TotalArea").data("kendoNumericTextBox").value('');
                    }
                }
            }
            CalculateTotalPropertyCost();
        }
        else {

        }
    }

    function LocationTypeChangeEvent() {
        var totalcost;
        var allotmentRate = $("#AllotmentRate").val() == "" ? 0 : $("#AllotmentRate").val();
        var totalAllotmentRate = $("#TotalAllotmentRate").val() == "" ? 0 : $("#TotalAllotmentRate").val();
        var totalArea = $("#TotalArea").val() == "" ? 0 : $("#TotalArea").val();
        if ($("#LocationId").val() != '') {
            allotmentRate = (parseFloat(allotmentRate).toFixed(2));
            var chargeInPercent = $("#LocationCharge").val() == "" ? 0 : $("#LocationCharge").val();
            var chargeRate = parseFloat(parseFloat(allotmentRate).toFixed(2) * parseFloat(chargeInPercent).toFixed(2) / 100).toFixed(2);
            
            var locationCharge = (parseFloat(chargeRate).toFixed(2));
            var totalCharges = Number(parseFloat(allotmentRate).toFixed(2)) + Number(parseFloat(locationCharge).toFixed(2));
            
            totalcost = (isNaN(Math.round(parseFloat(totalCharges * parseFloat(totalArea).toFixed(2)).toFixed(2)))) ? '' : Math.round(parseFloat(totalCharges * parseFloat(totalArea).toFixed(2)).toFixed(2));
            $("#LocationChargeRate").data("kendoNumericTextBox").value(chargeRate);
            $("#TotalAllotmentRate").data("kendoNumericTextBox").value(totalCharges);
        }
        else {
            totalcost = (isNaN(Math.round(parseFloat(allotmentRate * parseFloat(totalArea).toFixed(2)).toFixed(2)))) ? '' : Math.round(parseFloat(allotmentRate * parseFloat(totalArea).toFixed(2)).toFixed(2));
        }
            
        $("#TotalPropertyCost").data("kendoNumericTextBox").value(totalcost);
    }

    function LeaseRentChangeEvent() {
        var leaseRentPercent = $('#LeaseRent').val() == "" ? 0 : $('#LeaseRent').val();
        var totalCost = $('#TotalPropertyCost').val();
        var leaserent = parseFloat(parseFloat(totalCost).toFixed(2) * parseFloat(leaseRentPercent).toFixed(2) / 100).toFixed(2);
        $("#AdvanceLeaseRent").data("kendoNumericTextBox").value(leaserent);
    }


