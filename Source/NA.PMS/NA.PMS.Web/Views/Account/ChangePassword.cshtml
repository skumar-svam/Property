@model NA.PMS.Web.Models.PasswordModel
@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .k-textbox {
        width: 100%;
    }

    .red {
        color: red;
    }
</style>

@using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="col-lg-10 col-md-12 col-sm-12 col-md-offset-0s col-lg-offset-1">
        <div class="row">
            <div class="col-md-12">
                <div class="row rw-spce">
                    <div class="col-md-6 col-sm-6 col-xs-12"><h1 class="gridTitle">Change Password</h1></div>
                    <div class="col-md-6 col-sm-6 col-xs-12 mandatory">Fields marked with an asterisk (<span class="star">*</span>) are required.</div>
                </div>
            </div>
            <div class="col-md-12 blnk-rw"></div>
            <div class="col-md-12 content-top-spce">
                <div class="inr-bx" style="border:solid #e2e3e4; border-width:0 1px 1px">
                    <h2 class="blck-heading">Change Password</h2>
                    <div class="form-bx">
                        <div class="row">
                            <div class="col-md-3 col-sm-6 col-xs-12 col-md-offset-2 form-group">
                                @Html.HiddenFor(model=>model.HiddenVal)
                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12 form-group">
                                <label>@Html.ValidationMessageFor(model => model.PasswordMessage, "", new { @class = "red" })</label>
                                <label>@Html.ValidationMessageFor(model => model.PasswordSuccessMessage, "", new { style = "color:green" })</label>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 col-md-offset-2 form-group">
                                @Html.Label("Old password", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                                @Html.PasswordFor(model => model.OldPassword, new { @class = "k-textbox", maxlength = "50", minlength = "8" })
                                @Html.ValidationMessageFor(model => model.OldPassword, "", new { @class = "red" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 col-md-offset-2 form-group">
                                @Html.Label("New password", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                                @Html.PasswordFor(model => model.NewPassword, new { @class = "k-textbox", maxlength = "50", minlength = "8" })
                                @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "red" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 col-sm-3 col-xs-12 col-md-offset-2 form-group">
                                @Html.Label("Confirm new password", htmlAttributes: new { @class = "required" })
                            </div>
                            <div class="col-md-4 col-sm-3 col-xs-12 form-group">
                                @Html.PasswordFor(model => model.ConfirmNewPassword, new { @class = "k-textbox", maxlength = "50", minlength = "8" })
                                @Html.ValidationMessageFor(model => model.ConfirmNewPassword, "", new { @class = "red" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="box-button text-center">
                    <input type="reset" id="btnCancel" value="Reset" class="btn btn-default" />
                    <input type="submit" id="btnSubmit" value="Submit" class="btn btn-add" />
                </div>
            </div>
        </div>
    </div>

}






<script type="text/javascript">
    $(document).ready(function () {
        $("#HiddenVal").val(2);
    });
</script>