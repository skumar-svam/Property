@model NA.PMS.Model.Department
@using NA.PMS.Model;
@{
    int index = 1;
}
<tr>
    <td style="display: none">
        <input type="hidden" value="@index" name="Index">
    </td>
    <td style="width:20%">
        @{
            <input type="checkbox" value="DepartmentList[0].IsSelected.ToString().ToLower()" checked="checked" name="DepartmentList[0].IsSelected " id="departmentlist[0]__title">
        }
    </td>
    <td style="width:20%">
        @Model.departmentId
    </td>
    <td style="width:10%">
        <select value="@Model.departmentId" name="DepartmentList[0].ID" id="DepartmentList_[0]__Title"></select>
    </td>
    <td style="width:10%"><select value="@Model.departmentId" name="DepartmentList[0].ID" id="DepartmentList_[0]__Title"></select></td>
    <td style="width:10%"><select value="@Model.departmentId" name="DepartmentList[0].ID" id="DepartmentList_[0]__Title"></select></td>
    <td style="width:10%"><input type="text" value="" style="width:80%"/></td>
    <td style="width:10%"><input type="text" value="" style="width:50%" /></td>

    
</tr>

<script type="text/javascript">
        
    function fillDropdown() {
        var controlToBind = "#tableDepartment select[name='DepartmentList[" + 0 + "].ID']";
        var items = "";
        items += "<option value='" + 0 + "'>" + "Select" + "</option>";
        for (var i = .5; i < 100; i++) {
            items += "<option value='" + i + "'>" + i + "</option>";          
        }
        $(controlToBind).html(items);
    }

    $(document).ready(function () {
        fillDropdown();
    });
</script>