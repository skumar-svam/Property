    function ValidateRebateValue(){
        var unt = $("#rebateUnitId").val();
        var uvalu = $('#rebateValue').val();
        if(unt == 1 ){
            if((uvalu >=0 && uvalu <= 99))
            {return true;}
            else{
                alertify.error('Value should be a number and between 0 to 99.');
                return false;
            }
        }
        if(unt == 2){
            if((uvalu >=0 && uvalu <= 9999999))
            {return true;}
            else{
                alertify.error('Value should be a number and between 0 to 9999999.');
                return false;
