@model NA.PMS.Model.Rebate
@using Kendo.Mvc.UI

<style>
    #divRebateValue2 {
        display: none;
    }
</style>

<div class="SchemeRebateForm">
    <div class="col-md-12" id="rebateDetail">
        @*<div class="col-md-12 blnk-rw"></div>*@
        <h2 class="blck-heading">Rebate Information</h2>
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="col-md-12 col-sm-12 col-xs-12 scheme-form-bx">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="row">
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.LabelFor(model => model.rebatedepartment, htmlAttributes: new { @class = "k-label required" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(model => model.rebatedepartment)
                                .Name("rebatedepartment")
                                .DataTextField("text")
                                .DataValueField("id")
                                .OptionLabel("Select")
                                .Filter("contains")
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("GetAllDepartmentsByScheme", "Scheme").Data("AdditionalData");
                                    });
                                })
                                .HtmlAttributes(new { style = "width:100%" })
                        )

                        @Html.ValidationMessageFor(model => model.rebatedepartment, "", new { @class = "text-danger" })

                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.LabelFor(model => model.rebateId, htmlAttributes: new { @class = "k-label required" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(m => m.rebateId)
                                 .Name("rebateId")
                                .DataTextField("text")
                                .DataValueField("id")
                                .OptionLabel("Select")
                                .Filter("contains")
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("GetRebateTypes", "Scheme");
                                    });
                                })
                                .HtmlAttributes(new { style = "width:100%" })
                        )
                        @Html.ValidationMessageFor(model => model.rebateId)
                    </div>
                </div>

                <div class=" row">
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.LabelFor(model => model.rebateUnitId, htmlAttributes: new { @class = "k-label required" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @(Html.Kendo().DropDownListFor(model => model.rebateUnitId)
                                .Name("rebateUnitId")
                                .DataTextField("text")
                                .DataValueField("id")
                                .OptionLabel("Select")
                                .Filter("contains")
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("GetRebateUnits", "Scheme");
                                    });
                                })
                                .HtmlAttributes(new { style = "width:100%" })
                        )
                        @Html.ValidationMessageFor(model => model.rebateUnitId, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.LabelFor(model => model.rebateValue, htmlAttributes: new { @class = "k-label required" })
                    </div>
                    <div class="col-md-3 col-sm-3 col-xs-12 form-group">
                        @Html.TextBoxFor(model => model.rebateValue, htmlAttributes: new { @class = "form-control textBoxValueRightAlign", style = "width:100%;" })
                        @Html.ValidationMessageFor(model => model.rebateValue, "", new { @class = "text-danger" })
                    </div>

                </div>

                <div class="row">
                    <div class="col-md-12" style="text-align:center">

                    </div>
                </div>

            </div>
        }
    </div>
    <div class="row scheme-rw-btn">
        <div class="col-md-4 col-sm-4 col-xs-4 text-left">
            <button type="button" class="btn btn-add" value="Add" id="btnPre7">Previous <i class="glyphicon glyphicon-backward"></i></button>
        </div>
        <div class="col-md-4 col-sm-4 col-xs-4 text-center">
            <button type="button" class="btn btn-add" value="Add" id="btnAddRebate"> Add</button>
        </div>
        <div class="col-md-4 col-sm-4 col-xs-4 text-right">
        </div>
    </div>
    @*<div class="col-md-3 col-sm-3 col-xs-2 form-group">
            <button type="button" class="btn btn-add" value="Add" id="btnPre7">Previous <i class="glyphicon glyphicon-backward"></i></button>
        </div>*@
    <div class="col-md-12 blnk-rw"></div>
    <div class="col-md-12 k-grid-content" style="margin-bottom:10px;">
        @(Html.Kendo().Grid<NA.PMS.Model.Rebate>()
        .Name("gridReb")
        .Columns(columns =>
        {
            columns.Bound(c => c.rebateDepartmentName).Title("Department").Width(150);
            columns.Bound(c => c.rebatedepartment).Hidden(true);
            columns.Bound(c => c.rebateName).Title("Rebate Type").Width(150);
            columns.Bound(c => c.rebateId).Width(100).Hidden(true);
            columns.Bound(c => c.rebateValue).Width(90).Title("Value");
            columns.Bound(c => c.rebateUnitname).Title("Unit").Width(100);
            columns.Bound(c => c.rebateUnitId).Width(90).Hidden(true);
            if (ViewBag.view != "Yes")
            {
                columns.Bound(c => c.refId).Title("Action").ClientTemplate("<a onclick='javascript:RemoveRebRecord(\"#=refId#\");' class='schemeMasterGrids'>Remove</a>").Width(50).Filterable(false).Sortable(false);
            }
        })
        .Sortable()
        .Filterable()
        .Pageable
        (
             pageable => pageable
            .Enabled(true)
                 //.Refresh(true)
                    .PageSizes(true)

                ).Groupable().AutoBind(false)
        .DataSource
        (
             dataSource => dataSource
            .Ajax().Model(model => model.Id(p => p.refId))
            .ServerOperation(true)
            .Read(read => read.Action("GetRebateData", "Scheme").Data("AdditionalData")).PageSize(20)
         )
        )
    </div>
    <div class="row scheme-rw-btn">
        <div class="col-md-4 col-sm-4 col-xs-4 text-left">
            <button type="button" class="btn btn-add" value="Add" id="btnPre71">Previous <i class="glyphicon glyphicon-backward"></i></button>
        </div>
        <div class="col-md-4 col-sm-4 col-xs-4 text-center">            
        </div>
        <div class="col-md-4 col-sm-4 col-xs-4 text-right">
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        //$("#btnAddRebate").removeAttr('disabled');
        $("#btnAddRebate").click(function () {
            //$("#btnAddRebate").attr('disabled','disabled');
            var validaterebate= ValidaterebateMasterScheme();
            if (validaterebate) {
                var departmentID = $('#rebatedepartment').val();
                var schemeID = $("#scheId").val();
                var rebateId = $("#rebateId").val();
                var strrebateunitId="";
                if(($("#rebateUnitId").data("kendoDropDownList").text()=="PERCENTAGE"))
                {
                    strrebateunitId="PER";
                }
                else{
                    strrebateunitId=$("#rebateUnitId").data("kendoDropDownList").text();
                }
                $.ajax({
                    dataType: 'json',
                    type: 'Post',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify({ departmentID: departmentID, schemeID: schemeID,rebateId:rebateId }),
                    url: '/Scheme/IsRebateNameUnique',
                    success: function (result) {
                        if (result == true) {
                            alertify.error("This Department already exists");
                            return false;
                        }
                        else
                        {
                            $.ajax({
                                dataType: 'json',
                                type: 'Post',
                                contentType: 'application/json; charset=utf-8',
                                data: JSON.stringify({ rebatedepartment: $("#rebatedepartment").val(), rebateId: $("#rebateId").val(), rebateValue: $("#rebateValue").val(), rebateUnitId: strrebateunitId, schemeId: $("#scheId").val() }),
                                url: "/Scheme/AddRebate",
                                success: function (data) {
                                    if (data == 1) {
                                        $("#rebatedepartment").data("kendoDropDownList").value("");
                                        $("#rebateId").data("kendoDropDownList").value("");
                                        $("#rebateUnitId").data("kendoDropDownList").value("");
                                        $("#rebateValue").val('');
                                        $("#gridReb").data("kendoGrid").dataSource.read();
                                        alertify.success("Data added successfully");
                                        setTimeout(function () { ActivateScheme(); }, 2000);
                                        //$("#btnAddRebate").removeAttr('disabled');
                                    }
                                    else if (data==2)
                                    {
                                        alertify.error("Rebate unit Value should be same in grid.");
                                    }
                                    else if (data==3)
                                    {
                                        alertify.error("This Department already exists");
                                    }
                                    else if (data == 4) {
                                        alertify.error("Sum of Rebate value can't exceed 100%");
                                    }
                                    else
                                    {
                                        alertify.error("Data Not added successfully");
                                    }
                                },
                                error: function (objAjaxRequest, strError) {
                                    var respText = objAjaxRequest.responseText;
                                    //$("#btnAddRebate").removeAttr('disabled');
                                    //alert(respText);
                                }
                            });
                        }
                    },
                    error: function (objAjaxRequest, strError) {
                        var respText = objAjaxRequest.responseText;
                        //alert(respText);
                    }
                });
            }
            //$("#btnAddRebate").removeAttr('disabled');
        });
        $('#btnPre7').click(function () {
            $("#acc6").click();
        });
        $('#btnPre71').click(function () {
            $("#acc6").click();
        });
    });

    function RemoveRebRecord(refId) {
        var schemeID = $("#scheId").val();
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ refId: refId,schemeID:schemeID }),
            url: '/Scheme/RemoveRebRecord',
            success: function (result) {
                if (result == true) {
                    $("#gridReb").data("kendoGrid").dataSource.read();
                    $('#gridReb').data('kendoGrid').refresh();
                    var gridReb = $("#gridReb").data("kendoGrid").dataSource.data();
                    if(gridReb.length==1)
                    {
                        IsSchemeCompletedByRemove(false);
                    }
                    alertify.success("Record deleted successfully.");
                }
            },
            error: function (obj) {
                //alert('Error While Saving Record.');
            }
        });
    }


    function ValidaterebateMasterScheme()
    {
        var selecterebateValue = $('#rebatedepartment');
        var selectedrebatetypeValue = $('#rebateId');
        var selectedunitValue = $('#rebateUnitId');
        var rebateValue = $('#rebateValue');
        var unt = $("#rebateUnitId").val();
        var uvalu = $('#rebateValue').val();
        var unival=ValidateRebateValue();
        if (selecterebateValue.val() == "")
        {
            alertify.error('Please Select Department');
            return false;
        }
        else if (selectedrebatetypeValue.val() == "")
        {
            alertify.error('Please Select Rebate Type');
            return false;
        }
        else if (selectedunitValue.val() == "")
        {
            alertify.error('Please Select Unit');
            return false;
        }
        else if (rebateValue.val() == "")
        {
            alertify.error('Please enter Value');
            return false;
        }
        else if(!unival)
        {
            return false;
        }
        else
        {
            return true;
        }

    }

    function ValidateRebateDepttDuplicacy(quotaDepartmentId, schemeID,rebateId)
    {
        $.ajax({
            dataType: 'json',
            type: 'Post',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({ departmentID: quotaDepartmentId, schemeID: schemeID,rebateId:rebateId }),
            url: '/Scheme/IsRebateNameUnique',
            success: function (result) {
                if (result == true) {
                    temp = false;
                    alertify.error("This Department already exists");
                    return false;
                }
                else
                    temp = true;
                return true;
            },
            error: function (objAjaxRequest, strError) {
                var respText = objAjaxRequest.responseText;
                //alert(respText);
            }
        });
        //alert(temp);
        return temp;

    }

