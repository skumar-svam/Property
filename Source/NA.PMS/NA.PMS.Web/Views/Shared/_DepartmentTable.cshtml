@model NA.PMS.Model.Scheme
@using NA.PMS.Model;
<table id="tableDepartment" cellpadding='0' cellspacing='0' border='0'>
    <thead>
        <tr>
            <th><a href='javascript:void(0);'>Select</a></th>
            <th><a href='javascript:void(0);'>Department</a></th>
            <th><a href='javascript:void(0);'>Normal Interest</a></th>
            <th><a href='javascript:void(0);'>Penal Interest</a></th>
            <th><a href='javascript:void(0);'>Frequency</a></th>
            <th><a href='javascript:void(0);'>No of Intallment</a></th>
            <th><a href='javascript:void(0);'>FAR</a></th>
        </tr>
    </thead>
    <tbody>
        @{

            if (Model.DepartmentList.Count == 0)
            {
            }
            else
            {
                {
                    for (int i = 0; i < Model.DepartmentList.Count + 1; i++)
                    {
                        Html.RenderPartial("_BlankDepartmentRow", Model.DepartmentList[0]);
                    }
                }
            }
        }
    </tbody>
</table>
