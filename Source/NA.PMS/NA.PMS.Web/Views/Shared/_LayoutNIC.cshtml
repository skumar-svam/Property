@using System.Web.Optimization;
@using NA.PMS.Common.Helpers;
@using NA.PMS.Web.Models;
@using System.Web.Mvc;
@using NA.PMS.Model;
@using NA.PMS.Common;

@{
    var displayMiniProfiler = SettingsHelper.IsMiniProfilerEnabled;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/others")
    @Styles.Render("~/bundles/KendoCSS")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/others")
    @Scripts.Render("~/bundles/KendoJS")

    <link href="~/Content/CSS/style-new.css" rel="stylesheet" />
    <link href="~/Content/CSS/responsive.css" rel="stylesheet" />
    <link href="~/Content/CSS/open-top-bx.css" rel="stylesheet" />
    <script src="~/Scripts/kendo.aspnetmvc.min.js"></script>

    <link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">
    <script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
    <link href="~/Content/CSS/NICTemplate.css" rel="stylesheet" />
    <link href="~/Content/CSS/NICResponsiveStyle.css" rel="stylesheet" />
    <script>
        $(".input-disabled").keypress(function () {
            return false;
        });
    </script>
</head>
<body style="background:#fff;">
    <header class="nic-header-content" style="">
        <div class="row">
            <div class="col-md-3 col-sm-3 col-xs-3 col-lg-3">
                <img src="~/Content/Images/govt_up.png" class="img-up-govt-left"/> 
            </div>
            <div class="col-md-6 col-sm-6 col-xs-6 col-lg-6 nic-header-title" style="text-align:center;">
                <h1 class="nic-header-name">Nivesh Mitra</h1>
                <p>
                    <span style="">Single Window Portal</span> ,Govt. of Uttar Pradesh                                        
                </p>
                <p style="color:green;">New Okhla Industrial Development Authority</p>
            </div>
            <div class="col-md-3 col-sm-3 col-xs-3 col-lg-3 col-sm-hdn" style="text-align:right">
                <img src="~/Content/Images/logo_udhyog_bandu_b.png" class="img-up-govt-right"/> 
            </div>
        </div>
        @*<div class="row nic-dept-title" style="border-top: 1px solid #eeeeee; background:#fbfbfb;">
            <div class="col-md-12 nic-header-title" style="text-align:center">
                <p>New Okhla Industrial Development Authority</p>
            </div>
        </div>*@
    </header>

    <div class="nic-main-content">
        @RenderBody()
    </div>

    <footer>
        <div style="display:none">footer style here</div>
    </footer>
</body>
</html>
