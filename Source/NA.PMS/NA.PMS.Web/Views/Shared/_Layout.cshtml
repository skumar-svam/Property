@using System.Web.Optimization;
@using NA.PMS.Common.Helpers;
@using NA.PMS.Web.Models;
@using System.Web.Mvc;
@using NA.PMS.Model;
@*@using StackExchange.Profiling;*@
@{
    var displayMiniProfiler = SettingsHelper.IsMiniProfilerEnabled;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="template">
    <title>@ViewBag.Title</title>

    @Styles.Render("~/Content/others")
    @Styles.Render("~/bundles/KendoCSS")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/others")
    @Scripts.Render("~/bundles/KendoJS")


    <link href="~/Content/CSS/style-new.css" rel="stylesheet" />
    <link href="~/Content/CSS/responsive.css" rel="stylesheet" />
    <link href="~/Content/CSS/open-top-bx.css" rel="stylesheet" />
    <script src="~/Scripts/kendo.aspnetmvc.min.js"></script>

    <link rel="stylesheet" href="//code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css">
    <script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
    <script>
        $(document).ready(function () {

            $(".mbl-menu-btn").click(function () {
                $(".menu-wrapper").toggle("slide");
            });

            //Disable Keyboard for Kendo Date Picker
            $(".DisableKeyboardInput").keypress(function () {
                return false;
            });

            $(".input-disabled").keypress(function () {
                return false;
            });

            
        });
    </script>
    <style type="text/css">
        .navbar-collapse.collapse {
            display: block !important;
        }

        .navbar-nav > li, .navbar-nav {
            float: left !important;
        }

            .navbar-nav.navbar-right:last-child {
                margin-right: -15px !important;
            }

        .navbar-right {
            float: right !important;
        }
        .col-10{width:10% !important;}
        .col-20{width:20% !important;}
        .col-30{width:30% !important;}
        .col-40{width:40% !important;}
        .col-50{width:50% !important;}
        .col-60{width:60% !important;}
        .col-70{width:70% !important;}
        .col-80{width:80% !important;}
        .col-90{width:90% !important;}
    </style>
</head>
<body>

    <div id="mainWrapper" class="grad1" style="background: #fff;">
        <nav id="header-full" class="navbar navbar-default navbar-fixed-top nav-bg">
            <div class="container-fluid">
                <!-- Brand and toggle get grouped for better mobile display -->
                <div class="navbar-header">
                    @*<button type="button" class="navbar-toggle collapsed pull-left" data-toggle="collapse" data-target="#mainNav" aria-expanded="false">
                            <span class="sr-only">Toggle navigation</span>
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                        </button>*@
                    <div class="brand-wrap">
                        <a class="navbar-brand" href="#"></a>
                    </div>
                </div>

                <!-- Collect the nav links, forms, and other content for toggling -->
                <div class="collapse navbar-collapse" id="mainNav">
                    @{
                        if (Session["CurrentUser"] != null)
                        {
                            var usr = (CurrentUserDetail)Session["CurrentUser"];
                            //var usr = (LoginUserDetail)Session["CurrentUser"];
                            <input type="hidden" id="hdn-usr-roleindepartment" value='@usr.RoleMaster.RoleInDepartment' />
                            <ul class="nav navbar-nav navbar-right top-links hidden-xs">
                                <li class="dropdown dropdown-notifications">
                                    @{
                            var reqlist = (List<ServiceRequestModel>)Session["ServiceRequest"];
                            var ct = reqlist.Count;
                                    }
                                    <a href="#notifications-panel" class="dropdown-toggle"><i data-count="2" class="fa fa-square" aria-hidden="true"></i><span class="label label-warning">@ct</span></a>
                                    <div class="dropdown-container">
                                        <div style="width:100%; background:transparent; position:relative; top:-2px;"><div class="arrow-up"></div></div>

                                        <div class="dropdown-toolbar">
                                            <h3 class="dropdown-toolbar-title">New Service Request: @ct</h3>
                                        </div><!-- /dropdown-toolbar -->
                                        <ul class="dropdown-menu">
                                            @{
                                                if (reqlist.Count > 0)
                                                {
                                                    foreach (var req in reqlist)
                                                    {
                                                        <li>@req.DepartmentName  :  @req.Registration_No : ReqId:@req.Id : <a href="#" class="req-num">@req.ServiceName</a></li>
                                                    }
                                                }
                                            }
                                        </ul>

                                        <div class="dropdown-footer text-center">
                                            <a href="/Member/CitizenRequests/ManageCitizenRequests">View All</a>
                                        </div><!-- /dropdown-footer -->

                                    </div><!-- /dropdown-container -->
                                </li>
                                <li class="dropdown  dropdown-notifications">
                                    @{
                            var rtype = (List<ServiceTypeList>)Session["RequestType"];
                            var ntype = rtype.Sum(m => m.TotalCount);
                                    }
                                    <a href="#notifications-panel" class="dropdown-toggle"><i data-count="2" class="fa fa-bell" aria-hidden="true"></i><span class="label label-danger">@ntype</span></a>
                                    <div class="dropdown-container">
                                        <div style="width:100%; background:transparent; position:relative; top:-2px;"><div class="arrow-up"></div></div>

                                        <div class="dropdown-toolbar">
                                            <h3 class="dropdown-toolbar-title">Total Request: @ntype</h3>
                                        </div><!-- /dropdown-toolbar -->
                                        <ul class="dropdown-menu">
                                            @{
                            if (rtype.Count > 0)
                            {
                                foreach (var reqt in rtype)
                                {
                                    <li>@reqt.ServiceType : <a href="#" class="req-num">@reqt.TotalCount</a></li>
                                }
                            }
                                            }
                                        </ul>
                                        <div class="dropdown-footer text-center">
                                            <a href="/Reports/Report/PendencyReport">View All</a>
                                        </div><!-- /dropdown-footer -->

                                    </div><!-- /dropdown-container -->
                                </li>
                                @*<li class="dropdown user-tasks">
                                        <a href="#"><i class="fa fa-flag" aria-hidden="true"></i><span class="label label-danger">9</span></a>
                                    </li>*@
                                <li class="dropdown dropdown-notifications">
                                    @{
                            var nclst = (List<NoidaCustomerModel>)Session["NewCustomer"];
                            var nusr = nclst.Count;
                                    }
                                    <a href="#notifications-panel" class="dropdown-toggle"><i data-count="2" class="fa fa-flag" aria-hidden="true"></i><span class="label label-success">@nusr</span></a>
                                    <div class="dropdown-container">
                                        <div style="width:100%; background:transparent; position:relative; top:-2px;"><div class="arrow-up"></div></div>

                                        <div class="dropdown-toolbar">
                                            <h3 class="dropdown-toolbar-title">New Customer: @nusr</h3>
                                        </div><!-- /dropdown-toolbar -->
                                        <ul class="dropdown-menu">
                                            @{
                            if (nclst.Count > 0)
                            {
                                foreach (var req in nclst)
                                {
                                    <li>@req.FirstName  @req.LastName : Mobile:@req.MobileNo : <a href="#" class="req-num">@req.UserEmail</a></li>
                                }
                            }
                                            }
                                        </ul>
                                        <div class="dropdown-footer text-center">
                                            <a href="#">View All</a>
                                        </div><!-- /dropdown-footer -->
                                    </div><!-- /dropdown-container -->
                                </li>

                                <li class="dropdown">
                                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                        <i class="fa fa-user" aria-hidden="true"></i>
                                        <span class="caret"></span>
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <span>Welcome @usr.FirstName <br /> @usr.RoleMaster.RoleName</span>
                                        </li>

                                        <li>@Html.ActionLink("Change Password", "ChangePassword", new { @Controller = "Account", @Area = "" })</li>
                                        <li style="display:none"><a href="#">Settings</a></li>
                                        <li class="divider"></li>
                                        <li><a href="/Account/Logout/">Logout</a></li>
                                    </ul>
                                </li>
                            </ul>
                        }
                        else
                        {
                            Response.Redirect("~/Account/Login");
                        }
                    }

                    <div class="container-fluid nav-wrap">
                        @*@Html.MvcSiteMap().Menu(false, true, true)*@
                        @Html.MvcSiteMap().Menu("_PartialSiteMapMenu")
                    </div>
                </div><!-- /.navbar-collapse -->
            </div><!-- /.container-fluid -->
        </nav>



        <div class="container-fluid contentWrapper main" id="mainMaster">
            @RenderBody()
        </div>
        <footer>
            <div class="container-fluid">

                <div class="row">
                    <div class="col-md-12 col-xs-12 copyright text-center">
                        Copyright © @DateTime.Now.Year <b>NOIDA</b>. Developed and Maintained by <a href="http://www.svam.com">North Shore Technologies</a>

                    </div>
                </div>
            </div>
        </footer>

    </div>

</body>
</html>

<script>
    //Upon session end, throws back to Logout page automatically.
    var sessionTimeoutWarning = @Session.Timeout -1;

    var sTimeout = parseInt(sessionTimeoutWarning) * 60 * 1000;
    setTimeout('SessionEnd()', sTimeout);

    function SessionEnd() {
        window.location = "/Account/Logout";
    }

    $(function () {
        $(".dropdown").hover(
            function () {
                $('.dropdown-menu', this).stop(true, true).fadeIn("fast");
                $(this).toggleClass('open');
            },
            function () {
                $('.dropdown-menu', this).stop(true, true).fadeOut("fast");
                $(this).toggleClass('open');
            }
		);

    });
</script>
