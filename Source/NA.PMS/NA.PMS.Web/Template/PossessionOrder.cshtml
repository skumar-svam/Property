@using System.Web.Mvc.Html
@model NA.PMS.Model.Property.PropertyPossessionModel



<div style="width: 100%;">
    <center>
        <h2>New Okhla Industrial Development Authority</h2>
        Main Administrative Building, Sector VI,<br />
        NOIDA - 201301
    </center><br />

    <div>

        <table cellspacing=0 cellpadding=0 style="width: 100%;">
            <tr>
                <td>
                    <p>
                        <span>POSSESSION ORDER</span><br />
                        <span>FOR HANDING OVER</span><br />
                        <span>POSSESSION</span>
                    </p>
                </td>
                <td style="float: right;">
                    @*<p>
                        <span>ADMINISTRATIVE BLOCK</span><br />
                        <span>SECTOR-VI NOIDA COMPLEX</span><br />
                        <span>DISTT. GHAZIABAD (U.P.).</span>
                    </p>*@
                </td>
            </tr>
        </table>
    </div>

    <br />
    <br />

    <div>
        <table style="width: 100%;">
            <tr>
                <td>
                    <p>
                        <span>PROJECT ENGINEER-I/II/III</span>
                    </p>
                </td>
                <td style="float: right;">
                    <span>No.__________/NOIDA/@Model.CurrentYear</span><br />
                    <span>Dated: @Model.CurrentDate</span>
                </td>
            </tr>
        </table>
    </div>

    <br />

    <p>
        <span>
            Sub:--Possession order for handing over possession on Hire Purchase basis.<o:p></o:p>
        </span>
    </p>


    <p>
        <span>
            1.<span>        </span>Flat No.  @Model.PropertyNumber  @Model.BlockName Block  @Model.SectorName Sector in NOIDA Complex was allotted to
            Shri @Model.ApplicantName  with reference
            to his application bearing registration No. <span>@Model.Rid</span>  dated @Model.PossessionOrderDate.
        </span>
    </p>
    <p>
        <span>
            2.<span>       </span>The Hire purchase
            Tenancy Agreement deed has been made on Date  @Model.PossessionOrderDate.
        </span>
    </p>

    <p>
        <span>
            3.<span>       </span>The flat is allotted on Hire purchase
            Basis and the payment as per terms and conditions have been
            made by the allottee. Possession
            of the above mentioned flat may kindly be handed over to
            Shri @Model.ApplicantName  whose signatures duly attested are given on the enclosed paper
            within seven days from the date of issue of this letter i.e. by date  @Model.PossessionOrderDate
        </span>
    </p>

    <p>
        4.<span>        </span>A copy of the
        possession certificate may be handed over to the allottee on the spot at the time
        of handing over the possession of the house so that on
        the basis of that the allottee may contact
        the Project Engineer (<span>Jal</span>) for sewer/water connection and S.D.O. (<span>Hydle</span>) for electric connection.
    </p>

    <p>
        <span>
            5.<span>       </span>It is requested that one copy of the
            possession certificate alongwith the design of the
            house and
            other necessary papers bearing the signatures of the person taking over
            possession and signature
            of the concerned JE/APE may kindly be
            sent to the office of the undersigned and done copy direct
            to <span>Sr.A.O.III</span> within seven days for timely necessary action by
            him for recovery of monthly instalments.
        </span>
    </p>
    <br />
    <br />
    <p>
        <span>Encl:<span>  </span>As above</span>
    </p>


    <p>
        <span>Copy to :-</span><span></span>
    </p>

    <p>
        Shri/Smt/Km. @Model.ApplicantName  with
        the request that the possesion of the flat may be taken over within
        seven days from the date of issue of this letter by
        @Model.PossessionOrderDate for this you may please contact Project Engineer concerned
        Sector-6,Noida. In case you fail to take over the possession within
        the stipulated period of the allotted flat, the allotment
        of the flat made in your favour may be
        concerned.

    </p>
    <p>
        <span style="float: right;">
            <span>A L O</span><br />
            <span>@Model.DepartmentName</span>
        </span>
    </p>
</div>

