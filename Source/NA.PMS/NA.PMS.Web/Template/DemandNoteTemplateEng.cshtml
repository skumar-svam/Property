@using System.Web.Mvc.Html
@model NA.PMS.Model.PaymentViewModel


<div class="container-fluid">
    <table class="tbl-challan">
        <tr>
            <td colspan="3" style="text-align:center;">
                <h2>New Okhla Industrial Development Authority</h2>
                <h3>Administrative Block, Sector - 6, NOIDA</h3>
                <h4>@Model.Department Accounts Department</h4>
            </td>
        </tr>
        <tr>
            <td colspan="3" style="text-align:right;">
                <b>Notification No: @Model.NotificationId</b> <br />
                <b>Date: @DateTime.Now.ToString("dd-MMM-yyyy")</b>
            </td>
        </tr>
        <tr>
            <td colspan="3">To,</td>
        </tr>
        <tr>
            <td colspan="3">
                <b>@Model.Applicant</b><br />
                <b>@Model.RegistrationId</b> <br />
                <b>@Model.ApplicantAddress</b>
            </td>
        </tr>
        <tr>
            <td colspan="3">
                Subject:&nbsp;<b>@Model.ActionType</b>
            </td>
        </tr>
        
        <tr>
            <td colspan="3">Sir/Madam,</td>
        </tr>
        <tr>
            <td colspan="3">
                 <p>
                     Your are informed that last date for dues payment against above mentioned property is @Model.DuesUptoDate.Value.ToString("dd-MMM-yyyy").
                     Kindly pay your dues amount by Noida Authority challan and submit demand copy with challan in Authority.
                 </p>            
            </td>
        </tr>
        <tr>
            <td> 1 &nbsp; Installment Amount: </td> 
            <td colspan="2"> @Model.InstallmentAmount </td>
        </tr>
        <tr>
            <td> 2 &nbsp; Installment Interest Amount: </td>
            <td colspan="2"> @Model.InstallmentInterest </td>
        </tr>
        <tr>
            <td> 3 &nbsp; Total Installment Dues Amount: </td>
            <td colspan="2"> @Model.TotalInstallment </td>
        </tr>
        <tr>
            <td> 4 &nbsp; Leaserent Amount: </td>
            <td colspan="2"> @Model.LeaseRentDues </td>
        </tr>
        <tr>
            <td> 5 &nbsp; Leaserent Interest Amount: </td>
            <td colspan="2"> @Model.LeaseRentInterest </td>
        </tr>
        <tr>
            <td> 6 &nbsp; Total Leaserent Dues Amount: </td>
            <td colspan="2"> @Model.TotalLeaseRent </td>
        </tr>
        <tr>
            <td> 7 &nbsp; One Time Leaserent Amount: </td>
            <td colspan="2"> @Model.OneTimeLeaseRentAmount </td>
        </tr>
        <tr>
            <td> &nbsp; &nbsp; Total Amount: </td>
            <td colspan="2"> @Model.TotalDuesAmount </td>
        </tr>
        <tr>
            <td colspan="3"><b>Amount in words: @Model.AmountInWords</b></td>
        </tr>
        <tr>
            <td colspan="3"><b>Allottee is responsible to pay GST on dues by Reverse Charge Mechanism. GST No. of Noida Authority is 09AAALN0120A1ZV</b></td>
        </tr>
        <tr>
            <td colspan="3"><b>This is a system generated demand. Please contact the appropriate property accounts department in case of any discrepancy.</b></td>
        </tr>
        <tr>
            <td colspan="3" style="text-align:right;">
                <b>Your faithfully</b><br />
                <b>Accounts Officer</b><br />
                <b>Noida Authority</b><br />
                <b>(@Model.Department)</b>
            </td>
        </tr>
        
    </table>

</div>

