@model NA.PMS.Model.MutationModel

<html>
<head>
    <style>
        p {
            font-family: Verdana;
        }
    </style>
</head>
<body>
    <center>
        <h2>New Okhla Industrial Development Authority</h2>
        Main Administrative Building, Sector VI,<br />
        NOIDA - 201301
    </center><br />
    <div>
        <b><u>@Model.DepttName Department</u></b><br /><br />
        <center><b><u>REGISTERED</u></b></center>
        <div style="text-align:right">
            <table align="right">
                <tr><td>No</td><td>NOIDA/   (@Model.DepttName)/</td></tr>
                <tr><td>Run Date</td><td>@DateTime.Now.Date</td></tr>
                <tr>
                    <td>Regn. Id.</td>
                    <td>@Model.RId</td>
                </tr>
            </table>
        </div>
    </div>
    <p><b>Sh/Smt/Km/M/s</b> @Model.TransfereeName<br />@Model.TransfereeAddress</p>
    <br />
    <br />
    <p><b>Subject: Mutation of House/Flat No. @Model.PropNo</b></p>
    <br />
    <br />
    <p>
        Sir/Madam,<br />
        The above mentioned house/flat stands mutated in your name on the basis of transfer<br />
        @Model.ApplicantName, @Model.ApplicantAddress<br />
        and @Model.TransfereeName, @Model.TransfereeAddress (Transferee)<br />
        and registered with sub-registrar Noida vide Bahi No. @if (Model.BahiNo == "") { <span>NA</span>} else{<span>@Model.BahiNo</span>} Zild No. @if (Model.BahiZildNo == "")
        { <span>NA</span>}
        else
        {<span>@Model.BahiZildNo</span>} Page No. @if (Model.BahiPageNo == "")
        { <span>NA</span>}
        else
        {<span>@Model.BahiPageNo</span>} SI. No. @if (Model.SINo == "")
        { <span>NA</span>}
        else
        {<span>@Model.SINo</span>} @*on @if (Model.MutationDate == "")
        { <span>NA</span>}
        else
        {<span>@Model.MutationDate</span>}*@
    </p>
</body>
</html>



