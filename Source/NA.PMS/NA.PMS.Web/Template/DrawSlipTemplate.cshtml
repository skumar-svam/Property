@using System.Web.Mvc.Html





<table class="" style="border:1px solid black; width:100%; height:225px;margin:3px">
    <tr>
        <th colspan="4"><b>@Model.SchemeName</b></th>
    </tr>
    <tr>
        <td colspan="2"></td>
        <td colspan="2"></td>
    </tr>
    @if (@Model.PropertyTypeId != null)
    {
        <tr>
            <td colspan="2">
                Type:
            </td>
            <td colspan="2">
                @Model.PropertyTypeName
            </td>
        </tr>
    }
    @if (@Model.BankName != null)
    {
        <tr>
            <td colspan="2">
                Bank Name:
            </td>
            <td colspan="2">
                @Model.BankName
            </td>
        </tr>
    }
    @if (@Model.FormNumber != null)
    {
        <tr>
            <td colspan="2">
                Form No:
            </td>
            <td colspan="2">
                @Model.FormNumber
            </td>
        </tr>
    }

    @if (@Model.MobileNumber != null)
    {
        <tr>
            <td colspan="2">
                Mobile No:
            </td>
            <td colspan="2">
                @Model.MobileNumber
            </td>
        </tr>
    }
    @if (@Model.FirstName != null)
    {
        <tr>
            <td colspan="2">
                Applicant Name:
            </td>
            <td colspan="2">
                @Model.ApplicantName
            </td>
        </tr>
    }
    @if (@Model.PanNumber != null)
    {
        <tr>
            <td colspan="2">
                PAN:
            </td>
            <td colspan="2">
                @Model.PanNumber
            </td>
        </tr>
    }
    @if (@Model.FatherName != null)
    {
        <tr>
            <td colspan="2">
                Father's Name:
            </td>
            <td colspan="2">
                @Model.FatherName
            </td>
        </tr>
    }
    @if (@Model.MotherName != null)
    {
        <tr>
            <td colspan="2">
                Mother's Name:
            </td>
            <td colspan="2">
                @Model.MotherName
            </td>
        </tr>
    }


</table>
